{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchos.local/contracts/native.client-attestation.v1.schema.json",
  "$defs": {
    "NativeClientAttestRequestFrame": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "NATIVE_CLIENT_ATTEST_REQUEST"
        },
        "client_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "payload": {
          "type": "object",
          "properties": {
            "schema_version": {
              "const": 1
            },
            "credential_value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "writeOnly": true
            },
            "command_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,64}$"
            },
            "method": {
              "const": "session.create"
            },
            "project_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "request_raw_sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "session_id": {
              "const": null
            },
            "expected_revision": {
              "const": null
            },
            "writer_epoch": {
              "const": null
            }
          },
          "required": [
            "schema_version",
            "credential_value",
            "command_id",
            "method",
            "project_id",
            "request_raw_sha256",
            "session_id",
            "expected_revision",
            "writer_epoch"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "client_id",
        "payload"
      ],
      "additionalProperties": false
    },
    "NativeClientAttestResultFrame": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "NATIVE_CLIENT_ATTEST_RESULT"
        },
        "payload": {
          "type": "object",
          "properties": {
            "schema_version": {
              "const": 1
            },
            "attestation_ref": {
              "type": "string",
              "pattern": "^natt-[0-9a-f]{64}$"
            },
            "client_instance_ref": {
              "type": "string",
              "pattern": "^nci-[0-9a-f]{32}$"
            },
            "host_instance_id": {
              "type": "string",
              "pattern": "^host-[0-9a-f]{12}$"
            },
            "expires_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "schema_version",
            "attestation_ref",
            "client_instance_ref",
            "host_instance_id",
            "expires_at"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "payload"
      ],
      "additionalProperties": false
    }
  }
}
