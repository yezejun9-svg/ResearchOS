+				var body Object
+				if err := json.Unmarshal([]byte(Str(rows[0], "body")), &body); err != nil {
+					t.Fatal(err)
+				}
+				if mutation == "intent-hash" {
+					body["intent_hash"] = "wrong"
+				}
+				if mutation == "state" {
+					body["state"] = "PAUSE_REQUESTED"
