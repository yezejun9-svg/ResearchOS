+  const binding = {
+    project_id: "p",
+    session_id: "s",
+    task_id: "t",
+    run_id: "r",
+    runtime_epoch: epoch,
+    queue_generation: "g",
+    dispatch_key: "d" + epoch,
+    manifest_hash: digest("manifest" + epoch),
+  };
+  const request = {
+    task_id: "t",
+    run_id: "r",
+    epoch,
+    input_refs: [],
+    context: {},
+    task_title: "pause evidence",
+    task_description: "original prompt once",
+    queue_control: true,
+    queue_binding: { ...binding },
+    pause_protocol: version,
+  };
