+import { createHash } from "node:crypto";
+import { gzipSync } from "node:zlib";
+const bundle = process.env.RESEARCHOS_PAUSE_WORKER_BUNDLE;
+assert.ok(bundle, "actual rebuilt candidate worker required");
+const sha = (b) => createHash("sha256").update(b).digest("hex"),
+  digest = (b) => "sha256:" + sha(b),
+  version = "RESEARCHOS_PAUSE_V1";
+const config = {
+  ref: "fixture",
+  api: "openai-completions",
+  provider: "openai",
+  model: "fixture",
+  endpoint: "https://fixture.invalid",
+  route: "broker",
+  max_output_tokens: 128,
+  max_calls: 8,
+  tools: [],
+};
+const sse =
+  "data: " +
+  JSON.stringify({
+    id: "fixture",
+    object: "chat.completion.chunk",
+    choices: [
+      {
+        index: 0,
+        delta: { role: "assistant", content: "reply" },
+        finish_reason: null,
+      },
+    ],
+  }) +
+  "\n\ndata: " +
+  JSON.stringify({
+    id: "fixture",
+    object: "chat.completion.chunk",
+    choices: [{ index: 0, delta: {}, finish_reason: "stop" }],
+  }) +
+  "\n\ndata: [DONE]\n\n";
+async function run(
+  t,
+  {
+    snapshot,
+    ack = "valid",
+    epoch = 1,
+    mutateActivation,
+    withTool = false,
+  } = {},
+) {
+  const root = await mkdtemp(join(tmpdir(), "researchos-production-pause-"));
