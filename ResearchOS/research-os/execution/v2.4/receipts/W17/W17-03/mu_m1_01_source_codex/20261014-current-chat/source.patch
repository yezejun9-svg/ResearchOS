+    process_created_ns: "1",
+    job: "j" + epoch,
+    appcontainer_sid: "sid",
+    profile: "profile",
+    staging_directory: root,
+  };
+  const send = (x) => child.stdin.write(JSON.stringify(x) + "\n"),
