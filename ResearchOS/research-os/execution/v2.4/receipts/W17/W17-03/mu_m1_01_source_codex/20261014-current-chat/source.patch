+            sequence: f.sequence,
+            key: "command.initialize",
+            state: "CONFIRMED",
+            payload: {},
+          });
+        if (f.type === "effect.request") {
+          effects.push(f);
+          if (
+            !snapshot &&
+            (withTool ? f.capability === "TOOL" : effects.length === 1)
+          ) {
+            for (const [i, delivery] of ["STEER", "FOLLOW_UP"].entries()) {
+              const content = JSON.stringify({
+                text: "queued-" + i,
+                attachments: [],
+              });
+              control({
+                type: "command.deliver",
+                command: {
+                  command_id: "c" + i,
+                  message_id: "m" + i,
+                  queue_sequence: i + 1,
+                  content,
+                  content_hash: digest(content),
+                  delivery,
+                },
+              });
+            }
+            control({ type: "command.pause", version, pause_id: "pause-1" });
+          }
+          const toolSSE =
+            "data: " +
+            JSON.stringify({
+              id: "fixture",
+              object: "chat.completion.chunk",
+              choices: [
+                {
+                  index: 0,
+                  delta: {
+                    role: "assistant",
+                    tool_calls: [
+                      {
+                        index: 0,
+                        id: "call-1",
+                        type: "function",
+                        function: {
+                          name: "read",
+                          arguments: JSON.stringify({ path: "file.txt" }),
+                        },
+                      },
+                    ],
+                  },
+                  finish_reason: null,
+                },
+              ],
+            }) +
+            "\n\ndata: " +
+            JSON.stringify({
+              id: "fixture",
+              object: "chat.completion.chunk",
+              choices: [{ index: 0, delta: {}, finish_reason: "tool_calls" }],
+            }) +
+            "\n\ndata: [DONE]\n\n";
+          const body =
+            withTool && !snapshot && f.capability === "MODEL" ? toolSSE : sse;
+          if (f.capability === "TOOL") {
+            setTimeout(
+              () =>
+                send({
+                  sequence: f.sequence,
+                  key: f.key,
+                  state: "CONFIRMED",
+                  payload: {
+                    content: [{ type: "text", text: "tool-result-preserved" }],
+                    details: {
+                      path: "file.txt",
+                      content_hash: digest("tool-result-preserved"),
+                      next_offset: 21,
+                      truncated: false,
+                      size_bytes: 21,
+                    },
+                  },
+                }),
+              50,
+            );
+            return;
+          }
+          setTimeout(
+            () =>
+              send({
+                sequence: f.sequence,
+                key: f.key,
+                state: "CONFIRMED",
+                payload: {
+                  status: 200,
+                  content_type: "text/event-stream",
+                  body_encoding: "gzip+base64",
+                  body_gzip_base64: gzipSync(body).toString("base64"),
+                  body_sha256: digest(body),
+                },
+              }),
+            50,
+          );
