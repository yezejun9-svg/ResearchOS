+		{"v1-erased-all-pause-fields", "fixture", PauseProtocol, func(_ string, j *BridgeJournal) {
+			j.PauseProtocol = ""
+			j.Checkpoint = nil
+			j.CheckpointSeal = nil
+			j.PauseRequested = false
+			j.PauseID = ""
