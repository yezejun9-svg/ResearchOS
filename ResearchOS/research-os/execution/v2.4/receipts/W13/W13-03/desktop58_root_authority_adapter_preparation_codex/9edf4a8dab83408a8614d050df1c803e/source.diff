+def absolute_ref(reader, item):
+    reader.verify(item, external=Path(item['path']).is_absolute() and not Path(item['path']).is_relative_to(ROOT))
+    p = Path(item['path'])
+    if not p.is_absolute():
+        p = ROOT / p
+    return {'path': str(p), 'sha256': item['sha256'], 'bytes': item['bytes']}
+
