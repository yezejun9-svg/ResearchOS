  "requested_changes": [
    {
      "id": "D58-AUTH-R01",
      "severity": "Important",
      "path": "D:\\作品集\\ResearchOS\\research-os\\execution\\v2.4\\receipts\\W13\\W13-03\\desktop58_root_authority_adapter_preparation_codex\\9edf4a8dab83408a8614d050df1c803e\\authorization_adapter.final.proposed.py",
      "line": 611,
      "function": "validate_grant",
      "summary": "Empty runtime_observation_refs bypasses the prelaunch runtime evidence gate.",
      "trigger": "With an otherwise valid Root scope/grant, set grant.runtime_observation_refs=[]; the for loop executes zero times. No observation schema/files/all_observed_inputs_pre_pinned/read/hash check occurs before the success return at633.",
      "impact": "The adapter returns registered_Root_scope_and_grant_verified=True without the prelaunch runtime evidence promised by its contract. NULL fails by type traversal, but the known-empty list is a success path rather than OPEN/refusal.",
      "evidence_lines": [
        611,
        613,
        619,
        624,
        633
      ],
      "minimal_fix": "Require runtime_observation_refs to be an explicit nonempty list of unique exact refs before traversing it. Freeze the expected ordered observation paths/roles or exact selected refs in the Root reviewed scope/prelaunch contract, compare the grant against that set, and reject a missing, duplicate or foreign observation. Keep the observations point-in-time only; do not infer continuous OS proof. All added scope/producer fields remain proposals until Root adopts them.",
      "minimal_future_controls": [
        "An otherwise valid Root positive with every frozen expected prelaunch observation is preserved.",
        "Change only runtime_observation_refs to [] -> reject before returning authority and before allocation.",
        "NULL/wrong type -> explicit refusal.",
        "Duplicate, missing expected ref or foreign observation path/role -> reject.",
        "A nonempty observation with empty files/unpinned member/all_observed_inputs_pre_pinned!=true -> reject."
      ],
      "verification": "Source control-flow reasoning only; no candidate import/call or synthetic executed gate test."
    }
  ],
