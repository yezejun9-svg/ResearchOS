      "old": "        for key in ['invocation_ref','verified_ref','stdout_ref','stderr_ref']:\n            require(str(bounded_path(fact[key]['path'])) in ex, 'CLI leaf unsealed raw fact')\n            same_ref(reader, ex[str(bounded_path(fact[key]['path']))], fact[key])\n        reader.verify(case_result['proof_ref'])\n",
      "new": "        # The original Q fact carries invocation/verified refs only. The executor\n        # producer names raw streams by the stage label and seals their actual pins.\n        stage = result['stages'][-len(CASES)+i]\n        label = 'case-%02d' % i\n        require(stage['label'] == label and stage['result_ref'] == fact['invocation_ref'],\n                'CLI case stage/fact provenance')\n        invocation_path = bounded_path(fact['invocation_ref']['path'])\n        verified_path = bounded_path(fact['verified_ref']['path'])\n        require(invocation_path.name == label+'.invocation.json' and\n                verified_path == invocation_path.with_name(label+'.verified.json'),\n                'CLI producer case filenames')\n        for key in ['invocation_ref','verified_ref']:\n            p = str(bounded_path(fact[key]['path']))\n            require(p in ex, 'CLI leaf unsealed original fact')\n            same_ref(reader, ex[p], fact[key])\n        verified = reader.doc(fact['verified_ref'])\n        require(verified == case_result, 'CLI verified leaf differs from result')\n        require(invocation_path.parent == bounded_path(evidence['executor_manifest_ref']['path']).parent,\n                'CLI case outside original executor root')\n        raw_streams = {}\n        for stream in ('stdout','stderr'):\n            raw_path = invocation_path.with_name(label+'.'+stream+'.raw')\n            require(str(raw_path) in ex, 'CLI producer raw stream absent from sealed executor')\n            raw_streams[stream] = reader.verify(ex[str(raw_path)])\n        events = [strict_json(line) for line in raw_streams['stdout'].splitlines()]\n        leaf = 'TestCLIProtocolInteractiveAuthority/'+case\n        require(sum(e.get('Action') == 'run' and e.get('Test') == leaf for e in events) == 1 and\n                sum(e.get('Action') == 'pass' and e.get('Test') == leaf for e in events) == 1 and\n                not any(e.get('Action') in ('fail','skip') for e in events),\n                'CLI raw leaf RUN/PASS or FAIL/SKIP mismatch')\n        proof_path = bounded_path(case_result['proof_ref']['path'])\n        export_root = bounded_path(cli_scope['new_export_root'])\n        expected_proof = (export_root/'.cli43-build'/'case-evidence'/label/\n                          ('TestCLIProtocolInteractiveAuthority_'+case)/'closed-proof.json')\n        require(proof_path == expected_proof, 'CLI proof outside original export/case')\n        reader.verify(case_result['proof_ref'])\n",
      "only_one_exact_bytes_replacement": true
    },
