diff --git a/apps/desktop/validator/main.go b/apps/desktop/validator/main.go
index 014b284a..e5e3977e 100644
--- a/apps/desktop/validator/main.go
+++ b/apps/desktop/validator/main.go
@@ -348,16 +348,44 @@ func validate(raw []byte) verdict {
 	if !jsontext.Value(raw).IsValid() {
 		return out
 	}
-	var p packet
-	dec := json.NewDecoder(bytes.NewReader(raw))
-	dec.DisallowUnknownFields()
-	if dec.Decode(&p) != nil || p.Schema != protocol || !uuid(p.Nonce) || (p.Phase != "REQUEST" && p.Phase != "RESPONSE") {
-		return out
-	}
+	// Check exact decoded member names and non-null types before encoding/json's
+	// struct projection can accept case aliases or silently zero a null string.
 	var keys map[string]json.RawMessage
 	if json.Unmarshal(raw, &keys) != nil || len(keys) != 6 {
 		return out
 	}
+	for _, key := range []string{"schema", "phase", "nonce", "request_raw_base64", "response_raw_base64"} {
+		value, exists := keys[key]
+		var text string
+		if !exists || len(value) == 0 || value[0] != '"' || json.Unmarshal(value, &text) != nil {
+			return out
+		}
+	}
+	if _, exists := keys["http_status"]; !exists {
+		return out
+	}
+	var p packet
+	for key, target := range map[string]*string{"schema": &p.Schema, "phase": &p.Phase, "nonce": &p.Nonce, "request_raw_base64": &p.Request, "response_raw_base64": &p.Response} {
+		if json.Unmarshal(keys[key], target) != nil {
+			return out
+		}
+	}
+	if !bytes.Equal(keys["http_status"], []byte("null")) {
+		value, err := decode(keys["http_status"], &budget{})
+		number, ok := value.(json.Number)
+		if err != nil || !ok {
+			return out
+		}
+		rational, ok := new(big.Rat).SetString(string(number))
+		if !ok || !rational.IsInt() || !rational.Num().IsInt64() || rational.Num().Int64() < 100 || rational.Num().Int64() > 599 {
+			return out
+		}
+		status := int(rational.Num().Int64())
+		p.Status = &status
+	}
+	if p.Schema != protocol || !uuid(p.Nonce) || (p.Phase != "REQUEST" && p.Phase != "RESPONSE") {
+		return out
+	}
 	out.Nonce = p.Nonce
 	out.Phase = p.Phase
 	out.Status = p.Status
diff --git a/apps/desktop/validator/main_test.go b/apps/desktop/validator/main_test.go
index 22804045..36074c84 100644
--- a/apps/desktop/validator/main_test.go
+++ b/apps/desktop/validator/main_test.go
@@ -1,7 +1,9 @@
 package main
 
 import (
+	"encoding/base64"
 	"encoding/json"
+	"strings"
 	"testing"
 )
 
@@ -15,6 +17,89 @@ func TestWireParserPreservesAdjacentIntegers(t *testing.T) {
 		}
 	}
 }
+
+func TestWirePrivatePacketExactKeysAndTypes(t *testing.T) {
+	request := `{"protocol_version":"researchos-client/2","command_id":"private-unit","client_id":"desktop-shell","method":"host.status","project_id":null,"session_id":null,"expected_revision":null,"writer_epoch":null,"payload":{}}`
+	fields := map[string]any{"schema": protocol, "phase": "REQUEST", "nonce": "12345678-1234-1234-1234-123456789abc", "http_status": nil, "request_raw_base64": base64.StdEncoding.EncodeToString([]byte(request)), "response_raw_base64": ""}
+	raw, _ := json.Marshal(fields)
+	if got := validate(raw); got.Outcome != "VALID" {
+		t.Fatalf("positive request: %+v", got)
+	}
+	for _, key := range []string{"schema", "phase", "nonce", "request_raw_base64", "response_raw_base64"} {
+		for _, bad := range []any{nil, true, 1, []any{}, map[string]any{}} {
+			t.Run(key+"/"+string(mustWireJSON(bad)), func(t *testing.T) {
+				copy := map[string]any{}
+				for k, v := range fields {
+					copy[k] = v
+				}
+				copy[key] = bad
+				if got := validate(mustWireJSON(copy)); got.Outcome != "REFUSED" || got.Reason != "PRIVATE_PACKET" {
+					t.Fatalf("accepted wrong field type: %+v", got)
+				}
+			})
+		}
+	}
+	for _, key := range []string{"schema", "phase", "nonce", "http_status", "request_raw_base64", "response_raw_base64"} {
+		for _, kind := range []string{"case-alias", "missing", "extra", "duplicate"} {
+			t.Run(key+"/"+kind, func(t *testing.T) {
+				copy := map[string]any{}
+				for k, v := range fields {
+					copy[k] = v
+				}
+				switch kind {
+				case "case-alias":
+					delete(copy, key)
+					copy[strings.ToUpper(key)] = fields[key]
+				case "missing":
+					delete(copy, key)
+				case "extra":
+					copy["extra"] = nil
+				}
+				candidate := mustWireJSON(copy)
+				if kind == "duplicate" {
+					candidate = append(candidate[:len(candidate)-1], []byte(`,"`+key+`":null}`)...)
+				}
+				if got := validate(candidate); got.Outcome != "REFUSED" || got.Reason != "PRIVATE_PACKET" {
+					t.Fatalf("accepted wrong member set: %+v", got)
+				}
+			})
+		}
+	}
+	for _, literal := range []string{"null", "true", `"200"`, "99", "600", "200.0000000000000001", "{}", "[]"} {
+		t.Run("response-status/"+literal, func(t *testing.T) {
+			candidate := strings.Replace(string(raw), `"REQUEST"`, `"RESPONSE"`, 1)
+			candidate = strings.Replace(candidate, `"http_status":null`, `"http_status":`+literal, 1)
+			if got := validate([]byte(candidate)); got.Outcome != "REFUSED" || got.Reason != "PRIVATE_PACKET" {
+				t.Fatalf("accepted invalid status: %+v", got)
+			}
+		})
+	}
+	for _, literal := range []string{"100", "100.0", "1e2", "599"} {
+		t.Run("valid-response-status/"+literal, func(t *testing.T) {
+			candidate := strings.Replace(string(raw), `"REQUEST"`, `"RESPONSE"`, 1)
+			candidate = strings.Replace(candidate, `"http_status":null`, `"http_status":`+literal, 1)
+			if got := validate([]byte(candidate)); got.Outcome != "HTTP_ERROR" {
+				t.Fatalf("rejected integral status: %+v", got)
+			}
+		})
+	}
+	for _, prefix := range []string{"\u00a0", "\ufeff", "\v", "\f"} {
+		if got := validate(append([]byte(prefix), raw...)); got.Outcome != "REFUSED" {
+			t.Fatal("accepted non-JSON whitespace")
+		}
+	}
+	if got := validate(append([]byte(" \t\r\n"), raw...)); got.Outcome != "VALID" {
+		t.Fatal("rejected JSON whitespace")
+	}
+}
+
+func mustWireJSON(value any) []byte {
+	raw, err := json.Marshal(value)
+	if err != nil {
+		panic(err)
+	}
+	return raw
+}
 func TestWireParserRejectsAmbiguousJSONAndWorkExhaustion(t *testing.T) {
 	for _, raw := range []string{`{"a":1,"\u0061":2}`, `"\ud800"`, `{} {}`} {
 		if _, err := decode([]byte(raw), &budget{}); err == nil {
diff --git a/tests/ui/desktop/http-wire-boundary.test.mjs b/tests/ui/desktop/http-wire-boundary.test.mjs
index 1dc4b629..9babf41e 100644
--- a/tests/ui/desktop/http-wire-boundary.test.mjs
+++ b/tests/ui/desktop/http-wire-boundary.test.mjs
@@ -330,6 +330,53 @@ const negativeCases={
 };
 if(direct && !process.versions.electron)for(const [name,run] of Object.entries(negativeCases))test('desktop-http/'+name,{timeout:45000},run);
 
+if(direct && !process.versions.electron) {
+  test('desktop-http/revision/ack-before-concurrent-get',{timeout:45000},async()=>{
+    const p=pair('session.attach');
+    const state={projectId:p.request.project_id,sessionId:p.request.session_id,expectedRevision:7,writerEpoch:2,writerClientId:'foreign',writerExpiresAt:'2099-01-01T00:00:00Z'};
+    const advanced=snapshot({revision:8,writer:{client_id:'desktop-shell',epoch:3,expires_at:'2099-01-01T00:00:00Z'}});
+    let gotA,releaseA,enqueuedB;
+    const arrivedA=new Promise(resolve=>gotA=resolve),allowA=new Promise(resolve=>releaseA=resolve),queuedB=new Promise(resolve=>enqueuedB=resolve);
+    const transitions=[];
+    const h=await harness(async(raw,index)=>{
+      const env=JSON.parse(raw.toString('utf8'));
+      if(index===1){gotA();await allowA;}
+      const response=index===1?pair(env.method,'ACKNOWLEDGED').response:pair(env.method).response;
+      Object.assign(response,{command_id:env.command_id,session_id:env.session_id});
+      if(index!==1){response.revision=8;if(env.method==='session.get')response.result=advanced;else if(env.method==='session.attach')response.result={snapshot:advanced,write_owner_acquired:true};else response.result.snapshot=advanced;}
+      return {body:response};
+    },{state});
+    const real=h.deps.v2Transport;h.deps.v2Transport=(...args)=>{if(args[2].method==='session.get')enqueuedB();return real(...args);};
+    const args={after_sequence:3,request_write_owner:true};
+    try {
+      const a=ipc.callV2(h.deps,'session.attach',args);await arrivedA;
+      const b=ipc.callV2(h.deps,'session.get',{});await queuedB;releaseA();
+      const ack=await a;assert.equal(ack.protocol_status,'ACKNOWLEDGED');assert.equal(ack.completed,false);
+      assert.equal(state.pendingOperation.method,'session.attach');transitions.push({stage:'ACK',command:state.pendingOperation.commandId,revision:state.expectedRevision,epoch:state.writerEpoch});
+      const read=await b;assert.equal(read.completed,true);assert.equal(state.expectedRevision,7);assert.equal(state.writerEpoch,2);assert.equal(state.writerClientId,'foreign');
+      assert.equal(state.pendingOperation.commandId,JSON.parse(h.observations.http[0].raw).command_id);
+      const childrenBefore=h.observations.children.length;
+      const blocked=await ipc.callV2(h.deps,'session.send',{text:'blocked',attachment_artifact_ids:[],delivery:'NORMAL'});
+      assert.equal(blocked.reason,'COMMAND_PENDING');assert.equal(h.observations.http.length,2);assert.equal(h.observations.children.length,childrenBefore);
+      const complete=await ipc.callV2(h.deps,'session.attach',args);assert.equal(complete.completed,true);
+      assert.deepEqual(h.observations.http[0].raw,h.observations.http[2].raw);assert.equal(state.pendingOperation,undefined);
+      assert.equal(state.expectedRevision,8);assert.equal(state.writerEpoch,3);assert.equal(state.writerClientId,'desktop-shell');
+      transitions.push({stage:'original-COMPLETED',revision:state.expectedRevision,epoch:state.writerEpoch});
+      const sent=await ipc.callV2(h.deps,'session.send',{text:'one dependent send',attachment_artifact_ids:[],delivery:'NORMAL'});assert.equal(sent.completed,true);
+      assert.equal(h.observations.http.length,4);assert.equal(h.observations.children.length,8);
+      fs.mkdirSync(process.env.RESEARCHOS_DESKTOP_CASE_RECEIPT,{recursive:true});
+      fs.writeFileSync(path.join(process.env.RESEARCHOS_DESKTOP_CASE_RECEIPT,'revision-transitions.json'),JSON.stringify(transitions,null,2));
+    } finally {releaseA();await h.close();}
+  });
+  test('desktop-http/revision/private-six-key-types',{timeout:45000},async()=>{
+    const request=exact.stringify(pair('host.status').request);
+    const aliased=await purePacket(request,'','REQUEST',null,p=>{p.Schema=p.schema;delete p.schema;});
+    const nullString=await purePacket(request,'','REQUEST',null,p=>{p.response_raw_base64=null;});
+    for(const value of [aliased,nullString]){assert.equal(value.outcome,'REFUSED');assert.equal(value.reason,'PRIVATE_PACKET');}
+  });
+  test('desktop-http/revision/private-json-whitespace',{timeout:45000},()=>negativeChild('nbsp','PRIVATE_JSON'));
+}
