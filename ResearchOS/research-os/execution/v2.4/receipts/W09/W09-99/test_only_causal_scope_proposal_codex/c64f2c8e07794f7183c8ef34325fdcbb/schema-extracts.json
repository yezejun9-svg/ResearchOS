{
  "CreateEvidenceRequest": {
    "type": "object",
    "properties": {
      "claim": {
        "type": "string",
        "minLength": 1
      },
      "stance": {
        "type": "string",
        "enum": [
          "SUPPORT",
          "CONTRADICT",
          "CONTEXT",
          "UNKNOWN"
        ]
      },
      "evidence_kind": {
        "$ref": "#/$defs/EvidenceKind"
      },
      "source_kind": {
        "type": "string",
        "enum": [
          "GITHUB",
          "X",
          "PAPER",
          "LOCAL",
          "EXPERIMENT",
          "SIMULATION"
        ]
      },
      "canonical_url": {
        "anyOf": [
          {
            "$ref": "#/$defs/Uri"
          },
          {
            "type": "null"
          }
        ]
      },
      "publisher": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "null"
          }
        ]
      },
      "upstream_revision": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "null"
          }
        ]
      },
      "published_at": {
        "anyOf": [
          {
            "$ref": "#/$defs/UtcTime"
          },
          {
            "type": "null"
          }
        ]
      },
      "modified_at": {
        "anyOf": [
          {
            "$ref": "#/$defs/UtcTime"
          },
          {
            "type": "null"
          }
        ]
      },
      "retrieved_at": {
        "$ref": "#/$defs/UtcTime"
      },
      "time_status": {
        "type": "string",
        "enum": [
          "KNOWN",
          "PARTIAL",
          "UNKNOWN"
        ]
      },
      "snapshot_artifact_ref": {
        "$ref": "#/$defs/VersionRef"
      },
      "locator": {
        "type": "string",
        "minLength": 1
      },
      "independence_key": {
        "$ref": "#/$defs/Digest"
      },
      "origin_evidence_id": {
        "anyOf": [
          {
            "$ref": "#/$defs/Id"
          },
          {
            "type": "null"
          }
        ]
      },
      "discovery_urls": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/Uri"
        },
        "minItems": 0
      },
      "license_status": {
        "type": "string",
        "enum": [
          "VERIFIED",
          "UNKNOWN",
          "RESTRICTED"
        ]
      },
      "license_expression": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "null"
          }
        ]
      }
