      "stance",
      "evidence_kind",
      "source_kind",
      "canonical_url",
      "publisher",
      "upstream_revision",
      "published_at",
      "modified_at",
      "retrieved_at",
      "time_status",
      "snapshot_artifact_ref",
      "locator",
      "independence_key",
      "origin_evidence_id",
      "discovery_urls",
      "license_status",
      "license_expression"
    ],
    "additionalProperties": false
  },
