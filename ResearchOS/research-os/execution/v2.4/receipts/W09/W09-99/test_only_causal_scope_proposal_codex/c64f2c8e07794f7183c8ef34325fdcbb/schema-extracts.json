  "SearchRequest": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "minLength": 1
      },
      "snapshot_ids": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/Id"
        },
        "minItems": 1
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      },
      "expected_state_revision": {
        "$ref": "#/$defs/Revision"
      }
    },
    "required": [
      "query",
      "snapshot_ids",
      "limit",
      "expected_state_revision"
    ],
    "additionalProperties": false
  },
