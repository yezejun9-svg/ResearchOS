{
  "template_only": true,
  "not_a_qualified_decision": true,
  "decision": {
    "schema": "researchos.w09-mode-decision.v2",
    "required_fields": [
      "route",
      "mode",
      "run_id",
      "report_ref",
      "report_sha256",
      "stdout_sha256",
      "source_sha256",
      "go_executable",
      "producer_id",
      "reviewer_id",
      "reviewer_role",
      "decision",
      "input_origin",
      "independent_review_ref"
    ],
    "required_values": {
      "mode": "FIXTURE",
      "reviewer_role": "INDEPENDENT_NON_AUTHOR",
      "decision": "QUALIFIED_ONLY_AFTER_REAL_INDEPENDENT_REVIEW",
      "input_origin": "OWNED_TEMP_DIR"
    },
    "route": "exact respective tuple",
    "independent_review_ref": "typed relative path/sha256/bytes outside producer run subtree; byte-exact reviewer-authored receipt"
  },
  "review": {
    "schema": "researchos.w09-independent-mode-review.v1",
    "required_fields": [
      "actor_id",
      "actor_role",
      "producer_id",
      "run_id",
      "report_sha256",
      "source_sha256",
      "go_executable",
      "run_os",
      "run_os_release",
      "decision"
    ],
    "required_values": {
      "actor_role": "INDEPENDENT_NON_AUTHOR",
      "decision": "QUALIFIED_ONLY_AFTER_REAL_INDEPENDENT_REVIEW"
    },
    "actor_rule": "actor_id == decision.reviewer_id != producer_id"
  }
}
