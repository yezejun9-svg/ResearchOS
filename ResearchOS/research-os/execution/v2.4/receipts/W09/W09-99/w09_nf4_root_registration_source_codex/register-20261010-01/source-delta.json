          "before": "\ndef apply_profile(plan_ref):\n    ctx=activated_context(plan_ref);plan=ctx['plan'];request=ctx['request'];out=ctx['out']\n    require(plan['kind']=='PROFILE_ADOPTION','PROFILE_PLAN_ONLY')\n    require([pin(p) for p in CANON]==plan['canonical_after_refs'],'REGISTERED_CURRENT4_BEFORE_MAIN')\n    require(not (out/'apply-profile.intent.json').exists() and not (out/'main.transaction').exists(),'MAIN_ADOPTION_ALREADY_ATTEMPTED')\n    refs=ctx['refs']+plan['canonical_after_refs']+[request['formal_index_ref']]\n    refs=[r for r in refs if Path(r['path']) not in set(MAIN)]\n    def operation():\n        require([pin(p) for p in CANON]==plan['canonical_after_refs'],'GUARDED_PROFILE_CURRENT4')\n        save(out/'apply-profile.intent.json',dict(plan_ref=plan_ref,activation_ref=ctx['activation_ref'],created_utc=now_text(),\n            target_before_refs=plan['target_before_refs'],target_after_refs=plan['target_after_refs'],automatic_retry=False))\n        helper=load_module(ctx['own']['main_pair_ref'],'w09_exact_main_bytes_transaction')\n        def owned_boundary(before,after):\n            ctx['core'].validate_lease(request['lease'],now(),ctx['core'].utc(request['created_utc']))\n            # CP/OW/SS and formal index remain held; commands is now exclusively owned.\n            require([pin(p) for p in CANON[:3]]==plan['canonical_after_refs'][:3],'MAIN_WRITE_CURRENT_CANON_TRIPLE')\n            require(pin(INDEX)==request['formal_index_ref'],'FORMAL_INDEX_UNCHANGED')\n            require([pin_raw(p,b) for p,b in zip(MAIN,before)]==plan['target_before_refs']\n                    and [pin_raw(p,b) for p,b in zip(MAIN,after)]==plan['target_after_refs'],'EXACT_MAIN_TWO_BYTE_VECTORS')\n        return helper.replace_exact_pair(plan['target_before_refs'],ctx['main_after'],out/'main.transaction',owned_boundary)\n    transaction,audit=guarded(ctx,refs,operation)\n    guardref=save(out/'apply-profile.guard.closed.json',audit)\n    require([pin(p) for p in MAIN]==plan['target_after_refs'] and pin(INDEX)==request['formal_index_ref'],'MAIN_AFTER_AND_INDEX')\n    completed=dict(schema='researchos.root-w09-profile-adoption-completed.v1',status='W09_PROFILE_ADOPTED_CM40',issued_by=ROOT,\n        completed_utc=now_text(),plan_ref=plan_ref,activation_ref=ctx['activation_ref'],scope_ref=plan['scope_refs']['profile'],\n        target_after_refs=plan['target_after_refs'],canonical_after_refs=[*plan['canonical_after_refs'][:3],plan['target_after_refs'][1]],\n        formal_index_ref=request['formal_index_ref'],transaction=transaction,guard_ref=guardref,all_guards_closed=True,\n        formal_acceptance=False,parent_acceptance=False,formal_case_accepted_delta=0)\n    ref=save(out/'apply-profile.completed.json',completed)\n    return dict(status='W09_PROFILE_ADOPTED_CM40',profile_commit_ref=ref,target_after_refs=plan['target_after_refs'],\n                canonical_after_refs=completed['canonical_after_refs'])",
