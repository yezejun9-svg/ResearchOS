+def _owned_inventory(reader, relative, claims):
+    """Pin every W09 owned raw member and its complete directory inventory."""
+    text(relative, "owned directory")
+    require(relative.startswith("execution/receipts/W09/") and
+            all(part not in ("", ".", "..") for part in relative.split("/")),
+            "OWNED_SCOPE", relative)
+    root = reader.repo / relative
+    require(root.is_dir() and not root.is_symlink() and not root.is_junction()
+            and root.resolve(strict=True) == root, "OWNED_SCOPE", relative)
+    observed = []
+    for directory, dirs, files in os.walk(root, followlinks=False):
+        for name in dirs:
+            child = Path(directory) / name
+            require(not child.is_symlink() and not child.is_junction(), "OWNED_ALIAS", str(child))
+        for name in files:
+            if name.endswith(".raw"):
+                child = Path(directory) / name
+                require(child.is_file() and not child.is_symlink() and not child.is_junction(),
+                        "OWNED_ALIAS", str(child))
+                observed.append(child.relative_to(reader.repo).as_posix())
+    observed.sort()
+    rows = sequence(claims, "owned inventory claims")
+    wanted = [row["path"] for row in rows]
+    require(len(wanted) == len(set(wanted)) and sorted(wanted) == observed,
+            "OWNED_INVENTORY_CHANGED", relative)
+    for row in rows:
+        fields(row, ("path", "sha256", "bytes"), label="owned inventory member")
+        path = reader.ref({"path": row["path"], "sha256": row["sha256"]},
+                          "execution/receipts/W09/")
+        require(type(row["bytes"]) is int and path.stat().st_size == row["bytes"],
+                "OWNED_BYTES_CHANGED", row["path"])
+    return {"kind": "owned_raw", "repo": str(reader.repo), "directory": relative,
+            "members": claims, "paths_sha256": object_sha256(observed)}
+
