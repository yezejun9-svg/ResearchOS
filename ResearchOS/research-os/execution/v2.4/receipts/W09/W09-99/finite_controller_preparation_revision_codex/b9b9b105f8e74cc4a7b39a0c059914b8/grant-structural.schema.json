{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "researchos.w09.preparation-authorization-boundary.v2",
  "type": "object",
  "required": [
    "schema",
    "actor",
    "authorized",
    "actual_registration_completed",
    "status",
    "scope_ref",
    "spec_ref",
    "source_catalog_ref",
    "resource_catalog_ref",
    "runtime_catalog_ref",
    "combined_source_closure_ref",
    "canonical_original_refs",
    "canonical_desired_refs",
    "canonical_copy_refs",
    "controller_review_ref",
    "registration_review_ref",
    "registration_audit_ref",
    "registration_intent_ref",
    "registration_invocation_ref",
    "registration_manifest_ref"
  ],
  "properties": {
    "schema": {
      "const": "researchos.w09.finite-controller-root-grant.v2"
    },
    "actor": {
      "const": "codex:/root"
    },
    "authorized": {
      "const": true
    },
    "actual_registration_completed": {
      "const": true
    },
    "status": {
      "const": "ROOT_REGISTERED_EXECUTION_AUTHORIZED"
    },
    "scope_ref": {
      "$ref": "#/$defs/pin"
    },
    "spec_ref": {
      "$ref": "#/$defs/pin"
    },
    "source_catalog_ref": {
      "$ref": "#/$defs/pin"
    },
    "resource_catalog_ref": {
      "$ref": "#/$defs/pin"
    },
    "runtime_catalog_ref": {
      "$ref": "#/$defs/pin"
    },
    "combined_source_closure_ref": {
      "$ref": "#/$defs/pin"
    },
    "controller_review_ref": {
      "$ref": "#/$defs/pin"
    },
    "registration_review_ref": {
      "$ref": "#/$defs/pin"
    },
    "registration_audit_ref": {
      "$ref": "#/$defs/pin"
    },
    "registration_intent_ref": {
      "$ref": "#/$defs/pin"
    },
    "registration_invocation_ref": {
      "$ref": "#/$defs/pin"
    },
    "registration_manifest_ref": {
      "$ref": "#/$defs/pin"
    },
    "canonical_original_refs": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/pin"
      }
    },
    "canonical_desired_refs": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/pin"
      }
    },
    "canonical_copy_refs": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/pin"
      }
    }
  },
  "$defs": {
    "pin": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "description": "Structural supplement only. Pure Python validate_grant enforces actual references/semantic relation and counters; this schema alone never authorizes."
}
