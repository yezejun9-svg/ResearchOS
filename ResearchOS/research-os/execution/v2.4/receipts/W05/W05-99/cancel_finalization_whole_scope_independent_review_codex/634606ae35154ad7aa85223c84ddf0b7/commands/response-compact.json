[
  {
    "name": "CommandResponse",
    "required": [
      "protocol_version",
      "command_id",
      "method",
      "status",
      "session_id",
      "revision",
      "error_code",
      "error",
      "result"
    ],
    "properties": {
      "protocol_version": {
        "type": null,
        "maxLength": null,
        "nullable": false
      },
      "command_id": {
        "type": "string",
        "maxLength": null,
        "nullable": false
      },
      "method": {
        "type": null,
        "maxLength": null,
        "nullable": false
      },
      "status": {
        "type": null,
        "maxLength": null,
        "nullable": false
      },
      "session_id": {
        "type": null,
        "maxLength": null,
        "nullable": true
      },
      "revision": {
        "type": null,
        "maxLength": null,
        "nullable": true
      },
      "error_code": {
        "type": null,
        "maxLength": null,
        "nullable": true
      },
      "error": {
        "type": null,
        "maxLength": null,
        "nullable": true
      },
      "result": {
        "type": [
          "object",
          "null"
        ],
        "maxLength": null,
        "nullable": false
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false
    },
    "cancel_read_branch": [
      {
        "if": {
          "properties": {
            "method": {
              "const": "session.control"
            },
            "status": {
              "const": "COMPLETED"
            }
          },
          "required": [
            "method",
            "status"
          ]
        },
        "then": {
          "properties": {
            "result": {
              "$ref": "#/$defs/ControlResult"
            }
          }
        }
      }
    ]
  },
  {
    "name": "SessionSnapshot",
    "required": [
      "session_id",
      "project_id",
      "workspace_ref",
      "native_session_ref",
      "core_build_id",
      "protocol_version",
      "revision",
      "title",
      "archived_at",
      "created_at",
      "updated_at",
      "model_config_ref",
      "goal_id",
      "active_run_id",
      "run_status",
      "goal_status",
      "writer",
      "event_sequence",
      "earliest_event_sequence",
      "checkpoint_artifact_ref",
      "pending_command_ids",
      "pending_permissions",
      "resume_requires_explicit_user",
      "messages",
      "transcript_artifact_ref",
      "has_earlier_messages"
    ],
    "properties": {
      "session_id": {
        "type": "string",
        "minLength": 1
      },
      "project_id": {
        "type": "string",
        "minLength": 1
      },
      "workspace_ref": {
        "type": "string",
        "minLength": 1
      },
      "native_session_ref": {
        "type": "string",
        "minLength": 1
      },
      "core_build_id": {
        "type": "string",
        "minLength": 1
      },
      "protocol_version": {
        "const": "researchos-client/2"
      },
      "revision": {
        "type": "integer",
        "minimum": 1
      },
      "title": {
        "type": "string"
      },
      "archived_at": {
        "anyOf": [
          {
            "type": "string",
            "format": "date-time"
          },
          {
            "type": "null"
          }
        ]
      },
      "created_at": {
        "type": "string",
        "format": "date-time"
      },
      "updated_at": {
        "type": "string",
        "format": "date-time"
      },
      "model_config_ref": {
        "type": "string",
        "minLength": 1
      },
      "goal_id": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "null"
          }
        ]
      },
      "active_run_id": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "null"
          }
        ]
      },
      "run_status": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "QUEUED",
              "STARTING",
              "RUNNING",
              "CANCEL_REQUESTED",
              "SETTLED",
              "FAILED",
              "CANCELLED",
              "LOST",
              "RECONCILING"
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "goal_status": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "DRAFT",
              "ACTIVE",
              "PAUSED",
              "VERIFYING",
              "ACCEPTED",
              "BLOCKED",
              "CANCELLED",
              "NEEDS_REVALIDATION"
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "writer": {
        "anyOf": [
          {
            "$ref": "#/$defs/WriterLease"
          },
          {
            "type": "null"
          }
        ]
      },
      "event_sequence": {
        "type": "integer",
        "minimum": 0
      },
      "earliest_event_sequence": {
        "type": "integer",
        "minimum": 0
      },
      "checkpoint_artifact_ref": {
        "anyOf": [
          {
            "$ref": "#/$defs/ArtifactRef"
          },
          {
            "type": "null"
          }
        ]
      },
      "pending_command_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "maxItems": 1000
      },
      "pending_permissions": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/PermissionPrompt"
        },
        "maxItems": 100
      },
      "resume_requires_explicit_user": {
        "type": "boolean"
      },
      "messages": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/MessageRecord"
        },
        "maxItems": 200
      },
      "transcript_artifact_ref": {
        "anyOf": [
          {
            "$ref": "#/$defs/ArtifactRef"
          },
          {
            "type": "null"
          }
        ]
      },
      "has_earlier_messages": {
        "type": "boolean"
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false
    }
  },
  {
    "name": "MessageRecord",
    "required": [
      "message_id",
      "role",
      "parts",
      "complete"
    ],
    "properties": {
      "message_id": {
        "type": "string",
        "minLength": 1
      },
      "role": {
        "enum": [
          "USER",
          "ASSISTANT",
          "SYSTEM"
        ]
      },
      "parts": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/MessagePart"
        },
        "maxItems": 64
      },
      "complete": {
        "type": "boolean"
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false
    }
  },
  {
    "name": "PermissionPrompt",
    "required": [
      "request",
      "task_id",
      "run_id",
      "action_digest",
      "action_artifact_ref",
      "allowed_responses",
      "policy_allows_user_decision",
      "action_scope"
    ],
    "properties": {
      "request": {
        "allOf": [
          {
            "$ref": "domain.schema.json#/$defs/ResourceRequest"
          },
          {
            "properties": {
              "category": {
                "const": "PERMISSION"
              }
            }
          }
        ]
      },
      "task_id": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "null"
          }
        ]
      },
      "run_id": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "null"
          }
        ]
      },
      "action_digest": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      },
      "action_artifact_ref": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "allowed_responses": {
        "type": "array",
        "items": {
          "enum": [
            "ALLOW_ONCE",
            "DENY"
          ]
        },
        "maxItems": 2
      },
      "policy_allows_user_decision": {
        "type": "boolean"
      },
      "action_scope": {
        "$ref": "#/$defs/PermissionActionScope"
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false
    }
  },
  {
    "name": "WriterLease",
    "required": [
      "client_id",
      "epoch",
      "expires_at"
    ],
    "properties": {
      "client_id": {
        "type": "string",
        "minLength": 1
      },
      "epoch": {
        "type": "integer",
        "minimum": 1
      },
      "expires_at": {
        "type": "string",
        "format": "date-time"
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false
    }
  }
]
