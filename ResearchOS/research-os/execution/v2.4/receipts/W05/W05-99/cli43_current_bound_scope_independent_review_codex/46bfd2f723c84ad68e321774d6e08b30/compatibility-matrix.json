    },
    {
      "stage": "prepare -> reviewed desired files",
      "status": "STATIC_SOURCE_REVIEWED_NOT_EXECUTED",
      "source_guards": [
        "gate.load_scope",
        "review['requested_changes']==[]",
        "pin(output/name)==known[output/name]",
        "wipvalues=[scope_ref,b['current43_authority_ref'],b['controller_review_ref']]",
        "rawdesired=[encoded(desiredcp),encoded(desiredow),*before[2:]]"
      ]
    },
    {
      "stage": "prepared -> register/run/seal",
      "status": "STATIC_SOURCE_REVIEWED_NOT_EXECUTED",
      "source_guards": [
        "p['binding']==b",
        "original[2:]==desired[2:]",
        "oldcp['failure_counters']+origins(b,oldcp)",
        "protectedcp==oldcp and protectedow==oldow",
        "p['scope_ref'],b['current43_authority_ref'],b['controller_review_ref']"
      ]
    },
    {
      "stage": "independent registration review",
      "status": "STATIC_SOURCE_REVIEWED_NOT_EXECUTED",
      "source_guards": [
        "'codex:/root/w05_merge_review'",
        "d['actual_registration_executed'] is False",
        "d['canonical_before']==p['canonical_before']",
        "len(d['copied_canonical_before_refs'])==4",
        "safe(copied['path']).parent==safe(r['path']).parent"
      ]
    },
    {
      "stage": "register guarded writes",
      "status": "STATIC_SOURCE_REVIEWED_NOT_EXECUTED",
      "source_guards": [
        "'all-four immediately before replace CAS'",
        "os.replace(temp,target)",
        "expected[i]=desired[i]",
        "READS.pop(str(target),None)",
        "'post-source-guard final four CAS'",
        "'automatic_retry':False",
        "FORWARD_ONLY_REQUIRES_SEPARATE_ROOT_DECISION"
      ]
    },
    {
      "stage": "owned register actual exits",
      "status": "STATIC_SOURCE_REVIEWED_NOT_EXECUTED",
      "source_guards": [
        "helper.run_owned",
        "finally:",
        "result['actual_exit'] if result else None",
        "'actual_outer_tool_exit':None",
        "job_ok(result)"
      ]
    },
    {
      "stage": "seal -> immutable registration consumer",
      "status": "STATIC_SOURCE_REVIEWED_NOT_EXECUTED",
      "source_guards": [
        "job_ok(inv['result'])",
        "inv['actual_exit']==0",
        "'actual raw mismatch'",
        "'post-source-guard seal four CAS'",
        "ACTUAL_CANONICAL_REGISTRATION_CLOSED_NO_CASE_ACCEPTANCE",
        "x.name!='manifest.json'"
      ]
    },
    {
      "stage": "gate registration links",
      "status": "STATIC_SOURCE_REVIEWED_NOT_EXECUTED",
      "source_guards": [
        "audit['invocation_ref'] == registration['invocation']",
        "audit['intent_ref'] == registration['intent']",
        "audit['verified_ref'] == registration['verified']",
        "audit['review_ref'] == inv['review_ref']",
        "'Registration independent review'",
        "'Failure history prefix changed'"
      ]
    },
    {
      "stage": "grant exact identities/copies",
      "status": "STATIC_SOURCE_REVIEWED_NOT_EXECUTED",
      "source_guards": [
        "gate.validate_authority(reader,scope,scope_ref,preliminary,rr)",
        "first_records,first_observed=facts('admission')",
        "root.mkdir()",
        "gate.validate_authority(reader,scope,scope_ref,copies,rr)",
        "final_records,final_observed=facts('grant-final')",
        "'immediate pre-grant live four CAS'",
        "'binding':gate.binding(scope)",
        "gate.validate_grant"
      ]
    },
    {
      "stage": "gate actual grant consumer",
      "status": "STATIC_SOURCE_REVIEWED_NOT_EXECUTED",
      "source_guards": [
        "grant['scope_ref'] == scope_ref",
        "grant['binding'] == binding(scope)",
        "grant['authority_review_refs'] == authority",
        "prelaunch['runtime_resources_ref'] == scope['runtime_resources_ref']",
        "['head','status','index']",
        "observed['all_observed_inputs_pre_pinned'] is True"
      ]
    }
  ],
