165: // A settled UNKNOWN-cost ledger is left byte-for-byte intact: it is not an
166: // unknown external effect. Only original effect/dispatch state resolves that.
167: func localQualificationIdle(tx *sql.Tx) error {
168: 	for _, query := range []string{
169: 		`SELECT count(*) FROM domain_objects WHERE kind='Run' AND coalesce(json_extract(body,'$.status'),'UNKNOWN') NOT IN ('SETTLED','FAILED','CANCELLED')`,
170: 		`SELECT count(*) FROM resource_effects x WHERE sequence=(SELECT max(y.sequence) FROM resource_effects y WHERE y.project=x.project AND y.run=x.run AND y.effect_key=x.effect_key) AND json_extract(body,'$.state') IN ('PREPARED','STARTED','UNKNOWN')`,
171: 		`SELECT count(*) FROM runtime_dispatches WHERE state IN ('PREPARED','STARTED','UNKNOWN')`,
172: 	} {
173: 		var n int
174: 		if e := tx.QueryRow(query).Scan(&n); e != nil {
175: 			return e
REF {'path': 'D:\\作品集\\ResearchOS\\research-os\\internal\\host\\desktop_management_windows.go', 'sha256': 'ceadc33520229494eccef4b0738fbb5bbb83a4e0dbe5a182184832dae84b65e5', 'start': 254, 'end': 278, 'provenance': 'CURRENT_SOURCE_LOCATOR_NOT_ORIGINAL_CORE_ATTESTATION'}
254: 		bounded, cancel := context.WithTimeout(ctx, 3*time.Minute)
255: 		defer cancel()
256: 		return d.host.QualifyLocalRuntime(bounded, d.service, d.coordinator, d.apiURL, request, d.installation)
257: 	}
258: 	return nil, errors.New("unsupported operation")
259: }
