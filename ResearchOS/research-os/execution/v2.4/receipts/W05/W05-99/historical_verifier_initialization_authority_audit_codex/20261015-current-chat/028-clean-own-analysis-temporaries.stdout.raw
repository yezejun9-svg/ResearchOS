EXACT_ARGV ["powershell.exe", "-NoProfile", "-NonInteractive", "-Command", "$ErrorActionPreference = 'Stop'\n$auditRoot = (Resolve-Path -LiteralPath 'execution/v2.4/receipts/W05/W05-99/historical_verifier_initialization_authority_audit_codex/20261015-current-chat').Path\n$targets = @('analysis-cache', 'analysis-tmp', 'analysis-gopath')\nforeach ($leaf in $targets) {\n  $target = [IO.Path]::GetFullPath((Join-Path $auditRoot $leaf))\n  if (-not $target.StartsWith($auditRoot + [IO.Path]::DirectorySeparatorChar, [StringComparison]::OrdinalIgnoreCase)) { throw 'cleanup target escapes audit root' }\n  if (Test-Path -LiteralPath $target) {\n    $resolved = (Resolve-Path -LiteralPath $target).Path\n    if ($resolved -ne $target) { throw 'cleanup resolved path differs' }\n    $item = Get-Item -LiteralPath $target -Force\n    if (($item.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) { throw 'cleanup target is reparse point' }\n    $files = @(Get-ChildItem -LiteralPath $target -Recurse -File -Force)\n    Write-Output (\"verified_target=\" + $target + \" files=\" + $files.Count)\n    Remove-Item -LiteralPath $target -Recurse -Force\n    if (Test-Path -LiteralPath $target) { throw 'cleanup incomplete' }\n  } else { Write-Output (\"absent_target=\" + $target) }\n}\n"]
