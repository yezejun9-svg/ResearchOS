50: //
51: // Constructing one is supported for the private-registration pattern: a driver
52: // registered under a name of its own with sql.Register, so that its functions,
53: // collations, modules and connection hooks apply to its own connections rather
54: // than to every connection in the process. Prefer sql.Open or NewConnector for
55: // anything else.
56: type Driver struct {
57: 	// mu guards the registration state below against concurrent
58: 	// registrations. Open reads that state without it, which the ordering
59: 	// requirement in the type documentation makes safe.
60: 	mu sync.Mutex
61: 	// user defined functions that are added to every new connection on Open
62: 	udfs map[string]*userDefinedFunction
63: 	// collations that are added to every new connection on Open
64: 	collations map[string]*collation
65: 	// connection hooks are called after a connection is opened
66: 	connectionHooks []ConnectionHookFn
67: 	// modules holds registered virtual table modules that should be added to
68: 	// every new connection on Open.
69: 	modules map[string]vtab.Module
70: }
71: 
72: var d = &Driver{
73: 	udfs:            make(map[string]*userDefinedFunction, 0),
74: 	collations:      make(map[string]*collation, 0),
75: 	connectionHooks: make([]ConnectionHookFn, 0),
76: 	modules:         make(map[string]vtab.Module, 0),
77: }
78: 
79: func defaultDriver() *Driver { return d }
80: 
81: // Open returns a new connection to the database. The name is a string in a
82: // driver-specific format.
83: //
84: // Open may return a cached connection (one previously closed), but doing so is
85: // unnecessary; the sql package maintains a pool of idle connections for
86: // efficient re-use.
87: //
88: // The returned connection is only used by one goroutine at a time.
89: //
