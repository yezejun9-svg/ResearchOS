REF {'import_path': 'os', 'file': 'D:\\作品集\\ResearchOS\\research-os\\.local\\tools\\go1.27.1\\go\\src\\os\\exec_windows.go', 'line': 18, 'end_line': 53, 'name': '(*Process).wait', 'sha256': '7a3c8f10605e5ea468538b1833b04ddf609bff84999b037839ef23d99afc50c4'}
18: func (p *Process) wait() (ps *ProcessState, err error) {
19: 	handle, status := p.handleTransientAcquire()
20: 	switch status {
21: 	case statusDone:
22: 		return nil, ErrProcessDone
23: 	case statusReleased:
24: 		return nil, syscall.EINVAL
25: 	}
26: 	defer p.handleTransientRelease()
27: 
28: 	s, e := syscall.WaitForSingleObject(syscall.Handle(handle), syscall.INFINITE)
29: 	switch s {
30: 	case syscall.WAIT_OBJECT_0:
31: 		break
32: 	case syscall.WAIT_FAILED:
33: 		return nil, NewSyscallError("WaitForSingleObject", e)
34: 	default:
35: 		return nil, errors.New("os: unexpected result from WaitForSingleObject")
36: 	}
37: 	var ec uint32
38: 	e = syscall.GetExitCodeProcess(syscall.Handle(handle), &ec)
39: 	if e != nil {
40: 		return nil, NewSyscallError("GetExitCodeProcess", e)
41: 	}
42: 	var u syscall.Rusage
43: 	e = syscall.GetProcessTimes(syscall.Handle(handle), &u.CreationTime, &u.ExitTime, &u.KernelTime, &u.UserTime)
44: 	if e != nil {
45: 		return nil, NewSyscallError("GetProcessTimes", e)
46: 	}
47: 
48: 	// For compatibility we use statusReleased here rather
49: 	// than statusDone.
50: 	p.doRelease(statusReleased)
51: 
52: 	return &ProcessState{p.Pid, syscall.WaitStatus{ExitCode: ec}, &u}, nil
53: }

REF {'import_path': 'unique', 'file': 'D:\\作品集\\ResearchOS\\research-os\\.local\\tools\\go1.27.1\\go\\src\\unique\\handle.go', 'line': 33, 'end_line': 53, 'name': 'Make', 'sha256': '08c7ca3c26f66f22128d0f061e47242fc3a96e6dd765ac73d1fb8800e022c859'}
33: func Make[T comparable](value T) Handle[T] {
34: 	// Find the map for type T.
35: 	typ := abi.TypeFor[T]()
36: 	if typ.Size() == 0 {
37: 		return Handle[T]{(*T)(unsafe.Pointer(&zero))}
38: 	}
39: 	ma, ok := uniqueMaps.Load(typ)
40: 	if !ok {
41: 		m := &uniqueMap[T]{canonMap: newCanonMap[T](), cloneSeq: makeCloneSeq(typ)}
42: 		ma, _ = uniqueMaps.LoadOrStore(typ, m)
43: 	}
44: 	m := ma.(*uniqueMap[T])
45: 
46: 	// Find the value in the map.
47: 	ptr := m.Load(value)
48: 	if ptr == nil {
49: 		// Insert a new value into the map.
50: 		ptr = m.LoadOrStore(clone(value, &m.cloneSeq))
51: 	}
52: 	return Handle[T]{ptr}
53: }

REF {'import_path': 'os/exec', 'file': 'D:\\作品集\\ResearchOS\\research-os\\.local\\tools\\go1.27.1\\go\\src\\os\\exec\\exec.go', 'line': 936, 'end_line': 972, 'name': '(*Cmd).Wait', 'sha256': '3ec96eeef97a375aa5e39663961f8adf3177db9449dacd3c407fd258bc9a2498'}
936: func (c *Cmd) Wait() error {
937: 	if c.Process == nil {
938: 		return errors.New("exec: not started")
939: 	}
940: 	if c.ProcessState != nil {
941: 		return errors.New("exec: Wait was already called")
942: 	}
943: 
944: 	state, err := c.Process.Wait()
945: 	if err == nil && !state.Success() {
946: 		err = &ExitError{ProcessState: state}
947: 	}
948: 	c.ProcessState = state
949: 
950: 	var timer *time.Timer
951: 	if c.ctxResult != nil {
952: 		watch := <-c.ctxResult
953: 		timer = watch.timer
954: 		// If c.Process.Wait returned an error, prefer that.
955: 		// Otherwise, report any error from the watchCtx goroutine,
956: 		// such as a Context cancellation or a WaitDelay overrun.
957: 		if err == nil && watch.err != nil {
958: 			err = watch.err
959: 		}
960: 	}
961: 
962: 	if goroutineErr := c.awaitGoroutines(timer); err == nil {
963: 		// Report an error from the copying goroutines only if the program otherwise
964: 		// exited normally on its own. Otherwise, the copying error may be due to the
965: 		// abnormal termination.
966: 		err = goroutineErr
967: 	}
968: 	closeDescriptors(c.parentIOPipes)
969: 	c.parentIOPipes = nil
970: 
971: 	return err
972: }

REF {'import_path': 'github.com/pdfcpu/pdfcpu/pkg/font', 'file': 'D:\\作品集\\ResearchOS\\research-os\\.local\\tools\\gopath\\pkg\\mod\\github.com\\pdfcpu\\pdfcpu@v0.16.0\\pkg\\font\\metrics.go', 'line': 493, 'end_line': 507, 'name': 'doLoadUserFonts', 'sha256': '9a53c791867e15a2fdf674d2e36ba3d9bb22585a189f5698f7d1d28eefb4d44e'}
493: func doLoadUserFonts(c context.Context) error {
494: 	//fmt.Printf("*** loading userFonts from %s ***\n", UserFontDir)
495: 
496: 	loadedMetrics, err := loadUserFontMetrics(UserFontDir, c.Err)
497: 	if err != nil {
498: 		return err
499: 	}
500: 	userFontMetricsLock.Lock()
501: 	defer userFontMetricsLock.Unlock()
502: 	if err := c.Err(); err != nil {
503: 		return err
504: 	}
505: 	userFontMetrics = loadedMetrics
506: 	return nil
507: }

REF {'import_path': 'github.com/pdfcpu/pdfcpu/pkg/font', 'file': 'D:\\作品集\\ResearchOS\\research-os\\.local\\tools\\gopath\\pkg\\mod\\github.com\\pdfcpu\\pdfcpu@v0.16.0\\pkg\\font\\metrics.go', 'line': 510, 'end_line': 528, 'name': 'LoadUserFonts', 'sha256': '9a53c791867e15a2fdf674d2e36ba3d9bb22585a189f5698f7d1d28eefb4d44e'}
510: func LoadUserFonts(c context.Context) error {
511: 	if err := contextutil.Check(c); err != nil {
512: 		return err
513: 	}
514: 	loadUserFontsMutex.Lock()
515: 	defer loadUserFontsMutex.Unlock()
516: 	if err := c.Err(); err != nil {
517: 		return err
518: 	}
519: 	if loadUserFontsInitialized {
520: 		return loadUserFontsErr
521: 	}
522: 	loadUserFontsErr = doLoadUserFonts(c)
523: 	if errors.Is(loadUserFontsErr, context.Canceled) || errors.Is(loadUserFontsErr, context.DeadlineExceeded) {
524: 		return loadUserFontsErr
525: 	}
526: 	loadUserFontsInitialized = true
527: 	return loadUserFontsErr
528: }

REF {'import_path': 'github.com/pdfcpu/pdfcpu/pkg/pdfcpu/model', 'file': 'D:\\作品集\\ResearchOS\\research-os\\.local\\tools\\gopath\\pkg\\mod\\github.com\\pdfcpu\\pdfcpu@v0.16.0\\pkg\\pdfcpu\\model\\configuration.go', 'line': 795, 'end_line': 813, 'name': 'ensureDefaultConfigAt', 'sha256': '883b8f9baca332960676a69c6d863fce839650fbe16fb1e7724e871231392f86'}
795: func ensureDefaultConfigAt(path string, override bool) error {
796: 	configDir := filepath.Join(path, "pdfcpu")
797: 	if err := os.MkdirAll(configDir, 0755); err != nil {
798: 		return err
799: 	}
800: 	conf, err := ensureConfigFileAt(filepath.Join(configDir, "config.yml"), override)
801: 	if err != nil {
802: 		return err
803: 	}
804: 
805: 	if err := initializeConfigurationResourcesAt(configDir); err != nil {
806: 		return err
807: 	}
808: 
809: 	font.UserFontDir = conf.resources.userFontDir
810: 	TrustedCertDir = conf.resources.trustedCertDir
811: 	loadedDefaultConfig = conf
812: 	return nil
813: }

REF {'import_path': 'github.com/pdfcpu/pdfcpu/pkg/pdfcpu/model', 'file': 'D:\\作品集\\ResearchOS\\research-os\\.local\\tools\\gopath\\pkg\\mod\\github.com\\pdfcpu\\pdfcpu@v0.16.0\\pkg\\pdfcpu\\model\\configuration.go', 'line': 891, 'end_line': 916, 'name': 'NewDefaultConfiguration', 'sha256': '883b8f9baca332960676a69c6d863fce839650fbe16fb1e7724e871231392f86'}
891: func NewDefaultConfiguration() *Configuration {
892: 	defaultConfigMu.RLock()
893: 	conf := loadedDefaultConfig
894: 	defaultConfigMu.RUnlock()
895: 	if conf != nil {
896: 		return conf.Clone()
897: 	}
898: 
899: 	defaultConfigMu.Lock()
900: 	defer defaultConfigMu.Unlock()
901: 	if loadedDefaultConfig != nil {
902: 		return loadedDefaultConfig.Clone()
903: 	}
904: 	if ConfigPath != "disable" {
905: 		path, err := os.UserConfigDir()
906: 		if err != nil {
907: 			path = os.TempDir()
908: 		}
909: 		if err = ensureDefaultConfigAt(path, false); err == nil {
910: 			return loadedDefaultConfig.Clone()
911: 		}
912: 		fault.Fail("config problem: %w", err)
913: 	}
914: 	// Bypass config.yml
915: 	return NewStatelessConfiguration()
916: }
