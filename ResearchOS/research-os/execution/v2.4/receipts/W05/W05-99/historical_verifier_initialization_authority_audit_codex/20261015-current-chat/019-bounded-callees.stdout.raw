REF {'import_path': 'github.com/pdfcpu/pdfcpu/pkg/api', 'file': 'D:\\作品集\\ResearchOS\\research-os\\.local\\tools\\gopath\\pkg\\mod\\github.com\\pdfcpu\\pdfcpu@v0.16.0\\pkg\\api\\selectPages.go', 'line': 33, 'end_line': 40, 'name': 'setupRegExpForPageSelection', 'sha256': 'fa5d6e24cacad8b11f9cc4391c08b8e105c8a3119ea98fa398eeee2fac7daf8f'}
33: func setupRegExpForPageSelection() *regexp.Regexp {
34: 	e := "(\\d+)?-l(-\\d+)?|l(-(\\d+)-?)?"
35: 	e = "[!n]?((-\\d+)|(\\d+(-(\\d+)?)?)|" + e + ")"
36: 	e = "\\Qeven\\E|\\Qodd\\E|" + e
37: 	exp := "^" + e + "(," + e + ")*$"
38: 	re, _ := regexp.Compile(exp)
39: 	return re
40: }
