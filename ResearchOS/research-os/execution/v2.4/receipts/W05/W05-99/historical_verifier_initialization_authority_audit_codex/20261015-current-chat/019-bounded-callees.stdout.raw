REF {'import_path': 'unique', 'file': 'D:\\作品集\\ResearchOS\\research-os\\.local\\tools\\go1.27.1\\go\\src\\unique\\canonmap.go', 'line': 26, 'end_line': 35, 'name': 'newCanonMap', 'sha256': 'c2231dbb996483905d256f0c1d8cf64266fd89c63bc339e0530e536bedb5aedb'}
26: func newCanonMap[T comparable]() *canonMap[T] {
27: 	cm := new(canonMap[T])
28: 	cm.root.Store(newIndirectNode[T](nil))
29: 
30: 	var m map[T]struct{}
31: 	mapType := abi.TypeOf(m).MapType()
32: 	cm.hash = mapType.Hasher
33: 	cm.seed = uintptr(runtime_rand())
34: 	return cm
35: }
