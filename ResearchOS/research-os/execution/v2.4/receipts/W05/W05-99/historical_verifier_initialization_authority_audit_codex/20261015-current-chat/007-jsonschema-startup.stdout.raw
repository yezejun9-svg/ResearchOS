1: package jsonschema
2: 
3: import (
4: 	"embed"
5: 	"encoding/json"
6: 	"errors"
7: 	"fmt"
8: 	"io"
9: 	"io/fs"
10: 	gourl "net/url"
11: 	"os"
12: 	"path/filepath"
13: 	"runtime"
14: 	"strings"
15: )
16: 
17: // URLLoader knows how to load json from given url.
18: type URLLoader interface {
19: 	// Load loads json from given absolute url.
20: 	Load(url string) (any, error)
21: }
22: 
23: // --
24: 
25: // FileLoader loads json file url.
26: type FileLoader struct{}
27: 
28: func (l FileLoader) Load(url string) (any, error) {
29: 	path, err := l.ToFile(url)
30: 	if err != nil {
31: 		return nil, err
32: 	}
33: 	f, err := os.Open(path)
34: 	if err != nil {
35: 		return nil, err
36: 	}
37: 	defer f.Close()
38: 	return UnmarshalJSON(f)
39: }
40: 
41: // ToFile is helper method to convert file url to file path.
42: func (l FileLoader) ToFile(url string) (string, error) {
43: 	u, err := gourl.Parse(url)
44: 	if err != nil {
45: 		return "", err
46: 	}
47: 	if u.Scheme != "file" {
48: 		return "", fmt.Errorf("invalid file url: %s", u)
49: 	}
50: 	path := u.Path
51: 	if runtime.GOOS == "windows" {
52: 		path = strings.TrimPrefix(path, "/")
53: 		path = filepath.FromSlash(path)
54: 	}
55: 	return path, nil
56: }
57: 
58: // --
59: 
60: // SchemeURLLoader delegates to other [URLLoaders]
61: // based on url scheme.
62: type SchemeURLLoader map[string]URLLoader
63: 
64: func (l SchemeURLLoader) Load(url string) (any, error) {
65: 	u, err := gourl.Parse(url)
66: 	if err != nil {
67: 		return nil, err
68: 	}
69: 	ll, ok := l[u.Scheme]
70: 	if !ok {
71: 		return nil, &UnsupportedURLSchemeError{u.String()}
72: 	}
73: 	return ll.Load(url)
74: }
75: 
76: // --
77: 
78: //go:embed metaschemas
79: var metaFS embed.FS
80: 
81: func openMeta(url string) (fs.File, error) {
82: 	u, meta := strings.CutPrefix(url, "http://json-schema.org/")
83: 	if !meta {
84: 		u, meta = strings.CutPrefix(url, "https://json-schema.org/")
85: 	}
86: 	if meta {
87: 		if u == "schema" {
88: 			return openMeta(draftLatest.url)
89: 		}
90: 		f, err := metaFS.Open("metaschemas/" + u)
91: 		if err != nil {
92: 			if errors.Is(err, fs.ErrNotExist) {
93: 				return nil, nil
94: 			}
95: 			return nil, err
96: 		}
97: 		return f, err
98: 	}
99: 	return nil, nil
100: 
101: }
102: 
103: func isMeta(url string) bool {
104: 	f, err := openMeta(url)
105: 	if err != nil {
106: 		return true
107: 	}
108: 	if f != nil {
109: 		f.Close()
110: 		return true
111: 	}
112: 	return false
113: }
114: 
115: func loadMeta(url string) (any, error) {
116: 	f, err := openMeta(url)
117: 	if err != nil {
118: 		return nil, err
119: 	}
120: 	if f == nil {
121: 		return nil, nil
122: 	}
123: 	defer f.Close()
124: 	return UnmarshalJSON(f)
125: }
126: 
127: // --
128: 
129: type defaultLoader struct {
130: 	docs   map[url]any // docs loaded so far
131: 	loader URLLoader
132: }
133: 
134: func (l *defaultLoader) add(url url, doc any) bool {
135: 	if _, ok := l.docs[url]; ok {
136: 		return false
137: 	}
138: 	l.docs[url] = doc
139: 	return true
140: }
141: 
142: func (l *defaultLoader) load(url url) (any, error) {
143: 	if doc, ok := l.docs[url]; ok {
144: 		return doc, nil
145: 	}
146: 	doc, err := loadMeta(url.String())
147: 	if err != nil {
148: 		return nil, err
149: 	}
150: 	if doc != nil {
151: 		l.add(url, doc)
152: 		return doc, nil
153: 	}
154: 	if l.loader == nil {
155: 		return nil, &LoadURLError{url.String(), errors.New("no URLLoader set")}
156: 	}
157: 	doc, err = l.loader.Load(url.String())
158: 	if err != nil {
159: 		return nil, &LoadURLError{URL: url.String(), Err: err}
160: 	}
161: 	l.add(url, doc)
162: 	return doc, nil
163: }
164: 
165: func (l *defaultLoader) getDraft(up urlPtr, doc any, defaultDraft *Draft, cycle map[url]struct{}) (*Draft, error) {
166: 	obj, ok := doc.(map[string]any)
167: 	if !ok {
168: 		return defaultDraft, nil
169: 	}
170: 	sch, ok := strVal(obj, "$schema")
171: 	if !ok {
172: 		return defaultDraft, nil
173: 	}
174: 	if draft := draftFromURL(sch); draft != nil {
175: 		return draft, nil
176: 	}
177: 	sch, _ = split(sch)
178: 	if _, err := gourl.Parse(sch); err != nil {
179: 		return nil, &InvalidMetaSchemaURLError{up.String(), err}
180: 	}
181: 	schUrl := url(sch)
182: 	if up.ptr.isEmpty() && schUrl == up.url {
183: 		return nil, &UnsupportedDraftError{schUrl.String()}
184: 	}
185: 	if _, ok := cycle[schUrl]; ok {
186: 		return nil, &MetaSchemaCycleError{schUrl.String()}
187: 	}
188: 	cycle[schUrl] = struct{}{}
189: 	doc, err := l.load(schUrl)
190: 	if err != nil {
191: 		return nil, err
192: 	}
193: 	return l.getDraft(urlPtr{schUrl, ""}, doc, defaultDraft, cycle)
194: }
195: 
196: func (l *defaultLoader) getMetaVocabs(doc any, draft *Draft, vocabularies map[string]*Vocabulary) ([]string, error) {
197: 	obj, ok := doc.(map[string]any)
198: 	if !ok {
199: 		return nil, nil
200: 	}
201: 	sch, ok := strVal(obj, "$schema")
202: 	if !ok {
203: 		return nil, nil
204: 	}
205: 	if draft := draftFromURL(sch); draft != nil {
206: 		return nil, nil
207: 	}
208: 	sch, _ = split(sch)
209: 	if _, err := gourl.Parse(sch); err != nil {
210: 		return nil, &ParseURLError{sch, err}
211: 	}
212: 	schUrl := url(sch)
213: 	doc, err := l.load(schUrl)
214: 	if err != nil {
215: 		return nil, err
216: 	}
217: 	return draft.getVocabs(schUrl, doc, vocabularies)
218: }
219: 
220: // --
221: 
222: type LoadURLError struct {
223: 	URL string
224: 	Err error
225: }
