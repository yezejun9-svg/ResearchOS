16: 
17: func newRoots() *roots {
18: 	return &roots{
19: 		defaultDraft: draftLatest,
20: 		roots:        map[url]*root{},
21: 		loader: defaultLoader{
22: 			docs:   map[url]any{},
23: 			loader: FileLoader{},
24: 		},
25: 		regexpEngine: goRegexpCompile,
26: 		vocabularies: map[string]*Vocabulary{},
27: 	}
