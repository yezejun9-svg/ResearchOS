8: 
9: // A Draft represents json-schema specification.
10: type Draft struct {
11: 	version       int
12: 	url           string
13: 	sch           *Schema
14: 	id            string             // property name used to represent id
15: 	subschemas    []SchemaPath       // locations of subschemas
16: 	vocabPrefix   string             // prefix used for vocabulary
17: 	allVocabs     map[string]*Schema // names of supported vocabs with its schemas
18: 	defaultVocabs []string           // names of default vocabs
19: }
20: 
21: // String returns the specification url.
22: func (d *Draft) String() string {
23: 	return d.url
24: }
