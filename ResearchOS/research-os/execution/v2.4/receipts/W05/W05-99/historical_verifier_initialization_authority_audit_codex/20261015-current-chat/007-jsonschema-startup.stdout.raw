29: 
30: func (rr *roots) orLoad(u url) (*root, error) {
31: 	if r, ok := rr.roots[u]; ok {
32: 		return r, nil
33: 	}
34: 	doc, err := rr.loader.load(u)
35: 	if err != nil {
36: 		return nil, err
37: 	}
38: 	return rr.addRoot(u, doc)
39: }
40: 
41: func (rr *roots) addRoot(u url, doc any) (*root, error) {
42: 	r := &root{
43: 		url:                 u,
44: 		doc:                 doc,
45: 		resources:           map[jsonPointer]*resource{},
46: 		subschemasProcessed: map[jsonPointer]struct{}{},
47: 	}
48: 	if err := rr.collectResources(r, doc, u, "", dialect{rr.defaultDraft, nil}); err != nil {
49: 		return nil, err
50: 	}
51: 	if !strings.HasPrefix(u.String(), "http://json-schema.org/") &&
52: 		!strings.HasPrefix(u.String(), "https://json-schema.org/") {
53: 		if err := rr.validate(r, doc, ""); err != nil {
54: 			return nil, err
55: 		}
56: 	}
57: 
58: 	rr.roots[u] = r
59: 	return r, nil
60: }
61: 
62: func (rr *roots) resolveFragment(uf urlFrag) (urlPtr, error) {
63: 	r, err := rr.orLoad(uf.url)
64: 	if err != nil {
65: 		return urlPtr{}, err
66: 	}
67: 	return r.resolveFragment(uf.frag)
68: }
69: 
70: func (rr *roots) collectResources(r *root, sch any, base url, schPtr jsonPointer, fallback dialect) error {
71: 	if _, ok := r.subschemasProcessed[schPtr]; ok {
72: 		return nil
73: 	}
74: 	if err := rr._collectResources(r, sch, base, schPtr, fallback); err != nil {
75: 		return err
76: 	}
77: 	r.subschemasProcessed[schPtr] = struct{}{}
78: 	return nil
79: }
80: 
81: func (rr *roots) _collectResources(r *root, sch any, base url, schPtr jsonPointer, fallback dialect) error {
82: 	obj, ok := sch.(map[string]any)
83: 	if !ok {
84: 		if schPtr.isEmpty() {
85: 			// root resource
86: 			res := newResource(schPtr, base)
87: 			res.dialect = fallback
88: 			r.resources[schPtr] = res
89: 		}
90: 		return nil
91: 	}
92: 
93: 	hasSchema := false
94: 	if sch, ok := obj["$schema"]; ok {
95: 		if _, ok := sch.(string); ok {
96: 			hasSchema = true
97: 		}
98: 	}
99: 
100: 	draft, err := rr.loader.getDraft(urlPtr{r.url, schPtr}, sch, fallback.draft, map[url]struct{}{})
101: 	if err != nil {
102: 		return err
103: 	}
104: 	id := draft.getID(obj)
105: 	if id == "" && !schPtr.isEmpty() {
106: 		// ignore $schema
107: 		draft = fallback.draft
108: 		hasSchema = false
109: 		id = draft.getID(obj)
110: 	}
111: 
112: 	var res *resource
113: 	if id != "" {
114: 		uf, err := base.join(id)
115: 		if err != nil {
116: 			loc := urlPtr{r.url, schPtr}
117: 			return &ParseIDError{loc.String()}
118: 		}
119: 		base = uf.url
120: 		res = newResource(schPtr, base)
121: 	} else if schPtr.isEmpty() {
122: 		// root resource
123: 		res = newResource(schPtr, base)
124: 	}
125: 
126: 	if res != nil {
127: 		found := false
128: 		for _, res := range r.resources {
129: 			if res.id == base {
130: 				found = true
131: 				if res.ptr != schPtr {
132: 					return &DuplicateIDError{base.String(), r.url.String(), string(schPtr), string(res.ptr)}
133: 				}
134: 			}
135: 		}
136: 		if !found {
137: 			if hasSchema {
138: 				vocabs, err := rr.loader.getMetaVocabs(sch, draft, rr.vocabularies)
139: 				if err != nil {
140: 					return err
141: 				}
142: 				res.dialect = dialect{draft, vocabs}
143: 			} else {
144: 				res.dialect = fallback
145: 			}
146: 			r.resources[schPtr] = res
147: 		}
148: 	}
149: 
150: 	var baseRes *resource
151: 	for _, res := range r.resources {
152: 		if res.id == base {
153: 			baseRes = res
154: 			break
155: 		}
156: 	}
157: 	if baseRes == nil {
158: 		panic("baseres is nil")
159: 	}
160: 
161: 	// found base resource
162: 	if err := r.collectAnchors(sch, schPtr, baseRes); err != nil {
163: 		return err
164: 	}
165: 
166: 	// process subschemas
167: 	subschemas := map[jsonPointer]any{}
168: 	for _, sp := range draft.subschemas {
169: 		ss := sp.collect(obj, schPtr)
170: 		for k, v := range ss {
171: 			subschemas[k] = v
172: 		}
173: 	}
174: 	for _, vocab := range baseRes.dialect.activeVocabs(true, rr.vocabularies) {
175: 		if v := rr.vocabularies[vocab]; v != nil {
176: 			for _, sp := range v.Subschemas {
177: 				ss := sp.collect(obj, schPtr)
178: 				for k, v := range ss {
179: 					subschemas[k] = v
180: 				}
