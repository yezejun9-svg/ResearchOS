153: func (c *Compiler) enqueue(q *queue, up urlPtr) *Schema {
154: 	if sch, ok := c.schemas[up]; ok {
155: 		// already got compiled
156: 		return sch
157: 	}
158: 	if sch := q.get(up); sch != nil {
159: 		return sch
160: 	}
161: 	sch := newSchema(up)
162: 	q.append(sch)
163: 	return sch
164: }
165: 
166: // MustCompile is like [Compile] but panics if compilation fails.
167: // It simplifies safe initialization of global variables holding
168: // compiled schema.
169: func (c *Compiler) MustCompile(loc string) *Schema {
170: 	sch, err := c.Compile(loc)
171: 	if err != nil {
172: 		panic(fmt.Sprintf("jsonschema: Compile(%q): %v", loc, err))
173: 	}
174: 	return sch
175: }
176: 
177: // Compile compiles json-schema at given loc.
178: func (c *Compiler) Compile(loc string) (*Schema, error) {
179: 	uf, err := absolute(loc)
180: 	if err != nil {
181: 		return nil, err
182: 	}
183: 	up, err := c.roots.resolveFragment(*uf)
184: 	if err != nil {
185: 		return nil, err
186: 	}
187: 	return c.doCompile(up)
188: }
189: 
190: func (c *Compiler) doCompile(up urlPtr) (*Schema, error) {
191: 	q := &queue{}
192: 	compiled := 0
193: 
194: 	c.enqueue(q, up)
195: 	for q.len() > compiled {
196: 		sch := q.at(compiled)
197: 		if err := c.roots.ensureSubschema(sch.up); err != nil {
198: 			return nil, err
199: 		}
200: 		r := c.roots.roots[sch.up.url]
201: 		v, err := sch.up.lookup(r.doc)
202: 		if err != nil {
203: 			return nil, err
204: 		}
205: 		if err := c.compileValue(v, sch, r, q); err != nil {
206: 			return nil, err
207: 		}
208: 		compiled++
209: 	}
210: 	for _, sch := range *q {
211: 		c.schemas[sch.up] = sch
212: 	}
213: 	return c.schemas[up], nil
214: }
215: 
216: func (c *Compiler) compileValue(v any, sch *Schema, r *root, q *queue) error {
217: 	res := r.resource(sch.up.ptr)
218: 	sch.DraftVersion = res.dialect.draft.version
219: 
220: 	base := urlPtr{sch.up.url, res.ptr}
221: 	sch.resource = c.enqueue(q, base)
222: 
223: 	// if resource, enqueue dynamic anchors for compilation
224: 	if sch.DraftVersion >= 2020 && sch.up == sch.resource.up {
225: 		res := r.resource(sch.up.ptr)
226: 		for anchor, anchorPtr := range res.anchors {
227: 			if slices.Contains(res.dynamicAnchors, anchor) {
228: 				up := urlPtr{sch.up.url, anchorPtr}
229: 				danchorSch := c.enqueue(q, up)
230: 				if sch.dynamicAnchors == nil {
231: 					sch.dynamicAnchors = map[string]*Schema{}
232: 				}
233: 				sch.dynamicAnchors[string(anchor)] = danchorSch
234: 			}
235: 		}
236: 	}
237: 
238: 	switch v := v.(type) {
239: 	case bool:
240: 		sch.Bool = &v
241: 	case map[string]any:
242: 		if err := c.compileObject(v, sch, r, q); err != nil {
243: 			return err
244: 		}
245: 	}
