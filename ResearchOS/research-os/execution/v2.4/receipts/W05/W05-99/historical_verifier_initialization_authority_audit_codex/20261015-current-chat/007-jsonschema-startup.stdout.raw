103: 	Draft2020 = &Draft{
104: 		version: 2020,
105: 		url:     "https://json-schema.org/draft/2020-12/schema",
106: 		id:      "$id",
107: 		subschemas: joinSubschemas(Draft2019.subschemas,
108: 			schemaPath("prefixItems/[]"),
109: 		),
110: 		vocabPrefix: "https://json-schema.org/draft/2020-12/vocab/",
111: 		allVocabs: map[string]*Schema{
112: 			"core":              nil,
113: 			"applicator":        nil,
114: 			"unevaluated":       nil,
115: 			"validation":        nil,
116: 			"meta-data":         nil,
117: 			"format-annotation": nil,
118: 			"format-assertion":  nil,
119: 			"content":           nil,
120: 		},
121: 		defaultVocabs: []string{"core", "applicator", "unevaluated", "validation"},
122: 	}
123: 
124: 	draftLatest = Draft2020
125: )
126: 
127: func init() {
128: 	c := NewCompiler()
129: 	c.AssertFormat()
130: 	for _, d := range []*Draft{Draft4, Draft6, Draft7, Draft2019, Draft2020} {
131: 		d.sch = c.MustCompile(d.url)
132: 		for name := range d.allVocabs {
133: 			d.allVocabs[name] = c.MustCompile(strings.TrimSuffix(d.url, "schema") + "meta/" + name)
134: 		}
135: 	}
136: }
