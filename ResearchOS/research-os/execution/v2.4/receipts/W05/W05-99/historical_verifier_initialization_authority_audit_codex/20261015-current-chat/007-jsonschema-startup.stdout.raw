31: 		subschemas: []SchemaPath{
32: 			// type agonistic
33: 			schemaPath("definitions/*"),
34: 			schemaPath("not"),
35: 			schemaPath("allOf/[]"),
36: 			schemaPath("anyOf/[]"),
37: 			schemaPath("oneOf/[]"),
