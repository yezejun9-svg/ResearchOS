          "line": 38,
          "text": "def read_private_pipe():"
        },
        {
          "line": 39,
          "text": "    api = ctypes.WinDLL(\"kernel32\", use_last_error=True)"
        },
        {
          "line": 40,
          "text": "    api.GetFileType.argtypes = [wintypes.HANDLE]"
        },
        {
          "line": 41,
          "text": "    api.GetFileType.restype = wintypes.DWORD"
        },
        {
          "line": 42,
          "text": "    if api.GetFileType(wintypes.HANDLE(msvcrt.get_osfhandle(sys.stdin.fileno()))) != 3:"
        },
        {
          "line": 43,
          "text": "        raise ValueError(\"broker requires real private stdin pipe\")"
        },
        {
          "line": 44,
          "text": "    value = bytearray(4097)"
        },
        {
          "line": 45,
          "text": "    count = 0"
        },
        {
          "line": 46,
          "text": "    try:"
        },
        {
          "line": 47,
          "text": "        while count < len(value):"
        },
        {
          "line": 48,
          "text": "            view = memoryview(value)[count:]"
        },
        {
          "line": 49,
          "text": "            try:"
        },
        {
          "line": 50,
          "text": "                received = sys.stdin.buffer.readinto(view)"
        },
        {
          "line": 51,
          "text": "            finally:"
        },
        {
          "line": 52,
          "text": "                view.release()"
        },
        {
          "line": 53,
          "text": "            if not received:"
        },
        {
          "line": 54,
          "text": "                break"
        },
        {
          "line": 55,
          "text": "            count += received"
        },
        {
          "line": 56,
          "text": "        if not 1 <= count <= 4096:"
        },
        {
          "line": 57,
          "text": "            raise ValueError(\"broker private input size\")"
        },
        {
          "line": 58,
          "text": "        del value[count:]"
        },
        {
          "line": 59,
          "text": "        return value"
        },
        {
          "line": 60,
          "text": "    except BaseException:"
        },
        {
          "line": 61,
          "text": "        for index in range(len(value)):"
        },
        {
          "line": 62,
          "text": "            value[index] = 0"
        },
        {
          "line": 63,
          "text": "        raise"
        }
