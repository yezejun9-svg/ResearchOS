{
  "schema": "researchos.native-error-match-cases.v1",
  "go_test_executed": false,
  "cases": [
    {
      "name": "bare-exact",
      "stderr": "AUTHORITY_MIGRATION_GRANT",
      "expected": "AUTHORITY_MIGRATION_GRANT",
      "want": true
    },
    {
      "name": "standard-time-prefix",
      "stderr": "2026/10/09 05:01:02 AUTHORITY_MIGRATION_GRANT",
      "expected": "AUTHORITY_MIGRATION_GRANT",
      "want": true
    },
    {
      "name": "native-id-collision",
      "stderr": "2026/10/09 05:01:02 AUTHORITY_MIGRATION_GRANT_NATIVE_ID",
      "expected": "AUTHORITY_MIGRATION_GRANT",
      "want": false
    },
    {
      "name": "already-used-collision",
      "stderr": "2026/10/09 05:01:02 AUTHORITY_MIGRATION_GRANT_ALREADY_USED",
      "expected": "AUTHORITY_MIGRATION_GRANT",
      "want": false
    },
    {
      "name": "size-collision",
      "stderr": "2026/10/09 05:01:02 AUTHORITY_MIGRATION_GRANT_SIZE",
      "expected": "AUTHORITY_MIGRATION_GRANT",
      "want": false
    },
    {
      "name": "authority-no-expected",
      "stderr": "2026/10/09 05:01:02 AUTHORITY_PRIVATE_INHERITANCE_REQUIRED",
      "expected": "AUTHORITY_MIGRATION_GRANT",
      "want": false
    },
    {
      "name": "expected-prefix-text",
      "stderr": "2026/10/09 05:01:02 failure: AUTHORITY_MIGRATION_GRANT",
      "expected": "AUTHORITY_MIGRATION_GRANT",
      "want": false
    },
    {
      "name": "expected-suffix-text",
      "stderr": "2026/10/09 05:01:02 AUTHORITY_MIGRATION_GRANT additional detail",
      "expected": "AUTHORITY_MIGRATION_GRANT",
      "want": false
    },
    {
      "name": "unknown-log-prefix",
      "stderr": "WARN 2026/10/09 05:01:02 AUTHORITY_MIGRATION_GRANT",
      "expected": "AUTHORITY_MIGRATION_GRANT",
      "want": false
    },
    {
      "name": "invalid-date-prefix",
      "stderr": "2026/99/09 05:01:02 AUTHORITY_MIGRATION_GRANT",
      "expected": "AUTHORITY_MIGRATION_GRANT",
      "want": false
    },
    {
      "name": "fractional-prefix-not-current-format",
      "stderr": "2026/10/09 05:01:02.123456 AUTHORITY_MIGRATION_GRANT",
      "expected": "AUTHORITY_MIGRATION_GRANT",
      "want": false
    },
    {
      "name": "extra-space-after-time",
      "stderr": "2026/10/09 05:01:02  AUTHORITY_MIGRATION_GRANT",
      "expected": "AUTHORITY_MIGRATION_GRANT",
      "want": false
    },
    {
      "name": "control-error-then-root-exit-status",
      "stderr": "2026/10/09 05:01:02 AUTHORITY_MIGRATION_GRANT\n2026/10/09 05:01:02 exit status 1\n",
      "expected": "AUTHORITY_MIGRATION_GRANT",
      "want": true
    },
    {
      "name": "first-other-error-not-hidden",
      "stderr": "2026/10/09 05:01:02 AUTHORITY_RAW_PIN_MISMATCH\n2026/10/09 05:01:02 AUTHORITY_MIGRATION_GRANT\n",
      "expected": "AUTHORITY_MIGRATION_GRANT",
      "want": false
    },
    {
      "name": "crlf",
      "stderr": "2026/10/09 05:01:02 AUTHORITY_MIGRATION_GRANT\r\n2026/10/09 05:01:02 exit status 1\r\n",
      "expected": "AUTHORITY_MIGRATION_GRANT",
      "want": true
    },
    {
      "name": "blank-before-exact",
      "stderr": "\n2026/10/09 05:01:02 AUTHORITY_MIGRATION_GRANT\n",
      "expected": "AUTHORITY_MIGRATION_GRANT",
      "want": true
    },
    {
      "name": "no-error",
      "stderr": "",
      "expected": "AUTHORITY_MIGRATION_GRANT",
      "want": false
    },
    {
      "name": "empty-expected",
      "stderr": "",
      "expected": "",
      "want": false
    },
    {
      "name": "replay-exact",
      "stderr": "2026/10/09 05:01:02 AUTHORITY_MIGRATION_GRANT_ALREADY_USED",
      "expected": "AUTHORITY_MIGRATION_GRANT_ALREADY_USED",
      "want": true
    },
    {
      "name": "replay-longer-collision",
      "stderr": "2026/10/09 05:01:02 AUTHORITY_MIGRATION_GRANT_ALREADY_USED_EXTRA",
      "expected": "AUTHORITY_MIGRATION_GRANT_ALREADY_USED",
      "want": false
    },
    {
      "name": "wrong-owner-complete",
      "stderr": "2026/10/09 05:01:02 FORBIDDEN: current project Owner required",
      "expected": "FORBIDDEN: current project Owner required",
      "want": true
    },
    {
      "name": "wrong-owner-missing-fault-code",
      "stderr": "2026/10/09 05:01:02 current project Owner required",
      "expected": "FORBIDDEN: current project Owner required",
      "want": false
    },
    {
      "name": "lease-full-localized-message",
      "stderr": "2026/10/09 05:01:02 \u793a\u4f8b\u79df\u7ea6\u9519\u8bef\uff08\u4ec5\u5339\u914d\u6d4b\u8bd5\uff09",
      "expected": "\u793a\u4f8b\u79df\u7ea6\u9519\u8bef\uff08\u4ec5\u5339\u914d\u6d4b\u8bd5\uff09",
      "want": true
    },
    {
      "name": "lease-extra-prefix",
      "stderr": "2026/10/09 05:01:02 detail: \u793a\u4f8b\u79df\u7ea6\u9519\u8bef\uff08\u4ec5\u5339\u914d\u6d4b\u8bd5\uff09",
      "expected": "\u793a\u4f8b\u79df\u7ea6\u9519\u8bef\uff08\u4ec5\u5339\u914d\u6d4b\u8bd5\uff09",
      "want": false
    }
  ]
}
