+        raise ValueError("fixed proof root TEMP TMP binding differs")
+
+    def contains(parent, child):
+        parent_key, child_key = str(parent).casefold(), str(child).casefold()
+        try:
+            return os.path.commonpath([parent_key, child_key]) == parent_key
+        except ValueError:
+            return False
