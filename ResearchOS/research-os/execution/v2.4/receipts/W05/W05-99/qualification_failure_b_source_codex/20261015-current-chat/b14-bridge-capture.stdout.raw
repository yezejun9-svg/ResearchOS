	}
	if !filepath.IsAbs(request.Executable) || !strings.EqualFold(filepath.Ext(request.Executable), ".exe") {
		return nil, errors.New("trusted native executable required")
	}
	actual, e := filepath.EvalSymlinks(request.Executable)
