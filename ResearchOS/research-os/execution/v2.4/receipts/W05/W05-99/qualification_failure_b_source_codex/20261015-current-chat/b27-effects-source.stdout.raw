package domain

import (
	"context"
	"database/sql"
	"time"
)

func latestEffect(tx *sql.Tx, project, run, key string) (Object, error) {
	var raw string
	e := tx.QueryRow("SELECT body FROM resource_effects WHERE project=? AND run=? AND effect_key=? ORDER BY sequence DESC LIMIT 1", project, run, key).Scan(&raw)
	if e != nil {
		return nil, e
	}
	return Decode([]byte(raw))
}
func effectAppend(tx *sql.Tx, project, run, key string, o Object) error {
	var seq int64
	if e := tx.QueryRow("SELECT coalesce(max(sequence),0)+1 FROM resource_effects WHERE project=? AND run=? AND effect_key=?", project, run, key).Scan(&seq); e != nil {
		return e
	}
	o["sequence"] = seq
	o["observed_at"] = Now()
	_, e := tx.Exec("INSERT INTO resource_effects(project,run,effect_key,sequence,body) VALUES(?,?,?,?,?)", project, run, key, seq, string(Bytes(o)))
	return e
}
func effectsReconciled(tx *sql.Tx, project, run string) error {
	var unresolved int
	e := tx.QueryRow(`SELECT count(*) FROM resource_effects x WHERE project=? AND run=? AND sequence=(SELECT max(y.sequence) FROM resource_effects y WHERE y.project=x.project AND y.run=x.run AND y.effect_key=x.effect_key) AND json_extract(body,'$.state') IN ('STARTED','UNKNOWN')`, project, run).Scan(&unresolved)
	if e != nil {
		return e
	}
	if unresolved != 0 {
		return Fail(409, "STATE_CONFLICT", "unknown effects require reconciliation; blind retry prohibited")
	}
	return nil
}

// PrepareEffect persists intent and cost admission in one transaction before
// any provider request. The sole scheduler owns this; a worker cannot enqueue.
func (s *Service) PrepareEffect(ctx context.Context, token, project, runID, key string, payload, cost Object) (Object, error) {
	tx, e := s.DB.BeginTx(ctx, nil)
	if e != nil {
		return nil, e
	}
	defer tx.Rollback()
	result, e := s.prepareEffectTx(tx, token, project, runID, key, payload, cost)
	if e != nil {
		return nil, e
	}
	return result, tx.Commit()
}
func (s *Service) prepareEffectTx(tx *sql.Tx, token, project, runID, key string, payload, cost Object) (Object, error) {
	if e := resourceWriteLock(tx); e != nil {
		return nil, e
	}
	p, e := resourcePrincipal(tx, token, project, "SCHEDULER")
	if e != nil {
		return nil, e
	}
	if s.Contracts.Validate("Idempotency-Key", key) != nil {
		return nil, Fail(400, "INVALID_REQUEST", "stable effect key required")
	}
	digest := Hash([]any{payload, cost})
	prior, e := latestEffect(tx, project, runID, key)
	if e == nil {
		if prior["request_hash"] != digest {
			return nil, Fail(409, "IDEMPOTENCY_CONFLICT", "effect key payload changed")
		}
		return prior, nil
	}
	if e != sql.ErrNoRows {
		return nil, e
	}
	run, e := load(tx, project, "Run", runID)
	if e != nil {
		return nil, e
	}
	task, e := load(tx, project, "Task", Str(run, "task_id"))
	if e != nil {
		return nil, e
	}
	if e = qualificationEffectBlocked(tx, project, task); e != nil {
		if e = qualificationModelEffectAllowed(tx, project, task, payload); e != nil {
			return nil, e
		}
	}
	goal, e := load(tx, project, "Goal", Str(task, "goal_id"))
	if e != nil {
		return nil, e
	}
	if task["active_run_id"] != runID || goal["status"] != "ACTIVE" || runTerminal(run) || run["status"] == "CANCEL_REQUESTED" {
		return nil, Fail(409, "STATE_CONFLICT", "run is not permitted new effects")
	}
	if e = s.taskContextForRun(tx, project, run); e != nil {
		return nil, e
	}
	if e = effectsReconciled(tx, project, runID); e != nil {
		return nil, e
	}
	if cost["run_id"] != runID || cost["provider_request_id"] != key || cost["reservation_id"] != nil || (cost["operation"] != "RESERVE" && cost["operation"] != "UNKNOWN") {
		return nil, Fail(422, "GATE_FAILED", "effect must bind a new reservation")
	}
	if e = s.Contracts.Validate("CostEntryRequest", cost); e != nil {
		return nil, Fail(400, "INVALID_REQUEST", "invalid cost request")
	}
	ledger, e := s.appendBudget(tx, project, cost)
	if e != nil {
		return nil, e
	}
	o := Object{"project_id": project, "goal_id": goal["id"], "task_id": task["id"], "run_id": runID, "key": key, "request_hash": digest, "payload": payload, "reservation_id": ledger["id"], "state": "PREPARED", "epoch": run["lease_epoch"], "context_bundle_id": task["context_bundle_id"], "checkpoint_artifact_id": run["checkpoint_artifact_id"], "receipt": nil}
	if e = effectAppend(tx, project, runID, key, o); e != nil {
		return nil, e
	}
	if e = s.event(tx, project, "Run", run, p.ID, ID(), "RUN_CHANGED"); e != nil {
		return nil, e
	}
	return o, nil
}

// BeginEffect is an atomic one-time dispatch fence. A lost acknowledgement is
// STARTED/UNKNOWN until trusted reconciliation, even when retries remain.
func (s *Service) BeginEffect(ctx context.Context, token, project, runID, key string) (Object, error) {
	tx, e := s.DB.BeginTx(ctx, nil)
	if e != nil {
		return nil, e
	}
	defer tx.Rollback()
	result, e := s.beginEffectTx(tx, token, project, runID, key)
	if e != nil {
		return nil, e
	}
	return result, tx.Commit()
}
func (s *Service) beginEffectTx(tx *sql.Tx, token, project, runID, key string) (Object, error) {
	if e := resourceWriteLock(tx); e != nil {
		return nil, e
	}
	_, e := resourcePrincipal(tx, token, project, "SCHEDULER")
	if e != nil {
		return nil, e
	}
	o, e := latestEffect(tx, project, runID, key)
	if e != nil {
		return nil, e
	}
	if o["state"] != "PREPARED" {
		return nil, Fail(409, "STATE_CONFLICT", "already dispatched; query provider before recovery")
	}
	run, e := load(tx, project, "Run", runID)
	if e != nil {
		return nil, e
	}
	task, e := load(tx, project, "Task", Str(run, "task_id"))
	if e != nil {
		return nil, e
	}
	if e = qualificationEffectBlocked(tx, project, task); e != nil {
		payload, _ := o["payload"].(map[string]any)
		if e = qualificationModelEffectAllowed(tx, project, task, payload); e != nil {
			return nil, e
		}
	}
	goal, e := load(tx, project, "Goal", Str(task, "goal_id"))
	if e != nil {
		return nil, e
	}
	if goal["status"] != "ACTIVE" || task["status"] != "RUNNING" || runTerminal(run) || run["status"] == "CANCEL_REQUESTED" || task["active_run_id"] != runID {
		return nil, Fail(409, "STATE_CONFLICT", "run stopped or superseded")
	}
	expiry, e := time.Parse(time.RFC3339Nano, Str(run, "lease_expires_at"))
	if e != nil || !expiry.After(time.Now()) {
		return nil, Fail(409, "LEASE_EXPIRED", "expired lease cannot start effect")
	}
	if e = s.taskContextForRun(tx, project, run); e != nil {
		return nil, e
	}
	ledger, e := load(tx, project, "BudgetLedgerEntry", Str(o, "reservation_id"))
	if e != nil {
		return nil, e
	}
	var lastCost string
	if e = tx.QueryRow("SELECT json_extract(body,'$.operation') FROM domain_objects WHERE project=? AND kind='BudgetLedgerEntry' AND json_extract(body,'$.run_id')=? AND json_extract(body,'$.provider_request_id')=? ORDER BY rowid DESC LIMIT 1", project, runID, key).Scan(&lastCost); e != nil {
		return nil, e
	}
	if lastCost != "RESERVE" && lastCost != "UNKNOWN" {
		return nil, Fail(409, "STATE_CONFLICT", "settled or released cost cannot authorize a new effect")
	}
	chain, _, e := runBudgetScopes(tx, project, runID)
	if e != nil {
		return nil, e
	}
	for _, policy := range chain {
		if policy["mode"] != "CAPPED" {
			continue
		}
		if ledger["money"] == nil {
			if policy["enforcement"] == "STRICT" || policy["unknown_cost_action"] == "BLOCK" {
				return nil, Fail(422, "GATE_FAILED", "current policy cannot bound prepared effect")
			}
			continue
		}
		if policy["enforcement"] == "STRICT" && ledger["cost_basis"] != "UPPER_BOUND" {
			return nil, Fail(422, "GATE_FAILED", "current policy cannot bound prepared effect")
		}
		cap := policy["cap"].(map[string]any)
		used, unknown, e := budgetExposure(tx, policy, Str(cap, "currency"))
		if e != nil {
			return nil, e
		}
		limit, _ := moneyAmount(cap)
		if unknown && (policy["enforcement"] == "STRICT" || policy["unknown_cost_action"] == "BLOCK") || used.Cmp(limit) > 0 {
			return nil, Fail(422, "GATE_FAILED", "tightened policy blocks unissued effect")
		}
	}
	o["state"] = "STARTED"
	o["epoch"] = run["lease_epoch"]
	if e = effectAppend(tx, project, runID, key, o); e != nil {
		return nil, e
	}
	return o, nil
}

// ObserveEffect is the trusted worker/provider reconciliation boundary, like
// ObserveRuntime. No public HTTP endpoint accepts invented provider outcomes.
func (s *Service) ObserveEffect(ctx context.Context, project, runID, key, state string, receipt Object) error {
	if (state != "CONFIRMED" && state != "UNKNOWN" && state != "NOT_APPLIED") || len(receipt) == 0 {
		return Fail(400, "INVALID_REQUEST", "trusted outcome and receipt required")
	}
	tx, e := s.DB.BeginTx(ctx, nil)
	if e != nil {
		return e
	}
	defer tx.Rollback()
	if e = resourceWriteLock(tx); e != nil {
		return e
	}
	o, e := latestEffect(tx, project, runID, key)
	if e != nil {
		return e
	}
	if o["state"] == state && Hash(o["receipt"]) == Hash(receipt) {
		return nil
	}
	if o["state"] == "CONFIRMED" || o["state"] == "NOT_APPLIED" || o["state"] == "PREPARED" {
		return Fail(409, "STATE_CONFLICT", "effect outcome cannot be rewritten")
	}
	o["state"] = state
	o["receipt"] = receipt
	if e = effectAppend(tx, project, runID, key, o); e != nil {
		return e
	}
	return tx.Commit()
}

// ResumeCheckpoint rebuilds current context after trusted process/effect
// reconciliation. It retains Run identity and all provider keys, rotating only
// the execution lease so old callbacks cannot change the resumed run.
func (s *Service) ResumeCheckpoint(ctx context.Context, token, project, runID, key string, expectedRevision int64) (Object, error) {
	tx, e := s.DB.BeginTx(ctx, nil)
	if e != nil {
		return nil, e
	}
	defer tx.Rollback()
	if e = resourceWriteLock(tx); e != nil {
		var raw []byte
		if err = tx.QueryRow("SELECT bytes FROM uploaded_content WHERE project=? AND storage_key=? AND sealed=1", project, a["storage_key"]).Scan(&raw); err != nil {
			return nil, err
		}
		if Digest(raw) != a["content_hash"] || !utf8.Valid(raw) {
			return nil, Fail(422, "GATE_FAILED", "Mu input artifact seal or UTF-8 mismatch")
		}
		if Hash(ref) == Hash(admission["profile_ref"]) {
			continue // Host control input stays hash-bound, never user prompt text.
		}
		request["artifact_inputs"] = append(Arr(request, "artifact_inputs"), Object{"id": a["id"], "content_hash": a["content_hash"], "media_type": a["media_type"], "path": "artifacts/" + Str(a, "id")})
		attachments = append(attachments, Object{"id": a["id"], "content_hash": a["content_hash"], "media_type": a["media_type"], "text": string(raw)})
	}
	prompt := Merge(request, Object{"attachments": attachments})
	history, ledger := Empty(), Empty()
	rows, err := tx.Query("SELECT rowid,body FROM resource_effects WHERE project=? AND run=? ORDER BY effect_key,sequence", project, run["id"])
	if err != nil {
		return nil, err
	}
	for rows.Next() {
		var raw string
		var position int64
		if err = rows.Scan(&position, &raw); err != nil {
			rows.Close()
			return nil, err
		}
		o, e := Decode([]byte(raw))
		if e != nil {
			rows.Close()
			return nil, e
		}
		// Local append order is read from SQLite, never accepted from a worker.
		// It proves MODEL -> TOOL -> MODEL ordering without trusting wall time.
		o["_journal_position"] = position
		history = append(history, o)
	}
	err = rows.Err()
	rows.Close()
	if err != nil {
		return nil, err
	}
	rows, err = tx.Query("SELECT body FROM domain_objects WHERE project=? AND kind='BudgetLedgerEntry' AND json_extract(body,'$.run_id')=? ORDER BY id", project, run["id"])
	if err != nil {
		return nil, err
	}
	for rows.Next() {
		var raw string
		if err = rows.Scan(&raw); err != nil {
			rows.Close()
			return nil, err
		}
		o, e := Decode([]byte(raw))
		if e != nil {
			rows.Close()
			return nil, e
		}
		ledger = append(ledger, o)
	}
	err = rows.Err()
	rows.Close()
	if err != nil {
		return nil, err
	}
	snapshot := Object{"dispatch": dispatch, "profile": profile, "request": request, "prompt": prompt, "effects": history, "ledger": ledger}
	// UNKNOWN has no reserve bound to verify. Carry the real current run scopes
	// into both acceptance snapshots; policy changes invalidate their hash.
	if profile["max_cost"] == nil {
		policies, leaves, e := runBudgetScopes(tx, project, Str(run, "id"))
		if e != nil {
			return nil, e
		}
		sort.Slice(policies, func(i, j int) bool { return Str(policies[i], "id") < Str(policies[j], "id") })
		values := Empty()
		for _, policy := range policies {
			values = append(values, policy)
		}
		snapshot["unknown_budget"] = Object{"goal": goal, "policies": values, "leaves": leaves}
	}
	stream, err := s.modelStreamAcceptanceSnapshot(tx, project, run)
	if err != nil {
		return nil, err
	}
	if stream != nil {
		snapshot["model_stream"] = stream
	}
	return snapshot, nil
}

type muAssistant struct {
	Text, Thinking, Stop string
	Calls                []Object
}

// Parse the broker's bounded original SSE, independently of the SDK artifact.
func muResponse(raw string) (muAssistant, error) {
	result := muAssistant{Calls: []Object{}}
	if !completeRuntimeModelSSE([]byte(raw)) {
		return result, fmt.Errorf("incomplete model SSE")
	}
	calls := map[int64]Object{}
	for _, event := range strings.Split(strings.ReplaceAll(raw, "\r\n", "\n"), "\n\n") {
		data := []string{}
		for _, line := range strings.Split(event, "\n") {
			if strings.HasPrefix(line, "data:") {
				data = append(data, strings.TrimPrefix(strings.TrimPrefix(line, "data:"), " "))
			}
		}
		payload := strings.Join(data, "\n")
		if payload == "" || payload == "[DONE]" {
			continue
		}
		chunk, err := Decode([]byte(payload))
		if err != nil || chunk["error"] != nil {
			return result, fmt.Errorf("model error or malformed SSE")
		}
		choices := Arr(chunk, "choices")
		if len(choices) == 0 {
			continue
		}
		if len(choices) != 1 {
			return result, fmt.Errorf("multiple model choices")
		}
		choice, ok := choices[0].(map[string]any)
		if !ok {
			return result, fmt.Errorf("malformed choice")
		}
		index, err := Num(choice, "index")
		if err != nil || index != 0 {
			return result, fmt.Errorf("unexpected model choice")
		}
		delta, _ := choice["delta"].(map[string]any)
		if result.Stop != "" && (len(delta) > 0 || choice["finish_reason"] != nil) {
			return result, fmt.Errorf("data after model finish")
		}
		if delta["role"] != nil && delta["role"] != "assistant" {
package domain

import (
	"context"
	"database/sql"
	"encoding/base64"
	"encoding/json"
	"errors"
	"strings"
	"time"
	"unicode/utf8"
)

// ClientSessionRuntime is supplied by the host composition root. It must only
// inspect current bindings/admission in this transaction: it must never launch a
// worker, make a provider request, or open a second database transaction.
type ClientSessionRuntime interface {
	ValidateBinding(ctx context.Context, tx *sql.Tx, principal, project, workspaceRef, modelConfigRef string) error
	AdmitTurn(ctx context.Context, tx *sql.Tx, project, modelConfigRef string, task Object) error
}

func clientAuthenticatedPrincipal(ctx context.Context, tx *sql.Tx, id string) (Principal, error) {
	p := Principal{ID: id}
	var roles string
	if err := tx.QueryRowContext(ctx, "SELECT roles,can_create_project FROM auth_principals WHERE id=? AND revoked=0", id).Scan(&roles, &p.CanCreateProject); err != nil {
		return p, Fail(403, "FORBIDDEN", "current principal required")
	}
	if err := json.Unmarshal([]byte(roles), &p.Roles); err != nil {
		return p, err
	}
	rows, err := tx.QueryContext(ctx, "SELECT project,task,run,restricted FROM auth_grants WHERE principal=?", id)
	if err != nil {
		return p, err
	}
	for rows.Next() {
		var g Grant
		if err = rows.Scan(&g.ProjectID, &g.TaskID, &g.RunID, &g.Restricted); err != nil {
			rows.Close()
			return p, err
		}
		p.Grants = append(p.Grants, g)
	}
	err = rows.Err()
	rows.Close()
	if err != nil {
		return p, err
	}
	if err = constrainRemotePrincipal(tx, &p); err != nil {
		return p, err
	}
	return p, nil
}

func clientPrincipal(ctx context.Context, tx *sql.Tx, id, project string, owner bool) (Principal, error) {
	p, err := clientAuthenticatedPrincipal(ctx, tx, id)
	if err != nil {
		return p, err
	}
	if !p.Allowed(project, "", "", false) || owner && !p.HasRole("OWNER") {
		return p, Fail(403, "FORBIDDEN", "current project Owner required for session writes")
	}
	return p, nil
}

// A real project-level goal.start can create a mapped session. Its response has
// a null top-level session_id and the created identity in result.snapshot. A
// session-scoped goal.start has a non-null top-level session_id, so it is never
// mistaken for a second creation receipt. Conflicting receipts fail closed.
func clientSessionCreationPrincipal(ctx context.Context, tx *sql.Tx, project, session string) (string, error) {
	rows, err := tx.QueryContext(ctx, `SELECT project,principal FROM idempotency WHERE
