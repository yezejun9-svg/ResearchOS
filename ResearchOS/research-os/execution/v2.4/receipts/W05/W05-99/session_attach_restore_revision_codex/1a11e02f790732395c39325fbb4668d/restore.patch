+// clientAttachRestoreState reads durable restore evidence before any writer write.
+// renew is false until the current session generation has a real post-restore
+// CLIENT_HANDOFF, preceded by a matching fresh settled observation.
+func clientAttachRestoreState(ctx context.Context, tx *sql.Tx, sess *clientSessionRow) (renew, ready bool, err error) {
+	if sess.runID == "" {
+		return true, true, nil
+	}
+	var barrier sql.NullString
+	if err = tx.QueryRowContext(ctx, "SELECT max(restored_at) FROM backup_restore_barriers WHERE project=? AND run=?", sess.project, sess.runID).Scan(&barrier); err != nil {
+		return false, false, err
+	}
+	if !barrier.Valid {
+		return true, true, nil
+	}
+	restored, parseErr := time.Parse(time.RFC3339Nano, barrier.String)
+	if parseErr != nil {
+		return false, false, nil
+	}
+	run, err := load(tx, sess.project, "Run", sess.runID)
+	if err != nil {
+		return false, false, err
+	}
+	epoch, epochErr := Num(run, "lease_epoch")
+	if epochErr != nil || epoch < 1 || run["children_stopped"] != true || run["queue_empty"] != true {
+		return false, false, nil
+	}
+	rows, err := tx.QueryContext(ctx, "SELECT body,observed_at,receipt_hash FROM runtime_observations WHERE project=? AND run=? AND epoch=? ORDER BY observed_at DESC,receipt_hash DESC", sess.project, sess.runID, epoch)
+	if err != nil {
+		return false, false, err
+	}
+	var firstFresh time.Time
+	latest := true
+	for rows.Next() {
+		var raw, timestamp, receipt string
+		if err = rows.Scan(&raw, &timestamp, &receipt); err != nil {
+			rows.Close()
+			return false, false, err
+		}
+		observed, timeErr := time.Parse(time.RFC3339Nano, timestamp)
+		observation, decodeErr := Decode([]byte(raw))
+		spec, _ := observation["spec"].(map[string]any)
+		observedEpoch, identityErr := Num(spec, "epoch")
+		valid := timeErr == nil && observed.After(restored) && decodeErr == nil &&
+			receipt == Hash(observation) && identityErr == nil && observedEpoch == epoch &&
+			Str(spec, "run_id") == sess.runID && Str(spec, "task_id") == Str(run, "task_id") &&
+			observation["children_stopped"] == true && observation["queue_empty"] == true
+		// A later partial observation must not be hidden by an older settled one.
+		if latest && !valid {
+			rows.Close()
+			return false, false, nil
+		}
+		latest = false
+		if valid && (firstFresh.IsZero() || observed.Before(firstFresh)) {
+			firstFresh = observed
+		}
+	}
+	if err = rows.Err(); err != nil {
+		rows.Close()
+		return false, false, err
+	}
+	if err = rows.Close(); err != nil {
+		return false, false, err
+	}
+	if firstFresh.IsZero() {
+		return false, false, nil
+	}
+	events, err := tx.QueryContext(ctx, "SELECT body FROM outbox WHERE project=? AND json_extract(body,'$.session_id')=? AND json_extract(body,'$.run_id')=? AND json_extract(body,'$.kind')='CLIENT_HANDOFF' ORDER BY json_extract(body,'$.sequence') DESC", sess.project, sess.sessionID, sess.runID)
+	if err != nil {
+		return false, false, err
+	}
+	defer events.Close()
+	for events.Next() {
+		var raw string
+		if err = events.Scan(&raw); err != nil {
+			return false, false, err
+		}
+		var event SessionEvent
+		if json.Unmarshal([]byte(raw), &event) != nil || event.Sequence == nil ||
+			*event.Sequence < 1 || *event.Sequence > sess.watermark || deref(event.CommandID) == "" ||
+			deref(event.SessionID) != sess.sessionID || deref(event.RunID) != sess.runID ||
+			deref(event.Kind) != "CLIENT_HANDOFF" || deref(event.ProtocolVersion) != ProtocolV2 {
+			continue
+		}
+		payload, decodeErr := Decode(event.Payload)
+		writer, _ := payload["writer"].(map[string]any)
+		writerEpoch, writerErr := Num(writer, "epoch")
+		previousEpoch, previousErr := Num(payload, "previous_epoch")
+		effective, timeErr := time.Parse(time.RFC3339Nano, Str(payload, "effective_at"))
+		expires, expiryErr := time.Parse(time.RFC3339Nano, Str(writer, "expires_at"))
+		if decodeErr == nil && writerErr == nil && previousErr == nil && timeErr == nil && expiryErr == nil &&
+			writerEpoch == sess.epoch && previousEpoch == sess.epoch-1 &&
+			Str(payload, "target_client_id") == sess.writerClientID && Str(writer, "client_id") == sess.writerClientID &&
+			effective.After(restored) && !effective.Before(firstFresh) && expires.After(effective) {
+			return true, true, nil
+		}
+	}
+	if err = events.Err(); err != nil {
+		return false, false, err
+	}
+	// Fresh runtime evidence exists, but the restored session still needs one
+	// real handoff through the existing epoch/CAS/journal transaction.
+	return false, true, nil
+}
