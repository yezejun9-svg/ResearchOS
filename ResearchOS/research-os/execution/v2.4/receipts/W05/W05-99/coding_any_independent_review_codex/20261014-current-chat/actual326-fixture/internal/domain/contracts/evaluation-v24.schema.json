{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchos.invalid/evaluation-v24.schema.json",
  "$ref": "#/$defs/EvaluationReport",
  "$defs": {
    "Amount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "Currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "EvaluationCaseResult": {
      "type": "object",
      "properties": {
        "case_id": {
          "$ref": "#/$defs/Id"
        },
        "verdict": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "ERROR",
            "ABSTAIN",
            "MISSING"
          ]
        },
        "hard_checks_passed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "score": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "latency_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "cost": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ]
        },
        "output_artifact_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/VersionRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "case_id",
        "verdict",
        "hard_checks_passed",
        "score",
        "reason",
        "latency_ms",
        "cost",
        "output_artifact_ref"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "hard_checks_passed": {
                "const": false
              }
            },
            "required": [
              "hard_checks_passed"
            ]
          },
          "then": {
            "properties": {
              "verdict": {
                "not": {
                  "const": "PASS"
                }
              }
            }
          }
        }
      ]
    },
    "EvaluationCounts": {
      "type": "object",
      "properties": {
        "expected_count": {
          "type": "integer",
          "minimum": 1
        },
        "observed_count": {
          "type": "integer",
          "minimum": 0
        },
        "pass_count": {
          "type": "integer",
          "minimum": 0
        },
        "fail_count": {
          "type": "integer",
          "minimum": 0
        },
        "error_count": {
          "type": "integer",
          "minimum": 0
        },
        "abstain_count": {
          "type": "integer",
          "minimum": 0
        },
        "missing_count": {
          "type": "integer",
          "minimum": 0
        },
        "duplicate_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "expected_count",
        "observed_count",
        "pass_count",
        "fail_count",
        "error_count",
        "abstain_count",
        "missing_count",
        "duplicate_count"
      ],
      "additionalProperties": false
    },
    "EvaluationReport": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "2.4.0"
        },
        "report_id": {
          "$ref": "#/$defs/Id"
        },
        "project_id": {
          "$ref": "#/$defs/Id"
        },
        "experiment_id": {
          "$ref": "#/$defs/Id"
        },
        "run_id": {
          "$ref": "#/$defs/Id"
        },
        "external_eval_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "engine": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "enum": [
                "PROMPTFOO",
                "NATIVE",
                "SKILL_UP"
              ]
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "config_hash": {
              "$ref": "#/$defs/Digest"
            }
          },
          "required": [
            "name",
            "version",
            "config_hash"
          ],
          "additionalProperties": false
        },
        "dataset_split": {
          "type": "string",
          "enum": [
            "DEVELOPMENT",
            "HOLDOUT"
          ]
        },
        "access_class": {
          "type": "string",
          "enum": [
            "PROJECT",
            "VERIFIER_ONLY"
          ]
        },
        "dataset_hash": {
          "$ref": "#/$defs/Digest"
        },
        "candidate_hash": {
          "$ref": "#/$defs/Digest"
        },
        "baseline_hash": {
          "$ref": "#/$defs/Digest"
        },
        "rubric_hash": {
          "$ref": "#/$defs/Digest"
        },
        "expected_case_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvaluationCaseResult"
          },
          "minItems": 1
        },
        "counts": {
          "$ref": "#/$defs/EvaluationCounts"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "cost": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ]
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "integrity_status": {
          "type": "string",
          "enum": [
            "COMPLETE",
            "INCOMPLETE",
            "INVALID"
          ]
        },
        "raw_artifact_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VersionRef"
          },
          "minItems": 0
        },
        "created_at": {
          "$ref": "#/$defs/UtcTime"
        }
      },
      "required": [
        "schema_version",
        "report_id",
        "project_id",
        "experiment_id",
        "run_id",
        "external_eval_id",
        "engine",
        "dataset_split",
        "access_class",
        "dataset_hash",
        "candidate_hash",
        "baseline_hash",
        "rubric_hash",
        "expected_case_ids",
        "results",
        "counts",
        "duration_ms",
        "cost",
        "exit_code",
        "integrity_status",
        "raw_artifact_refs",
        "created_at"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "dataset_split": {
                "const": "HOLDOUT"
              }
            },
            "required": [
              "dataset_split"
            ]
          },
          "then": {
            "properties": {
              "access_class": {
                "const": "VERIFIER_ONLY"
              }
            }
          }
        }
      ]
    },
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "Money": {
      "type": "object",
      "properties": {
        "amount": {
          "$ref": "#/$defs/Amount"
        },
        "currency": {
          "$ref": "#/$defs/Currency"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "additionalProperties": false
    },
    "Revision": {
      "type": "integer",
      "minimum": 1
    },
    "UtcTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "VersionRef": {
      "type": "object",
      "properties": {
        "entity_type": {
          "type": "string",
          "enum": [
            "ProjectProfile",
            "ProjectState",
            "Requirement",
            "Goal",
            "Task",
            "Run",
            "Artifact",
            "Evidence",
            "ResearchCycle",
            "Experiment",
            "DecisionReceipt",
            "Qualification",
            "ContextBundle",
            "ChangeProposal",
            "ImpactLink",
            "BudgetPolicy",
            "RunPolicy",
            "ResourceRequest",
            "MilestoneRelease",
            "ProgressProjection",
            "SkillVersion",
            "SystemCandidate",
            "AcceptanceReceipt",
            "AgentMessage",
            "SourceCursor",
            "BudgetLedgerEntry",
            "NoProgressRecord",
            "RuntimeRegistration",
            "Notification",
            "Conflict",
            "EventEnvelope"
          ]
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "content_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "entity_type",
        "id",
        "revision",
        "content_hash"
      ],
      "additionalProperties": false,
      "description": "实体类型必须是本文件核心实体名；服务器验证项目归属、存在性和当前版本。不可变对象 revision 恒为1。"
    }
  },
  "x-source": {
    "package_version": "2.4.0",
    "source_path": "contracts/domain.schema.json",
    "source_sha256": "b53d9e6eddfeed89d27ee65c378d8067ae8b0c46de2ba2a098856a7557df1c54",
    "derivation": "Exact transitive $defs closure from EvaluationReport; no thresholds, properties or required fields changed."
  }
}
