apps/desktop/main/main.js
1: // ResearchOS Desktop main (W13-01 increment on the W02-03 thin shell).
2: //
3: // It still does not start a second business scheduler: it discovers the existing Go control host, starts it
4: // when it is genuinely unreachable, and exposes the four native clients through the channels declared in
5: // main/lib/ipc.js. The registration and the routing are pure functions of injected collaborators, so
6: // tests/ui/check drives them without an Electron runtime; what only a real session can prove stays disclosed.
7: const { app, BrowserWindow, ipcMain, dialog, protocol } = require('electron');
8: const childProcess = require('node:child_process');
9: const crypto = require('node:crypto');
10: const http = require('node:http');
11: const fs = require('node:fs');
12: const path = require('node:path');
13: const { TextDecoder } = require('node:util');
14: const host = require('./lib/host.js');
15: const ipc = require('./lib/ipc.js');
16: const { createTransport } = require('./lib/http-wire.js');
17: const native = require('./lib/native.js');
18: const { createAppProtocol, routeTable, APP_ORIGIN } = require('./lib/app-protocol.js');
19: const { chooseWorkspace } = require('./lib/first-use.js');
20: const { createContextStore } = require('./lib/context.js');
21: const { createDesktopManagement } = require('./lib/desktop-management.js');
22: 
23: protocol.registerSchemesAsPrivileged([{ scheme: 'ros-app', privileges: {
24:   standard: true, secure: true, supportFetchAPI: true, stream: true, corsEnabled: false,
25: } }]);
26: if (process.env.RESEARCHOS_DESKTOP_USER_DATA) {
27:   const isolatedUserData = path.resolve(process.env.RESEARCHOS_DESKTOP_USER_DATA);
28:   fs.mkdirSync(isolatedUserData, { recursive: true });
29:   app.setPath('userData', isolatedUserData);
30: }
31: 
32: const ROOT = path.resolve(__dirname, '..');
33: const validatedV2Transport = createTransport({ appRoot: ROOT });
34: const REPO = path.resolve(ROOT, '..', '..');
35: const WEB_DIST = path.join(REPO, 'apps', 'web', 'dist');
36: const DISCOVERY = path.resolve(REPO, process.env.RESEARCHOS_CLI_DISCOVERY ||
37:   process.env.RESEARCHOS_HOST_DISCOVERY || path.join('.local', 'v24_host.json'));
38: const PRINCIPAL = path.join(REPO, '.local', 'v24_principal.json');
39: const SMOKE = process.env.ROS_DESKTOP_SMOKE === '1';
40: const configuredCore = process.env.RESEARCHOS_CONTROL_EXE || '';
41: const coreExecutable = configuredCore ? path.resolve(REPO, configuredCore) : path.join(ROOT, 'resources', 'control', 'researchos-control.exe');
42: const dataRoot = path.resolve(REPO, process.env.RESEARCHOS_DATA_DIR || path.join('.local', 'data'));
43: const verifierManifest = process.env.RESEARCHOS_DESKTOP_VERIFIER_MANIFEST ||
44:   path.join(path.dirname(coreExecutable), 'runtime-verifier-installation.json');
45: const runtimeAssetsDir = process.env.RESEARCHOS_DESKTOP_RUNTIME_ASSETS_DIR ||
46:   path.join(path.dirname(coreExecutable), 'runtime');
47: 
48: // The smoke report must describe the same owned process observed on the
49: // private management channel. A healthy HTTP endpoint alone is insufficient.
50: function ownedCoreIdentity(machine) {
51:   if (machine.state !== 'READY') return null;
52:   try {
53:     const discovery = machine.currentHost();
54:     const identity = machine.identity;
55:     if (!identity || discovery.pid !== identity.PID || !machine.hostId) return null;
56:     return { pid: identity.PID, created_ns: identity.CreatedNS,
57:       image_sha256: identity.ImageSHA256, host_id: machine.hostId };
58:   } catch { return null; }
59: }
60: 
61: function smokeReadyEvidence(renderer, nativeProbe, management, started, owned) {
62:   return !!(renderer?.bridge && renderer.react_root && renderer.mounted_title &&
63:     renderer.navigation > 0 && nativeProbe?.ok === true &&
64:     management?.state === 'READY' && started?.health === 'UP' &&
65:     started.discovery?.pid === owned?.pid && owned?.pid > 0 &&
66:     typeof owned.created_ns === 'string' && /^[0-9]+$/.test(owned.created_ns) &&
67:     /^[a-f0-9]{64}$/.test(owned.image_sha256) && /^host-[a-f0-9]{12}$/.test(owned.host_id));
68: }
69: 
70: function smokeShutdownConfirmation(result, machine, owned) {
71:   const identity = machine.identity;
72:   if (result?.state !== 'STOPPED' || result.process_exit_confirmed !== true ||
73:       machine.state !== 'STOPPED' || machine.hasUnconfirmedChild() ||
74:       !identity || !owned || identity.PID !== owned.pid ||
75:       identity.CreatedNS !== owned.created_ns || identity.ImageSHA256 !== owned.image_sha256 ||
76:       machine.hostId !== owned.host_id) return null;
77:   return { process_exit_confirmed: true, owned_core_identity: owned };
78: }
79: 
80: const deps = {
81:   fsImpl: fs,
82:   httpImpl: http,
83:   // A normal Desktop may only launch an owned control through the inherited
84:   // private management pipes below. The older health route cannot spawn one.
85:   requireLaunchDisabled: true,
86:   discoveryFile: DISCOVERY,
87:   credentialFor: native.createCredentialProvider({ clientId: 'desktop-shell' }),
88:   principalFile: PRINCIPAL,
89:   coreArgv: [],
90:   sleep: (ms) => new Promise((r) => setTimeout(r, ms)),
