apps/desktop/main/lib/desktop-management.js
735:         value.qualification_model_calls !== 1 || value.qualification_tool_calls !== 0 ||
736:         !object(value.scope) || !sameValue(value.scope, intent.scope) ||
737:         !Array.isArray(value.frozen_checks) || !sameValue(value.frozen_checks, intent.frozenChecks) ||
738:         !Number.isSafeInteger(value.revision) || !Number.isSafeInteger(value.config_revision))
739:       throw failure('CODING_RESULT_INVALID');
740:     intent.state = value.state; intent.newModelRef = value.model_config_ref;
741:     intent.runtimeStatus = value.runtime_status; intent.profileRef = frozenCopy(value.profile_ref);
742:     intent.configRevision = value.config_revision;
743:     intent.commitKey = digest(Buffer.from(JSON.stringify([intent.hostId, intent.projectId,
744:       intent.sessionId, intent.requestId, value.model_config_ref, value.revision, value.config_revision])));
745:   }
746:   retireQualificationAfterCodingCommit() {
747:     if (this.intent?.confirmSent && ['EXECUTION_SETTLED', 'QUALIFIED_PURPOSE_AUTHORIZED'].includes(this.intent.state)) {
748:       this.currentHost();
749:       this.retiredIntents.push(Object.freeze({ ...this.intent, retiredAt: new Date().toISOString(),
750:         retireReason: 'CODING_COMMITTED' })); this.intent = null;
751:     }
752:   }
753:   async statusCoding() {
754:     this.commandIdle();
755:     const intent = this.codingIntent;
756:     if (!intent) throw failure('CODING_ORIGINAL_REQUEST_REQUIRED');
757:     if (!intent.requestId) throw failure('CODING_PREPARE_ORIGINAL_UNRESOLVED');
758:     if (!this.sameSelection(intent.projectId, intent.sessionId)) throw failure('CONTEXT_CHANGED');
759:     const reply = await this.exchange('STATUS_CODING', { project_id: intent.projectId,
760:       request_id: intent.requestId, request_hash: intent.requestHash }, 30000);
761:     if (reply.kind !== 'RESULT') throw failure('CODING_STATUS_REJECTED');
762:     const value = reply.result;
763:     if (value?.state === 'CODING_CONFIGURED') {
764:       this.acceptCodingResult(intent, value); this.retireQualificationAfterCodingCommit();
765:     }
766:     else if (!object(value) || !['AWAITING_CODING_CONFIRMATION', 'EXPIRED'].includes(value.state) ||
767:         value.request_id !== intent.requestId || value.request_hash !== intent.requestHash ||
768:         value.project_id !== intent.projectId || value.session_id !== intent.sessionId)
769:       throw failure('CODING_STATUS_RESULT_INVALID');
770:     else { intent.state = value.state; intent.statusCheckedAt = Date.now(); }
771:     return this.codingSummary();
772:   }
773:   async shutdown() {
774:     if (this.state === 'STOPPED') return { state: 'STOPPED', process_exit_confirmed: true };
775:     if (this.state !== 'READY') throw failure('SAFE_SHUTDOWN_UNAVAILABLE');
776:     const reply = await this.exchange('SHUTDOWN', {}, 30000);
777:     if (reply.kind !== 'RESULT' || reply.result?.state !== 'SHUTDOWN_ACCEPTED')
778:       throw failure('SHUTDOWN_REFUSED');
779:     this.shutdownAccepted = true;
780:     let timer;
781:     let outcome;
782:     try {
783:       outcome = await Promise.race([
784:         this.exitPromise,
785:         new Promise((_, reject) => { timer = setTimeout(() => reject(failure('SHUTDOWN_EXIT_UNCONFIRMED')), 15000); }),
786:       ]);
787:     } finally { clearTimeout(timer); }
788:     if (outcome.code !== 0 || outcome.signal || this.state !== 'STOPPED')
789:       throw failure('SHUTDOWN_EXIT_UNCONFIRMED');
790:     return { state: 'STOPPED', process_exit_confirmed: true };
791:   }
792: }
793: 
794: function createDesktopManagement(options) { return new DesktopManagement(options); }
795: module.exports = { PROTOCOL, FRAME_LIMIT, strictJSON, installedResources, observeWindowsProcess,
796:   createDesktopManagement, DesktopManagement };
