107:     def test_actual_build_manifest_when_explicitly_supplied(self):
108:         directory = os.environ.get("RESEARCHOS_DEVELOPMENT_BUNDLE")
109:         if not directory:
110:             self.skipTest("real builder outcome is checked after creation")
111:         bundle = Path(directory)
112:         manifest = json.loads((bundle / "development-manifest.json").read_bytes())
113:         self.assertEqual(manifest["schema"], builder.SCHEMA)
114:         self.assertEqual(manifest["source"]["head"], "7d1e3ff288f91254c7304dd32f6e5bb4b66b8f1e")
115:         self.assertEqual(manifest["core"]["migration_count"], 25)
116:         self.assertEqual(manifest["mu"]["vendored_files_verified"], 5083)
117:         self.assertGreaterEqual(manifest["electron"]["file_count"], 75)
118:         self.assertEqual(manifest["files"], builder.inventory(bundle))
