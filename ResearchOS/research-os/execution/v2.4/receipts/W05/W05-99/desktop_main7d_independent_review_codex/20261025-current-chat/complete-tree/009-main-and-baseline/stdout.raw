175:     req.end();
176:   });
177: }
178: 
179: ipc.register(ipcMain, deps);
180: 
181: // The main process alone reads the host's private session file and renews it over the native pipe.
182: // The renderer receives only protocol outcomes and session references.
183: const selectedState = {
184:   projectId: process.env.RESEARCHOS_PROJECT_ID || null,
185:   sessionId: process.env.RESEARCHOS_SESSION_ID || null,
186:   expectedRevision: null,
187:   writerEpoch: null,
188:   selectionGeneration: 0,
189:   authorityGeneration: 0,
190: };
191: const sessionState = new Proxy(selectedState, { set(target, key, value) {
192:   if (target[key] !== value) {
193:     if (key === 'projectId' || key === 'sessionId') target.selectionGeneration++;
194:     if (['expectedRevision', 'writerEpoch', 'writerClientId', 'writerExpiresAt'].includes(key)) target.authorityGeneration++;
195:   }
196:   target[key] = value; return true;
197: } });
198: const qualificationContext = () => JSON.stringify([
199:   sessionState.projectId, sessionState.sessionId,
200:   sessionState.expectedRevision == null ? null : String(sessionState.expectedRevision),
201:   sessionState.writerEpoch == null ? null : String(sessionState.writerEpoch),
202:   sessionState.writerClientId || null, sessionState.writerExpiresAt || null,
203:   sessionState.selectionGeneration, sessionState.authorityGeneration,
204: ]);
205: // Raw startup diagnostics stay in the privileged main process and are bounded
206: // across all chunks. Renderer responses carry only stable error codes.
207: const managementDiagnostic = { chunks: [], bytes: 0, truncated: false };
208: const captureManagementDiagnostic = input => {
209:   const bytes = Buffer.from(input);
210:   const remaining = 8192 - managementDiagnostic.bytes;
211:   if (remaining > 0) {
212:     const kept = bytes.subarray(0, remaining);
213:     managementDiagnostic.chunks.push(kept); managementDiagnostic.bytes += kept.length;
214:   }
215:   if (bytes.length > remaining) managementDiagnostic.truncated = true;
216: };
217: const desktopManagement = createDesktopManagement({
218:   fsImpl: fs, spawn: childProcess.spawn, httpImpl: http, discoveryFile: DISCOVERY,
219:   dataRoot, controlExe: coreExecutable, verifierManifest, runtimeAssetsDir,
220:   webDir: WEB_DIST, cwd: REPO, context: qualificationContext,
221:   codingResourceGeneration: () => codingDirectories.generation,
222:   diagnostic: captureManagementDiagnostic,
223: });
224: const v2Deps = Object.assign({}, deps, {
225:   v2Transport: validatedV2Transport,
226:   clientId: 'desktop-shell',
227:   commandIdFor: () => crypto.randomUUID(),
228:   sessionState,
229: });
230: 
231: async function prepareQualificationScope() {
232:   if (!v2Deps.contextVerified || !sessionState.projectId || !sessionState.sessionId)
233:     throw Object.assign(new Error('SESSION_NOT_SELECTED'), { code: 'SESSION_NOT_SELECTED' });
234:   const projectId = sessionState.projectId, sessionId = sessionState.sessionId;
235:   const selectionGeneration = sessionState.selectionGeneration;
236:   desktopManagement.currentHost();
237:   const opened = await ipc.callV2(v2Deps, 'session.get', {}, ipc.AUTHORITY_READ);
238:   desktopManagement.currentHost();
239:   if (!opened?.completed || opened.result?.project_id !== projectId || opened.result?.session_id !== sessionId ||
240:       sessionState.projectId !== projectId || sessionState.sessionId !== sessionId ||
241:       sessionState.selectionGeneration !== selectionGeneration)
242:     throw Object.assign(new Error('SESSION_CHANGED'), { code: 'SESSION_CHANGED' });
243:   const snapshot = opened.result, context = qualificationContext();
244:   if (snapshot.writer?.client_id !== 'desktop-shell' || Date.parse(snapshot.writer?.expires_at) <= Date.now() ||
245:       String(snapshot.writer?.epoch) !== String(sessionState.writerEpoch) ||
246:       String(snapshot.revision) !== String(sessionState.expectedRevision))
247:     throw Object.assign(new Error('WRITE_OWNER_REQUIRED'), { code: 'WRITE_OWNER_REQUIRED' });
248:   const status = await ipc.callV2(v2Deps, 'host.status', {}, ipc.AUTHORITY_READ);
249:   const currentHost = desktopManagement.currentHost();
250:   if (qualificationContext() !== context || !status?.completed ||
251:       status.local_host_origin !== crypto.createHash('sha256').update(JSON.stringify([
252:         desktopManagement.hostId, currentHost.data_dir])).digest('hex'))
253:     throw Object.assign(new Error('HOST_OR_CONTEXT_CHANGED'), { code: 'HOST_OR_CONTEXT_CHANGED' });
254:   const modelRef = snapshot.model_config_ref;
255:   const model = status.result?.model_configurations?.find(item => item.model_config_ref === modelRef);
apps/desktop/build-validator.py
1: """Build a new, source-bound Desktop development tree; never overwrite a release."""
2: import argparse, datetime, hashlib, json, os, pathlib, shutil, subprocess, sys, uuid
3: ROOT = pathlib.Path(__file__).resolve().parents[2]
4: 
5: def digest(path):
6:     return hashlib.sha256(path.read_bytes()).hexdigest()
7: 
8: def put(path, value):
9:     path.parent.mkdir(parents=True, exist_ok=True)
10:     with path.open('x', encoding='utf-8', newline='\n') as stream:
11:         json.dump(value, stream, ensure_ascii=False, indent=2); stream.write('\n')
12: 
13: def stream_json(text):
14:     decoder=json.JSONDecoder(); offset=0
15:     while offset<len(text):
16:         while offset<len(text) and text[offset].isspace(): offset+=1
17:         if offset==len(text): break
18:         value,end=decoder.raw_decode(text,offset); yield value; offset=end
19: 
20: def main():
21:     parser=argparse.ArgumentParser()
22:     for flag in ['go','node','electron','module-cache','web-modules','output','receipts']:
23:         parser.add_argument('--'+flag,required=True)
24:     args=parser.parse_args()
25:     output=pathlib.Path(args.output).resolve(); receipts=pathlib.Path(args.receipts).resolve()
26:     if not output.is_relative_to(ROOT) or output.exists() or not receipts.is_relative_to(ROOT) or receipts.exists():
27:         raise SystemExit('new output and receipt directories must belong to this worktree')
28:     output.mkdir(parents=True); receipts.mkdir(parents=True)
29:     go=pathlib.Path(args.go).resolve(); goroot=go.parent.parent
30:     env={**os.environ,'GOTOOLCHAIN':'local','GOENV':'off','GOROOT':str(goroot),'GOPATH':str(pathlib.Path(args.module_cache).resolve().parent.parent),
31:          'GOMODCACHE':str(pathlib.Path(args.module_cache).resolve()),'GOCACHE':str(output/'go-cache'),'GOTMPDIR':str(output/'go-tmp'),'GOPROXY':'off','GOSUMDB':'off'}
32:     pathlib.Path(env['GOTMPDIR']).mkdir()
33:     invocations=[]
34:     def run(name, argv, cwd=ROOT, timeout=120):
35:         start=datetime.datetime.now(datetime.timezone.utc).isoformat()
36:         try:
37:             proc=subprocess.run(argv,cwd=cwd,env=env,capture_output=True,timeout=timeout); code=proc.returncode; stdout=proc.stdout; stderr=proc.stderr
38:         except subprocess.TimeoutExpired as e:
39:             code=124;stdout=e.stdout or b'';stderr=e.stderr or b''
40:         (receipts/(name+'.stdout')).write_bytes(stdout);(receipts/(name+'.stderr')).write_bytes(stderr)
41:         row={'actualargv':[str(x) for x in argv],'cwd':str(cwd),'started_at':start,'ended_at':datetime.datetime.now(datetime.timezone.utc).isoformat(),'exit':code,
42:              'stdout':name+'.stdout','stderr':name+'.stderr','environment':{k:env[k] for k in ['GOTOOLCHAIN','GOENV','GOROOT','GOPATH','GOMODCACHE','GOCACHE','GOTMPDIR','GOPROXY','GOSUMDB']}}
43:         put(receipts/(name+'.invocation.json'),row);invocations.append(row)
44:         if code:
45:             put(receipts/'stopped.json',{'first_unexpected':row,'source_acceptance':False});raise SystemExit(code)
46:         return stdout.decode('utf-8')
47:     tools=[]
48:     for name,p in [('go',go),('node',pathlib.Path(args.node)),('electron',pathlib.Path(args.electron)),('python',pathlib.Path(sys.executable))]:
49:         tools.append({'name':name,'path':str(p.resolve()),'sha256':digest(p),'bytes':p.stat().st_size})
50:     powershell=pathlib.Path(os.environ['SystemRoot'])/'System32/WindowsPowerShell/v1.0/powershell.exe'
51:     tools.append({'name':'powershell-public-module-audit','path':str(powershell),'sha256':digest(powershell),'bytes':powershell.stat().st_size})
52:     put(receipts/'tools.before.json',tools)
53:     expected={'go':'d3ccdb604eafa6031133aefe1a3db24f0bb7362b857bc2125ac4e4c178b4b490','node':'5f364598aa3017130b22908ff7c3db0fd05bd42d39fd65b79fd6bd3f73c73da6','electron':'8d205e25b40da3ada4a08c92f32bfbd8e8d38edb4bfe443deea77fc9de685bac'}
54:     if any(x['name'] in expected and x['sha256']!=expected[x['name']] for x in tools):raise SystemExit('locked tool mismatch')
