tests/ui/desktop/development-bundle.test.py
1: """Mock/source checks for the complete Desktop development builder.
2: 
3: The real build and its manifest are checked separately. These tests never
4: start Electron, Core or a provider.
5: """
6: import importlib.util
7: import json
8: import os
9: from pathlib import Path
10: import shutil
11: import stat
12: import subprocess
13: import tempfile
14: import types
15: import unittest
16: 
17: 
18: ROOT = Path(__file__).resolve().parents[3]
19: SOURCE = ROOT / "apps/desktop/build-development.py"
20: spec = importlib.util.spec_from_file_location("desktop_build_development", SOURCE)
21: builder = importlib.util.module_from_spec(spec)
22: spec.loader.exec_module(builder)
23: 
24: 
25: class DevelopmentBundleTest(unittest.TestCase):
26:     def setUp(self):
27:         self.temp = Path(tempfile.mkdtemp(prefix="ros-desktop-development-mock-"))
28: 
29:     def tearDown(self):
30:         target = self.temp.resolve()
31:         base = Path(tempfile.gettempdir()).resolve()
32:         self.assertTrue(target.is_relative_to(base) and target.name.startswith("ros-desktop-development-mock-"))
33:         def writable_then_remove(operation, name, error):
34:             if not isinstance(error, PermissionError):
35:                 raise error
36:             os.chmod(name, stat.S_IWRITE)
37:             operation(name)
38:         shutil.rmtree(target, onexc=writable_then_remove)
39: 
40:     def test_sqlite_closure_rejects_gap_and_missing_next(self):
41:         migrations = self.temp / "migrations/sqlite"
42:         migrations.mkdir(parents=True)
43:         (migrations / "0001_bootstrap.sql").write_text("SELECT 1;", encoding="utf-8")
44:         (migrations / "0003_other.sql").write_text("SELECT 3;", encoding="utf-8")
45:         (migrations / "next_v24_sessions.sql").write_text("SELECT 4;", encoding="utf-8")
46:         with self.assertRaisesRegex(RuntimeError, "continuous numbered"):
47:             builder.validate_migrations(self.temp)
48:         (migrations / "0002_domain.sql").write_text("SELECT 2;", encoding="utf-8")
49:         self.assertEqual(len(builder.validate_migrations(self.temp)), 4)
50:         (migrations / "next_v24_sessions.sql").unlink()
51:         with self.assertRaisesRegex(RuntimeError, "continuous numbered"):
52:             builder.validate_migrations(self.temp)
53: 
54:     def test_exact_copy_and_tree_refuse_redirected_source(self):
55:         source = self.temp / "source"
56:         source.mkdir()
57:         (source / "file.txt").write_bytes(b"one")
58:         self.assertEqual(builder.copy_tree(source, self.temp / "output"), 1)
59:         self.assertEqual((self.temp / "output/file.txt").read_bytes(), b"one")
60:         with self.assertRaisesRegex(RuntimeError, "output collision"):
61:             builder.copy_tree(source, self.temp / "output")
62:         alias = source / "alias.txt"
63:         try:
64:             os.symlink(source / "file.txt", alias)
65:         except (OSError, NotImplementedError) as error:
66:             self.skipTest(f"Windows symlink fixture unavailable: {error}")
67:         with self.assertRaisesRegex(RuntimeError, "redirected"):
68:             builder.copy_tree(source, self.temp / "other")
69: 
70:     def test_source_snapshot_covers_new_delta_and_refuses_outside_scope(self):
71:         repo = self.temp / "repo"
72:         repo.mkdir()
73:         subprocess.run(["git", "init", "-q", str(repo)], check=True, capture_output=True)
74:         for relative in builder.ALLOWLIST:
75:             path = repo / relative
76:             path.parent.mkdir(parents=True, exist_ok=True)
77:             path.write_bytes(relative.encode())
