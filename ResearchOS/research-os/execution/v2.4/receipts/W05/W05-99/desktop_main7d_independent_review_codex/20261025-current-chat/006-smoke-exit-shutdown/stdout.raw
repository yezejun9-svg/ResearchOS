465:   async exchange(operation, scope, timeoutMs, postflight = true, hooks = {}) {
466:     this.currentHost();
467:     if (hooks.beforeWrite) {
468:       if (operation !== 'CONFIRM_CODING' || this.pending || !this.consentPending)
469:         throw failure('PRIVILEGED_CONFIRM_PENDING');
470:     } else this.commandIdle();
471:     const messageId = crypto.randomUUID();
472:     const request = { protocol: PROTOCOL, message_id: messageId, operation, host_id: this.hostId, ...scope };
473:     const bytes = Buffer.from(JSON.stringify(request) + '\n');
474:     if (bytes.length - 1 > FRAME_LIMIT) throw failure('PRIVATE_FRAME_SIZE');
475:     return new Promise((resolve, reject) => {
476:       // This hook runs in the same JS turn as the write, after all prior awaits.
477:       hooks.beforeWrite?.();
478:       const pending = { messageId, operation, resolve, reject, timer: null,
479:         onTerminal: hooks.onTerminal || null };
480:       this.pending = pending;
481:       pending.timer = setTimeout(() => {
482:         // A timed-out write may already be executing. Keep the barrier until a
483:         // late terminal reply or process exit; never issue a second CONFIRM.
484:         pending.timedOut = true; reject(failure('MANAGEMENT_REPLY_UNCERTAIN'));
485:       }, timeoutMs);
