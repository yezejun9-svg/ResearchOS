463: 
464: def main():
465:     parser = argparse.ArgumentParser()
466:     for flag in ["go", "node", "electron-dist", "module-cache", "web-modules", "mu-common", "output", "receipts"]:
467:         parser.add_argument("--" + flag, required=True)
468:     args = parser.parse_args()
469:     try:
470:         build(args)
471:     except Exception as error:
472:         receipts = Path(args.receipts)
473:         if receipts.is_dir() and not (receipts / "failed.json").exists():
474:             put(receipts / "failed.json", {"error_type": type(error).__name__, "error": str(error),
475:                                            "status": "FIRST_FAILURE_RETAINED_NO_RETRY"})
476:         print(f"development build failed: {error}", file=sys.stderr)
477:         raise SystemExit(1)
478: 
479: 
480: if __name__ == "__main__":
481:     main()
