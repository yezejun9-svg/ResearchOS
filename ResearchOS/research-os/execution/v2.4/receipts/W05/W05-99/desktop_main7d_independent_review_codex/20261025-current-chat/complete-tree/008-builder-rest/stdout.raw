259: 
260: def run_command(receipts, name, argv, cwd, env):
261:     location = receipts / "commands" / name
262:     location.mkdir(parents=True, exist_ok=False)
263:     invocation = {"argv": [str(item) for item in argv], "cwd": str(cwd),
264:                   "environment": {key: env.get(key) for key in ["GOENV", "GOTOOLCHAIN", "GOPATH", "GOMODCACHE", "GOCACHE", "GOTMPDIR", "GOPROXY", "GOSUMDB", "TEMP", "TMP"]}}
265:     put(location / "recipe.json", invocation)
266:     started = datetime.datetime.now(datetime.timezone.utc).isoformat()
267:     with (location / "stdout.raw").open("xb") as stdout, (location / "stderr.raw").open("xb") as stderr:
268:         process = subprocess.Popen([str(item) for item in argv], cwd=cwd, env=env,
269:                                    stdout=stdout, stderr=stderr, stdin=subprocess.DEVNULL)
270:         code = process.wait()
271:     ended = datetime.datetime.now(datetime.timezone.utc).isoformat()
272:     put(location / "result.json", {"started_at": started, "ended_at": ended, "pid": process.pid,
273:                                    "native_exit": code, "stdout_sha256": sha256(location / "stdout.raw"),
274:                                    "stderr_sha256": sha256(location / "stderr.raw")})
275:     if code:
276:         raise RuntimeError(f"{name} exited {code}; retained {location}")
277:     return (location / "stdout.raw").read_bytes()
