apps/desktop/build-development.py
245: def mu_compiled_closure(common, worktree, metadata, node, stage, receipts, env, run):
246:     script = stage / "mu-metafile.mjs"
247:     script.write_text(MU_META_SCRIPT, encoding="utf-8", newline="\n")
248:     raw = run(receipts, "mu-compiled-inputs", [node, script, worktree, common, stage / "mu-worker.mjs"], worktree, env)
249:     compiled = json.loads(raw)
250:     if compiled.get("output_sha256") != metadata["bundle_sha256"] or compiled.get("esbuild_version") != "0.28.2":
251:         raise RuntimeError("Mu independent compiled-input closure differs from producer output")
252:     paths = [Path(name) for name in compiled["inputs"]]
253:     for dependency in [common / "third_party/mu/node_modules/esbuild", common / "third_party/mu/node_modules/@esbuild/win32-x64"]:
254:         if not dependency.is_dir() or dependency.is_symlink():
255:             raise RuntimeError("Mu esbuild package/tool unavailable")
256:         paths.extend(path for path in dependency.rglob("*") if path.is_file())
257:     return {"compiled_input_count": len(compiled["inputs"]), "files": file_rows(paths)}
