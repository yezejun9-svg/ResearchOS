1: import assert from 'node:assert/strict';
2: import crypto from 'node:crypto';
3: import { EventEmitter } from 'node:events';
4: import fs from 'node:fs';
5: import os from 'node:os';
6: import path from 'node:path';
7: import test from 'node:test';
8: import { fileURLToPath } from 'node:url';
9: import { buildChildEnv, executeDevelopmentLaunch, prepareDevelopmentLaunch,
10:   validateBundle, validateSmokeReports } from '../../../apps/desktop/launch-development.mjs';
11: 
12: const sha = bytes => crypto.createHash('sha256').update(bytes).digest('hex');
13: const fixtureRoot = () => fs.mkdtempSync(path.join(os.tmpdir(), 'ros-desktop-development-mock-'));
14: function removeFixture(root) {
15:   const resolved = path.resolve(root), temp = path.resolve(os.tmpdir());
16:   assert.ok(resolved.startsWith(temp + path.sep) && path.basename(resolved).startsWith('ros-desktop-development-mock-'));
17:   fs.rmSync(resolved, { recursive: true, force: true });
18: }
19: function write(root, relative, content) {
20:   const target = path.join(root, relative);
21:   fs.mkdirSync(path.dirname(target), { recursive: true });
22:   fs.writeFileSync(target, content);
23: }
24: function fixture(root) {
25:   const bundle = path.join(root, 'bundle'); fs.mkdirSync(bundle);
26:   const files = [
27:     'apps/desktop/main/main.js', 'apps/desktop/preload/preload.js',
28:     'apps/desktop/resources/client-wire/researchos-client-wire-validator.exe',
29:     'apps/desktop/resources/control/researchos-control.exe',
30:     'apps/desktop/resources/control/runtime-verifier.exe',
31:     'apps/desktop/resources/control/runtime/mu-worker.mjs',
32:     'apps/desktop/resources/control/runtime/node.exe',
33:     'apps/web/dist/index.html', 'apps/web/dist/assets/index.js', 'apps/web/dist/assets/index.css',
34:     'runtime/electron/electron.exe', 'spec/v2.0/contracts/domain.schema.json',
35:     'spec/v2.0/contracts/openapi.json', 'internal/api/contracts/client.protocol.schema.json',
36:     'internal/api/contracts/domain.schema.json', 'migrations/sqlite/0001_bootstrap.sql',
37:     'migrations/sqlite/0002_domain.sql', 'migrations/sqlite/next_v24_sessions.sql',
38:   ];
39:   for (const name of files) write(bundle, name, name.endsWith('.exe') ? Buffer.from('MZ-mock') : Buffer.from(name));
40:   const verifier = path.join(bundle, 'apps/desktop/resources/control/runtime-verifier.exe');
41:   write(bundle, 'apps/desktop/resources/control/runtime-verifier-installation.json', JSON.stringify({
42:     schema: 'researchos.runtime-verifier-installation.v1', service_id: 'researchos.runtime-qualification-verifier.v1',
43:     protocol: 'researchos.runtime-verifier/1', executable: verifier,
44:     executable_hash: 'sha256:' + sha(fs.readFileSync(verifier)), source_commit: 'a'.repeat(40), arguments: [],
45:   }));
46:   const mu = path.join(bundle, 'apps/desktop/resources/control/runtime/mu-worker.mjs');
47:   write(bundle, 'apps/desktop/resources/control/runtime/mu-worker.mjs.build.json', JSON.stringify({
48:     mu_commit: '8dfebe36508ac0c2508735bb866756dab9283e74', vendored_files_verified: 5083,
49:     bundle_sha256: sha(fs.readFileSync(mu)), bundle_bytes: fs.statSync(mu).size,
50:   }));
51:   write(bundle, 'apps/desktop/resources/client-wire/descriptor.json', JSON.stringify({
52:     build_input_digest: 'b'.repeat(64),
53:     binary_sha256: sha(fs.readFileSync(path.join(bundle, 'apps/desktop/resources/client-wire/researchos-client-wire-validator.exe'))),
54:   }));
55:   const inventory = [];
56:   function walk(directory) {
57:     for (const entry of fs.readdirSync(directory, { withFileTypes: true })) {
58:       const target = path.join(directory, entry.name);
59:       if (entry.isDirectory()) walk(target);
60:       else inventory.push({ path: path.relative(bundle, target).split(path.sep).join('/'),
61:         sha256: sha(fs.readFileSync(target)), bytes: fs.statSync(target).size });
62:     }
63:   }
64:   walk(bundle); inventory.sort((a, b) => a.path.localeCompare(b.path, 'en'));
65:   // The runtime contract sorts by UTF-16 codepoint order, which these ASCII
66:   // fixture paths share with ordinary JavaScript lexical order.
67:   inventory.sort((a, b) => a.path < b.path ? -1 : a.path > b.path ? 1 : 0);
68:   write(bundle, 'development-manifest.json', JSON.stringify({
69:     schema: 'researchos.desktop-development-tree/1', mode: 'DEVELOPMENT_ONLY_BUILT_NOT_NATIVE_TESTED',
70:     bundle_root: bundle, client_wire: { build_input_digest: 'b'.repeat(64) }, files: inventory,
71:   }));
72:   return { bundle, state: path.join(root, 'fresh-state') };
73: }
74: 
75: test('mock complete tree dry-run validates every hash and does not create state or spawn', async () => {
76:   const root = fixtureRoot();
77:   try {
78:     const { bundle, state } = fixture(root);
79:     const ambient = { SystemRoot: process.env.SystemRoot || 'C:\\Windows',
80:       node_options: '--require evil', researchos_project_id: 'foreign', ROS_DESKTOP_LEGACY_WORKBENCH: '1' };
81:     let spawns = 0;
82:     const result = await executeDevelopmentLaunch({ bundle, state, ambient, dryRun: true, smoke: true },
83:       () => { spawns++; throw Error('must not spawn'); });
84:     assert.equal(result.mode, 'DRY_RUN_NO_STATE_NO_SPAWN');
85:     assert.equal(spawns, 0);
86:     assert.equal(fs.existsSync(state), false);
87:     const prepared = prepareDevelopmentLaunch({ bundle, state, ambient, smoke: true });
88:     assert.equal(prepared.env.ROS_DESKTOP_SMOKE, '1');
89:     assert.equal(prepared.env.ROS_DESKTOP_NATIVE_SMOKE, '1');
90:     assert.equal(prepared.env.RESEARCHOS_DATA_DIR, path.join(state, 'data'));
91:     assert.equal(prepared.env.node_options, undefined);
92:     assert.equal(prepared.env.researchos_project_id, undefined);
93:     assert.equal(prepared.env.ROS_DESKTOP_LEGACY_WORKBENCH, undefined);
94:     assert.deepEqual(prepared.argv, [path.join(bundle, 'apps/desktop')]);
95:   } finally { removeFixture(root); }
96: });
97: 
98: test('mock launcher rejects changed, missing, alias and pre-existing state before spawn', async t => {
99:   const root = fixtureRoot();
100:   try {
101:     const { bundle, state } = fixture(root);
102:     const options = { bundle, state, ambient: { SystemRoot: process.env.SystemRoot || 'C:\\Windows' }, dryRun: true };
103:     fs.mkdirSync(state);
104:     assert.throws(() => prepareDevelopmentLaunch(options), /STATE_NOT_FRESH/);
105:     fs.rmdirSync(state);
106:     const target = path.join(bundle, 'apps/web/dist/index.html');
107:     fs.appendFileSync(target, 'tamper');
108:     assert.throws(() => validateBundle(bundle), /BUNDLE_FILE_CHANGED/);
109:     fs.writeFileSync(target, 'apps/web/dist/index.html');
110:     const control = path.join(bundle, 'apps/desktop/resources/control/researchos-control.exe');
111:     fs.unlinkSync(control);
112:     assert.throws(() => validateBundle(bundle), /PATH_UNAVAILABLE|BUNDLE_RESOURCE_MISSING/);
113:     write(bundle, 'apps/desktop/resources/control/researchos-control.exe', Buffer.from('MZ-mock'));
114:     const alias = path.join(root, 'state-alias');
115:     try {
116:       fs.symlinkSync(bundle, alias, 'junction');
117:       assert.throws(() => prepareDevelopmentLaunch({ ...options, state: path.join(alias, 'new-state') }), /PATH_ALIAS_REFUSED/);
118:     } catch (error) {
119:       if (error.code !== 'EPERM' && error.code !== 'EACCES') throw error;
120:       t.diagnostic('Windows did not allow this junction fixture');
121:     }
122:   } finally { removeFixture(root); }
123: });
124: 
125: test('Windows env case collisions and lowercase injection cannot become child variables', () => {
126:   const root = fixtureRoot();
127:   try {
128:     const { bundle, state } = fixture(root);
129:     assert.throws(() => buildChildEnv({ SystemRoot: 'C:\\Windows', systemroot: 'C:\\Windows' }, bundle, state), /ENV_CASE_COLLISION/);
130:     assert.throws(() => buildChildEnv({ SystemRoot: 'C:\\Windows', NODE_OPTIONS: 'x', node_options: 'y' }, bundle, state), /ENV_CASE_COLLISION/);
131:     const env = buildChildEnv({ SystemRoot: 'C:\\Windows', node_options: 'x', researchos_data_dir: 'foreign',
132:       ros_desktop_smoke: '0', ELECTRON_RUN_AS_NODE: '1' }, bundle, state, true);
133:     assert.equal(env.NODE_OPTIONS, undefined);
134:     assert.equal(env.ELECTRON_RUN_AS_NODE, undefined);
135:     assert.equal(env.RESEARCHOS_DATA_DIR, path.join(state, 'data'));
136:     assert.equal(env.ROS_DESKTOP_SMOKE, '1');
137:   } finally { removeFixture(root); }
138: });
139: 
140: test('mock launch creates only a fresh state and report verifier demands same owned exit', async () => {
141:   const root = fixtureRoot();
142:   try {
143:     const { bundle, state } = fixture(root);
144:     const owned = { pid: 121, created_ns: '1792057406096619100', image_sha256: 'a'.repeat(64), host_id: 'host-aaaaaaaaaaaa' };
145:     const ready = { event: 'ready_to_show', management_state: 'READY', host_health: 'UP',
146:       native_probe: { ok: true }, renderer: { bridge: true, react_root: true, mounted_title: 'ResearchOS', navigation: 3 },
147:       owned_core_identity: owned };
148:     const stopped = { event: 'shutdown_confirmed', process_exit_confirmed: true, owned_core_identity: owned };
149:     assert.deepEqual(validateSmokeReports([ready, stopped], 0), { status: 'NATIVE_SMOKE_CONFIRMED', owned_core_identity: owned });
150:     assert.throws(() => validateSmokeReports([ready, { ...stopped, owned_core_identity: { ...owned, created_ns: '1' } }], 0), /SMOKE_OUTCOME_UNCONFIRMED/);
151:     assert.throws(() => validateSmokeReports([{ ...ready, native_probe: null }, stopped], 0), /SMOKE_OUTCOME_UNCONFIRMED/);
152:     assert.throws(() => validateSmokeReports([ready, stopped], 2), /SMOKE_OUTCOME_UNCONFIRMED/);
153:     let observed;
154:     const mockSpawn = (exe, argv, opts) => {
155:       observed = { exe, argv, opts };
156:       const child = new EventEmitter(); child.stdout = new EventEmitter(); child.stderr = new EventEmitter();
157:       process.nextTick(() => {
158:         child.stdout.emit('data', Buffer.from('ROS_DESKTOP_REPORT ' + JSON.stringify(ready) + '\n' +
159:           'ROS_DESKTOP_REPORT ' + JSON.stringify(stopped) + '\n'));
160:         child.emit('close', 0, null);
161:       });
162:       return child;
163:     };
164:     const result = await executeDevelopmentLaunch({ bundle, state, ambient: { SystemRoot: process.env.SystemRoot || 'C:\\Windows' }, smoke: true }, mockSpawn);
165:     assert.equal(result.status, 'NATIVE_SMOKE_CONFIRMED');
166:     assert.ok(fs.statSync(path.join(state, 'data')).isDirectory());
167:     assert.equal(observed.exe, path.join(bundle, 'runtime/electron/electron.exe'));
168:     assert.equal(observed.opts.env.RESEARCHOS_CLI_DISCOVERY, path.join(state, 'discovery.json'));
169:   } finally { removeFixture(root); }
170: });
tests/ui/desktop/development-smoke.test.mjs
1: import assert from 'node:assert/strict';
2: import crypto from 'node:crypto';
3: import fs from 'node:fs';
4: import path from 'node:path';
5: import test from 'node:test';
6: import { fileURLToPath } from 'node:url';
7: 
8: // Evaluate the exact pure functions in the production main without loading
9: // Electron or starting Core. These are mock verdict tests, not native proof.
10: const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../../..');
11: const source = fs.readFileSync(path.join(root, 'apps/desktop/main/main.js'), 'utf8');
12: const begin = source.indexOf('function ownedCoreIdentity(machine) {');
13: const end = source.indexOf('\nconst deps = {', begin);
14: assert.ok(begin >= 0 && end > begin);
15: const code = source.slice(begin, end);
16: const { ownedCoreIdentity, smokeReadyEvidence, smokeShutdownConfirmation } =
17:   Function(code + '\nreturn { ownedCoreIdentity, smokeReadyEvidence, smokeShutdownConfirmation };')();
18: 
19: const identity = { PID: 12345, CreatedNS: '1792057406096619100', ImageSHA256: 'a'.repeat(64) };
20: const machine = () => ({ state: 'READY', identity: { ...identity }, hostId: 'host-aaaaaaaaaaaa',
21:   currentHost: () => ({ pid: 12345 }), hasUnconfirmedChild: () => false });
22: const renderer = { bridge: true, react_root: true, mounted_title: 'ResearchOS', navigation: 3 };
23: const nativeProbe = { ok: true, protocol_status: 'COMPLETED' };
24: const started = { health: 'UP', discovery: { pid: 12345 } };
25: 
26: test('exact main smoke verdict binds READY, native probe, React and owned identity', () => {
27:   const owned = ownedCoreIdentity(machine());
28:   assert.deepEqual(owned, { pid: 12345, created_ns: identity.CreatedNS,
29:     image_sha256: identity.ImageSHA256, host_id: 'host-aaaaaaaaaaaa' });
30:   assert.equal(smokeReadyEvidence(renderer, nativeProbe, { state: 'READY' }, started, owned), true);
31:   assert.equal(smokeReadyEvidence(renderer, null, { state: 'READY' }, started, owned), false);
32:   assert.equal(smokeReadyEvidence(renderer, { ok: false }, { state: 'READY' }, started, owned), false);
33:   assert.equal(smokeReadyEvidence(renderer, nativeProbe, { state: 'BROKEN' }, started, owned), false);
34:   assert.equal(smokeReadyEvidence({ ...renderer, react_root: false }, nativeProbe, { state: 'READY' }, started, owned), false);
35:   assert.equal(smokeReadyEvidence(renderer, nativeProbe, { state: 'READY' }, { ...started, discovery: { pid: 9 } }, owned), false);
36:   const changed = machine(); changed.currentHost = () => ({ pid: 9 });
37:   assert.equal(ownedCoreIdentity(changed), null);
38:   assert.match(crypto.createHash('sha256').update(code).digest('hex'), /^[a-f0-9]{64}$/);
39: });
40: 
41: test('exact main shutdown verdict requires returned exit and original PID, creation, image and host ID', () => {
42:   const m = machine(), owned = ownedCoreIdentity(m);
43:   m.state = 'STOPPED';
44:   const stopped = { state: 'STOPPED', process_exit_confirmed: true };
45:   assert.deepEqual(smokeShutdownConfirmation(stopped, m, owned),
46:     { process_exit_confirmed: true, owned_core_identity: owned });
47:   assert.equal(smokeShutdownConfirmation({ ...stopped, process_exit_confirmed: false }, m, owned), null);
48:   assert.equal(smokeShutdownConfirmation({ state: 'SHUTDOWN_ACCEPTED', process_exit_confirmed: true }, m, owned), null);
49:   m.hasUnconfirmedChild = () => true;
50:   assert.equal(smokeShutdownConfirmation(stopped, m, owned), null);
51:   m.hasUnconfirmedChild = () => false;
52:   for (const [field, replacement] of [['PID', 999], ['CreatedNS', '1'], ['ImageSHA256', 'b'.repeat(64)]]) {
53:     const original = m.identity[field]; m.identity[field] = replacement;
54:     assert.equal(smokeShutdownConfirmation(stopped, m, owned), null, field);
55:     m.identity[field] = original;
56:   }
57:   m.hostId = 'host-bbbbbbbbbbbb';
58:   assert.equal(smokeShutdownConfirmation(stopped, m, owned), null);
59: });
