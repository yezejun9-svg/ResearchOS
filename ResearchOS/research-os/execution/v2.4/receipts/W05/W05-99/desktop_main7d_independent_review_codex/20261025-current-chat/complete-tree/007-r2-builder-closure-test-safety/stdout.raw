apps/desktop/build-development.py
1: #!/usr/bin/env python3
2: """Build a source-bound, repo-shaped Windows Desktop development tree.
3: 
4: The output is a development fixture. It is not an installer or a portable
5: release. All generated files stay in a new ignored worktree directory.
6: """
7: 
8: import argparse
9: import datetime
10: import hashlib
11: import json
12: import os
13: from pathlib import Path
14: import re
15: import shutil
16: import stat
17: import subprocess
18: import sys
19: 
20: 
21: ROOT = Path(__file__).resolve().parents[2]
22: ALLOWLIST = {
23:     "apps/desktop/build-development.py",
24:     "apps/desktop/launch-development.mjs",
25:     "apps/desktop/main/main.js",
26:     "tests/ui/desktop/development-launcher.test.mjs",
27:     "tests/ui/desktop/development-bundle.test.py",
28:     "tests/ui/desktop/development-smoke.test.mjs",
29:     "docs/installation/desktop-development.md",
30: }
31: SOURCE_PREFIXES = ("adapters/", "internal/", "apps/control/", "apps/runtime-verifier/",
32:                    "apps/desktop/main/", "apps/desktop/preload/", "apps/desktop/validator/",
33:                    "apps/web/src/", "migrations/sqlite/", "spec/v2.0/contracts/")
34: SOURCE_EXACT = {"go.mod", "go.sum", "go.work", "go.work.sum", "execution/toolchains/locked.json",
35:                 "apps/desktop/package.json", "apps/desktop/package-lock.json", "apps/web/package.json",
36:                 "apps/web/package-lock.json", "apps/web/index.html", "apps/desktop/build-validator.py"}
37: SCHEMA = "researchos.desktop-development-tree/1"
38: MU_COMMIT = "8dfebe36508ac0c2508735bb866756dab9283e74"
39: REPARSE = getattr(stat, "FILE_ATTRIBUTE_REPARSE_POINT", 0x400)
40: 
41: 
42: def sha256(path):
43:     hasher = hashlib.sha256()
44:     with Path(path).open("rb") as stream:
45:         while block := stream.read(1024 * 1024):
46:             hasher.update(block)
47:     return hasher.hexdigest()
48: 
49: 
50: def canonical(value):
51:     return (json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":")) + "\n").encode()
52: 
53: 
54: def put(path, value):
55:     path = Path(path)
56:     path.parent.mkdir(parents=True, exist_ok=True)
57:     with path.open("xb") as stream:
58:         stream.write(canonical(value))
59: 
60: 
61: def regular(path):
62:     path = Path(path)
63:     info = path.lstat()
64:     return path.is_file() and not path.is_symlink() and not (info.st_file_attributes & REPARSE)
65: 
66: 
67: def git(*args):
68:     return subprocess.run(["git", *args], cwd=ROOT, stdout=subprocess.PIPE,
69:                           stderr=subprocess.PIPE, check=True).stdout
70: 
71: 
72: def source_snapshot():
73:     """Freeze tracked source plus the six explicitly admitted new source files."""
74:     tracked = {item.decode("utf-8") for item in git("ls-files", "-z").split(b"\0") if item}
75:     changed = {item.decode("utf-8") for item in git("diff", "--name-only", "-z").split(b"\0") if item}
76:     changed |= {item.decode("utf-8") for item in git("diff", "--cached", "--name-only", "-z").split(b"\0") if item}
77:     untracked = {item.decode("utf-8") for item in git("ls-files", "--others", "--exclude-standard", "-z").split(b"\0") if item}
78:     if not (changed | untracked) <= ALLOWLIST:
79:         raise RuntimeError(f"source outside frozen scope: {sorted((changed | untracked) - ALLOWLIST)}")
80:     # The 36k-file Git tree includes historic receipts and unrelated products.
81:     # Go's exact package closure and the current Mu producer closure are sealed
82:     # separately below; only source and contract candidates belong here.
83:     paths = {name for name in tracked if name.startswith(SOURCE_PREFIXES) or name in SOURCE_EXACT} | ALLOWLIST
84:     rows = []
85:     for relative in sorted(paths):
86:         path = ROOT / relative
87:         if not regular(path):
88:             raise RuntimeError(f"source missing or redirected: {relative}")
89:         rows.append({"path": relative, "sha256": sha256(path), "bytes": path.stat().st_size,
90:                      "candidate_delta": relative in ALLOWLIST})
91:     head = git("rev-parse", "HEAD").decode("ascii").strip()
92:     tree = git("show", "-s", "--format=%T", "HEAD").decode("ascii").strip()
93:     return {"head": head, "tree": tree, "tracked_count": len(tracked),
94:             "candidate_delta": sorted(changed | untracked), "files": rows,
95:             "digest": hashlib.sha256(canonical(rows)).hexdigest()}
96: 
97: 
98: def validate_migrations(root):
99:     migration_dir = Path(root) / "migrations/sqlite"
100:     files = sorted(p for p in migration_dir.glob("*.sql") if p.is_file())
101:     numbered = sorted(int(m.group(1)) for p in files if (m := re.fullmatch(r"(\d{4})_[A-Za-z0-9_]+\.sql", p.name)))
102:     if not numbered or numbered != list(range(1, max(numbered) + 1)) or not (migration_dir / "next_v24_sessions.sql").is_file():
103:         raise RuntimeError("continuous numbered SQLite migrations and next_v24_sessions.sql required")
104:     if len(files) != len(numbered) + 1:
105:         raise RuntimeError("unexpected SQLite migration name")
106:     return files
107: 
108: 
109: def exact_copy(source, target):
110:     source, target = Path(source), Path(target)
111:     if not regular(source):
112:         raise RuntimeError(f"nonregular or redirected source: {source}")
113:     target.parent.mkdir(parents=True, exist_ok=True)
114:     if target.exists():
115:         raise RuntimeError(f"output collision: {target}")
116:     shutil.copy2(source, target)
117:     if sha256(source) != sha256(target):
118:         raise RuntimeError(f"copy drift: {target}")
119: 
120: 
121: def copy_tree(source, target):
122:     source, target = Path(source), Path(target)
123:     if not source.is_dir() or source.is_symlink():
124:         raise RuntimeError(f"source directory unavailable: {source}")
125:     count = 0
126:     for current, directories, files in os.walk(source, followlinks=False):
127:         for name in directories:
128:             directory = Path(current) / name
129:             if directory.is_symlink() or directory.lstat().st_file_attributes & REPARSE:
130:                 raise RuntimeError(f"redirected directory: {directory}")
131:         for name in files:
132:             path = Path(current) / name
133:             exact_copy(path, target / path.relative_to(source))
134:             count += 1
135:     return count
136: 
137: 
138: def inventory(root):
139:     root = Path(root)
140:     rows = []
141:     for current, directories, files in os.walk(root, followlinks=False):
142:         for name in directories:
143:             path = Path(current) / name
144:             if path.is_symlink() or path.lstat().st_file_attributes & REPARSE:
145:                 raise RuntimeError(f"redirected output directory: {path}")
146:         for name in files:
147:             path = Path(current) / name
148:             if not regular(path):
149:                 raise RuntimeError(f"nonregular output: {path}")
150:             relative = path.relative_to(root).as_posix()
151:             if relative == "development-manifest.json":
152:                 continue
153:             rows.append({"path": relative, "sha256": sha256(path), "bytes": path.stat().st_size})
154:     return sorted(rows, key=lambda row: row["path"])
155: 
156: 
157: def json_stream(raw):
158:     source = raw.decode("utf-8")
159:     decoder = json.JSONDecoder()
160:     offset = 0
161:     while offset < len(source):
162:         while offset < len(source) and source[offset].isspace():
163:             offset += 1
164:         if offset == len(source):
165:             break
166:         item, offset = decoder.raw_decode(source, offset)
167:         yield item
168: 
169: 
170: def file_rows(paths):
171:     rows = []
172:     for path in sorted({Path(path).resolve() for path in paths}, key=lambda item: str(item).lower()):
173:         if not regular(path):
174:             raise RuntimeError(f"build input missing or redirected: {path}")
175:         rows.append({"path": str(path), "sha256": sha256(path), "bytes": path.stat().st_size})
176:     return rows
177: 
178: 
179: def go_compiled_closure(go_lists, toolchain_root):
180:     paths = set()
181:     package_count = 0
182:     fields = ("GoFiles", "CompiledGoFiles", "CgoFiles", "CFiles", "CXXFiles", "MFiles",
183:               "HFiles", "FFiles", "SFiles", "SwigFiles", "SwigCXXFiles", "SysoFiles", "EmbedFiles")
184:     for raw in go_lists:
185:         for package in json_stream(raw):
186:             package_count += 1
187:             directory = Path(package["Dir"])
188:             for field in fields:
189:                 for name in package.get(field, []):
190:                     source = Path(name)
191:                     paths.add(source if source.is_absolute() else directory / source)
192:             module = package.get("Module") or {}
193:             if module.get("GoMod"):
194:                 paths.add(Path(module["GoMod"]))
195:     tool_dir = Path(toolchain_root) / "pkg/tool/windows_amd64"
196:     tools = sorted(tool_dir.glob("*.exe"))
197:     if package_count < 20 or not tools:
198:         raise RuntimeError("Go package/toolchain closure incomplete")
199:     paths.update(tools)
200:     for name in ["go.env", "VERSION"]:
201:         path = Path(toolchain_root) / name
202:         if path.is_file():
203:             paths.add(path)
204:     return {"package_count": package_count, "tool_count": len(tools), "files": file_rows(paths)}
205: 
206: 
207: def mu_vendor_closure(common):
208:     manifest = json.loads((common / "third_party/mu.MANIFEST.json").read_bytes())
209:     entries = manifest.get("entries") or {}
210:     if manifest.get("files") != 5083 or len(entries) != 5083:
211:         raise RuntimeError("public Mu 5083-file manifest unavailable")
212:     paths = []
213:     for relative, expected in entries.items():
214:         if not relative.startswith("third_party/mu/") or ".." in Path(relative).parts:
215:             raise RuntimeError("Mu vendor manifest path invalid")
216:         path = common / relative
217:         if not regular(path) or path.stat().st_size != expected["size"] or sha256(path) != expected["sha256"]:
218:             raise RuntimeError(f"public Mu vendor source changed: {relative}")
219:         paths.append({"path": str(path.resolve()), "sha256": expected["sha256"], "bytes": expected["size"]})
220:     return sorted(paths, key=lambda row: row["path"].lower())
221: 
222: 
223: MU_META_SCRIPT = r'''
224: import { createRequire } from 'node:module';
225: import { createHash } from 'node:crypto';
226: import { join, resolve } from 'node:path';
227: const [worktree, common, output] = process.argv.slice(2);
228: const require = createRequire(import.meta.url);
229: const dependencies = join(common, 'third_party', 'mu', 'node_modules');
230: const esbuild = require(join(dependencies, 'esbuild'));
231: const result = await esbuild.build({
232:   entryPoints: [join(worktree, 'adapters/runtime/mu/worker.mjs')], bundle: true,
233:   platform: 'node', format: 'esm', target: 'node24', nodePaths: [dependencies],
234:   banner: { js: "import { createRequire as createRequireForMuWorker } from 'node:module'; const require = createRequireForMuWorker(import.meta.url);" },
235:   outfile: output, write: false, metafile: true, logLevel: 'warning',
236: });
237: const compiled = result.outputFiles.find(item => resolve(item.path) === resolve(output));
238: if (!compiled) throw Error('Mu compiled output absent');
239: process.stdout.write(JSON.stringify({ output_sha256: createHash('sha256').update(compiled.contents).digest('hex'),
240:   inputs: Object.keys(result.metafile.inputs).map(name => resolve(worktree, name)),
241:   esbuild_version: esbuild.version }) + '\n');
242: '''
243: 
244: 
245: def mu_compiled_closure(common, worktree, metadata, node, stage, receipts, env, run):
246:     script = stage / "mu-metafile.mjs"
247:     script.write_text(MU_META_SCRIPT, encoding="utf-8", newline="\n")
248:     raw = run(receipts, "mu-compiled-inputs", [node, script, worktree, common, stage / "mu-worker.mjs"], worktree, env)
249:     compiled = json.loads(raw)
250:     if compiled.get("output_sha256") != metadata["bundle_sha256"] or compiled.get("esbuild_version") != "0.28.2":
