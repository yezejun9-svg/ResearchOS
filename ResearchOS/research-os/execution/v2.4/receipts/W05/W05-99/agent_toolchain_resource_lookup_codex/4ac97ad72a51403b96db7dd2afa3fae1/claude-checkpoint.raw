lso\": \"plugins/cli-hints#next-steps\",\n      \"what-the-user-sees\": \"plugins/cli-hints#preview-what-the-user-sees\",\n    },\n    \"plugins/relevance\": {\n      \"how-it-works\": \"plugins/relevance#understand-how-plugin-relevance-works\",\n      \"what-the-user-sees\": \"plugins/relevance#preview-what-the-user-sees\",\n    },\n  }\n\n  function forward() {\n    var m = PLUGIN_PAGE.exec(window.location.pathname)\n    if (!m) return\n    var here = Object.prototype.hasOwnProperty.call(OLD_PAGE, m[2]) ? OLD_PAGE[m[2]] : m[2]\n    if (!Object.prototype.hasOwnProperty.call(MOVED, here)) return\n    var table = MOVED[here]\n    var hash = window.location.hash\n    if (!hash || hash.length \u003c 2) return\n    var id\n    try {\n      id = decodeURIComponent(hash.slice(1))\n    } catch (e) {\n      id = hash.slice(1)\n    }\n    if (document.getElementById(id)) return\n    if (!Object.prototype.hasOwnProperty.call(table, id)) return\n    var target = table[id]\n    if (typeof target !== 'string') return\n    var cut = target.indexOf('#')\n    var page = cut === -1 ? target : target.slice(0, cut)\n    var frag = cut === -1 ? '' : target.slice(cut)\n    if (page === here \u0026\u0026 !frag) {\n      // The content stayed on this page but lost its anchor: drop the dead\n      // hash so the address bar doesn't carry it, and stay put.\n      history.replaceState(null, '', window.location.pathname + window.location.search)\n      return\n    }\n    var dest = new URL(m[1] + page + window.location.search + frag, window.location.origin)\n    if (dest.origin !== window.location.origin) return\n    window.location.replace(dest.pathname + dest.search + dest.hash)\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', forward)\n  } else {\n    forward()\n  }\n  // A hash-only change on an already loaded page doesn't reload it, so\n  // check again when the fragment changes.\n  window.addEventListener('hashchange', forward)\n})()\n"])</script><script>self.__next_f.push([1,"56:[\"$\",\"$L5c\",null,{\"customJsDisabled\":false,\"jsFiles\":[{\"_id\":\"69bdb9fd7ba705a281409ac4\",\"filePath\":\"consent-loader.js\",\"subdomain\":\"claude-code\",\"__v\":0,\"content\":\"/**\\n * Consent banner loader for code.claude.com/docs.\\n *\\n * Mintlify auto-includes any .js file in the content root on every page.\\n * This loader injects the shared consent banner hosted on claude.com.\\n */\\n;(function () {\\n  var s = document.createElement('script')\\n  s.src = 'https://claude.com/shared/consent-banner.js'\\n  s.async = true\\n  document.head.appendChild(s)\\n})()\\n\"},{\"_id\":\"69fe40dc388017ee55c19b7a\",\"subdomain\":\"claude-code\",\"filePath\":\"antalytics-loader.js\",\"__v\":0,\"content\":\"$5d\"},{\"_id\":\"6a567ad87ec0f756509df168\",\"filePath\":\"toc-collapse.js\",\"subdomain\":\"claude-code\",\"__v\":0,\"content\":\"$5e\"},{\"_id\":\"6aa02c7db3ae356e0552bde8\",\"filePath\":\"settings-anchor-redirect.js\",\"subdomain\":\"claude-code\",\"__v\":0,\"content\":\"$5f\"},{\"_id\":\"6ab5b5a6e81de3b1772a6cfe\",\"filePath\":\"plugins-anchor-redirect.js\",\"subdomain\":\"claude-code\",\"__v\":0,\"content\":\"$60\"}]}]\n"])</script><script>self.__next_f.push([1,"63:T2eef2,"])</script><script>self.__next_f.push([1,"\"use strict\";const{Fragment:_Fragment,jsx:_jsx,jsxs:_jsxs}=arguments[0];const{useMDXComponents:_provideComponents}=arguments[0];function _createMdxContent(props){const _components={a:`a`,code:`code`,li:`li`,p:`p`,pre:`pre`,span:`span`,strong:`strong`,tbody:`tbody`,td:`td`,th:`th`,thead:`thead`,tr:`tr`,ul:`ul`,..._provideComponents(),...props.components},{CodeBlock,CodeGroup,Heading,Note,Step,Steps,Tab,Table,Tabs,Tip,Warning}=_components;if(!CodeBlock)_missingMdxReference(`CodeBlock`,true);if(!CodeGroup)_missingMdxReference(`CodeGroup`,true);if(!Heading)_missingMdxReference(`Heading`,true);if(!Note)_missingMdxReference(`Note`,true);if(!Step)_missingMdxReference(`Step`,true);if(!Steps)_missingMdx