en/agent-sdk/migration-guide\"},{\"title\":\"Troubleshoot the Agent SDK\",\"sidebarTitle\":\"Troubleshooting\",\"description\":\"Fix Agent SDK errors when the Claude Code CLI fails to start, the CLI process exits, or a successful result arrives without structured output.\",\"keywords\":[\"error\",\"troubleshoot\",\"fix\",\"not working\",\"CLINotFoundError\",\"Claude Code not found\",\"structured_output None\",\"structured output empty\",\"CLIConnectionError\",\"Refusing to execute batch script\",\"claude.cmd\",\"ProcessError\",\"Command failed with exit code\",\"Claude Code process exited with code\",\"Claude Code returned an error result\",\"ResultError\",\"Failed to start Claude Code\",\"exists but failed to launch\",\"Failed to spawn Claude Code process\",\"Claude Code native binary not found\",\"Claude Code executable not found\",\"Native CLI binary not found\",\"Not connected\"],\"href\":\"/en/agent-sdk/troubleshooting\"}]},{\"group\":\"Build agents\",\"pages\":[{\"title\":\"Configure your agent\",\"description\":\"Configure Agent SDK sessions: compose the options object, set the model, environment, and limits, and find each feature option's page.\",\"href\":\"/en/agent-sdk/configuration\"},{\"title\":\"Examples\",\"description\":\"Find a complete, runnable Agent SDK project or a guided recipe in the Claude Cookbook that matches what you want to build.\",\"href\":\"/en/agent-sdk/examples\"}]},{\"group\":\"Core concepts\",\"pages\":[{\"title\":\"How the agent loop works\",\"description\":\"Understand the message lifecycle, tool execution, context window, and architecture that power your SDK agents.\",\"href\":\"/en/agent-sdk/agent-loop\"},{\"title\":\"Use Claude Code features in the SDK\",\"sidebarTitle\":\"Use Claude Code features\",\"description\":\"Load project instructions, skills, hooks, and other Claude Code features into your SDK agents.\",\"href\":\"/en/agent-sdk/claude-code-features\"},{\"title\":\"Work with sessions\",\"description\":\"How sessions persist agent conversation history, and when to use continue, resume, and fork to return to a prior run.\",\"href\":\"/en/agent-sdk/sessions\"},{\"title\":\"Persist sessions to external storage\",\"description\":\"Mirror Agent SDK session transcripts to your own object store, key-value store, or database so other hosts can resume your sessions.\",\"keywords\":[\"SessionStore\",\"session store\",\"session persistence\",\"S3\",\"Redis\",\"Postgres\",\"resume\",\"multi-host\"],\"href\":\"/en/agent-sdk/session-storage\"}]},{\"group\":\"Input and output\",\"pages\":[{\"title\":\"Streaming Input\",\"description\":\"Understanding the two input modes for Claude Agent SDK and when to use each\",\"href\":\"/en/agent-sdk/streaming-vs-single-mode\"},{\"title\":\"Handle approvals and user input\",\"description\":\"Surface Claude's approval requests and clarifying questions to users, then return their decisions to the SDK.\",\"href\":\"/en/agent-sdk/user-input\"},{\"title\":\"Stream responses in real-time\",\"description\":\"Get real-time responses from the Agent SDK as text and tool calls stream in\",\"href\":\"/en/agent-sdk/streaming-output\"},{\"title\":\"Get structured output from agents\",\"description\":\"Return validated JSON from agent workflows using JSON Schema, Zod, or Pydantic. Get type-safe, structured data after multi-turn tool use.\",\"href\":\"/en/agent-sdk/structured-outputs\"}]},{\"group\":\"Extend with tools\",\"pages\":[{\"title\":\"Give Claude custom tools\",\"description\":\"Define custom tools with the Claude Agent SDK's in-process MCP server so Claude can call your functions, hit your APIs, and perform domain-specific operations.\",\"href\":\"/en/agent-sdk/custom-tools\"},{\"title\":\"Connect to external tools with MCP\",\"description\":\"Configure MCP servers to extend your agent with external tools. Covers transport types, tool search for large tool sets, authentication, and error handling.\",\"href\":\"/en/agent-sdk/mcp\"},{\"title\":\"Scale to many tools with tool search\",\"description\":\"Scale your agent to thousands of tools by discovering and loading only what's needed, on demand.\",\"href\":\"/en/agent-sdk/tool-search\"},{\"title\":\"Subagents in the SDK\",\"description\":\"Define and invoke subagents to isolate context, run tasks in parallel, and apply specialized instructions in your Claude Agent SDK applications.\",\"href\":\"/en/agent-sdk/subagents\"}]},{\"group\":\"Customize behavior\",\"pages\":[{\"title\":\"Modifying system prompts\",\"description\":\"Choose between the `claude_code` preset and a custom system prompt, and customize behavior with CLAUDE.md, output styles, append, or a fully custom prompt.\",\"keywords\":[\"system prompt\",\"systemPrompt\",\"system_prompt\",\"claude_code preset\",\"preset\",\"append\",\"custom system prompt\",\"output styles\",\"CLAUDE.md\",\"excludeDynamicSections\",\"exclude_dynamic_sections\",\"SYSTEM_PROMPT_DYNAMIC_BOUNDARY\",\"cache boundary\",\"settingSources\",\"setting_sources\",\"prompt caching\",\"default system prompt\",\"minimal prompt\",\"agent persona\",\"agent identity\",\"replace system prompt\"],\"href\":\"/en/agent-sdk/modifying-system-prompts\"},{\"title\":\"Extend agents with skills\",\"description\":\"Control which skills Claude can invoke in Claude Agent SDK sessions, dispatch commands by name, and author skills your sessions discover\",\"href\":\"/en/agent-sdk/skills\"},{\"title\":\"Plugins in the SDK\",\"description\":\"Load custom plugins to extend Claude Code with skills, agents, hooks, and MCP servers through the Agent SDK\",\"href\":\"/en/agent-sdk/plugins\"}]},{\"group\":\"Control and observability\",\"pages\":[{\"title\":\"Configure permissions\",\"description\":\"Control how your agent uses tools with permission modes, hooks, and declarative allow/deny rules.\",\"href\":\"/en/agent-sdk/permissions\"},{\"title\":\"Intercept and control agent behavior with hooks\",\"description\":\"Intercept and customize agent behavior at key execution points with hooks\",\"href\":\"/en/agent-sdk/hooks\"},{\"title\":\"Rewind file changes with checkpointing\",\"description\":\"Track file changes during agent sessions and restore files to any previous state\",\"href\":\"/en/agent-sdk/file-checkpointing\"},{\"title\":\"Track cost and usage\",\"description\":\"Learn how to track token usage, estimate costs, and configure prompt caching with the Claude Agent SDK.\",\"keywords\":[\"token usage\",\"cost\",\"billing\",\"prompt caching\",\"cache TTL\",\"ENABLE_PROMPT_CACHING_1H\",\"CLAUDE_CODE_PROMPT_CACHE_TTL\",\"promptCacheTtl\",\"modelPricing\",\"cache_read_input_tokens\",\"total_cost_usd\"],\"href\":\"/en/agent-sdk/cost-tracking\"},{\"title\":\"Observability with OpenTelemetry\",\"description\":\"Export traces, metrics, and events from the Agent SDK to your observability backend using OpenTelemetry.\",\"href\":\"/en/agent-sdk/observability\"},{\"title\":\"Track todos\",\"description\":\"Track todos in Agent SDK sessions and render Claude's progress in your application from structured tool calls\",\"href\":\"/en/agent-sdk/todo-tracking\"}]},{\"group\":\"Deployment\",\"pages\":[{\"title\":\"Hosting the Agent SDK\",\"description\":\"Deploy the Agent SDK in production: subprocess architecture, session persistence, scaling, observability, and multi-tenant isolation for Docker, Kubernetes, and sandbox providers.\",\"href\":\"/en/agent-sdk/hosting\"},{\"title\":\"Securely deploying AI agents\",\"description\":\"A guide to securing Claude Code and Agent SDK deployments with isolation, credential management, and network controls\",\"href\":\"/en/agent-sdk/secure-deployment\"}]},{\"group\":\"SDK references\",\"pages\":[{\"title\":\"Agent SDK reference - TypeScript\",\"sidebarTitle\":\"TypeScript SDK\",\"description\":\"Complete API reference for the TypeScript Agent SDK, including all functions, types, and interfaces.\",\"href\":\"/en/agent-sdk/typescript\"},{\"title\":\"TypeScript SDK V2 session API (removed)\",\"sidebarTitle\":\"Typ