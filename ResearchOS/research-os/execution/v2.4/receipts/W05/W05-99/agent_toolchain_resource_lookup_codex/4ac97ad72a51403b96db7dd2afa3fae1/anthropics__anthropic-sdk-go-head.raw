e-please-start-version -->\n \n ```sh\n-go get -u 'github.com/anthropics/anthropic-sdk-go@v1.77.0'\n+go get -u 'github.com/anthropics/anthropic-sdk-go@v1.78.0'\n ```\n \n <!-- x-release-please-end -->"},{"sha":"9f1dec3fb13deaa78488fae7a725a65c2947fe9b","filename":"api.md","status":"modified","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/anthropics/anthropic-sdk-go/blob/c9ebe447ac92c91748af817c265398e5d81ca49f/api.md","raw_url":"https://github.com/anthropics/anthropic-sdk-go/raw/c9ebe447ac92c91748af817c265398e5d81ca49f/api.md","contents_url":"https://api.github.com/repos/anthropics/anthropic-sdk-go/contents/api.md?ref=c9ebe447ac92c91748af817c265398e5d81ca49f","patch":"@@ -2340,6 +2340,7 @@ Response Types:\n Methods:\n \n - <code title=\"get /v1/organizations/spend_limits/{spend_limit_id}?beta=true\">client.Beta.Organization.SpendLimits.<a href=\"https://pkg.go.dev/github.com/anthropics/anthropic-sdk-go#BetaOrganizationSpendLimitService.Get\">Get</a>(ctx <a href=\"https://pkg.go.dev/context\">context</a>.<a href=\"https://pkg.go.dev/context#Context\">Context</a>, spendLimitID <a href=\"https://pkg.go.dev/builtin#string\">string</a>) (\\*<a href=\"https://pkg.go.dev/github.com/anthropics/anthropic-sdk-go\">anthropic</a>.<a href=\"https://pkg.go.dev/github.com/anthropics/anthropic-sdk-go#BetaSpendLimit\">BetaSpendLimit</a>, <a href=\"https://pkg.go.dev/builtin#error\">error</a>)</code>\n+- <code title=\"get /v1/organizations/spend_limits?beta=true\">client.Beta.Organization.SpendLimits.<a href=\"https://pkg.go.dev/github.com/anthropics/anthropic-sdk-go#BetaOrganizationSpendLimitService.List\">List</a>(ctx <a href=\"https://pkg.go.dev/context\">context</a>.<a href=\"https://pkg.go.dev/context#Context\">Context</a>, params <a href=\"https://pkg.go.dev/github.com/anthropics/anthropic-sdk-go\">anthropic</a>.<a href=\"https://pkg.go.dev/github.com/anthropics/anthropic-sdk-go#BetaOrganizationSpendLimitListParams\">BetaOrganizationSpendLimitListParams<