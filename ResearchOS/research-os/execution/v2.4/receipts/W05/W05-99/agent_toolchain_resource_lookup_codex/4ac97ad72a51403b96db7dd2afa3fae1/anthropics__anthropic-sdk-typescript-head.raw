Response();\n+    expect(rawResponse).toBeInstanceOf(Response);\n+    const response = await responsePromise;\n+    expect(response).not.toBeInstanceOf(Response);\n+    const dataAndResponse = await responsePromise.withResponse();\n+    expect(dataAndResponse.data).toBe(response);\n+    expect(dataAndResponse.response).toBe(rawResponse);\n+  });\n+\n+  test('list: request options and params are passed correctly', async () => {\n+    // ensure the request options are being passed correctly by passing an invalid HTTP method in order to cause an error\n+    await expect(\n+      client.beta.organization.spendLimits.list(\n+        {\n+          limit: 1,\n+          page: 'page',\n+          scope_type: ['organization'],\n+          betas: ['message-batches-2024-09-24'],\n+        },\n+        { path: '/_stainless_unknown_path' },\n+      ),\n+    ).rejects.toThrow(Anthropic.NotFoundError);\n+  });\n+\n   test('delete', async () => {\n     const responsePromise = client.beta.organization.spendLimits.delete('spend_limit_id');\n     const rawResponse = await responsePromise.asResponse();"},{"sha":"c22fd6d93db4f593d93f8092af72f7487f8f505d","filename":"tests/api-resources/messages/messages.test.ts","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/anthropics/anthropic-sdk-typescript/blob/d49bdab458000bcdffe77bd84b03293f31824fb3/tests%2Fapi-resources%2Fmessages%2Fmessages.test.ts","raw_url":"https://github.com/anthropics/anthropic-sdk-typescript/raw/d49bdab458000bcdffe77bd84b03293f31824fb3/tests%2Fapi-resources%2Fmessages%2Fmessages.test.ts","contents_url":"https://api.github.com/repos/anthropics/anthropic-sdk-typescript/contents/tests%2Fapi-resources%2Fmessages%2Fmessages.test.ts?ref=d49bdab458000bcdffe77bd84b03293f31824fb3","patch":"@@ -205,7 +205,7 @@ describe('create: non-streaming timeout', () => {\n \n   // max_tokens large enough that the estimated non-streaming duration exceeds the 10 minute default\n   const longParams = {\n-    model: 'claude-sonnet-4-5',\n+    model: 'claude-sonnet-5-5',\n     max_tokens: 128_000,\n     messages: [{ role: 'user' as const, content: 'hi' }],\n   };"},{"sha":"f3356ae09fcbb331530d144f3f3213e8ba95fadf","filename":"tests/index.test.ts","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/anthropics/anthropic-sdk-typescript/blob/d49bdab458000bcdffe77bd84b03293f31824fb3/tests%2Findex.test.ts","raw_url":"https://github.com/anthropics/anthropic-sdk-typescript/raw/d49bdab458000bcdffe77bd84b03293f31824fb3/tests%2Findex.test.ts","contents_url":"https://api.github.com/repos/anthropics/anthropic-sdk-typescript/contents/tests%2Findex.test.ts?ref=d49bdab458000bcdffe77bd84b03293f31824fb3","patch":"@@ -930,7 +930,7 @@ describe('retries', () => {\n \n     try {\n       await client.messages.create({\n-        model: 'claude-sonnet-4-5-20250929',\n+        model: 'claude-sonnet-5-5',\n         max_tokens: 1,\n         messages: [{ role: 'user', content: 'hi' }],\n       });"}]}