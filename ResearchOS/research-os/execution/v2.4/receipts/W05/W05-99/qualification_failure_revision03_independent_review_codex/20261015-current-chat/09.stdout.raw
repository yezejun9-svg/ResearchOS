49: 
50: type LocalUpgradeOptions struct {
51: 	Source, Snapshot, Destination, KeyFile string
52: 	SourceRoot, TargetRoot                 string
53: 	SourceProgram, TargetProgram           string
54: 	Plan                                   string
55: }
56: 
57: // Public callers cannot replace the concrete authenticated LIVE service with a
58: // JSON declaration, environment switch, fake Provider, or an arbitrary callback.
59: func UpgradeLocal(ctx context.Context, opt LocalUpgradeOptions) (RestoreReport, error) {
60: 	return upgradeLocal(ctx, opt, upgradeVerifier{
61: 		provider: &protectedstore.FrozenProvider{},
62: 		summary: func(ctx context.Context) (protectedstore.SafeSummary, error) {
63: 			if e := ctx.Err(); e != nil {
64: 				return protectedstore.SafeSummary{}, e
65: 			}
66: 			return protectedstore.QueryFrozenService("aggregate")
67: 		},
68: 	})
69: }
70: 
71: type upgradeVerifier struct {
72: 	provider protectedstore.Provider
245: func upgradeLocal(ctx context.Context, opt LocalUpgradeOptions, verifier upgradeVerifier) (RestoreReport, error) {
246: 	if opt.Plan == PreparedAbandonmentSchemaUpgradePlan {
247: 		return upgradePreparedAbandonmentLocal(ctx, opt, verifier)
248: 	}
249: 	if opt.Plan == ConfigurationSchemaUpgradePlan {
250: 		return upgradeConfigurationLocal(ctx, opt, verifier)
251: 	}
252: 	if opt.Plan == QueueSchemaUpgradePlan {
253: 		return upgradeQueueLocal(ctx, opt, verifier)
254: 	}
255: 	report := RestoreReport{Started: Now(), Status: "FAILED"}
256: 	targetVersion := 14
257: 	switch opt.Plan {
258: 	case LocalUpgradePlan:
259: 	case FinalSchemaUpgradePlan:
260: 		targetVersion = 20
261: 	default:
262: 		return report, fmt.Errorf("UPGRADE_PLAN_UNSUPPORTED")
263: 	}
264: 	if e := upgradePaths(&opt); e != nil {
265: 		return report, e
266: 	}
267: 	sourceRelease, _, e := upgradeRelease(opt.SourceRoot, 13)
268: 	if e != nil {
269: 		return report, e
270: 	}
271: 	targetRelease, sqls, e := upgradeRelease(opt.TargetRoot, targetVersion)
272: 	if e != nil {
273: 		return report, e
274: 	}
275: 	contracts, e := LoadContracts(filepath.Join(opt.TargetRoot, "spec/v2.0/contracts"))
276: 	if e != nil {
277: 		return report, e
278: 	}
279: 	expectedSourceSchema, expectedTargetSchema, e := upgradeTemplate(ctx, sqls, contracts)
280: 	if e != nil {
281: 		return report, e
282: 	}
283: 	key, e := os.ReadFile(opt.KeyFile)
284: 	if e != nil || len(key) != 32 {
285: 		return report, fmt.Errorf("BACKUP_KEY_UNAVAILABLE")
286: 	}
287: 	defer clear(key)
288: 	db, e := upgradeOpenExclusive(ctx, opt.Source)
289: 	if e != nil {
290: 		return report, e
291: 	}
292: 	defer db.Close() // The native source lock spans snapshot through publication.
293: 	versions, e := backupMigrations(db)
294: 	if e != nil || !reflect.DeepEqual(versions, upgradeVersions(13)) {
295: 		return report, fmt.Errorf("UPGRADE_SOURCE_VERSION: require exact 1..13")
