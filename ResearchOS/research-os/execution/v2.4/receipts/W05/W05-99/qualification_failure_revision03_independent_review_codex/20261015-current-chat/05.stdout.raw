{
  "schema": "researchos.C-single-native-lease-tests.v3",
  "status": "DESIGN_NOT_EXECUTED",
  "entries": ["backup create", "backup export", "upgrade schema13to14", "upgrade schema13to20", "upgrade schema21to22", "upgrade schema22to23", "upgrade schema23to24", "upgrade-prepared-backup", "release_host legacy", "release_host control bootstrap/resume", "inherited prepared recovery", "inherited schema migration", "fixture replay", "normal Core", "replacement commit/recover", "C commit/recover/abort"],
  "cuts": [
    {"id":"CL01","case":"pending C BEGIN or pending replacement in each entry","expect":"denied while native lock held before protected/key/provider/template/store boundary; sentinel access counts0"},
    {"id":"CL02","case":"real held lease, both clear namespaces, each of five upgrade plans","expect":"entry crosses real guarded adapter; one native acquisition; source DB closes before borrow then outer release"},
    {"id":"CL03","case":"prepared local and prepared handoff nested helper success/failure","expect":"no second acquisition, no inner close of outer; Held remains true until outer close"},
    {"id":"CL04","case":"zero/closed/wrong-root/wrong-file/released/stale/copied/concurrent borrow","expect":"reject without secret/DB access; parent Close while active borrow refuses"},
    {"id":"CL05","case":"direct old public API or direct typed adapter without caller combined gate","expect":"old APIs fail early; typed adapter runs both gates itself and cannot bypass replacement"},
    {"id":"CL06","case":"strict completed replacement COMMITTED/ABORTED history, forks/missing predecessor/digest drift/stage leftovers","expect":"lower reader and original host validator agree; malformed always rejects"},
    {"id":"CL07","case":"C own-operation permit used for replacement/backup, replacement permit used for C","expect":"cross-namespace and BackupSourceBorrow exemption rejected"},
    {"id":"CL08","case":"release_host legacy ordering and control fixture launch handoff/resume","expect":"legacy gate before Canary/store; control driver plus child gates cannot skip pending journal and never hold duplicate lifetime lease"},
    {"id":"CL09","case":"inherited tokens before/after combined gate, mismatch or token close","expect":"same token-native lease remains held; no extra acquire or token/handle export; invalid token cannot open DB"},
    {"id":"CL10","case":"nonWindows, restore existing-root alias, mixed early arguments","expect":"explicit unsupported/forbidden before setup; no nil-authority success"},
    {"id":"CL11","case":"source identity changes after canonicalization/options copy","expect":"borrow Check catches drift before DB; normalized handoff retains same private capability"}
  ],
  "real_native_fixture_required": true,
  "no_callback_or_boolean_authority": true,
  "actual_operations": 0,
  "formal_increment": 0
}

