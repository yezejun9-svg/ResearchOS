50: // Supply the protected descriptor to the native create itself. A process death
51: // between mkdir and a later SetNamedSecurityInfo must not strand recovery with
52: // an inherited (rather than protected) operation directory.
53: func replacementMkdirPrivate(path string) error {
151: func replacementReadJournal(dir string, p replacementPlan, raw []byte) (replacementJournalView, error) {
152: 	v := replacementJournalView{Files: map[string][]byte{}}
153: 	if _, e := replacementIdentity(dir, true); e != nil {
154: 		return v, e
155: 	}
156: 	if e := replacementACL(dir, true, true); e != nil {
157: 		return v, e
158: 	}
159: 	guards, e := guardWriteDirectories(dir)
160: 	if e != nil {
161: 		return v, e
162: 	}
163: 	defer closeWriteGuards(guards)
164: 	entries, e := os.ReadDir(dir)
165: 	if e != nil {
166: 		return v, e
167: 	}
168: 	if len(entries) > 12 {
169: 		return v, errors.New("journal entry bound exceeded")
170: 	}
171: 	for _, entry := range entries {
172: 		name := entry.Name()
173: 		if entry.IsDir() {
174: 			return v, errors.New("journal contains directory")
175: 		}
176: 		data, e := replacementRead(filepath.Join(dir, name), 256<<10)
177: 		if e != nil {
178: 			return v, e
179: 		}
180: 		v.Files[name] = data
181: 		switch name {
182: 		case "plan.json":
183: 			if !bytes.Equal(data, raw) {
184: 				return v, errors.New("same ID with different plan")
185: 			}
186: 		case "old-registration.bin":
187: 			if !bytes.Equal(data, p.OldBytes) {
188: 				return v, errors.New("old snapshot differs")
189: 			}
190: 		case "new-registration.bin", "stage.bin":
191: 			if !bytes.Equal(data, p.NewBytes) {
192: 				return v, errors.New("new snapshot differs")
193: 			}
194: 		case "actual-backup.bin": // Preserve third-party bytes; observation classifies them UNKNOWN.
195: 		default:
196: 			var event replacementEvent
197: 			if decodeRuntimeManaged(data, &event) != nil || name != fmt.Sprintf("%04d-%s.json", len(v.Events)+1, strings.ToLower(event.State)) {
198: 				return v, errors.New("unknown/orphan journal file")
199: 			}
200: 			want := event.Hash
201: 			event.Hash = ""
202: 			if want != domain.Hash(event) || event.Schema != replacementSchema || event.Sequence != len(v.Events)+1 || event.OperationID != p.OperationID || event.PlanSHA256 != domain.Digest(raw) || event.OldSHA256 != p.OldSHA256 || event.NewSHA256 != p.NewSHA256 {
203: 				return v, errors.New("event linkage corrupt")
204: 			}
205: 			previous, state := "", ""
206: 			if len(v.Events) > 0 {
207: 				last := v.Events[len(v.Events)-1]
208: 				previous, state = last.Hash, last.State
209: 				// Audit clocks can change precision or move backwards. Sequence,
210: 				// previous hash and transition are the only ordering authority.
211: 			}
212: 			if event.Previous != previous || !replacementTransition(state, event.State) {
213: 				return v, errors.New("event chain invalid")
214: 			}
215: 			if _, e = time.Parse(time.RFC3339Nano, event.At); e != nil {
216: 				return v, e
217: 			}
218: 			event.Hash = want
219: 			v.Events = append(v.Events, event)
220: 		}
221: 	}
222: 	if len(v.Events) > 0 {
223: 		for _, name := range []string{"plan.json", "old-registration.bin", "new-registration.bin"} {
224: 			if _, ok := v.Files[name]; !ok {
225: 				return v, errors.New("journal snapshot missing")
226: 			}
227: 		}
228: 	}
229: 	return v, nil
230: }
231: func replacementTransition(old, new string) bool {
232: 	switch old {
233: 	case "":
234: 		return new == "PREPARED" || new == "ABORTED"
235: 	case "PREPARED":
236: 		return new == "PUBLISHING" || new == "ABORTED"
237: 	case "PUBLISHING":
238: 		return new == "COMMITTED" || new == "ABORTED"
239: 	}
240: 	return false
439: // RuntimeVerifierReplacementStartupGate is read-only and must run while the
440: // caller holds its existing lease, before store.Open or any migration.
441: func RuntimeVerifierReplacementStartupGate(lease *rt.DataRootLease) error {
442: 	if lease == nil || !lease.Held() {
443: 		return errors.New("replacement startup gate requires data-root lease")
444: 	}
445: 	return replacementCheckHistoryCurrent(lease.Root())
446: }
447: func replacementCheckHistoryCurrent(dataRoot string) error {
448: 	head, e := replacementReadHistory(dataRoot, "")
449: 	if e != nil {
450: 		return e
451: 	}
452: 	if head.Sequence == 0 {
453: 		return nil
454: 	}
455: 	raw, e := replacementRead(filepath.Join(dataRoot, "host", "runtime-verifier-installation.json"), 64<<10)
456: 	if e != nil {
457: 		return e
458: 	}
459: 	if domain.Digest(raw) != head.RecordSHA256 {
460: 		return errors.New("latest replacement registration drift")
461: 	}
462: 	return nil
463: }
464: 
465: // Every new plan binds the previous immutable terminal, including ABORTED
466: // operations. No wall clock, directory enumeration order, or byte-hash cycle is
467: // used to infer causality. Unbound older draft plans remain intact and fail
468: // closed; this maintenance command does not silently rewrite/migrate history.
469: func replacementReadHistory(dataRoot, excludeOperation string) (head replacementHistoryHead, err error) {
470: 	root := filepath.Join(dataRoot, "host", replacementJournal)
471: 	if _, e := os.Lstat(root); os.IsNotExist(e) {
472: 		return head, nil
473: 	} else if e != nil {
474: 		return head, e
475: 	}
476: 	if _, e := replacementIdentity(root, true); e != nil {
477: 		return head, e
478: 	}
479: 	if e := replacementACL(root, true, true); e != nil {
480: 		return head, e
481: 	}
482: 	guards, e := guardWriteDirectories(root)
483: 	if e != nil {
484: 		return head, e
485: 	}
486: 	defer closeWriteGuards(guards)
487: 	entries, e := os.ReadDir(root)
488: 	if e != nil {
489: 		return head, e
490: 	}
491: 	type terminal struct {
492: 		P          replacementPlan
493: 		E          replacementEvent
494: 		PlanSHA256 string
495: 	}
496: 	var all []terminal
497: 	for _, entry := range entries {
498: 		if !entry.IsDir() || !replacementID(entry.Name()) {
499: 			return head, errors.New("replacement journal malformed; explicit recover required")
500: 		}
501: 		if entry.Name() == excludeOperation {
502: 			continue
503: 		}
504: 		dir := filepath.Join(root, entry.Name())
505: 		raw, e := replacementRead(filepath.Join(dir, "plan.json"), 256<<10)
506: 		if e != nil {
507: 			return head, fmt.Errorf("replacement unfinished; explicit recover required: %w", e)
508: 		}
509: 		var p replacementPlan
510: 		if decodeRuntimeManaged(raw, &p) != nil || replacementPlanValid(p) != nil || p.OperationID != entry.Name() || p.DataRoot != dataRoot {
511: 			return head, errors.New("replacement plan invalid; explicit recover required")
512: 		}
513: 		v, e := replacementReadJournal(dir, p, raw)
514: 		if e != nil {
515: 			return head, e
516: 		}
517: 		if len(v.Events) == 0 {
518: 			return head, errors.New("replacement unfinished; explicit recover required")
519: 		}
520: 		last := v.Events[len(v.Events)-1]
521: 		switch last.State {
522: 		case "COMMITTED":
523: 			if !bytes.Equal(v.Files["actual-backup.bin"], p.OldBytes) || v.Files["stage.bin"] != nil {
524: 				return head, errors.New("committed backup/stage invalid")
525: 			}
526: 		case "ABORTED":
527: 			if v.Files["actual-backup.bin"] != nil {
528: 				return head, errors.New("aborted journal has publication evidence")
529: 			}
530: 		default:
531: 			return head, errors.New("replacement unfinished; use --runtime-verifier-replacement recover")
532: 		}
533: 		all = append(all, terminal{p, last, domain.Digest(raw)})
534: 	}
535: 	if len(all) == 0 {
536: 		return head, nil
537: 	}
538: 	sort.Slice(all, func(i, j int) bool { return all[i].P.HistorySequence < all[j].P.HistorySequence })
539: 	for _, t := range all {
540: 		if !replacementExtendsHead(t.P, head) {
541: 			return head, errors.New("causal history fork, cycle, missing predecessor or digest drift")
542: 		}
543: 		record := t.P.OldSHA256
544: 		if t.E.State == "COMMITTED" {
545: 			record = t.P.NewSHA256
546: 		}
547: 		head = replacementHistoryHead{Sequence: t.P.HistorySequence, OperationID: t.P.OperationID, PlanSHA256: t.PlanSHA256, TerminalHash: t.E.Hash, RecordSHA256: record}
548: 	}
549: 	return head, nil
550: }
