97: func replacementID(s string) bool {
98: 	b, e := hex.DecodeString(s)
99: 	return e == nil && len(b) == 16 && strings.ToLower(s) == s
100: }
101: func replacementDigest(s string) bool {
102: 	b, e := hex.DecodeString(strings.TrimPrefix(s, "sha256:"))
103: 	return strings.HasPrefix(s, "sha256:") && e == nil && len(b) == 32 && strings.ToLower(s) == s
104: }
105: func replacementPath(p string) error {
106: 	if !filepath.IsAbs(p) || filepath.Clean(p) != p || len(filepath.VolumeName(p)) != 2 || strings.Contains(p[2:], ":") {
107: 		return errors.New("canonical absolute local path required")
108: 	}
109: 	return nil
110: }
111: func replacementACL(path string, dir, private bool) error {
112: 	sid, e := currentSIDString()
113: 	if e != nil {
114: 		return e
115: 	}
116: 	sd, e := windows.GetNamedSecurityInfo(path, windows.SE_FILE_OBJECT, windows.OWNER_SECURITY_INFORMATION|windows.DACL_SECURITY_INFORMATION)
117: 	if e != nil {
118: 		return e
119: 	}
120: 	owner, _, e := sd.Owner()
121: 	if e != nil || owner == nil || owner.String() != sid {
122: 		return errors.New("current SID owner required")
123: 	}
124: 	if !private {
125: 		return nil
126: 	}
127: 	control, _, e := sd.Control()
128: 	if e != nil || control&windows.SE_DACL_PROTECTED == 0 {
129: 		return errors.New("protected private DACL required")
130: 	}
131: 	acl, _, e := sd.DACL()
132: 	if e != nil || acl == nil || acl.AceCount != 1 {
133: 		return errors.New("single private ACE required")
134: 	}
135: 	var ace *windows.ACCESS_ALLOWED_ACE
136: 	if windows.GetAce(acl, 0, &ace) != nil {
137: 		return errors.New("private ACE unavailable")
138: 	}
139: 	flags := byte(0)
140: 	if dir {
141: 		flags = windows.OBJECT_INHERIT_ACE | windows.CONTAINER_INHERIT_ACE
142: 	}
143: 	if ace.Header.AceType != windows.ACCESS_ALLOWED_ACE_TYPE || ace.Header.AceFlags != flags || ace.Mask != 0x001f01ff || (*windows.SID)(unsafe.Pointer(&ace.SidStart)).String() != sid {
144: 		return errors.New("private ACE differs")
145: 	}
146: 	return nil
147: }
148: func replacementIdentity(path string, dir bool) (replacementFileID, error) {
149: 	var out replacementFileID
150: 	if e := replacementPath(path); e != nil {
151: 		return out, e
152: 	}
153: 	p, e := windows.UTF16PtrFromString(path)
154: 	if e != nil {
155: 		return out, e
156: 	}
157: 	h, e := windows.CreateFile(p, windows.FILE_READ_ATTRIBUTES, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE|windows.FILE_SHARE_DELETE, nil, windows.OPEN_EXISTING, windows.FILE_FLAG_OPEN_REPARSE_POINT|windows.FILE_FLAG_BACKUP_SEMANTICS, 0)
158: 	if e != nil {
159: 		return out, e
160: 	}
161: 	defer windows.CloseHandle(h)
162: 	var i windows.ByHandleFileInformation
163: 	if e = windows.GetFileInformationByHandle(h, &i); e != nil {
164: 		return out, e
165: 	}
166: 	if i.FileAttributes&windows.FILE_ATTRIBUTE_REPARSE_POINT != 0 || (i.FileAttributes&windows.FILE_ATTRIBUTE_DIRECTORY != 0) != dir || (!dir && i.NumberOfLinks != 1) {
167: 		return out, errors.New("reparse, alias or wrong file type")
168: 	}
169: 	return replacementFileID{i.VolumeSerialNumber, i.FileIndexHigh, i.FileIndexLow}, nil
170: }
171: func replacementRead(path string, limit int64) ([]byte, error) {
172: 	if _, e := replacementIdentity(path, false); e != nil {
173: 		return nil, e
174: 	}
175: 	guards, e := guardWriteDirectories(filepath.Dir(path))
176: 	if e != nil {
177: 		return nil, e
178: 	}
179: 	defer closeWriteGuards(guards)
180: 	wide, e := windows.UTF16PtrFromString(path)
181: 	if e != nil {
182: 		return nil, e
183: 	}
184: 	h, e := windows.CreateFile(wide, windows.GENERIC_READ, windows.FILE_SHARE_READ, nil, windows.OPEN_EXISTING, windows.FILE_FLAG_OPEN_REPARSE_POINT, 0)
185: 	if e != nil {
186: 		return nil, e
187: 	}
188: 	f := os.NewFile(uintptr(h), path)
189: 	defer f.Close()
190: 	var info windows.ByHandleFileInformation
191: 	if e = windows.GetFileInformationByHandle(h, &info); e != nil {
192: 		return nil, e
193: 	}
194: 	if info.FileAttributes&(windows.FILE_ATTRIBUTE_DIRECTORY|windows.FILE_ATTRIBUTE_REPARSE_POINT) != 0 || info.NumberOfLinks != 1 {
195: 		return nil, errors.New("managed handle redirected or aliased")
196: 	}
197: 	if e = replacementACL(path, false, true); e != nil {
198: 		return nil, e
199: 	}
200: 	stat, e := f.Stat()
201: 	if e != nil {
202: 		return nil, e
203: 	}
204: 	if stat.Size() < 1 || stat.Size() > limit {
205: 		return nil, errors.New("bounded managed file required")
206: 	}
207: 	raw, e := io.ReadAll(io.LimitReader(f, limit+1))
208: 	if e != nil {
209: 		return nil, e
210: 	}
211: 	if int64(len(raw)) > limit {
212: 		return nil, errors.New("managed read exceeded bound")
213: 	}
214: 	return raw, nil
215: }
