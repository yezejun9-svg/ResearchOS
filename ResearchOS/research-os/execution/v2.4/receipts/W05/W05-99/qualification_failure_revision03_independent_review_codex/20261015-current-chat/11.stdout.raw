580: // RuntimeVerifierReplacement owns the same native lease as normal control. It
582: func RuntimeVerifierReplacement(ctx context.Context, in RuntimeVerifierReplacementInput) (out RuntimeVerifierReplacementResult, err error) {
583: 	out = RuntimeVerifierReplacementResult{Schema: replacementSchema, Action: in.Action, OperationID: in.OperationID, State: "REJECTED", Outcome: "NOT_APPLIED"}
584: 	if in.Action == "recover" {
585: 		out.Outcome = "UNKNOWN"
586: 	}
587: 	defer func() {
588: 		if err != nil && out.ErrorCode == "" {
589: 			out.ErrorCode = "REPLACEMENT_REJECTED"
590: 		}
591: 		if err != nil && out.Outcome == "UNKNOWN" {
592: 			out.ErrorCode = "REPLACEMENT_RECOVERY_REQUIRED"
593: 		}
594: 	}()
595: 	if replacementPath(in.DataRoot) != nil {
596: 		return out, errors.New("canonical data root required")
597: 	}
598: 	for i, p := range []string{in.DataRoot, filepath.Join(in.DataRoot, "host"), filepath.Join(in.DataRoot, "researchos.sqlite"), filepath.Join(in.DataRoot, "host", stateFile), filepath.Join(in.DataRoot, "host", "runtime-verifier-installation.json")} {
599: 		if _, e := replacementIdentity(p, i < 2); e != nil {
600: 			return out, e
601: 		}
602: 	}
603: 	guards, e := guardWriteDirectories(filepath.Join(in.DataRoot, "host"))
604: 	if e != nil {
605: 		return out, e
606: 	}
607: 	defer closeWriteGuards(guards)
608: 	dbPath, e := windows.UTF16PtrFromString(filepath.Join(in.DataRoot, "researchos.sqlite"))
609: 	if e != nil {
610: 		return out, e
611: 	}
612: 	dbGuard, e := windows.CreateFile(dbPath, windows.FILE_READ_ATTRIBUTES, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, nil, windows.OPEN_EXISTING, windows.FILE_FLAG_OPEN_REPARSE_POINT, 0)
613: 	if e != nil {
614: 		return out, e
615: 	}
616: 	defer windows.CloseHandle(dbGuard)
617: 	lease, e := rt.AcquireDataRootLease(in.DataRoot)
618: 	if e != nil {
619: 		return out, e
620: 	}
621: 	defer lease.Close()
622: 	if in.Action == "preflight" {
623: 		if !replacementID(in.OperationID) || !replacementDigest(in.ExpectRecordSHA256) || !replacementDigest(in.ExpectManifestSHA256) || replacementPath(in.Out) != nil {
624: 			return out, errors.New("invalid preflight arguments")
625: 		}
626: 		if _, e = os.Lstat(in.Out); !os.IsNotExist(e) {
627: 			return out, errors.New("plan output must not exist")
628: 		}
629: 		// Never create a preflight artifact inside the product root.
630: 		rel, e := filepath.Rel(in.DataRoot, in.Out)
631: 		if e != nil || (rel != ".." && !strings.HasPrefix(rel, ".."+string(filepath.Separator))) {
632: 			return out, errors.New("plan output must be outside product data")
633: 		}
634: 		if e = RuntimeVerifierReplacementStartupGate(lease); e != nil {
635: 			return out, e
636: 		}
637: 		if _, e = os.Lstat(filepath.Join(in.DataRoot, "host", replacementJournal, in.OperationID)); !os.IsNotExist(e) {
638: 			return out, errors.New("operation ID already exists")
639: 		}
640: 		p, e := replacementCandidate(ctx, in)
641: 		out.ReadonlyCensus = p.Census
650: 		if e != nil {
651: 			return out, e
652: 		}
653: 		defer closeWriteGuards(og)
654: 		if e = replacementWrite(filepath.Dir(in.Out), filepath.Base(in.Out), raw); e != nil {
655: 			return out, e
656: 		}
657: 		return replacementResult(in.Action, p, domain.Digest(raw), "PREFLIGHT", "NOT_APPLIED"), nil
658: 	}
659: 	if in.Action != "commit" && in.Action != "recover" {
660: 		return out, errors.New("unknown replacement action")
661: 	}
662: 	p, raw, e := replacementLoadPlan(in.Plan, in.ExpectPlanSHA256)
663: 	if e != nil {
664: 		return out, e
665: 	}
666: 	if p.DataRoot != in.DataRoot {
667: 		return out, errors.New("plan root differs")
668: 	}
669: 	out = replacementResult(in.Action, p, in.ExpectPlanSHA256, "REJECTED", "NOT_APPLIED")
670: 	if _, existing := os.Lstat(filepath.Join(p.HostPath, replacementJournal, p.OperationID)); in.Action == "recover" || existing == nil {
671: 		out.Outcome = "UNKNOWN"
672: 	}
673: 	if in.Action == "recover" && (in.OperationID != p.OperationID || (in.RecoveryAction != "inspect" && in.RecoveryAction != "complete" && in.RecoveryAction != "abort")) {
674: 		return out, errors.New("invalid recovery arguments")
675: 	}
676: 	snapshot, e := replacementSnapshot(ctx, in.DataRoot)
677: 	out.ReadonlyCensus = snapshot.Census
678: 	if e != nil {
679: 		return out, e
680: 	}
681: 	if !replacementSameSnapshot(p, snapshot) {
682: 		return out, errors.New("identity or readonly snapshot drift")
683: 	}
684: 	if in.Action == "recover" {
685: 		out.Outcome = "UNKNOWN"
686: 		return replacementRecover(in, p, raw)
687: 	}
688: 	dir := filepath.Join(p.HostPath, replacementJournal, p.OperationID)
689: 	if _, e = os.Lstat(dir); e == nil {
690: 		in.RecoveryAction = "inspect"
691: 		result, err := replacementRecover(in, p, raw)
692: 		if err == nil && result.State != "COMMITTED" {
693: 			return result, errors.New("existing operation requires explicit recover")
694: 		}
695: 		return result, err
696: 	} else if !os.IsNotExist(e) {
697: 		return out, e
698: 	}
699: 	if e = RuntimeVerifierReplacementStartupGate(lease); e != nil {
700: 		return out, e
701: 	}
702: 	fresh, e := replacementCandidate(ctx, RuntimeVerifierReplacementInput{DataRoot: p.DataRoot, OperationID: p.OperationID, Manifest: p.Manifest, ExpectRecordSHA256: p.OldSHA256, ExpectManifestSHA256: p.ManifestSHA256, RollbackOf: p.RollbackOf})
703: 	if e != nil {
704: 		return out, e
705: 	}
706: 	if !replacementSameSnapshot(p, fresh) || !replacementSameHistory(p, fresh) || !bytes.Equal(fresh.NewBytes, p.NewBytes) || fresh.OldSHA256 != p.OldSHA256 {
707: 		return out, errors.New("stale plan")
708: 	}
709: 	out.Outcome = "UNKNOWN"
