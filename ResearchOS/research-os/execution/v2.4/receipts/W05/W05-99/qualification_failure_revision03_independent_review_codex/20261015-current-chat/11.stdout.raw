224: func replacementSnapshot(ctx context.Context, root string) (replacementPlan, error) {
528: func replacementLoadPlan(path, digest string) (replacementPlan, []byte, error) {
529: 	var p replacementPlan
530: 	raw, e := replacementRead(path, 256<<10)
531: 	if e != nil {
532: 		return p, nil, e
533: 	}
534: 	if !replacementDigest(digest) || domain.Digest(raw) != digest {
535: 		return p, nil, errors.New("plan raw digest differs")
536: 	}
537: 	if e = decodeRuntimeManaged(raw, &p); e != nil {
538: 		return p, nil, e
539: 	}
540: 	if e = replacementPlanValid(p); e != nil {
541: 		return p, nil, e
542: 	}
543: 	return p, raw, nil
544: }
545: func replacementPlanValid(p replacementPlan) error {
546: 	if p.Schema != replacementPlanSchema || !replacementID(p.OperationID) || (p.RollbackOf != "" && (!replacementID(p.RollbackOf) || p.RollbackOf == p.OperationID)) || p.SchemaVersion != 24 || p.Census != [4]int{} || replacementPath(p.DataRoot) != nil || p.HostPath != filepath.Join(p.DataRoot, "host") || p.DBPath != filepath.Join(p.DataRoot, "researchos.sqlite") {
547: 		return errors.New("invalid replacement plan")
548: 	}
549: 	if p.HistorySequence == 0 || (p.HistorySequence == 1 && (p.PredecessorOperation != "" || p.PredecessorPlanSHA256 != "" || p.PredecessorTerminalHash != "")) || (p.HistorySequence > 1 && (!replacementID(p.PredecessorOperation) || p.PredecessorOperation == p.OperationID || !replacementDigest(p.PredecessorPlanSHA256) || !replacementDigest(p.PredecessorTerminalHash))) {
550: 		return errors.New("invalid causal history binding")
551: 	}
552: 	if _, e := time.Parse(time.RFC3339Nano, p.CreatedAt); e != nil {
553: 		return e
554: 	}
555: 	var old, new runtimeVerifierRegistration
556: 	if decodeRuntimeManaged(p.OldBytes, &old) != nil || decodeRuntimeManaged(p.NewBytes, &new) != nil || domain.Digest(p.OldBytes) != p.OldSHA256 || domain.Digest(p.NewBytes) != p.NewSHA256 || domain.Hash(old) != p.OldHash || domain.Hash(new) != p.NewHash || old.InstallHash != p.OldInstallationHash || new.InstallHash != p.NewInstallationHash || domain.Hash(p.Installation) != p.NewInstallationHash || domain.Hash(old.Installation) != old.InstallHash || domain.Hash(new.Installation) != new.InstallHash {
557: 		return errors.New("plan record linkage invalid")
558: 	}
559: 	if old.OwnerHost != p.HostID || old.OwnerPrincipal != p.Owner || old.ServiceRoot != p.Root || old.Schema != "researchos.runtime-verifier-registration.v1" || p.OldSHA256 == p.NewSHA256 {
560: 		return errors.New("plan authority invalid")
561: 	}
562: 	expected := old
563: 	expected.Installation = p.Installation
564: 	expected.InstallHash = domain.Hash(p.Installation)
565: 	raw, e := json.MarshalIndent(expected, "", "  ")
566: 	if e != nil || !bytes.Equal(raw, p.NewBytes) {
567: 		return errors.New("candidate bytes invalid")
568: 	}
569: 	ni, oi := p.Installation, old.Installation
570: 	ni.Executable, ni.ExecutableHash, ni.SourceCommit = oi.Executable, oi.ExecutableHash, oi.SourceCommit
571: 	if domain.Hash(ni) != domain.Hash(oi) {
572: 		return errors.New("forbidden installation mutation")
573: 	}
574: 	return nil
575: }
576: func replacementSameSnapshot(a, b replacementPlan) bool {
577: 	return a.DataRoot == b.DataRoot && a.HostPath == b.HostPath && a.DBPath == b.DBPath && a.FileIDs == b.FileIDs && a.PrincipalRef == b.PrincipalRef && a.HostID == b.HostID && a.Owner == b.Owner && a.Root == b.Root && a.StateSHA256 == b.StateSHA256 && a.LineageHash == b.LineageHash && a.SchemaVersion == b.SchemaVersion && a.Census == b.Census
578: }
