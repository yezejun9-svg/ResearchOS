802: // ReadBridgeTerminal checks the trusted directory and raw hashes. It never
803: // creates a process, renews a lease or turns missing PID into success.
804: func ReadBridgeTerminal(directory, manifestHash string) (BridgeJournal, error) {
805: 	lock, e := lockFile(filepath.Join(directory, "owner.lock"))
806: 	if e != nil {
807: 		return BridgeJournal{}, errors.New("worker still owns dispatch")
808: 	}
809: 	defer lock.Close()
810: 	raw, e := os.ReadFile(filepath.Join(directory, "bridge.json"))
811: 	if e != nil {
812: 		return BridgeJournal{}, e
813: 	}
814: 	var j BridgeJournal
815: 	if e = json.Unmarshal(raw, &j); e != nil {
816: 		return j, e
817: 	}
818: 	digest, e := canonicalHash(j.Manifest)
819: 	if e != nil || digest != manifestHash || j.ManifestHash != manifestHash {
820: 		return j, errors.New("recovery manifest mismatch")
821: 	}
822: 	if j.Identity.PID != 0 {
823: 		alive, e := inspectIdentity(j.Identity.PID, j.Identity.Created)
824: 		if e != nil || alive {
825: 			return j, errors.New("old process identity not confirmed stopped")
826: 		}
827: 	}
828: 	if j.Ended == "" || !j.Receipt.Stopped || !j.Receipt.StreamsDrained || !j.Receipt.CleanupComplete {
829: 		return j, errors.New("dispatch outcome UNKNOWN")
830: 	}
831: 	if j.State == "SETTLED" && (!j.ProtocolComplete || j.Acknowledged != j.Frames || j.Receipt.ExitCode != 0 || !j.Receipt.OutputCopied || j.Cancelled) {
832: 		return j, errors.New("terminal protocol is not settled")
833: 	}
834: 	for file, digest := range map[string]string{"stdout.raw": j.StdoutHash, "stderr.raw": j.StderrHash} {
835: 		f, e := os.Open(filepath.Join(directory, file))
836: 		if e != nil {
837: 			return j, e
