17: func effectAppend(tx *sql.Tx, project, run, key string, o Object) error {
18: 	var seq int64
19: 	if e := tx.QueryRow("SELECT coalesce(max(sequence),0)+1 FROM resource_effects WHERE project=? AND run=? AND effect_key=?", project, run, key).Scan(&seq); e != nil {
20: 		return e
21: 	}
22: 	o["sequence"] = seq
23: 	o["observed_at"] = Now()
24: 	_, e := tx.Exec("INSERT INTO resource_effects(project,run,effect_key,sequence,body) VALUES(?,?,?,?,?)", project, run, key, seq, string(Bytes(o)))
25: 	return e
26: }
27: func effectsReconciled(tx *sql.Tx, project, run string) error {
28: 	var unresolved int
29: 	e := tx.QueryRow(`SELECT count(*) FROM resource_effects x WHERE project=? AND run=? AND sequence=(SELECT max(y.sequence) FROM resource_effects y WHERE y.project=x.project AND y.run=x.run AND y.effect_key=x.effect_key) AND json_extract(body,'$.state') IN ('STARTED','UNKNOWN')`, project, run).Scan(&unresolved)
30: 	if e != nil {
31: 		return e
32: 	}
33: 	if unresolved != 0 {
34: 		return Fail(409, "STATE_CONFLICT", "unknown effects require reconciliation; blind retry prohibited")
35: 	}
36: 	return nil
37: }
