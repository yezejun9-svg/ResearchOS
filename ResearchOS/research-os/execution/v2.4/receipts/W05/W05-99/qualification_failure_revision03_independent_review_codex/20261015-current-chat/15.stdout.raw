163: // LockDataRoot is held for the complete control coordinator lifetime. It uses
164: // an OS-exclusive non-inherited handle, not the SQLite connection count.
165: func LockDataRoot(directory string) (*os.File, error) {
166: 	abs, e := filepath.Abs(directory)
167: 	if e != nil {
168: 		return nil, e
169: 	}
170: 	if e = os.MkdirAll(abs, 0700); e != nil {
171: 		return nil, e
172: 	}
173: 	actual, e := filepath.EvalSymlinks(abs)
174: 	if e != nil || !strings.EqualFold(filepath.Clean(abs), filepath.Clean(actual)) {
175: 		return nil, errors.New("canonical non-reparse data root required")
176: 	}
177: 	return lockFile(filepath.Join(actual, "coordinator.lock"))
178: }
