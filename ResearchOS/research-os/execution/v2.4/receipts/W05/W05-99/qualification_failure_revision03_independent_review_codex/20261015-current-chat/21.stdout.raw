71: func (c *RuntimeCoordinator) providerRoute(tx *sql.Tx, route RuntimeCoordinatorRoute, run, dispatch Object, frame rt.BridgeFrame) (RuntimeProviderRoute, error) {
72: 	manifest := dispatch["manifest"].(map[string]any)
73: 	admission := manifest["admission"].(map[string]any)
74: 	profile := admission["profile"].(map[string]any)
75: 	if c.service.Contracts.Validate("Idempotency-Key", frame.Key) != nil {
76: 		return RuntimeProviderRoute{}, Fail(400, "INVALID_REQUEST", "stable effect key required")
77: 	}
78: 	task, e := load(tx, route.ProjectID, "Task", Str(run, "task_id"))
79: 	if e != nil {
80: 		return RuntimeProviderRoute{}, e
81: 	}
82: 	if admission["qualification_bootstrap"] == true {
83: 		if e = qualificationModelEffectAllowed(tx, route.ProjectID, task, Object{"capability": frame.Capability, "route": frame.Route}); e != nil {
84: 			return RuntimeProviderRoute{}, e
85: 		}
86: 		permission := profile["model_qualification"].(map[string]any)
87: 		if e = runtimeModelCallGate(tx, route.ProjectID, Str(run, "id"), frame.Key, permission); e != nil {
88: 			return RuntimeProviderRoute{}, e
89: 		}
90: 	}
91: 	for _, provider := range c.runtimeProviders() {
92: 		if provider.ID != frame.Route || provider.ProjectID != route.ProjectID || provider.RuntimeID != route.RuntimeID || provider.Purpose != task["task_type"] || provider.Capability != frame.Capability || provider.MeasurementMode != admission["mode"] {
93: 			continue
94: 		}
95: 		bound := false
96: 		for _, v := range Arr(profile, "effect_routes") {
97: 			p, ok := v.(map[string]any)
98: 			if ok && p["id"] == provider.ID && p["capability"] == provider.Capability && p["credential_revision"] == provider.CredentialRevision && Hash(p["upper_bound"]) == Hash(provider.UpperBound) {
99: 				bound = true
100: 			}
