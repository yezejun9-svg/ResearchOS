FILE internal/host/runtime_verifier_replacement_journal_windows.go
315: func replacementRecover(in RuntimeVerifierReplacementInput, p replacementPlan, raw []byte) (RuntimeVerifierReplacementResult, error) {
316: 	out := replacementResult(in.Action, p, domain.Digest(raw), "UNKNOWN", "UNKNOWN")
317: 	dir := filepath.Join(p.HostPath, replacementJournal, p.OperationID)
318: 	guards, e := guardWriteDirectories(dir)
319: 	if e != nil {
320: 		return out, e
321: 	}
322: 	defer closeWriteGuards(guards)
323: 	v, e := replacementReadJournal(dir, p, raw)
324: 	if e != nil {
325: 		return out, e
326: 	}
327: 	head, e := replacementReadHistory(p.DataRoot, p.OperationID)
328: 	if e != nil {
329: 		return out, e
330: 	}
331: 	if !replacementExtendsHead(p, head) {
332: 		return out, errors.New("recovery causal predecessor differs")
333: 	}
334: 	state := ""
335: 	if len(v.Events) > 0 {
336: 		state = v.Events[len(v.Events)-1].State
337: 	}
338: 	current, e := replacementRead(filepath.Join(p.HostPath, "runtime-verifier-installation.json"), 64<<10)
339: 	if e != nil {
340: 		return out, e
341: 	}
342: 	backup, published := v.Files["actual-backup.bin"]
343: 	applied := bytes.Equal(current, p.NewBytes) && published && bytes.Equal(backup, p.OldBytes) && v.Files["stage.bin"] == nil
344: 	unapplied := bytes.Equal(current, p.OldBytes) && !published
345: 	if state == "COMMITTED" {
346: 		if !applied {
347: 			return out, errors.New("committed result drift")
348: 		}
349: 		if e = replacementInstallationValid(p); e != nil {
350: 			return out, e
351: 		}
352: 		out.State, out.Outcome = "COMMITTED", "APPLIED"
353: 		return out, nil
354: 	}
355: 	if state == "ABORTED" {
356: 		if !unapplied {
357: 			return out, errors.New("aborted result drift")
358: 		}
359: 		out.State, out.Outcome = "ABORTED", "NOT_APPLIED"
360: 		return out, nil
361: 	}
362: 	if applied && state == "PUBLISHING" {
363: 		if e = replacementInstallationValid(p); e != nil {
364: 			return out, e
365: 		}
366: 		if in.RecoveryAction == "abort" {
367: 			return out, errors.New("published operation cannot abort")
368: 		}
369: 		if in.RecoveryAction == "complete" {
370: 			if e = replacementApplied(p, dir); e != nil {
371: 				return out, e
372: 			}
373: 			if e = replacementAppend(dir, p, raw, "COMMITTED"); e != nil {
374: 				return out, e
375: 			}
376: 			if e = replacementApplied(p, dir); e != nil {
377: 				return out, e
378: 			}
379: 			if e = replacementCheckHistoryCurrent(p.DataRoot); e != nil {
380: 				return out, e
381: 			}
382: 			out.State, out.Outcome = "COMMITTED", "APPLIED"
383: 			return out, nil
384: 		}
385: 		out.State = "PUBLISHING"
386: 		return out, nil
387: 	}
388: 	if !unapplied {
389: 		return out, errors.New("replacement evidence ambiguous; no replay or rollback")
390: 	}
391: 	out.State, out.Outcome = "UNAPPLIED", "NOT_APPLIED"
392: 	if in.RecoveryAction == "complete" {
393: 		return out, errors.New("complete never replays ReplaceFile")
394: 	}
395: 	if in.RecoveryAction == "abort" {
396: 		// Also provides recovery from death immediately after operation mkdir.
397: 		for _, v := range []struct {
398: 			name string
399: 			data []byte
400: 		}{{"plan.json", raw}, {"old-registration.bin", p.OldBytes}, {"new-registration.bin", p.NewBytes}} {
401: 			if e = replacementWrite(dir, v.name, v.data); e != nil {
402: 				return out, e
403: 			}
404: 		}
405: 		if e = replacementAppend(dir, p, raw, "ABORTED"); e != nil {
406: 			return out, e
407: 		}
408: 		if e = replacementCheckHistoryCurrent(p.DataRoot); e != nil {
409: 			return out, e
410: 		}
411: 		out.State = "ABORTED"
412: 	}
413: 	return out, nil
414: }
