20: func upgradeConfigurationRelease(root string, count int) (Object, [][]byte, error) {
21: 	if count != 22 && count != 23 {
22: 		return nil, nil, fmt.Errorf("UPGRADE_PLAN_UNSUPPORTED")
23: 	}
24: 	files, e := filepath.Glob(filepath.Join(root, "migrations/sqlite/0*.sql"))
25: 	if e != nil || len(files) != count {
26: 		return nil, nil, fmt.Errorf("UPGRADE_RELEASE_MIGRATIONS: require exact 1..%d", count)
27: 	}
28: 	manifest := Object{}
29: 	sqls := make([][]byte, count+1)
30: 	for i, file := range files {
31: 		name := filepath.Base(file)
32: 		if len(name) < 5 || name[:4] != fmt.Sprintf("%04d", i+1) {
33: 			return nil, nil, fmt.Errorf("UPGRADE_RELEASE_MIGRATIONS")
34: 		}
35: 		expected := upgradeMigrationHashes[name]
36: 		switch name {
37: 		case "0021_research_pending_windows.sql":
38: 			expected = "sha256:36d4e5c93aa1edcd7ca5aca922b3bea11d5739f307bd11c6834936adf5552f32"
39: 		case "0022_client_command_queue.sql":
40: 			expected = upgradeQueueSQLHash
41: 		case "0023_host_model_configuration.sql":
42: 			expected = upgradeConfigurationSQLHash
43: 		}
44: 		raw, e := os.ReadFile(file)
45: 		if e != nil || expected == "" || Digest(raw) != expected {
46: 			return nil, nil, fmt.Errorf("UPGRADE_RELEASE_HASH: %s", name)
47: 		}
48: 		manifest["migrations/sqlite/"+name] = expected
49: 		sqls[i] = raw
50: 	}
51: 	for path, expected := range map[string]string{
52: 		"spec/v2.0/contracts/domain.schema.json":             "sha256:b11439c80d15c9481d7940c98eb6517b5156470f871c839e505a8dce40e0b847",
53: 		"spec/v2.0/contracts/openapi.json":                   "sha256:f1edd7955a1d134a675c5558618756db809d82729f8eebe622a9bc2605a58920",
54: 		"internal/api/contracts/client.protocol.schema.json": "sha256:8943fe363bcfda4a2c45231e54c266133ffccc8642c541724d93d2e56d3a9a9b",
55: 		"internal/api/contracts/domain.schema.json":          "sha256:b53d9e6eddfeed89d27ee65c378d8067ae8b0c46de2ba2a098856a7557df1c54",
56: 	} {
57: 		raw, e := os.ReadFile(filepath.Join(root, filepath.FromSlash(path)))
58: 		if e != nil || Digest(raw) != expected {
59: 			return nil, nil, fmt.Errorf("UPGRADE_CONTRACT_HASH: %s", path)
60: 		}
61: 		manifest[path] = expected
62: 	}
63: 	raw, e := os.ReadFile(filepath.Join(root, "migrations/sqlite/next_v24_sessions.sql"))
64: 	if e != nil || Digest(raw) != upgradeQueueSessionHash {
65: 		return nil, nil, fmt.Errorf("UPGRADE_SESSION_SCHEMA_HASH")
66: 	}
67: 	manifest["migrations/sqlite/next_v24_sessions.sql"] = Digest(raw)
68: 	sqls[count] = raw
69: 	return manifest, sqls, nil
70: }
