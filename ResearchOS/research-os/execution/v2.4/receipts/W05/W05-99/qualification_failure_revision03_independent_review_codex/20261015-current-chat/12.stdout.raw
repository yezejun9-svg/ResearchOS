32: // Same-host continuity reads only directory metadata. It does not copy a
33: // workspace, grant access, or replace the existing host authority/pin store.
34: func upgradeQueueWorkspaceIdentity(db *sql.DB, opt LocalUpgradeOptions) (Object, error) {
35: 	bindings, e := workspaceBackupBindings(db)
36: 	if e != nil {
37: 		return nil, e
38: 	}
39: 	manifest := Object{}
40: 	for _, b := range bindings {
41: 		path, e := upgradeExistingPath(b.RealPath)
42: 		if e != nil {
43: 			return nil, e
44: 		}
45: 		if !strings.EqualFold(filepath.Clean(path), filepath.Clean(b.RealPath)) {
46: 			return nil, fmt.Errorf("UPGRADE_WORKSPACE_ALIAS")
47: 		}
48: 		info, e := os.Stat(path)
49: 		if e != nil || !info.IsDir() {
50: 			return nil, fmt.Errorf("UPGRADE_WORKSPACE_DIRECTORY")
51: 		}
52: 		if backupWorkspaceOverlaps(path, opt.Destination) || backupWorkspaceOverlaps(path, opt.Snapshot) {
53: 			return nil, fmt.Errorf("UPGRADE_WORKSPACE_OUTPUT_OVERLAP")
54: 		}
55: 		identity, e := retrieval.Identity(path)
56: 		if e != nil {
57: 			return nil, e
58: 		}
59: 		manifest[b.AuthorizedRef] = Object{"path": path, "identity": identity, "principal": b.PrincipalID, "host_principal": b.HostPrincipalRef, "access": b.Access, "project": b.ProjectID}
60: 	}
61: 	return manifest, nil
62: }
