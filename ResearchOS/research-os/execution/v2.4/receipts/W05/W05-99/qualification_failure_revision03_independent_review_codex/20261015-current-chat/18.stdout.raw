96: 	}
97: 	var extra any
98: 	if d.Decode(&extra) != io.EOF {
99: 		return errors.New("managed runtime request has trailing data")
100: 	}
101: 	return nil
102: }
103: 
104: type runtimeVerifierProcess struct {
105: 	cmd      *exec.Cmd
106: 	in       io.WriteCloser
107: 	out      io.ReadCloser
108: 	cancel   context.CancelFunc
109: 	identity supervisor.ProcessIdentity
110: 	nonce    string
111: 	waited   bool
112: }
113: 
114: func startRuntimeVerifier(ctx context.Context, install RuntimeVerifierInstallation) (*runtimeVerifierProcess, error) {
115: 	if e := verifyRuntimeVerifierImage(install); e != nil {
116: 		return nil, e
117: 	}
118: 	deadline, cancel := context.WithTimeout(ctx, 3*time.Minute)
119: 	p := &runtimeVerifierProcess{cancel: cancel}
120: 	p.cmd = exec.CommandContext(deadline, install.Executable)
121: 	p.cmd.Dir = filepath.Dir(install.Executable)
122: 	p.cmd.Env = []string{}
123: 	for _, name := range []string{"SystemRoot", "WINDIR", "TEMP", "TMP"} {
124: 		if value := os.Getenv(name); value != "" {
125: 			p.cmd.Env = append(p.cmd.Env, name+"="+value)
126: 		}
127: 	}
128: 	p.cmd.SysProcAttr = &syscall.SysProcAttr{HideWindow: true}
129: 	// These are dedicated inherited anonymous pipes. No token is placed in argv,
130: 	// environment, a file, logs, worker configuration or the scheduler object.
131: 	var e error
132: 	if p.in, e = p.cmd.StdinPipe(); e != nil {
133: 		cancel()
134: 		return nil, e
135: 	}
136: 	if p.out, e = p.cmd.StdoutPipe(); e != nil {
137: 		p.in.Close()
138: 		cancel()
139: 		return nil, e
140: 	}
141: 	p.cmd.Stderr = io.Discard
142: 	if e = p.cmd.Start(); e != nil {
143: 		p.in.Close()
144: 		p.out.Close()
145: 		cancel()
146: 		return nil, errors.New("installed verifier process could not start")
147: 	}
148: 	ok := false
149: 	defer func() {
150: 		if !ok {
151: 			p.close()
152: 		}
153: 	}()
154: 	p.identity, e = supervisor.ObserveProcess(uint32(p.cmd.Process.Pid))
155: 	if e != nil || "sha256:"+p.identity.ImageSHA256 != install.ExecutableHash {
156: 		return nil, errors.New("verifier process does not match installed image")
157: 	}
158: 	var nonce [32]byte
159: 	if _, e = rand.Read(nonce[:]); e != nil {
160: 		return nil, e
161: 	}
162: 	p.nonce = hex.EncodeToString(nonce[:])
163: 	if e = verifier.WriteFrame(p.in, verifier.Challenge{Protocol: verifier.Protocol, Nonce: p.nonce}); e != nil {
164: 		return nil, errors.New("verifier handshake write failed")
165: 	}
166: 	var hello verifier.Hello
167: 	if e = p.read(deadline, &hello); e != nil {
168: 		return nil, e
169: 	}
170: 	if hello.Protocol != verifier.Protocol || hello.ServiceID != verifier.ServiceID || hello.Nonce != p.nonce || hello.PID != p.cmd.Process.Pid {
171: 		return nil, errors.New("verifier process handshake identity differs")
172: 	}
173: 	ok = true
174: 	return p, nil
175: }
176: func (p *runtimeVerifierProcess) read(ctx context.Context, target any) error {
177: 	done := make(chan error, 1)
178: 	go func() { done <- verifier.ReadFrame(p.out, target) }()
179: 	timer := time.NewTimer(20 * time.Second)
180: 	defer timer.Stop()
181: 	select {
182: 	case e := <-done:
183: 		return e
184: 	case <-ctx.Done():
185: 		p.cancel()
186: 		return errors.New("verifier process cancelled")
187: 	case <-timer.C:
188: 		p.cancel()
189: 		return errors.New("verifier reply deadline exceeded")
190: 	}
191: }
192: func (p *runtimeVerifierProcess) verify(ctx context.Context, job verifier.Job) (verifier.Result, error) {
193: 	var result verifier.Result
194: 	observed, e := supervisor.ObserveProcess(uint32(p.cmd.Process.Pid))
195: 	if e != nil || observed != p.identity {
196: 		return result, errors.New("verifier process identity changed before credential transfer")
197: 	}
198: 	job.Protocol, job.Nonce = verifier.Protocol, p.nonce
199: 	if e = verifier.WriteFrame(p.in, job); e != nil {
200: 		return result, errors.New("private verifier job transfer failed")
201: 	}
202: 	job.Token = ""
203: 	_ = p.in.Close()
204: 	if e = p.read(ctx, &result); e != nil {
205: 		return result, e
206: 	}
207: 	e = p.cmd.Wait()
208: 	p.waited = true
209: 	if e != nil || result.Protocol != verifier.Protocol || result.Nonce != p.nonce || result.Status != "QUALIFIED" || result.ErrorCode != "" {
210: 		for _, code := range []string{"TASK_RUN_BINDING", "PROFILE_EVIDENCE", "NATIVE_OBSERVATION", "OUTPUT_EVIDENCE", "FROZEN_CHECKS", "DETERMINISTIC_CHECK", "SERVER_ACCEPTANCE", "SERVER_QUALIFICATION"} {
211: 			if result.ErrorCode == code {
212: 				return result, errors.New("independent verifier rejected stage " + code)
213: 			}
214: 		}
215: 		return result, errors.New("independent verifier did not qualify the runtime")
FILE internal/domain/runtime_qualification_execution_windows.go
70: 		return nil, nil, Fail(412, "STALE_INPUT", "qualification task inputs changed")
71: 	}
72: 	return runtime, task, nil
73: }
74: 
75: // ValidateLocalQualification is read-only and exposes no token or execution
76: // capability. The same checks run again under the sole scan lock before Begin.
77: func (c *RuntimeCoordinator) ValidateLocalQualification(ctx context.Context, ownerToken string, request LocalRuntimeQualificationRequest) error {
78: 	tx, e := c.service.DB.BeginTx(ctx, nil)
79: 	if e != nil {
80: 		return e
81: 	}
82: 	defer tx.Rollback()
83: 	p, e := authenticate(tx, ownerToken)
84: 	if e != nil {
85: 		return e
86: 	}
87: 	_, task, e := c.localQualification(tx, p, request)
88: 	if e == nil {
89: 		e = c.validateLocalConfirmation(ctx, tx, p, request)
90: 	}
91: 	if e == nil && task["status"] != "DRAFT" {
92: 		return Fail(409, "STATE_CONFLICT", "qualification request was already consumed; no automatic retry")
93: 	}
94: 	return e
95: }
96: 
97: // ExecuteLocalQualification joins the single coordinator lifecycle. Scan does
98: // not claim qualification tasks, so a trusted explicit request must bridge
99: // Begin to RunAdmitted exactly once. Cancellation/recovery never relaunches it.
100: func (c *RuntimeCoordinator) ExecuteLocalQualification(ctx context.Context, ownerToken string, request LocalRuntimeQualificationRequest) (Object, error) {
101: 	c.scanMu.Lock()
102: 	unlock := true
103: 	defer func() {
104: 		if unlock {
105: 			c.scanMu.Unlock()
106: 		}
107: 	}()
108: 	if c.quiesced || !c.qualificationActive || c.qualificationRequest != request.RequestID {
109: 		return nil, Fail(409, "RESOURCE_BLOCKED", "runtime intake is fenced")
110: 	}
111: 	if !c.startupComplete {
112: 		if e := c.Recover(ctx); e != nil {
113: 			return nil, e
114: 		}
115: 		c.startupComplete = true
116: 	}
117: 	tx, e := c.service.DB.BeginTx(ctx, nil)
118: 	if e != nil {
119: 		return nil, e
120: 	}
121: 	p, e := authenticate(tx, ownerToken)
122: 	if e != nil {
123: 		tx.Rollback()
124: 		return nil, e
125: 	}
126: 	_, task, e := c.localQualification(tx, p, request)
127: 	if e != nil {
128: 		tx.Rollback()
129: 		return nil, e
130: 	}
131: 	if task["status"] != "DRAFT" {
132: 		tx.Rollback()
133: 		return nil, Fail(409, "STATE_CONFLICT", "qualification already consumed; no automatic retry")
134: 	}
135: 	var route RuntimeCoordinatorRoute
136: 	for _, current := range c.runtimeRoutes() {
137: 		if current.ProjectID == request.ProjectID && current.RuntimeID == request.RuntimeID {
138: 			if route.RuntimeID != "" {
139: 				tx.Rollback()
140: 				return nil, errors.New("ambiguous qualification route")
141: 			}
142: 			route = current
143: 		}
144: 	}
145: 	if route.RuntimeID == "" {
146: 		tx.Rollback()
147: 		return nil, Fail(503, "MODEL_UNAVAILABLE", "prepared route unavailable")
148: 	}
149: 	var active int
150: 	e = tx.QueryRow(`SELECT count(*) FROM domain_objects WHERE project=? AND kind='Run' AND json_extract(body,'$.executor_principal_id')=? AND json_extract(body,'$.status') NOT IN ('SETTLED','FAILED','CANCELLED')`, route.ProjectID, route.ExecutorID).Scan(&active)
