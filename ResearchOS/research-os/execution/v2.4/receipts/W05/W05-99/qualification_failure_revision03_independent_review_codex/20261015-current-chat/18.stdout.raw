106: func upgradeQueueMigration(ctx context.Context, db *sql.DB, raw, additive []byte) error {
107: 	if Digest(raw) != upgradeQueueSQLHash || Digest(additive) != upgradeQueueSessionHash {
108: 		return fmt.Errorf("UPGRADE_MIGRATION_HASH")
109: 	}
110: 	versions, e := backupMigrations(db)
111: 	if e != nil || !reflect.DeepEqual(versions, upgradeVersions(21)) {
112: 		return fmt.Errorf("UPGRADE_SOURCE_VERSION")
113: 	}
114: 	before, e := upgradeRows(db)
115: 	if e != nil {
116: 		return e
117: 	}
118: 	tx, e := db.BeginTx(ctx, nil)
119: 	if e != nil {
120: 		return e
121: 	}
122: 	defer tx.Rollback()
123: 	// The exact additive schema must already exist. Reinstalling it must be a
124: 	// no-op, not a repair of corrupt source state or a reconstruction of sessions.
125: 	if _, e = tx.ExecContext(ctx, string(additive)); e != nil {
126: 		return e
127: 	}
128: 	if e = installClientSessionFence(ctx, tx, false); e != nil {
129: 		return e
130: 	}
131: 	if _, e = tx.ExecContext(ctx, string(raw)); e != nil {
132: 		return e
133: 	}
134: 	if _, e = tx.ExecContext(ctx, "INSERT INTO schema_migrations(version) VALUES(22)"); e != nil {
135: 		return e
136: 	}
137: 	after, e := upgradeQueueRows(tx)
138: 	if e != nil {
139: 		return e
140: 	}
141: 	for table, rows := range before {
142: 		if table == "schema_migrations" {
143: 			continue
144: 		}
145: 		if Hash(rows) != Hash(after[table]) {
146: 			return fmt.Errorf("UPGRADE_MIGRATION_MUTATED_HISTORY: %s", table)
147: 		}
148: 	}
149: 	for table := range upgradeQueueTables {
150: 		if rows, ok := after[table]; !ok || len(rows) != 0 {
151: 			return fmt.Errorf("UPGRADE_QUEUE_NOT_EMPTY: %s", table)
152: 		}
153: 	}
154: 	for table := range after {
155: 		if _, ok := before[table]; !ok && !upgradeQueueTables[table] {
156: 			return fmt.Errorf("UPGRADE_UNEXPECTED_TABLE: %s", table)
157: 		}
158: 	}
