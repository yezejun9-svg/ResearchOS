114: func upgradeConfigurationMigration(ctx context.Context, db *sql.DB, raw []byte) error {
115: 	if Digest(raw) != upgradeConfigurationSQLHash {
116: 		return fmt.Errorf("UPGRADE_MIGRATION_HASH")
117: 	}
