127: 	if e != nil {
128: 		return e
129: 	}
130: 	defer tx.Rollback()
131: 	if _, e = tx.ExecContext(ctx, string(raw)); e != nil {
132: 		return e
133: 	}
134: 	if _, e = tx.ExecContext(ctx, "INSERT INTO schema_migrations(version) VALUES(23)"); e != nil {
135: 		return e
136: 	}
137: 	after, e := upgradeQueueRows(tx)
138: 	if e != nil {
139: 		return e
140: 	}
141: 	for table, rows := range before {
142: 		if table != "schema_migrations" && Hash(rows) != Hash(after[table]) {
143: 			return fmt.Errorf("UPGRADE_MIGRATION_MUTATED_HISTORY: %s", table)
144: 		}
145: 	}
146: 	for table := range upgradeConfigurationTables {
147: 		rows, ok := after[table]
148: 		if !ok || len(rows) != 0 {
149: 			return fmt.Errorf("UPGRADE_CONFIGURATION_NOT_EMPTY")
150: 		}
151: 	}
152: 	for table := range after {
153: 		if _, ok := before[table]; !ok && !upgradeConfigurationTables[table] {
154: 			return fmt.Errorf("UPGRADE_UNEXPECTED_TABLE")
155: 		}
