72: func upgradeConfigurationTemplate(ctx context.Context, sqls [][]byte, contracts *Contracts) (string, string, error) {
73: 	if len(sqls) != 24 {
74: 		return "", "", fmt.Errorf("UPGRADE_PLAN_UNSUPPORTED")
75: 	}
76: 	stage, e := os.MkdirTemp("", ".researchos-configuration-template-")
77: 	if e != nil {
78: 		return "", "", e
79: 	}
80: 	defer backupDiscard(stage)
81: 	db, e := store.Open(filepath.Join(stage, "schema.sqlite"))
82: 	if e != nil {
83: 		return "", "", e
84: 	}
85: 	defer db.Close()
86: 	for i, raw := range sqls[:22] {
87: 		if _, e = db.ExecContext(ctx, string(raw)); e != nil {
88: 			return "", "", e
89: 		}
90: 		if _, e = db.ExecContext(ctx, "INSERT INTO schema_migrations(version) VALUES(?)", i+1); e != nil {
91: 			return "", "", e
92: 		}
93: 	}
94: 	if _, e = db.ExecContext(ctx, string(sqls[23])); e != nil {
95: 		return "", "", e
96: 	}
97: 	if e = installClientSessionFence(ctx, db, false); e != nil {
98: 		return "", "", e
99: 	}
100: 	before, e := backupSchema(db)
101: 	if e != nil {
102: 		return "", "", e
103: 	}
104: 	if _, e = (&Service{DB: db, Contracts: contracts}).backupFence(ctx); e != nil {
105: 		return "", "", e
106: 	}
107: 	if e = upgradeConfigurationMigration(ctx, db, sqls[22]); e != nil {
108: 		return "", "", e
109: 	}
110: 	after, e := backupSchema(db)
111: 	return before, after, e
112: }
