316: func (d *ControlFixtureDriver) Ready(ctx context.Context, p ProcessIdentity, token string) error {
388: func (d *ControlFixtureDriver) Compatible(ctx context.Context, s ReleaseState) error {
389: 	if (d.RestoreWithContext == nil && d.Restore == nil) || s.Cutover == nil {
390: 		return errors.New("actual control rollback requires a separately qualified restore")
391: 	}
392: 	if d.Journal == nil || d.Journal.State().Operation != s.Operation || d.Journal.State().Epoch != s.Epoch {
393: 		return errors.New("restore journal operation changed")
394: 	}
395: 	if bound := d.Journal.State().RestoreContext; bound != nil {
396: 		if _, err := ValidateReleaseRestoreResult(d.Journal.State(), *bound); err != nil {
397: 			return err
398: 		}
399: 		return errors.New(RecoveryAuthorizationBlocked)
400: 	}
401: 	lease, err := rt.AcquireDataRootLease(s.Data)
402: 	if err != nil {
403: 		return err
404: 	}
405: 	defer lease.Close()
406: 	if d.RestoreWithContext != nil {
407: 		result, err := d.RestoreWithContext(ctx, s, lease)
408: 		if err != nil {
409: 			return err // Never fall back to an untyped restore after uncertainty.
410: 		}
411: 		if err = d.Journal.BindRestoreContext(result); err != nil {
412: 			return err
413: 		}
414: 		// The real restored copy is fenced, but no current recovery actor/proof
415: 		// exists in this bounded slice. Do not select its Data or start control.
416: 		return errors.New(RecoveryAuthorizationBlocked)
417: 	}
418: 	// Legacy synthetic fixture callback remains compatible; it cannot consume
419: 	// a typed context and is not selected by the actual-control host.
420: 	dest, err := d.Restore(ctx, s, lease)
421: 	if err != nil {
422: 		return err
423: 	}
424: 	current := d.Journal.State()
425: 	current.Data = dest
426: 	clearProcess(&current)
427: 	return d.Journal.Append(current)
428: }
