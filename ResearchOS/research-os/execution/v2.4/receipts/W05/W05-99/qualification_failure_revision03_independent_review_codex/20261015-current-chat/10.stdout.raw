89: func (d *ControlFixtureDriver) Start(image, token, data string) (ProcessIdentity, error) {
90: 	if d.Journal == nil {
91: 		return ProcessIdentity{}, errors.New("supervisor journal required")
92: 	}
93: 	s := d.Journal.State()
94: 	if s.RestoreContext != nil {
95: 		return ProcessIdentity{}, errors.New(RecoveryAuthorizationBlocked)
96: 	}
97: 	if (s.Phase != "STARTING" && s.Phase != "SWITCHED") || s.PID != 0 || s.Data != data || token == "" {
98: 		return ProcessIdentity{}, errors.New("durable unstarted slot required")
99: 	}
100: 	lease, e := rt.AcquireDataRootLease(data)
101: 	if e != nil {
102: 		return ProcessIdentity{}, e
103: 	}
104: 	if e = lease.Close(); e != nil {
105: 		return ProcessIdentity{}, e
106: 	}
107: 	actual, digest, e := exactImage(image)
108: 	if e != nil || digest != s.Active {
109: 		return ProcessIdentity{}, errors.New("control image differs from durable slot")
110: 	}
111: 	peer, e := ObserveProcess(uint32(os.Getpid()))
112: 	if e != nil {
113: 		return ProcessIdentity{}, e
114: 	}
115: 	name, e := NewDrainPipeName()
116: 	if e != nil {
117: 		return ProcessIdentity{}, e
118: 	}
119: 	boot := &DrainBootstrap{Pipe: name, Root: filepath.Clean(data), Key: make([]byte, 32), Peer: peer, Token: token, Epoch: s.Epoch, Listener: d.Listen}
120: 	boot.FixtureStore = d.FixtureStore
121: 	if _, e = rand.Read(boot.Key); e != nil {
122: 		return ProcessIdentity{}, e
123: 	}
124: 	r, w, e := os.Pipe()
125: 	if e != nil {
126: 		return ProcessIdentity{}, e
127: 	}
128: 	defer r.Close()
129: 	defer w.Close()
130: 	if e = windows.SetHandleInformation(windows.Handle(r.Fd()), windows.HANDLE_FLAG_INHERIT, windows.HANDLE_FLAG_INHERIT); e != nil {
131: 		return ProcessIdentity{}, e
132: 	}
133: 	args := []string{}
134: 	if d.CoordinatorConfig != "" {
135: 		args = append(args, "--runtime-coordinator-config", d.CoordinatorConfig)
136: 	}
137: 	cmd := exec.Command(actual, args...)
138: 	cmd.Dir = d.WorkDir
139: 	for _, v := range os.Environ() {
140: 		name, _, _ := strings.Cut(v, "=")
141: 		if strings.EqualFold(name, drainHandleEnv) || strings.EqualFold(name, "RESEARCHOS_DATA_DIR") || strings.EqualFold(name, "RESEARCHOS_WEB_DIR") || strings.EqualFold(name, "RESEARCHOS_LISTEN") {
142: 			continue
143: 		}
144: 		cmd.Env = append(cmd.Env, v)
145: 	}
146: 	cmd.Env = append(cmd.Env, drainHandleEnv+"="+strconv.FormatUint(uint64(r.Fd()), 10), "RESEARCHOS_DATA_DIR="+data, "RESEARCHOS_WEB_DIR="+d.WebDir, "RESEARCHOS_LISTEN="+d.Listen)
147: 	cmd.Stdout, cmd.Stderr = d.Output, d.Output
148: 	cmd.SysProcAttr = &windows.SysProcAttr{CreationFlags: windows.CREATE_NEW_PROCESS_GROUP | windows.CREATE_NO_WINDOW, AdditionalInheritedHandles: []syscall.Handle{syscall.Handle(r.Fd())}}
149: 	if e = cmd.Start(); e != nil {
150: 		return ProcessIdentity{}, e
151: 	}
152: 	go func() { _ = cmd.Wait() }()
153: 	p, e := ObserveProcess(uint32(cmd.Process.Pid))
154: 	if e != nil {
155: 		return ProcessIdentity{}, e
156: 	}
157: 	d.boot, d.process, d.frame = boot, p, DrainFrame{}
158: 	if e = json.NewEncoder(w).Encode(boot); e != nil {
159: 		return p, e
160: 	}
161: 	return p, nil
162: }
