27: 
28: func runControlHost(control, root, work, web, listen, private, contracts string) error {
29: 	if !filepath.IsAbs(root) || !filepath.IsAbs(control) || !filepath.IsAbs(work) || !filepath.IsAbs(web) || !filepath.IsAbs(private) || contracts == "" || listen == "" {
30: 		return errors.New("absolute actual-control fixture host bindings required")
31: 	}
32: 	j, e := supervisor.OpenReleaseJournal(filepath.Join(root, "release-state"))
33: 	if e != nil {
34: 		return e
35: 	}
36: 	defer j.Close()
37: 	d := &supervisor.ControlFixtureDriver{Journal: j, WorkDir: work, WebDir: web, Listen: listen, FixtureStore: private, Output: os.Stderr}
38: 	d.RestoreWithContext = func(ctx context.Context, s supervisor.ReleaseState, lease *rt.DataRootLease) (supervisor.ReleaseRestoreResult, error) {
39: 		return domain.RestoreEvolutionCutoverContext(ctx, s, lease, contracts, private)
40: 	}
41: 	verify := func(a supervisor.ReleaseAdmission) error {
42: 		state := j.State()
43: 		_, e := d.Private(context.Background(), "FIXTURE_CURRENT", supervisor.ReleasePrivateMessage{Admission: &a, Snapshot: &state})
44: 		return e
45: 	}
46: 	engine, e := supervisor.NewReleaseEngine(j, d, d, verify)
47: 	if e != nil {
48: 		return e
49: 	}
50: 	if j.Sequence() == 0 {
51: 		ctx, cancel := context.WithTimeout(context.Background(), 15*time.Second)
52: 		e = engine.BootstrapFixture(ctx, control, filepath.Join(root, "data"))
53: 		cancel()
54: 		if e != nil {
55: 			return e
56: 		}
57: 	}
58: 	encoder := json.NewEncoder(os.Stdout)
59: 	if e = encoder.Encode(map[string]any{"status": "HOST_READY", "state": j.State(), "recovered": j.State().Phase != "STABLE"}); e != nil {
60: 		return e
61: 	}
62: 	scan := bufio.NewScanner(os.Stdin)
63: 	scan.Buffer(make([]byte, 1024), 8192)
64: 	for scan.Scan() {
65: 		var c command
66: 		if e = json.Unmarshal(scan.Bytes(), &c); e != nil {
67: 			return e
68: 		}
69: 		ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
70: 		result, err := controlCommand(ctx, c, root, j, d, engine)
71: 		cancel()
72: 		reply := map[string]any{"action": c.Action, "state": j.State(), "result": result}
73: 		if err != nil {
74: 			reply["error"] = err.Error()
75: 		}
76: 		if e = encoder.Encode(reply); e != nil {
77: 			return e
78: 		}
79: 		if c.Action == "stop" && err == nil {
80: 			return nil
81: 		}
82: 	}
83: 	// EOF releases only the host journal. It does not repeat stop or launch.
84: 	return scan.Err()
85: }
86: 
87: func controlCommand(ctx context.Context, c command, root string, j *supervisor.ReleaseJournal, d *supervisor.ControlFixtureDriver, engine *supervisor.ReleaseEngine) (any, error) {
88: 	state := j.State()
89: 	switch c.Action {
90: 	case "status":
91: 		return engine.Reconcile()
92: 	case "current":
93: 		if state.Phase != "STABLE" {
94: 			return nil, errors.New("current control proof requires stable host")
95: 		}
96: 		return d.Private(ctx, "CURRENT_CONTROL", supervisor.ReleasePrivateMessage{Request: c.Request, Snapshot: &state})
97: 	case "seal":
98: 		if state.Phase != "STABLE" {
99: 			return nil, errors.New("stable host required to seal")
100: 		}
101: 		return d.Private(ctx, "FIXTURE_SEAL", supervisor.ReleasePrivateMessage{Project: c.Project, Candidate: c.Candidate, Request: c.Request, Snapshot: &state})
102: 	case "execute":
103: 		// CANARY is an observation/projection retry only; no switch is dispatched.
104: 		if state.Phase == "STABLE" {
105: 			if len(c.Operation) != 64 || filepath.Base(c.Operation) != c.Operation {
106: 				return nil, errors.New("sealed operation identifier required")
107: 			}
108: 			raw, e := os.ReadFile(filepath.Join(root, "release-state", "admissions", c.Operation+".json"))
109: 			if e != nil {
110: 				return nil, e
111: 			}
112: 			var a supervisor.ReleaseAdmission
113: 			if e = json.Unmarshal(raw, &a); e != nil {
114: 				return nil, e
115: 			}
116: 			if a.Operation != c.Operation {
117: 				return nil, errors.New("sealed operation mismatch")
118: 			}
119: 			state, e = engine.PrepareFixture(a, c.CandidatePath)
120: 			if e != nil {
121: 				return nil, e
122: 			}
123: 		}
124: 		if state.Operation != c.Operation {
125: 			return nil, errors.New("current host operation differs")
126: 		}
127: 		if state.Phase == "PREPARED" {
128: 			if _, e := d.Private(ctx, "FIXTURE_DISPATCH", supervisor.ReleasePrivateMessage{Snapshot: &state, Admission: state.AdmissionBundle}); e != nil {
129: 				return nil, e
130: 			}
131: 			var e error
132: 			state, e = engine.SwitchFixture(ctx, c.Operation)
133: 			if e != nil {
134: 				return nil, e
135: 			}
136: 		} else if state.Phase != "CANARY" {
137: 			return nil, errors.New("release outcome unknown; journal inspection only")
138: 		}
139: 		receipt, _, e := supervisor.WriteFixtureReceipt(filepath.Join(root, "release-state"), j, d)
140: 		if e != nil {
141: 			return nil, e
142: 		}
143: 		return d.Private(ctx, "FIXTURE_PROJECT", supervisor.ReleasePrivateMessage{Snapshot: &state, Observation: &receipt})
144: 	case "rollback":
145: 		return engine.RollbackFixture(ctx, c.Operation)
146: 	case "stop":
147: 		return nil, d.ShutdownFixture(ctx)
148: 	default:
149: 		return nil, fmt.Errorf("unknown bounded host command %q", c.Action)
150: 	}
151: }
