164: func (d *ControlFixtureDriver) Alive(p ProcessIdentity) (bool, error) {
284: 	}
285: 	f := d.frame
286: 	f.Kind = "COMMIT_EXIT"
287: 	if e = d.send(c, f); e != nil {
288: 		return e
289: 	}
290: 	r, e := d.read(c, f)
291: 	if e != nil {
292: 		return e
293: 	}
294: 	if r.Kind != "COMMIT_READY" || r.State != "QUIESCED" || r.Receipt != f.Receipt {
295: 		return errors.New("commit outcome unknown")
296: 	}
297: 	f.Kind = "EXIT_ACK"
298: 	if e = d.send(c, f); e != nil {
299: 		return e
300: 	}
301: 	wait, e := windows.WaitForSingleObject(h, 15000)
302: 	if e != nil || wait != windows.WAIT_OBJECT_0 {
303: 		return fmt.Errorf("normal exit not observed: %d %v", wait, e)
304: 	}
305: 	var code uint32
306: 	if e = windows.GetExitCodeProcess(h, &code); e != nil || code != 0 {
307: 		return fmt.Errorf("control exit was not clean: %d %v", code, e)
308: 	}
309: 	lease, e := rt.AcquireDataRootLease(s.Data)
310: 	if e != nil {
311: 		return e
312: 	}
313: 	return lease.Close()
314: }
