1: //go:build windows
2: 
3: package main
4: 
5: import (
6:     "bytes"
7:     "context"
8:     "database/sql"
9:     "encoding/json"
10:     "errors"
11:     "net/url"
12:     "os"
13:     "path/filepath"
14:     "strings"
15:     "time"
16: 
17:     "researchos.local/research-os/internal/domain"
18:     "researchos.local/research-os/internal/recoveryauthority"
19: )
20: 
21: // Runs before all normal flags, migrations, protected stores, recovery scans,
22: // provider configuration and listeners. A public invocation alone lacks the
23: // inherited OS/crypto authority and therefore cannot open the database.
24: func runPreparedRecoveryMaintenance(args []string) (bool,error) {
25:     if len(args)==0 || (args[0]!=recoveryauthority.MaintenanceArgument && args[0]!=recoveryauthority.MigrationArgument) { return false,nil }
26:     if len(args)!=1 { return true,errors.New("private recovery accepts no caller paths or authority options") }
27:     ctx,cancel:=context.WithTimeout(context.Background(),5*time.Minute); defer cancel()
28:     if args[0]==recoveryauthority.MigrationArgument { return true,runPreparedSchemaMaintenance(ctx) }
29:     token,ownerToken,err:=recoveryauthority.ReceiveInherited(ctx); if err!=nil { return true,err }
30:     defer token.Close()
31:     adoption,err:=token.Adoption(); if err!=nil { return true,err }
32:     db,err:=openExclusiveRecoveryDB(ctx,adoption.Database); if err!=nil { return true,err }; defer db.Close()
33:     result,err:=domain.ExecutePreparedAbandonmentMaintenance(ctx,db,filepath.Join("spec","v2.0","contracts"),token,ownerToken)
34:     ownerToken=""
35:     if err!=nil { return true,err }; return true,json.NewEncoder(os.Stdout).Encode(result)
36: }
37: func openExclusiveRecoveryDB(ctx context.Context,path string) (*sql.DB,error) {
38:     u:=url.URL{Scheme:"file",Opaque:filepath.ToSlash(path)}; q:=u.Query(); q.Set("mode","rw"); u.RawQuery=q.Encode()
39:     db,err:=sql.Open("sqlite",u.String()); if err!=nil { return nil,err }
40:     db.SetMaxOpenConns(1); db.SetMaxIdleConns(1)
41:     ok:=false; defer func(){ if !ok { _=db.Close() } }()
42:     for _,statement:=range []string{"PRAGMA busy_timeout=5000","PRAGMA foreign_keys=ON","PRAGMA synchronous=FULL","PRAGMA locking_mode=EXCLUSIVE"} { if _,err=db.ExecContext(ctx,statement); err!=nil { return nil,err } }
43:     var mode string; if err=db.QueryRowContext(ctx,"PRAGMA locking_mode").Scan(&mode); err!=nil || strings.ToLower(mode)!="exclusive" { return nil,errors.New("native recovery requires exclusive SQLite connection") }
44:     // EXCLUSIVE locking mode retains the OS SQLite lock across later domain
45:     // transactions until this single-connection pool is closed.
46:     if _,err=db.ExecContext(ctx,"BEGIN EXCLUSIVE"); err!=nil { return nil,err }
47:     if _,err=db.ExecContext(ctx,"COMMIT"); err!=nil { return nil,err }
48:     ok=true; return db,nil
49: }
50: func runPreparedSchemaMaintenance(ctx context.Context) error {
51:     token,ownerToken,err:=recoveryauthority.ReceiveMigrationInherited(ctx); if err!=nil { return err }; defer token.Close()
52:     binding,err:=token.Binding(); if err!=nil { return err }
53:     raw,err:=token.Options(); if err!=nil { return err }
54:     var opt domain.LocalUpgradeOptions
55:     decoder:=json.NewDecoder(bytes.NewReader(raw)); decoder.DisallowUnknownFields()
56:     if err=decoder.Decode(&opt); err!=nil { return err }
57:     canonical,err:=json.Marshal(opt); if err!=nil || domain.Digest(canonical)!=binding.OptionsSHA256 || !bytes.Equal(canonical,raw) { return errors.New("native schema maintenance options differ from grant") }
58:     db,err:=openExclusiveRecoveryDB(ctx,binding.Database); if err!=nil { return err }; defer db.Close()
59:     result,err:=domain.ExecutePreparedAbandonmentSchemaUpgrade(ctx,db,token,ownerToken,opt)
60:     ownerToken=""
61:     if err!=nil { return err }; return json.NewEncoder(os.Stdout).Encode(result)
62: }
FILE apps/control/replay_command.go
1: package main
2: 
3: import (
4: 	"bytes"
5: 	"encoding/json"
6: 	"fmt"
7: 	"net/http/httptest"
8: 	"os"
9: 	"path/filepath"
10: 	"strings"
11: 	"unsafe"
12: 
13: 	"golang.org/x/sys/windows"
14: 
15: 	"researchos.local/research-os/evaluation/evolution"
16: 	"researchos.local/research-os/internal/domain"
17: 	"researchos.local/research-os/internal/store"
18: )
19: 
20: // Called before ordinary control initialization. It neither starts a listener
21: // nor loads real credentials, a provider, coordinator or service capability.
22: func runFixtureControlReplay(args []string) (bool, error) {
23: 	if len(args) == 0 || args[0] != "--fixture-control-replay" {
24: 		return false, nil
25: 	}
26: 	if len(args) != 2 {
27: 		return true, fmt.Errorf("one fixture replay request required")
28: 	}
29: 	return true, fixtureControlReplay(args[1])
30: }
31: 
32: func replayPlain(path string) error {
33: 	if !filepath.IsAbs(path) {
34: 		return fmt.Errorf("absolute replay path required")
35: 	}
36: 	name, err := windows.UTF16PtrFromString(path)
37: 	if err != nil {
38: 		return err
39: 	}
40: 	h, err := windows.CreateFile(name, windows.FILE_READ_ATTRIBUTES, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE|windows.FILE_SHARE_DELETE, nil, windows.OPEN_EXISTING, windows.FILE_FLAG_BACKUP_SEMANTICS|windows.FILE_FLAG_OPEN_REPARSE_POINT, 0)
41: 	if err != nil {
42: 		return err
43: 	}
44: 	defer windows.CloseHandle(h)
45: 	var info windows.ByHandleFileInformation
46: 	if err = windows.GetFileInformationByHandle(h, &info); err != nil {
47: 		return err
48: 	}
49: 	if info.FileAttributes&windows.FILE_ATTRIBUTE_REPARSE_POINT != 0 {
50: 		return fmt.Errorf("replay reparse leaf refused")
51: 	}
52: 	// The host has copied every ancestor into a fresh tree while rejecting
53: 	// reparses. AppContainer intentionally cannot query C:\Users metadata, so
54: 	// do not demand ancestor enumeration or grant it broader filesystem access.
55: 	return nil
56: }
57: 
58: func replayRead(path string, limit int64) ([]byte, error) {
59: 	if err := replayPlain(path); err != nil {
60: 		return nil, err
61: 	}
62: 	info, err := os.Stat(path)
63: 	if err != nil || !info.Mode().IsRegular() || info.Size() > limit {
64: 		return nil, fmt.Errorf("bounded regular replay file required")
65: 	}
66: 	return os.ReadFile(path)
67: }
68: 
69: // The replay output is a freshly created AppContainer-only clone. Keep the
70: // same native share-mode-zero coordinator lock without enumerating ancestors
71: // outside the sandbox. Ordinary control still uses its canonical root lease.
72: func replayOutputLease(data string) (*os.File, error) {
73: 	if err := replayPlain(data); err != nil {
74: 		return nil, err
75: 	}
76: 	path := filepath.Join(data, "coordinator.lock")
77: 	name, err := windows.UTF16PtrFromString(path)
78: 	if err != nil {
79: 		return nil, err
80: 	}
81: 	h, err := windows.CreateFile(name, windows.GENERIC_READ|windows.GENERIC_WRITE, 0, nil, windows.CREATE_NEW, windows.FILE_ATTRIBUTE_NORMAL, 0)
82: 	if err != nil {
83: 		return nil, err
84: 	}
85: 	return os.NewFile(uintptr(h), path), nil
86: }
87: 
88: func fixtureControlReplay(requestPath string) error {
89: 	token, err := windows.OpenCurrentProcessToken()
90: 	if err != nil {
91: 		return err
92: 	}
93: 	var appContainer, size uint32
94: 	const tokenIsAppContainer = 29 // TOKEN_INFORMATION_CLASS from Windows SDK winnt.h.
95: 	err = windows.GetTokenInformation(token, tokenIsAppContainer, (*byte)(unsafe.Pointer(&appContainer)), uint32(unsafe.Sizeof(appContainer)), &size)
96: 	token.Close()
97: 	if err != nil || appContainer != 1 {
98: 		return fmt.Errorf("fixture control replay requires AppContainer")
99: 	}
100: 	if err := replayPlain(requestPath); err != nil {
101: 		return err
102: 	}
103: 	input := filepath.Dir(requestPath)
104: 	output, err := os.Getwd()
105: 	if err != nil {
106: 		return err
107: 	}
108: 	if err = replayPlain(output); err != nil {
109: 		return err
110: 	}
111: 	if filepath.Base(requestPath) != "current-case.json" || filepath.Base(input) != "input" || filepath.Base(output) != "output" || !strings.EqualFold(filepath.Dir(input), filepath.Dir(output)) {
112: 		return fmt.Errorf("replay requires isolated sibling input/output roots")
113: 	}
114: 	entries, err := os.ReadDir(output)
115: 	if err != nil || len(entries) != 0 {
116: 		return fmt.Errorf("empty replay output required")
117: 	}
118: 	raw, err := replayRead(requestPath, 64*1024)
119: 	if err != nil {
120: 		return err
121: 	}
122: 	var request evolution.ControlRequest
123: 	if err = evolution.StrictControlJSON(raw, &request); err != nil {
124: 		return err
125: 	}
126: 	if err = evolution.ValidateControlCase(request.Case, request.Binding); err != nil {
127: 		return err
128: 	}
129: 	bundle := evolution.ControlBundle{Binding: request.Binding, Files: map[string][]byte{}}
130: 	for name := range evolution.ControlReleaseHashes() {
131: 		b, e := replayRead(filepath.Join(input, filepath.FromSlash(name)), 2*1024*1024)
132: 		if e != nil {
133: 			return e
134: 		}
135: 		bundle.Files[name] = b
136: 	}
137: 	bundle.Files["snapshot.sqlite"], err = replayRead(filepath.Join(input, "snapshot.sqlite"), 32*1024*1024)
138: 	if err != nil {
139: 		return err
140: 	}
141: 	if err = bundle.Validate(); err != nil {
142: 		return err
143: 	}
144: 	data := filepath.Join(output, "replay-data")
145: 	if err = os.Mkdir(data, 0700); err != nil {
146: 		return err
147: 	}
148: 	path := filepath.Join(data, "researchos.sqlite")
