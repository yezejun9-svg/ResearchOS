+		{"ENQUEUED_SEALED_FENCE",true,4,"SEALED",f08NativeProofGap},
+		{"ENQUEUED_SEALED_SEQUENCE",true,6,f08Number(1),f08Binding},
+		{"ENQUEUED_RESTORE_OPEN",true,12,f08Number(1),f08NativeProofGap},
+		{"ENQUEUED_FENCE_REVISION_BEFORE_ACCEPTANCE",true,13,f08Number(1),f08Binding},
+		{"DROPPED_FENCE_REVISION_BEFORE_CANCEL",false,13,f08Number(2),f08Binding},
+	}
