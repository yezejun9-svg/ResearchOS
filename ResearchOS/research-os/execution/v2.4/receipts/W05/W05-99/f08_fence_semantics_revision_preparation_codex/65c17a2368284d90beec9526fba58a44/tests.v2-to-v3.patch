+		wantRevision:=f08Number(3);if enqueued{wantRevision=f08Number(2)};if !f08Equal(f[13],wantRevision){t.Fatal("fixture does not include actual producer increments")}
+		s:=f08AbsenceDecode(t,rows);q,e:=v.queueAdmission(s,"p","A");if e!=nil||q["variant"]!="NO_SESSION"{t.Fatal(q,e)}
+		final,e:=v.emptyQueueFinal(s,"p","A",q);if e!=nil||!f08EmptyArray(final["entry_refs"])||!f08EmptyArray(final["receipt_refs"]){t.Fatal(final,e)}
+	})}
+	cases:=[]struct{name string;enqueued bool;index int;value any;want error}{
