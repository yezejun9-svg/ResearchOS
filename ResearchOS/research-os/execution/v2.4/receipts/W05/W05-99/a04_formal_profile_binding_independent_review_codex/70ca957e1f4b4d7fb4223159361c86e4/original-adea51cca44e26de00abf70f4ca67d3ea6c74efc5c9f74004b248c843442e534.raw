        "original_token_count": 3831,
        "output": "SOURCE formal_profile_w05.proposed.py\r\n1: \"\"\"Proposed fixed-path W05/A04 owner profile; read-only and fail-closed.\r\n2: \r\n3: The integrator must install this as execution/v2.4/formal_profile_w05.py and\r\n4: independently review the source before any formal owner can be registered.\r\n5: Receipt code is data, never imported. This module neither runs a product nor\r\n6: creates a reviewer or Root issuance record.\r\n7: \"\"\"\r\n8: from __future__ import annotations\r\n9: \r\n10: import hashlib\r\n11: import json\r\n12: from pathlib import Path\r\n13: import re\r\n14: \r\n15: PREFIX = 'execution/v2.4/receipts/W05/W05-99/'\r\n16: MODULE = 'execution/v2.4/formal_profile_w05.py'\r\n17: IDS = tuple('A04-0' + str(i) for i in range(1, 7))\r\n18: GATES = ('W05-G01', 'W05-G02', 'W05-H08', 'W05-P01', 'W05-U02')\r\n19: SCHEMAS = {'context': 'researchos.w05.current-context.v1',\r\n20:            'review': 'researchos.w05.independent-review.v1',\r\n21:            'issuance': 'researchos.w05.root-observed-issuance.v1'}\r\n22: MINIMUM_SOURCE = {MODULE, 'execution/v2.4/formal_case_index.py',\r\n23:                   'ops/ci/runtime.py', 'ops/ci/runtime_w05_live.py',\r\n24:                   'tests/runtime/check/main.go', 'tests/runtime/check/legacy.go'}\r\n25: SCENARIOS = ('success', 'tool_failed', 'request_timeout',\r\n26:              'pending_queue_cancel', 'executor_crash')\r\n27: EXTRA = {'A04-04': 'H08', 'A04-05': 'P01', 'A04-06': 'U02'}\r\n28: \r\n29: \r\n30: def _ref(api, reader, value, *, locator=False):\r\n31:     api.fields(value, ('path', 'sha256'), ('locator',) if locator else (), 'W05 ref')\r\n32:     return reader.ref(value, PREFIX, locator=locator)\r\n33: \r\n34: \r\n35: def _doc(api, reader, value):\r\n36:     return reader.read(_ref(api, reader, value))\r\n37: \r\n38: \r\n39: def _raw(api, reader, value):\r\n40:     path = _ref(api, reader, value, locator=True)\r\n41:     location = api.obj(value.get('locator'), 'A04 raw locator')\r\n42:     content = path.read_bytes()\r\n43:     if set(location) == {'json_pointer'}:\r\n44:         pointer = location['json_pointer']\r\n45:         api.require(type(pointer) is str and (not pointer or pointer.startswith('/')),\r\n46:                     'RAW_LOCATOR', value['path'])\r\n47:         current = api.strict_json(content)\r\n48:         for token in pointer[1:].split('/') if pointer else ():\r\n49:             api.require(re.search(r'~(?![01])', token) is None, 'RAW_LOCATOR', pointer)\r\n50:             token = token.replace('~1', '/').replace('~0', '~')\r\n51:             if type(current) is dict:\r\n52:                 api.require(token in current, 'RAW_LOCATOR_MISSING', pointer)\r\n53:                 current = current[token]\r\n54:             elif type(current) is list:\r\n55:                 api.require(re.fullmatch(r'0|[1-9][0-9]*', token) is not None and\r\n56:                             int(token) < len(current), 'RAW_LOCATOR_MISSING', pointer)\r\n57:                 current = current[int(token)]\r\n58:             else:\r\n59:                 api.require(False, 'RAW_LOCATOR_MISSING', pointer)\r\n60:     else:\r\n61:         api.fields(location, ('line_start', 'line_end'), label='A04 line locator')\r\n62:         lines = content.decode('utf-8').splitlines()\r\n63:         first, last = location['line_start'], location['line_end']\r\n64:         api.require(type(first) is int and type(last) is int and\r\n65:                     1 <= first <= last <= len(lines), 'RAW_LOCATOR_MISSING', value['path'])\r\n66:         current = '\\n'.join(lines[first - 1:last])\r\n67:     api.require(api.meaningful(current), 'RAW_EMPTY', value['path'])\r\n68:     return current\r\n69: \r\n70: \r\n71: def _vector(api, reader, context):\r\n72:     vector = api.fields(context.get('version_vector'),\r\n73:                         ('schema', 'package_version', 'spec_files', 'source_files',\r\n74:                          'input_files', 'lock_files', 'tool_files', 'environment',\r\n75:                          'components'), label='W05 vector')\r\n76:     api.require(vector['schema'] == 'researchos.w05.version-vector.v1' and\r\n77:                 vector['package_version'] == '2.4.0', 'SCHEMA', 'W05 vector')\r\n78:     pinned, paths = {}, set()\r\n79:     for group in ('spec_files', 'source_files', 'input_files', 'lock_files', 'tool_files'):\r\n80:         local = set()\r\n81:         for reference in api.sequence(vector[group], 'W05 ' + group):\r\n82:             path = reader.ref(reference)\r\n83:             api.require(path not in local, 'DUPLICATE_REFERENCE', group)\r\n84:             local.add(path)\r\n85:             api.require(path not in pinned or pinned[path] == reference['sha256'],\r\n86:                         'VECTOR_CONFLICT', reference['path'])\r\n87:             pinned[path] = reference['sha256']\r\n88:             paths.add(reference['path'])\r\n89:     api.require(MINIMUM_SOURCE <= {r['path'] for r in vector['source_files']},\r\n90:                 'SOURCE_COVERAGE', 'current A04 handler/profile source missing')\r\n91:     api.coverage(reader, context['source_coverage'], vector['source_files'])\r\n92:     for name, digest in api.FROZEN_HASHES.items():\r\n93:         api.require(any(Path(ref['path']).name == name and ref['sha256'] == digest\r\n94:                         for ref in vector['spec_files']), 'VECTOR_BASELINE', name)\r\n95:     for key in ('execution/v2.4/commands.json', 'execution/commands.json',\r\n96:                 'execution/toolchains/locked.json'):\r\n97:         api.require(key in paths, 'VECTOR_INPUT', key)\r\n98:     env = api.fields(vector['environment'], ('os', 'arch', 'timezone'), label='environment')\r\n99:     api.require('windows' in env['os'].casefold() and\r\n100:                 all(api.text(value, key) for key, value in env.items()),\r\n101:                 'ENVIRONMENT', 'A04 requires actual Windows')\r\n102:     components = api.fields(vector['components'], ('model', 'adapter', 'rubric', 'policy'),\r\n103:                             label='components')\r\n104:     for name, value in components.items():\r\n105:         api.fields(value, ('status', 'version', 'refs'), label=name)\r\n106:         api.require(value['status'] == 'applicable', 'COMPONENT_STATUS', name)\r\n107:         api.text(value['version'], name)\r\n108:         for reference in api.sequence(value['refs'], name):\r\n109:             api.require(pinned.get(reader.ref(reference)) == reference['sha256'],\r\n110:                         'COMPONENT_UNPINNED', name)\r\n111:     return vector, pinned\r\n112: \r\n113: \r\n114: def _frozen(api, reader, plan_path):\r\n115:     package_plan = Path(plan_path).resolve(strict=True)\r\n116:     api.require(package_plan.name == 'execution.plan.json' and\r\n117:                 api.sha256(package_plan) == api.FROZEN_HASHES['execution.plan.json'],\r\n118:                 'FROZEN_BASELINE', 'v2.4 plan')\r\n119:     plan = reader.read(package_plan)\r\n120:     step = next(item for item in plan['steps'] if item['id'] == 'W05-99')\r\n121:     api.require(step['formal_final_cases'] == ['A04'] and\r\n122:                 [row.get('check_id') for row in step['verification_commands'] if row.get('check_id')] == list(GATES) and\r\n123:                 [row.get('case_id') for row in step['verification_commands'] if row.get('case_id')] == ['A04'],\r\n124:                 'FROZEN_OWNER', 'W05-99 binding changed')\r\n125:     catalog_path = package_plan.parent / 'acceptance.json'\r\n126:     api.require(catalog_path.is_file() and\r\n127:                 api.sha256(catalog_path) == api.FROZEN_HASHES['acceptance.json'],\r\n128:                 'FROZEN_BASELINE', 'v2.4 acceptance')\r\n129:     catalog = reader.read(catalog_path)\r\n130:     case = next(item for item in catalog['cases'] if item['id'] == 'A04')\r\n131:     api.require(case['final_owner_task'] == 'W05' and case['mode'] == 'LIVE_WINDOWS',\r\n132:                 'FROZEN_OWNER', 'A04')\r\n133:     api.exact_ids([row['id'] for row in case['assertions']], IDS, 'A04 frozen assertions')\r\n134:     api.require(case['input']['subcases'] == list(SCENARIOS),\r\n135:                 'FROZEN_OWNER', 'five A04 subcases')\r\n136:     return case, step\r\n137: \r\n138: \r\nSOURCE runtime_w05_live.proposed.py\r\n1: \"\"\"Proposed W05-only post-capture test.runtime handler.\r\n2: \r\n3: It reads a Root-selected, immutable LIVE_WINDOWS bundle. The actual product\r\n4: execution must be a separate registered, granted producer. This handler is\r\n5: not a model caller or an independent formal reviewer.\r\n6: \"\"\"\r\n7: from __future__ import annotations\r\n8: \r\n9: import hashlib\r\n10: import json\r\n11: import os\r\n12: from pathlib import Path\r\n13: import sys\r\n14: \r\n15: REPO = Path(__file__).resolve().parents[2]\r\n16: BOUNDARY = REPO / 'execution/v2.4/receipts/W05/W05-99'\r\n17: IDS = tuple('A04-0' + str(i) for i in range(1, 7))\r\n18: GATES = ('W05-G01', 'W05-G02', 'W05-H08', 'W05-P01', 'W05-U02')\r\n19: SCENARIOS = ('success', 'tool_failed', 'request_timeout',\r\n20:              'pending_queue_cancel', 'executor_crash')\r\n21: \r\n22: \r\n23: def require(ok, reason):\r\n24:     if not ok:\r\n25:         raise ValueError(reason)\r\n26: \r\n27: \r\n28: def strict_json(raw):\r\n29:     def unique(pairs):\r\n30:         value = {}\r\n31:         for key, item in pairs:\r\n32:             require(key not in value, 'DUPLICATE_JSON_KEY')\r\n33:             value[key] = item\r\n34:         return value\r\n35:     return json.loads(raw, object_pairs_hook=unique,\r\n36:                       parse_constant=lambda _: require(False, 'NONFINITE_JSON'))\r\n37: \r\n38: \r\n39: def pin_raw(ref):\r\n40:     require(type(ref) is dict and set(ref) in ({'path', 'sha256'},\r\n41:                                                  {'path', 'sha256', 'locator'}), 'REF_SHAPE')\r\n42:     require(type(ref['path']) is str and type(ref['sha256']) is str and\r\n43:             len(ref['sha256']) == 64, 'REF_FORMAT')\r\n44:     relative = Path(ref['path'])\r\n45:     require(not relative.is_absolute() and '..' not in relative.parts and\r\n46:             '\\\\' not in ref['path'], 'REF_PATH')\r\n47:     candidate = REPO / relative\r\n48:     for part in (candidate, *candidate.parents):\r\n49:         if part == REPO.parent:\r\n50:             break\r\n51:         require(not part.is_symlink() and not part.is_junction(), 'REF_REPARSE')\r\n52:     path = candidate.resolve(strict=True)\r\n53:     require(path.is_file() and path.is_relative_to(BOUNDARY.resolve(strict=True)),\r\n54:             'REF_SCOPE')\r\n55:     raw = path.read_bytes()\r\n56:     require(hashlib.sha256(raw).hexdigest() == ref['sha256'], 'REF_CHANGED')\r\n57:     return raw, path\r\n58: \r\n59: \r\n60: def read_ref(ref):\r\n61:     raw, path = pin_raw(ref)\r\n62:     value = strict_json(raw)\r\n63:     if 'locator' in ref:\r\n64:         location = ref['locator']\r\n65:         require(type(location) is dict and set(location) == {'json_pointer'},\r\n66:                 'JSON_LOCATOR_REQUIRED')\r\n67:         pointer = location['json_pointer']\r\n68:         require(type(pointer) is str and (not pointer or pointer.startswith('/')),\r\n69:                 'JSON_POINTER_FORMAT')\r\n70:         for token in pointer[1:].split('/') if pointer else ():\r\n71:             require('~' not in token.replace('~1', '').replace('~0', ''),\r\n72:                     'JSON_POINTER_ESCAPE')\r\n73:             token = token.replace('~1', '/').replace('~0', '~')\r\n74:             if type(value) is dict:\r\n75:                 require(token in value, 'JSON_POINTER_MISSING')\r\n76:                 value = value[token]\r\n77:             elif type(value) is list:\r\n78:                 require(token.isdigit() and int(token) < len(value),\r\n79:                         'JSON_POINTER_MISSING')\r\n80:                 value = value[int(token)]\r\n81:             else:\r\n82:                 raise ValueError('JSON_POINTER_MISSING')\r\n83:     return value, path\r\n84: \r\n85: \r\n86: def selected_selector():\r\n87:     task = os.environ.get('RESEARCHOS_TASK_ID')\r\n88:     check = os.environ.get('RESEARCHOS_CHECK_ID') or ''\r\n89:     case = os.environ.get('RESEARCHOS_CASE_ID') or ''\r\n90:     require(task == 'W05' and ((case == 'A04' and not check) or\r\n91:             (check in GATES and not case)), 'W05_EXACT_SELECTOR')\r\n92:     return case or check\r\n93: \r\n94: \r\n198: def main():\r\n199:     try:\r\n200:         selector = selected_selector()\r\n201:         require(os.name == 'nt' and os.environ.get('RESEARCHOS_RUNTIME_LIVE') == '1',\r\n202:                 'LIVE_WINDOWS_NOT_GRANTED')\r\n203:         source = os.environ.get('RESEARCHOS_W05_LIVE_BUNDLE_PATH')\r\n204:         digest = os.environ.get('RESEARCHOS_W05_LIVE_BUNDLE_SHA256')\r\n205:         require(source and digest and len(digest) == 64, 'ROOT_BUNDLE_NOT_SELECTED')\r\n206:         path = Path(source)\r\n207:         require(path.is_absolute() and path.is_file() and\r\n208:                 path.resolve(strict=True).is_relative_to(BOUNDARY.resolve(strict=True)) and\r\n209:                 not path.is_symlink() and not path.is_junction(), 'ROOT_BUNDLE_PATH')\r\n210:         raw = path.read_bytes()\r\n211:         require(hashlib.sha256(raw).hexdigest() == digest, 'ROOT_BUNDLE_CHANGED')\r\n212:         bundle = strict_json(raw)\r\n213:         rows = verify_bundle(bundle, selector)\r\n214:         print(json.dumps({'schema': 'researchos.w05.test-runtime-live-result.v1',\r\n215:                           'task_id': 'W05', 'selector': selector, 'run_id': bundle['run_id'],\r\n216:                           'mode': 'LIVE_WINDOWS', 'status': 'PASS',\r\n217:                           'cost_status': bundle['accounting']['status'],\r\n218:                           'cost_amount_usd': bundle['accounting']['amount_usd'],\r\n219:                           'assertion_ids': [row['id'] for row in rows],\r\n220:                           'independent_acceptance': 'NOT_EVALUATED'},\r\n221:                          ensure_ascii=False, sort_keys=True))\r\n222:         return 0\r\n223:     except (OSError, ValueError, KeyError, TypeError, json.JSONDecodeError) as exc:\r\n224:         print(json.dumps({'schema': 'researchos.w05.test-runtime-live-result.v1',\r\n225:                           'status': 'NOT_RUN', 'reason': type(exc).__name__ + ':' + str(exc),\r\n226:                           'independent_acceptance': 'NOT_EVALUATED'},\r\n227:                          ensure_ascii=False), file=sys.stderr)\r\n228:         return 3\r\n229: \r\n230: \r\n231: if __name__ == '__main__':\r\n232:     raise SystemExit(main())\r\nSOURCE export_a04_live.proposed.py\r\n1: \"\"\"Proposed A04 producer-only GLOBAL_EVIDENCE_V1 exporter.\r\n2: \r\n3: This consumes a Root-sealed LIVE capture after the native children are closed.\r\n4: It writes four producer parts and current context. The fifth part is a later\r\n5: independent acceptance review; this exporter cannot create or impersonate it.\r\n6: \"\"\"\r\n7: from __future__ import annotations\r\n8: \r\n9: from datetime import datetime, timezone\r\n10: import hashlib\r\n11: import json\r\n12: import os\r\n13: from pathlib import Path\r\n14: import sys\r\n15: \r\n16: from runtime_w05_live import REPO, BOUNDARY, IDS, GATES, SCENARIOS, \\\r\n17:     pin_raw, read_ref, require, strict_json, verify_bundle\r\n18: \r\n19: \r\n20: def pin(path):\r\n21:     raw = path.read_bytes()\r\n22:     return {'path': path.relative_to(REPO).as_posix(),\r\n23:             'sha256': hashlib.sha256(raw).hexdigest()}\r\n24: \r\n25: \r\n26: def put(path, value):\r\n27:     raw = (json.dumps(value, ensure_ascii=False, sort_keys=True,\r\n28:                       indent=2, allow_nan=False) + '\\n').encode('utf-8')\r\n29:     with path.open('xb') as out:\r\n30:         out.write(raw)\r\n31:     return pin(path)\r\n32: \r\n33: \r\nACTUAL_PYTHON_EXIT=0\r\n"
