        "cmd": "@'\nfrom pathlib import Path\np=Path('D:/作品集/ResearchOS/research-os/execution/v2.4/receipts/W05/W05-99/a04_formal_profile_source_preparation_codex/a61c549b78aa4f2ea3ccf4857e44838e')\nfor name,spans in [('formal_profile_w05.proposed.py',[(1,138)]),('runtime_w05_live.proposed.py',[(1,94),(198,232)]),('export_a04_live.proposed.py',[(1,33)])]:\n lines=(p/name).read_text(encoding='utf-8').splitlines();print('SOURCE',name)\n for a,b in spans:\n  for n in range(a,min(b,len(lines))+1):print(f'{n}: {lines[n-1]}')\n'@ | & 'C:/Users/yqyyds/AppData/Local/Python/pythoncore-3.14-64/python.exe' -I -S -X utf8 -\n$metadataExit=$LASTEXITCODE\nWrite-Output \"ACTUAL_PYTHON_EXIT=$metadataExit\"\nexit $metadataExit",
