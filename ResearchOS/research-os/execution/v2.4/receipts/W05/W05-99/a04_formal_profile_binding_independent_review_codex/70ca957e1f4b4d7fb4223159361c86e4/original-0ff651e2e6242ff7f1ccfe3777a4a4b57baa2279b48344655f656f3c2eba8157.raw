fullmatch(facts['file_after_sha256']) and\\\\r\\\\n275:                     facts.get('file_before_sha256') != facts.get('file_after_sha256') and\\\\r\\\\n276:                     type(facts.get('tests_native_exit')) is int and facts['tests_native_exit'] == 0 and\\\\r\\\\n277:                     facts.get('fixed_model_unchanged') is True and\\\\r\\\\n278:                     facts.get('model_before') == facts.get('model_after') ==\\\\r\\\\n279:                     context['fixed_model'] and\\\\r\\\\n280:                     set(facts.get('cli_handlers', ())) ==\\\\r\\\\n281:                     {'init', 'run', 'goal', 'resume', 'status', 'cancel', 'doctor',\\\\r\\\\n282:                      'config', 'interactive', 'jsonl', 'slash'},\\\\r\\\\n283:                     'A04_REAL_ISSUE', row['id'])\\\\r\\\\n284:     doc, raw = _profile_io(api, reader, context)\\\\r\\\\n285:     verify_refusal(doc, raw, context, row)\\\\r\\\\n286:     api.require(row['actual'] == proof.get('actual'),\\\\r\\\\n287:                 'ASSERTION_RESULT', row['id'])\\\\r\\\\n497: def _root_pair(document, scope):\\\\r\\\\n498:     if type(document) is not dict or document.get('schema') != 'researchos.w05.original-tool-pair.v2':\\\\r\\\\n499:         raise ValueError('OPEN_ORIGINAL_ROOT_TOOL_PAIR')\\\\r\\\\n500:     initial, terminal = document.get('initial'), document.get('terminal')\\\\r\\\\n501:     for pair in (initial, terminal):\\\\r\\\\n502:         if type(pair) is not dict or set(pair) != {'tool', 'input', 'result'} or type(pair['input']) is not dict or type(pair['result']) is not dict:\\\\r\\\\n503:             raise ValueError('OPEN_ORIGINAL_TOOL_INPUT_RESULT')\\\\r\\\\n504:     if initial['tool'] != 'exec_command' or initial['input'] != scope['initial_tool_input']:\\\\r\\\\n505:         raise ValueError('OPEN_ROOT_INITIAL_INPUT')\\\\r\\\\n506:     first = initial['result']\\\\r\\\\n507:     if type(first.get('session_id')) is int:\\\\r\\\\n508:         if terminal['tool'] != 'write_stdin' or terminal['input'].get('session_id') != first['session_id'] or terminal['input'].get('chars', '') != '':\\\\r\\\\n509:             raise ValueError('OPEN_ROOT_TERMINAL_SESSION')\\\\r\\\\n510:     elif terminal != initial:\\\\r\\\\n511:         raise ValueError('OPEN_ROOT_SYNCHRONOUS_PAIR')\\\\r\\\\n512:     _native_exit(terminal['result'].get('exit_code'), 'actual outer exit')\\\\r\\\\n513:     output = _nonempty(terminal['result'].get('output'), 'original terminal output')\\\\r\\\\n514:     lines = output.splitlines()\\\\r\\\\n515:     summaries = [_json_original(line) for line in lines if line.startswith('{')]\\\\r\\\\n516:     closed = [row for row in summaries if type(row) is dict and 'actual_launcher_native_exit' in row]\\\\r\\\\n517:     if len(closed) != 1:\\\\r\\\\n518:         raise ValueError('OPEN_ACTUAL_NATIVE_BRIDGE')\\\\r\\\\n519:     _native_exit(closed[0]['actual_launcher_native_exit'], 'actual launcher native exit')\\\\r\\\\n520:     return closed[0]\\\\r\\\\nACTUAL_PYTHON_EXIT=0\\\\r\\\\n\\\"\\n      }\\n    },\\n    {\\n      \\\"operation\\\": \\\"helpers_patch\\\",\\n      \\\"input\\\": \\\"*** Begin Patch\\\\n*** Add File: D:/作品集/ResearchOS/research-os/execution/v2.4/receipts/W05/W05-99/a04_formal_profile_source_binding_revision_codex/c97e11df194d431cb901934bf01e6c94/schema_helpers.source.txt\\\\n+def _public_value(group, name, value):\\\\n+    # Closed projection of the three pinned public schemas, not receipt code.\\\\n+    _schema_value(PUBLIC_SCHEMAS[group][name], value, group)\\\\n+\\\\n+\\\\n+def _schema_value(schema, value, group, depth=0):\\\\n+    if depth > 128:\\\\n+        raise ValueError('OPEN_PUBLIC_SCHEMA_DEPTH')\\\\n+    if '$ref' in schema:\\\\n+        target_group, name = schema['$ref'].split(':', 1)\\\\n+        _schema_value(PUBLIC_SCHEMAS[target_group][name], value, target_group, depth+1)\\\\n+    if 'type' in schema:\\\\n+        expected = {'object': dict, 'array': list, 'string': str, 'integer': int,\\\\n+                    'boolean': bool, 'null': type(None)}[schema['type']]\\\\n+        if type(value) is not expected:\\\\n+            raise ValueError('OPEN_PUBLIC_SCHEMA_TYPE')\\\\n+    if 'const' in schema and (type(value) is not type(schema['const']) or value != schema['const']):\\\\n+        raise ValueError('OPEN_PUBLIC_SCHEMA_CONST')\\\\n+    if 'enum' in schema and not any(type(value) is type(item) and value == item for item in schema['enum']):\\\\n+        raise ValueError('OPEN_PUBLIC_SCHEMA_ENUM')\\\\n+    if 'anyOf' in schema:\\\\n+        matched = False\\\\n+        for alternative in schema['anyOf']:\\\\n+            try:\\\\n+                _schema_value(alternative, value, group, depth+1)\\\\n+                matched = True\\\\n+                break\\\\n+            except ValueError:\\\\n+                pass\\\\n+        if not matched:\\\\n+            raise ValueError('OPEN_PUBLIC_SCHEMA_ANYOF')\\\\n+    for child in schema.get('allOf', ()):\\\\n+        _schema_value(child, value, group, depth+1)\\\\n+    if 'if' in schema:\\\\n+        try:\\\\n+            _schema_value(schema['if'], value, group, depth+1)\\\\n+            applies = True\\\\n+        except ValueError:\\\\n+            applies = False\\\\n+        branch = 'then' if applies else 'else'\\\\n+        if branch in schema:\\\\n+            _schema_value(schema[branch], value, group, depth+1)\\\\n+    if type(value) is dict:\\\\n+        props = schema.get('properties', {})\\\\n+        if not set(schema.get('required', ())) <= set(value):\\\\n+            raise ValueError('OPEN_PUBLIC_SCHEMA_REQUIRED')\\\\n+        if schema.get('additionalProperties') is False and not set(value) <= set(props):\\\\n+            raise ValueError('OPEN_PUBLIC_SCHEMA_EXTRA')\\\\n+        for key in set(value) & set(props):\\\\n+            if props[key].get('writeOnly') is True:\\\\n+                raise ValueError('OPEN_PUBLIC_WRITE_ONLY')\\\\n+            _schema_value(props[key], value[key], group, depth+1)\\\\n+    if type(value) is list:\\\\n+        if len(value) < schema.get('minItems', 0) or ('maxItems' in schema and len(value) > schema['maxItems']):\\\\n+            raise ValueError('OPEN_PUBLIC_SCHEMA_ARRAY_SIZE')\\\\n+        for item in value:\\\\n+            if 'items' in schema:\\\\n+                _schema_value(schema['items'], item, group, depth+1)\\\\n+    if type(value) is str:\\\\n+        if len(value) < schema.get('minLength', 0) or ('maxLength' in schema and len(value) > schema['maxLength']):\\\\n+            raise ValueError('OPEN_PUBLIC_SCHEMA_STRING_SIZE')\\\\n+        if 'pattern' in schema and re.search(schema['pattern'], value) is None:\\\\n+            raise ValueError('OPEN_PUBLIC_SCHEMA_PATTERN')\\\\n+        if schema.get('format') == 'date-time':\\\\n+            import datetime\\\\n+            if re.fullmatch(r'[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\\\\\\\.[0-9]+)?(?:[Zz]|[+-][0-9]{2}:[0-9]{2})', value) is None:\\\\n+                raise ValueError('OPEN_PUBLIC_SCHEMA_DATE_TIME')\\\\n+            try:\\\\n+                datetime.datetime.fromisoformat(value.upper().replace('Z', '+00:00'))\\\\n+            except ValueError:\\\\n+                raise ValueError('OPEN_PUBLIC_SCHEMA_DATE_TIME') from None\\\\n+    if type(value) is int and 'minimum' in schema and value < schema['minimum']:\\\\n+        raise ValueError('OPEN_PUBLIC_SCHEMA_MINIMUM')\\\\n+\\\\n+\\\\n+def _database_row(kind, revision, digest, body, identity, expected_id):\\\\n+    _integer(revision, 'database revision')\\\\n+    if revision < 1 or revision > 9223372036854775807:\\\\n+        raise ValueError('OPEN_DATABASE_REVISION')\\\\n+    value = _json_original(body)\\\\n+    if type(value) is not dict or kind not in ('Task', 'Run', 'Artifact'):\\\\n+        raise ValueError('OPEN_DATABASE_ENTITY')\\\\n+    group = 'domain'\\\\n+    if kind == 'Task':\\\\n+        route = value.get('binding', {}).get('route') if type(value.get('binding')) is dict else None\\\\n+        if route in ('MU_FORK', 'PI_COMPOSE', 'GAP_ONLY_COMPOSE'):\\\\n+            group = 'persistence'\\\\n+        elif route not in ('PAPERCLIP', 'THIN_CORE'):\\\\n+            raise ValueError('OPEN_DATABASE_TASK_ROUTE')\\\\n+    _public_value(group, kind, value)\\\\n+    if value['id'] != expected_id or value['revision'] != revision or value['project_id'] != identity['project_id']:\\\\n+        raise ValueError('OPEN_DATABASE_BODY')\\\\n+    if kind == 'Artifact':\\\\n+        if type(digest) is not str or re.fullmatch(r'sha256:[0-9a-f]{64}', digest) is None or digest != value['content_hash'] or value['run_id'] != identity['run_id']:\\\\n+            raise ValueError('OPEN_DATABASE_ARTIFACT_HASH')\\\\n+    elif digest is not None:\\\\n+        # store.go:221-235 only sets this column for receipt_hash or Artifact.\\\\n+        raise ValueError('OPEN_DATABASE_NONHASHED_ENTITY')\\\\n+    if kind == 'Task' and value['goal_id'] != identity['goal_id']:\\\\n+        raise ValueError('OPEN_DATABASE_TASK_GOAL')\\\\n+    if kind == 'Run' and value['task_id'] != identity['task_id']:\\\\n+        raise ValueError('OPEN_DATABASE_TASK_RUN')\\\\n+    return value\\\\n+\\\\n+\\\\n+def _event_schema(event):\\\\n+    _public_value('client', 'SessionEvent', event)\\\\n+    sensitive = ('credential_value', 'api_key', 'apikey', 'secret', 'token_value', 'password', 'authorization')\\\\n+    pending = [event['payload']]\\\\n+    while pending:\\\\n+        value = pending.pop()\\\\n+        if type(value) is dict:\\\\n+            for key, child in value.items():\\\\n+                if any(pattern in key.casefold() for pattern in sensitive):\\\\n+                    raise ValueError('OPEN_SENSITIVE_EVENT_PAYLOAD')\\\\n+                pending.append(child)\\\\n+        elif type(value) is list:\\\\n+            pending.extend(value)\\\\n+\\\\n*** End Patch\\\",\\n      \\\"result\\\": {}\\n    },\\n    {\\n      \\\"operation\\\": \\\"replacements_patch\\\",\\n      \\\"input\\\": \\\"*** Begin Patch\\\\n*** Add File: D:/作品集/ResearchOS/research-os/execution/v2.4/receipts/W05/W05-99/a04_formal_profile_source_binding_revision_codex/c97e11df194d431cb901934bf01e6c94/replacement_functions.source.txt\\\\n+def _database(raw, identity):\\\\n+    # Only a Root-materialized complete, quiescent SQLite snapshot is supported.\\\\n+    if type(raw) is not bytes or not raw.startswith((b'SQLite format 3' + bytes((0,)))):\\\\n+        raise ValueError('OPEN_COMPLETE_SQLITE_ORIGINAL')\\\\n+    import sqlite3\\\\n+    db = sqlite3.connect(':memory:')\\\\n+    try:\\\\n+        db.deserialize(raw)\\\\n+        db.execute('PRAGMA query_only=ON')\\\\n+        result = {}\\\\n+        for kind, key, output_key in (('Task', 'task_id', 'Task'), ('Run', 'run_id', 'TaskRun')):\\\\n+            rows = db.execute('SELECT revision,content_hash,body FROM domain_objects WHERE project=? AND kind=? AND id=?',\\\\n+                              (identity['project_id'], kind, identity[key])).fetchall()\\\\n+            if len(rows) != 1:\\\\n+                raise ValueError('OPEN_DATABASE_CURRENT_IDENTITY')\\\\n+            result[output_key] = _database_row(kind, *rows[0], identity, identity[key])\\\\n+        artifact_ids = result['TaskRun']['result_artifact_ids']\\\\n+        if len(set(artifact_ids)) != len(artifact_ids):\\\\n+            raise ValueError('OPEN_DUPLICATE_RESULT_ARTIFACT')\\\\n+        result['Artifacts'] = {}\\\\n+        for artifact_id in artifact_ids:\\\\n+            rows = db.execute('SELECT revision,content_hash,body FROM domain_objects WHERE project=? AND kind=\\\\\\\\'Artifact\\\\\\\\' AND id=?',\\\\n+                              (identity['project_id'], artifact_id)).fetchall()\\\\n+            if len(rows) != 1:\\\\n+                raise ValueError('OPEN_DATABASE_CURRENT_ARTIFACT')\\\\n+            result['Artifacts'][artifact_id] = _database_row('Artifact', *rows[0], identity, artifact_id)\\\\n+        result['acceptance_count'] = db.execute(\\\\n+            \\\\\\\"SELECT count(*) FROM domain_objects WHERE project=? AND kind='AcceptanceReceipt' AND json_extract(body,'$.task_id')=?\\\\\\\",\\\\n+            (identity['project_id'], identity['task_id'])).fetchone()[0]\\\\n+        return result\\\\n+    finally:\\\\n+        db.close()\\\\n+\\\\n+\\\\n+def _jsonl(raw, identity):\\\\n+    lines = raw.decode('utf-8').splitlines()\\\\n+    if not lines or any(not line.strip() for line in lines):\\\\n+        raise ValueError('OPEN_COMPLETE_JSONL')\\\\n+    frames = [_json_original(line) for line in lines]\\\\n+    events, finals, event_ids = [], [], set()\\\\n+    for ordinal, frame in enumerate(frames):\\\\n+        if type(frame) is not dict:\\\\n+            raise ValueError('OPEN_JSONL_OBJECT')\\\\n+        if frame.get('type') == 'session.event':\\\\n+            if finals:\\\\n+                raise ValueError('OPEN_EVENT_AFTER_FINAL')\\\\n+            event = frame.get('event')\\\\n+            _event_schema(event)\\\\n+            if event['session_id'] != identity['session_id'] or event['core_build_id'] != identity['core_build_id']:\\\\n+                raise ValueError('OPEN_EVENT_IDENTITY')\\\\n+            if event['event_id'] in event_ids:\\\\n+                raise ValueError('OPEN_DUPLICATE_EVENT_ID')\\\\n+            event_ids.add(event['event_id'])\\\\n+            if events and event['sequence'] != events[-1]['sequence'] + 1:\\\\n+                raise ValueError('OPEN_EVENT_GAP')\\\\n+            if event['run_id'] not in (None, identity['run_id']):\\\\n+                raise ValueError('OPEN_FOREIGN_RUN_EVENT')\\\\n+            if event['kind'] == 'RUN_STATE' and event['payload']['run_id'] != event['run_id']:\\\\n+                raise ValueError('OPEN_RUN_STATE_EVENT_RUN')\\\\n+            if event['kind'] == 'GOAL_STATE' and event['payload']['goal_id'] != identity['goal_id']:\\\\n+                raise ValueError('OPEN_GOAL_STATE_EVENT_GOAL')\\\\n+            events.append(event)\\\\n+        elif frame.get('type') == 'session.snapshot':\\\\n+            raise ValueError('OPEN_EVENT_RESYNC_OR_SNAPSHOT')\\\\n+        else:\\\\n+            if ordinal != len(frames)-1 or finals or type(frame.get('execution')) is not dict:\\\\n+                raise ValueError('OPEN_SINGLE_FINAL_REQUIRED')\\\\n+            finals.append(frame['execution'])\\\\n+    if not events or len(finals) != 1:\\\\n+        raise ValueError('OPEN_ORIGINAL_EVENT_STREAM')\\\\n+    final = finals[0]\\\\n+    for key in ('project_id', 'session_id', 'goal_id', 'task_id', 'run_id'):\\\\n+        if final.get(key) != identity[key]:\\\\n+            raise ValueError('OPEN_FINAL_IDENTITY')\\\\n+    _integer(final.get('event_sequence'), 'final event sequence')\\\\n+    if final['event_sequence'] != events[-1]['sequence'] or final.get('independent_acceptance') != 'NOT_EVALUATED':\\\\n+        raise ValueError('OPEN_FINAL_CURSOR_ACCEPTANCE')\\\\n+    _native_exit(final.get('exit_code'), 'actual CLI exit')\\\\n+    return events, final\\\\n+\\\\n+\\\\n+def verify_refusal(doc, raw, context, row):\\\\n+    identity = row['product_identity']\\\\n+    expected = {'run_id': context['run_id'], 'task_id': identity['task_id'],\\\\n+                'lane': row['lane'], 'assertion_id': row['id'],\\\\n+                'negative_condition': row['expected'], 'product_identity': identity}\\\\n+    issuance, _ = _original(doc, raw, context.get('root_grant_issuance_ref'))\\\\n+    if issuance.get('schema') != 'researchos.w05.original-root-grant-issuance.v2' or issuance.get('actor_id') != 'codex:/root' or issuance.get('run_id') != context['run_id'] or issuance.get('grant_ref') != context['root_grant_ref']:\\\\n+        raise ValueError('OPEN_NEGATIVE_ROOT_ISSUANCE')\\\\n+    scope_refs = _nonempty(issuance.get('negative_scope_refs'), 'Root negative scope refs', list)\\\\n+    if any(type(ref) is not dict or set(ref) != {'path', 'sha256'} for ref in scope_refs) or len({ref['path'] for ref in scope_refs}) != len(scope_refs):\\\\n+        raise ValueError('OPEN_NEGATIVE_ROOT_SCOPE_REFS')\\\\n+    original_result = issuance.get('original_result')\\\\n+    if type(original_result) is not dict or type(original_result.get('exit_code')) is not int or original_result['exit_code'] != 0 or type(original_result.get('output')) is not str:\\\\n+        raise ValueError('OPEN_NEGATIVE_ROOT_ISSUANCE_RESULT')\\\\n+    observed = [_json_original(line) for line in original_result['output'].splitlines() if line.startswith('{')]\\\\n+    if len(observed) != 1 or type(observed[0]) is not dict or observed[0].get('grant_ref') != context['root_grant_ref'] or observed[0].get('negative_scope_refs') != scope_refs:\\\\n+        raise ValueError('OPEN_NEGATIVE_ROOT_ORIGINAL_SCOPE_BINDING')\\\\n+    for reference in _nonempty(row.get('refusal_evidence_refs'), 'actual refusal refs', list):\\\\n+        refusal, _ = _original(doc, raw, reference)\\\\n+        if refusal.get('schema') != 'researchos.w05.actual-refusal.v2' or refusal.get('rejected') is not True or any(refusal.get(key) != expected[key] for key in ('assertion_id', 'run_id', 'lane', 'task_id', 'negative_condition')):\\\\n+            raise ValueError('OPEN_ACTUAL_REFUSAL_IDENTITY')\\\\n+        if refusal.get('invocation_ref') != row['negative_invocation_ref']:\\\\n+            raise ValueError('OPEN_FROZEN_NEGATIVE_BINDING')\\\\n+        invocation, _ = _original(doc, raw, refusal['invocation_ref'])\\\\n+        if invocation.get('schema') != 'researchos.w05.negative-invocation.v3' or any(invocation.get(key) != value for key, value in expected.items()) or invocation.get('root_grant_ref') != context['root_grant_ref']:\\\\n+            raise ValueError('OPEN_NEGATIVE_INVOCATION_IDENTITY')\\\\n+        if invocation.get('scope_ref') not in scope_refs:\\\\n+            raise ValueError('OPEN_NEGATIVE_SCOPE_NOT_ROOT_ISSUED')\\\\n+        scope, _ = _original(doc, raw, invocation['scope_ref'])\\\\n+        if scope.get('schema') != 'researchos.w05.a04-negative-scope.v3' or any(scope.get(key) != value for key, value in expected.items()) or scope.get('root_grant_ref') != context['root_grant_ref'] or invocation.get('scope') != scope:\\\\n+            raise ValueError('OPEN_NEGATIVE_SCOPE_IDENTITY')\\\\n+        for key in ('argv', 'cwd', 'env_names', 'initial_tool_input', 'producer_ref'):\\\\n+            if key not in scope or invocation.get(key) != scope[key]:\\\\n+                raise ValueError('OPEN_NEGATIVE_SCOPE_ABI')\\\\n+        _nonempty(invocation['argv'], 'negative argv', list)\\\\n+        _nonempty(invocation['cwd'], 'negative cwd')\\\\n+        if invocation['cwd'] != context['worktree'] or type(invocation['env_names']) is not list or any(type(v) is not str or not v for v in invocation['env_names']):\\\\n+            raise ValueError('OPEN_NEGATIVE_CURRENT_WORKTREE')\\\\n+        _native_exit(invocation.get('native_exit'), 'refusal native exit')\\\\n+        pair, _ = _original(doc, raw, invocation['root_tool_pair_ref'])\\\\n+        closed = _root_pair(pair, scope)\\\\n+        if closed['actual_launcher_native_exit'] != invocation['native_exit'] or invocation['native_exit'] == 0:\\\\n+            raise ValueError('OPEN_REFUSAL_ACTUAL_NONZERO')\\\\n+        response, _ = _original(doc, raw, refusal['original_response_ref'])\\\\n+        if response.get('schema') != 'researchos.w05.original-negative-response.v3' or any(response.get(key) != value for key, value in expected.items()) or response.get('scope_ref') != invocation['scope_ref'] or response.get('status') not in ('REJECTED', 'BLOCKED', 'DENIED'):\\\\n+            raise ValueError('OPEN_ORIGINAL_REFUSAL_RESPONSE')\\\\n+        # These fields must occur in the Root-observed terminal stdout itself.\\\\n+        # The response/scope precede the pair and invocation; no backward hash cycle.\\\\n+        if closed.get('negative_identity') != expected or closed.get('negative_scope_ref') != invocation['scope_ref'] or closed.get('actual_refusal_response') != response:\\\\n+            raise ValueError('OPEN_REFUSAL_NOT_FROM_ORIGINAL_TERMINAL')\\\\n+\\\\n*** End Patch\\\",\\n      \\\"result\\\": {}\\n    },\\n    {\\n      \\\"operation\\\": \\\"build_patch\\\",\\n      \\\"input\\\": \\\"*** Begin Patch\\\\n*** Add File: D:/作品集/ResearchOS/research-os/execution/v2.4/receipts/W05/W05-99/a04_formal_profile_source_binding_revision_codex/c97e11df194d431cb901934bf01e6c94/build_source_revision.py\\\\n+from pathlib import Path\\\\n+import ast, difflib, hashlib, json\\\\n+\\\\n+ROOT = Path('D:/作品集/ResearchOS/research-os')\\\\n+OUT = Path(__file__).parent\\\\n+BASE = ROOT/'execution/v2.4/receipts/W05/W05-99/a04_formal_profile_source_revision_codex/02b58e39e08c457a8c48d10ce764fb94'\\\\n+REVIEW = ROOT/'execution/v2.4/receipts/W05/W05-99/a04_formal_profile_revision_independent_review_codex/be0d42806fa145ee896d6da1a9379a33/review.json'\\\\n+\\\\n+def pin(p):\\\\n+    b=p.read_bytes()\\\\n+    return {'path':p.as_posix(),'sha256':hashlib.sha256(b).hexdigest(),'bytes':len(b)}\\\\n+\\\\n+def write(name,value):\\\\n+    with (OUT/name).open('xb') as f:\\\\n+        f.write(json.dumps(value,ensure_ascii=False,indent=2).encode('utf-8')+b'\\\\\\\\n')\\\\n+    return pin(OUT/name)\\\\n+\\\\n+def check(ref):\\\\n+    p=Path(ref['path'])\\\\n+    if not p.is_absolute():p=ROOT/p\\\\n+    got=pin(p)\\\\n+    assert got['sha256']==ref['sha256'] and got['bytes']==ref['bytes'], ref['path']\\\\n+    return got\\\\n+\\\\n+review_raw=REVIEW.read_bytes()\\\\n+assert hashlib.sha256(review_raw).hexdigest()=='086b9a327a4d1ce0aaa2df71fbd03b9a88c5b64e546ae716b3172b33f7122b05' and len(review_raw)==12652\\\\n+review=json.loads(review_raw)\\\\n+hdf=json.loads((BASE/'handoff.json').read_bytes())\\\\n+assert pin(BASE/'handoff.json')['sha256']=='c81528f0d2cfba839fd6ef4036a9d04c2cf89976b0688effe50a372568e10e01'\\\\n+mf=json.loads((BASE/'manifest.json').read_bytes())\\\\n+assert pin(BASE/'manifest.json')['sha256']=='7a62badae4bcee8d0b0c56d47bc43aa429bc68faa927dcccac4e9a6c28d9f777'\\\\n+members=[check(ref) for ref in mf['members']]\\\\n+selected={target:check(ref) for target,ref in hdf['source_pins'].items()}\\\\n+assert selected==review['selected_source_refs']\\\\n+for p in [REVIEW,BASE/'handoff.json',BASE/'manifest.json']:\\\\n+    with (OUT/('basis.'+p.parent.name[:8]+'.'+p.name)).open('xb') as f:f.write(p.read_bytes())\\\\n+\\\\n+schema_paths={'domain':'internal/api/contracts/domain.schema.json','client':'internal/domain/contracts/client.protocol.schema.json','persistence':'internal/domain/contracts/persistence-v24.schema.json'}\\\\n+docs={name:json.loads((ROOT/rel).read_bytes()) for name,rel in schema_paths.items()}\\\\n+roots=[('domain','Task'),('domain','Run'),('domain','Artifact'),('client','SessionEvent'),('persistence','Task')]\\\\n+pending=roots[:];seen=set()\\\\n+allowed={'type','$ref','anyOf','allOf','if','then','else','const','enum','required','additionalProperties','properties','items','minItems','maxItems','minLength','maxLength','minimum','pattern','format'}\\\\n+annotations={'description','title','$comment','default','examples','readOnly','writeOnly','deprecated'}\\\\n+def project(node,group):\\\\n+    if type(node) is list:return [project(x,group) for x in node]\\\\n+    if type(node) is not dict:return node\\\\n+    assert set(node)<=allowed|annotations, set(node)-(allowed|annotations)\\\\n+    out={}\\\\n+    for key,value in node.items():\\\\n+        if key in annotations:continue\\\\n+        if key=='$ref':\\\\n+            filename,name=value.split('#/$defs/')\\\\n+            assert filename in ('','domain.schema.json')\\\\n+            target='domain' if filename else group\\\\n+            pending.append((target,name))\\\\n+            out[key]=target+':'+name\\\\n+        elif key=='properties':\\\\n+            out[key]={k:project(v,group) for k,v in value.items()}\\\\n+        else:out[key]=project(value,group)\\\\n+    if 'type' in out:assert out['type'] in ('object','array','string','integer','boolean','null')\\\\n+    if 'format' in out:assert out['format']=='date-time'\\\\n+    if 'additionalProperties' in out:assert type(out['additionalProperties']) is bool\\\\n+    return out\\\\n+schemas={name:{} for name in docs}\\\\n+while pending:\\\\n+    key=pending.pop()\\\\n+    if key in seen:continue\\\\n+    seen.add(key);schemas[key[0]][key[1]]=project(docs[key[0]]['$defs'][key[1]],key[0])\\\\n+schemas={group:{name:values[name] for name in sorted(values)} for group,values in schemas.items()}\\\\n+public_paths=list(schema_paths.values())+['internal/domain/store.go','internal/domain/client_protocol_events.go','internal/domain/client_protocol_schema.go','internal/domain/contracts.go','internal/domain/contracts_persistence_v24.go','internal/domain/runtime.go']\\\\n+basis=[pin(ROOT/rel) for rel in public_paths]\\\\n+for group,rel in schema_paths.items():\\\\n+    with (OUT/('public.'+group+'.schema.original.json')).open('xb') as f:f.write((ROOT/rel).read_bytes())\\\\n+write('public-schema-projection.actual.json',{'schema':'researchos.a04.closed-public-schema-projection.v1','basis_refs':basis,'roots':roots,'reachable_definitions':sorted(seen),'allowed_assertion_keywords':sorted(allowed),'projection':schemas,'description_annotations_only_removed':True,'external_refs_or_schema_network':False})\\\\n+snips=(OUT/'replacement_functions.source.txt').read_text(encoding='utf-8')\\\\n+helpers=(OUT/'schema_helpers.source.txt').read_text(encoding='utf-8')\\\\n+ast.parse(snips);ast.parse(helpers)\\\\n+replacement={node.name:ast.get_source_segment(snips,node) for node in ast.parse(snips).body if isinstance(node,ast.FunctionDef)}\\\\n+old=Path(selected['execution/v2.4/formal_profile_w05.py']['path']).read_text(encoding='utf-8')\\\\n+lines=old.splitlines(keepends=True)\\\\n+tree=ast.parse(old)\\\\n+for node in sorted([n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name in replacement],key=lambda n:n.lineno,reverse=True):\\\\n+    lines[node.lineno-1:node.end_lineno]=[replacement[node.name]+'\\\\\\\\n']\\\\n+new=''.join(lines)+'\\\\\\\\n\\\\\\\\n# Exact public schema assertion closure; SOURCE data, not dynamically loaded code.\\\\\\\\nPUBLIC_SCHEMAS = '+repr(schemas)+'\\\\\\\\n\\\\\\\\n'+helpers\\\\n+ast.parse(new)\\\\n+p=OUT/'formal_profile_w05.binding.v3.proposed.py'\\\\n+with p.open('xb') as f:f.write(new.encode('utf-8'))\\\\n+new_profile=pin(p)\\\\n+runtime_target='ops/ci/runtime_w05_live.py'\\\\n+old_runtime=Path(selected[runtime_target]['path']).read_bytes()\\\\n+old_sha=selected['execution/v2.4/formal_profile_w05.py']['sha256'].encode()\\\\n+assert old_runtime.count(old_sha)==2\\\\n+new_runtime=old_runtime.replace(old_sha,new_profile['sha256'].encode())\\\\n+ast.parse(new_runtime)\\\\n+names={runtime_target:'runtime_w05_live.binding.v3.proposed.py',\\\\n+       'ops/ci/export_a04_live.py':'export_a04_live.binding.v3.proposed.py',\\\\n+       'execution/v2.4/formal_case_index.py':'formal_case_index.w05.binding.v3.proposed.py',\\\\n+       'ops/ci/runtime.py':'runtime.w05.route.binding.v3.proposed.py'}\\\\n+source_pins={'execution/v2.4/formal_profile_w05.py':new_profile}\\\\n+inverses=[]\\\\n+for target,name in names.items():\\\\n+    original=Path(selected[target]['path']).read_bytes()\\\\n+    updated=new_runtime if target==runtime_target else original\\\\n+    with (OUT/name).open('xb') as f:f.write(updated)\\\\n+    source_pins[target]=pin(OUT/name)\\\\n+for target,after in source_pins.items():\\\\n+    before=selected[target];old_text=Path(before['path']).read_text(encoding='utf-8');new_text=Path(after['path']).read_text(encoding='utf-8')\\\\n+    delta=list(difflib.ndiff(old_text.splitlines(keepends=True),new_text.splitlines(keepends=True)))\\\\n+    assert ''.join(difflib.restore(delta,1))==old_text\\\\n+    assert ''.join(difflib.restore(delta,2))==new_text\\\\n+    bt,nt=ast.parse(old_text),ast.parse(new_text)\\\\n+    old_defs={n.name:n for n in bt.body if isinstance(n,(ast.FunctionDef,ast.ClassDef))}\\\\n+    new_defs={n.name:n for n in nt.body if isinstance(n,(ast.FunctionDef,ast.ClassDef))}\\\\n+    unchanged=[];changed=[]\\\\n+    for key,n in old_defs.items():\\\\n+        other=new_defs[key]\\\\n+        is_same=ast.dump(n,include_attributes=False)==ast.dump(other,include_attributes=False) and ast.get_source_segment(old_text,n)==ast.get_source_segment(new_text,other)\\\\n+        (unchanged if is_same else changed).append(key)\\\\n+    if target=='execution/v2.4/formal_profile_w05.py':assert set(changed)==set(replacement)\\\\n+    elif target==runtime_target:assert changed==['verify_bundle']\\\\n+    else:assert not changed and before['sha256']==after['sha256']\\\\n+    inverses.append({'target':target,'before_ref':before,'after_ref':after,'exact_copy':before['sha256']==after['sha256'],'ndiff':delta,'unchanged_definitions':unchanged,'changed_definitions':changed,'new_definitions':sorted(set(new_defs)-set(old_defs)),'whole_forward_inverse_exact':True})\\\\n+write('source.inverse.actual.json',{'schema':'researchos.a04-source-inverse.v1','entries':inverses,'candidate_module_imports':0})\\\\n+write('construction.actual.json',{'schema':'researchos.a04-binding-source-construction.v1','author_id':'codex:/root/f08_whole_scope_review','basis_review_ref':pin(REVIEW),'basis_handoff_ref':pin(BASE/'handoff.json'),'basis_manifest_ref':pin(BASE/'manifest.json'),'all_prior_members_verified':members,'public_source_basis':basis,'source_pins':source_pins,'schema_definition_count':len(seen),'changed_profile_definitions':sorted(replacement),'unchanged_profile_definitions':[x for x in inverses[0]['unchanged_definitions']],'runtime_exact_pin_replacements':2,'exact_copy_count':3,'module_imports':0,'SQL_Go_CLI_model_native_calls':0,'canonical_writes':0,'formal_accepted_delta':0})\\\\n+print(json.dumps({'source_pins':source_pins,'prior_member_count':len(members),'schema_definitions':len(seen),'profile_changed':sorted(replacement),'failure_count':