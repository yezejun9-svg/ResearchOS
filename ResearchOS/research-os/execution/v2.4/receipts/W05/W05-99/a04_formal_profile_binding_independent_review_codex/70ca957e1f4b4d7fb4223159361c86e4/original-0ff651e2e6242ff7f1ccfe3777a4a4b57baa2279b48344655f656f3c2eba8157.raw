urrent) is list:\\\\r\\\\n56:                 api.require(re.fullmatch(r'0|[1-9][0-9]*', token) is not None and\\\\r\\\\n57:                             int(token) < len(current), 'RAW_LOCATOR_MISSING', pointer)\\\\r\\\\n58:                 current = current[int(token)]\\\\r\\\\n59:             else:\\\\r\\\\n60:                 api.require(False, 'RAW_LOCATOR_MISSING', pointer)\\\\r\\\\n61:     else:\\\\r\\\\n62:         api.fields(location, ('line_start', 'line_end'), label='A04 line locator')\\\\r\\\\n63:         lines = content.decode('utf-8').splitlines()\\\\r\\\\n64:         first, last = location['line_start'], location['line_end']\\\\r\\\\n65:         api.require(type(first) is int and type(last) is int and\\\\r\\\\n66:                     1 <= first <= last <= len(lines), 'RAW_LOCATOR_MISSING', value['path'])\\\\r\\\\n67:         current = '\\\\\\\\n'.join(lines[first - 1:last])\\\\r\\\\n68:     api.require(api.meaningful(current), 'RAW_EMPTY', value['path'])\\\\r\\\\n69:     return current\\\\r\\\\n70: \\\\r\\\\n71: \\\\r\\\\n72: def _vector(api, reader, context):\\\\r\\\\n73:     vector = api.fields(context.get('version_vector'),\\\\r\\\\n74:                         ('schema', 'package_version', 'spec_files', 'source_files',\\\\r\\\\n75:                          'input_files', 'lock_files', 'tool_files', 'environment',\\\\r\\\\n76:                          'components'), label='W05 vector')\\\\r\\\\n77:     api.require(vector['schema'] == 'researchos.w05.version-vector.v1' and\\\\r\\\\n78:                 vector['package_version'] == '2.4.0', 'SCHEMA', 'W05 vector')\\\\r\\\\n79:     pinned, paths = {}, set()\\\\r\\\\n80:     for group in ('spec_files', 'source_files', 'input_files', 'lock_files', 'tool_files'):\\\\r\\\\n81:         local = set()\\\\r\\\\n82:         for reference in api.sequence(vector[group], 'W05 ' + group):\\\\r\\\\n83:             path = reader.ref(reference)\\\\r\\\\n84:             api.require(path not in local, 'DUPLICATE_REFERENCE