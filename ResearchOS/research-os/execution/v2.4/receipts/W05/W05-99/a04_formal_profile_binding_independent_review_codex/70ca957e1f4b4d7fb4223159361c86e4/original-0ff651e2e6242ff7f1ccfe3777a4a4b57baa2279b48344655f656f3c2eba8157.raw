\\\\\\\"missing\\\\\\\": \\\\\\\"Real selected SDK parent/child/run/tool events, same cancellation and effective budget identity, fixed model config/ref before+after, security-patch and adapter/version-matrix replay. sdk_jsonl_ref cannot be a boolean summary.\\\\\\\"\\\\n    },\\\\n    {\\\\n      \\\\\\\"id\\\\\\\": \\\\\\\"W05-P01/A04-05\\\\\\\",\\\\n      \\\\\\\"missing\\\\\\\": \\\\\\\"Actual installed researchos binary identity, interactive inputs/stdout transcript, full headless JSONL and read/edit/shell/goal/resume/cancel original actions with native/Job/version identities.\\\\\\\"\\\\n    },\\\\n    {\\\\n      \\\\\\\"id\\\\\\\": \\\\\\\"W05-U02/A04-06\\\\\\\",\\\\n      \\\\\\\"missing\\\\\\\": \\\\\\\"Actual selected delivery.contract ISSUE-CONTINUITY-001 journey, Chinese input and handler/action receipts; original before/after file bytes, real test command/Job/exit, fixed model and task-specific cancel settlement.\\\\\\\"\\\\n    },\\\\n    {\\\\n      \\\\\\\"id\\\\\\\": \\\\\\\"ROOT_CAPTURE_AND_ISSUANCE\\\\\\\",\\\\n      \\\\\\\"missing\\\\\\\": \\\\\\\"A new Root-owned finite LIVE producer, fixed original observation contracts, current-source/runtime/resource/grant qualification and actual non-author review/delivery observations. All new schema names/fields here are proposals, not adopted Root authority.\\\\\\\"\\\\n    }\\\\n  ],\\\\n  \\\\\\\"r3_full_implementation_complete\\\\\\\": false,\\\\n  \\\\\\\"current_dispatcher_can_qualify_a04\\\\\\\": false,\\\\n  \\\\\\\"main_adopted\\\\\\\": false,\\\\n  \\\\\\\"actual_root_authority\\\\\\\": null,\\\\n  \\\\\\\"root_grant_approved\\\\\\\": false,\\\\n  \\\\\\\"full_candidate_entrypoints_executed\\\\\\\": 0,\\\\n  \\\\\\\"sql_native_model_calls\\\\\\\": 0,\\\\n  \\\\\\\"new_tool_failure_origin_refs\\\\\\\": [],\\\\n  \\\\\\\"new_tool_failure_count\\\\\\\": 0,\\\\n  \\\\\\\"canonical_writes\\\\\\\": 0,\\\\n  \\\\\\\"source_acceptance\\\\\\\": false,\\\\n  \\\\\\\"formal_case_accepted_delta\\\\\\\": 0,\\\\n  \\\\\\\"postseal_original_io_annex\\\\\\\": \\\\\\\"postseal-tool-observations.original.json; external to MF, no circular self-hash.\\\\\\\"\\\\n}\\\\n\\\\r\\\\n\\\"\\n      }\\n    },\\n    {\\n      \\\"operation\\\": \\\"public\\\",\\n      \\\"input\\\": {\\n        \\\"cmd\\\": \\\"@'\\\\nfrom pathlib import Path\\\\nimport json,hashlib,ast\\\\nroot=Path('D:/作品集/ResearchOS/research-os')\\\\npaths=['internal/domain/client_protocol_events.go','internal/domain/store.go','internal/domain/contracts/client.protocol.schema.json','internal/domain/contracts/client.protocol.domain.schema.json']\\\\nfor rel in paths:\\\\n p=root/rel;b=p.read_bytes();print(json.dumps({'path':str(p),'sha256':hashlib.sha256(b).hexdigest(),'bytes':len(b)},ensure_ascii=False))\\\\n if p.suffix=='.go':\\\\n  lines=b.decode('utf-8').splitlines();lo,hi=(1,210) if 'events' in rel else (205,245)\\\\n  for i in range(lo-1,min(hi,len(lines))):print(str(i+1)+': '+lines[i])\\\\n else:\\\\n  d=json.loads(b);print(json.dumps({'keys':list(d),'defs':list(d.get('$defs',{}))},ensure_ascii=False))\\\\nbase=root/'execution/v2.4/receipts/W05/W05-99/a04_formal_profile_source_revision_codex/02b58e39e08c457a8c48d10ce764fb94'\\\\ns=(base/'formal_profile_w05.final.proposed.py').read_text(encoding='utf-8');t=ast.parse(s);ls=s.splitlines()\\\\nfor n in t.body:\\\\n if isinstance(n,ast.FunctionDef) and n.name in ['_database','_jsonl','verify_refusal','verify_live_originals']:\\\\n  print('FUNCTION '+n.name)\\\\n  for i in range(n.lineno-1,n.end_lineno):print(str(i+1)+': '+ls[i])\\\\n'@ | & 'C:/Users/yqyyds/AppData/Local/Python/pythoncore-3.14-64/python.exe' -I -S -X utf8 -\\\\n$metadataExit=$LASTEXITCODE\\\\nWrite-Output \\\\\\\"ACTUAL_PYTHON_EXIT=$metadataExit\\\\\\\"\\\\nexit $metadataExit\\\",\\n        \\\"max_output_tokens\\\": 16000\\n      },\\n      \\\"result\\\": {\\n        \\\"chunk_id\\\": \\\"582bcd\\\",\\n        \\\"wall_time_seconds\\\": 0.7220464,\\n        \\\"exit_code\\\": 0,\\n        \\\"original_token_count\\\": 6392,\\n        \\\"output\\\": \\\"{\\\\\\\"path\\\\\\\": \\\\\\\"D:\\\\\\\\\\\\\\\\作品集\\\\\\\\\\\\\\\\ResearchOS\\\\\\\\\\\\\\\\research-os\\\\\\\\\\\\\\\\internal\\\\\\\\\\\\\\\\domain\\\\\\\\\\\\\\\\client_protocol_events.go\\\\\\\", \\\\\\\"sha256\\\\\\\": \\\\\\\"5c950d80ef6a5b36e2fab8bf5f9e5bde8d90e561ae4585b9d1ac1dd0a7b62a5d\\\\\\\", \\\\\\\"bytes\\\\\\\": 6249}\\\\r\\\\n1: package domain\\\\r\\\\n2: \\\\r\\\\n3: // Typed session events for researchos-client/2 (W03-02) and validation of the\\\\r\\\\n4: // transient native bridge messages (never journaled; rejection as CommandEnvelope\\\\r\\\\n5: // is covered by DecodeEnvelope's method registry).\\\\r\\\\n6: //\\\\r\\\\n7: // The field set is exactly the published SessionEvent schema: ten required keys,\\\\r\\\\n8: // no extras, with run_id/command_id/domain_event_id required-but-nullable.\\\\r\\\\n9: \\\\r\\\\n10: import (\\\\r\\\\n11: \\\\t\\\\\\\"encoding/json\\\\\\\"\\\\r\\\\n12: \\\\t\\\\\\\"errors\\\\\\\"\\\\r\\\\n13: \\\\t\\\\\\\"fmt\\\\\\\"\\\\r\\\\n14: \\\\t\\\\\\\"strings\\\\\\\"\\\\r\\\\n15: )\\\\r\\\\n16: \\\\r\\\\n17: var eventKinds = map[string]bool{\\\\r\\\\n18: \\\\t\\\\\\\"MESSAGE\\\\\\\": true, \\\\\\\"TOOL_STARTED\\\\\\\": true, \\\\\\\"TOOL_RESULT\\\\\\\": true, \\\\\\\"JUDGE_DECISION\\\\\\\": true,\\\\r\\\\n19: \\\\t\\\\\\\"RUN_STATE\\\\\\\": true, \\\\\\\"GOAL_STATE\\\\\\\": true, \\\\\\\"ARTIFACT\\\\\\\": true, \\\\\\\"USAGE\\\\\\\": true, \\\\\\\"CHECKPOINT\\\\\\\": true,\\\\r\\\\n20: \\\\t\\\\\\\"CLIENT_HANDOFF\\\\\\\": true, \\\\\\\"BOOTSTRAP_STATE\\\\\\\": true, \\\\\\\"PERMISSION_REQUIRED\\\\\\\": true,\\\\r\\\\n21: \\\\t\\\\\\\"PERMISSION_RESOLVED\\\\\\\": true, \\\\\\\"ERROR\\\\\\\": true,\\\\r\\\\n22: }\\\\r\\\\n23: \\\\r\\\\n24: // eventFields is the schema's SessionEvent property set (additionalProperties:false).\\\\r\\\\n25: var eventFields = map[string]bool{\\\\r\\\\n26: \\\\t\\\\\\\"event_id\\\\\\\": true, \\\\\\\"session_id\\\\\\\": true, \\\\\\\"sequence\\\\\\\": true, \\\\\\\"core_build_id\\\\\\\": true,\\\\r\\\\n27: \\\\t\\\\\\\"protocol_version\\\\\\\": true, \\\\\\\"run_id\\\\\\\": true, \\\\\\\"command_id\\\\\\\": true, \\\\\\\"domain_event_id\\\\\\\": true,\\\\r\\\\n28: \\\\t\\\\\\\"kind\\\\\\\": true, \\\\\\\"payload\\\\\\\": true,\\\\r\\\\n29: }\\\\r\\\\n30: \\\\r\\\\n31: type SessionEvent struct {\\\\r\\\\n32: \\\\tEventID         *string         `json:\\\\\\\"event_id\\\\\\\"`\\\\r\\\\n33: \\\\tSessionID       *string         `json:\\\\\\\"session_id\\\\\\\"`\\\\r\\\\n34: \\\\tSequence        *int64          `json:\\\\\\\"sequence\\\\\\\"`\\\\r\\\\n35: \\\\tCoreBuildID     *string         `json:\\\\\\\"core_build_id\\\\\\\"`\\\\r\\\\n36: \\\\tProtocolVersion *string         `json:\\\\\\\"protocol_version\\\\\\\"`\\\\r\\\\n37: \\\\tRunID           *string         `json:\\\\\\\"run_id\\\\\\\"`\\\\r\\\\n38: \\\\tCommandID       *string         `json:\\\\\\\"command_id\\\\\\\"`\\\\r\\\\n39: \\\\tDomainEventID   *string         `json:\\\\\\\"domain_event_id\\\\\\\"`\\\\r\\\\n40: \\\\tKind            *string         `json:\\\\\\\"kind\\\\\\\"`\\\\r\\\\n41: \\\\tPayload         json.RawMessage `json:\\\\\\\"payload\\\\\\\"`\\\\r\\\\n42: }\\\\r\\\\n43: \\\\r\\\\n44: var (\\\\r\\\\n45: \\\\tErrEventSequence  = errors.New(\\\\\\\"EVENT_SEQUENCE_OUT_OF_ORDER\\\\\\\")\\\\r\\\\n46: \\\\tErrResyncRequired = errors.New(\\\\\\\"SNAPSHOT_RESYNC_REQUIRED\\\\\\\")\\\\r\\\\n47: \\\\tErrSensitiveField = errors.New(\\\\\\\"SENSITIVE_FIELD_IN_EVENT_PAYLOAD\\\\\\\")\\\\r\\\\n48: )\\\\r\\\\n49: \\\\r\\\\n50: // DecodeEvent rejects bare shapes, unknown kinds, missing required keys, and any\\\\r\\\\n51: // field the published schema does not declare. Per-kind payload typing is done by\\\\r\\\\n52: // ValidateEventPayload against the schema document so the two cannot drift.\\\\r\\\\n53: func DecodeEvent(raw []byte) (*SessionEvent, error) {\\\\r\\\\n54: \\\\tvar probe map[string]json.RawMessage\\\\r\\\\n55: \\\\tdec := json.NewDecoder(strings.NewReader(string(raw)))\\\\r\\\\n56: \\\\tdec.DisallowUnknownFields()\\\\r\\\\n57: \\\\tif err := dec.Decode(&probe); err != nil {\\\\r\\\\n58: \\\\t\\\\treturn nil, fmt.Errorf(\\\\\\\"%w: %v\\\\\\\", ErrBareObject, err)\\\\r\\\\n59: \\\\t}\\\\r\\\\n60: \\\\tfor k := range probe {\\\\r\\\\n61: \\\\t\\\\tif !eventFields[k] {\\\\r\\\\n62: \\\\t\\\\t\\\\treturn nil, fmt.Errorf(\\\\\\\"UNKNOWN_FIELD:%s\\\\\\\", k)\\\\r\\\\n63: \\\\t\\\\t}\\\\r\\\\n64: \\\\t}\\\\r\\\\n65: \\\\tfor _, req := range []string{\\\\\\\"event_id\\\\\\\", \\\\\\\"session_id\\\\\\\", \\\\\\\"sequence\\\\\\\", \\\\\\\"core_build_id\\\\\\\",\\\\r\\\\n66: \\\\t\\\\t\\\\\\\"protocol_version\\\\\\\", \\\\\\\"run_id\\\\\\\", \\\\\\\"command_id\\\\\\\", \\\\\\\"domain_event_id\\\\\\\", \\\\\\\"kind\\\\\\\", \\\\\\\"payload\\\\\\\"} {\\\\r\\\\n67: \\\\t\\\\tif _, has := probe[req]; !has {\\\\r\\\\n68: \\\\t\\\\t\\\\treturn nil, fmt.Errorf(\\\\\\\"MISSING_FIELD:%s\\\\\\\", req)\\\\r\\\\n69: \\\\t\\\\t}\\\\r\\\\n70: \\\\t}\\\\r\\\\n71: \\\\tvar ev SessionEvent\\\\r\\\\n72: \\\\tif err := json.Unmarshal(raw, &ev); err != nil {\\\\r\\\\n73: \\\\t\\\\treturn nil, err\\\\r\\\\n74: \\\\t}\\\\r\\\\n75: \\\\tif ev.ProtocolVersion == nil || *ev.ProtocolVersion != ProtocolV2 {\\\\r\\\\n76: \\\\t\\\\treturn nil, ErrProtocolVersion\\\\r\\\\n77: \\\\t}\\\\r\\\\n78: \\\\tfor name, v := range map[string]*string{\\\\\\\"event_id\\\\\\\": ev.EventID, \\\\\\\"session_id\\\\\\\": ev.SessionID, \\\\\\\"core_build_id\\\\\\\": ev.CoreBuildID, \\\\\\\"kind\\\\\\\": ev.Kind} {\\\\r\\\\n79: \\\\t\\\\tif err := requiredString(name, v); err != nil {\\\\r\\\\n80: \\\\t\\\\t\\\\treturn nil, err\\\\r\\\\n81: \\\\t\\\\t}\\\\r\\\\n82: \\\\t}\\\\r\\\\n83: \\\\tfor name, v := range map[string]*string{\\\\\\\"run_id\\\\\\\": ev.RunID, \\\\\\\"command_id\\\\\\\": ev.CommandID, \\\\\\\"domain_event_id\\\\\\\": ev.DomainEventID} {\\\\r\\\\n84: \\\\t\\\\tif v != nil && *v == \\\\\\\"\\\\\\\" {\\\\r\\\\n85: \\\\t\\\\t\\\\treturn nil, fmt.Errorf(\\\\\\\"EMPTY_STRING:%s\\\\\\\", name)\\\\r\\\\n86: \\\\t\\\\t}\\\\r\\\\n87: \\\\t}\\\\r\\\\n88: \\\\tif ev.Sequence == nil || *ev.Sequence < 0 {\\\\r\\\\n89: \\\\t\\\\treturn nil, fmt.Errorf(\\\\\\\"BAD_SEQUENCE\\\\\\\")\\\\r\\\\n90: \\\\t}\\\\r\\\\n91: \\\\tif !eventKinds[*ev.Kind] {\\\\r\\\\n92: \\\\t\\\\treturn nil, fmt.Errorf(\\\\\\\"UNKNOWN_EVENT_KIND:%s\\\\\\\", *ev.Kind)\\\\r\\\\n93: \\\\t}\\\\r\\\\n94: \\\\tif len(ev.Payload) == 0 || !json.Valid(ev.Payload) {\\\\r\\\\n95: \\\\t\\\\treturn nil, fmt.Errorf(\\\\\\\"BAD_EVENT_PAYLOAD\\\\\\\")\\\\r\\\\n96: \\\\t}\\\\r\\\\n97: \\\\treturn &ev, nil\\\\r\\\\n98: }\\\\r\\\\n99: \\\\r\\\\n100: // ValidateEventPayload checks the payload against the schema def published for the\\\\r\\\\n101: // event kind, in read direction: writeOnly-annotated fields (credential material)\\\\r\\\\n102: // can never appear in a durable event, and the value-shape rules (stream phase,\\\\r\\\\n103: // cost_known/money coupling, cancel settlement) come from the schema itself.\\\\r\\\\n104: // The only extra rule here is the sensitive-key red list, which no JSON Schema\\\\r\\\\n105: // keyword in the pinned document expresses.\\\\r\\\\n106: func ValidateEventPayload(doc *SchemaDoc, ev *SessionEvent) error {\\\\r\\\\n107: \\\\tvar p any\\\\r\\\\n108: \\\\tif err := json.Unmarshal(ev.Payload, &p); err != nil {\\\\r\\\\n109: \\\\t\\\\treturn fmt.Errorf(\\\\\\\"PAYLOAD_NOT_OBJECT:%v\\\\\\\", err)\\\\r\\\\n110: \\\\t}\\\\r\\\\n111: \\\\tobj, ok := p.(map[string]any)\\\\r\\\\n112: \\\\tif !ok || obj == nil {\\\\r\\\\n113: \\\\t\\\\treturn fmt.Errorf(\\\\\\\"PAYLOAD_NOT_OBJECT\\\\\\\")\\\\r\\\\n114: \\\\t}\\\\r\\\\n115: \\\\tif k, bad := firstSensitiveKey(obj); bad {\\\\r\\\\n116: \\\\t\\\\treturn fmt.Errorf(\\\\\\\"%w:%s\\\\\\\", ErrSensitiveField, k)\\\\r\\\\n117: \\\\t}\\\\r\\\\n118: \\\\tif doc != nil {\\\\r\\\\n119: \\\\t\\\\tdef, err := doc.EventPayloadDef(*ev.Kind)\\\\r\\\\n120: \\\\t\\\\tif err != nil {\\\\r\\\\n121: \\\\t\\\\t\\\\treturn err\\\\r\\\\n122: \\\\t\\\\t}\\\\r\\\\n123: \\\\t\\\\tif err := doc.ValidateDef(def, p); err != nil {\\\\r\\\\n124: \\\\t\\\\t\\\\treturn fmt.Errorf(\\\\\\\"EVENT_PAYLOAD_SCHEMA:%v\\\\\\\", err)\\\\r\\\\n125: \\\\t\\\\t}\\\\r\\\\n126: \\\\t}\\\\r\\\\n127: \\\\treturn nil\\\\r\\\\n128: }\\\\r\\\\n129: \\\\r\\\\n130: // sensitiveKeyPatterns are matched case-insensitively against every payload key that\\\\r\\\\n131: // actually carries a value; credentials belong to the native transient import path.\\\\r\\\\n132: var sensitiveKeyPatterns = []string{\\\\\\\"credential_value\\\\\\\", \\\\\\\"api_key\\\\\\\", \\\\\\\"apikey\\\\\\\", \\\\\\\"secret\\\\\\\", \\\\\\\"token_value\\\\\\\", \\\\\\\"password\\\\\\\", \\\\\\\"authorization\\\\\\\"}\\\\r\\\\n133: \\\\r\\\\n134: func firstSensitiveKey(node any) (string, bool) {\\\\r\\\\n135: \\\\tswitch tv := node.(type) {\\\\r\\\\n136: \\\\tcase map[string]any:\\\\r\\\\n137: \\\\t\\\\tfor _, k := range sortedKeys(tv) {\\\\r\\\\n138: \\\\t\\\\t\\\\tfor _, pat := range sensitiveKeyPatterns {\\\\r\\\\n139: \\\\t\\\\t\\\\t\\\\tif strings.EqualFold(k, pat) || strings.Contains(strings.ToLower(k), pat) {\\\\r\\\\n140: \\\\t\\\\t\\\\t\\\\t\\\\treturn k, true\\\\r\\\\n141: \\\\t\\\\t\\\\t\\\\t}\\\\r\\\\n142: \\\\t\\\\t\\\\t}\\\\r\\\\n143: \\\\t\\\\t\\\\tif k, bad := firstSensitiveKey(tv[k]); bad {\\\\r\\\\n144: \\\\t\\\\t\\\\t\\\\treturn k, bad\\\\r\\\\n145: \\\\t\\\\t\\\\t}\\\\r\\\\n146: \\\\t\\\\t}\\\\r\\\\n147: \\\\tcase []any:\\\\r\\\\n148: \\\\t\\\\tfor _, x := range tv {\\\\r\\\\n149: \\\\t\\\\t\\\\tif k, bad := firstSensitiveKey(x); bad {\\\\r\\\\n150: \\\\t\\\\t\\\\t\\\\treturn k, bad\\\\r\\\\n151: \\\\t\\\\t\\\\t}\\\\r\\\\n152: \\\\t\\\\t}\\\\r\\\\n153: \\\\t}\\\\r\\\\n154: \\\\treturn \\\\\\\"\\\\\\\", false\\\\r\\\\n155: }\\\\r\\\\n156: \\\\r\\\\n157: // ValidateNativeTransient grades the four transient OS-bridge message shapes against the\\\\r\\\\n158: // published defs. They are never durable commands and never written to journals or events:\\\\r\\\\n159: // a request direction may carry credential material, a result direction may not.\\\\r\\\\n160: func ValidateNativeTransient(doc *SchemaDoc, def string, raw []byte, writeDirection bool) error {\\\\r\\\\n161: \\\\tif !strings.HasPrefix(def, \\\\\\\"Native\\\\\\\") {\\\\r\\\\n162: \\\\t\\\\treturn fmt.Errorf(\\\\\\\"UNKNOWN_NATIVE_DEFINITION:%s\\\\\\\", def)\\\\r\\\\n163: \\\\t}\\\\r\\\\n164: \\\\tif doc == nil {\\\\r\\\\n165: \\\\t\\\\treturn fmt.Errorf(\\\\\\\"SCHEMA_REQUIRED\\\\\\\")\\\\r\\\\n166: \\\\t}\\\\r\\\\n167: \\\\tvar v any\\\\r\\\\n168: \\\\tif err := json.Unmarshal(raw, &v); err != nil {\\\\r\\\\n169: \\\\t\\\\treturn err\\\\r\\\\n170: \\\\t}\\\\r\\\\n171: \\\\tif writeDirection {\\\\r\\\\n172: \\\\t\\\\treturn doc.ValidateDefInput(def, v)\\\\r\\\\n173: \\\\t}\\\\r\\\\n174: \\\\treturn doc.ValidateDef(def, v)\\\\r\\\\n175: }\\\\r\\\\n{\\\\\\\"path\\\\\\\": \\\\\\\"D:\\\\\\\\\\\\\\\\作品集\\\\\\\\\\\\\\\\ResearchOS\\\\\\\\\\\\\\\\research-os\\\\\\\\\\\\\\\\internal\\\\\\\\\\\\\\\\domain\\\\\\\\\\\\\\\\store.go\\\\\\\", \\\\\\\"sha256\\\\\\\": \\\\\\\"fa22f121b7f99f11094c1c68cbd961f146d3aee0ce73a356b5fce84216799a2c\\\\\\\", \\\\\\\"bytes\\\\\\\": 16266}\\\\r\\\\n205: \\\\t\\\\toldRevision, e := Num(old, \\\\\\\"revision\\\\\\\")\\\\r\\\\n206: \\\\t\\\\tif e != nil {\\\\r\\\\n207: \\\\t\\\\t\\\\treturn e\\\\r\\\\n208: \\\\t\\\\t}\\\\r\\\\n209: \\\\t\\\\tif oldRevision == 1<<63-1 || rev != oldRevision+1 {\\\\r\\\\n210: \\\\t\\\\t\\\\treturn Fail(409, \\\\\\\"STATE_CONFLICT\\\\\\\", \\\\\\\"revision must advance once\\\\\\\")\\\\r\\\\n211: \\\\t\\\\t}\\\\r\\\\n212: \\\\t\\\\tif kind == \\\\\\\"Task\\\\\\\" && !taskTransition(old, o) {\\\\r\\\\n213: \\\\t\\\\t\\\\treturn Fail(409, \\\\\\\"STATE_CONFLICT\\\\\\\", \\\\\\\"transition requires lifecycle owner\\\\\\\")\\\\r\\\\n214: \\\\t\\\\t}\\\\r\\\\n215: \\\\t} else if f, ok := e.(*Fault); !ok || f.Status != 404 {\\\\r\\\\n216: \\\\t\\\\treturn e\\\\r\\\\n217: \\\\t}\\\\r\\\\n218: \\\\tif e = s.invariants(kind, o); e != nil {\\\\r\\\\n219: \\\\t\\\\treturn e\\\\r\\\\n220: \\\\t}\\\\r\\\\n221: \\\\tvar hash any\\\\r\\\\n222: \\\\timmutable := 0\\\\r\\\\n223: \\\\tif h, ok := o[\\\\\\\"receipt_hash\\\\\\\"]; ok {\\\\r\\\\n224: \\\\t\\\\tif h != Receipt(o) {\\\\r\\\\n225: \\\\t\\\\t\\\\treturn Fail(422, \\\\\\\"CONTENT_HASH_MISMATCH\\\\\\\", \\\\\\\"receipt hash mismatch\\\\\\\")\\\\r\\\\n226: \\\\t\\\\t}\\\\r\\\\n227: \\\\t\\\\thash = h\\\\r\\\\n228: \\\\t\\\\timmutable = 1\\\\r\\\\n229: \\\\t} else if kind == \\\\\\\"Artifact\\\\\\\" {\\\\r\\\\n230: \\\\t\\\\thash = o[\\\\\\\"content_hash\\\\\\\"]\\\\r\\\\n231: \\\\t}\\\\r\\\\n232: \\\\tif _, e = tx.Exec(\\\\\\\"INSERT INTO domain_versions(project,kind,id,revision,body,content_hash) VALUES(?,?,?,?,?,?)\\\\\\\", project, kind, id, rev, string(Bytes(o)), hash); e != nil {\\\\r\\\\n233: \\\\t\\\\treturn e\\\\r\\\\n234: \\\\t}\\\\r\\\\n235: \\\\tif _, e = tx.Exec(\\\\\\\"INSERT INTO domain_objects(project,kind,id,revision,body,content_hash,immutable) VALUES(?,?,?,?,?,?,?) ON CONFLICT(project,kind,id) DO UPDATE SET revision=excluded.revision,body=excluded.body,content_hash=excluded.content_hash\\\\\\\", project, kind, id, rev, string(Bytes(o)), hash, immutable); e != nil {\\\\r\\\\n236: \\\\t\\\\treturn e\\\\r\\\\n237: \\\\t}\\\\r\\\\n238: \\\\treturn s.refs(tx, project, kind, id, rev, \\\\\\\"\\\\\\\", o)\\\\r\\\\n239: }\\\\r\\\\n240: func (s *Service) refs(tx *sql.Tx, project, kind, id string, rev int64, path string, value any) error {\\\\r\\\\n241: \\\\tswitch v := value.(type) {\\\\r\\\\n242: \\\\tcase map[string]any:\\\\r\\\\n243: \\\\t\\\\tif _, ok := v[\\\\\\\"entity_type\\\\\\\"]; ok {\\\\r\\\\n244: \\\\t\\\\t\\\\tif e := s.Contracts.Validate(\\\\\\\"VersionRef\\\\\\\", v); e != nil {\\\\r\\\\n245: \\\\t\\\\t\\\\t\\\\treturn Fail(400, \\\\\\\"INVALID_REQUEST\\\\\\\", \\\\\\\"invalid reference\\\\\\\")\\\\r\\\\n{\\\\\\\"path\\\\\\\": \\\\\\\"D:\\\\\\\\\\\\\\\\作品集\\\\\\\\\\\\\\\\ResearchOS\\\\\\\\\\\\\\\\research-os\\\\\\\\\\\\\\\\internal\\\\\\\\\\\\\\\\domain\\\\\\\\\\\\\\\\contracts\\\\\\\\\\\\\\\\client.protocol.schema.json\\\\\\\", \\\\\\\"sha256\\\\\\\": \\\\\\\"8943fe363bcfda4a2c45231e54c266133ffccc8642c541724d93d2e56d3a9a9b\\\\\\\", \\\\\\\"bytes\\\\\\\": 161794}\\\\r\\\\n{\\\\\\\"keys\\\\\\\": [\\\\\\\"$schema\\\\\\\", \\\\\\\"$id\\\\\\\", \\\\\\\"title\\\\\\\", \\\\\\\"$comment\\\\\\\", \\\\\\\"oneOf\\\\\\\", \\\\\\\"x-method-contracts\\\\\\\", \\\\\\\"x-event-contracts\\\\\\\", \\\\\\\"$defs\\\\\\\"], \\\\\\\"defs\\\\\\\": [\\\\\\\"SendMessagePayload\\\\\\\", \\\\\\\"ControlPayload\\\\\\\", \\\\\\\"ReuseDecisionPayload\\\\\\\", \\\\\\\"EmptyPayload\\\\\\\", \\\\\\\"ConfigurePayload\\\\\\\", \\\\\\\"BootstrapPayload\\\\\\\", \\\\\\\"ListSessionsPayload\\\\\\\", \\\\\\\"CreateSessionPayload\\\\\\\", \\\\\\\"AttachPayload\\\\\\\", \\\\\\\"ReadEventsPayload\\\\\\\", \\\\\\\"HandoffPayload\\\\\\\", \\\\\\\"StartGoalPayload\\\\\\\", \\\\\\\"LocalInventoryPayload\\\\\\\", \\\\\\\"Id\\\\\\\", \\\\\\\"Digest\\\\\\\", \\\\\\\"UtcTime\\\\\\\", \\\\\\\"RelativePath\\\\\\\", \\\\\\\"ArtifactRef\\\\\\\", \\\\\\\"ResourceRequestRef\\\\\\\", \\\\\\\"WriterLease\\\\\\\", \\\\\\\"MessagePart\\\\\\\", \\\\\\\"MessageRecord\\\\\\\", \\\\\\\"PermissionPrompt\\\\\\\", \\\\\\\"SessionSnapshot\\\\\\\", \\\\\\\"ProtocolError\\\\\\\", \\\\\\\"CredentialSummary\\\\\\\", \\\\\\\"ModelConfiguration\\\\\\\", \\\\\\\"WorkspaceBinding\\\\\\\", \\\\\\\"HostStatusResult\\\\\\\", \\\\\\\"ConfigureResult\\\\\\\", \\\\\\\"BootstrapResult\\\\\\\", \\\\\\\"SessionListResult\\\\\\\", \\\\\\\"AttachResult\\\\\\\", \\\\\\\"SendMessageResult\\\\\\\", \\\\\\\"ControlResult\\\\\\\", \\\\\\\"HandoffResult\\\\\\\", \\\\\\\"StartGoalResult\\\\\\\", \\\\\\\"PendingResult\\\\\\\", \\\\\\\"ListModelsPayload\\\\\\\", \\\\\\\"ModelDescriptor\\\\\\\", \\\\\\\"ListModelsResult\\\\\\\", \\\\\\\"ProbeProviderPayload\\\\\\\", \\\\\\\"ProbeProviderResult\\\\\\\", \\\\\\\"RegisterWorkspacePayload\\\\\\\", \\\\\\\"WorkspaceListResult\\\\\\\", \\\\\\\"WorkspaceTreePayload\\\\\\\", \\\\\\\"WorkspaceEntry\\\\\\\", \\\\\\\"WorkspaceTreeResult\\\\\\\", \\\\\\\"WorkspaceReadPayload\\\\\\\", \\\\\\\"WorkspaceReadResult\\\\\\\", \\\\\\\"WorkspaceDiffPayload\\\\\\\", \\\\\\\"DiffFile\\\\\\\", \\\\\\\"WorkspaceDiffResult\\\\\\\", \\\\\\\"WorkspaceWritePayload\\\\\\\", \\\\\\\"WorkspaceWriteResult\\\\\\\", \\\\\\\"ImportArtifactPayload\\\\\\\", \\\\\\\"ImportArtifactResult\\\\\\\", \\\\\\\"UpdateSessionPayload\\\\\\\", \\\\\\\"RespondPermissionPayload\\\\\\\", \\\\\\\"RespondPermissionResult\\\\\\\", \\\\\\\"MessageEventPayload\\\\\\\", \\\\\\\"ToolStartedEventPayload\\\\\\\", \\\\\\\"ToolResultEventPayload\\\\\\\", \\\\\\\"JudgeEventPayload\\\\\\\", \\\\\\\"RunStateEventPayload\\\\\\\", \\\\\\\"GoalStateEventPayload\\\\\\\", \\\\\\\"ArtifactEventPayload\\\\\\\", \\\\\\\"UsageEventPayload\\\\\\\", \\\\\\\"CheckpointEventPayload\\\\\\\", \\\\\\\"HandoffEventPayload\\\\\\\", \\\\\\\"BootstrapEventPayload\\\\\\\", \\\\\\\"PermissionRequiredEventPayload\\\\\\\", \\\\\\\"PermissionResolvedEventPayload\\\\\\\", \\\\\\\"ErrorEventPayload\\\\\\\", \\\\\\\"SessionEvent\\\\\\\", \\\\\\\"ReadEventsResult\\\\\\\", \\\\\\\"CommandEnvelope\\\\\\\", \\\\\\\"CommandResponse\\\\\\\", \\\\\\\"NativeCredentialImportRequest\\\\\\\", \\\\\\\"NativeCredentialImportResult\\\\\\\", \\\\\\\"NativeWorkspaceChooseRequest\\\\\\\", \\\\\\\"NativeWorkspaceChooseResult\\\\\\\", \\\\\\\"NativeUserBootstrapResult\\\\\\\", \\\\\\\"PermissionActionScope\\\\\\\"]}\\\\r\\\\n{\\\\\\\"path\\\\\\\": \\\\\\\"D:\\\\\\\\\\\\\\\\作品集\\\\\\\\\\\\\\\\ResearchOS\\\\\\\\\\\\\\\\research-os\\\\\\\\\\\\\\\\internal\\\\\\\\\\\\\\\\domain\\\\\\\\\\\\\\\\contracts\\\\\\\\\\\\\\\\client.protocol.domain.schema.json\\\\\\\", \\\\\\\"sha256\\\\\\\": \\\\\\\"b53d9e6eddfeed89d27ee65c378d8067ae8b0c46de2ba2a098856a7557df1c54\\\\\\\", \\\\\\\"bytes\\\\\\\": 204466}\\\\r\\\\n{\\\\\\\"keys\\\\\\\": [\\\\\\\"$schema\\\\\\\", \\\\\\\"$id\\\\\\\", \\\\\\\"title\\\\\\\", \\\\\\\"description\\\\\\\", \\\\\\\"oneOf\\\\\\\", \\\\\\\"$defs\\\\\\\", \\\\\\\"x-core-entities\\\\\\\", \\\\\\\"x-invariants-document\\\\\\\"], \\\\\\\"defs\\\\\\\": [\\\\\\\"Id\\\\\\\", \\\\\\\"Revision\\\\\\\", \\\\\\\"UtcTime\\\\\\\", \\\\\\\"Digest\\\\\\\", \\\\\\\"Decimal\\\\\\\", \\\\\\\"Amount\\\\\\\", \\\\\\\"Currency\\\\\\\", \\\\\\\"Uri\\\\\\\", \\\\\\\"TaskStatus\\\\\\\", \\\\\\\"ResearchCycleStatus\\\\\\\", \\\\\\\"EvidenceKind\\\\\\\", \\\\\\\"Validity\\\\\\\", \\\\\\\"DecisionMode\\\\\\\", \\\\\\\"Stage\\\\\\\", \\\\\\\"Role\\\\\\\", \\\\\\\"MeasurementMode\\\\\\\", \\\\\\\"Money\\\\\\\", \\\\\\\"VersionRef\\\\\\\", \\\\\\\"Fact\\\\\\\", \\\\\\\"SourceConfig\\\\\\\", \\\\\\\"ScopeGrant\\\\\\\", \\\\\\\"CheckSpec\\\\\\\", \\\\\\\"AcceptanceContract\\\\\\\", \\\\\\\"QualificationScope\\\\\\\", \\\\\\\"CheckResult\\\\\\\", \\\\\\\"SourceCoverage\\\\\\\", \\\\\\\"MetricSpec\\\\\\\", \\\\\\\"MetricResult\\\\\\\", \\\\\\\"ModelSignal\\\\\\\", \\\\\\\"StageCount\\\\\\\", \\\\\\\"StopPolicy\\\\\\\", \\\\\\\"ProjectBinding\\\\\\\", \\\\\\\"ProjectProfile\\\\\\\", \\\\\\\"ProjectState\\\\\\\", \\\\\\\"Requirement\\\\\\\", \\\\\\\"Goal\\\\\\\", \\\\\\\"Task\\\\\\\", \\\\\\\"Run\\\\\\\", \\\\\\\"Artifact\\\\\\\", \\\\\\\"Evidence\\\\\\\", \\\\\\\"ResearchCycle\\\\\\\", \\\\\\\"Experiment\\\\\\\", \\\\\\\"DecisionReceipt\\\\\\\", \\\\\\\"Qualification\\\\\\\", \\\\\\\"ContextBundle\\\\\\\", \\\\\\\"ProposedEdit\\\\\\\", \\\\\\\"ChangeProposal\\\\\\\", \\\\\\\"ImpactLink\\\\\\\", \\\\\\\"BudgetPolicy\\\\\\\", \\\\\\\"RunPolicy\\\\\\\", \\\\\\\"ResourceRequest\\\\\\\", \\\\\\\"MilestoneRelease\\\\\\\", \\\\\\\"ProgressProjection\\\\\\\", \\\\\\\"SkillVersion\\\\\\\", \\\\\\\"SystemCandidate\\\\\\\", \\\\\\\"AcceptanceReceipt\\\\\\\", \\\\\\\"AgentMessage\\\\\\\", \\\\\\\"SourceCursor\\\\\\\", \\\\\\\"BudgetLedgerEntry\\\\\\\", \\\\\\\"NoProgressRecord\\\\\\\", \\\\\\\"RuntimeRegistration\\\\\\\", \\\\\\\"Notification\\\\\\\", \\\\\\\"Conflict\\\\\\\", \\\\\\\"EventEnvelope\\\\\\\", \\\\\\\"CreateProjectRequest\\\\\\\", \\\\\\\"CreateGoalRequest\\\\\\\", \\\\\\\"CreateTaskRequest\\\\\\\", \\\\\\\"ActionRequest\\\\\\\", \\\\\\\"ClaimTaskRequest\\\\\\\", \\\\\\\"HeartbeatRequest\\\\\\\", \\\\\\\"RunReportRequest\\\\\\\", \\\\\\\"CancelRunRequest\\\\\\\", \\\\\\\"CancelAckRequest\\\\\\\", \\\\\\\"ReconcileRunRequest\\\\\\\", \\\\\\\"CreateArtifactRequest\\\\\\\", \\\\\\\"CreateEvidenceRequest\\\\\\\", \\\\\\\"VerifyEvidenceRequest\\\\\\\", \\\\\\\"CreateCycleRequest\\\\\\\", \\\\\\\"CycleCheckpointRequest\\\\\\\", \\\\\\\"CloseCycleRequest\\\\\\\", \\\\\\\"CreateExperimentRequest\\\\\\\", \\\\\\\"RegisterExperimentRequest\\\\\\\", \\\\\\\"ExperimentResultRequest\\\\\\\", \\\\\\\"CreateDecisionRequest\\\\\\\", \\\\\\\"CreateAcceptanceRequest\\\\\\\", \\\\\\\"ContextRequest\\\\\\\", \\\\\\\"CreateChangeRequest\\\\\\\", \\\\\\\"ImpactReviewRequest\\\\\\\", \\\\\\\"ApplyChangeRequest\\\\\\\", \\\\\\\"CreateImpactLinkRequest\\\\\\\", \\\\\\\"UpdateBudgetRequest\\\\\\\", \\\\\\\"UpdateRunPolicyRequest\\\\\\\", \\\\\\\"CreateResourceRequest\\\\\\\", \\\\\\\"ResolveResourceRequest\\\\\\\", \\\\\\\"CreateMilestoneRequest\\\\\\\", \\\\\\\"CreateSkillRequest\\\\\\\", \\\\\\\"PromoteSkillRequest\\\\\\\", \\\\\\\"CreateSystemCandidateRequest\\\\\\\", \\\\\\\"CandidateActionRequest\\\\\\\", \\\\\\\"CreateQualificationRequest\\\\\\\", \\\\\\\"QualificationResultRequest\\\\\\\", \\\\\\\"CreateMessageRequest\\\\\\\", \\\\\\\"AcknowledgeRequest\\\\\\\", \\\\\\\"CreateRuntimeRequest\\\\\\\", \\\\\\\"QualifyRuntimeRequest\\\\\\\", \\\\\\\"CostEntryRequest\\\\\\\", \\\\\\\"UpdateCursorRequest\\\\\\\", \\\\\\\"SearchRequest\\\\\\\", \\\\\\\"SearchHit\\\\\\\", \\\\\\\"SearchResponse\\\\\\\", \\\\\\\"ContentUploadResponse\\\\\\\", \\\\\\\"TaskClaimResponse\\\\\\\", \\\\\\\"ErrorDetail\\\\\\\", \\\\\\\"Error\\\\\\\", \\\\\\\"CreateRequirementRequest\\\\\\\", \\\\\\\"RequirementActionRequest\\\\\\\", \\\\\\\"TaskActionRequest\\\\\\\", \\\\\\\"AdvanceNoProgressRequest\\\\\\\", \\\\\\\"ResolveConflictRequest\\\\\\\", \\\\\\\"CreateConflictRequest\\\\\\\", \\\\\\\"DeviceRecord\\\\\\\", \\\\\\\"CreatePairingRequest\\\\\\\", \\\\\\\"PairingChallengeResponse\\\\\\\", \\\\\\\"RedeemPairingRequest\\\\\\\", \\\\\\\"DeviceSessionResponse\\\\\\\", \\\\\\\"RefreshDeviceSessionRequest\\\\\\\", \\\\\\\"UpdateDeviceGrantRequest\\\\\\\", \\\\\\\"DevicePage\\\\\\\", \\\\\\\"EvaluationCaseResult\\\\\\\", \\\\\\\"EvaluationCounts\\\\\\\", \\\\\\\"EvaluationReport\\\\\\\", \\\\\\\"EvaluationSummary\\\\\\\"]}\\\\r\\\\nFUNCTION _database\\\\r\\\\n523: def _database(raw, identity):\\\\r\\\\n524:     # In-memory deserialization prevents mutation or WAL omission of a live path.\\\\r\\\\n525:     # Only a Root-materialized complete, quiescent SQLite snapshot is supported.\\\\r\\\\n526:     if type(raw) is not bytes or not raw.startswith((b'SQLite format 3' + bytes((0,)))):\\\\r\\\\n527:         raise ValueError('OPEN_COMPLETE_SQLITE_ORIGINAL')\\\\r\\\\n528:     import sqlite3\\\\r\\\\n529:     db = sqlite3.connect(':memory:')\\\\r\\\\n530:     try:\\\\r\\\\n531:         db.deserialize(raw)\\\\r\\\\n532:         db.execute('PRAGMA query_only=ON')\\\\r\\\\n533:         result = {}\\\\r\\\\n534:         for kind, key in (('Task', 'task_id'), ('TaskRun', 'run_id')):\\\\r\\\\n535:             rows = db.execute('SELECT revision,content_hash,body FROM domain_objects WHERE project=? AND kind=? AND id=?',\\\\r\\\\n536:                               (identity['project_id'], kind, identity[key])).fetchall()\\\\r\\\\n537:             if len(rows) != 1:\\\\r\\\\n538:                 raise ValueError('OPEN_DATABASE_CURRENT_IDENTITY')\\\\r\\\\n539:             revision, digest, body = rows[0]\\\\r\\\\n540:             _integer(revision, 'database revision')\\\\r\\\\n541:             if revision < 1 or type(digest) is not str or not re.fullmatch('[0-9a-f]{64}', digest):\\\\r\\\\n542:                 raise ValueError('OPEN_DATABASE_REF')\\\\r\\\\n543:             value = _json_original(body)\\\\r\\\\n544:             if value.get('id') != identity[key] or value.get('revision') != revision:\\\\r\\\\n545:                 raise ValueError('OPEN_DATABASE_BODY')\\\\r\\\\n546:             result[kind] = value\\\\r\\\\n547:         if result['TaskRun'].get('task_id') != identity['task_id']:\\\\r\\\\n548:             raise ValueError('OPEN_DATABASE_TASK_RUN')\\\\r\\\\n549:         result['acceptance_count'] = db.execute(\\\\r\\\\n550:             \\\\\\\"SELECT count(*) FROM domain_objects WHERE project=? AND kind='AcceptanceReceipt' AND json_extract(body,'$.task_id')=?\\\\\\\",\\\\r\\\\n551:             (identity['project_id'], identity['task_id'])).fetchone()[0]\\\\r\\\\n552:         return result\\\\r\\\\n553:     finally:\\\\r\\\\n554:         db.close()\\\\r\\\\nFUNCTION _jsonl\\\\r\\\\n557: def _jsonl(raw, identity):\\\\r\\\\n558:     lines = raw.decode('utf-8').splitlines()\\\\r\\\\n559:     if not lines or any(not line.strip() for line in lines):\\\\r\\\\n560:         raise ValueError('OPEN_COMPLETE_JSONL')\\\\r\\\\n561:     frames = [_json_original(line) for line in lines]\\\\r\\\\n562:     events, finals = [], []\\\\r\\\\n563:     for ordinal, frame in enumerate(frames):\\\\r\\\\n564:         if type(frame) is not dict:\\\\r\\\\n565:             raise ValueError('OPEN_JSONL_OBJECT')\\\\r\\\\n566:         if frame.get('type') == 'session.event':\\\\r\\\\n567:             if finals:\\\\r\\\\n568:                 raise ValueError('OPEN_EVENT_AFTER_FINAL')\\\\r\\\\n569:             event = frame.get('event')\\\\r\\\\n570:             if type(event) is not dict or event.get('session_id') != identity['session_id'] or event.get('protocol_version') != 'researchos-client/2' or event.get('core_build_id') != identity['core_build_id']:\\\\r\\\\n571:                 raise ValueError('OPEN_EVENT_IDENTITY')\\\\r\\\\n572:             _integer(event.get('sequence'), 'event sequence')\\\\r\\\\n573:             if events and event['sequence'] != events[-1]['sequence'] + 1:\\\\r\\\\n574:                 raise ValueError('OPEN_EVENT_GAP')\\\\r\\\\n575:             if event.get('run_id') not in (None, identity['run_id']):\\\\r\\\\n576:                 raise ValueError('OPEN_FOREIGN_RUN_EVENT')\\\\r\\\\n577:             events.append(event)\\\\r\\\\n578:         elif frame.get('type') == 'session.snapshot':\\\\r\\\\n579:             raise ValueError('OPEN_EVENT_RESYNC_OR_SNAPSHOT')\\\\r\\\\n580:         else:\\\\r\\\\n581:             if ordinal != len(frames)-1 or finals or type(frame.get('execution')) is not dict:\\\\r\\\\n582:                 raise ValueError('OPEN_SINGLE_FINAL_REQUIRED')\\\\r\\\\n583:             finals.append(frame['execution'])\\\\r\\\\n584:     if not events or len(finals) != 1:\\\\r\\\\n585:         raise ValueError('OPEN_ORIGINAL_EVENT_STREAM')\\\\r\\\\n586:     final = finals[0]\\\\r\\\\n587:     for key in ('project_id', 'session_id', 'goal_id', 'task_id', 'run_id'):\\\\r\\\\n588:         if final.get(key) != identity[key]:\\\\r\\\\n589:             raise ValueError('OPEN_FINAL_IDENTITY')\\\\r\\\\n590:     if final.get('event_sequence') != events[-1]['sequence'] or final.get('independent_acceptance') != 'NOT_EVALUATED':\\\\r\\\\n591:         raise ValueError('OPEN_FINAL_CURSOR_ACCEPTANCE')\\\\r\\\\n592:     _native_exit(final.get('exit_code'), 'actual CLI exit')\\\\r\\\\n593:     return events, final\\\\r\\\\nFUNCTION verify_live_originals\\\\r\\\\n596: def verify_live_originals(doc, raw, context, row, invocation, scope):\\\\r\\\\n597:     identity = row.get('product_identity')\\\\r\\\\n598:     keys = {'project_id', 'session_id', 'goal_id', 'task_id', 'run_id', 'core_build_id'}\\\\r\\\\n599:     if type(identity) is not dict or set(identity) != keys or not all(type(value) is str and value for value in identity.values()):\\\\r\\\\n600:         raise ValueError('OPEN_ACTUAL_PRODUCT_IDENTITIES')\\\\r\\\\n601:     if row['lane'] != ASSERTION_LANES[row['id']]:\\\\r\\\\n602:         raise ValueError('OPEN_FROZEN_ASSERTION_LANE')\\\\r\\\\n603:     original, _ = _original(doc, raw, row.get('original_witness_ref'))\\\\r\\\\n604:     if original.get('schema') != 'researchos.w05.a04-whole-originals.v2' or original.get('run_id') != context['run_id'] or original.get('lane') != row['lane'] or original.get('product_identity') != identity:\\\\r\\\\n605:         raise ValueError('OPEN_WHOLE_ORIGINAL_IDENTITY')\\\\r\\\\n606:     for key in ('argv', 'cwd', 'env_names', 'initial_tool_input', 'producer_ref'):\\\\r\\\\n607:         if key not in scope or scope[key] != invocation.get(key):\\\\r\\\\n608:             raise ValueError('OPEN_COMPLETE_SCOPE_ABI')\\\\r\\\\n609:     _nonempty(invocation.get('argv'), 'actual argv', list)\\\\r\\\\n610:     _nonempty(invocation.get('cwd'), 'actual cwd')\\\\r\\\\n611:     if type(invocation.get('env_names')) is not list or any(type(v) is not str or not v for v in invocation['env_names']):\\\\r\\\\n612:         raise ValueError('OPEN_ACTUAL_ENV_NAMES')\\\\r\\\\n613:     _native_exit(invocation.get('native_exit'), 'actual invocation exit')\\\\r\\\\n614:     capture, _ = _original(doc, raw, original.get('root_tool_pair_ref'))\\\\r\\\\n615:     closed = _root_pair(capture, scope)\\\\r\\\\n616:     if closed['actual_launcher_native_exit'] != invocation['native_exit']:\\\\r\\\\n617:         raise ValueError('OPEN_NATIVE_RESULT_CONFLICT')\\\\r\\\\n618:     job, _ = _original(doc, raw, original.get('windows_job_ref'))\\\\r\\\\n619:     if job.get('schema') != 'researchos.w05.windows-job-original.v2' or job.get('run_id') != context['run_id'] or job.get('lane') != row['lane'] or job.get('root_tool_pair_ref') != original['root_tool_pair_ref'] or job.get('producer_ref') != scope['producer_ref'] or job.get('native_exit') != invocation['native_exit']:\\\\r\\\\n620:         raise ValueError('OPEN_WINDOWS_JOB_BINDING')\\\\r\\\\n621:     for key in ('owned_processes_before', 'owned_processes_after', 'pending_requests_after', 'launch_events'):\\\\r\\\\n622:         if type(job.get(key)) is not list:\\\\r\\\\n623:             raise ValueError('OPEN_COMPLETE_WINDOWS_JOB_EVENTS')\\\\r\\\\n624:     if job.get('job_closed') is not True or job.get('cleanup_complete') is not True:\\\\r\\\\n625:         raise ValueError('OPEN_WINDOWS_JOB_NOT_CLOSED')\\\\r\\\\n626:     objects = _database(raw(original['database_ref']), identity)\\\\r\\\\n627:     events, final = _jsonl(raw(original['jsonl_ref']), identity)\\\\r\\\\n628:     if final['exit_code'] != invocation['native_exit']:\\\\r\\\\n629:         raise ValueError('OPEN_JSONL_NATIVE_CONFLICT')\\\\r\\\\n630:     task, run = objects['Task'], objects['TaskRun']\\\\r\\\\n631:     states = [ev.get('payload') for ev in events if ev.get('kind') == 'RUN_STATE' and ev.get('run_id') == identity['run_id']]\\\\r\\\\n632:     if not states or type(states[-1]) is not dict:\\\\r\\\\n633:         raise ValueError('OPEN_RUN_STATE_ORIGINAL')\\\\r\\\\n634:     state = states[-1]\\\\r\\\\n635:     _integer(state.get('revision'), 'RUN_STATE revision')\\\\r\\\\n636:     if state.get('revision') != run.get('revision') or state.get('status') != run.get('status') or run.get('children_stopped') is not True or run.get('queue_empty') is not True or state.get('children_stopped') is not True or state.get('queue_empty') is not True:\\\\r\\\\n637:         raise ValueError('OPEN_RUN_DATABASE_EVENT_BINDING')\\\\r\\\\n638:     if row['id'] == 'A04-01':\\\\r\\\\n639:         if task.get('status') != 'EXECUTION_REPORTED' or run.get('status') != 'SETTLED' or objects['acceptance_count'] != 0 or final.get('status') != 'EXECUTION_REPORTED':\\\\r\\\\n640:             raise ValueError('OPEN_EXECUTION_REPORTED_NOT_ACCEPTED')\\\\r\\\\n641:         if not run.get('result_artifact_ids') or state.get('settled_at') != run.get('runtime_settled_at'):\\\\r\\\\n642:             raise ValueError('OPEN_SETTLED_RECEIPTS')\\\\r\\\\n643:     elif row['id'] == 'A