              "SESSION_BUSY",
              "SESSION_ARCHIVED",
              "COMMAND_ID_CONFLICT",
              "COMMAND_PENDING",
              "CURSOR_EXPIRED",
              "CURSOR_INVALID",
              "PATH_OUT_OF_SCOPE",
              "WORKSPACE_REVOKED",
              "SELECTION_EXPIRED",
              "SELECTION_ALREADY_USED",
              "CONTENT_CONFLICT",
              "CONTENT_TOO_LARGE",
              "UNSUPPORTED_CONTENT",
              "NOT_A_REPOSITORY",
              "EXTERNAL_WRITE_RACE",
              "ARTIFACT_IMMUTABLE",
              "CREDENTIAL_MISSING",
              "CREDENTIAL_REVOKED",
              "CONFIG_CONFLICT",
              "MODEL_UNAVAILABLE",
              "PROVIDER_AUTH_FAILED",
              "PROVIDER_RATE_LIMITED",
              "PROVIDER_TIMEOUT",
              "NETWORK_UNAVAILABLE",
              "RESOURCE_BLOCKED",
              "CANCEL_UNCONFIRMED",
              "ALREADY_TERMINAL",
              "INTERNAL_ERROR",
              "VERSION_CONFLICT"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "retryable": {
            "type": "boolean"
          },
          "recovery": {
            "enum": [
              "FIX_INPUT",
              "REAUTHENTICATE_OS_USER",
              "REFRESH_SNAPSHOT",
              "ACQUIRE_WRITER",
              "WAIT_FOR_SETTLEMENT",
              "RECONFIGURE",
              "RESOLVE_RESOURCE",
              "RETRY_SAME_COMMAND",
              "STOP_AND_REPORT"
            ]
          },
          "current_revision": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "current_writer_epoch": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "resource_request_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "retry_after_ms": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "correlation_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "message",
          "retryable",
          "recovery",
          "current_revision",
          "current_writer_epoch",
          "resource_request_id",
          "retry_after_ms",
          "correlation_id"
        ],
        "additionalProperties": false
      },
      "RelativePath": {
