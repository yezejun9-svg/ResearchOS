      "SessionEvent": {
        "type": "object",
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "session_id": {
            "type": "string",
            "minLength": 1
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "core_build_id": {
            "type": "string",
            "minLength": 1
          },
          "protocol_version": {
            "const": "researchos-client/2"
          },
          "run_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "command_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "domain_event_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "kind": {
            "enum": [
              "MESSAGE",
              "TOOL_STARTED",
              "TOOL_RESULT",
              "JUDGE_DECISION",
              "RUN_STATE",
              "GOAL_STATE",
              "ARTIFACT",
              "USAGE",
              "CHECKPOINT",
              "CLIENT_HANDOFF",
              "BOOTSTRAP_STATE",
              "PERMISSION_REQUIRED",
              "PERMISSION_RESOLVED",
              "ERROR"
            ]
          },
          "payload": {
            "type": "object"
          }
        },
        "required": [
          "event_id",
          "session_id",
          "sequence",
          "core_build_id",
          "protocol_version",
          "run_id",
          "command_id",
          "domain_event_id",
          "kind",
          "payload"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "MESSAGE"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "payload": {
                  "$ref": "client:MessageEventPayload"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "TOOL_STARTED"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "payload": {
                  "$ref": "client:ToolStartedEventPayload"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "TOOL_RESULT"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "payload": {
                  "$ref": "client:ToolResultEventPayload"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "JUDGE_DECISION"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "payload": {
                  "$ref": "client:JudgeEventPayload"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "RUN_STATE"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "payload": {
                  "$ref": "client:RunStateEventPayload"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "GOAL_STATE"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "payload": {
                  "$ref": "client:GoalStateEventPayload"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "ARTIFACT"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "payload": {
                  "$ref": "client:ArtifactEventPayload"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "USAGE"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "payload": {
                  "$ref": "client:UsageEventPayload"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "CHECKPOINT"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "payload": {
                  "$ref": "client:CheckpointEventPayload"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "CLIENT_HANDOFF"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "payload": {
                  "$ref": "client:HandoffEventPayload"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "BOOTSTRAP_STATE"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "payload": {
                  "$ref": "client:BootstrapEventPayload"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "PERMISSION_REQUIRED"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "payload": {
                  "$ref": "client:PermissionRequiredEventPayload"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "PERMISSION_RESOLVED"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "payload": {
                  "$ref": "client:PermissionResolvedEventPayload"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "ERROR"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "payload": {
                  "$ref": "client:ErrorEventPayload"
                }
              }
            }
          }
        ]
      },
      "ToolResultEventPayload": {
        "type": "object",
        "properties": {
          "tool_call_id": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "enum": [
              "SUCCEEDED",
              "FAILED",
              "CANCELLED",
              "BLOCKED",
              "UNKNOWN"
            ]
          },
          "summary": {
            "type": "string"
          },
          "stdout_artifact_ref": {
            "anyOf": [
              {
                "$ref": "client:ArtifactRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "stderr_artifact_ref": {
            "anyOf": [
              {
                "$ref": "client:ArtifactRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "result_artifact_refs": {
            "type": "array",
            "items": {
              "$ref": "client:ArtifactRef"
            },
            "maxItems": 100
          }
        },
        "required": [
          "tool_call_id",
          "outcome",
          "summary",
          "stdout_artifact_ref",
          "stderr_artifact_ref",
          "result_artifact_refs"
        ],
        "additionalProperties": false
      },
      "ToolStartedEventPayload": {
        "type": "object",
        "properties": {
          "tool_call_id": {
            "type": "string",
            "minLength": 1
          },
          "parent_tool_call_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "tool_name": {
            "type": "string",
            "minLength": 1
          },
          "input_summary": {
            "type": "string"
          },
          "input_artifact_ref": {
            "anyOf": [
              {
                "$ref": "client:ArtifactRef"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "tool_call_id",
          "parent_tool_call_id",
          "tool_name",
          "input_summary",
          "input_artifact_ref"
        ],
        "additionalProperties": false
      },
      "UsageEventPayload": {
        "type": "object",
        "properties": {
          "ledger_entry_id": {
            "type": "string",
            "minLength": 1
          },
          "provider_usage_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "input_tokens": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "output_tokens": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "money": {
            "anyOf": [
              {
                "$ref": "domain:Money"
              },
              {
                "type": "null"
              }
            ]
          },
          "cost_known": {
            "type": "boolean"
          }
        },
        "required": [
          "ledger_entry_id",
          "provider_usage_id",
          "input_tokens",
          "output_tokens",
          "money",
          "cost_known"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "cost_known": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "money": {
                  "$ref": "domain:Money"
                }
              }
            },
            "else": {
              "properties": {
                "money": {
                  "type": "null"
                }
              }
            }
          }
        ]
      },
      "WriterLease": {
        "type": "object",
        "properties": {
          "client_id": {
            "type": "string",
            "minLength": 1
          },
          "epoch": {
            "type": "integer",
            "minimum": 1
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "client_id",
          "epoch",
          "expires_at"
        ],
        "additionalProperties": false
      }
    },
    "persistence": {
      "AcceptanceContract": {
        "type": "object",
        "properties": {
          "contract_hash": {
            "$ref": "persistence:Digest"
          },
          "contract_revision": {
            "$ref": "persistence:Revision"
          },
          "checks": {
            "type": "array",
            "items": {
              "$ref": "persistence:CheckSpec"
            },
            "minItems": 1
          },
          "require_independent_verifier": {
            "const": true
          },
          "version_policy": {
            "const": "EXACT"
          },
          "frozen_at": {
            "$ref": "persistence:UtcTime"
          }
        },
        "required": [
          "contract_hash",
          "contract_revision",
          "checks",
          "require_independent_verifier",
          "version_policy",
          "frozen_at"
        ],
        "additionalProperties": false
      },
      "CheckSpec": {
        "type": "object",
        "properties": {
          "check_id": {
            "$ref": "persistence:Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "DETERMINISTIC",
              "MODEL_RUBRIC",
              "PREFERENCE"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "command_key": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "rubric_ref": {
            "anyOf": [
              {
                "$ref": "persistence:VersionRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "qualification_id": {
            "anyOf": [
              {
                "$ref": "persistence:Id"
              },
              {
                "type": "null"
              }
            ]
          },
          "not_applicable_reason": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "check_id",
          "kind",
          "required",
          "expected",
          "command_key",
          "rubric_ref",
          "qualification_id",
          "not_applicable_reason"
        ],
        "additionalProperties": false
      },
      "Digest": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "Id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
      },
      "ProjectBinding": {
        "type": "object",
        "properties": {
          "route": {
            "type": "string",
            "enum": [
              "MU_FORK",
              "PI_COMPOSE",
              "GAP_ONLY_COMPOSE"
            ]
          },
          "upstream_project_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "upstream_goal_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "upstream_task_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "route",
          "upstream_project_id",
          "upstream_goal_id",
          "upstream_task_id"
        ],
        "additionalProperties": false
      },
      "Revision": {
        "type": "integer",
        "minimum": 1
      },
      "Stage": {
        "type": "string",
        "enum": [
          "discovery",
          "verification",
          "experiment",
          "review",
          "delivery",
          "follow_up"
        ]
      },
      "StopPolicy": {
        "type": "object",
        "properties": {
          "wall_time_seconds": {
            "type": "integer",
            "minimum": 1
          },
          "max_attempts": {
            "type": "integer",
            "minimum": 1
          },
          "max_parallel_runs": {
            "type": "integer",
            "minimum": 1
          },
          "stop_conditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "wall_time_seconds",
          "max_attempts",
          "max_parallel_runs",
          "stop_conditions"
        ],
        "additionalProperties": false
      },
      "Task": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "persistence:Id"
          },
          "project_id": {
            "$ref": "persistence:Id"
          },
          "revision": {
            "$ref": "persistence:Revision"
          },
          "created_at": {
            "$ref": "persistence:UtcTime"
          },
          "updated_at": {
            "$ref": "persistence:UtcTime"
          },
          "goal_id": {
            "$ref": "persistence:Id"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "task_type": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "$ref": "persistence:Stage"
          },
          "status": {
            "$ref": "persistence:TaskStatus"
          },
          "dependency_task_ids": {
            "type": "array",
            "items": {
              "$ref": "persistence:Id"
            },
            "minItems": 0
          },
          "requirement_refs": {
            "type": "array",
            "items": {
              "$ref": "persistence:VersionRef"
            },
            "minItems": 0
          },
          "input_refs": {
            "type": "array",
            "items": {
              "$ref": "persistence:VersionRef"
            },
            "minItems": 0
          },
          "context_bundle_id": {
            "anyOf": [
              {
                "$ref": "persistence:Id"
              },
              {
                "type": "null"
              }
            ]
          },
          "acceptance_contract": {
            "$ref": "persistence:AcceptanceContract"
          },
          "assigned_principal_id": {
            "anyOf": [
              {
                "$ref": "persistence:Id"
              },
              {
                "type": "null"
              }
            ]
          },
          "active_run_id": {
            "anyOf": [
              {
                "$ref": "persistence:Id"
              },
              {
                "type": "null"
              }
            ]
          },
          "output_artifact_ids": {
            "type": "array",
            "items": {
              "$ref": "persistence:Id"
            },
            "minItems": 0
          },
          "acceptance_id": {
            "anyOf": [
              {
                "$ref": "persistence:Id"
              },
              {
                "type": "null"
              }
            ]
          },
          "blocking_conflict_ids": {
            "type": "array",
            "items": {
              "$ref": "persistence:Id"
            },
            "minItems": 0
          },
          "no_progress_record_id": {
            "$ref": "persistence:Id"
          },
          "stop_policy": {
            "$ref": "persistence:StopPolicy"
          },
          "binding": {
            "$ref": "persistence:ProjectBinding"
          }
        },
        "required": [
          "id",
          "project_id",
          "revision",
          "created_at",
          "updated_at",
          "goal_id",
          "title",
          "task_type",
          "stage",
          "status",
          "dependency_task_ids",
          "requirement_refs",
          "input_refs",
          "context_bundle_id",
          "acceptance_contract",
          "assigned_principal_id",
          "active_run_id",
          "output_artifact_ids",
          "acceptance_id",
          "blocking_conflict_ids",
          "no_progress_record_id",
          "stop_policy",
          "binding"
        ],
        "additionalProperties": false
      },
      "TaskStatus": {
        "type": "string",
        "enum": [
          "DRAFT",
          "READY",
          "RUNNING",
          "EXECUTION_REPORTED",
          "VERIFYING",
          "ACCEPTED",
          "FAILED",
          "BLOCKED",
          "CANCELLED",
          "NEEDS_REVALIDATION",
          "DEFERRED_NO_PROGRESS"
        ]
      },
      "UtcTime": {
        "type": "string",
        "format": "date-time",
        "pattern": "Z$"
      },
      "VersionRef": {
        "type": "object",
        "properties": {
          "entity_type": {
            "type": "string",
            "enum": [
              "ProjectProfile",
              "ProjectState",
              "Requirement",
              "Goal",
              "Task",
              "Run",
              "Artifact",
              "Evidence",
              "ResearchCycle",
              "Experiment",
              "DecisionReceipt",
              "Qualification",
              "ContextBundle",
              "ChangeProposal",
              "ImpactLink",
              "BudgetPolicy",
              "RunPolicy",
              "ResourceRequest",
              "MilestoneRelease",
              "ProgressProjection",
              "SkillVersion",
              "SystemCandidate",
              "AcceptanceReceipt",
              "AgentMessage",
              "SourceCursor",
              "BudgetLedgerEntry",
              "NoProgressRecord",
              "RuntimeRegistration",
              "Notification",
              "Conflict",
              "EventEnvelope"
            ]
          },
          "id": {
            "$ref": "persistence:Id"
          },
          "revision": {
            "$ref": "persistence:Revision"
          },
          "content_hash": {
            "anyOf": [
              {
                "$ref": "persistence:Digest"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "entity_type",
          "id",
          "revision",
          "content_hash"
        ],
        "additionalProperties": false
      }
    }
  },
  "description_annotations_only_removed": true,
  "external_refs_or_schema_network": false
}
