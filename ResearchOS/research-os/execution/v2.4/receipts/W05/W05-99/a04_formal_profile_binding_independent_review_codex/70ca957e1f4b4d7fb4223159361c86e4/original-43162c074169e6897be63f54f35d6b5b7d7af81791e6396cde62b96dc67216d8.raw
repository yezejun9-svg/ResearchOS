      },
      "MessageEventPayload": {
        "type": "object",
        "properties": {
          "message_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "USER",
              "ASSISTANT",
              "SYSTEM"
            ]
          },
          "phase": {
            "enum": [
              "START",
              "DELTA",
              "END"
            ]
          },
          "part_index": {
            "type": "integer",
            "minimum": 0
          },
          "content_offset_utf8_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "text": {
            "type": "string",
            "maxLength": 16384
          }
        },
        "required": [
          "message_id",
          "role",
          "phase",
          "part_index",
          "content_offset_utf8_bytes",
          "text"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "phase": {
                  "const": "START"
                }
              }
            },
            "then": {
              "properties": {
                "content_offset_utf8_bytes": {
                  "const": 0
                },
                "text": {
                  "const": ""
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "phase": {
                  "const": "END"
                }
              }
            },
            "then": {
              "properties": {
                "text": {
                  "const": ""
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "phase": {
                  "const": "DELTA"
                }
              }
            },
            "then": {
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16384
                }
              }
            }
          }
        ]
      },
      "PermissionActionScope": {
