7: async function installFixture(page, { native = false } = {}) {
8:   const unexpected = [];
9:   const requests = [];
10:   const data = {
11:     '/v1/projects': { items: [{ project_id: projectId, name: '城市河流研究', intent: '整理水质与治理证据' }] },
12:     [`/v1/projects/${projectId}/profile`]: { project_id: projectId, name: '城市河流研究', revision: 3 },
13:     [`/v1/projects/${projectId}/state`]: { project_id: projectId, revision: 3, active_cycle_id: null, blocking_conflict_ids: [] },
14:     [`/v1/projects/${projectId}/progress`]: { project_id: projectId, plan_revision: 3, as_of_event_sequence: 0, stages: [] },
15:     [`/v1/projects/${projectId}/releases`]: { items: [] },
16:     [`/v1/projects/${projectId}/notifications`]: { items: [] },
17:     [`/v1/projects/${projectId}/goals`]: { items: [] },
18:     [`/v1/projects/${projectId}/tasks`]: { items: [] },
19:     [`/v1/projects/${projectId}/research-cycles`]: { items: [] },
20:     [`/v1/projects/${projectId}/resource-requests`]: { items: [] },
21:   };
22:   await page.route('**/*', async route => {
23:     const url = new URL(route.request().url());
24:     const path = url.pathname;
25:     if (path.startsWith('/v1/') || path.startsWith('/v2/')) {
26:       requests.push({ method: route.request().method(), path });
27:       if (path.endsWith('/events/stream')) return route.fulfill({ status: 200, contentType: 'text/event-stream', body: ': fixture heartbeat\n\n' });
28:       if (route.request().method() === 'GET' && Object.hasOwn(data, path))
29:         return route.fulfill({ status: 200, contentType: 'application/json', body: JSON.stringify(data[path]) });
30:       unexpected.push(`${route.request().method()} ${path}`);
31:       return route.fulfill({ status: 599, contentType: 'application/json', body: JSON.stringify({ code: 'FIXTURE_UNEXPECTED_REQUEST' }) });
32:     }
33:     if (path === '/remote-info') return route.fulfill({ status: 404, body: '{}' });
34:     if (url.hostname === '127.0.0.1' && (path === '/' || path.startsWith('/p/') || path.startsWith('/assets/')))
35:       return route.continue();
36:     unexpected.push(`EXTERNAL ${url.href}`);
37:     return route.abort();
38:   });
39:   if (native) await page.addInitScript(({ projectId }) => {
40:     const initial = {
41:       project_id: projectId, session_id: 'session-one', title: '河流污染证据核对', revision: 7,
42:       event_sequence: 0, earliest_event_sequence: 0, run_status: 'WAITING', active_run_id: null,
43:       workspace_ref: 'workspace-one', goal_id: null, pending_command_ids: [], pending_permissions: [],
44:       writer: { client_id: 'fixture-client', expires_at: '2099-01-01T00:00:00Z' },
45:       messages: [
46:         { message_id: 'm1', role: 'USER', complete: true, parts: [{ text: '请核对上游与下游水质记录，标出来源不一致的结论。' }] },
47:         { message_id: 'm2', role: 'ASSISTANT', complete: true, parts: [{ text: '已收到研究问题。下一步先整理来源，再逐条核对采样时间和测点。' }] },
48:       ],
49:     };
50:     const state = { snapshot: initial, sessions: [{ session_id: initial.session_id, title: initial.title, run_status: 'WAITING' }] };
51:     const completed = result => ({ ok: true, completed: true, protocol_status: 'COMPLETED', result });
52:     window.__frontendFixtureCalls = [];
53:     const actions = {
54:       'host.status': () => ({ client_id: 'fixture-client', model_configurations: [{ model_config_ref: 'model-one', provider_id: 'local', model_id: 'research-model', config_revision: 1 }], workspaces: [{ project_id: projectId, status: 'ACTIVE', authorized_workspace_ref: 'workspace-one', display_name: '研究资料' }] }),
55:       'session.list': () => ({ items: state.sessions, next_cursor: null }),
56:       'session.get': () => state.snapshot,
57:       'session.events': () => ({ events: [], next_sequence: state.snapshot.event_sequence }),
58:       'session.attach': () => state.snapshot,
59:       'session.create': body => { const next = { ...initial, session_id: 'session-two', title: body.title, messages: [], revision: 1 }; state.sessions.unshift({ session_id: next.session_id, title: next.title, run_status: 'WAITING' }); state.snapshot = next; return next },
60:       'session.send': body => { state.snapshot.messages.push({ message_id: `m${state.snapshot.messages.length + 1}`, role: 'USER', complete: true, parts: [{ text: body.text }] }); state.snapshot.pending_command_ids.push('pending-fixture'); return { command_id: 'pending-fixture' } },
61:       'session.control': () => state.snapshot,
62:       'workspace.tree': () => ({ entries: [], next_cursor: null }),
63:       'workspace.diff': () => ({ base: 'HEAD', files: [], total_files: 0, truncated: false }),
64:     };
65:     const v2 = Object.fromEntries(Object.entries(actions).map(([name, action]) => [name, async body => { window.__frontendFixtureCalls.push({ name, body }); return completed(action(body || {})) }]));
66:     window.researchos = { desktop: {
67:       context: async () => ({ project_id: projectId, session_id: state.snapshot.session_id }),
68:       selectProject: async () => ({ ok: true }),
69:       openSession: async sessionId => { const session = state.sessions.find(item => item.session_id === sessionId); if (session) state.snapshot = { ...state.snapshot, session_id: session.session_id, title: session.title }; return completed(state.snapshot) },
70:       qualificationCurrent: async () => ({ ok: true, available: false, state: 'NOT_REQUESTED' }),
71:       codingCurrent: async () => ({ ok: true, available: false, state: 'NOT_REQUESTED' }),
72:     }, v2 };
73:   }, { projectId });
74:   return { unexpected, requests, projectId };
75: }
76: 
77: module.exports = { installFixture, projectId };
