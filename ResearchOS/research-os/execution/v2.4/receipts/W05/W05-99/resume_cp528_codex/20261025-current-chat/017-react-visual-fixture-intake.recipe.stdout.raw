1: 'use strict';
2: 
3: const assert = require('node:assert/strict');
4: const fs = require('node:fs');
5: const path = require('node:path');
6: const { createHash } = require('node:crypto');
7: const playwright = require(process.env.RESEARCHOS_PLAYWRIGHT_MODULE || 'C:/Users/yqyyds/AppData/Local/Python/pythoncore-3.14-64/Lib/site-packages/playwright/driver/package');
8: const { installFixture, projectId } = require('./frontend-redesign-fixture.cjs');
9: 
10: const url = process.argv[2];
11: const out = path.resolve(process.argv[3]);
12: if (!url || !out || new URL(url).hostname !== '127.0.0.1') throw new Error('A task-owned loopback preview URL and output directory are required');
13: fs.mkdirSync(out, { recursive: true });
14: const report = { schema: 'researchos.frontend-redesign-fixture.v1', evidence_kind: 'VISUAL_INTERACTION_FIXTURE_ONLY', checks: [], screenshots: [], limitations: ['Browser and native-shaped bridges are disposable fixtures. No Core, owner, provider, or formal acceptance is asserted.'] };
15: function check(name, value, detail) { report.checks.push({ name, status: value ? 'PASS' : 'FAIL', detail }); assert.ok(value, `${name}: ${JSON.stringify(detail)}`); }
16: function shot(page, name) { const target = path.join(out, `${name}.png`); return page.screenshot({ path: target, fullPage: true }).then(() => report.screenshots.push({ name, path: target, sha256: createHash('sha256').update(fs.readFileSync(target)).digest('hex') })); }
17: 
18: async function main() {
19:   const browser = await playwright.chromium.launch({ headless: true });
20:   try {
21:     for (const width of [320, 768, 1024, 1440]) {
22:       for (const theme of ['light', 'dark']) {
23:         const context = await browser.newContext({ viewport: { width, height: 900 }, deviceScaleFactor: 1 });
24:         const page = await context.newPage();
25:         const errors = [];
26:         page.on('pageerror', error => errors.push(error.message));
27:         const fixture = await installFixture(page, { native: true });
28:         await page.addInitScript(theme => localStorage.setItem('researchos.theme', theme), theme);
29:         await page.goto(`${url}/p/${projectId}`, { waitUntil: 'domcontentloaded' });
30:         await page.getByRole('heading', { name: '河流污染证据核对' }).waitFor({ timeout: 12000 });
31:         await page.getByText('请核对上游与下游水质记录').waitFor({ timeout: 12000 });
32:         const metrics = await page.evaluate(() => ({ viewport: innerWidth, document: document.documentElement.scrollWidth,
33:           regions: [...document.querySelectorAll('.workbench-layout > *')].map(el => ({ label: el.getAttribute('aria-label'), width: Math.round(el.getBoundingClientRect().width) })),
34:           theme: document.documentElement.dataset.theme }));
35:         check(`${width}-${theme}-no-overflow`, metrics.document <= metrics.viewport, metrics);
36:         check(`${width}-${theme}-regions`, metrics.regions.length === 3 && metrics.regions.every(x => x.width > 0), metrics);
37:         check(`${width}-${theme}-theme`, metrics.theme === theme, metrics);
38:         check(`${width}-${theme}-console`, errors.length === 0, errors);
39:         check(`${width}-${theme}-interception`, fixture.unexpected.length === 0, fixture.unexpected);
40:         await shot(page, `native-${width}-${theme}`);
41:         if (width === 1440 && theme === 'light') {
42:           const input = page.getByRole('textbox', { name: '会话消息' });
43:           await input.fill('核对采样点 A 与 B 的时间差异。');
