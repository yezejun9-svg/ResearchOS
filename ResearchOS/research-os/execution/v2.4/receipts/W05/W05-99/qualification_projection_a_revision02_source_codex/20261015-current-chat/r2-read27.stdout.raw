{
  "schema": "researchos.qualification-repair-test-cuts.v1",
  "scope": "A",
  "execution_status": "NOT_RUN_ARCHITECTURE_ONLY",
  "isolation": {"base": "4f4023c956f84d65743f39ce77d6c8899a21ada1", "actual_root": "FORBIDDEN", "network": "LOCAL_FIXTURE_ONLY", "worker": "FROZEN_SDK8df_ARTIFACT", "installed_resources_mutation": false},
  "cuts": [
    {"id": "A01", "cut": "pure eligible qualification", "assert": "source profile/config unchanged recursively; effective changes only max_calls=1 and tools=[]; repeated derivation/hash deterministic"},
    {"id": "A02", "cut": "normal mu_turn", "assert": "original max_calls and complete coding schemas remain exact at staging, host and verifier"},
    {"id": "A03", "cut": "legacy qualification without marker", "assert": "historical original config accepted as before; no silent projection; historical replay authority remains unchanged"},
    {"id": "A04", "cut": "partial/tampered marker matrix", "mutate_one_at_a_time": ["schema version", "purpose", "bootstrap flag", "project", "task", "run", "epoch", "runtime", "dispatch_key", "profile_ref/hash", "source profile hash", "source config hash", "plan_hash", "permission_hash", "effective config hash", "max_model_calls", "max_tool_calls", "extra marker field"], "assert": "every consumer fails closed; no fallback and no provider call"},
    {"id": "A05", "cut": "new dispatch production path", "assert": "all eligible new qualification manifests carry marker before immutable hash/INSERT; task-type contradiction and qualification max_calls=2 rejected; no marker for normal turns"},
    {"id": "A06", "cut": "adapter start before native launch", "assert": "staged old coding config under a v1 qualification marker rejected; arbitrary tools=[] without valid marker rejected; bundle/argv/backend checks remain active"},
    {"id": "A07", "cut": "actual frozen worker + local fixture model", "assert": "worker.json effective config is consumed; observed actual MODEL wire body exposes no callable coding tool; max1; one complete response; frozen bundle unchanged; do not assert semantic content of provider text"},
    {"id": "A08", "cut": "host model pre-prepare and pre-transport", "assert": "injected tool schema or second model request rejected; provider count not incremented on rejection; source provider config remains original; any already-confirmed effect remains unchanged"},
    {"id": "A09", "cut": "independent verifier snapshot", "assert": "matching projected request valid against effective config; copied marker from another dispatch, old tools, profile mismatch and excess model count rejected; ordinary turn snapshot still valid"},
    {"id": "A10", "cut": "completedLocalUnknownCost", "assert": "complete projected confirmed MODEL may satisfy existing completed native check; UNKNOWN money/ledger remains unchanged; missing native closure, altered effective config or unconfirmed effect rejected"},
    {"id": "A11", "cut": "hash compatibility", "assert": "shared canonicalization equals current domain and adapter hashes with json.Number, nested arrays, Unicode and empty tools; no mutation aliasing"},
    {"id": "A12", "cut": "provider emits unsolicited tool_calls", "assert": "A creates no tool authority and makes no second MODEL call; do not claim deterministic FAILED closure until B exists"}
  ],
  "commands_template": [
    "go test ./internal/runtimepolicy ./adapters/runtime ./internal/domain -run 'QualificationProjection|ModelProjection|MuTurn|CompletedLocalUnknownCost' -count=1",
    "go test ./adapters/runtime ./internal/domain -count=1",
    "go build ./apps/control"
  ],
  "required_receipt_fields": ["exact source diff and file hashes", "Go toolchain/env and isolated root", "test selection and assertion counts", "stdout/stderr/exit status", "frozen worker bundle hash before/after", "source profile/config hashes before/after", "fixture wire-request metadata", "no real provider or product-data access", "independent review verdict"],
  "acceptance": {"source": "all A cuts pass with nonzero relevant assertions and independent review", "fixture": "real frozen worker local fixture path observed", "actual": "NOT_AUTHORIZED", "formal_case_increment": 0}
}
