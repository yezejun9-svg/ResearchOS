359: // CreateBackup uses a transactional SQLite snapshot, including WAL commits and
360: // sealed BLOBs in the same consistency window. Files are derived ONLY from that
361: // closed snapshot. Publication happens after all hashes and the manifest pass.
362: func (s *Service) CreateBackup(ctx context.Context, destination string, key []byte) (BackupManifest, error) {
363: 	return s.createBackupPolicy(ctx, destination, key, nil)
364: }
365: func (s *Service) createBackupPolicy(ctx context.Context, destination string, key []byte, policy *backupPolicy, sources ...WorkspaceBackupSource) (BackupManifest, error) {
366: 	m := BackupManifest{Format: backupFormat(policy), ID: ID(), Started: Now(), KeyPolicy: "AES-256-GCM; key stored separately; credentials require fresh provisioning after restore", CachePolicy: "SQLite FTS cache included; external worker/context workspaces excluded and rebuilt from sealed content"}
367: 	if policy != nil {
368: 		m.Purpose = policy.purpose
369: 	}
370: 	a, e := backupCipher(key)
371: 	if e != nil {
372: 		return m, e
373: 	}
374: 	stage, e := backupNewStage(destination)
375: 	if e != nil {
376: 		return m, e
377: 	}
378: 	defer backupDiscard(stage)
379: 	plain := filepath.Join(stage, "snapshot.sqlite")
380: 	if _, e = s.DB.ExecContext(ctx, "VACUUM INTO ?", plain); e != nil {
381: 		return m, e
382: 	}
383: 	m.SnapshotCompleted = Now()
384: 	db, e := store.Open(plain)
385: 	if e != nil {
386: 		return m, e
387: 	}
388: 	defer db.Close()
389: 	if e = backupIntegrityPolicy(db, policy); e != nil {
390: 		return m, e
391: 	}
392: 	if m.Migrations, e = backupMigrations(db); e != nil {
393: 		return m, e
394: 	}
395: 	if m.SchemaHash, e = backupSchema(db); e != nil {
396: 		return m, e
397: 	}
398: 	if m.Runtime, e = backupRuntime(db); e != nil {
399: 		return m, e
400: 	}
401: 	if m.Inventory, e = backupInventory(db); e != nil {
402: 		return m, e
403: 	}
404: 	files := map[string][]byte{}
405: 	rows, e := db.Query("SELECT storage_key,bytes,content_hash FROM uploaded_content WHERE sealed=1 ORDER BY storage_key")
406: 	if e != nil {
407: 		return m, e
408: 	}
409: 	for rows.Next() {
410: 		var k, h string
411: 		var b []byte
412: 		if e = rows.Scan(&k, &b, &h); e != nil {
413: 			rows.Close()
414: 			return m, e
415: 		}
416: 		if Digest(b) != h {
417: 			rows.Close()
418: 			return m, fmt.Errorf("BACKUP_CONTENT_HASH")
419: 		}
420: 		files["content-"+strings.TrimPrefix(Digest([]byte(k)), "sha256:")+".bin"] = b
421: 	}
422: 	e = rows.Err()
423: 	rows.Close()
424: 	if e != nil {
425: 		return m, e
426: 	}
427: 	if policy == nil {
428: 		objects, e := backupPortable(db)
429: 		if e != nil {
430: 			return m, e
431: 		}
432: 		queue, err := backupQueueState(db)
433: 		if err != nil {
434: 			return m, err
435: 		}
436: 		if queue != nil {
437: 			files["command-queue.json"] = Bytes(queue)
438: 		}
439: 		files["portable.json"] = Bytes(Object{"format": "RESEARCHOS_PORTABLE_V1", "objects": objects, "authority": "state.sqlite; portable objects preserve IDs, revisions, source relationships and receipt hashes"})
440: 		var source WorkspaceBackupSource
441: 		if len(sources) != 0 {
442: 			source = sources[0]
443: 		}
444: 		workspaceFiles, count, err := backupWorkspaceFiles(ctx, db, source, destination)
445: 		if err != nil {
446: 			return m, err
447: 		}
448: 		for name, raw := range workspaceFiles {
449: 			files[name] = raw
450: 		}
451: 		if count != 0 {
452: 			m.CachePolicy = "SQLite FTS cache included; authorized workspaces encrypted and bounded; external worker/context caches rebuilt from sealed content"
453: 		}
454: 	}
455: 	if _, e = db.Exec("PRAGMA wal_checkpoint(TRUNCATE)"); e != nil {
456: 		return m, e
457: 	}
458: 	if e = db.Close(); e != nil {
459: 		return m, e
460: 	}
461: 	files["state.sqlite"], e = os.ReadFile(plain)
462: 	if e != nil {
463: 		return m, e
464: 	}
465: 	for name, raw := range files {
466: 		encrypted, e := backupEncrypt(a, m.ID, name, raw)
467: 		if e != nil {
468: 			return m, e
469: 		}
470: 		if e = backupWrite(filepath.Join(stage, name+".enc"), encrypted); e != nil {
471: 			return m, e
472: 		}
473: 		m.Files = append(m.Files, BackupFile{Name: name, Hash: Digest(raw), Size: len(raw)})
474: 	}
475: 	sort.Slice(m.Files, func(i, j int) bool { return m.Files[i].Name < m.Files[j].Name })
476: 	m.MAC = backupMAC(m, key)
477: 	if e = backupWrite(filepath.Join(stage, "manifest.json"), Bytes(m)); e != nil {
478: 		return m, e
479: 	}
480: 	for _, suffix := range []string{"", "-wal", "-shm"} {
481: 		if e = os.Remove(plain + suffix); e != nil && !os.IsNotExist(e) {
482: 			return m, e
483: 		}
484: 	}
485: 	if e = ctx.Err(); e != nil {
486: 		return m, e
487: 	}
488: 	if e = os.Rename(stage, destination); e != nil {
489: 		return m, e
490: 	}
491: 	return m, nil
492: }
