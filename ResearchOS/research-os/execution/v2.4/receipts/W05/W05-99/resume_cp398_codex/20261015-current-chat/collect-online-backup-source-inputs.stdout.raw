290: func backupIntegrityPolicy(db *sql.DB, policy *backupPolicy) error {
291: 	if err := validateBackupHostConfiguration(db); err != nil {
292: 		return err
293: 	}
294: 	if err := validateBackupQueue(db); err != nil {
295: 		return err
296: 	}
297: 	if policy != nil && policy.validate != nil {
298: 		if e := policy.validate(db); e != nil {
299: 			return e
300: 		}
301: 	}
302: 	var result string
303: 	if e := db.QueryRow("PRAGMA integrity_check").Scan(&result); e != nil {
304: 		return e
305: 	}
306: 	if result != "ok" {
307: 		return fmt.Errorf("BACKUP_DB_INTEGRITY")
308: 	}
309: 	rows, e := db.Query("PRAGMA foreign_key_check")
310: 	if e != nil {
311: 		return e
312: 	}
313: 	bad := rows.Next()
314: 	e = rows.Err()
315: 	rows.Close()
316: 	if e != nil {
317: 		return e
318: 	}
319: 	if bad {
320: 		return fmt.Errorf("BACKUP_DANGLING_REFERENCE")
321: 	}
322: 	// Every version, including historical accepted evidence, must retain its bytes.
323: 	arts, e := backupObjects(db, "SELECT body FROM domain_versions WHERE kind='Artifact'")
324: 	if e != nil {
325: 		return e
326: 	}
327: 	for _, o := range arts {
328: 		if o["access_class"] != "PROJECT" {
329: 			if policy == nil || policy.allowProtected == nil {
330: 				return fmt.Errorf("PROTECTED_BACKUP_REQUIRES_W17")
331: 			}
332: 			if e = policy.allowProtected(db, o); e != nil {
333: 				return e
334: 			}
335: 			continue
336: 		}
337: 		var raw []byte
338: 		var hash string
339: 		var sealed int
340: 		if e = db.QueryRow("SELECT bytes,content_hash,sealed FROM uploaded_content WHERE storage_key=? AND project=?", o["storage_key"], o["project_id"]).Scan(&raw, &hash, &sealed); e != nil {
341: 			return fmt.Errorf("BACKUP_ARTIFACT_MISSING")
342: 		}
343: 		if sealed != 1 || Digest(raw) != hash || hash != o["content_hash"] {
344: 			return fmt.Errorf("BACKUP_ARTIFACT_HASH")
345: 		}
346: 	}
347: 	receipts, e := backupObjects(db, "SELECT body FROM domain_versions WHERE json_type(body,'$.receipt_hash')='text'")
348: 	if e != nil {
349: 		return e
350: 	}
351: 	for _, o := range receipts {
352: 		if o["receipt_hash"] != Receipt(o) {
353: 			return fmt.Errorf("BACKUP_RECEIPT_HASH")
354: 		}
355: 	}
356: 	return nil
357: }
