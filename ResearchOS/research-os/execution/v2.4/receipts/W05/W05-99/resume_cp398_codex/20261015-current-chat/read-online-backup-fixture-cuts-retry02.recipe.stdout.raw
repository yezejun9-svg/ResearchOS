{"intake": {"path": "execution/v2.4/receipts/W05/W05-99/online_backup_source_resource_map_codex/20261015-current-chat/fixture-qualification-intake03/intake.json", "bytes": 3555, "sha256": "a219ad483e14c2fd57b3f63911552bc077f35610feb44c1e5bc5e2c2c001ab79"}, "selections": {"internal/domain/backup_test.go": "1: package domain\n2: \n3: import (\n4: \t\"context\"\n5: \t\"crypto/rand\"\n6: \t\"database/sql\"\n7: \t\"encoding/json\"\n8: \t\"fmt\"\n9: \t\"os\"\n10: \t\"path/filepath\"\n11: \t\"researchos.local/research-os/adapters/sources\"\n12: \t\"researchos.local/research-os/internal/store\"\n13: \t\"runtime\"\n14: \t\"strings\"\n15: \t\"sync\"\n16: \t\"testing\"\n17: \t\"time\"\n18: )\n19: \n20: func backupAssert(t *testing.T, id string, want, got, evidence any) {\n21: \tt.Helper()\n22: \tstatus := \"PASS\"\n23: \tif Hash(want) != Hash(got) {\n24: \t\tstatus = \"FAIL\"\n25: \t}\n26: \tfmt.Println(\"W18_ASSERTION \" + string(Bytes(Object{\"assertion_id\": id, \"expected\": want, \"actual\": got, \"status\": status, \"evidence\": evidence})))\n27: \tif status != \"PASS\" {\n28: \t\tt.Fatal(id)\n29: \t}\n30: }\n31: func backupTestKey(t *testing.T) []byte {\n32: \tt.Helper()\n33: \tb := make([]byte, 32)\n34: \tif _, e := rand.Read(b); e != nil {\n35: \t\tt.Fatal(e)\n36: \t}\n37: \treturn b\n38: }\n39: func backupOpt(t *testing.T, s *Service, key []byte) RestoreOptions {\n40: \tt.Helper()\n41: \tv, e := backupMigrations(s.DB)\n42: \tif e != nil {\n43: \t\tt.Fatal(e)\n44: \t}\n45: \treturn RestoreOptions{Key: key, SupportedMigrations: v, Contracts: s.Contracts}\n46: }\n47: func backupTestCreate(t *testing.T, s *Service, key []byte) (string, BackupManifest) {\n48: \tt.Helper()\n49: \tp := filepath.Join(t.TempDir(), \"backup\")\n50: \tm, e := s.CreateBackup(context.Background(), p, key)\n51: \tif e != nil {\n52: \t\tt.Fatal(e)\n53: \t}\n54: \treturn p, m\n55: }\n56: func backupEvidence(t *testing.T, name string, v any) {\n57: \tt.Helper()\n58: \tif dir := os.Getenv(\"W18_EVIDENCE_DIR\"); dir != \"\" {\n59: \t\tif e := os.WriteFile(filepath.Join(dir, name), Bytes(v), 0600); e != nil {\n60: \t\t\tt.Fatal(e)\n61: \t\t}\n62: \t}\n63: }\n64: \n65: func TestW18RestoreNative(t *testing.T) {", "internal/domain/backup_cli_test.go": "1: package domain\n2: \n3: import (\n4: \t\"context\"\n5: \t\"encoding/json\"\n6: \t\"os\"\n7: \t\"os/exec\"\n8: \t\"path/filepath\"\n9: \t\"testing\"\n10: )\n11: \n12: func TestW18CLI(t *testing.T) {\n13: \tgoexe := os.Getenv(\"RESEARCHOS_GO\")\n14: \tif goexe == \"\" {\n15: \t\tvar e error\n16: \t\tgoexe, e = exec.LookPath(\"go\")\n17: \t\tif e != nil {\n18: \t\t\tt.Fatal(\"RESEARCHOS_GO required for CLI acceptance\")\n19: \t\t}\n20: \t}\n21: \tf := contextFixture(t)\n22: \tf.artifact(Object{\"portable\": \"CLI export preserves provenance\"}, Empty())\n23: \tvar dbpath, name string\n24: \tvar seq int\n25: \tif e := f.db.QueryRow(\"PRAGMA database_list\").Scan(&seq, &name, &dbpath); e != nil {\n26: \t\tt.Fatal(e)\n27: \t}\n28: \twork := t.TempDir()\n29: \tkey := filepath.Join(work, \"separate.key\")\n30: \tpack := filepath.Join(work, \"export\")\n31: \ttarget := filepath.Join(work, \"restored\")\n32: \tcommands := []any{}\n33: \tinvoke := func(args ...string) []byte {\n34: \t\tt.Helper()\n35: \t\tcmd := exec.Command(goexe, append([]string{\"run\", \"./ops/backup\"}, args...)...)\n36: \t\tcmd.Dir = \"../..\"\n37: \t\traw, e := cmd.CombinedOutput()\n38: \t\tif e != nil {\n39: \t\t\tt.Fatalf(\"CLI %v: %v %s\", args, e, raw)\n40: \t\t}\n41: \t\tcommands = append(commands, Object{\"argv\": cmd.Args, \"exit_code\": 0, \"output_sha256\": Digest(raw)})\n42: \t\treturn raw\n43: \t}\n44: \tinvoke(\"keygen\", \"--key-file\", key)\n45: \traw := invoke(\"export\", \"--db\", dbpath, \"--out\", pack, \"--key-file\", key)\n46: \tvar manifest BackupManifest\n47: \tif e := json.Unmarshal(raw, &manifest); e != nil {\n48: \t\tt.Fatal(e)\n49: \t}\n50: \traw = invoke(\"restore\", \"--backup\", pack, \"--out\", target, \"--key-file\", key)\n51: \tvar report RestoreReport\n52: \tif e := json.Unmarshal(raw, &report); e != nil {\n53: \t\tt.Fatal(e)\n54: \t}\n55: \tsecret, e := os.ReadFile(key)\n56: \tif e != nil {\n57: \t\tt.Fatal(e)\n58: \t}\n59: \t_, files, e := readBackup(pack, secret)\n60: \tif e != nil {\n61: \t\tt.Fatal(e)\n62: \t}\n63: \tvar portable Object\n64: \tif e = json.Unmarshal(files[\"portable.json\"], &portable); e != nil {\n65: \t\tt.Fatal(e)\n66: \t}\n67: \tbackupAssert(t, \"A12-04-CLI\", true, report.BackupID == manifest.ID && len(Arr(portable, \"objects\")) > 0 && report.Status == \"RESTORED_RECONCILIATION_REQUIRED\", Object{\"commands\": commands, \"manifest\": manifest, \"report\": report})\n68: \t// The encryption key is not evidence and is never copied into the package.\n69: \tif out := os.Getenv(\"W18_EVIDENCE_DIR\"); out != \"\" {\n70: \t\tdest := filepath.Join(out, \"encrypted-cli-package\")\n71: \t\tif e = os.Mkdir(dest, 0700); e != nil {\n72: \t\t\tt.Fatal(e)\n73: \t\t}\n74: \t\tentries, e := os.ReadDir(pack)\n75: \t\tif e != nil {\n76: \t\t\tt.Fatal(e)\n77: \t\t}\n78: \t\tfor _, entry := range entries {\n79: \t\t\tb, e := os.ReadFile(filepath.Join(pack, entry.Name()))\n80: \t\t\tif e != nil {\n81: \t\t\t\tt.Fatal(e)\n82: \t\t\t}\n83: \t\t\tif e = os.WriteFile(filepath.Join(dest, entry.Name()), b, 0600); e != nil {\n84: \t\t\t\tt.Fatal(e)\n85: \t\t\t}\n86: \t\t}\n87: \t\tbackupEvidence(t, \"cli.json\", Object{\"commands\": commands, \"manifest\": manifest, \"report\": report, \"key_retained_in_evidence\": false, \"verification\": \"independent rerun generates a new key/package; original package remains encrypted\"})\n88: \t}\n89: \t// Repeating create refuses overwrite and leaves the stable manifest unchanged.\n90: \t_, e = f.s.CreateBackup(context.Background(), pack, secret)\n91: \tbackupAssert(t, \"W18-CLI-NO-OVERWRITE\", true, e != nil, Object{\"error\": e.Error()})\n92: \tclear(secret)\n93: }", "internal/domain/backup_workspace.go": "1: package domain\n2: \n3: import (\n4: \t\"context\"\n5: \t\"database/sql\"\n6: \t\"encoding/json\"\n7: \t\"fmt\"\n8: \t\"os\"\n9: \t\"path/filepath\"\n10: \t\"sort\"\n11: \t\"strings\"\n12: )\n13: \n14: // Workspace contents are bounded rather than silently omitted. These limits cover the\n15: // entire backup, not each workspace independently.\n16: const (\n17: \tBackupWorkspaceMaxRoots     = 8\n18: \tBackupWorkspaceMaxFiles     = 4096\n19: \tBackupWorkspaceMaxDirs      = 4096\n20: \tBackupWorkspaceMaxPathBytes = 4096\n21: \tBackupWorkspaceMaxBytes     = 256 << 20\n22: \tBackupWorkspaceMaxFileBytes = 16 << 20\n23: )\n24: \n25: type BackupWorkspaceLimits struct {\n26: \tMaxFiles     int\n27: \tMaxDirs      int\n28: \tMaxBytes     int64\n29: \tMaxFileBytes int64\n30: }\n31: \n32: type BackupWorkspaceFile struct {\n33: \tPath string\n34: \tData []byte\n35: }\n36: \n37: type BackupWorkspaceSnapshot struct {\n38: \tDirectories []string\n39: \tFiles       []BackupWorkspaceFile\n40: }\n41: \n42: // WorkspaceBackupSource must verify an existing Host root binding, current pin,\n43: // revocation and OS ownership before reading any path. A database path alone is\n44: // never permission to read a workspace.\n45: type WorkspaceBackupSource interface {\n46: \tSnapshotWorkspace(context.Context, WorkspaceBinding, string, BackupWorkspaceLimits) (BackupWorkspaceSnapshot, error)\n47: }\n48: \n49: type WorkspaceRestoreRequest struct {\n50: \tAuthorizedRef string\n51: \tRealPath      string\n52: \tAccess        string\n53: \tPrincipalID   string\n54: }\n55: \n56: type WorkspaceRestorePin struct {\n57: \tAuthorizedRef    string\n58: \tRealPath         string\n59: \tHostPrincipalRef string\n60: }\n61: \n62: // WorkspaceRestoreTarget runs only after the isolated restored data root has\n63: // been published. It must bind a fresh Host root to each requested final path.\n64: // The database remains RESTORE_PENDING until every pin has been verified.\n65: type WorkspaceRestoreTarget func(context.Context, string, []WorkspaceRestoreRequest) ([]WorkspaceRestorePin, error)\n66: \n67: type backupWorkspaceIndex struct {\n68: \tFormat string                `json:\"format\"`\n69: \tRoots  []backupWorkspaceRoot `json:\"roots\"`\n70: }\n71: \n72: type backupWorkspaceRoot struct {\n73: \tRef         string                `json:\"ref\"`\n74: \tSourcePath  string                `json:\"source_path\"`\n75: \tAccess      string                `json:\"access\"`\n76: \tPrincipalID string                `json:\"principal_id\"`\n77: \tDirectories []string              `json:\"directories\"`\n78: \tFiles       []backupWorkspaceFile `json:\"files\"`\n79: }\n80: \n81: type backupWorkspaceFile struct {\n82: \tPath string `json:\"path\"`\n83: \tBlob string `json:\"blob\"`\n84: \tHash string `json:\"hash\"`\n85: \tSize int    `json:\"size\"`\n86: }\n87: \n88: func (s *Service) CreateBackupWithWorkspaces(ctx context.Context, destination string, key []byte, source WorkspaceBackupSource) (BackupManifest, error) {\n89: \tif source == nil {\n90: \t\treturn BackupManifest{}, fmt.Errorf(\"BACKUP_WORKSPACE_SOURCE_REQUIRED\")\n91: \t}\n92: \treturn s.createBackupPolicy(ctx, destination, key, nil, source)\n93: }\n94: \n95: func workspaceBackupBindings(db *sql.DB) ([]WorkspaceBinding, error) {\n96: \trows, err := db.Query(`SELECT body FROM domain_objects WHERE project='' AND kind=? ORDER BY id`, KindWorkspaceBinding)\n97: \tif err != nil {\n98: \t\treturn nil, err\n99: \t}\n100: \tdefer rows.Close()\n101: \tbindings := []WorkspaceBinding{}\n102: \tfor rows.Next() {\n103: \t\tvar raw string\n104: \t\tif err := rows.Scan(&raw); err != nil {\n105: \t\t\treturn nil, err\n106: \t\t}\n107: \t\tbinding, err := decodeBinding(raw)\n108: \t\tif err != nil {\n109: \t\t\treturn nil, err\n110: \t\t}\n111: \t\tif binding.Status == WorkspaceActive {\n112: \t\t\tbindings = append(bindings, *binding)\n113: \t\t} else if binding.Status != WorkspaceRevoked {\n114: \t\t\treturn nil, fmt.Errorf(\"BACKUP_WORKSPACE_STATUS_INVALID\")\n115: \t\t}\n116: \t}\n117: \treturn bindings, rows.Err()\n118: }\n119: \n120: func backupWorkspaceBlobName(ref, rel string) string {\n121: \treturn \"workspace-\" + strings.TrimPrefix(Digest([]byte(ref+\"\\x00\"+rel)), \"sha256:\") + \".bin\"\n122: }\n123: \n124: func backupWorkspaceDirectory(destination, ref string) string {\n125: \treturn filepath.Join(destination, \"workspaces\", strings.TrimPrefix(Digest([]byte(ref)), \"sha256:\"))\n126: }\n127: \n128: func backupWorkspaceOverlaps(left, right string) bool {\n129: \ta, ea := filepath.Abs(left)\n130: \tb, eb := filepath.Abs(right)\n131: \tif ea != nil || eb != nil {\n132: \t\treturn true\n133: \t}\n134: \tif strings.EqualFold(filepath.Clean(a), filepath.Clean(b)) {\n135: \t\treturn true\n136: \t}\n137: \tfor _, pair := range [][2]string{{a, b}, {b, a}} {\n138: \t\trel, err := filepath.Rel(pair[0], pair[1])\n139: \t\tif err == nil && rel != \"..\" && !strings.HasPrefix(rel, \"..\"+string(filepath.Separator)) && !filepath.IsAbs(rel) {\n140: \t\t\treturn true\n141: \t\t}\n142: \t}\n143: \treturn false\n144: }\n145: ", "internal/domain/runtime_model_stream_test.go": "1: package domain\n2: \n3: import (\n4: \t\"bytes\"\n5: \t\"context\"\n6: \t\"database/sql\"\n7: \t\"encoding/json\"\n8: \t\"fmt\"\n9: \t\"os\"\n10: \t\"path/filepath\"\n11: \t\"researchos.local/research-os/internal/store\"\n12: \t\"strings\"\n13: \t\"testing\"\n14: )\n15: \n16: func streamTestEvent(text string) []byte {\n17: \traw, _ := json.Marshal(map[string]any{\"choices\": []any{map[string]any{\"index\": 0, \"delta\": map[string]any{\"content\": text}}}})\n18: \treturn append(append([]byte(\"data: \"), raw...), []byte(\"\\n\\n\")...)\n19: }\n20: \n21: func modelStreamArchivedFixture(t *testing.T) (*sql.DB, *Service) {\n22: \tt.Helper()\n23: \tpath := filepath.Join(\"..\", \"..\", \"execution\", \"v2.4\", \"receipts\", \"W05\", \"W05-99\", \"model_stream_executor_codex\", \"test-f4a65b87734641c8a39d7060dd8b24fb\", \"actual-fixtures\", \"TestCLIModelStreamInterruptedPrefix\", \"fixture.sqlite\")\n24: \traw, err := os.ReadFile(path)\n25: \tif err != nil {\n26: \t\tt.Fatal(err)\n27: \t}\n28: \tcopy := filepath.Join(t.TempDir(), \"state.sqlite\")\n29: \tif err = os.WriteFile(copy, raw, 0600); err != nil {\n30: \t\tt.Fatal(err)\n31: \t}\n32: \tdb, err := store.Open(copy)\n33: \tif err != nil {\n34: \t\tt.Fatal(err)\n35: \t}\n36: \tt.Cleanup(func() { db.Close() })\n37: \tcontracts, err := LoadContracts(\"../../spec/v2.0/contracts\")\n38: \tif err != nil {\n39: \t\tt.Fatal(err)\n40: \t}\n41: \treturn db, &Service{DB: db, Contracts: contracts}\n42: }\n43: \n44: func TestModelStreamInterruptedActualBackupRestore(t *testing.T) {\n45: \tdb, s := modelStreamArchivedFixture(t)\n46: \tif err := validateBackupQueue(db); err != nil {\n47: \t\tt.Fatal(\"original observed partial\", err)\n48: \t}\n49: \t// This copy is a local fixture. Revoke the already removed fixture workspace,\n50: \t// exactly as the existing queue restore suite does; original bytes stay sealed.\n51: \tif _, err := db.Exec(`UPDATE domain_objects SET body=json_set(body,'$.status','REVOKED') WHERE kind='WorkspaceBinding'`); err != nil {\n52: \t\tt.Fatal(err)\n53: \t}\n54: \tvar before string\n55: \tif err := db.QueryRow(`SELECT group_concat(body,'') FROM client_control_receipts WHERE kind=? ORDER BY rowid`, modelObservationKind).Scan(&before); err != nil {\n56: \t\tt.Fatal(err)\n57: \t}\n58: \tkey := backupTestKey(t)\n59: \tarchive, _ := backupTestCreate(t, s, key)\n60: \tdestination := filepath.Join(t.TempDir(), \"restored\")\n61: \treport, err := RestoreBackup(context.Background(), archive, destination, backupOpt(t, s, key))\n62: \tif err != nil {\n63: \t\tt.Fatal(err)\n64: \t}\n65: \tif report.Status != \"RESTORED_RECONCILIATION_REQUIRED\" {\n66: \t\tt.Fatal(report.Status)\n67: \t}\n68: \trestored, err := store.Open(filepath.Join(destination, \"state.sqlite\"))\n69: \tif err != nil {\n70: \t\tt.Fatal(err)\n71: \t}\n72: \tdefer restored.Close()\n73: \tif err = validateBackupQueue(restored); err != nil {\n74: \t\tt.Fatal(\"restored immutable prefix\", err)\n75: \t}\n76: \tvar after string\n77: \tvar unknown, ends, fenced int\n78: \tif err = restored.QueryRow(`SELECT group_concat(body,'') FROM client_control_receipts WHERE kind=? ORDER BY rowid`, modelObservationKind).Scan(&after); err != nil {\n79: \t\tt.Fatal(err)\n80: \t}\n81: \trestored.QueryRow(`SELECT count(*) FROM resource_effects x WHERE json_extract(body,'$.state')='UNKNOWN' AND sequence=(SELECT max(y.sequence) FROM resource_effects y WHERE y.project=x.project AND y.run=x.run AND y.effect_key=x.effect_key)`).Scan(&unknown)\n82: \trestored.QueryRow(`SELECT count(*) FROM outbox WHERE json_extract(body,'$.kind')='MESSAGE' AND json_extract(body,'$.payload.role')='ASSISTANT' AND json_extract(body,'$.payload.phase')='END'`).Scan(&ends)\n83: \trestored.QueryRow(`SELECT count(*) FROM client_queue_fences WHERE restore_fenced=1 AND state='RECONCILING'`).Scan(&fenced)\n84: \tif before != after || unknown != 1 || ends != 0 || fenced != 1 {\n85: \t\tt.Fatalf(\"partial restore changed facts equal=%v UNKNOWN=%d END=%d fenced=%d\", before == after, unknown, ends, fenced)\n86: \t}\n87: \t// The old process/sequence cannot turn the restored prefix into a current live\n88: \t// stream. Restore preserves the evidence and fences its execution separately.\n89: \tt.Logf(\"MODEL_STREAM_RESTORE immutable=%v UNKNOWN=%d END=%d restore_fenced=%d\", before == after, unknown, ends, fenced)\n90: }", "ops/backup/main.go": "1: // backup is a local administrative command; it starts no server or worker.\n2: package main\n3: \n4: import (\n5: \t\"context\"\n6: \t\"crypto/rand\"\n7: \t\"database/sql\"\n8: \t\"encoding/json\"\n9: \t\"flag\"\n10: \t\"fmt\"\n11: \t\"os\"\n12: \t\"path/filepath\"\n13: \t\"researchos.local/research-os/internal/domain\"\n14: \thostboundary \"researchos.local/research-os/internal/host\"\n15: \t\"researchos.local/research-os/internal/store\"\n16: \t\"strconv\"\n17: \t\"strings\"\n18: )\n19: \n20: func main() {\n21: \tif e := run(); e != nil {\n22: \t\tfmt.Fprintln(os.Stderr, e)\n23: \t\tos.Exit(1)\n24: \t}\n25: }\n26: func run() error {\n27: \tif len(os.Args) < 2 {\n28: \t\treturn fmt.Errorf(\"usage: backup keygen|create|export|restore|upgrade-local|upgrade-prepared-backup [flags]\")\n29: \t}\n30: \tcommand := os.Args[1]\n31: \tf := flag.NewFlagSet(command, flag.ContinueOnError)\n32: \tsource := f.String(\"db\", \"\", \"existing source SQLite database\")\n33: \tbackup := f.String(\"backup\", \"\", \"existing encrypted backup directory\")\n34: \tout := f.String(\"out\", \"\", \"new destination (must not exist)\")\n35: \tkeyfile := f.String(\"key-file\", \"\", \"separate recovery key file; never command-line key bytes\")\n36: \troot := f.String(\"root\", \".\", \"matching application repository root\")\n37: \tasDataRoot := f.Bool(\"as-data-root\", false, \"restore an operational data root (researchos.sqlite plus fresh Host bindings)\")\n38: \tsourceRoot := f.String(\"source-root\", \"\", \"upgrade: exact schema13 release root\")\n39: \tsourceProgram := f.String(\"source-program\", \"\", \"upgrade: preserved matching old program\")\n40: \ttargetProgram := f.String(\"target-program\", \"\", \"upgrade: reviewed target program\")\n41: \tplan := f.String(\"plan\", \"\", \"upgrade: schema13-to14-remote-access-v1 or schema13-to20-research-runtime-v1 (exact releases only)\")\n42:     handoffBinding := f.String(\"handoff-binding\", \"\", \"upgrade-prepared-backup: externally reviewed and pinned producer binding\")\n43:     handoffSHA256 := f.String(\"handoff-binding-sha256\", \"\", \"upgrade-prepared-backup: expected sha256: digest of binding\")\n44: \tif e := f.Parse(os.Args[2:]); e != nil {\n45: \t\treturn e\n46: \t}\n47: \tif f.NArg() != 0 {\n48: \t\treturn fmt.Errorf(\"unexpected positional arguments\")\n49: \t}\n50: \tif *keyfile == \"\" {\n51: \t\treturn fmt.Errorf(\"--key-file required\")\n52: \t}\n53: \tif command == \"keygen\" {\n54: \t\tkey := make([]byte, 32)\n55: \t\tif _, e := rand.Read(key); e != nil {\n56: \t\t\treturn e\n57: \t\t}\n58: \t\tf, e := os.OpenFile(*keyfile, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)\n59: \t\tif e != nil {\n60: \t\t\treturn e\n61: \t\t}\n62: \t\tdefer f.Close()\n63: \t\tif _, e = f.Write(key); e != nil {\n64: \t\t\treturn e\n65: \t\t}\n66: \t\tif e = f.Sync(); e != nil {\n67: \t\t\treturn e\n68: \t\t}\n69: \t\tfmt.Println(`{\"status\":\"KEY_CREATED_SEPARATELY\",\"key_bytes_printed\":false}`)\n70: \t\treturn nil\n71: \t}\n72: \tif command != \"create\" && command != \"export\" && command != \"restore\" && command != \"upgrade-local\" && command != \"upgrade-prepared-backup\" {\n73: \t\treturn fmt.Errorf(\"unknown command\")\n74: \t}\n75: \tif *out == \"\" {\n76: \t\treturn fmt.Errorf(\"--out required\")\n77: \t}\n78:     if command == \"upgrade-prepared-backup\" {\n79:         r, e := domain.UpgradePreparedAbandonmentBackup(context.Background(), domain.PreparedBackupHandoffOptions{\n80:             Upgrade: domain.LocalUpgradeOptions{\n81:                 Source: *source, Snapshot: *backup, Destination: *out, KeyFile: *keyfile,\n82:                 SourceRoot: *sourceRoot, TargetRoot: *root, SourceProgram: *sourceProgram,\n83:                 TargetProgram: *targetProgram, Plan: *plan,\n84:             },\n85:             BindingFile: *handoffBinding, BindingSHA256: *handoffSHA256,\n86:         })\n87:         if e != nil { return e }\n88:         return json.NewEncoder(os.Stdout).Encode(r)\n89:     }\n90: \tif command == \"upgrade-local\" {\n91: \t\tr, e := domain.UpgradeLocal(context.Background(), domain.LocalUpgradeOptions{\n92: \t\t\tSource: *source, Snapshot: *backup, Destination: *out, KeyFile: *keyfile,\n93: \t\t\tSourceRoot: *sourceRoot, TargetRoot: *root, SourceProgram: *sourceProgram,\n94: \t\t\tTargetProgram: *targetProgram, Plan: *plan,\n95: \t\t})\n96: \t\tif e != nil {\n97: \t\t\treturn e\n98: \t\t}\n99: \t\treturn json.NewEncoder(os.Stdout).Encode(r)\n100: \t