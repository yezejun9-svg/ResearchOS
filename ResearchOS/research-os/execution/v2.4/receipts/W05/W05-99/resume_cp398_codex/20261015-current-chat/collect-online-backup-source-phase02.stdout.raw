107: func New(cfg Config) (*Host, error) {
108: 	if cfg.DB == nil || cfg.Dir == "" || cfg.ContractsDir == "" || cfg.MigrationFile == "" || cfg.SchemaDir == "" {
109: 		return nil, fmt.Errorf("%w: db, dir, contracts, migration and schema are required", ErrBadState)
110: 	}
111: 	if cfg.ReadOnlyModelVaultDir != "" {
112: 		if cfg.ReadOnlyModelCredentialRef == "" || cfg.ReadOnlyModelProvider == "" ||
113: 			filepath.Base(cfg.Dir) != "host" ||
114:             ValidateTrialStorageLayout(filepath.Dir(cfg.Dir), cfg.Dir, cfg.ReadOnlyModelVaultDir) != nil {
115: 			return nil, ErrUnknownCredential
116: 		}
117: 	} else if cfg.ReadOnlyModelCredentialRef != "" || cfg.ReadOnlyModelProvider != "" {
118: 		return nil, ErrUnknownCredential
119: 	}
120: 	ttl := cfg.SessionTTL
121: 	if ttl <= 0 || ttl > MaxSessionTTL {
122: 		ttl = DefaultSessionTTL
123: 	}
124: 	now := cfg.Now
125: 	if now == nil {
126: 		now = func() time.Time { return time.Now().UTC() }
127: 	}
128: 	id, err := auth.Current()
129: 	if err != nil {
130: 		return nil, err
131: 	}
132: 	if !verifiableKind(id.Kind) {
133: 		return nil, fmt.Errorf("%w: host identity kind %s is not a verifiable local principal", ErrHostIdentity, id.Kind)
134: 	}
135: 	if err := os.MkdirAll(cfg.Dir, 0o700); err != nil {
136: 		return nil, err
137: 	}
138: 	if cfg.ReadOnlyModelVaultDir != "" &&
139: 		ValidateTrialStorageLayout(filepath.Dir(cfg.Dir), cfg.Dir, cfg.ReadOnlyModelVaultDir) != nil {
140: 		return nil, ErrUnknownCredential
141: 	}
142: 	if err := privateDir(cfg.Dir); err != nil {
143: 		return nil, fmt.Errorf("private host directory refused: %w", err)
144: 	}
145: 	doc, err := loadSchema(cfg.SchemaDir)
146: 	if err != nil {
147: 		return nil, err
148: 	}
149: 	svc, err := domain.NewCurrentMu(cfg.DB, cfg.ContractsDir, cfg.MigrationFile)
150: 	if err != nil {
151: 		return nil, err
152: 	}
153: 	h := &Host{db: cfg.DB, domain: svc, dir: cfg.Dir, ttl: ttl, identity: id, now: now, doc: doc}
154: 	h.peerLookup = cfg.PeerIdentityResolver
155: 	if h.peerLookup == nil {
156: 		h.peerLookup = auth.ProcessIdentity
157: 	}
158: 	h.protocolVersion = cfg.ProtocolVersion
159: 	if h.protocolVersion == "" {
160: 		h.protocolVersion = nativeProtocolVersion
161: 	}
162: 	if cfg.ReadOnlyModelVaultDir != "" {
163: 		if h.vault, err = openVaultReadOnly(cfg.ReadOnlyModelVaultDir,
164: 			cfg.ReadOnlyModelCredentialRef, cfg.ReadOnlyModelProvider); err != nil {
165: 			return nil, err
