1: package domain
2: 
3: import (
4: 	"database/sql"
5: 	"encoding/json"
6: 	"fmt"
7: 	"sort"
8: )
9: 
10: var clientQueueTables = []string{"client_queue_fences", "client_command_queue", "client_control_requests", "client_control_receipts"}
11: 
12: func backupQueueState(db *sql.DB) (Object, error) {
13: 	var version int
14: 	if err := db.QueryRow(`SELECT coalesce(max(version),0) FROM schema_migrations`).Scan(&version); err != nil {
15: 		return nil, err
16: 	}
17: 	if version < 22 {
18: 		return nil, nil
19: 	}
20: 	state := Object{"format": "RESEARCHOS_COMMAND_QUEUE_V1"}
21: 	for _, table := range clientQueueTables {
22: 		rows, err := db.Query(`SELECT * FROM ` + table)
23: 		if err != nil {
24: 			return nil, err
25: 		}
26: 		cols, err := rows.Columns()
27: 		if err != nil {
28: 			rows.Close()
29: 			return nil, err
30: 		}
31: 		entries := []Object{}
32: 		for rows.Next() {
33: 			values := make([]any, len(cols))
34: 			ptrs := make([]any, len(cols))
35: 			for i := range values {
36: 				ptrs[i] = &values[i]
37: 			}
38: 			if err = rows.Scan(ptrs...); err != nil {
39: 				rows.Close()
40: 				return nil, err
41: 			}
42: 			entry := Object{}
43: 			for i, col := range cols {
44: 				entry[col] = values[i]
45: 			}
46: 			entries = append(entries, entry)
47: 		}
48: 		err = rows.Err()
49: 		rows.Close()
50: 		if err != nil {
51: 			return nil, err
52: 		}
53: 		sort.Slice(entries, func(i, j int) bool { return Hash(entries[i]) < Hash(entries[j]) })
54: 		state[table] = entries
55: 	}
56: 	return state, nil
57: }
58: 
59: func validateBackupQueue(db *sql.DB) error {
60: 	state, err := backupQueueState(db)
61: 	if err != nil || state == nil {
62: 		return err
63: 	}
64: 	for _, query := range []string{
65: 		`SELECT count(*) FROM client_queue_fences f LEFT JOIN client_sessions s ON s.project_id=f.project AND s.id=f.session_id LEFT JOIN domain_objects t ON t.project=f.project AND t.kind='Task' AND t.id=f.task_id WHERE s.id IS NULL OR t.id IS NULL OR f.accepted_through<0 OR f.sealed_through<0 OR f.sealed_through>f.accepted_through OR (f.state='SEALED' AND f.sealed_through<>f.accepted_through)`,
66: 		`SELECT count(*) FROM client_queue_fences f WHERE f.run_id IS NOT NULL AND NOT EXISTS(SELECT 1 FROM domain_objects r WHERE r.project=f.project AND r.kind='Run' AND r.id=f.run_id AND json_extract(r.body,'$.task_id')=f.task_id AND json_extract(r.body,'$.lease_epoch')=f.runtime_epoch)`,
67: 		`SELECT count(*) FROM client_command_queue q LEFT JOIN client_queue_fences f ON f.generation=q.generation LEFT JOIN domain_objects t ON t.project=q.project AND t.kind='Task' AND t.id=q.task_id WHERE f.generation IS NULL OR f.project<>q.project OR f.task_id<>q.task_id OR f.session_id<>q.session_id OR json_extract(t.body,'$.goal_id') IS NOT q.goal_id OR t.id IS NULL OR q.queue_sequence<1 OR q.queue_sequence>f.accepted_through OR q.accepted_writer_epoch<1`,
68: 		`SELECT count(*) FROM client_queue_fences f WHERE f.accepted_through<>(SELECT count(*) FROM client_command_queue q WHERE q.generation=f.generation)`,
69: 		`SELECT count(*) FROM client_command_queue q WHERE (q.state<>'ENQUEUED' AND q.last_receipt_id IS NULL) OR (q.last_receipt_id IS NOT NULL AND NOT EXISTS(SELECT 1 FROM client_control_receipts r WHERE r.receipt_id=q.last_receipt_id AND r.project=q.project AND r.generation=q.generation AND r.command_id=q.command_id))`,
70: 		`SELECT count(*) FROM client_control_receipts r WHERE NOT EXISTS(SELECT 1 FROM client_queue_fences f WHERE f.project=r.project AND f.generation=r.generation) OR (r.previous_receipt_id IS NOT NULL AND NOT EXISTS(SELECT 1 FROM client_control_receipts p WHERE p.receipt_id=r.previous_receipt_id AND p.project=r.project AND p.generation=r.generation AND p.command_id=r.command_id AND p.receipt_id<>r.receipt_id))`,
71: 		`SELECT count(*) FROM client_control_requests c WHERE NOT EXISTS(SELECT 1 FROM client_sessions s WHERE s.id=c.session_id AND s.project_id=c.project) OR NOT json_valid(c.task_ids) OR json_array_length(c.task_ids)=0 OR (c.state='CONFIRMED' AND c.final_response IS NULL)`,
72: 	} {
73: 		var n int
74: 		if err = db.QueryRow(query).Scan(&n); err != nil {
75: 			return err
76: 		}
77: 		if n != 0 {
78: 			return fmt.Errorf("BACKUP_QUEUE_BINDING: %d invalid rows", n)
79: 		}
80: 	}
81: 	for _, query := range []string{
82: 		`SELECT count(*) FROM client_command_queue q WHERE NOT EXISTS(SELECT 1 FROM idempotency i WHERE i.principal=q.principal AND i.project=q.project AND i.operation='v2:session.send' AND i.key=q.command_id AND i.request_hash=q.request_hash)`,
83: 		`SELECT count(*) FROM client_control_requests c WHERE NOT EXISTS(SELECT 1 FROM idempotency i WHERE i.principal=c.principal AND i.project=c.project AND i.operation='v2:session.control' AND i.key=c.command_id AND i.request_hash=c.request_hash) OR c.original_response IS NULL`,
84: 		`SELECT count(*) FROM client_queue_fences f WHERE f.process_identity IS NOT NULL AND NOT EXISTS(SELECT 1 FROM runtime_dispatches d WHERE d.project=f.project AND d.run=f.run_id AND d.epoch=f.runtime_epoch AND d.dispatch_key=f.dispatch_key AND d.manifest_hash=f.manifest_hash AND d.identity=f.process_identity)`} {
85: 		var n int
86: 		if err = db.QueryRow(query).Scan(&n); err != nil {
87: 			return err
88: 		}
89: 		if n != 0 {
90: 			return fmt.Errorf("BACKUP_QUEUE_REQUEST_OR_PROCESS_BINDING")
91: 		}
92: 	}
93: 	for _, row := range state["client_command_queue"].([]Object) {
94: 		if Digest([]byte(Str(row, "content"))) != row["content_hash"] {
95: 			return fmt.Errorf("BACKUP_QUEUE_CONTENT_HASH")
96: 		}
97: 		var content Object
98: 		if json.Unmarshal([]byte(Str(row, "content")), &content) != nil || len(content) != 2 {
99: 			return fmt.Errorf("BACKUP_QUEUE_CONTENT")
100: 		}
101: 
102: 		text, ok := content["text"].(string)
103: 		attachments, valid := content["attachments"].([]any)
104: 		if !ok || !valid || text == "" || len(Str(row, "content")) > 32*1024 {
105: 			return fmt.Errorf("BACKUP_QUEUE_CONTENT_SHAPE")
