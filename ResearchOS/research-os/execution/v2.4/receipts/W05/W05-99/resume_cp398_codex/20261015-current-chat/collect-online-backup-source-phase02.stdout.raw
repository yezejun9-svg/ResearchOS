12: 	_ "modernc.org/sqlite"
13: )
14: 
15: // Open initializes the single local authoritative database connection.
16: func Open(path string) (*sql.DB, error) {
17: 	abs, err := filepath.Abs(path)
18: 	if err != nil {
19: 		return nil, err
20: 	}
21: 	if err := os.MkdirAll(filepath.Dir(abs), 0700); err != nil {
22: 		return nil, err
23: 	}
24: 	u := url.URL{Scheme: "file", Opaque: filepath.ToSlash(abs)}
25: 	q := u.Query()
26: 	q.Set("_foreign_keys", "1")
27: 	q.Set("_journal_mode", "WAL")
28: 	q.Set("_synchronous", "FULL")
29: 	q.Set("_busy_timeout", "5000")
30: 	u.RawQuery = q.Encode()
31: 	db, err := sql.Open("sqlite", u.String())
32: 	if err != nil {
33: 		return nil, err
34: 	}
35: 	db.SetMaxOpenConns(1)
36: 	db.SetMaxIdleConns(1)
37: 	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
38: 	defer cancel()
39: 	if err := db.PingContext(ctx); err != nil {
40: 		db.Close()
41: 		return nil, err
42: 	}
43: 	if err := Ready(ctx, db); err != nil {
44: 		db.Close()
45: 		return nil, err
46: 	}
47: 	return db, nil
48: }
49: 
50: // Ready checks the live connection settings, rather than treating a file as readiness.
51: func Ready(ctx context.Context, db *sql.DB) error {
52: 	for pragma, want := range map[string]string{
53: 		"foreign_keys": "1", "journal_mode": "wal", "synchronous": "2", "busy_timeout": "5000",
54: 	} {
55: 		var got string
56: 		if err := db.QueryRowContext(ctx, "PRAGMA "+pragma).Scan(&got); err != nil {
57: 			return fmt.Errorf("%s: %w", pragma, err)
58: 		}
59: 		if got != want {
60: 			return fmt.Errorf("%s=%s, want %s", pragma, got, want)
61: 		}
62: 	}
63: 	var integrity string
64: 	if err := db.QueryRowContext(ctx, "PRAGMA quick_check").Scan(&integrity); err != nil {
65: 		return err
66: 	}
67: 	if integrity != "ok" {
68: 		return fmt.Errorf("sqlite quick_check: %s", integrity)
69: 	}
70: 	return nil
71: }
72: 
73: // Bootstrap records only the empty storage baseline; W03 owns business tables.
74: func Bootstrap(ctx context.Context, db *sql.DB, migrationFile string) error {
75: 	sqlText, err := os.ReadFile(migrationFile)
76: 	if err != nil {
77: 		return err
78: 	}
79: 	tx, err := db.BeginTx(ctx, nil)
80: 	if err != nil {
81: 		return err
82: 	}
83: 	defer tx.Rollback()
84: 	if _, err := tx.ExecContext(ctx, string(sqlText)); err != nil {
85: 		return err
86: 	}
87: 	if _, err := tx.ExecContext(ctx, `INSERT OR IGNORE INTO schema_migrations(version) VALUES (1)`); err != nil {
88: 		return err
89: 	}
90: 	return tx.Commit()
91: }
