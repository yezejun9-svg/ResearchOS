166: func backupWorkspaceFiles(ctx context.Context, db *sql.DB, source WorkspaceBackupSource, destination string) (map[string][]byte, int, error) {
167: 	bindings, err := workspaceBackupBindings(db)
168: 	if err != nil {
169: 		return nil, 0, err
170: 	}
171: 	if len(bindings) == 0 {
172: 		return nil, 0, nil
173: 	}
174: 	if source == nil {
175: 		return nil, 0, fmt.Errorf("BACKUP_WORKSPACE_SOURCE_REQUIRED: %d active workspace(s)", len(bindings))
176: 	}
177: 	if len(bindings) > BackupWorkspaceMaxRoots {
178: 		return nil, 0, fmt.Errorf("BACKUP_WORKSPACE_ROOT_LIMIT: %d", len(bindings))
179: 	}
180: 	files := map[string][]byte{}
181: 	index := backupWorkspaceIndex{Format: "RESEARCHOS_WORKSPACE_SNAPSHOT_V1", Roots: []backupWorkspaceRoot{}}
182: 	remainingFiles, remainingDirs, remainingBytes := BackupWorkspaceMaxFiles, BackupWorkspaceMaxDirs, int64(BackupWorkspaceMaxBytes)
183: 	for _, b := range bindings {
184: 		if err := ctx.Err(); err != nil {
185: 			return nil, 0, err
186: 		}
187: 		if b.AuthorizedRef == "" || b.RealPath == "" || b.PrincipalID == "" || b.Access != "READ_ONLY" && b.Access != "READ_WRITE" {
188: 			return nil, 0, fmt.Errorf("BACKUP_WORKSPACE_BINDING_INVALID")
189: 		}
190: 		snapshot, err := source.SnapshotWorkspace(ctx, b, destination, BackupWorkspaceLimits{MaxFiles: remainingFiles, MaxDirs: remainingDirs, MaxBytes: remainingBytes, MaxFileBytes: BackupWorkspaceMaxFileBytes})
191: 		if err != nil {
192: 			return nil, 0, fmt.Errorf("BACKUP_WORKSPACE_SNAPSHOT_FAILED %s: %w", b.AuthorizedRef, err)
193: 		}
194: 		if len(snapshot.Files) > remainingFiles || len(snapshot.Directories) > remainingDirs {
195: 			return nil, 0, fmt.Errorf("BACKUP_WORKSPACE_FILE_LIMIT %s", b.AuthorizedRef)
196: 		}
197: 		root := backupWorkspaceRoot{Ref: b.AuthorizedRef, SourcePath: b.RealPath, Access: b.Access, PrincipalID: b.PrincipalID,
198: 			Directories: append([]string{}, snapshot.Directories...), Files: []backupWorkspaceFile{}}
199: 		seen := map[string]bool{}
200: 		for _, dir := range root.Directories {
201: 			if !backupWorkspaceRelative(dir) || seen[dir] {
202: 				return nil, 0, fmt.Errorf("BACKUP_WORKSPACE_DIRECTORY_INVALID %s", b.AuthorizedRef)
203: 			}
204: 			seen[dir] = true
205: 		}
206: 		for _, file := range snapshot.Files {
207: 			if !backupWorkspaceRelative(file.Path) || seen[file.Path] || len(file.Data) > BackupWorkspaceMaxFileBytes || int64(len(file.Data)) > remainingBytes {
208: 				return nil, 0, fmt.Errorf("BACKUP_WORKSPACE_FILE_INVALID_OR_LIMIT %s %s", b.AuthorizedRef, file.Path)
209: 			}
210: 			seen[file.Path] = true
211: 			blob := backupWorkspaceBlobName(b.AuthorizedRef, file.Path)
212: 			if _, exists := files[blob]; exists {
213: 				return nil, 0, fmt.Errorf("BACKUP_WORKSPACE_BLOB_COLLISION")
214: 			}
215: 			files[blob] = file.Data
216: 			root.Files = append(root.Files, backupWorkspaceFile{Path: file.Path, Blob: blob, Hash: Digest(file.Data), Size: len(file.Data)})
217: 			remainingFiles--
218: 			remainingBytes -= int64(len(file.Data))
219: 		}
220: 		sort.Strings(root.Directories)
221: 		sort.Slice(root.Files, func(i, j int) bool { return root.Files[i].Path < root.Files[j].Path })
222: 		remainingDirs -= len(root.Directories)
223: 		index.Roots = append(index.Roots, root)
224: 	}
225: 	files["workspace-index.json"] = Bytes(index)
226: 	return files, len(index.Roots), nil
227: }
