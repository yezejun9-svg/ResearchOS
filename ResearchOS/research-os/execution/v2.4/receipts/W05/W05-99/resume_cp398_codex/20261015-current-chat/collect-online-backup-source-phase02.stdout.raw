170: 	if h.roots, err = openRootRegistry(cfg.Dir); err != nil {
171: 		return nil, err
172: 	}
173: 	if h.selections, err = openSelectionStore(cfg.Dir); err != nil {
174: 		return nil, err
175: 	}
176: 	if h.state, err = loadHostState(cfg.Dir); err != nil {
177: 		return nil, err
178: 	}
179: 	return h, nil
