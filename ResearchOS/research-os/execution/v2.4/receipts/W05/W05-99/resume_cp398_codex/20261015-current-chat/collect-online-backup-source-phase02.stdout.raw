181: 
182: // verifiableKind accepts WINDOWS_SID today; the POSIX path must be re-qualified before it is
183: // trusted as a local principal, so anything else fails closed.
184: func verifiableKind(kind string) bool { return kind == "WINDOWS_SID" }
185: 
186: // Identity exposes the verified OS principal reference (never the raw SID).
187: func (h *Host) Identity() auth.Identity { return h.identity }
188: 
189: // InstanceID is a stable local host identifier for handshake responses; it is derived from
190: // the private directory path plus the principal reference, so it changes if either does.
191: func (h *Host) InstanceID() string {
192: 	sum := sha256.Sum256([]byte(h.dir + "|" + h.identity.Ref))
193: 	return "host-" + hex.EncodeToString(sum[:6])
194: }
195: 
196: // writePrivate stores a file with 0600 plus the current-user-only DACL and a durable rename,
197: // so a crash cannot leave a half-written credential or root registry.
198: func writePrivate(dir, name string, payload any) error {
199: 	raw, err := json.MarshalIndent(payload, "", "  ")
200: 	if err != nil {
201: 		return err
202: 	}
203: 	tmp, err := os.CreateTemp(dir, name+".tmp-")
204: 	if err != nil {
205: 		return err
206: 	}
207: 	defer os.Remove(tmp.Name())
208: 	if err := tmp.Chmod(0o600); err != nil {
209: 		tmp.Close()
210: 		return err
211: 	}
212: 	if _, err := tmp.Write(raw); err != nil {
213: 		tmp.Close()
214: 		return err
215: 	}
216: 	if err := tmp.Sync(); err != nil {
217: 		tmp.Close()
218: 		return err
219: 	}
220: 	if err := tmp.Close(); err != nil {
221: 		return err
222: 	}
223: 	if err := privateFile(tmp.Name()); err != nil {
224: 		return err
225: 	}
226: 	return os.Rename(tmp.Name(), filepath.Join(dir, name))
227: }
228: 
229: func readPrivate(dir, name string, into any) error {
230: 	raw, err := os.ReadFile(filepath.Join(dir, name))
231: 	if err != nil {
232: 		if errors.Is(err, os.ErrNotExist) {
233: 			return nil
234: 		}
235: 		return err
236: 	}
237: 	return json.Unmarshal(raw, into)
238: }
