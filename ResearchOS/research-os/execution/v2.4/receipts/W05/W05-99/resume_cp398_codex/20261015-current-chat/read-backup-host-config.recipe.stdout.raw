{"host_config": [], "key_and_restore": ["106: \t\tif dir == \"\" {\n107: \t\t\tcontinue\n108: \t\t}\n109: \t\tabs, e := filepath.Abs(dir)\n110: \t\tif e != nil {\n111: \t\t\treturn e\n112: \t\t}\n113: \t\trel, e := filepath.Rel(abs, keyPath)\n114: \t\tif e == nil && filepath.IsLocal(rel) {\n115: \t\t\treturn fmt.Errorf(\"KEY_MUST_BE_OUTSIDE_BACKUP_AND_RESTORE\")\n116: \t\t}\n117: \t}\n118: \tkey, e := os.ReadFile(*keyfile)\n119: \tif e != nil || len(key) != 32 {\n120: \t\treturn fmt.Errorf(\"BACKUP_KEY_UNAVAILABLE\")\n121: \t}\n122: \tdefer clear(key)\n123: \tcontracts, e := domain.LoadContracts(filepath.Join(*root, \"spec/v2.0/contracts\"))\n124: \tif e != nil {\n125: \t\treturn e\n126: \t}\n127: \tctx := context.Background()\n128: \thostConfig := func(db *sql.DB, dataRoot string) hostboundary.Config {\n129: \t\treturn hostboundary.Config{DB: db, Dir: filepath.Join(dataRoot, \"host\"),\n130: \t\t\tContractsDir:  filepath.Join(*root, \"spec\", \"v2.0\", \"contracts\"),\n131: \t\t\tMigrationFile: filepath.Join(*root, \"migrations\", \"sqlite\", \"0002_domain.sql\"),\n132: \t\t\tSchemaDir:     filepath.Join(*root, \"internal\", \"api\", \"contracts\")}\n133: \t}\n134: \tif command == \"restore\" {\n135: \t\tif *backup == \"\" {\n136: \t\t\treturn fmt.Errorf(\"--backup required\")\n137: \t\t}\n138: \t\tfiles, e := filepath.Glob(filepath.Join(*root, \"migrations/sqlite/[0-9][0-9][0-9][0-9]_*.sql\"))\n139: \t\tif e != nil {\n140: \t\t\treturn e\n141: \t\t}\n142: \t\tversions := []int{}\n143: \t\tfor _, file := range files {\n144: \t\t\tv, e := strconv.Atoi(filepath.Base(file)[:4])\n145: \t\t\tif e != nil {\n146: \t\t\t\treturn e\n147: \t\t\t}\n148: \t\t\tversions = append(versions, v)\n149: \t\t}\n150: \t\ttarget := func(ctx context.Context, destination string, requests []domain.WorkspaceRestoreRequest) ([]domain.WorkspaceRestorePin, error) {\n151: \t\t\trestored, err := store.Open(filepath.Join(destination, \"researchos.sqlite\"))\n152: \t\t\tif err != nil {\n153: \t\t\t\treturn nil, err\n154: \t\t\t}\n155: \t\t\tdefer restored.Close()\n156: \t\t\th, err := hostboundary.New(hostConfig(restored, destination))\n157: \t\t\tif err != nil {\n158: \t\t\t\treturn nil, err\n159: \t\t\t}\n160: \t\t\tif _, err := h.BootstrapOwner(ctx); err != nil {\n161: \t\t\t\treturn nil, err\n162: \t\t\t}\n163: \t\t\tpins := make([]domain.WorkspaceRestorePin, 0, len(requests))\n164: \t\t\tfor _, request := range requests {\n165: \t\t\t\tpin, err := h.PinRestoredWorkspace(ctx, request)\n166: \t\t\t\tif err != nil {\n167: \t\t\t\t\treturn nil, err\n168: \t\t\t\t}\n169: \t\t\t\tpins = append(pins, pin)\n170: \t\t\t}\n171: \t\t\treturn pins, nil\n172: \t\t}\n173: \t\toptions := domain.RestoreOptions{Key: key, SupportedMigrations: versions, Contracts: contracts}\n174: \t\tif *asDataRoot {\n175: \t\t\toptions.WorkspaceTarget = target\n176: \t\t\toptions.DatabaseName = \"researchos.sqlite\"\n177: \t\t}\n178: \t\tr, e := domain.RestoreBackup(ctx, *backup, *out, options)\n179: \t\tif e != nil {\n180: \t\t\treturn e\n181: \t\t}\n182: \t\treturn json.NewEncoder(os.Stdout).Encode(r)\n183: \t}\n184: \tif *source == \"\" {\n185: \t\treturn fmt.Errorf(\"--db required\")\n186: \t}\n187: \tst, e := os.Stat(*source)\n188: \tif e != nil || !st.Mode().IsRegular() {\n189: \t\treturn fmt.Errorf(\"existing regular source database required\")\n190: \t}\n191: \t// Refuse ambiguous URI DSNs; --db is an ordinary local file path.\n192: \tif strings.Contains(*source, \"?\") {\n193: \t\treturn fmt.Errorf(\"SQLite URI parameters prohibited\")\n194: \t}\n195: \tdb, e := store.Open(*source)"]}
