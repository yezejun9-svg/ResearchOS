931: 	result := c.RunAdmitted(context.Background(), route, r.run, r.lease)
932: 	if hookErr != nil || hookCount != 1 || result == nil || !strings.Contains(result.Error(), "planned qualification facts changed") || calls.Load() != 1 {
933: 		t.Fatalf("heartbeat race was not fenced: hook=%d hookErr=%v result=%v calls=%d", hookCount, hookErr, result, calls.Load())
934: 	}
935: 	var state, locator string
936: 	if err = r.f.db.QueryRow("SELECT state,journal_locator FROM runtime_dispatches WHERE run=?", r.run["id"]).Scan(&state, &locator); err != nil {
937: 		t.Fatal(err)
938: 	}
939: 	var status string
940: 	if err = r.f.db.QueryRow("SELECT json_extract(body,'$.status') FROM domain_objects WHERE kind='Run' AND id=?", r.run["id"]).Scan(&status); err != nil {
941: 		t.Fatal(err)
942: 	}
943: 	if status != "RUNNING" || state != "UNKNOWN" {
944: 		t.Fatalf("stale frozen plan terminalized: run=%s dispatch=%s", status, state)
945: 	}
946: 	dir := filepath.Join(c.config.DataRoot, "runtime-dispatches", locator)
947: 	journal, _ := os.ReadFile(filepath.Join(dir, "bridge.json"))
948: 	stdout, _ := os.ReadFile(filepath.Join(dir, "stdout.raw"))
949: 	stderr, _ := os.ReadFile(filepath.Join(dir, "stderr.raw"))
950: 	if Hash(beforeNative) != Hash(Object{"journal": Digest(journal), "stdout": Digest(stdout), "stderr": Digest(stderr)}) {
951: 		t.Fatal("heartbeat race changed immutable native cause")
952: 	}
953: }
