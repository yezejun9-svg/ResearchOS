681: func TestQualificationFailureNativeSourceTamperingRefused(t *testing.T) {
682: 	c, route, r, _ := qualificationFailureLoopbackFixture(t)
683: 	if err := c.RunAdmitted(context.Background(), route, r.run, r.lease); err == nil {
684: 		t.Fatal("expected first-gate denial")
685: 	}
686: 	var locator, manifestHash string
687: 	if err := r.f.db.QueryRow("SELECT journal_locator,manifest_hash FROM runtime_dispatches WHERE run=?", r.run["id"]).Scan(&locator, &manifestHash); err != nil {
688: 		t.Fatal(err)
689: 	}
690: 	directory := filepath.Join(c.config.DataRoot, "runtime-dispatches", locator)
691: 	if _, err := rt.ReadQualificationNativeFacts(directory, manifestHash); err != nil {
692: 		t.Fatal(err)
693: 	}
694: 	for _, name := range []string{"stdout.raw", "stderr.raw", "bridge.json"} {
695: 		t.Run(name, func(t *testing.T) {
696: 			path := filepath.Join(directory, name)
697: 			original, readErr := os.ReadFile(path)
698: 			if readErr != nil {
699: 				t.Fatal(readErr)
700: 			}
701: 			defer os.WriteFile(path, original, 0600)
702: 			if writeErr := os.WriteFile(path, append(append([]byte(nil), original...), byte('x')), 0600); writeErr != nil {
703: 				t.Fatal(writeErr)
704: 			}
705: 			if _, verifyErr := rt.ReadQualificationNativeFacts(directory, manifestHash); verifyErr == nil {
706: 				t.Fatal("damaged native source was accepted")
707: 			}
708: 		})
709: 	}
710: 	journalPath := filepath.Join(directory, "bridge.json")
