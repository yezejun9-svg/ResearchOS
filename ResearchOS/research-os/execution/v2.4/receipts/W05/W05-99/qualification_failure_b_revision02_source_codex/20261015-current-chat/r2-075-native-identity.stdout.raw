45: 	Version                  string          `json:"version"`
46: 	PauseID                  string          `json:"pause_id"`
47: 	Binding                  json.RawMessage `json:"binding"`
48: 	Sequence                 int64           `json:"checkpoint_sequence"`
49: 	ContentHash              string          `json:"content_hash"`
50: 	CheckpointArtifactID     string          `json:"checkpoint_artifact_id"`
51: 	CheckpointUseReceiptHash string          `json:"checkpoint_use_receipt_hash"`
52: 	JournalCheckpointHash    string          `json:"journal_checkpoint_hash"`
53: }
54: 
