60: 	Capability string          `json:"capability,omitempty"`
61: 	Payload    json.RawMessage `json:"payload,omitempty"`
62: 	Path       string          `json:"path,omitempty"`
63: }
64: 
65: type BridgeRequest struct {
66: 	WorkerID     string
67: 	Manifest     json.RawMessage
68: 	ManifestHash string
69: 	Executable   string
70: 	// Only explicit immutable inputs cross into the task sandbox. Credentials,
71: 	// authority paths and the host manifest never enter this map.
72: 	Inputs       map[string][]byte
73: 	BeforeResume func(sandbox.Identity) error
74: }
75: 
76: type BridgeJournal struct {
