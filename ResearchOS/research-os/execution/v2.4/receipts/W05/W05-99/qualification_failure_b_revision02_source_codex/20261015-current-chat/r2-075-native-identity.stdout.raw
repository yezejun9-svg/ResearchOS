109: 	QueueAbortObserved bool             `json:"queue_abort_observed"`
110: 	QueueCancelIdle    bool             `json:"queue_cancel_idle"`
111: 	QueueIdle          bool             `json:"queue_idle"`
112: 	QueueInitSequence  int64            `json:"queue_init_sequence"`
113: 	CommandReceipts    []BridgeFrame    `json:"command_receipts,omitempty"`
114: }
115: 
116: type Bridge struct {
