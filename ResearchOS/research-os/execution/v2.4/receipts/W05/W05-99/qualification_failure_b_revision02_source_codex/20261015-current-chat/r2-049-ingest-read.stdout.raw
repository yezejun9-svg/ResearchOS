256: // ResumeCheckpoint rebuilds current context after trusted process/effect
257: // reconciliation. It retains Run identity and all provider keys, rotating only
258: // the execution lease so old callbacks cannot change the resumed run.
259: func (s *Service) ResumeCheckpoint(ctx context.Context, token, project, runID, key string, expectedRevision int64) (Object, error) {
260: 	tx, e := s.DB.BeginTx(ctx, nil)
