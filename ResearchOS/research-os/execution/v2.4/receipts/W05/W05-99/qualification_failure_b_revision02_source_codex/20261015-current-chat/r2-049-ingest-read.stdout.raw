262: 		return nil, e
263: 	}
264: 	defer tx.Rollback()
265: 	if e = resourceWriteLock(tx); e != nil {
266: 		return nil, e
267: 	}
268: 	p, e := resourcePrincipal(tx, token, project, "SCHEDULER")
