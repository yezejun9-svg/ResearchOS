20: func stageRuntimeProgram(route RuntimeCoordinatorRoute, dispatch Object, inputs map[string][]byte) error {
21: 	manifest := dispatch["manifest"].(map[string]any)
22: 	profile := manifest["admission"].(map[string]any)["profile"].(map[string]any)
23: 	if profile["backend"] != runtimeMuBackend {
24: 		return nil
25: 	}
26: 	if e := validateRuntimeModelConfig(profile); e != nil {
27: 		return e
28: 	}
29: 	effective, e := runtimepolicy.Effective(manifest, "")
30: 	if e != nil {
31: 		return e
32: 	}
33: 	if !filepath.IsAbs(route.BundleFile) {
34: 		return errors.New("host Mu bundle binding required")
35: 	}
36: 	actual, e := filepath.EvalSymlinks(route.BundleFile)
37: 	if e != nil || !strings.EqualFold(actual, filepath.Clean(route.BundleFile)) {
38: 		return errors.New("Mu bundle reparse rejected")
39: 	}
40: 	info, e := os.Stat(actual)
41: 	if e != nil || !info.Mode().IsRegular() || info.Size() > 32*1024*1024 {
42: 		return errors.New("bounded Mu bundle required")
43: 	}
44: 	raw, e := os.ReadFile(actual)
45: 	if e != nil || Digest(raw) != profile["bundle_hash"] {
46: 		return errors.New("Mu bundle differs from frozen profile")
47: 	}
48: 	inputs["mu-worker.mjs"] = raw
49: 	inputs["worker.json"] = Bytes(effective)
50: 	return nil
51: }
