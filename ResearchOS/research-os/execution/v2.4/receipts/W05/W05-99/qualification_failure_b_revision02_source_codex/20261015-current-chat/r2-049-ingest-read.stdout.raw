216: 	o["state"] = "STARTED"
217: 	o["epoch"] = run["lease_epoch"]
218: 	if e = effectAppend(tx, project, runID, key, o); e != nil {
219: 		return nil, e
220: 	}
221: 	return o, nil
222: }
