224: // ObserveEffect is the trusted worker/provider reconciliation boundary, like
225: // ObserveRuntime. No public HTTP endpoint accepts invented provider outcomes.
226: func (s *Service) ObserveEffect(ctx context.Context, project, runID, key, state string, receipt Object) error {
227: 	if (state != "CONFIRMED" && state != "UNKNOWN" && state != "NOT_APPLIED") || len(receipt) == 0 {
228: 		return Fail(400, "INVALID_REQUEST", "trusted outcome and receipt required")
229: 	}
230: 	tx, e := s.DB.BeginTx(ctx, nil)
231: 	if e != nil {
232: 		return e
233: 	}
234: 	defer tx.Rollback()
235: 	if e = resourceWriteLock(tx); e != nil {
236: 		return e
237: 	}
238: 	o, e := latestEffect(tx, project, runID, key)
239: 	if e != nil {
240: 		return e
241: 	}
242: 	if o["state"] == state && Hash(o["receipt"]) == Hash(receipt) {
243: 		return nil
244: 	}
245: 	if o["state"] == "CONFIRMED" || o["state"] == "NOT_APPLIED" || o["state"] == "PREPARED" {
246: 		return Fail(409, "STATE_CONFLICT", "effect outcome cannot be rewritten")
247: 	}
248: 	o["state"] = state
249: 	o["receipt"] = receipt
250: 	if e = effectAppend(tx, project, runID, key, o); e != nil {
251: 		return e
252: 	}
253: 	return tx.Commit()
254: }
