369: // A late receipt settles the original reservation and recorded epoch, without
370: // acquiring execution authority or extending any lease.
371: func (c *RuntimeCoordinator) ingestEffectFact(ctx context.Context, fact Object) error {
372: 	if len(Bytes(fact)) > runtimeFactMaxBytes {
373: 		return errors.New("encoded host fact exceeds persistence bound")
374: 	}
375: 	project, run, key := Str(fact, "project_id"), Str(fact, "run_id"), Str(fact, "effect_key")
376: 	tx, e := c.service.DB.BeginTx(ctx, nil)
377: 	if e != nil {
378: 		return e
379: 	}
380: 	defer tx.Rollback()
381: 	if e = resourceWriteLock(tx); e != nil {
382: 		return e
383: 	}
384: 	dispatch, e := runtimeDispatch(tx, project, run, fact["epoch"])
385: 	if e != nil {
386: 		return e
387: 	}
388: 	if fact["dispatch_key"] != dispatch["dispatch_key"] || fact["manifest_hash"] != dispatch["manifest_hash"] {
389: 		return Fail(422, "GATE_FAILED", "effect receipt dispatch mismatch")
390: 	}
391: 	intent, e := latestEffect(tx, project, run, key)
392: 	if e != nil {
393: 		return e
394: 	}
395: 	if intent["request_hash"] != fact["request_hash"] || intent["reservation_id"] != fact["reservation_id"] || Hash(intent["epoch"]) != Hash(fact["epoch"]) {
396: 		return Fail(422, "GATE_FAILED", "effect receipt epoch or intent mismatch")
397: 	}
398: 	receipt, ok := fact["receipt"].(map[string]any)
399: 	if !ok {
400: 		return errors.New("trusted effect receipt required")
401: 	}
402: 	if receipt["key"] != key || receipt["run_id"] != run || Hash(receipt["epoch"]) != Hash(fact["epoch"]) || Str(receipt, "receipt_id") == "" || (receipt["state"] != "CONFIRMED" && receipt["state"] != "NOT_APPLIED") {
403: 		return Fail(422, "GATE_FAILED", "effect receipt identity or outcome mismatch")
404: 	}
405: 	request, _ := intent["payload"].(map[string]any)
406: 	if request["capability"] == "MODEL" || request["capability"] == "TOOL" {
407: 		result, valid := receipt["payload"].(map[string]any)
408: 		if !valid {
409: 			return Fail(422, "GATE_FAILED", "host effect result missing")
410: 		}
411: 		wantHash := Digest(Bytes(result))
412: 		if request["capability"] == "MODEL" && receipt["state"] == "CONFIRMED" {
413: 			raw := []byte(Str(result, "body"))
414: 			if receipt["model_transport"] != true || receipt["actual_cost"] != nil || result["content_type"] != "text/event-stream" || Hash(result["status"]) != Hash(200) || len(raw) > runtimeModelMaxSSEBytes || !completeRuntimeModelSSE(raw) {
415: 				return Fail(422, "GATE_FAILED", "model transport receipt invalid")
416: 			}
417: 			wantHash = Digest(raw)
418: 		}
419: 		if wantHash != fact["provider_response_hash"] || wantHash != receipt["receipt_id"] {
420: 			return Fail(422, "GATE_FAILED", "host effect response hash mismatch")
421: 		}
422: 		if receipt["state"] == "NOT_APPLIED" {
423: 			money, _ := receipt["actual_cost"].(map[string]any)
424: 			amount, err := moneyAmount(money)
425: 			if result["dispatched"] != false || result["witness"] != "HOST_PRE_EFFECT_REFUSAL" || err != nil || amount.Sign() != 0 {
426: 				return Fail(422, "GATE_FAILED", "known unissued effect witness required")
427: 			}
428: 		} else if request["capability"] == "TOOL" {
429: 			payload, _ := request["payload"].(map[string]any)
430: 			if receipt["host_tool"] != payload["name"] {
431: 				return Fail(422, "GATE_FAILED", "host tool receipt name mismatch")
432: 			}
433: 		}
434: 	}
435: 	if evidence := fact["host_tool_evidence"]; evidence != nil && (request["capability"] != "TOOL" || len(Bytes(evidence)) > 4*1024*1024 || fact["host_tool_evidence_hash"] != Hash(evidence)) {
436: 		return Fail(422, "GATE_FAILED", "host tool evidence hash or bound mismatch")
437: 	}
438: 	if intent["state"] == receipt["state"] && Hash(intent["receipt"]) == Hash(receipt) {
439: 		current, err := load(tx, project, "Run", run)
440: 		if err != nil {
441: 			return err
442: 		}
443: 		if err = c.projectSessionEffects(tx, project, current, fact); err != nil {
444: 			return err
445: 		}
446: 		return tx.Commit()
447: 	}
448: 	if intent["state"] != "STARTED" && intent["state"] != "UNKNOWN" {
449: 		return Fail(409, "STATE_CONFLICT", "effect outcome cannot be rewritten")
450: 	}
