FILE internal/store/qualification_maintenance_windows.go
224: type QualificationResidualSelectors struct {
225: 	Project, Run, Operation, Principal, UploadKey, EventID string
226: 	Epoch, EventSequence                                   int64
227: 	ArtifactID, ImpactLinkID, StateID                      string
228: 	RunRevision, StateRevision                             int64
229: 	ObservationHash                                        string
230: }
231: 
232: // QualificationMaintenanceResidualCensus hashes all rows in the nine allowed
233: // tables except precisely the rows this single operation may add or replace.
234: // Recovery compares this with its pre-BEGIN value and verifies the excluded
235: // rows separately. An unrelated change in an allowed table remains visible.
236: func QualificationMaintenanceResidualCensus(ctx context.Context, tx *sql.Tx, s QualificationResidualSelectors) (string, error) {
237: 	if tx == nil || s.Project == "" || s.Run == "" || s.Operation == "" || s.UploadKey == "" || s.EventID == "" {
238: 		return "", errors.New("qualification residual selectors invalid")
239: 	}
240: 	tables := []string{"uploaded_content", "domain_versions", "domain_objects", "domain_refs", "runtime_observations", "runtime_dispatches", "outbox", "event_state_snapshots", "idempotency"}
241: 	h := sha256.New()
242: 	value := func(v any) string {
243: 		switch x := v.(type) {
244: 		case []byte:
245: 			return string(x)
246: 		case string:
247: 			return x
248: 		case int64:
249: 			return fmt.Sprint(x)
250: 		default:
251: 			return ""
252: 		}
253: 	}
254: 	target := func(row map[string]any) bool {
255: 		if value(row["project"]) != s.Project {
256: 			return false
257: 		}
258: 		kind, id := value(row["kind"]), value(row["id"])
259: 		switch kind {
260: 		case "Artifact":
261: 			return id == s.ArtifactID && value(row["revision"]) == "1"
262: 		case "ImpactLink":
263: 			return id == s.ImpactLinkID && value(row["revision"]) == "1"
264: 		case "Run":
265: 			return id == s.Run && value(row["revision"]) == fmt.Sprint(s.RunRevision)
266: 		case "ProjectState":
267: 			return id == s.StateID && value(row["revision"]) == fmt.Sprint(s.StateRevision)
268: 		case "EventEnvelope":
269: 			return id == s.EventID && value(row["revision"]) == "1"
270: 		}
271: 		return false
272: 	}
273: 	for _, table := range tables {
274: 		ownedStopFrame(h, 'T', []byte(table))
275: 		rows, e := tx.QueryContext(ctx, `SELECT * FROM "`+table+`" ORDER BY rowid`)
276: 		if e != nil {
277: 			return "", e
278: 		}
279: 		cols, e := rows.Columns()
280: 		if e != nil {
281: 			rows.Close()
282: 			return "", e
283: 		}
284: 		for rows.Next() {
285: 			vals := make([]any, len(cols))
286: 			ptrs := make([]any, len(cols))
287: 			for i := range vals {
288: 				ptrs[i] = &vals[i]
289: 			}
290: 			if e = rows.Scan(ptrs...); e != nil {
291: 				break
292: 			}
293: 			row := make(map[string]any, len(cols))
294: 			for i, col := range cols {
295: 				row[col] = vals[i]
296: 			}
297: 			skip := false
298: 			switch table {
299: 			case "uploaded_content":
300: 				skip = value(row["storage_key"]) == s.UploadKey
301: 			case "domain_versions", "domain_refs":
302: 				skip = target(row)
303: 			case "domain_objects":
304: 				// Run and ProjectState existed before; their old rows are
305: 				// excluded as the same exact keys whose new values are checked.
306: 				kind, id := value(row["kind"]), value(row["id"])
307: 				skip = value(row["project"]) == s.Project && (kind == "Artifact" && id == s.ArtifactID ||
308: 					kind == "ImpactLink" && id == s.ImpactLinkID || kind == "Run" && id == s.Run ||
309: 					kind == "ProjectState" && id == s.StateID || kind == "EventEnvelope" && id == s.EventID)
310: 			case "runtime_observations":
311: 				skip = value(row["project"]) == s.Project && value(row["run"]) == s.Run &&
312: 					value(row["epoch"]) == fmt.Sprint(s.Epoch) && value(row["receipt_hash"]) == s.ObservationHash
313: 			case "runtime_dispatches":
314: 				skip = value(row["project"]) == s.Project && value(row["run"]) == s.Run && value(row["epoch"]) == fmt.Sprint(s.Epoch)
315: 			case "outbox":
316: 				skip = value(row["project"]) == s.Project && value(row["sequence"]) == fmt.Sprint(s.EventSequence) && value(row["id"]) == s.EventID
317: 			case "event_state_snapshots":
318: 				skip = value(row["project"]) == s.Project && value(row["event_id"]) == s.EventID
319: 			case "idempotency":
320: 				skip = value(row["principal"]) == s.Principal && value(row["project"]) == s.Project &&
321: 					value(row["operation"]) == "host:qualification-failure-maintenance" && value(row["key"]) == s.Operation
322: 			}
323: 			if skip {
324: 				continue
325: 			}
326: 			ownedStopFrame(h, 'R', nil)
327: 			for _, v := range vals {
328: 				if e = ownedStopCell(h, v); e != nil {
329: 					break
330: 				}
331: 			}
332: 			if e != nil {
333: 				break
334: 			}
335: 		}
336: 		if e == nil {
337: 			e = rows.Err()
338: 		}
339: 		rows.Close()
340: 		if e != nil {
341: 			return "", e
342: 		}
343: 	}
344: 	return hex.EncodeToString(h.Sum(nil)), nil
345: }
