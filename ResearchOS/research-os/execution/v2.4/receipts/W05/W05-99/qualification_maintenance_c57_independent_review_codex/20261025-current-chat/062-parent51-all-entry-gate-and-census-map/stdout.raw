343: type historicalBlockingDriver struct {
344: 	started, release chan struct{}
345: 	commitErr        bool
346: }
347: 
348: func (d *historicalBlockingDriver) Open(string) (driver.Conn, error) {
349: 	return &historicalBlockingConn{owner: d}, nil
350: }
351: 
352: type historicalBlockingConn struct{ owner *historicalBlockingDriver }
353: 
354: func (*historicalBlockingConn) Prepare(string) (driver.Stmt, error) {
355: 	return nil, errors.New("statement outside fixture")
356: }
357: func (*historicalBlockingConn) Close() error { return nil }
358: func (c *historicalBlockingConn) Begin() (driver.Tx, error) {
359: 	return &historicalBlockingTx{owner: c.owner}, nil
360: }
361: func (c *historicalBlockingConn) BeginTx(context.Context, driver.TxOptions) (driver.Tx, error) {
362: 	return c.Begin()
363: }
364: 
365: type historicalBlockingTx struct{ owner *historicalBlockingDriver }
366: 
367: func (tx *historicalBlockingTx) Commit() error {
368: 	close(tx.owner.started)
369: 	<-tx.owner.release
370: 	if tx.owner.commitErr {
371: 		return errors.New("injected driver commit failure")
372: 	}
373: 	return nil
374: }
375: func (tx *historicalBlockingTx) Rollback() error {
376: 	close(tx.owner.started)
377: 	<-tx.owner.release
378: 	return nil
379: }
380: 
381: func TestHistoricalQualificationNativeHoldWaitsForDriverRollbackAndCommitError(t *testing.T) {
382: 	user, err := windows.GetCurrentProcessToken().GetTokenUser()
383: 	if err != nil || user == nil || user.User.Sid == nil {
384: 		t.Fatalf("current SID: %v", err)
385: 	}
386: 	for _, mode := range []string{"cancel_rollback", "commit_error"} {
387: 		t.Run(mode, func(t *testing.T) {
388: 			root := t.TempDir()
389: 			source := filepath.Join(root, "raw.json")
390: 			if err := os.WriteFile(source, []byte(`{"source":"fixture"}`), 0600); err != nil {
391: 				t.Fatal(err)
392: 			}
393: 			owner, err := os.OpenFile(filepath.Join(root, "owner.lock"), os.O_CREATE|os.O_RDWR, 0600)
394: 			if err != nil {
395: 				t.Fatal(err)
396: 			}
397: 			hold := &historicalQualificationHold{owner: owner}
398: 			defer hold.Close()
399: 			f, err := hold.add(source, false, true, user.User.Sid.String())
400: 			if err != nil {
401: 				t.Fatal(err)
402: 			}
403: 			if _, err := historicalNativeRead(f, 1024, false); err != nil {
404: 				t.Fatal(err)
405: 			}
406: 			control := &historicalBlockingDriver{started: make(chan struct{}), release: make(chan struct{}), commitErr: mode == "commit_error"}
407: 			defer func() {
408: 				select {
409: 				case <-control.release:
410: 				default:
411: 					close(control.release)
412: 				}
413: 			}()
414: 			driverName := fmt.Sprintf("c57-historical-%s-%s", mode, ID())
415: 			sql.Register(driverName, control)
416: 			db, err := sql.Open(driverName, "")
417: 			if err != nil {
418: 				t.Fatal(err)
419: 			}
420: 			defer db.Close()
421: 			ctx, cancel := context.WithCancel(context.Background())
422: 			defer cancel()
423: 			tx, err := db.BeginTx(context.WithoutCancel(ctx), nil)
424: 			if err != nil {
425: 				t.Fatal(err)
426: 			}
427: 			var done <-chan error
428: 			if mode == "cancel_rollback" {
429: 				cancel()
430: 				if ctx.Err() != context.Canceled {
431: 					t.Fatal("caller cancellation not observed")
432: 				}
433: 				result := make(chan error, 1)
434: 				done = result
435: 				go func() { result <- finishHistoricalQualificationTx(tx, false, hold) }()
436: 			} else {
437: 				result := make(chan error, 1)
438: 				done = result
439: 				go func() { result <- tx.Commit() }()
440: 			}
441: 			select {
442: 			case <-control.started:
443: 			case <-time.After(5 * time.Second):
444: 				t.Fatal("driver transaction did not reach blocking return")
445: 			}
446: 			moved := source + ".moved"
447: 			if err := os.Rename(source, moved); err == nil {
448: 				t.Fatal("native source released before driver returned")
449: 			}
450: 			close(control.release)
451: 			select {
452: 			case err := <-done:
453: 				if mode == "cancel_rollback" && err != nil {
454: 					t.Fatal(err)
455: 				}
456: 				if mode == "commit_error" && (err == nil || !strings.Contains(err.Error(), "injected driver commit failure")) {
457: 					t.Fatalf("driver failure not delivered: %v", err)
458: 				}
459: 			case <-time.After(5 * time.Second):
460: 				t.Fatal("driver transaction did not return")
461: 			}
462: 			if mode == "commit_error" {
463: 				if err := os.Rename(source, moved); err == nil {
464: 					t.Fatal("native source released before caller failure cleanup")
465: 				}
466: 				_ = finishHistoricalQualificationTx(tx, false, hold)
467: 			}
468: 			if err := os.Rename(source, moved); err != nil {
469: 				t.Fatalf("native source remained locked after transaction cleanup: %v", err)
470: 			}
471: 		})
472: 	}
473: }
