612: func tokenGroupState(token windows.Token, businessSID string) (string, map[string]bool, string, error) {
613: 	user, userErr := token.GetTokenUser()
614: 	groups, groupsErr := token.GetTokenGroups()
615: 	if userErr != nil || groupsErr != nil {
616: 		return "", nil, "", errors.Join(userErr, groupsErr)
617: 	}
618: 	if user.User.Sid.String() != businessSID {
619: 		return "", nil, "", errors.New("native token user differs from frozen business SID")
620: 	}
621: 	var stable []string
622: 	var logonSID string
623: 	effective := map[string]bool{businessSID: true}
624: 	for _, group := range groups.AllGroups() {
625: 		if group.Attributes&windows.SE_GROUP_LOGON_ID == windows.SE_GROUP_LOGON_ID {
626: 			if logonSID != "" {
627: 				return "", nil, "", errors.New("multiple token logon SIDs")
628: 			}
629: 			logonSID = group.Sid.String()
630: 		}
631: 		if group.Attributes&windows.SE_GROUP_ENABLED != 0 && group.Attributes&windows.SE_GROUP_USE_FOR_DENY_ONLY == 0 {
632: 			effective[group.Sid.String()] = true
633: 			// Logon SID and integrity label are per logon/boot. Keep them in
634: 			// the current access map, but not in the frozen stable group hash.
635: 			if group.Attributes&(windows.SE_GROUP_LOGON_ID|windows.SE_GROUP_INTEGRITY) == 0 {
636: 				stable = append(stable, group.Sid.String())
637: 			}
638: 		}
639: 	}
640: 	if logonSID == "" {
641: 		return "", nil, "", errors.New("token logon SID unavailable")
642: 	}
643: 	sort.Strings(stable)
644: 	raw, _ := json.Marshal(stable)
645: 	return digest(raw), effective, logonSID, nil
646: }
647: 
648: type businessTokenShape struct {
649: 	SessionID        uint32
650: 	ElevationType    uint32
651: 	IntegritySID     string
652: 	LogonSID         string
653: 	PrivilegesSHA256 string
654: 	GroupsSHA256     string
655: 	EffectiveSIDs    map[string]bool
656: 	ProcessID        uint32
657: 	ProcessCreated   time.Time
658: 	ProcessImageSHA  string
659: }
660: 
661: func tokenInfoBytes(token windows.Token, class uint32) ([]byte, error) {
662: 	buf := make([]byte, 128)
663: 	for {
664: 		var size uint32
665: 		err := windows.GetTokenInformation(token, class, &buf[0], uint32(len(buf)), &size)
666: 		if err == nil {
667: 			if size > uint32(len(buf)) {
668: 				return nil, errors.New("token information size invalid")
669: 			}
670: 			return buf[:size], nil
671: 		}
672: 		if !errors.Is(err, windows.ERROR_INSUFFICIENT_BUFFER) || size > 64<<10 || size <= uint32(len(buf)) {
673: 			return nil, err
674: 		}
675: 		buf = make([]byte, size)
676: 	}
677: }
678: 
679: func tokenSecurityShape(token windows.Token, pid uint32, businessSID string) (businessTokenShape, error) {
680: 	var shape businessTokenShape
681: 	var session, elevation, size uint32
682: 	if err := windows.ProcessIdToSessionId(pid, &session); err != nil {
683: 		return shape, err
684: 	}
685: 	if err := windows.GetTokenInformation(token, windows.TokenElevationType, (*byte)(unsafe.Pointer(&elevation)), 4, &size); err != nil || size != 4 {
686: 		return shape, errors.Join(err, errors.New("token elevation type unavailable"))
687: 	}
688: 	labelBytes, err := tokenInfoBytes(token, windows.TokenIntegrityLevel)
689: 	if err != nil || len(labelBytes) < int(unsafe.Sizeof(windows.Tokenmandatorylabel{})) {
690: 		return shape, errors.Join(err, errors.New("token integrity label unavailable"))
691: 	}
692: 	groupSHA, effective, logonSID, err := tokenGroupState(token, businessSID)
693: 	if err != nil {
694: 		return shape, err
695: 	}
696: 	privBytes, err := tokenInfoBytes(token, windows.TokenPrivileges)
697: 	if err != nil || len(privBytes) < int(unsafe.Sizeof(windows.Tokenprivileges{})) {
698: 		return shape, errors.Join(err, errors.New("token privileges unavailable"))
699: 	}
700: 	var privilegeLines []string
701: 	for _, priv := range (*windows.Tokenprivileges)(unsafe.Pointer(&privBytes[0])).AllPrivileges() {
702: 		privilegeLines = append(privilegeLines, fmt.Sprintf("%08x:%08x:%08x", uint32(priv.Luid.HighPart), priv.Luid.LowPart, priv.Attributes))
703: 	}
704: 	sort.Strings(privilegeLines)
705: 	privJSON, _ := json.Marshal(privilegeLines)
706: 	shape = businessTokenShape{SessionID: session, ElevationType: elevation, IntegritySID: (*windows.Tokenmandatorylabel)(unsafe.Pointer(&labelBytes[0])).Label.Sid.String(), LogonSID: logonSID, PrivilegesSHA256: digest(privJSON), GroupsSHA256: groupSHA, EffectiveSIDs: effective}
707: 	return shape, nil
708: }
709: 
710: // Existing Explorer supplies a fresh business process token after restart.
711: // Its current PID, session and logon SID are evidence, never compared to the
712: // pre-restart values. Elevated-admin cross-account TOKEN_QUERY is probed.
713: func inspectExistingBusinessProcess(p EntryFencePlan, expected string, pre BootWitness) (businessTokenShape, error) {
714: 	var zero businessTokenShape
715: 	if pre.BusinessLogonSID == "" || !validDigest(pre.BusinessPrivilegesSHA256) || pre.BusinessIntegritySID == "" {
716: 		return zero, errors.New("pre business token shape unavailable")
717: 	}
718: 	systemRoot, rootErr := windows.GetSystemWindowsDirectory()
719: 	if rootErr != nil || !filepath.IsAbs(systemRoot) || filepath.Clean(systemRoot) != systemRoot {
720: 		return zero, errors.Join(rootErr, errors.New("native system root unavailable"))
721: 	}
722: 	explorerPath := filepath.Join(systemRoot, "explorer.exe")
723: 	_, currentBoot, err := bootClock()
724: 	if err != nil {
725: 		return zero, err
726: 	}
727: 	snapshot, err := windows.CreateToolhelp32Snapshot(windows.TH32CS_SNAPPROCESS, 0)
728: 	if err != nil {
729: 		return zero, err
730: 	}
731: 	defer windows.CloseHandle(snapshot)
732: 	var entry windows.ProcessEntry32
733: 	entry.Size = uint32(unsafe.Sizeof(entry))
734: 	if err = windows.Process32First(snapshot, &entry); err != nil {
735: 		return zero, err
736: 	}
737: 	var matched *businessTokenShape
738: 	for {
739: 		if strings.EqualFold(windows.UTF16ToString(entry.ExeFile[:]), "explorer.exe") {
740: 			proc, openErr := windows.OpenProcess(windows.PROCESS_QUERY_LIMITED_INFORMATION, false, entry.ProcessID)
741: 			if openErr != nil {
742: 				return zero, fmt.Errorf("Explorer candidate inaccessible: %w", openErr)
743: 			}
744: 			buf := make([]uint16, 32768)
745: 			n := uint32(len(buf))
746: 			imageErr := windows.QueryFullProcessImageName(proc, 0, &buf[0], &n)
747: 			if imageErr != nil {
748: 				windows.CloseHandle(proc)
749: 				return zero, imageErr
750: 			}
751: 			if !strings.EqualFold(windows.UTF16ToString(buf[:n]), explorerPath) {
752: 				windows.CloseHandle(proc)
753: 				goto nextProcess
754: 			}
755: 			var created, exited, kernel, userTime windows.Filetime
756: 			if err = windows.GetProcessTimes(proc, &created, &exited, &kernel, &userTime); err != nil || time.Unix(0, created.Nanoseconds()).Before(currentBoot.Add(-2*time.Second)) {
757: 				windows.CloseHandle(proc)
758: 				return zero, errors.Join(err, errors.New("Explorer creation predates current boot"))
759: 			}
760: 			var token windows.Token
761: 			tokenErr := windows.OpenProcessToken(proc, windows.TOKEN_QUERY, &token)
762: 			if tokenErr != nil {
763: 				windows.CloseHandle(proc)
764: 				return zero, tokenErr
765: 			}
766: 			user, userErr := token.GetTokenUser()
767: 			if userErr != nil {
768: 				token.Close()
769: 				windows.CloseHandle(proc)
770: 				return zero, userErr
771: 			}
772: 			if user.User.Sid.String() != p.BusinessSID {
773: 				token.Close()
774: 				windows.CloseHandle(proc)
775: 				goto nextProcess
776: 			}
777: 			shape, shapeErr := tokenSecurityShape(token, entry.ProcessID, p.BusinessSID)
778: 			closeErr := token.Close()
779: 			if shapeErr != nil || closeErr != nil {
780: 				windows.CloseHandle(proc)
781: 				return zero, errors.Join(shapeErr, closeErr)
782: 			}
783: 			imageSHA, imageErr := osProcessImageIdentity(explorerPath)
784: 			closeErr = windows.CloseHandle(proc)
785: 			if imageErr != nil || closeErr != nil {
786: 				return zero, errors.Join(imageErr, closeErr)
787: 			}
788: 			shape.ProcessID = entry.ProcessID
789: 			shape.ProcessCreated = time.Unix(0, created.Nanoseconds()).UTC()
790: 			shape.ProcessImageSHA = imageSHA
791: 			if err := sameBusinessPermissionSemantics(pre, shape, expected); err != nil {
792: 				return zero, err
793: 			}
794: 			if matched != nil {
795: 				if matched.SessionID != shape.SessionID || matched.LogonSID != shape.LogonSID || matched.ProcessImageSHA != shape.ProcessImageSHA {
796: 					return zero, errors.New("multiple current business Explorer sessions ambiguous")
797: 				}
798: 				if shape.ProcessCreated.Before(matched.ProcessCreated) {
799: 					matched = &shape
800: 				}
801: 			} else {
802: 				matched = &shape
803: 			}
804: 		}
805: 	nextProcess:
806: 		err = windows.Process32Next(snapshot, &entry)
807: 		if errors.Is(err, windows.ERROR_NO_MORE_FILES) {
808: 			break
809: 		}
810: 		if err != nil {
811: 			return zero, err
812: 		}
813: 	}
814: 	if matched == nil {
815: 		return zero, errors.New("current business Explorer token unavailable")
816: 	}
817: 	return *matched, nil
818: }
819: 
820: func sameBusinessPermissionSemantics(pre BootWitness, current businessTokenShape, expected string) error {
821: 	if current.LogonSID == "" || current.IntegritySID == "" || current.GroupsSHA256 != expected || current.ElevationType != pre.BusinessElevationType || current.IntegritySID != pre.BusinessIntegritySID || current.PrivilegesSHA256 != pre.BusinessPrivilegesSHA256 {
822: 		return errors.New("current business token permission semantics differ from pre witness")
823: 	}
824: 	return nil
825: }
826: 
827: func sameCurrentProcessWitness(post BootWitness, current businessTokenShape) error {
828: 	if post.BusinessEnabledSIDsSHA256 != current.GroupsSHA256 || post.BusinessSessionID != current.SessionID || post.BusinessLogonSID != current.LogonSID || post.BusinessProcessPID != current.ProcessID || !post.BusinessProcessCreatedUTC.Equal(current.ProcessCreated) || post.BusinessProcessImageSHA256 != current.ProcessImageSHA {
829: 		return errors.New("current business process identity changed")
830: 	}
831: 	return nil
832: }
833: 
834: // Windows may legitimately hard-link its own Explorer image. Read identity
835: // from one held native handle without applying the product target's hard-link
836: // ban to this OS image.
837: func osProcessImageIdentity(path string) (string, error) {
838: 	ptr, err := windows.UTF16PtrFromString(path)
839: 	if err != nil {
840: 		return "", err
841: 	}
842: 	h, err := windows.CreateFile(ptr, windows.FILE_READ_DATA|windows.FILE_READ_ATTRIBUTES,
843: 		windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, nil, windows.OPEN_EXISTING,
844: 		windows.FILE_FLAG_OPEN_REPARSE_POINT, 0)
845: 	if err != nil {
846: 		return "", err
847: 	}
848: 	defer windows.CloseHandle(h)
849: 	var info windows.ByHandleFileInformation
850: 	if err = windows.GetFileInformationByHandle(h, &info); err != nil {
851: 		return "", err
852: 	}
853: 	if info.FileAttributes&(windows.FILE_ATTRIBUTE_DIRECTORY|windows.FILE_ATTRIBUTE_REPARSE_POINT) != 0 {
854: 		return "", errors.New("OS process image is directory or reparse point")
855: 	}
856: 	volume, fileID, err := nativeFileID(h)
857: 	if err != nil {
858: 		return "", err
859: 	}
860: 	final, err := finalPath(h)
861: 	if err != nil {
862: 		return "", err
863: 	}
864: 	sum := sha256.New()
865: 	buf := make([]byte, 64<<10)
866: 	var total int64
867: 	for {
868: 		var n uint32
869: 		if err = windows.ReadFile(h, buf, &n, nil); err != nil {
870: 			return "", err
871: 		}
872: 		if n == 0 {
873: 			break
874: 		}
875: 		total += int64(n)
876: 		if total > 128<<20 {
877: 			return "", errors.New("OS process image exceeds hash bound")
878: 		}
879: 		_, _ = sum.Write(buf[:n])
880: 	}
881: 	return digest([]byte(fmt.Sprintf("%s|%d|%s|%x", strings.ToLower(final), volume, fileID, sum.Sum(nil)))), nil
882: }
883: 
884: func inspectLiveBusinessToken(p EntryFencePlan, expected string) error {
885: 	_, err := captureOfficialBusinessToken(p, expected)
886: 	return err
887: }
888: 
889: func captureOfficialBusinessToken(p EntryFencePlan, expected string) (businessTokenShape, error) {
890: 	var zero businessTokenShape
891: 	snapshot, err := windows.CreateToolhelp32Snapshot(windows.TH32CS_SNAPPROCESS, 0)
892: 	if err != nil {
893: 		return zero, err
894: 	}
895: 	defer windows.CloseHandle(snapshot)
896: 	var entry windows.ProcessEntry32
897: 	entry.Size = uint32(unsafe.Sizeof(entry))
898: 	if err = windows.Process32First(snapshot, &entry); err != nil {
899: 		return zero, err
900: 	}
901: 	for {
902: 		for _, target := range p.Targets {
903: 			if target.Mode != "executable" || !strings.EqualFold(windows.UTF16ToString(entry.ExeFile[:]), filepath.Base(target.File.Path)) {
904: 				continue
905: 			}
906: 			proc, openErr := windows.OpenProcess(windows.PROCESS_QUERY_LIMITED_INFORMATION, false, entry.ProcessID)
907: 			if openErr != nil {
908: 				return zero, openErr
909: 			}
910: 			buf := make([]uint16, 32768)
911: 			n := uint32(len(buf))
912: 			nameErr := windows.QueryFullProcessImageName(proc, 0, &buf[0], &n)
913: 			if nameErr != nil {
914: 				windows.CloseHandle(proc)
915: 				return zero, nameErr
916: 			}
917: 			if !strings.EqualFold(windows.UTF16ToString(buf[:n]), target.File.Path) {
918: 				windows.CloseHandle(proc)
919: 				continue
920: 			}
921: 			var token windows.Token
922: 			tokenErr := windows.OpenProcessToken(proc, windows.TOKEN_QUERY, &token)
923: 			var created, exited, kernel, userTime windows.Filetime
924: 			timeErr := windows.GetProcessTimes(proc, &created, &exited, &kernel, &userTime)
925: 			windows.CloseHandle(proc)
926: 			if tokenErr != nil || timeErr != nil {
927: 				if tokenErr == nil {
928: 					token.Close()
929: 				}
930: 				return zero, errors.Join(tokenErr, timeErr)
931: 			}
932: 			shape, shapeErr := tokenSecurityShape(token, entry.ProcessID, p.BusinessSID)
933: 			closeErr := token.Close()
934: 			if shapeErr != nil || closeErr != nil {
935: 				return zero, errors.Join(shapeErr, closeErr)
936: 			}
937: 			if shape.GroupsSHA256 != expected {
938: 				return zero, errors.New("actual business token enabled groups differ from frozen inventory")
939: 			}
940: 			shape.ProcessID = entry.ProcessID
941: 			shape.ProcessCreated = time.Unix(0, created.Nanoseconds()).UTC()
942: 			shape.ProcessImageSHA = digest([]byte(fmt.Sprintf("%s|%d|%s|%s", strings.ToLower(target.File.FinalUTF16), target.File.Volume, target.File.FileID, target.File.SHA256)))
943: 			return shape, nil
944: 		}
945: 		err = windows.Process32Next(snapshot, &entry)
946: 		if errors.Is(err, windows.ERROR_NO_MORE_FILES) {
947: 			return zero, errors.New("exact official process token unavailable for ancestor proof")
948: 		}
949: 		if err != nil {
950: 			return zero, err
951: 		}
952: 	}
953: }
954: 
955: func checkAncestorControl(p EntryFencePlan, holds []nativeHold) error {
956: 	enabled, err := verifiedBusinessGroups(p)
957: 	if err != nil {
958: 		return err
959: 	}
960: 	return checkAncestorACL(p, holds, enabled)
961: }
962: 
963: func checkAncestorACL(p EntryFencePlan, holds []nativeHold, enabled map[string]bool) error {
964: 	protected := map[string]bool{}
965: 	for _, a := range p.Ancestors {
966: 		protected[strings.ToLower(a.Path)] = true
967: 	}
968: 	protected[strings.ToLower(p.DataRoot.Path)] = true
969: 	for _, h := range holds {
970: 		if !protected[strings.ToLower(h.path)] {
971: 			continue
972: 		}
973: 		sd, e := windows.SecurityDescriptorFromString(h.identity.SecurityDescriptor)
974: 		if e != nil {
975: 			return e
976: 		}
977: 		owner, _, e := sd.Owner()
978: 		osAnchor := filepath.Dir(h.path) == h.path || strings.EqualFold(h.path, filepath.Join(filepath.VolumeName(h.path)+`\`, "Users"))
979: 		ownerTrusted := owner != nil && (owner.String() == p.ManagementSID || owner.String() == "S-1-5-18" || (osAnchor && owner.String() == "S-1-5-80-956008885-3418522649-1831038044-1853292631-2271478464"))
980: 		if e != nil || !ownerTrusted || enabled[owner.String()] {
981: 			return fmt.Errorf("ancestor owner can revoke boundary: %s", h.path)
982: 		}
983: 		acl, _, e := sd.DACL()
984: 		if e != nil || acl == nil {
985: 			return fmt.Errorf("ancestor DACL unavailable: %s", h.path)
986: 		}
987: 		for i := uint32(0); i < uint32(acl.AceCount); i++ {
988: 			var ace *windows.ACCESS_ALLOWED_ACE
989: 			if e = windows.GetAce(acl, i, &ace); e != nil {
990: 				return e
991: 			}
992: 			if ace.Header.AceFlags&windows.INHERIT_ONLY_ACE != 0 || ace.Header.AceType == windows.ACCESS_DENIED_ACE_TYPE {
993: 				continue
994: 			}
995: 			if ace.Header.AceType != windows.ACCESS_ALLOWED_ACE_TYPE {
996: 				return fmt.Errorf("ancestor ACL ACE unsupported: %s", h.path)
997: 			}
998: 			trustee := (*windows.SID)(unsafe.Pointer(&ace.SidStart)).String()
999: 			if !enabled[trustee] {
1000: 				continue
1001: 			}
1002: 			forbidden := uint32(0x40 | windows.WRITE_DAC | windows.WRITE_OWNER | windows.GENERIC_ALL) // FILE_DELETE_CHILD; GENERIC_WRITE maps to file writes only.
1003: 			if filepath.Dir(h.path) != h.path {
1004: 				forbidden |= windows.DELETE
1005: 			}
1006: 			if uint32(ace.Mask)&forbidden != 0 {
1007: 				return fmt.Errorf("business group can replace ancestor: %s", h.path)
1008: 			}
1009: 		}
1010: 	}
1011: 	return nil
1012: }
1013: 
1014: func preflightManagementRestore(p EntryFencePlan) error {
