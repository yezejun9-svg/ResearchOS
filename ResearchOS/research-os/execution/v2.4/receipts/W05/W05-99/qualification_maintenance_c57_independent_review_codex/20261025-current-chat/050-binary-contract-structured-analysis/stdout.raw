1: package recoveryboundary
2: 
3: import (
4: 	"crypto/sha256"
5: 	"encoding/hex"
6: 	"encoding/json"
7: 	"errors"
8: 	"fmt"
9: 	"path/filepath"
10: 	"strings"
11: 	"time"
12: )
13: 
14: const (
15: 	PlanSchema    = "researchos.recovery-boundary-plan.v1"
16: 	EventSchema   = "researchos.recovery-boundary-event.v1"
17: 	WitnessSchema = "researchos.post-restart-current-quiescence.v1"
18: 	// CurrentQuiescenceClass is scoped only to the C maintenance transaction.
19: 	// It is not a historical Wait, STOP closure, B drain ticket, or D proof.
20: 	CurrentQuiescenceClass = "POST_RESTART_CURRENT_QUIESCENCE_V1"
21: 	MaxElapsed             = 30 * time.Minute
22: 	MaxPostUptime          = 10 * time.Minute
23: )
24: 
25: // FileIdentity is evidence only. The native checker always reopens the object.
26: type FileIdentity struct {
27: 	Path               string `json:"path"`
28: 	FinalUTF16         string `json:"final_utf16"`
29: 	Volume             uint64 `json:"volume"`
30: 	FileID             string `json:"file_id"`
31: 	SHA256             string `json:"sha256,omitempty"`
32: 	SecurityDescriptor string `json:"security_descriptor"`
33: 	Directory          bool   `json:"directory"`
34: }
35: 
36: type FenceTarget struct {
37: 	File              FileIdentity `json:"file"`
38: 	Mode              string       `json:"mode"` // executable or script; exact access is checked natively
39: 	InstalledSD       string       `json:"installed_sd,omitempty"`
40: 	RestartArgsSHA256 []string     `json:"restart_args_sha256,omitempty"`
41: }
42: 
43: // EntryFencePlan describes the complete, frozen official entry inventory.
44: // Merely decoding one never grants an operation.
45: type EntryFencePlan struct {
46: 	Schema                 string         `json:"schema"`
47: 	OperationID            string         `json:"operation_id"`
48: 	PlanSHA256             string         `json:"plan_sha256"`
49: 	DataRoot               FileIdentity   `json:"data_root"`
50: 	Database               FileIdentity   `json:"database"`
51: 	Helper                 FileIdentity   `json:"helper"`
52: 	BusinessSID            string         `json:"business_sid"`
53: 	BusinessGroupSIDs      []string       `json:"business_group_sids"` // native potentially enableable groups; DENY_ONLY excluded, transient logon/integrity bound separately
54: 	ManagementSID          string         `json:"management_sid"`
