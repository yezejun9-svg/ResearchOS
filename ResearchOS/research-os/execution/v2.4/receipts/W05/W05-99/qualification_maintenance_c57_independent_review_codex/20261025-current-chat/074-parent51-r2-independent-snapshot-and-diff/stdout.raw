 func (p HistoricalQualificationPlan) coreHash() string { return Hash(p.Core) }
 
 func (p HistoricalQualificationPlan) beforeHash() string {
 	return Hash(Object{"census": p.BeforeCensus, "run": p.BeforeRun,
-		"state": p.BeforeState, "dispatch": p.BeforeDispatch,
+		"state": p.BeforeState, "dispatch": p.BeforeDispatch, "dispatch_row": p.BeforeDispatchRow,
 		"protected": p.BeforeProtectedSHA256, "residual": p.BeforeResidualSHA256})
+}
+
+// Keep the raw SQL image of every dispatch column. The decoded dispatch
+// object does not retain the exact manifest/identity bytes or prepared_at.
+type historicalQualificationDispatchRow struct {
+	Project             string                             `json:"project"`
+	Run                 string                             `json:"run"`
+	Epoch               int64                              `json:"epoch"`
+	DispatchKey         string                             `json:"dispatch_key"`
+	Manifest            string                             `json:"manifest"`
+	ManifestHash        string                             `json:"manifest_hash"`
+	State               string                             `json:"state"`
+	Worker              string                             `json:"worker"`
+	JournalLocator      string                             `json:"journal_locator"`
+	Identity            string                             `json:"identity"`
+	ObservationSequence int64                              `json:"observation_sequence"`
+	ObservationHash     string                             `json:"observation_hash"`
+	PreparedAt          string                             `json:"prepared_at"`
+	UpdatedAt           string                             `json:"updated_at"`
+	Reason              string                             `json:"reason"`
+	Cells               [15]historicalQualificationSQLCell `json:"cells"`
+}
+
+type historicalQualificationSQLCell struct {
+	Type string `json:"type"`
+	Data []byte `json:"data"`
+}
+
+func historicalQualificationReadDispatchRow(ctx context.Context, tx *sql.Tx, subject HistoricalQualificationSubject) (historicalQualificationDispatchRow, error) {
+	var r historicalQualificationDispatchRow
+	err := tx.QueryRowContext(ctx, `SELECT project,run,epoch,dispatch_key,manifest,manifest_hash,state,worker,journal_locator,identity,observation_sequence,observation_hash,prepared_at,updated_at,reason
+		FROM runtime_dispatches WHERE project=? AND run=? AND epoch=?`, subject.ProjectID, subject.RunID, subject.Epoch).
+		Scan(&r.Project, &r.Run, &r.Epoch, &r.DispatchKey, &r.Manifest, &r.ManifestHash,
+			&r.State, &r.Worker, &r.JournalLocator, &r.Identity, &r.ObservationSequence,
+			&r.ObservationHash, &r.PreparedAt, &r.UpdatedAt, &r.Reason)
+	if err != nil {
+		return r, err
+	}
+	// SQLite affinity permits BLOB or numeric storage in a TEXT column.
+	// Preserve every cell's storage class and exact bytes across JSON round trips.
+	cols := []string{"project", "run", "epoch", "dispatch_key", "manifest", "manifest_hash", "state", "worker", "journal_locator", "identity", "observation_sequence", "observation_hash", "prepared_at", "updated_at", "reason"}
+	fields := make([]string, 0, len(cols)*2)
+	args := make([]any, 0, len(cols)*2)
+	for i, col := range cols {
+		fields = append(fields, "typeof("+col+")", "CAST("+col+" AS BLOB)")
+		args = append(args, &r.Cells[i].Type, &r.Cells[i].Data)
+	}
+	err = tx.QueryRowContext(ctx, "SELECT "+strings.Join(fields, ",")+" FROM runtime_dispatches WHERE project=? AND run=? AND epoch=?",
+		subject.ProjectID, subject.RunID, subject.Epoch).Scan(args...)
+	return r, err
 }
 
