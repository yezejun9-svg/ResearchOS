620:
621:// PlanHistoricalQualification performs only reads of the existing database.
622:// The returned plan is informational until a separate boot-bound opaque
623:// current-quiescence witness, native root lock and journal BEGIN are present.
624:func PlanHistoricalQualification(ctx context.Context, db *sql.DB, contractsDir string,
625:	subject HistoricalQualificationSubject, source HistoricalQualificationSource,
626:	authorID, dataRoot, operationID, boundaryPlanSHA256, sid string) (plan HistoricalQualificationPlan, retErr error) {
627:	if db == nil || !filepath.IsAbs(dataRoot) || filepath.Clean(dataRoot) != dataRoot ||
628:		!filepath.IsAbs(contractsDir) || sid == "" {
629:		return plan, qualificationDenialUnavailable("historical preflight input invalid")
630:	}
631:	contracts, err := LoadContracts(contractsDir)
632:	if err != nil {
633:		return plan, err
634:	}
635:	s := &Service{DB: db, Contracts: contracts}
636:	tx, err := db.BeginTx(ctx, &sql.TxOptions{ReadOnly: true})
637:	if err != nil {
638:		return plan, err
639:	}
640:	var hold *historicalQualificationHold
641:	defer func() {
642:		retErr = errors.Join(retErr, tx.Rollback())
643:		if hold != nil {
644:			retErr = errors.Join(retErr, hold.Close())
645:		}
646:	}()
647:	var manifestHash string
648:	if err := tx.QueryRowContext(ctx, `SELECT manifest_hash FROM runtime_dispatches WHERE project=? AND run=? AND epoch=? AND dispatch_key=?`,
649:		subject.ProjectID, subject.RunID, subject.Epoch, subject.DispatchKey).Scan(&manifestHash); err != nil || manifestHash == "" {
650:		return plan, qualificationDenialUnavailable("exact historical dispatch unavailable")
651:	}
652:	directory := filepath.Join(dataRoot, "runtime-dispatches", subject.DispatchKey)
653:	native, nativeHold, err := holdHistoricalQualificationNative(directory, manifestHash, "", sid)
654:	if err != nil {
655:		return plan, err
656:	}
657:	hold = nativeHold
658:	verified, err := s.verifyHistoricalQualificationTx(ctx, tx, subject, source, authorID, directory, sid, native)
659:	if err != nil {
660:		return plan, err
661:	}
662:	before, err := store.QualificationMaintenanceCensus(ctx, tx)
663:	if err != nil {
664:		return plan, err
665:	}
666:	plan, err = s.buildHistoricalQualificationPlan(tx, verified, operationID, boundaryPlanSHA256, dataRoot,
667:		filepath.Join(dataRoot, "researchos.sqlite"), directory, sid, before, nil)
668:	if err != nil {
669:		return plan, err
670:	}
671:	if err = hold.Check(); err != nil {
672:		return plan, err
673:	}
674:	return plan, nil
675:}
676:
677:func historicalMaintenanceMarker(plan HistoricalQualificationPlan, planFileSHA256 string) Object {
678:	return Object{"schema": "researchos.qualification-failure-maintenance-marker.v1",
679:		"kind": historicalMaintenanceProofKind, "operation_id": plan.OperationID,
680:		"plan_hash": plan.coreHash(), "plan_file_sha256": planFileSHA256,
