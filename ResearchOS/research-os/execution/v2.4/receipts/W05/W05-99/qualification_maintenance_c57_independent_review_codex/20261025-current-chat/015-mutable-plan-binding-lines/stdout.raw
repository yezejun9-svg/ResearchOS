internal/recoveryboundary/boot_windows.go
611:// ReadBoundaryPlan returns evidence for a C preflight. Its return value is
612:// serializable data, never authority to enter a transaction.
613:func ReadBoundaryPlan(dataRoot, operationID, boundaryPlanSHA256 string) (EntryFencePlan, string, error) {
614:	var zero EntryFencePlan
615:	if !filepath.IsAbs(dataRoot) || !validOperation(operationID) || !validDigest(boundaryPlanSHA256) {
616:		return zero, "", errors.New("boundary selector invalid")
617:	}
618:	p, e := discoverPlan(dataRoot, operationID, boundaryPlanSHA256)
619:	if e != nil {
620:		return zero, "", e
621:	}
622:	if e = ValidatePlan(p); e != nil {
623:		return zero, "", e
624:	}
625:	if e = checkManagedChain(p); e != nil {
626:		return zero, "", e
627:	}
628:	if e = checkAcceptanceFiles(p); e != nil {
629:		return zero, "", e
630:	}
631:	r, e := readRecord(p)
632:	if e != nil {
633:		return zero, "", e
634:	}
635:	state := r.Events[len(r.Events)-1].State
636:	if state == "BOOT_OBSERVED" {
637:		if e = ValidateRestart(r.Pre, r.Post); e != nil {
638:			return zero, "", e
639:		}
640:		if e = checkCurrentBoot(r.Post); e != nil {
641:			return zero, "", e
642:		}
643:	}
644:	return p, state, nil
645:}
