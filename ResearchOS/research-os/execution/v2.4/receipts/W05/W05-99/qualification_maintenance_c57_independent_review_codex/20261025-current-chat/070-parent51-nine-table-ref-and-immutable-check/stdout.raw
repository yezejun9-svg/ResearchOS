1040: func historicalQualificationRefRevisionMatches(tx *sql.Tx, project, kind string, object Object, oldRows, newRows []any) (bool, error) {
1041: 	if len(oldRows) != len(newRows) {
1042: 		return false, nil
1043: 	}
1044: 	for i, entry := range newRows {
1045: 		current, ok := entry.([]any)
1046: 		if !ok || len(current) != 5 {
1047: 			return false, nil
1048: 		}
1049: 		prior, ok := oldRows[i].([]any)
1050: 		if !ok || len(prior) != 5 {
1051: 			return false, nil
1052: 		}
1053: 		for j := 0; j < 4; j++ {
1054: 			if current[j] != prior[j] {
1055: 				return false, nil
1056: 			}
1057: 		}
1058: 		field, ok := current[0].(string)
1059: 		if !ok || !strings.HasPrefix(field, "/") {
1060: 			return false, nil
1061: 		}
1062: 		targetKind, _ := current[2].(string)
1063: 		targetID, _ := current[3].(string)
1064: 		targetRevision, ok := current[4].(int64)
1065: 		if !ok {
1066: 			return false, nil
1067: 		}
1068: 		value := historicalRefValue(object, field)
1069: 		if ref, ok := value.(map[string]any); ok {
1070: 			rev, e := Num(Object(ref), "revision")
1071: 			if e != nil || ref["entity_type"] != targetKind || ref["id"] != targetID || rev != targetRevision {
1072: 				return false, nil
1073: 			}
1074: 			continue
1075: 		}
1076: 		parts := strings.Split(strings.TrimPrefix(field, "/"), "/")
1077: 		if len(parts) == 0 || relationKind(kind, parts[0]) != targetKind {
1078: 			return false, nil
1079: 		}
1080: 		textValue, _ := value.(string)
1081: 		contained := textValue == targetID
1082: 		if list, ok := value.([]any); ok {
1083: 			contained = false
1084: 			for _, v := range list {
1085: 				if v == targetID {
1086: 					contained = true
1087: 					break
1088: 				}
1089: 			}
1090: 		}
1091: 		if !contained {
1092: 			return false, nil
1093: 		}
1094: 		var currentRevision int64
1095: 		if e := tx.QueryRow(`SELECT revision FROM domain_objects WHERE project=? AND kind=? AND id=?`,
1096: 			project, targetKind, targetID).Scan(&currentRevision); e != nil {
1097: 			return false, e
1098: 		}
1099: 		if currentRevision != targetRevision {
1100: 			return false, nil
1101: 		}
1102: 	}
1103: 	return true, nil
1104: }
