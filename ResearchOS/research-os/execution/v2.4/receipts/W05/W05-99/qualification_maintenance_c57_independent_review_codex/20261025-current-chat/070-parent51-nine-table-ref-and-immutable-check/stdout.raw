1001: func historicalQualificationRefs(tx *sql.Tx, project, kind, id string, revision int64) ([]any, error) {
1002: 	rows, err := tx.Query(`SELECT field,target_project,target_kind,target_id,target_revision FROM domain_refs
1003: 		WHERE project=? AND kind=? AND id=? AND revision=?
1004: 		ORDER BY field,target_project,target_kind,target_id,target_revision`, project, kind, id, revision)
1005: 	if err != nil {
1006: 		return nil, err
1007: 	}
1008: 	defer rows.Close()
1009: 	var out []any
1010: 	for rows.Next() {
1011: 		var field, targetProject, targetKind, targetID string
1012: 		var targetRevision int64
1013: 		if err = rows.Scan(&field, &targetProject, &targetKind, &targetID, &targetRevision); err != nil {
1014: 			return nil, err
1015: 		}
1016: 		out = append(out, []any{field, targetProject, targetKind, targetID, targetRevision})
1017: 	}
1018: 	return out, rows.Err()
1019: }
