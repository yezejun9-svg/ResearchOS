1021: func historicalRefValue(object Object, path string) any {
1022: 	var current any = object
1023: 	for _, component := range strings.Split(strings.TrimPrefix(path, "/"), "/") {
1024: 		switch x := current.(type) {
1025: 		case map[string]any:
1026: 			current = x[component]
1027: 		case []any:
1028: 			i, e := strconv.Atoi(component)
1029: 			if e != nil || i < 0 || i >= len(x) {
1030: 				return nil
1031: 			}
1032: 			current = x[i]
1033: 		default:
1034: 			return nil
1035: 		}
1036: 	}
1037: 	return current
1038: }
