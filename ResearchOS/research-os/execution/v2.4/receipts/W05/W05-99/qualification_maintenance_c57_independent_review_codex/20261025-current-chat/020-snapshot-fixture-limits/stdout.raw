202:func TestDisposableExecutableFenceReadbackAndRestore(t *testing.T) {
203:	dir := t.TempDir()
204:	path := filepath.Join(dir, "boot-fixture.exe")
205:	if err := os.WriteFile(path, []byte("fixture-only"), 0600); err != nil {
206:		t.Fatal(err)
207:	}
208:	before, err := openNative(path, false, true)
209:	if err != nil {
210:		t.Fatal(err)
211:	}
212:	defer windows.CloseHandle(before.handle)
213:	u, err := windows.GetCurrentProcessToken().GetTokenUser()
214:	if err != nil {
215:		t.Fatal(err)
216:	}
217:	installed, err := denyDescriptor(before.identity.SecurityDescriptor, u.User.Sid.String(),u.User.Sid.String(), "executable")
218:	if err != nil {
219:		t.Fatal(err)
220:	}
221:	if installed == before.identity.SecurityDescriptor {
222:		t.Fatal("fence did not change descriptor")
223:	}
224:	if err = setTargetDescriptor(path, installed); err != nil {
225:		t.Skipf("fixture WRITE_DAC unavailable: %v", err)
226:	}
227:	defer func() {
228:		if err := setTargetDescriptor(path, before.identity.SecurityDescriptor); err != nil {
229:			t.Errorf("fixture descriptor restore: %v", err)
230:		}
231:	}()
232:	after, err := openNative(path, false, true)
233:	if err != nil {
234:		t.Fatal(err)
235:	}
236:	if !identityCoreEqual(before.identity, after.identity) || after.identity.SecurityDescriptor != installed {
237:		t.Errorf("installed native identity/readback mismatch: core=%v expectedSD=%q actualSD=%q", identityCoreEqual(before.identity, after.identity), installed, after.identity.SecurityDescriptor)
238:	}
239:	if err := windows.CloseHandle(after.handle); err != nil {
240:		t.Fatal(err)
241:	}
242:	w, err := windows.UTF16PtrFromString(path)
243:	if err != nil {
244:		t.Fatal(err)
245:	}
246:	h, err := windows.CreateFile(w, windows.FILE_EXECUTE, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, nil, windows.OPEN_EXISTING, 0, 0)
247:	if err == nil {
248:		windows.CloseHandle(h)
249:		t.Fatal("business SID execute opened through fence")
250:	}
251:	if !errors.Is(err, windows.ERROR_ACCESS_DENIED) {
252:		t.Fatalf("execute rejection differs: %v", err)
253:	}
254:	if err = setTargetDescriptor(path, before.identity.SecurityDescriptor); err != nil {
255:		t.Fatal(err)
256:	}
257:	restored, err := openNative(path, false, true)
258:	if err != nil {
259:		t.Fatal(err)
260:	}
261:	if !identityEqual(before.identity, restored.identity) {
262:		t.Error("original descriptor not restored exactly")
263:	}
264:	if err := windows.CloseHandle(restored.handle); err != nil {
265:		t.Fatal(err)
266:	}
267:}
