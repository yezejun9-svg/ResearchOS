269:func TestDistinctManagerPlanTransfersOwnerAndDeniesFenceTamper(t *testing.T) {
270:	path:=filepath.Join(t.TempDir(),"managed-entry.exe")
271:	if err:=os.WriteFile(path,[]byte("fixture"),0600); err!=nil { t.Fatal(err) }
272:	h,err:=openNative(path,false,true); if err!=nil { t.Fatal(err) }; defer windows.CloseHandle(h.handle)
273:	u,err:=windows.GetCurrentProcessToken().GetTokenUser(); if err!=nil { t.Fatal(err) }
274:	manager:="S-1-5-32-544" // descriptor-construction fixture only; no privileged owner change
275:	installed,err:=denyDescriptor(h.identity.SecurityDescriptor,u.User.Sid.String(),manager,"executable"); if err!=nil { t.Fatal(err) }
276:	sd,err:=windows.SecurityDescriptorFromString(installed); if err!=nil { t.Fatal(err) }
277:	owner,_,err:=sd.Owner(); if err!=nil || owner.String()!=manager { t.Fatalf("management owner absent: %v %v",owner,err) }
278:	acl,_,err:=sd.DACL(); if err!=nil { t.Fatal(err) }
279:	var ace *windows.ACCESS_ALLOWED_ACE; if err=windows.GetAce(acl,0,&ace); err!=nil { t.Fatal(err) }
280:	want:=uint32(windows.FILE_EXECUTE|windows.WRITE_DAC|windows.WRITE_OWNER|windows.DELETE|windows.FILE_WRITE_DATA|windows.FILE_APPEND_DATA)
281:	if ace.Header.AceType!=windows.ACCESS_DENIED_ACE_TYPE || ace.Mask&want!=want || (*windows.SID)(unsafe.Pointer(&ace.SidStart)).String()!=u.User.Sid.String() { t.Fatal("exact business SID anti-tamper deny absent") }
282:}
