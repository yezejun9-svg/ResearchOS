394:func exerciseSQLiteWALUnderFence(t *testing.T, parent string) {
395:	t.Helper()
396:	root := filepath.Join(parent, "data-root")
397:	if err := os.Mkdir(root, 0700); err != nil {
398:		t.Fatal(err)
399:	}
400:	lease, err := rt.AcquireDataRootLease(root)
401:	if err != nil {
402:		t.Fatalf("business root lease under fence: %v", err)
403:	}
404:	defer func() {
405:		if err := lease.Close(); err != nil {
406:			t.Errorf("business lease close: %v", err)
407:		}
408:	}()
409:	if !lease.Held() {
410:		t.Fatal("business root lease not held")
411:	}
412:	dbPath := filepath.Join(root, "researchos.sqlite")
413:	db, err := sql.Open("sqlite", dbPath)
414:	if err != nil {
415:		t.Fatal(err)
416:	}
417:	defer db.Close()
418:	var mode string
419:	if err = db.QueryRow(`PRAGMA journal_mode=WAL`).Scan(&mode); err != nil || strings.ToLower(mode) != "wal" {
420:		t.Fatalf("business WAL unavailable: %q %v", mode, err)
421:	}
422:	if _, err = db.Exec(`CREATE TABLE fixture (id INTEGER PRIMARY KEY, value TEXT NOT NULL)`); err != nil {
423:		t.Fatal(err)
424:	}
425:	if _, err = db.Exec(`INSERT INTO fixture(value) VALUES ('fence-compatible')`); err != nil {
426:		t.Fatal(err)
427:	}
428:	var got string
429:	if err = db.QueryRow(`SELECT value FROM fixture WHERE id=1`).Scan(&got); err != nil || got != "fence-compatible" {
430:		t.Fatalf("business SQLite read under fence: %q %v", got, err)
431:	}
432:	if _, err = os.Stat(dbPath + "-wal"); err != nil {
433:		t.Fatalf("business WAL file missing while DB open: %v", err)
434:	}
435:	t.Log("business data-root lease held; SQLite read/write and WAL file remained usable under executable fence")
436:}
