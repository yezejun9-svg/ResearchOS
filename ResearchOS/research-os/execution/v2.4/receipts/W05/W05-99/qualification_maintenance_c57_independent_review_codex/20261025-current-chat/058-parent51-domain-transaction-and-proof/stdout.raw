1378: func (s *Service) verifyHistoricalQualificationTx(ctx context.Context, tx *sql.Tx,
1379: 	subject HistoricalQualificationSubject, source HistoricalQualificationSource,
1380: 	authorID, directory, sid string, native historicalQualificationNative) (verifiedHistoricalQualification, error) {
1381: 	var out verifiedHistoricalQualification
1382: 	deny := func(reason string) (verifiedHistoricalQualification, error) {
1383: 		return out, qualificationDenialUnavailable("historical " + reason)
1384: 	}
1385: 	if tx == nil || subject.ProjectID == "" || subject.TaskID == "" || subject.RunID == "" ||
1386: 		subject.RuntimeID == "" || subject.DispatchKey == "" || subject.Epoch != 1 ||
1387: 		source.BridgeSHA256 == "" || source.SourceCommit == "" || source.CoreSHA256 == "" ||
1388: 		source.WorkerSHA256 == "" || source.BuildSHA256 == "" || source.PID == 0 ||
1389: 		source.Created <= 0 || source.Job == "" || authorID == "" || sid == "" {
1390: 		return deny("exact subject/source binding missing")
1391: 	}
1392: 	j := native.journal
1393: 	f1, f2, f3 := native.frames[0], native.frames[1], native.frames[2]
1394: 	if native.bridgeHash != source.BridgeSHA256 || native.stdoutHash != j.StdoutHash || native.stderrHash != j.StderrHash ||
1395: 		j.DispatchKey != subject.DispatchKey || j.Identity.PID != source.PID || j.Identity.Created != source.Created ||
1396: 		j.Identity.Job != source.Job || j.Receipt.PID != source.PID || j.Receipt.Created != source.Created ||
1397: 		j.Receipt.Job != source.Job || j.Receipt.SID != j.Identity.SID || j.Receipt.Profile != j.Identity.Profile ||
1398: 		j.Identity.SID == "" || !j.Receipt.Stopped || !j.Receipt.StreamsDrained || !j.Receipt.CleanupComplete ||
1399: 		!j.Receipt.OutputCopied || j.Receipt.ExitCode != 124 || !j.Receipt.TimedOut ||
1400: 		j.Receipt.JobProcesses != 2 || j.Frames != 3 || j.Acknowledged != 2 ||
1401: 		j.QueueRequired || j.QueueInitSequence != 0 || len(j.CommandReceipts) != 0 ||
1402: 		j.Checkpoint != nil || j.CheckpointSequence != 0 || j.Paused || j.ProtocolComplete ||
1403: 		(j.State != "FAILED" && j.State != "UNKNOWN") || j.Reason != "qualification first dispatch gate denied TOOL" ||
1404: 		f1.Sequence != 1 || f1.Type != "context.ready" || f2.Sequence != 2 || f2.Capability != "MODEL" ||
1405: 		f3.Sequence != 3 || f3.Capability != "TOOL" || f2.Key == "" || f3.Key == "" ||
1406: 		f2.Key == f3.Key || f2.Route == "" || f3.Route != f2.Route {
1407: 		return deny("raw native Job accounting/three-frame source differs")
1408: 	}
1409: 	if filepath.Clean(directory) != directory || filepath.Base(directory) != subject.DispatchKey ||
1410: 		filepath.Base(filepath.Dir(directory)) != "runtime-dispatches" {
1411: 		return deny("dispatch directory identity differs")
1412: 	}
1413: 	run, err := load(tx, subject.ProjectID, "Run", subject.RunID)
1414: 	if err != nil {
1415: 		return out, err
1416: 	}
1417: 	task, err := load(tx, subject.ProjectID, "Task", subject.TaskID)
1418: 	if err != nil {
1419: 		return out, err
1420: 	}
1421: 	state, err := singleton(tx, subject.ProjectID, "ProjectState")
1422: 	if err != nil {
1423: 		return out, err
1424: 	}
1425: 	dispatch, err := runtimeDispatch(tx, subject.ProjectID, subject.RunID, subject.Epoch)
1426: 	if err != nil {
1427: 		return out, err
1428: 	}
1429: 	manifest, manifestOK := dispatch["manifest"].(map[string]any)
1430: 	admission, admissionOK := manifest["admission"].(map[string]any)
