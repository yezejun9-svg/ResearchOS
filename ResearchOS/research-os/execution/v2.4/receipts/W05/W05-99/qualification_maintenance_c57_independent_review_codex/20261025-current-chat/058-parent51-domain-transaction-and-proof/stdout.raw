FILE internal/domain/qualification_failure_maintenance_windows.go
1328: func ClassifyHistoricalQualification(ctx context.Context, db *sql.DB, plan HistoricalQualificationPlan, planFileSHA256 string) (_ string, retErr error) {
1329: 	if db == nil || plan.Schema != "researchos.qualification-failure-maintenance-full-plan.v1" || planFileSHA256 == "" {
1330: 		return "", errors.New("qualification classifier plan invalid")
1331: 	}
1332: 	tx, err := db.BeginTx(ctx, &sql.TxOptions{ReadOnly: true})
1333: 	if err != nil {
1334: 		return "", err
1335: 	}
1336: 	defer func() { retErr = errors.Join(retErr, tx.Rollback()) }()
1337: 	full, err := store.QualificationMaintenanceCensus(ctx, tx)
1338: 	if err != nil {
1339: 		return "", err
1340: 	}
1341: 	var count int
1342: 	err = tx.QueryRowContext(ctx, `SELECT count(*) FROM idempotency WHERE principal=? AND project=? AND operation='host:qualification-failure-maintenance' AND key=?`,
1343: 		plan.AuthorID, plan.Subject.ProjectID, plan.OperationID).Scan(&count)
1344: 	if err != nil {
1345: 		return "", err
1346: 	}
1347: 	if Hash(full) == Hash(plan.BeforeCensus) && count == 0 {
1348: 		return "NOT_APPLIED", nil
1349: 	}
1350: 	if count != 1 || full.SchemaSHA256 != plan.BeforeCensus.SchemaSHA256 {
1351: 		return "UNKNOWN", nil
1352: 	}
1353: 	protected, err := store.QualificationMaintenanceProtectedCensus(ctx, tx)
1354: 	if err != nil {
1355: 		return "", err
1356: 	}
1357: 	selectors, err := plan.residualSelectors()
1358: 	if err != nil {
1359: 		return "", err
1360: 	}
1361: 	residual, err := store.QualificationMaintenanceResidualCensus(ctx, tx, selectors)
1362: 	if err != nil {
1363: 		return "", err
1364: 	}
1365: 	if protected != plan.BeforeProtectedSHA256 || residual != plan.BeforeResidualSHA256 {
1366: 		return "UNKNOWN", nil
1367: 	}
1368: 	exact, err := historicalQualificationExactRows(ctx, tx, plan, planFileSHA256)
1369: 	if err != nil {
1370: 		return "", err
1371: 	}
1372: 	if !exact {
1373: 		return "UNKNOWN", nil
1374: 	}
1375: 	return "APPLIED", nil
1376: }
