[
  {
    "id": "F01",
    "priority": "P1",
    "status": "MANDATORY_SOURCE_REFINEMENT",
    "title": "Per-object deny needs persistent namespace and effective ACL validation",
    "fix": "Native same-handle volume/128bitID/finalpath/hash/SD/reparse and retained ancestor checks inside boot_windows.go; no existing accepted helper prerequisite."
  },
  {
    "id": "F02",
    "priority": "P1",
    "status": "MANDATORY_SOURCE_AND_ACTUAL_REFINEMENT",
    "title": "Shared ancestors require explicit exact deployment scope",
    "fix": "D root AU 0x1301bf excludes DELETE_CHILD/WRITE_DAC/WRITE_OWNER; no drive ACL reset. Protect selected D portfolio and C home/.codex/cache edges; preserve dense deny preimages; no implicit authority."
  },
  {
    "id": "F03",
    "priority": "P1",
    "status": "SOURCE_CAPABILITY_AND_ACTUAL_GAP",
    "title": "Runtime RestartApps cannot be inferred from static no-call scan",
    "fix": "Bounded exact-process registration reader plus exact runtime/argv native fixture; unknown registration or uncovered normal branch blocks arm."
  },
  {
    "id": "F04",
    "priority": "P1",
    "status": "MANDATORY_RECOVERY_STATE_FIX",
    "title": "Pending C cannot release ungated legacy entry fence",
    "fix": "Allow legacy restore only pre-BEGIN proven no C effect or exact classified durable terminal/NOT_APPLIED/ABORTED; pending/unknown retains fence and journals."
  },
  {
    "id": "F05",
    "priority": "P1",
    "status": "ACTUAL_RESOURCE_REQUIRED",
    "title": "Recovery principal and business identity must be distinct",
    "fix": "Prefer distinct SID elevated recovery admin; same-SID elevation does not nullify SID deny. Trusted owner or independently tested OWNER RIGHTS policy; preserve business Owner."
  },
  {
    "id": "F06",
    "priority": "P1",
    "status": "SEPARATE_QUALIFICATION_AND_ACTUAL_GAP",
    "title": "Online backup cannot blindly acquire lease or initialize Host",
    "fix": "Consume Root mapped CLI contract and unchanged-Source held-lease/restore fixture; actual workspace/Host changes, key, restore usable proof before arm."
  },
  {
    "id": "F07",
    "priority": "P1",
    "status": "SOURCE_GATE",
    "title": "B online private API does not authorize historical C",
    "fix": "Wait independent B-r2; private historical validator with distinct marker namespace and exact currentOwner/model/raw bindings; no fabricated denial/drain/ACK."
  },
  {
    "id": "F08",
    "priority": "P1",
    "status": "ROOT_ADOPTION_REQUIRED",
    "title": "C-only operational substitute must be explicit",
    "fix": "Keep CP511 history and strict STOP unchanged; explicit alternative only for present quiescence under accepted boot boundary."
  },
  {
    "id": "F09",
    "priority": "P1",
    "status": "SOURCE_TEST_AND_ACTUAL_GATE",
    "title": "Namespace ACL cannot block necessary business data operations",
    "fix": "Separate entry/ancestor/data policies; actual SQLite/WAL/lease positive plus namespace-negative native tests. No broad temporary unlock or admin-as-business-Owner."
  }
]
[
  "Use the accepted Source43 snapshot including B-r3 native opaque closure, STOP19 and roots2 Unicode repair, never legacy unaccepted B-r2 API assumptions.",
  "The historical maintenance variant of validatedQualificationFailureTx remains private and distinct; its returned closure holds original raw evidence and native namespace identities until actual transaction Commit or Rollback has returned, and then Close on success and all errors. Cached proof maps or Check followed by early Close are invalid.",
  "Normal/replay/backup/release-host entry gates are early and pure before Host.New/store.Open/provider/template/key effects; preserve existing replacement own recovery applied/unapplied behavior.",
  "Source scopes are independent of original DB/Host/process/boot authority. Original data is never a test fixture. Tests may create and remove only explicitly task-owned disposable roots with validated absolute containment; old denied cleanup paths remain untouched.",
  "Before new package directories are created, write their responsibility, naming, lifecycle and cleanup conventions in own receipts. This satisfies canonical directory conventions without expanding exact production source allowlist.",
  "Architecture and boot reviews are already adopted subject to enumerated refinements. Implement those refinements directly; do not restart design reviews due superseded status text in old frozen architecture documents. Concrete new scope blockers require Root amendment.",
  "Source680 / Source25 schema work must remain separate; C fixture is schema24 with all87 application tables. No migration to25 in original data or this source branch.",
  "No swallowed original failures or fabricated privileged/FullRestart acceptance. Native nonprivileged fixture positives should run; missing distinct-SID/full-restart resources only limit those actual proof branches and must be explicitly reported."
]
{
  "source": [
    "B independent accepted snapshot",
    "Root exact 57-path responsibility/API freeze",
    "F01-F09 incorporated; no new mechanism"
  ],
  "native": [
    "same-handle/ACL/reparse/hardlink/ancestor races tested",
    "real PE execute and script read denial",
    "real RestartApps outcomes and phase CLI",
    "all C-LD01..03 and private transaction/replay checks"
  ],
  "privileged": [
    "distinct SID restore vs business user",
    "dense-ACE-preserving deployment and restoration",
    "persistent protection across actual fixture full restart",
    "legitimate OS ancestors and sibling/no business DB breakage"
  ],
  "actual_before_arm": [
    "complete actual supported-set image mapping",
    "accepted usable consistent online backup and Host side-effects scope",
    "authorized exact shared ACL delta/readback",
    "working protected recovery path",
    "accepted Source/native/privileged qualification"
  ],
  "after_restart": [
    "explicit later user FullRestart",
    "native uptime strict decrease and <=10m; pre>=10m; UTC delta<=30m",
    "trusted time and no VM/disk rollback assumption",
    "same host/businessSID/native root+DB identity",
    "persistent fence continuity and no normal supported postboot execution",
    "held root lease and dispatch owner lock through census/CAS/commit/receipt",
    "complete present census with no unresolved external effects"
  ]
}
