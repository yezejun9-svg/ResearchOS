531: func (p HistoricalQualificationPlan) beforeHash() string {
532: 	return Hash(Object{"census": p.BeforeCensus, "run": p.BeforeRun,
533: 		"state": p.BeforeState, "dispatch": p.BeforeDispatch, "dispatch_row": p.BeforeDispatchRow,
534: 		"protected": p.BeforeProtectedSHA256, "residual": p.BeforeResidualSHA256})
535: }
536: 
537: // Keep the raw SQL image of every dispatch column. The decoded dispatch
538: // object does not retain the exact manifest/identity bytes or prepared_at.
539: type historicalQualificationDispatchRow struct {
540: 	Project             string                             `json:"project"`
541: 	Run                 string                             `json:"run"`
542: 	Epoch               int64                              `json:"epoch"`
543: 	DispatchKey         string                             `json:"dispatch_key"`
544: 	Manifest            string                             `json:"manifest"`
545: 	ManifestHash        string                             `json:"manifest_hash"`
546: 	State               string                             `json:"state"`
547: 	Worker              string                             `json:"worker"`
548: 	JournalLocator      string                             `json:"journal_locator"`
549: 	Identity            string                             `json:"identity"`
550: 	ObservationSequence int64                              `json:"observation_sequence"`
551: 	ObservationHash     string                             `json:"observation_hash"`
552: 	PreparedAt          string                             `json:"prepared_at"`
553: 	UpdatedAt           string                             `json:"updated_at"`
554: 	Reason              string                             `json:"reason"`
555: 	Cells               [15]historicalQualificationSQLCell `json:"cells"`
556: }
557: 
558: type historicalQualificationSQLCell struct {
559: 	Type string `json:"type"`
560: 	Data []byte `json:"data"`
561: }
562: 
563: func historicalQualificationReadDispatchRow(ctx context.Context, tx *sql.Tx, subject HistoricalQualificationSubject) (historicalQualificationDispatchRow, error) {
564: 	var r historicalQualificationDispatchRow
565: 	err := tx.QueryRowContext(ctx, `SELECT project,run,epoch,dispatch_key,manifest,manifest_hash,state,worker,journal_locator,identity,observation_sequence,observation_hash,prepared_at,updated_at,reason
566: 		FROM runtime_dispatches WHERE project=? AND run=? AND epoch=?`, subject.ProjectID, subject.RunID, subject.Epoch).
567: 		Scan(&r.Project, &r.Run, &r.Epoch, &r.DispatchKey, &r.Manifest, &r.ManifestHash,
568: 			&r.State, &r.Worker, &r.JournalLocator, &r.Identity, &r.ObservationSequence,
569: 			&r.ObservationHash, &r.PreparedAt, &r.UpdatedAt, &r.Reason)
570: 	if err != nil {
571: 		return r, err
572: 	}
573: 	// SQLite affinity permits BLOB or numeric storage in a TEXT column.
574: 	// Preserve every cell's storage class and exact bytes across JSON round trips.
575: 	cols := []string{"project", "run", "epoch", "dispatch_key", "manifest", "manifest_hash", "state", "worker", "journal_locator", "identity", "observation_sequence", "observation_hash", "prepared_at", "updated_at", "reason"}
576: 	fields := make([]string, 0, len(cols)*2)
577: 	args := make([]any, 0, len(cols)*2)
578: 	for i, col := range cols {
579: 		fields = append(fields, "typeof("+col+")", "CAST("+col+" AS BLOB)")
580: 		args = append(args, &r.Cells[i].Type, &r.Cells[i].Data)
581: 	}
582: 	err = tx.QueryRowContext(ctx, "SELECT "+strings.Join(fields, ",")+" FROM runtime_dispatches WHERE project=? AND run=? AND epoch=?",
583: 		subject.ProjectID, subject.RunID, subject.Epoch).Scan(args...)
584: 	return r, err
585: }
586: 
587: func (p HistoricalQualificationPlan) residualSelectors() (store.QualificationResidualSelectors, error) {
588: 	runRev, e := Num(p.Run, "revision")
589: 	if e != nil {
590: 		return store.QualificationResidualSelectors{}, e
591: 	}
592: 	stateRev, e := Num(p.ProjectState, "revision")
593: 	if e != nil {
594: 		return store.QualificationResidualSelectors{}, e
595: 	}
596: 	return store.QualificationResidualSelectors{
597: 		Project: p.Subject.ProjectID, Run: p.Subject.RunID, Operation: p.OperationID,
598: 		Principal: p.AuthorID, UploadKey: p.UploadKey, EventID: Str(p.Event, "id"),
599: 		Epoch: p.Subject.Epoch, EventSequence: p.EventSequence, ArtifactID: Str(p.Artifact, "id"),
600: 		ImpactLinkID: Str(p.ImpactLink, "id"), StateID: Str(p.ProjectState, "id"),
601: 		RunRevision: runRev, StateRevision: stateRev, ObservationHash: Hash(p.Observation),
602: 	}, nil
603: }
604: 
605: func (p HistoricalQualificationPlan) afterHash() string {
606: 	return Hash(Object{"artifact": p.Artifact, "impact_link": p.ImpactLink,
607: 		"run": p.Run, "state": p.ProjectState, "event": p.Event,
608: 		"observation": p.Observation, "dispatch_sequence": p.DispatchSequence,
609: 		"upload_hash": Digest(p.ProofBytes), "outcome_hash": p.OutcomeHash})
610: }
611: 
612: // JournalHashes allow a lower-dependency journal to bind every immutable
613: // planned payload without importing domain or exposing SQL authority.
614: func (p HistoricalQualificationPlan) JournalHashes() (plan, before, after, subject, evidence string) {
615: 	return p.coreHash(), p.beforeHash(), p.afterHash(), Hash(p.Subject),
616: 		Hash(Object{"source": p.Source, "native": p.Proof["native"], "model": p.Proof["model_binding"]})
617: }
