258: func qualificationReadStrict(path string, limit int64, out any) ([]byte, error) {
259: 	info, e := os.Lstat(path)
260: 	if e != nil || !info.Mode().IsRegular() || info.Size() < 1 || info.Size() > limit {
261: 		return nil, errors.New("qualification input absent or invalid")
262: 	}
263: 	raw, e := os.ReadFile(path)
264: 	if e != nil || int64(len(raw)) != info.Size() {
265: 		return nil, errors.New("qualification input changed")
266: 	}
267: 	if _, e = canonical.JSON(raw); e != nil {
268: 		return nil, e
269: 	}
270: 	d := json.NewDecoder(bytes.NewReader(raw))
271: 	d.DisallowUnknownFields()
272: 	if e = d.Decode(out); e != nil {
273: 		return nil, e
274: 	}
275: 	var tail any
276: 	if d.Decode(&tail) != io.EOF {
277: 		return nil, errors.New("qualification input trailing JSON")
278: 	}
279: 	return raw, nil
280: }
