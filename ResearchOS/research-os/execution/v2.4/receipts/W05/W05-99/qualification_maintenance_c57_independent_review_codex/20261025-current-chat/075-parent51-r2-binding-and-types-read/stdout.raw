308: 		Schema: "researchos.qualification-failure-maintenance-plan.v1", OperationID: plan.OperationID,
309: 		DataRoot: plan.DataRoot, Database: plan.Database, PlanHash: core, BeforeHash: before, AfterHash: after,
310: 		SubjectHash: subject, EvidenceHash: evidence, FullPlan: append(json.RawMessage(nil), raw...)})
311: }
