52: func qualificationFullPlanMatches(plan JournalPlan) error {
53: 	decoder := json.NewDecoder(bytes.NewReader(plan.FullPlan))
54: 	decoder.UseNumber()
55: 	var f map[string]any
56: 	if err := decoder.Decode(&f); err != nil {
57: 		return err
58: 	}
59: 	var trailing any
60: 	if decoder.Decode(&trailing) != io.EOF {
61: 		return errors.New("qualification full plan trailing data")
62: 	}
63: 	get := func(key string) any { return f[key] }
64: 	if get("schema") != "researchos.qualification-failure-maintenance-full-plan.v1" ||
65: 		get("operation_id") != plan.OperationID || get("data_root") != plan.DataRoot || get("database") != plan.Database {
66: 		return errors.New("qualification full plan identity mismatch")
67: 	}
68: 	outcome, _ := get("outcome_hash").(string)
69: 	if !validDigest(outcome) {
70: 		return errors.New("qualification full outcome invalid")
71: 	}
72: 	core, ok := get("core").(map[string]any)
73: 	if !ok {
74: 		return errors.New("qualification full core absent")
75: 	}
76: 	if value, err := hash(core); err != nil || value != plan.PlanHash {
77: 		return errors.New("qualification full core hash mismatch")
78: 	}
79: 	before := map[string]any{
80: 		"census": get("before_census"), "run": get("before_run"), "state": get("before_state"),
81: 		"dispatch": get("before_dispatch"), "protected": get("before_protected_sha256"),
82: 		"residual": get("before_residual_sha256"),
83: 	}
84: 	if value, err := hash(before); err != nil || value != plan.BeforeHash {
85: 		return errors.New("qualification before hash mismatch")
86: 	}
87: 	proofBytesText, ok := get("proof_bytes").(string)
88: 	if !ok {
89: 		return errors.New("qualification proof bytes absent")
90: 	}
91: 	proofBytes, err := base64.StdEncoding.DecodeString(proofBytesText)
92: 	if err != nil || len(proofBytes) == 0 || len(proofBytes) > 64<<10 {
93: 		return errors.New("qualification proof bytes invalid")
94: 	}
95: 	after := map[string]any{
96: 		"artifact": get("artifact"), "impact_link": get("impact_link"), "run": get("run"),
97: 		"state": get("project_state"), "event": get("event"), "observation": get("observation"),
98: 		"dispatch_sequence": get("dispatch_sequence"), "upload_hash": digest(proofBytes),
99: 		"outcome_hash": get("outcome_hash"),
100: 	}
101: 	if value, err := hash(after); err != nil || value != plan.AfterHash {
102: 		return errors.New("qualification after hash mismatch")
103: 	}
104: 	if value, err := hash(get("subject")); err != nil || value != plan.SubjectHash {
105: 		return errors.New("qualification subject hash mismatch")
106: 	}
107: 	proof, ok := get("proof").(map[string]any)
108: 	if !ok {
109: 		return errors.New("qualification proof absent")
110: 	}
111: 	evidence := map[string]any{"source": get("source"), "native": proof["native"], "model": proof["model_binding"]}
112: 	if value, err := hash(evidence); err != nil || value != plan.EvidenceHash {
113: 		return errors.New("qualification evidence hash mismatch")
114: 	}
115: 	return nil

FILE internal/qualificationmaintenancejournal/journal_windows.go
434: func StartQualification(root string, planRaw []byte) (string, error) {
435: 	var plan JournalPlan
436: 	if err := strictJSON(planRaw, &plan); err != nil {
437: 		return "", err
438: 	}
439: 	if plan.Schema != qualificationPlanSchema || !validOperation(plan.OperationID) ||
440: 		plan.DataRoot != root || plan.Database != filepath.Join(root, "researchos.sqlite") ||
441: 		!validDigest(plan.PlanHash) || !validDigest(plan.BeforeHash) || !validDigest(plan.AfterHash) ||
442: 		!validDigest(plan.SubjectHash) || !validDigest(plan.EvidenceHash) || len(plan.FullPlan) == 0 {
443: 		return "", errors.New("qualification journal plan invalid")
444: 	}
445: 	if err := qualificationFullPlanMatches(plan); err != nil {
446: 		return "", err
447: 	}
448: 	if err := checkPrivateDirectory(filepath.Join(root, "host")); err != nil {
449: 		return "", err
450: 	}
451: 	namespace := filepath.Join(root, "host", QualificationNamespace)
452: 	if _, err := os.Lstat(namespace); os.IsNotExist(err) {
453: 		if err := createPrivateDirectory(namespace); err != nil {
454: 			return "", err
455: 		}
456: 	} else if err != nil {
457: 		return "", err
458: 	}
459: 	if err := checkPrivateDirectory(namespace); err != nil {
460: 		return "", err
461: 	}
462: 	dir := filepath.Join(namespace, plan.OperationID)
463: 	if err := createPrivateDirectory(dir); err != nil {
464: 		return "", err
465: 	}
466: 	if err := createPrivateFile(filepath.Join(dir, "plan.json"), planRaw); err != nil {
467: 		return "", err
468: 	}
469: 	planDigest := digest(planRaw)
470: 	event := QualificationEvent{Schema: qualificationEventSchema, Sequence: 1, OperationID: plan.OperationID,
471: 		PlanSHA256: planDigest, State: "BEGIN", At: time.Now().UTC().Format(time.RFC3339Nano)}
472: 	var err error
473: 	event.Hash, err = hash(event)
474: 	if err != nil {
475: 		return "", err
476: 	}
477: 	raw, err := json.Marshal(event)
478: 	if err != nil {
479: 		return "", err
480: 	}
481: 	if err := createPrivateFile(filepath.Join(dir, "0001-BEGIN.json"), raw); err != nil {
482: 		return "", err
483: 	}
484: 	return planDigest, nil
485: }
486: 
487: // AppendQualification records an observation after the caller has independently
488: // classified the exact SQLite state. It cannot infer that state from a flag.
