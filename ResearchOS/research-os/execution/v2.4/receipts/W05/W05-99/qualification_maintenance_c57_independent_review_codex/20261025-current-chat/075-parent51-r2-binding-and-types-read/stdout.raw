857: 		plan.Subject.ProjectID, plan.Artifact["id"]).Scan(&actualImmutable); e != nil || actualImmutable != 2 {
858: 		t.Fatalf("immutable 0->2 readback: %d %v", actualImmutable, e)
859: 	}
860: 	state, e = ClassifyHistoricalQualification(ctx, db, plan, planFileSHA256)
861: 	if e != nil || state != "UNKNOWN" {
862: 		t.Fatalf("domain_objects immutable 0->2 classified %s: %v", state, e)
863: 	}
864: 	if _, e = db.Exec(`UPDATE domain_objects SET immutable=0 WHERE project=? AND kind='Artifact' AND id=?`,
865: 		plan.Subject.ProjectID, plan.Artifact["id"]); e != nil {
866: 		t.Fatal(e)
867: 	}
868: 	state, e = ClassifyHistoricalQualification(ctx, db, plan, planFileSHA256)
869: 	if e != nil || state != "APPLIED" {
870: 		t.Fatalf("domain_objects immutable restore classified %s: %v", state, e)
