876:func managedToken(p EntryFencePlan) error {
877:	token := windows.GetCurrentProcessToken()
878:	if !token.IsElevated() {
879:		return errors.New("trusted management elevation required")
880:	}
881:	u, e := token.GetTokenUser()
882:	if e != nil {
883:		return e
884:	}
885:	if u.User.Sid.String() != p.ManagementSID || p.BusinessSID == p.ManagementSID {
886:		return errors.New("management SID cannot be business owner")
887:	}
888:	return nil
