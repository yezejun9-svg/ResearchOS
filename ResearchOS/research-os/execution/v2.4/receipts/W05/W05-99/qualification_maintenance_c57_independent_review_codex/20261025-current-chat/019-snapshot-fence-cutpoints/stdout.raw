1023:func setTargetDescriptor(path, sddl string) error {
1024:	sd, e := windows.SecurityDescriptorFromString(sddl)
1025:	if e != nil {
1026:		return e
1027:	}
1028:	owner,_,e:=sd.Owner(); if e!=nil || owner==nil { return errors.New("target owner descriptor missing") }
1029:	dacl, _, e := sd.DACL()
1030:	if e != nil {
1031:		return e
1032:	}
1033:	control, _, e := sd.Control()
1034:	if e != nil {
1035:		return e
1036:	}
1037:	flags := windows.SECURITY_INFORMATION(windows.DACL_SECURITY_INFORMATION | windows.UNPROTECTED_DACL_SECURITY_INFORMATION)
1038:	if control&windows.SE_DACL_PROTECTED != 0 {
1039:		flags = windows.SECURITY_INFORMATION(windows.DACL_SECURITY_INFORMATION | windows.PROTECTED_DACL_SECURITY_INFORMATION)
1040:	}
1041:	w, e := windows.UTF16PtrFromString(path)
1042:	if e != nil {
1043:		return e
1044:	}
1045:	h, e := windows.CreateFile(w, windows.READ_CONTROL|windows.WRITE_DAC|windows.WRITE_OWNER|windows.FILE_READ_ATTRIBUTES,
1046:		windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, nil, windows.OPEN_EXISTING, windows.FILE_FLAG_OPEN_REPARSE_POINT, 0)
1047:	if e != nil {
1048:		return e
1049:	}
1050:	defer windows.CloseHandle(h)
1051:	return windows.SetSecurityInfo(h, windows.SE_FILE_OBJECT, flags|windows.OWNER_SECURITY_INFORMATION, owner, nil, dacl, nil)
1052:}
