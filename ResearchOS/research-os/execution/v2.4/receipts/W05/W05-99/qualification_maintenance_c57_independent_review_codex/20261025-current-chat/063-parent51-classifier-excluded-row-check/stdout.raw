28: func qualificationClassifierFixture(t *testing.T) (*sql.DB, HistoricalQualificationPlan, string) {
29: 	t.Helper()
30: 	root := t.TempDir()
31: 	path := filepath.Join(root, "researchos.sqlite")
32: 	u := url.URL{Scheme: "file", Opaque: filepath.ToSlash(path)}
33: 	q := u.Query()
34: 	q.Set("mode", "rwc")
35: 	u.RawQuery = q.Encode()
36: 	initial, e := sql.Open("sqlite", u.String())
37: 	if e != nil {
38: 		t.Fatal(e)
39: 	}
40: 	if _, e = initial.Exec("PRAGMA journal_mode=WAL"); e != nil {
41: 		t.Fatal(e)
42: 	}
43: 	files, e := filepath.Glob(filepath.Join("..", "..", "migrations", "sqlite", "[0-9][0-9][0-9][0-9]_*.sql"))
44: 	if e != nil || len(files) != 24 {
45: 		t.Fatalf("migration inventory %d: %v", len(files), e)
46: 	}
47: 	sort.Strings(files)
48: 	for i, file := range files {
49: 		raw, err := os.ReadFile(file)
50: 		if err != nil {
51: 			t.Fatal(err)
52: 		}
53: 		if _, err = initial.Exec(string(raw)); err != nil {
54: 			t.Fatalf("migration %s: %v", file, err)
55: 		}
56: 		if _, err = initial.Exec(`INSERT INTO schema_migrations(version) VALUES(?)`, i+1); err != nil {
57: 			t.Fatal(err)
58: 		}
59: 	}
60: 	extra, e := os.ReadFile(filepath.Join("..", "..", "migrations", "sqlite", "next_v24_sessions.sql"))
61: 	if e != nil {
62: 		t.Fatal(e)
63: 	}
64: 	if _, e = initial.Exec(string(extra)); e != nil {
65: 		t.Fatal(e)
66: 	}
67: 	if _, e = initial.Exec(`CREATE TABLE IF NOT EXISTS backup_restore_barriers(project TEXT NOT NULL,run TEXT NOT NULL,restored_at TEXT NOT NULL,PRIMARY KEY(project,run))`); e != nil {
68: 		t.Fatal(e)
69: 	}
70: 	if e = initial.Close(); e != nil {
71: 		t.Fatal(e)
72: 	}
73: 	db, e := store.OpenQualificationMaintenance(context.Background(), path)
74: 	if e != nil {
75: 		t.Fatal(e)
76: 	}
77: 	t.Cleanup(func() { _ = db.Close() })
78: 	if _, e = db.Exec(`INSERT INTO auth_principals(id,roles) VALUES('owner','["OWNER"]')`); e != nil {
79: 		t.Fatal(e)
80: 	}
81: 	project := "project"
82: 	profile := Object{"id": "profile", "project_id": project, "revision": int64(1)}
83: 	runBefore := Object{"id": "run", "project_id": project, "revision": int64(1), "status": "RUNNING"}
84: 	stateBefore := Object{"id": "state", "project_id": project, "revision": int64(1)}
85: 	for _, entry := range []struct {
86: 		kind   string
87: 		object Object
88: 	}{{"ProjectProfile", profile}, {"Run", runBefore}, {"ProjectState", stateBefore}} {
89: 		raw := string(Bytes(entry.object))
90: 		if _, e = db.Exec(`INSERT INTO domain_versions(project,kind,id,revision,body) VALUES(?,?,?,?,?)`, project, entry.kind, entry.object["id"], 1, raw); e != nil {
91: 			t.Fatal(e)
92: 		}
93: 		if _, e = db.Exec(`INSERT INTO domain_objects(project,kind,id,revision,body) VALUES(?,?,?,?,?)`, project, entry.kind, entry.object["id"], 1, raw); e != nil {
94: 			t.Fatal(e)
95: 		}
96: 	}
97: 	if _, e = db.Exec(`INSERT INTO runtime_dispatches(project,run,epoch,dispatch_key,manifest,manifest_hash,state,prepared_at,updated_at)
98: 		VALUES('project','run',1,'dispatch','{}','manifest','STARTED','2026-10-25T00:00:00Z','2026-10-25T00:00:00Z')`); e != nil {
99: 		t.Fatal(e)
100: 	}
101: 	profileRef := Object{"entity_type": "ProjectProfile", "id": "profile", "revision": int64(1)}
102: 	proofBytes := []byte("historical fixture proof")
103: 	artifact := Object{"id": "artifact", "project_id": project, "revision": int64(1), "content_hash": Digest(proofBytes)}
104: 	link := Object{"id": "link", "project_id": project, "revision": int64(1)}
105: 	run := Object{"id": "run", "project_id": project, "revision": int64(2), "status": "FAILED"}
106: 	state := Object{"id": "state", "project_id": project, "revision": int64(2)}
107: 	event := Object{"id": "event", "project_id": project, "revision": int64(1)}
108: 	event["receipt_hash"] = Receipt(event)
109: 	plan := HistoricalQualificationPlan{
