118: func qualificationTransition(previous, next string) bool {
119: 	switch previous {
120: 	case "":
121: 		return next == "BEGIN"
122: 	case "BEGIN":
123: 		return next == "CLASSIFIED_NOT_APPLIED" || next == "DB_COMMITTED_OBSERVED"
124: 	case "CLASSIFIED_NOT_APPLIED":
125: 		return next == "ABORTED" || next == "DB_COMMITTED_OBSERVED"
126: 	case "DB_COMMITTED_OBSERVED":
127: 		return next == "DURABLE"
128: 	}
129: 	return false
130: }
