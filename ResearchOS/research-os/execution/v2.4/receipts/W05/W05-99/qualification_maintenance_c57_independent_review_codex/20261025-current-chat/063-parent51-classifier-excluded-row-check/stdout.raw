113: 		AuthorID:    "owner", UploadKey: "upload", EventSequence: 1, DispatchSequence: 1,
114: 		Core: Object{"profile_ref": profileRef}, Artifact: artifact, ImpactLink: link, Run: run,
115: 		ProjectState: state, Event: event, Observation: Object{"state": "FAILED"},
116: 		ProofBytes: proofBytes, ObservedAt: "2026-10-25T00:00:01Z", ExpiresAt: "2026-10-25T01:00:00Z",
117: 		BeforeRun: runBefore, BeforeState: stateBefore, BeforeDispatch: Object{"manifest_hash": "manifest"},
118: 		OutcomeHash: Hash(Object{"outcome": "fixture"}),
119: 	}
120: 	tx, e := db.BeginTx(context.Background(), &sql.TxOptions{ReadOnly: true})
121: 	if e != nil {
122: 		t.Fatal(e)
123: 	}
124: 	plan.BeforeCensus, e = store.QualificationMaintenanceCensus(context.Background(), tx)
125: 	if e != nil {
126: 		t.Fatal(e)
127: 	}
128: 	plan.BeforeProtectedSHA256, e = store.QualificationMaintenanceProtectedCensus(context.Background(), tx)
129: 	if e != nil {
130: 		t.Fatal(e)
131: 	}
132: 	selectors, e := plan.residualSelectors()
133: 	if e != nil {
134: 		t.Fatal(e)
135: 	}
136: 	plan.BeforeResidualSHA256, e = store.QualificationMaintenanceResidualCensus(context.Background(), tx, selectors)
137: 	if e != nil {
138: 		t.Fatal(e)
139: 	}
140: 	if e = tx.Rollback(); e != nil {
141: 		t.Fatal(e)
142: 	}
143: 	return db, plan, "sha256:1111111111111111111111111111111111111111111111111111111111111111"
144: }
