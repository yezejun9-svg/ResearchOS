690: func TestHistoricalQualificationRecoveryClassificationNineTables(t *testing.T) {
691: 	db, plan, planFileSHA256 := qualificationClassifierFixture(t)
692: 	ctx := context.Background()
693: 	state, e := ClassifyHistoricalQualification(ctx, db, plan, planFileSHA256)
694: 	if e != nil || state != "NOT_APPLIED" {
695: 		t.Fatalf("before: %s %v", state, e)
696: 	}
697: 	tx, e := db.BeginTx(ctx, nil)
698: 	if e != nil {
699: 		t.Fatal(e)
700: 	}
701: 	for _, entry := range []struct {
702: 		kind   string
703: 		object Object
704: 	}{{"Artifact", plan.Artifact}, {"ImpactLink", plan.ImpactLink},
705: 		{"Run", plan.Run}, {"ProjectState", plan.ProjectState}, {"EventEnvelope", plan.Event}} {
706: 		rev, _ := Num(entry.object, "revision")
707: 		var content any
708: 		immutable := 0
709: 		if entry.kind == "Artifact" {
710: 			content = entry.object["content_hash"]
711: 		}
712: 		if entry.kind == "EventEnvelope" {
713: 			content = entry.object["receipt_hash"]
714: 			immutable = 1
715: 		}
716: 		body := string(Bytes(entry.object))
717: 		if _, e = tx.Exec(`INSERT INTO domain_versions(project,kind,id,revision,body,content_hash) VALUES(?,?,?,?,?,?)`,
718: 			plan.Subject.ProjectID, entry.kind, entry.object["id"], rev, body, content); e != nil {
719: 			t.Fatal(e)
720: 		}
721: 		if _, e = tx.Exec(`INSERT INTO domain_objects(project,kind,id,revision,body,content_hash,immutable) VALUES(?,?,?,?,?,?,?)
722: 			ON CONFLICT(project,kind,id) DO UPDATE SET revision=excluded.revision,body=excluded.body,content_hash=excluded.content_hash`,
723: 			plan.Subject.ProjectID, entry.kind, entry.object["id"], rev, body, content, immutable); e != nil {
724: 			t.Fatal(e)
725: 		}
726: 	}
727: 	for _, ref := range []struct {
728: 		kind, id, field, targetKind, targetID string
729: 		targetRevision                        int
730: 	}{
731: 		{"Artifact", "artifact", "/input_refs/0", "ProjectProfile", "profile", 1},
732: 		{"ImpactLink", "link", "/from_ref", "Artifact", "artifact", 1},
733: 		{"ImpactLink", "link", "/to_ref", "ProjectProfile", "profile", 1},
734: 		{"EventEnvelope", "event", "/aggregate_ref", "Run", "run", 2},
735: 	} {
736: 		if _, e = tx.Exec(`INSERT INTO domain_refs(project,kind,id,revision,field,target_project,target_kind,target_id,target_revision)
737: 			VALUES(?,?,?,?,?,?,?,?,?)`, plan.Subject.ProjectID, ref.kind, ref.id, 1, ref.field, plan.Subject.ProjectID,
738: 			ref.targetKind, ref.targetID, ref.targetRevision); e != nil {
739: 			t.Fatal(e)
740: 		}
741: 	}
742: 	if _, e = tx.Exec(`INSERT INTO uploaded_content(storage_key,project,principal,bytes,content_hash,expires_at,sealed) VALUES(?,?,?,?,?,?,1)`,
743: 		plan.UploadKey, plan.Subject.ProjectID, plan.AuthorID, plan.ProofBytes, Digest(plan.ProofBytes), plan.ExpiresAt); e != nil {
744: 		t.Fatal(e)
745: 	}
746: 	if _, e = tx.Exec(`INSERT INTO runtime_observations(project,run,epoch,receipt_hash,body,observed_at) VALUES(?,?,?,?,?,?)`,
747: 		plan.Subject.ProjectID, plan.Subject.RunID, plan.Subject.Epoch, Hash(plan.Observation), string(Bytes(plan.Observation)), plan.ObservedAt); e != nil {
748: 		t.Fatal(e)
749: 	}
750: 	if _, e = tx.Exec(`UPDATE runtime_dispatches SET state='OBSERVED',observation_sequence=?,observation_hash=?,updated_at=?,reason=?
751: 		WHERE project=? AND run=? AND epoch=?`, plan.DispatchSequence, Hash(plan.Observation), plan.ObservedAt,
752: 		"historical qualification first-gate TOOL reconstruction "+plan.OperationID, plan.Subject.ProjectID, plan.Subject.RunID, plan.Subject.Epoch); e != nil {
753: 		t.Fatal(e)
754: 	}
755: 	if _, e = tx.Exec(`INSERT INTO outbox(project,sequence,id,body) VALUES(?,?,?,?)`,
756: 		plan.Subject.ProjectID, plan.EventSequence, plan.Event["id"], string(Bytes(plan.Event))); e != nil {
757: 		t.Fatal(e)
758: 	}
759: 	if _, e = tx.Exec(`INSERT INTO event_state_snapshots(project,event_id,revision,body) VALUES(?,?,?,?)`,
760: 		plan.Subject.ProjectID, plan.Event["id"], 2, string(Bytes(plan.ProjectState))); e != nil {
761: 		t.Fatal(e)
762: 	}
763: 	if _, e = tx.Exec(`INSERT INTO idempotency(principal,project,operation,key,request_hash,status,body,headers,created_at)
764: 		VALUES(?,?,'host:qualification-failure-maintenance',?,?,200,?,'{}',?)`, plan.AuthorID, plan.Subject.ProjectID,
765: 		plan.OperationID, planFileSHA256, Bytes(historicalMaintenanceMarker(plan, planFileSHA256)), plan.ObservedAt); e != nil {
766: 		t.Fatal(e)
767: 	}
768: 	if e = tx.Commit(); e != nil {
769: 		t.Fatal(e)
770: 	}
771: 	state, e = ClassifyHistoricalQualification(ctx, db, plan, planFileSHA256)
772: 	if e != nil || state != "APPLIED" {
773: 		probe, probeErr := db.BeginTx(ctx, &sql.TxOptions{ReadOnly: true})
774: 		if probeErr == nil {
775: 			full, _ := store.QualificationMaintenanceCensus(ctx, probe)
776: 			p, _ := store.QualificationMaintenanceProtectedCensus(ctx, probe)
777: 			sel, _ := plan.residualSelectors()
778: 			r, _ := store.QualificationMaintenanceResidualCensus(ctx, probe, sel)
779: 			exact, exactErr := historicalQualificationExactRows(ctx, probe, plan, planFileSHA256)
780: 			t.Logf("debug full=%t schema=%t protected=%t residual=%t exact=%t exactErr=%v", Hash(full) == Hash(plan.BeforeCensus), full.SchemaSHA256 == plan.BeforeCensus.SchemaSHA256, p == plan.BeforeProtectedSHA256, r == plan.BeforeResidualSHA256, exact, exactErr)
781: 			_ = probe.Rollback()
782: 		}
783: 		t.Fatalf("applied: %s %v", state, e)
784: 	}
785: 	if _, e = db.Exec(`INSERT INTO outbox(project,sequence,id,body) VALUES('project',2,'unrelated','{}')`); e != nil {
786: 		t.Fatal(e)
787: 	}
788: 	state, e = ClassifyHistoricalQualification(ctx, db, plan, planFileSHA256)
789: 	if e != nil || state != "UNKNOWN" {
790: 		t.Fatalf("unrelated row: %s %v", state, e)
791: 	}
792: }

