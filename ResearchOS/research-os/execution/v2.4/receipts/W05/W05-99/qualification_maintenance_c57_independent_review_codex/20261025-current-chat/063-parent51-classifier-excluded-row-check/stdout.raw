FILE internal/qualificationmaintenancejournal/journal_windows.go
544: // CheckOrdinary is a pure read under the caller's native coordinator lock.
545: // Both namespaces must be complete and current before any startup side effect.
546: func CheckOrdinary(root string) error {
547: 	if err := checkQualificationOrdinary(root); err != nil {
548: 		return err
549: 	}
550: 	return checkReplacementOrdinary(root)
551: }
552: 
553: // OpenOwnInspection makes only the exact matching pending transition visible.
554: // Callers must still establish all separate owner, evidence and write authority.
555: func OpenOwnInspection(root, namespace, operation, planDigest string) (InspectionPermit, HistoryStatus, error) {
556: 	var zero InspectionPermit
557: 	var status HistoryStatus
558: 	if !validOperation(operation) || !validDigest(planDigest) {
559: 		return zero, status, errors.New("own operation identity invalid")
560: 	}
561: 	switch namespace {
562: 	case ReplacementNamespace:
563: 		if err := checkQualificationOrdinary(root); err != nil {
564: 			return zero, status, err
565: 		}
566: 		var err error
567: 		status, err = inspectReplacement(root, operation, planDigest, nil)
568: 		if err != nil {
569: 			return zero, status, err
570: 		}
571: 	case QualificationNamespace:
572: 		if err := checkReplacementOrdinary(root); err != nil {
573: 			return zero, status, err
574: 		}
575: 		var err error
576: 		status, err = inspectQualification(root, operation, planDigest)
577: 		if err != nil {
578: 			return zero, status, err
579: 		}
580: 	default:
581: 		return zero, status, errors.New("own namespace invalid")
582: 	}
583: 	return InspectionPermit{root: root, namespace: namespace, operation: operation, planDigest: planDigest}, status, nil
584: }
585: 
586: func OpenOwnReplacementInspection(root, operation, planDigest string, planBytes []byte) (InspectionPermit, HistoryStatus, error) {
587: 	var zero InspectionPermit
588: 	var status HistoryStatus
589: 	if !validOperation(operation) || !validDigest(planDigest) || digest(planBytes) != planDigest {
590: 		return zero, status, errors.New("own replacement plan identity invalid")
591: 	}
592: 	if err := checkQualificationOrdinary(root); err != nil {
593: 		return zero, status, err
594: 	}
595: 	var err error
596: 	status, err = inspectReplacement(root, operation, planDigest, planBytes)
597: 	if err != nil {
598: 		return zero, status, err
599: 	}
600: 	return InspectionPermit{root: root, namespace: ReplacementNamespace, operation: operation,
601: 		planDigest: planDigest, replacementPlan: append([]byte(nil), planBytes...)}, status, nil
602: }
603: 
604: func (p InspectionPermit) Check(root string) (HistoryStatus, error) {
605: 	if p.root == "" || p.root != root {
606: 		return HistoryStatus{}, errors.New("own inspection root mismatch")
607: 	}
608: 	if p.namespace == ReplacementNamespace && p.replacementPlan != nil {
609: 		if err := checkQualificationOrdinary(root); err != nil {
610: 			return HistoryStatus{}, err
611: 		}
612: 		return inspectReplacement(root, p.operation, p.planDigest, p.replacementPlan)
613: 	}
614: 	_, status, err := OpenOwnInspection(root, p.namespace, p.operation, p.planDigest)
615: 	return status, err
616: }
