188: func (h *historicalQualificationHold) Close() error {
189: 	if h == nil {
190: 		return nil
191: 	}
192: 	h.mu.Lock()
193: 	defer h.mu.Unlock()
194: 	if h.closed {
195: 		return nil
196: 	}
197: 	h.closed = true
198: 	var err error
199: 	for i := len(h.files) - 1; i >= 0; i-- {
200: 		err = errors.Join(err, h.files[i].file.Close())
201: 	}
202: 	if h.owner != nil {
203: 		err = errors.Join(err, h.owner.Close())
204: 	}
205: 	return err
206: }
207: 
208: // The transaction uses a non-canceling lifetime while individual SQL calls
209: // use the caller's context. This makes a canceled call end in this synchronous
210: // Rollback, whose driver return precedes release of the native source hold.
211: func finishHistoricalQualificationTx(tx *sql.Tx, committed bool, hold *historicalQualificationHold) error {
212: 	var err error
213: 	if tx != nil && !committed {
214: 		err = tx.Rollback()
215: 	}
216: 	return errors.Join(err, hold.Close())
217: }
