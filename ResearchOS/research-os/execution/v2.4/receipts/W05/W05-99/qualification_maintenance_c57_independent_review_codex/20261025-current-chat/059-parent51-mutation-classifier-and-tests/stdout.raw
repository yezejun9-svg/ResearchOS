1106: func historicalQualificationExactRows(ctx context.Context, tx *sql.Tx, plan HistoricalQualificationPlan, planFileSHA256 string) (bool, error) {
1107: 	for _, entry := range []struct {
1108: 		kind   string
1109: 		object Object
1110: 	}{
1111: 		{"Artifact", plan.Artifact}, {"ImpactLink", plan.ImpactLink}, {"Run", plan.Run},
1112: 		{"ProjectState", plan.ProjectState}, {"EventEnvelope", plan.Event},
1113: 	} {
1114: 		id := Str(entry.object, "id")
1115: 		rev, err := Num(entry.object, "revision")
1116: 		if err != nil {
1117: 			return false, err
1118: 		}
1119: 		for _, table := range []string{"domain_versions", "domain_objects"} {
1120: 			var body string
1121: 			var actualRevision int64
1122: 			var contentHash sql.NullString
1123: 			var immutable int
1124: 			selection := "revision,body,content_hash"
1125: 			if table == "domain_objects" {
1126: 				selection += ",immutable"
1127: 			}
1128: 			row := tx.QueryRowContext(ctx, `SELECT `+selection+` FROM "`+table+`" WHERE project=? AND kind=? AND id=?`+
1129: 				func() string {
1130: 					if table == "domain_versions" {
1131: 						return " AND revision=?"
1132: 					}
1133: 					return ""
1134: 				}(),
1135: 				func() []any {
1136: 					args := []any{plan.Subject.ProjectID, entry.kind, id}
1137: 					if table == "domain_versions" {
1138: 						args = append(args, rev)
1139: 					}
1140: 					return args
1141: 				}()...,
1142: 			)
1143: 			var e error
1144: 			if table == "domain_objects" {
1145: 				e = row.Scan(&actualRevision, &body, &contentHash, &immutable)
1146: 			} else {
1147: 				e = row.Scan(&actualRevision, &body, &contentHash)
1148: 			}
1149: 			if e == sql.ErrNoRows {
1150: 				return false, nil
1151: 			}
1152: 			if e != nil {
1153: 				return false, e
1154: 			}
1155: 			if actualRevision != rev || body != string(Bytes(entry.object)) {
1156: 				return false, nil
1157: 			}
1158: 			wantHash := ""
1159: 			if entry.kind == "Artifact" {
1160: 				wantHash = Str(entry.object, "content_hash")
1161: 			}
1162: 			if entry.kind == "EventEnvelope" {
1163: 				wantHash = Str(entry.object, "receipt_hash")
1164: 			}
1165: 			if contentHash.Valid != (wantHash != "") || contentHash.Valid && contentHash.String != wantHash ||
1166: 				table == "domain_objects" && (immutable == 1) != (entry.kind == "EventEnvelope") {
1167: 				return false, nil
1168: 			}
1169: 		}
1170: 	}
1171: 	// New revisions of the two mutable objects must carry the same reference
1172: 	// edges as their immediately preceding versions.
1173: 	for _, entry := range []struct {
1174: 		kind   string
1175: 		object Object
1176: 	}{
1177: 		{"Run", plan.Run}, {"ProjectState", plan.ProjectState},
1178: 	} {
1179: 		rev, err := Num(entry.object, "revision")
1180: 		if err != nil {
1181: 			return false, err
1182: 		}
1183: 		newRows, err := historicalQualificationRefs(tx, plan.Subject.ProjectID, entry.kind, Str(entry.object, "id"), rev)
1184: 		if err != nil {
1185: 			return false, err
1186: 		}
1187: 		oldRows, err := historicalQualificationRefs(tx, plan.Subject.ProjectID, entry.kind, Str(entry.object, "id"), rev-1)
1188: 		if err != nil {
1189: 			return false, err
1190: 		}
1191: 		if matched, err := historicalQualificationRefRevisionMatches(tx, plan.Subject.ProjectID, entry.kind, entry.object, oldRows, newRows); err != nil {
1192: 			return false, err
1193: 		} else if !matched {
1194: 			return false, nil
1195: 		}
1196: 	}
1197: 	profile, ok := plan.Core["profile_ref"].(map[string]any)
1198: 	if !ok {
1199: 		return false, nil
1200: 	}
1201: 	profileRevision, err := Num(Object(profile), "revision")
1202: 	if err != nil {
1203: 		return false, err
1204: 	}
1205: 	refExpected := []struct {
1206: 		kind, id string
1207: 		rows     []any
1208: 	}{
1209: 		{"Artifact", Str(plan.Artifact, "id"), []any{[]any{"/input_refs/0", plan.Subject.ProjectID, Str(Object(profile), "entity_type"), Str(Object(profile), "id"), profileRevision}}},
1210: 		{"ImpactLink", Str(plan.ImpactLink, "id"), []any{
1211: 			[]any{"/from_ref", plan.Subject.ProjectID, "Artifact", Str(plan.Artifact, "id"), int64(1)},
1212: 			[]any{"/to_ref", plan.Subject.ProjectID, Str(Object(profile), "entity_type"), Str(Object(profile), "id"), profileRevision},
1213: 		}},
1214: 	}
1215: 	runRevision, err := Num(plan.Run, "revision")
1216: 	if err != nil {
1217: 		return false, err
1218: 	}
1219: 	refExpected = append(refExpected, struct {
1220: 		kind, id string
1221: 		rows     []any
1222: 	}{
1223: 		"EventEnvelope", Str(plan.Event, "id"), []any{[]any{"/aggregate_ref", plan.Subject.ProjectID, "Run", plan.Subject.RunID, runRevision}},
1224: 	})
1225: 	for _, entry := range refExpected {
1226: 		rows, err := historicalQualificationRefs(tx, plan.Subject.ProjectID, entry.kind, entry.id, 1)
1227: 		if err != nil {
1228: 			return false, err
1229: 		}
1230: 		if Hash(rows) != Hash(entry.rows) {
1231: 			return false, nil
1232: 		}
1233: 	}
1234: 	var uploaded []byte
1235: 	var contentHash string
1236: 	var sealed int
1237: 	var expiresAt string
1238: 	err = tx.QueryRowContext(ctx, `SELECT bytes,content_hash,sealed,expires_at FROM uploaded_content WHERE storage_key=? AND project=? AND principal=?`,
1239: 		plan.UploadKey, plan.Subject.ProjectID, plan.AuthorID).Scan(&uploaded, &contentHash, &sealed, &expiresAt)
1240: 	if err == sql.ErrNoRows {
1241: 		return false, nil
1242: 	}
1243: 	if err != nil {
1244: 		return false, err
1245: 	}
1246: 	if !bytes.Equal(uploaded, plan.ProofBytes) || contentHash != Digest(plan.ProofBytes) || sealed != 1 || expiresAt != plan.ExpiresAt {
1247: 		return false, nil
1248: 	}
1249: 	var observed, observedAt string
1250: 	err = tx.QueryRowContext(ctx, `SELECT body,observed_at FROM runtime_observations WHERE project=? AND run=? AND epoch=? AND receipt_hash=?`,
1251: 		plan.Subject.ProjectID, plan.Subject.RunID, plan.Subject.Epoch, Hash(plan.Observation)).Scan(&observed, &observedAt)
1252: 	if err == sql.ErrNoRows {
1253: 		return false, nil
1254: 	}
1255: 	if err != nil {
1256: 		return false, err
1257: 	}
1258: 	if observed != string(Bytes(plan.Observation)) || observedAt != plan.ObservedAt {
1259: 		return false, nil
1260: 	}
1261: 	var dispatchState, dispatchHash, dispatchKey, manifestHash, dispatchUpdated, dispatchReason string
1262: 	var dispatchSequence int64
1263: 	err = tx.QueryRowContext(ctx, `SELECT state,observation_sequence,observation_hash,dispatch_key,manifest_hash,updated_at,reason
1264: 		FROM runtime_dispatches WHERE project=? AND run=? AND epoch=?`, plan.Subject.ProjectID, plan.Subject.RunID, plan.Subject.Epoch).
1265: 		Scan(&dispatchState, &dispatchSequence, &dispatchHash, &dispatchKey, &manifestHash, &dispatchUpdated, &dispatchReason)
1266: 	if err == sql.ErrNoRows {
1267: 		return false, nil
1268: 	}
1269: 	if err != nil {
1270: 		return false, err
1271: 	}
1272: 	if dispatchState != "OBSERVED" || dispatchSequence != plan.DispatchSequence || dispatchHash != Hash(plan.Observation) ||
1273: 		dispatchKey != plan.Subject.DispatchKey || manifestHash != Str(plan.BeforeDispatch, "manifest_hash") ||
1274: 		dispatchUpdated != plan.ObservedAt || dispatchReason != "historical qualification first-gate TOOL reconstruction "+plan.OperationID {
1275: 		return false, nil
1276: 	}
1277: 	var outbox string
1278: 	var acknowledged int
1279: 	err = tx.QueryRowContext(ctx, `SELECT body,acknowledged FROM outbox WHERE project=? AND sequence=? AND id=?`,
1280: 		plan.Subject.ProjectID, plan.EventSequence, Str(plan.Event, "id")).Scan(&outbox, &acknowledged)
1281: 	if err == sql.ErrNoRows {
1282: 		return false, nil
1283: 	}
1284: 	if err != nil {
1285: 		return false, err
1286: 	}
1287: 	if outbox != string(Bytes(plan.Event)) || acknowledged != 0 {
1288: 		return false, nil
1289: 	}
1290: 	var snapshot string
1291: 	var snapshotRev int64
1292: 	err = tx.QueryRowContext(ctx, `SELECT body,revision FROM event_state_snapshots WHERE project=? AND event_id=?`,
1293: 		plan.Subject.ProjectID, Str(plan.Event, "id")).Scan(&snapshot, &snapshotRev)
1294: 	if err == sql.ErrNoRows {
1295: 		return false, nil
1296: 	}
1297: 	if err != nil {
1298: 		return false, err
1299: 	}
1300: 	stateRevision, stateErr := Num(plan.ProjectState, "revision")
1301: 	if stateErr != nil {
1302: 		return false, stateErr
1303: 	}
1304: 	if snapshot != string(Bytes(plan.ProjectState)) || snapshotRev != stateRevision {
1305: 		return false, nil
1306: 	}
1307: 	var markerRaw []byte
1308: 	var status int
1309: 	var headers, createdAt string
1310: 	err = tx.QueryRowContext(ctx, `SELECT body,status,headers,created_at FROM idempotency WHERE principal=? AND project=? AND operation='host:qualification-failure-maintenance' AND key=? AND request_hash=?`,
1311: 		plan.AuthorID, plan.Subject.ProjectID, plan.OperationID, planFileSHA256).Scan(&markerRaw, &status, &headers, &createdAt)
1312: 	if err == sql.ErrNoRows {
1313: 		return false, nil
1314: 	}
1315: 	if err != nil {
1316: 		return false, err
1317: 	}
1318: 	if status != 200 || headers != "{}" || createdAt != plan.ObservedAt ||
1319: 		!bytes.Equal(markerRaw, Bytes(historicalMaintenanceMarker(plan, planFileSHA256))) {
1320: 		return false, nil
1321: 	}
1322: 	return true, nil
1323: }
