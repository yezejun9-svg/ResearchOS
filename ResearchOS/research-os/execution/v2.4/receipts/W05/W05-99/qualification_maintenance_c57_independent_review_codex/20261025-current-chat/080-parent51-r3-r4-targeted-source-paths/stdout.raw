420:     }()
421:     sourceRelease, _, err := preparedUpgradeRelease(opt.SourceRoot, 23)
422:     if err != nil { return report, err }
423:     targetRelease, sqls, err := preparedUpgradeRelease(opt.TargetRoot, 24)
424:     if err != nil { return report, err }
