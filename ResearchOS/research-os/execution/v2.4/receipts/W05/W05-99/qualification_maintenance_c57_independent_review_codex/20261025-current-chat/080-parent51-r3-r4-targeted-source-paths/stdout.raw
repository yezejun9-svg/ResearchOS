63: func UpgradeLocalUnderSourceLease(ctx context.Context, opt LocalUpgradeOptions, lease *runtimeadapter.DataRootLease) (report RestoreReport, err error) {
64: 	report = RestoreReport{Status: "FAILED"}
65: 	switch opt.Plan {
66: 	case LocalUpgradePlan, FinalSchemaUpgradePlan, QueueSchemaUpgradePlan,
67: 		ConfigurationSchemaUpgradePlan, PreparedAbandonmentSchemaUpgradePlan:
68: 	default:
69: 		return report, fmt.Errorf("UPGRADE_PLAN_UNSUPPORTED")
70: 	}
71: 	guard, err := checkedBackupSource(&opt, lease)
72: 	if err != nil {
73: 		return report, err
74: 	}
75: 	defer func() {
76: 		if releaseErr := guard.borrow.Release(); err == nil && releaseErr != nil {
77: 			err = releaseErr
78: 		}
79: 	}()
80: 	return upgradeLocal(ctx, opt, concreteUpgradeVerifier())
81: }
