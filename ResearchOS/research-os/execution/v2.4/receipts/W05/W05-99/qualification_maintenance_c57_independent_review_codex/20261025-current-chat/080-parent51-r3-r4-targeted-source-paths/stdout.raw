109: func TestPreparedNestedSourceLeaseCloseKeepsOuterNativeOwner(t *testing.T) {
110: 	root := t.TempDir()
111: 	source := filepath.Join(root, "researchos.sqlite")
112: 	if err := os.WriteFile(source, []byte("disposable source"), 0600); err != nil {
113: 		t.Fatal(err)
114: 	}
115: 	lease, err := rt.AcquireDataRootLease(root)
116: 	if err != nil {
117: 		t.Fatal(err)
118: 	}
119: 	defer lease.Close()
120: 	opt := LocalUpgradeOptions{Source: source}
121: 	guard, err := checkedBackupSource(&opt, lease)
122: 	if err != nil {
123: 		t.Fatal(err)
124: 	}
125: 	defer guard.borrow.Release()
126: 	for _, branch := range []string{"prepared-local", "prepared-handoff"} {
127: 		t.Run(branch, func(t *testing.T) {
128: 			inner, err := acquirePreparedUpgradeRootLease(guard.root, guard.source, guard)
129: 			if err != nil || inner.Check() != nil {
130: 				t.Fatalf("inherited prepared lease: %v", err)
131: 			}
132: 			if err := inner.Close(); err != nil {
133: 				t.Fatal(err)
134: 			}
135: 			if inner.Check() == nil {
136: 				t.Fatal("closed inner prepared lease remained valid")
137: 			}
138: 			if !lease.Held() || guard.Check(guard.root, guard.source) != nil {
139: 				t.Fatal("inner prepared Close released outer native source owner")
140: 			}
141: 			if err := os.Rename(source, source+".moved"); err == nil {
142: 				t.Fatal("inner prepared Close released native source guard")
143: 			}
144: 		})
145: 	}
146: }

