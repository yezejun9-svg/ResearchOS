176: func upgradePreparedAbandonmentBackup(ctx context.Context, handoff PreparedBackupHandoffOptions, verifier upgradeVerifier) (report RestoreReport, err error) {
177:     opt := handoff.Upgrade
178:     report = RestoreReport{Started: Now(), Status: "FAILED"}
179:     if opt.Plan != PreparedAbandonmentSchemaUpgradePlan { return report, fmt.Errorf("PREPARED_UPGRADE_PLAN_UNSUPPORTED") }
180:     if err := preparedHandoffPaths(&opt, &handoff); err != nil { return report, err }
181:     if opt.sourceLease != nil {
182:         if err := opt.sourceLease.Check(filepath.Dir(opt.Source), opt.Source); err != nil { return report, err }
183:     }
184:     lease, err := acquirePreparedUpgradeRootLease(filepath.Dir(opt.Source), opt.Source, opt.sourceLease)
185:     if err != nil { return report, err }
186:     defer func() {
187:         if closeErr := lease.Close(); closeErr != nil && err == nil { err = closeErr }
188:     }()
189:     sourceRelease, _, err := preparedUpgradeRelease(opt.SourceRoot, 23)
190:     if err != nil { return report, err }
191:     targetRelease, sqls, err := preparedUpgradeRelease(opt.TargetRoot, 24)
192:     if err != nil { return report, err }
193:     sourceProgram, targetProgram, err := preparedUpgradeProgramHashes(opt, true)
194:     if err != nil { return report, err }
195:     binding, err := preparedHandoffCheck(opt, handoff)
196:     if err != nil { return report, err }
197:     contracts, err := LoadContracts(filepath.Join(opt.TargetRoot, "spec/v2.0/contracts"))
198:     if err != nil { return report, err }
199:     schemas, err := preparedUpgradeTemplate(ctx, sqls, contracts)
200:     if err != nil { return report, err }
201:     key, err := os.ReadFile(opt.KeyFile)
202:     if err != nil || len(key) != 32 { return report, fmt.Errorf("BACKUP_KEY_UNAVAILABLE") }
203:     defer clear(key)
204:     if err = preparedHandoffVerifyBackup(opt, key, binding); err != nil { return report, err }

