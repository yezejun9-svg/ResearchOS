22: func TestQualificationJournalFullPlanDispatchRowRoundTrip(t *testing.T) {
23: 	root := t.TempDir()
24: 	user, err := windows.GetCurrentProcessToken().GetTokenUser()
25: 	if err != nil {
26: 		t.Fatal(err)
27: 	}
28: 	sid := user.User.Sid.String()
29: 	sd, err := windows.SecurityDescriptorFromString("O:" + sid + "D:P(A;OICI;FA;;;" + sid + ")")
30: 	if err != nil {
31: 		t.Fatal(err)
32: 	}
33: 	hostPath, err := windows.UTF16PtrFromString(filepath.Join(root, "host"))
34: 	if err != nil {
35: 		t.Fatal(err)
36: 	}
37: 	sa := windows.SecurityAttributes{Length: uint32(unsafe.Sizeof(windows.SecurityAttributes{})), SecurityDescriptor: sd}
38: 	if err = windows.CreateDirectory(hostPath, &sa); err != nil {
39: 		t.Fatal(err)
40: 	}
41: 	plan := domain.HistoricalQualificationPlan{
42: 		Schema:      "researchos.qualification-failure-maintenance-full-plan.v1",
43: 		OperationID: "00112233445566778899aabbccddeeff", DataRoot: root,
44: 		Database: filepath.Join(root, "researchos.sqlite"),
45: 		Core:     domain.Object{"schema": "fixture"}, Proof: domain.Object{
46: 			"native": domain.Object{"kind": "fixture"}, "model_binding": domain.Object{"kind": "fixture"}},
47: 		ProofBytes: []byte("fixture"), OutcomeHash: domain.Digest([]byte("outcome")),
48: 		Subject:   domain.HistoricalQualificationSubject{ProjectID: "project", RunID: "run", Epoch: 1, DispatchKey: "dispatch"},
49: 		BeforeRun: domain.Object{}, BeforeState: domain.Object{}, BeforeDispatch: domain.Object{"state": "STARTED"},
50: 		BeforeProtectedSHA256: domain.Digest([]byte("protected")), BeforeResidualSHA256: domain.Digest([]byte("residual")),
51: 		Artifact: domain.Object{}, ImpactLink: domain.Object{}, Run: domain.Object{}, ProjectState: domain.Object{},
52: 		Event: domain.Object{}, Observation: domain.Object{}, DispatchSequence: 1,
53: 	}
54: 	// Populate the private typed dispatch row through its public JSON contract,
55: 	// as the Host does when reading a reviewed plan from disk.
56: 	initial, err := json.Marshal(plan)
57: 	if err != nil {
58: 		t.Fatal(err)
59: 	}
60: 	var tree map[string]any
61: 	if err = json.Unmarshal(initial, &tree); err != nil {
62: 		t.Fatal(err)
63: 	}
64: 	row := tree["before_dispatch_row"].(map[string]any)
65: 	row["project"], row["run"], row["epoch"], row["dispatch_key"] = "project", "run", float64(1), "dispatch"
66: 	row["worker"] = "fixture-worker"
67: 	cells := row["cells"].([]any)
68: 	cells[7] = map[string]any{"type": "text", "data": base64.StdEncoding.EncodeToString([]byte("fixture-worker"))}
69: 	serialized, err := json.Marshal(tree)
70: 	if err != nil {
71: 		t.Fatal(err)
72: 	}
73: 	if err = json.Unmarshal(serialized, &plan); err != nil {
74: 		t.Fatal(err)
75: 	}
76: 	fullPlanRaw, err := json.Marshal(plan)
77: 	if err != nil {
78: 		t.Fatal(err)
79: 	}
80: 	var reviewed domain.HistoricalQualificationPlan
81: 	if err = json.Unmarshal(fullPlanRaw, &reviewed); err != nil {
82: 		t.Fatal(err)
83: 	}
84: 	journalRaw, err := qualificationJournalRaw(reviewed, fullPlanRaw)
85: 	if err != nil {
86: 		t.Fatal(err)
87: 	}
88: 	digest, err := qualificationmaintenancejournal.StartQualification(root, journalRaw)
89: 	if err != nil {
90: 		t.Fatal(err)
91: 	}
92: 	_, status, err := qualificationmaintenancejournal.OpenOwnInspection(root,
93: 		qualificationmaintenancejournal.QualificationNamespace, plan.OperationID, digest)
94: 	if err != nil || status.State != "BEGIN" {
95: 		t.Fatalf("typed full plan journal readback: %#v %v", status, err)
96: 	}
97: }
