111: func TestQualificationJournalFullPlanHashesFailClosed(t *testing.T) {
112: 	root, plan, _ := qualificationJournalFixture(t)
113: 	for _, change := range []func(map[string]any){
114: 		func(full map[string]any) { full["operation_id"] = "ffeeddccbbaa99887766554433221100" },
115: 		func(full map[string]any) { full["core"] = map[string]any{"schema": "changed"} },
116: 		func(full map[string]any) { full["before_protected_sha256"] = "changed" },
117: 		func(full map[string]any) { full["before_dispatch_row"] = map[string]any{"changed": true} },
118: 		func(full map[string]any) { full["proof_bytes"] = []byte("different") },
119: 		func(full map[string]any) { full["source"] = map[string]any{"source": "changed"} },
120: 	} {
121: 		var full map[string]any
122: 		if err := json.Unmarshal(plan.FullPlan, &full); err != nil {
123: 			t.Fatal(err)
124: 		}
125: 		change(full)
126: 		tampered := plan
127: 		tampered.FullPlan, _ = json.Marshal(full)
128: 		raw, _ := json.Marshal(tampered)
129: 		if _, err := StartQualification(root, raw); err == nil {
130: 			t.Fatal("mismatched full plan accepted")
131: 		}
132: 	}
133: }
