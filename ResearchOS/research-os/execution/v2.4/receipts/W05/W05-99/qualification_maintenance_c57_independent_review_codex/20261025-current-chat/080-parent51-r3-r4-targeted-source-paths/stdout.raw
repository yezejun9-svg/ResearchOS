20: func (l *backupSourceLease) Check(root, source string) error {
21: 	if l == nil || l.borrow == nil || !strings.EqualFold(l.root, root) ||
22: 		!strings.EqualFold(l.source, source) || !strings.EqualFold(filepath.Dir(source), root) {
23: 		return fmt.Errorf("UPGRADE_SOURCE_LEASE_IDENTITY")
24: 	}
25: 	return l.borrow.Check(source)
26: }
27: 
28: func checkedBackupSource(opt *LocalUpgradeOptions, lease *runtimeadapter.DataRootLease) (*backupSourceLease, error) {
29: 	if lease == nil {
30: 		return nil, fmt.Errorf("UPGRADE_SOURCE_LEASE_REQUIRED")
31: 	}
32: 	source, err := upgradePath(opt.Source, true)
33: 	if err != nil {
34: 		return nil, err
35: 	}
36: 	opt.Source = source
37: 	root := filepath.Dir(source)
38: 	borrow, err := lease.BorrowMaintenanceSource(source)
39: 	if err != nil {
40: 		return nil, err
41: 	}
42: 	guard := &backupSourceLease{borrow: borrow, root: root, source: source}
43: 	if err := guard.Check(root, source); err != nil {
44: 		_ = borrow.Release()
45: 		return nil, err
46: 	}
47: 	opt.sourceLease = guard
48: 	return guard, nil
49: }

