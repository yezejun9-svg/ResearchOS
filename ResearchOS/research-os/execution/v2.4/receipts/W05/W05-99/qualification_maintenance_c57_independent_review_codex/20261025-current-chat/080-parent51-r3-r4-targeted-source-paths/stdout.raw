83: func UpgradePreparedAbandonmentBackupUnderSourceLease(ctx context.Context, handoff PreparedBackupHandoffOptions, lease *runtimeadapter.DataRootLease) (report RestoreReport, err error) {
84: 	report = RestoreReport{Status: "FAILED"}
85: 	if handoff.Upgrade.Plan != PreparedAbandonmentSchemaUpgradePlan {
86: 		return report, fmt.Errorf("PREPARED_UPGRADE_PLAN_UNSUPPORTED")
87: 	}
88: 	guard, err := checkedBackupSource(&handoff.Upgrade, lease)
89: 	if err != nil {
90: 		return report, err
91: 	}
92: 	defer func() {
93: 		if releaseErr := guard.borrow.Release(); err == nil && releaseErr != nil {
94: 			err = releaseErr
95: 		}
96: 	}()
97: 	return upgradePreparedAbandonmentBackup(ctx, handoff, preparedUpgradeConcreteVerifier())
98: }

FILE internal/domain/backup_upgrade.go
79: func upgradePath(path string, existing bool) (string, error) {
80: 	if path == "" || strings.ContainsAny(path, "?\x00") {
81: 		return "", fmt.Errorf("UPGRADE_PATH_REQUIRED")
82: 	}
83: 	abs, e := filepath.Abs(path)
84: 	if e != nil {
85: 		return "", e
86: 	}
87: 	if existing {
88: 		return upgradeExistingPath(abs)
89: 	}
90: 	if _, e = os.Lstat(abs); !os.IsNotExist(e) {
91: 		return "", fmt.Errorf("DESTINATION_EXISTS")
92: 	}
93: 	ancestor := filepath.Dir(abs)
94: 	for {
95: 		resolved, err := upgradeExistingPath(ancestor)
96: 		if err == nil {
97: 			rel, err := filepath.Rel(ancestor, abs)
98: 			if err != nil || !filepath.IsLocal(rel) {
99: 				return "", fmt.Errorf("UPGRADE_PATH_INVALID")
100: 			}
101: 			return filepath.Join(resolved, rel), nil
102: 		}
103: 		if !os.IsNotExist(err) || filepath.Dir(ancestor) == ancestor {
104: 			return "", err
105: 		}
106: 		ancestor = filepath.Dir(ancestor)
107: 	}
108: }

