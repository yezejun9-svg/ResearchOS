126: func preparedHandoffPaths(opt *LocalUpgradeOptions, handoff *PreparedBackupHandoffOptions) error {
127:     for _, p := range []*string{&opt.Source, &opt.Snapshot, &opt.KeyFile, &opt.SourceRoot, &opt.TargetRoot, &opt.SourceProgram, &opt.TargetProgram, &handoff.BindingFile} {
128:         v, err := upgradePath(*p, true)
129:         if err != nil { return err }
130:         *p = v
131:     }
132:     destination, err := upgradePath(opt.Destination, false)
133:     if err != nil { return err }
134:     opt.Destination = destination
135:     dirs := []string{filepath.Dir(opt.Source), filepath.Dir(opt.KeyFile), opt.Snapshot, opt.Destination}
136:     for i, a := range dirs {
137:         for _, b := range dirs[i+1:] {
138:             if upgradeInside(a, b) || upgradeInside(b, a) { return fmt.Errorf("UPGRADE_PATH_OVERLAP") }
139:         }
140:     }
141:     var infos []os.FileInfo
142:     for _, path := range []string{opt.Source, opt.KeyFile, opt.SourceProgram, opt.TargetProgram, handoff.BindingFile} {
143:         info, err := os.Stat(path)
144:         if err != nil || !info.Mode().IsRegular() { return fmt.Errorf("UPGRADE_REGULAR_FILE_REQUIRED") }
145:         infos = append(infos, info)
146:     }
147:     for i, a := range infos {
148:         for _, b := range infos[i+1:] {
149:             if os.SameFile(a, b) { return fmt.Errorf("UPGRADE_FILE_ALIAS") }
150:         }
151:     }
152:     for _, path := range []string{opt.Snapshot, opt.SourceRoot, opt.TargetRoot} {
153:         info, err := os.Stat(path)
154:         if err != nil || !info.IsDir() { return fmt.Errorf("PREPARED_HANDOFF_DIRECTORY_REQUIRED") }
155:     }
156:     return nil
157: }
