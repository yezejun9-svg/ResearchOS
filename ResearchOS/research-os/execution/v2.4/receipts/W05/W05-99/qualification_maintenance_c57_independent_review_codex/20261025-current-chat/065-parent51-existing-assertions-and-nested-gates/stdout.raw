243: func upgradeLocal(ctx context.Context, opt LocalUpgradeOptions, verifier upgradeVerifier) (RestoreReport, error) {
244: 	if opt.Plan == PreparedAbandonmentSchemaUpgradePlan {
245: 		return upgradePreparedAbandonmentLocal(ctx, opt, verifier)
246: 	}
247: 	if opt.Plan == ConfigurationSchemaUpgradePlan {
248: 		return upgradeConfigurationLocal(ctx, opt, verifier)
249: 	}
250: 	if opt.Plan == QueueSchemaUpgradePlan {
251: 		return upgradeQueueLocal(ctx, opt, verifier)
252: 	}
253: 	report := RestoreReport{Started: Now(), Status: "FAILED"}
254: 	targetVersion := 14
255: 	switch opt.Plan {
256: 	case LocalUpgradePlan:
257: 	case FinalSchemaUpgradePlan:
258: 		targetVersion = 20
259: 	default:
260: 		return report, fmt.Errorf("UPGRADE_PLAN_UNSUPPORTED")
261: 	}
262: 	if e := upgradePaths(&opt); e != nil {
263: 		return report, e
264: 	}
265: 	sourceRelease, _, e := upgradeRelease(opt.SourceRoot, 13)
266: 	if e != nil {
267: 		return report, e
268: 	}
269: 	targetRelease, sqls, e := upgradeRelease(opt.TargetRoot, targetVersion)
270: 	if e != nil {
271: 		return report, e
272: 	}
273: 	contracts, e := LoadContracts(filepath.Join(opt.TargetRoot, "spec/v2.0/contracts"))
274: 	if e != nil {
275: 		return report, e
276: 	}
277: 	expectedSourceSchema, expectedTargetSchema, e := upgradeTemplate(ctx, sqls, contracts)
278: 	if e != nil {
279: 		return report, e
280: 	}
281: 	key, e := os.ReadFile(opt.KeyFile)
282: 	if e != nil || len(key) != 32 {
283: 		return report, fmt.Errorf("BACKUP_KEY_UNAVAILABLE")
284: 	}
285: 	defer clear(key)

