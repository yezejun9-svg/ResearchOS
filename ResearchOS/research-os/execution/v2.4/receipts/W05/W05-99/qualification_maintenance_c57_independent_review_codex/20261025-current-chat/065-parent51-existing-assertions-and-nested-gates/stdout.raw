227: func checkQualificationOrdinary(root string) error {
228: 	namespace := filepath.Join(root, "host", QualificationNamespace)
229: 	if _, err := os.Lstat(namespace); os.IsNotExist(err) {
230: 		return nil
231: 	} else if err != nil {
232: 		return err
233: 	}
234: 	if err := checkPrivateDirectory(namespace); err != nil {
235: 		return err
236: 	}
237: 	entries, err := os.ReadDir(namespace)
238: 	if err != nil {
239: 		return err
240: 	}
241: 	if len(entries) > 256 {
242: 		return errors.New("qualification history bound")
243: 	}
244: 	for _, entry := range entries {
245: 		if !entry.IsDir() || !validOperation(entry.Name()) {
246: 			return errors.New("qualification unknown operation")
247: 		}
248: 		_, _, events, err := readQualification(root, entry.Name())
249: 		if err != nil {
250: 			return err
251: 		}
252: 		state := events[len(events)-1].State
253: 		if state != "ABORTED" && state != "DURABLE" {
254: 			return errors.New("qualification pending operation")
255: 		}
256: 	}
257: 	return nil
258: }
259: 
260: func inspectQualification(root, operation, planDigest string) (HistoryStatus, error) {
261: 	var status HistoryStatus
262: 	_, actualDigest, events, err := readQualification(root, operation)
263: 	if err != nil {
264: 		return status, err
265: 	}
266: 	if actualDigest != planDigest {
267: 		return status, errors.New("qualification own plan digest mismatch")
268: 	}
269: 	namespace := filepath.Join(root, "host", QualificationNamespace)
270: 	entries, err := os.ReadDir(namespace)
271: 	if err != nil {
272: 		return status, err
273: 	}
274: 	for _, entry := range entries {
275: 		if entry.Name() == operation {
276: 			continue
277: 		}
278: 		if !entry.IsDir() || !validOperation(entry.Name()) {
279: 			return status, errors.New("qualification other operation invalid")
280: 		}
281: 		_, _, other, err := readQualification(root, entry.Name())
282: 		if err != nil {
283: 			return status, err
284: 		}
285: 		last := other[len(other)-1].State
286: 		if last != "ABORTED" && last != "DURABLE" {
287: 			return status, errors.New("qualification other pending operation")
288: 		}
289: 	}
290: 	state := events[len(events)-1].State
291: 	return HistoryStatus{Namespace: QualificationNamespace, Operation: operation, PlanDigest: planDigest,
292: 		State: state, Terminal: state == "ABORTED" || state == "DURABLE",
293: 		Applied: state == "DB_COMMITTED_OBSERVED" || state == "DURABLE"}, nil
294: }
