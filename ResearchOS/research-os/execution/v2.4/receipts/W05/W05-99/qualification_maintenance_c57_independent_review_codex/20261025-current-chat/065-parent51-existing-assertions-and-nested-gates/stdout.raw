FILE internal/domain/backup_upgrade.go
113: func upgradePaths(opt *LocalUpgradeOptions) error {
114: 	for _, p := range []*string{&opt.Source, &opt.KeyFile, &opt.SourceRoot, &opt.TargetRoot, &opt.SourceProgram, &opt.TargetProgram} {
115: 		v, e := upgradePath(*p, true)
116: 		if e != nil {
117: 			return e
118: 		}
119: 		*p = v
120: 	}
121: 	for _, p := range []*string{&opt.Snapshot, &opt.Destination} {
122: 		v, e := upgradePath(*p, false)
123: 		if e != nil {
124: 			return e
125: 		}
126: 		*p = v
127: 	}
128: 	dirs := []string{filepath.Dir(opt.Source), filepath.Dir(opt.KeyFile), opt.Snapshot, opt.Destination}
129: 	for i, a := range dirs {
130: 		for _, b := range dirs[i+1:] {
131: 			if upgradeInside(a, b) || upgradeInside(b, a) {
132: 				return fmt.Errorf("UPGRADE_PATH_OVERLAP: source, key, snapshot and target require separate directories")
133: 			}
134: 		}
135: 	}
136: 	var infos []os.FileInfo
137: 	for _, p := range []string{opt.Source, opt.KeyFile, opt.SourceProgram, opt.TargetProgram} {
138: 		info, e := os.Stat(p)
139: 		if e != nil || !info.Mode().IsRegular() {
140: 			return fmt.Errorf("UPGRADE_REGULAR_FILE_REQUIRED")
141: 		}
142: 		infos = append(infos, info)
143: 	}
144: 	for i := 1; i < len(infos); i++ {
145: 		if os.SameFile(infos[0], infos[i]) || (i > 1 && os.SameFile(infos[1], infos[i])) {
146: 			return fmt.Errorf("UPGRADE_FILE_ALIAS")
147: 		}
148: 	}
149: 	if opt.sourceLease != nil {
150: 		if err := opt.sourceLease.Check(filepath.Dir(opt.Source), opt.Source); err != nil {
151: 			return err
152: 		}
153: 	}
154: 	return nil
155: }
