51: func preparedUpgradeReadPin(pin recoveryauthority.RawPin, path, role string) ([]byte, error) {
52:     resolved, err := upgradePath(path, true)
53:     if err != nil { return nil, err }
54:     pinned, err := upgradePath(pin.Path, true)
55:     if err != nil || !strings.EqualFold(resolved, pinned) || pin.Role != role || pin.Bytes <= 0 {
56:         return nil, fmt.Errorf("PREPARED_UPGRADE_EVIDENCE_PATH")
57:     }
58:     raw, err := os.ReadFile(resolved)
59:     if err != nil || int64(len(raw)) != pin.Bytes || Digest(raw) != pin.SHA256 {
60:         return nil, fmt.Errorf("PREPARED_UPGRADE_EVIDENCE_PIN")
61:     }
62:     return raw, nil
63: }
64: 
65: 
66: func preparedUpgradeRequireFilePin(token recoveryauthority.MigrationToken, role, path, expected string) error {
67:     raw, err := os.ReadFile(path)
68:     if err != nil || Digest(raw) != expected { return fmt.Errorf("PREPARED_UPGRADE_HELD_INPUT_HASH: %s", role) }
69:     return token.RequirePin(recoveryauthority.RawPin{Role: role, Path: path, SHA256: expected, Bytes: int64(len(raw))})
70: }
