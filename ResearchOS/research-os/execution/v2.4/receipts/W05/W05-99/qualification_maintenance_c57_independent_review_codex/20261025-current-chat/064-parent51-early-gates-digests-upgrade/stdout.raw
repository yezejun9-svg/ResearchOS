106: 	} else if *trialCredential != "" || *trialProvider != "" {
107: 		log.Fatal("partial trial readonly vault configuration")
108: 	}
109: 	webDir := setting("RESEARCHOS_WEB_DIR", filepath.Join("apps", "web", "dist"))
110: 	if _, err := os.Stat(filepath.Join(webDir, "index.html")); err != nil && adminActions == 0 {
111: 		log.Fatalf("web build unavailable: %v", err)
112: 	}
113: 	lease, err := rt.AcquireDataRootLease(dataDir)
114: 	if err != nil {
115: 		if managedQualification != nil {
116: 			log.Fatal("managed qualification request not consumed: control data root is already owned or unavailable; the privileged Desktop host must complete an orderly managed restart, never start a second coordinator")
117: 		}
118: 		log.Fatalf("control data-root lease unavailable: %v", err)
119: 	}
120: 	defer func() {
121: 		if err := lease.Close(); err != nil {
122: 			log.Fatalf("data-root lease close failed: %v", err)
123: 		}
124: 	}()
125: 	dataDir = lease.Root()
126: 	if err := runtimeVerifierReplacementStartupGate(lease); err != nil {
127: 		log.Fatalf("runtime verifier replacement recovery required: %v", err)
128: 	}
129: 	db, err := store.Open(filepath.Join(dataDir, "researchos.sqlite"))
130: 	if err != nil {
131: 		log.Fatalf("database unavailable: %v", err)
132: 	}
133: 	defer func() {
134: 		if err := db.Close(); err != nil {
135: 			log.Fatalf("database close failed: %v", err)
136: 		}

