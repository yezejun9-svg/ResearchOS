20: 
21: type preparedUpgradeRootLease struct {
22:     native *runtimeadapter.DataRootLease
23:     inherited *backupSourceLease
24:     root, source string
25:     closed bool
26: }
27: 
28: func acquirePreparedUpgradeRootLease(root, source string, inherited *backupSourceLease) (*preparedUpgradeRootLease, error) {
29:     if inherited != nil {
30:         if err := inherited.Check(root, source); err != nil { return nil, err }
31:         return &preparedUpgradeRootLease{inherited: inherited, root: root, source: source}, nil
32:     }
33:     lease, err := runtimeadapter.AcquireDataRootLease(root)
34:     if err != nil { return nil, err }
35:     return &preparedUpgradeRootLease{native: lease}, nil
36: }
37: func (l *preparedUpgradeRootLease) Check() error {
38:     if l == nil || l.closed { return fmt.Errorf("PREPARED_UPGRADE_DATA_ROOT_LEASE_REQUIRED") }
39:     if l.inherited != nil { return l.inherited.Check(l.root, l.source) }
40:     if l.native == nil || !l.native.Held() { return fmt.Errorf("PREPARED_UPGRADE_DATA_ROOT_LEASE_REQUIRED") }
41:     return nil
42: }
43: func (l *preparedUpgradeRootLease) Close() error {
44:     if l == nil || l.closed { return nil }
45:     l.closed = true
46:     if l.inherited != nil { return nil }
47:     if l.native == nil { return fmt.Errorf("PREPARED_UPGRADE_DATA_ROOT_LEASE_REQUIRED") }
48:     return l.native.Close()
49: }
50: 
51: func preparedUpgradeReadPin(pin recoveryauthority.RawPin, path, role string) ([]byte, error) {
52:     resolved, err := upgradePath(path, true)
53:     if err != nil { return nil, err }
54:     pinned, err := upgradePath(pin.Path, true)
55:     if err != nil || !strings.EqualFold(resolved, pinned) || pin.Role != role || pin.Bytes <= 0 {
56:         return nil, fmt.Errorf("PREPARED_UPGRADE_EVIDENCE_PATH")
57:     }
58:     raw, err := os.ReadFile(resolved)
59:     if err != nil || int64(len(raw)) != pin.Bytes || Digest(raw) != pin.SHA256 {
60:         return nil, fmt.Errorf("PREPARED_UPGRADE_EVIDENCE_PIN")
61:     }
62:     return raw, nil
63: }
64: 
65: 
66: func preparedUpgradeRequireFilePin(token recoveryauthority.MigrationToken, role, path, expected string) error {
67:     raw, err := os.ReadFile(path)
68:     if err != nil || Digest(raw) != expected { return fmt.Errorf("PREPARED_UPGRADE_HELD_INPUT_HASH: %s", role) }
69:     return token.RequirePin(recoveryauthority.RawPin{Role: role, Path: path, SHA256: expected, Bytes: int64(len(raw))})
70: }
71: 
72: // No original-root operation is available through caller JSON alone.
73: // The native leaf owns the purpose-separated signature, accepted release anchor,
74: // actual Windows peer/self/root/DB identities, lifetime and held DataRootLease.
75: func ExecutePreparedAbandonmentSchemaUpgrade(ctx context.Context, db *sql.DB, token recoveryauthority.MigrationToken, ownerToken string, opt LocalUpgradeOptions) (result Object, err error) {
76:     result = Object{"plan": PreparedAbandonmentSchemaUpgradePlan, "status": "DENIED_BEFORE_DDL",
77:         "committed": false, "automatic_retry": false, "original_restore_called": false,
78:         "abandonment_performed": false, "provider_requests": nil, "financial_closed": false}
79:     binding, err := token.Binding()
80:     if err != nil { return result, err }
81:     if binding.PlanID != PreparedAbandonmentSchemaUpgradePlan || opt.Plan != binding.PlanID ||
82:         binding.SQLSHA256 != preparedUpgradeSQLHash {
83:         return result, fmt.Errorf("PREPARED_UPGRADE_NATIVE_PLAN")
84:     }
85:     optionsRaw, err := json.Marshal(opt)
86:     if err != nil || Digest(optionsRaw) != binding.OptionsSHA256 {
87:         return result, fmt.Errorf("PREPARED_UPGRADE_NATIVE_OPTIONS")
88:     }
89:     if err = token.Check(binding); err != nil { return result, err }
90:     if db == nil || db.Stats().MaxOpenConnections != 1 {
91:         return result, fmt.Errorf("PREPARED_UPGRADE_SINGLE_CONNECTION_REQUIRED")
92:     }
93:     // Do not run upgradePaths here: these are reviewed EXISTING backup and
94:     // rehearsal outputs, not fresh destinations. Reject aliases before reading.
95:     for _, path := range []string{opt.Source, opt.SourceRoot, opt.TargetRoot, opt.SourceProgram, opt.TargetProgram, opt.KeyFile, opt.Snapshot, opt.Destination} {
96:         resolved, pathErr := upgradePath(path, true)
97:         if pathErr != nil || !filepath.IsAbs(path) || !strings.EqualFold(filepath.Clean(path), resolved) {
98:             return result, fmt.Errorf("PREPARED_UPGRADE_REVIEWED_PATH_CHANGED")
99:         }
100:     }
101:     for _, path := range []string{opt.KeyFile, opt.Snapshot, opt.Destination} {
102:         parent := path
103:         if path == opt.KeyFile { parent = filepath.Dir(path) }
104:         if upgradeInside(filepath.Dir(opt.Source), parent) || upgradeInside(parent, filepath.Dir(opt.Source)) {
105:             return result, fmt.Errorf("PREPARED_UPGRADE_OUTPUT_OVERLAP")
106:         }
107:     }
108:     if !strings.EqualFold(filepath.Clean(binding.Root), filepath.Dir(opt.Source)) ||
109:         !strings.EqualFold(filepath.Clean(binding.Database), filepath.Clean(opt.Source)) {
110:         return result, fmt.Errorf("PREPARED_UPGRADE_NATIVE_DATABASE")
111:     }
112:     dbs, err := db.QueryContext(ctx, "PRAGMA database_list")
113:     if err != nil { return result, err }
114:     mainPath, databaseCount := "", 0
115:     for dbs.Next() {
116:         var sequence int
117:         var name, path string
118:         if err = dbs.Scan(&sequence, &name, &path); err != nil { dbs.Close(); return result, err }
119:         if name != "temp" { databaseCount++ }
120:         if name == "main" { mainPath = path }
121:     }
122:     err = dbs.Err()
123:     dbs.Close()
124:     if err != nil || databaseCount != 1 || !strings.EqualFold(filepath.Clean(mainPath), filepath.Clean(opt.Source)) {
125:         return result, fmt.Errorf("PREPARED_UPGRADE_CONNECTION_IDENTITY")
126:     }
127:     var temporaryObjects int
128:     if err = db.QueryRowContext(ctx, "SELECT count(*) FROM sqlite_temp_master").Scan(&temporaryObjects); err != nil || temporaryObjects != 0 {
129:         return result, fmt.Errorf("PREPARED_UPGRADE_TEMP_SCHEMA_PROHIBITED")
130:     }
131:     // Retained EXCLUSIVE SQLite ownership is separate from the native lease.
132:     // This no-op transaction establishes it without restore/recovery changes.
133:     if _, err = db.ExecContext(ctx, "PRAGMA busy_timeout=250; PRAGMA locking_mode=EXCLUSIVE; BEGIN EXCLUSIVE; ROLLBACK;"); err != nil {
134:         return result, fmt.Errorf("PREPARED_UPGRADE_SOURCE_NOT_OFFLINE: %w", err)
135:     }
136:     sourceRelease, _, err := preparedUpgradeRelease(opt.SourceRoot, 23)
137:     if err != nil || Hash(sourceRelease) != binding.SourceInventorySHA256 {
138:         return result, fmt.Errorf("PREPARED_UPGRADE_SOURCE_RELEASE_ANCHOR")
139:     }
140:     targetRelease, sqls, err := preparedUpgradeRelease(opt.TargetRoot, 24)
141:     if err != nil || Hash(targetRelease) != binding.TargetInventorySHA256 {
142:         return result, fmt.Errorf("PREPARED_UPGRADE_TARGET_RELEASE_ANCHOR")
143:     }
144:     for relative, digest := range sourceRelease {
145:         if err = preparedUpgradeRequireFilePin(token, "source-inventory:"+relative,
146:             filepath.Join(opt.SourceRoot, filepath.FromSlash(relative)), digest.(string)); err != nil { return result, err }
147:     }
148:     for relative, digest := range targetRelease {
149:         if err = preparedUpgradeRequireFilePin(token, "target-inventory:"+relative,
150:             filepath.Join(opt.TargetRoot, filepath.FromSlash(relative)), digest.(string)); err != nil { return result, err }
151:     }
152:     sourceProgram, targetProgram, err := preparedUpgradeProgramHashes(opt, true)
153:     if err != nil || sourceProgram != binding.SourceReleaseSHA256 || targetProgram != binding.TargetReleaseSHA256 {
154:         return result, fmt.Errorf("PREPARED_UPGRADE_NATIVE_PROGRAM_ANCHOR")
155:     }
156:     for _, pin := range []struct{ role, path, hash string }{
157:         {"source-program", opt.SourceProgram, sourceProgram},
158:         {"target-program", opt.TargetProgram, targetProgram},
159:         {"migration-sql", filepath.Join(opt.TargetRoot, "migrations/sqlite/0024_prepared_run_abandonment.sql"), preparedUpgradeSQLHash},
160:     } {
161:         if err = preparedUpgradeRequireFilePin(token, pin.role, pin.path, pin.hash); err != nil { return result, err }
162:     }
163:     contracts, err := LoadContracts(filepath.Join(opt.TargetRoot, "spec/v2.0/contracts"))
164:     if err != nil { return result, err }
165:     schemas, err := preparedUpgradeTemplate(ctx, sqls, contracts)
166:     if err != nil { return result, err }
167:     if schemas.Source23 != binding.SourceSchemaSHA256 || schemas.Original24 != binding.TargetSchemaSHA256 {
168:         return result, fmt.Errorf("PREPARED_UPGRADE_NATIVE_SCHEMA_ANCHOR")
169:     }
170:     guard := &upgradeQueueProtection{upgradeProtection: upgradeProtection{ctx: ctx, verifier: preparedUpgradeConcreteVerifier()}, contracts: contracts}
171:     if err = guard.refresh(db); err != nil { return result, err }
172:     backupRaw, err := preparedUpgradeReadPin(binding.Backup, filepath.Join(opt.Snapshot, "manifest.json"), "encrypted-backup-manifest")
173:     if err != nil { return result, err }
174:     rehearsalRaw, err := preparedUpgradeReadPin(binding.Rehearsal, filepath.Join(opt.Destination, preparedUpgradeReceiptName), "isolated-restore-rehearsal")
175:     if err != nil { return result, err }
176:     var rehearsal preparedUpgradeRehearsalReceipt
177:     decoder := json.NewDecoder(bytes.NewReader(rehearsalRaw))
178:     decoder.DisallowUnknownFields()
179:     if err = decoder.Decode(&rehearsal); err != nil { return result, err }
180:     if err = decoder.Decode(new(any)); err != io.EOF { return result, fmt.Errorf("PREPARED_UPGRADE_REHEARSAL_TRAILING_DATA") }
181:     if rehearsal.Schema != "researchos.prepared-abandonment-schema-rehearsal.v1" ||
182:         rehearsal.Plan != binding.PlanID || rehearsal.Status != "ISOLATED_REHEARSAL_COMPLETE_ORIGINAL_UNCHANGED" ||
183:         !rehearsal.RollbackVerified || !rehearsal.OriginalUnchanged || !rehearsal.ExistingRowsUnchanged || !rehearsal.NewProofTableEmpty ||
184:         rehearsal.AutomaticPromotion || !reflect.DeepEqual(rehearsal.Options, opt) || rehearsal.OptionsHash != binding.OptionsSHA256 ||
185:         rehearsal.SourceProgramHash != sourceProgram || rehearsal.TargetProgramHash != targetProgram ||
186:         rehearsal.SourceInventoryHash != Hash(sourceRelease) || rehearsal.TargetInventoryHash != Hash(targetRelease) ||
187:         rehearsal.SQLHash != preparedUpgradeSQLHash || rehearsal.SourceSchema != schemas.Source23 || rehearsal.TargetSchema != schemas.Original24 ||
188:         rehearsal.RestoredSchema != schemas.Restored23 || rehearsal.RestoredTargetSchema != schemas.Restored24 ||
189:         rehearsal.OriginalRowsHash != binding.OriginalRowsSHA256 ||
190:         rehearsal.BackupManifestHash != Digest(backupRaw) || rehearsal.BackupManifestBytes != int64(len(backupRaw)) ||
191:         rehearsal.RestoreReport.Status != "RESTORED_RECONCILIATION_REQUIRED" ||
192:         !backupConfigurationHash.MatchString(rehearsal.PostRestoreRowsHash) || !backupConfigurationHash.MatchString(rehearsal.PostDDLRowsHash) ||
193:         rehearsal.RestoreDelta == nil || rehearsal.ReleaseAuthority != "RECORDED_PROGRAM_PINS_REQUIRE_SEPARATE_NATIVE_APPLY_AUTHORITY" {
194:         return result, fmt.Errorf("PREPARED_UPGRADE_REHEARSAL_BINDING")
195:     }
196:     savedPlan, planOK := rehearsal.BackupPurpose["plan"].(map[string]any)
197:     if !planOK || rehearsal.BackupPurpose["kind"] != "SAME_HOST_PREPARED_ABANDONMENT_SCHEMA_REHEARSAL" ||
198:         rehearsal.BackupPurpose["scope"] != "IsolatedRestoreOnly" || rehearsal.BackupPurpose["automatic_promotion"] != false ||
199:         rehearsal.BackupPurpose["original_business_mutation"] != false || Str(rehearsal.BackupPurpose, "plan_hash") != Hash(savedPlan) ||
200:         savedPlan["id"] != binding.PlanID || savedPlan["source_database_logical_hash"] != binding.OriginalRowsSHA256 ||
201:         savedPlan["source_schema_hash"] != schemas.Source23 || savedPlan["original_target_schema_hash"] != schemas.Original24 ||
202:         savedPlan["restored_target_schema_hash"] != schemas.Restored24 || savedPlan["migration_sql_hash"] != preparedUpgradeSQLHash ||
203:         savedPlan["source_release_hash"] != Hash(sourceRelease) || savedPlan["target_release_hash"] != Hash(targetRelease) ||
204:         savedPlan["source_program_hash"] != sourceProgram || savedPlan["target_program_hash"] != targetProgram ||
205:         savedPlan["options_hash"] != binding.OptionsSHA256 || Hash(savedPlan["source_versions"]) != Hash(upgradeVersions(23)) ||
206:         Hash(savedPlan["target_versions"]) != Hash(upgradeVersions(24)) {
207:         return result, fmt.Errorf("PREPARED_UPGRADE_BACKUP_PURPOSE")
208:     }
209:     key, err := os.ReadFile(opt.KeyFile)
210:     if err != nil || len(key) != 32 { return result, fmt.Errorf("BACKUP_KEY_UNAVAILABLE") }
211:     defer clear(key)
212:     policy := &backupPolicy{format: localUpgradeFormat, databaseName: "researchos.sqlite", purpose: rehearsal.BackupPurpose}
213:     manifest, files, err := readBackupPolicy(opt.Snapshot, key, policy)
214:     if err != nil { return result, err }
215:     defer func() { for _, raw := range files { clear(raw) } }()
216:     if !reflect.DeepEqual(manifest.Migrations, upgradeVersions(23)) || manifest.SchemaHash != schemas.Source23 ||
217:         manifest.ID != rehearsal.RestoreReport.BackupID || Digest(Bytes(manifest.Purpose)) != Digest(Bytes(rehearsal.BackupPurpose)) {
218:         return result, fmt.Errorf("PREPARED_UPGRADE_BACKUP_BINDING")
219:     }
220:     for _, file := range manifest.Files {
221:         path := filepath.Join(opt.Snapshot, file.Name+".enc")
222:         encrypted, readErr := os.ReadFile(path)
223:         if readErr != nil { return result, readErr }
224:         if err = token.RequirePin(recoveryauthority.RawPin{Role: "encrypted-backup-payload:"+file.Name+".enc",
225:             Path: path, SHA256: Digest(encrypted), Bytes: int64(len(encrypted))}); err != nil { return result, err }
226:     }
227:     if err = token.Check(binding); err != nil { return result, err }
228:     if err = preparedUpgradeVersions(db, 23); err != nil { return result, err }
229:     original, err := preparedUpgradeSnapshot(db)
230:     if err != nil || Hash(original) != binding.OriginalRowsSHA256 { return result, fmt.Errorf("PREPARED_UPGRADE_ORIGINAL_DRIFT") }
231:     schema, err := preparedUpgradeSchema(db)
232:     if err != nil || schema != schemas.Source23 { return result, fmt.Errorf("PREPARED_UPGRADE_SOURCE_SCHEMA") }
233:     if err = token.Check(binding); err != nil { return result, err }
234:     // An existing intent is a recovery boundary, never an automatic retry.
235:     receiptDir := opt.Destination + ".original-schema24"
236:     if _, err = upgradePath(receiptDir, false); err != nil { return result, err }
237:     if err = os.Mkdir(receiptDir, 0700); err != nil { return result, err }
238:     result["receipt_directory"] = receiptDir
239:     intent := Object{"schema": "researchos.prepared-abandonment-schema-migration-intent.v1", "binding": binding,
240:         "created_at": Now(), "status": "PREPARED_NOT_COMMITTED", "automatic_retry": false,
241:         "original_rows_sha256": Hash(original), "source_schema_sha256": schema}
242:     if err = backupWrite(filepath.Join(receiptDir, "migration-intent.json"), Bytes(intent)); err != nil { return result, err }
243:     // The native caller also records the result. A durable intent without a
244:     // final receipt requires inspection of schema/version, not replay.
245:     defer func() {
246:         result["finished_at"] = Now()
247:         if err != nil && result["committed"] == false && result["status"] != "COMMIT_OUTCOME_UNKNOWN" {
248:             result["status"] = "NOT_COMMITTED"
249:         }
250:         if err != nil { result["error"] = err.Error() }
251:         writeErr := backupWrite(filepath.Join(receiptDir, "migration-result.json"), Bytes(result))
252:         if writeErr != nil {
253:             result["receipt_persistence_error"] = writeErr.Error()
254:             if err == nil { err = fmt.Errorf("PREPARED_UPGRADE_RESULT_PERSISTENCE: %w", writeErr) }
255:         }
256:     }()
257:     tx, err := db.BeginTx(ctx, nil)
258:     if err != nil { return result, err }
259:     defer tx.Rollback()
260:     if err = resourceWriteLock(tx); err != nil { return result, err }
261:     owner, err := authenticate(tx, ownerToken)
262:     if err != nil { return result, err }
263:     if !owner.HasRole("OWNER") || !owner.Allowed(binding.ProjectID, "", "", false) {
264:         return result, Fail(403, "FORBIDDEN", "current project Owner required")
265:     }
266:     root, err := authorityRoot(tx, owner.ID)
267:     if err != nil || root != owner.ID || root != binding.OwnerRoot {
268:         return result, Fail(403, "FORBIDDEN", "direct local Root Owner required")
269:     }
270:     if err = token.Begin(binding); err != nil { return result, err }
271:     commitAttempted := false
272:     defer func() { _ = tx.Rollback(); token.Finish(commitAttempted) }()
273:     result["status"] = "TRANSACTION_OPEN"
274:     if err = preparedUpgradeDDL(ctx, tx, sqls[23], original, schemas.Source23, schemas.Original24); err != nil {
275:         result["status"] = "ROLLED_BACK_BEFORE_COMMIT"
276:         return result, err
277:     }
278:     if err = token.Check(binding); err != nil { return result, err }
279:     // Recheck public pins before commit; the SQL used above is the already
280:     // verified immutable byte slice, never reloaded from a mutable path.
281:     a, _, pinErr := preparedUpgradeRelease(opt.SourceRoot, 23)
282:     if pinErr != nil || Hash(a) != Hash(sourceRelease) { return result, fmt.Errorf("PREPARED_UPGRADE_RELEASE_CHANGED") }
283:     b, _, pinErr := preparedUpgradeRelease(opt.TargetRoot, 24)
284:     if pinErr != nil || Hash(b) != Hash(targetRelease) { return result, fmt.Errorf("PREPARED_UPGRADE_RELEASE_CHANGED") }
285:     x, y, pinErr := preparedUpgradeProgramHashes(opt, true)
286:     if pinErr != nil || x != sourceProgram || y != targetProgram { return result, fmt.Errorf("PREPARED_UPGRADE_PROGRAM_CHANGED") }
287:     if _, pinErr = preparedUpgradeReadPin(binding.Backup, filepath.Join(opt.Snapshot, "manifest.json"), "encrypted-backup-manifest"); pinErr != nil { return result, pinErr }
288:     if _, pinErr = preparedUpgradeReadPin(binding.Rehearsal, filepath.Join(opt.Destination, preparedUpgradeReceiptName), "isolated-restore-rehearsal"); pinErr != nil { return result, pinErr }
289:     after, err := preparedUpgradeSnapshot(tx)
290:     if err != nil { return result, err }
291:     result["before_rows_sha256"], result["after_rows_sha256"] = Hash(original), Hash(after)
292:     result["source_schema_sha256"], result["target_schema_sha256"] = schemas.Source23, schemas.Original24
293:     result["existing_business_rows_unchanged"], result["new_proof_table_empty"] = true, true
294:     result["migration_only_adds_version"] = 24
295:     // A Commit error can have an uncertain durable outcome. Consume the token
296:     // conservatively and leave the immutable intent for independent inspection.
297:     commitAttempted = true
298:     result["status"] = "COMMIT_OUTCOME_UNKNOWN"
299:     if err = tx.Commit(); err != nil { return result, err }
300:     result["status"], result["committed"] = "SCHEMA24_COMMITTED_ORIGINAL_BUSINESS_ROWS_UNCHANGED", true
301:     result["binding"] = binding
302:     return result, nil
303: }

