93: func fixtureControlReplay(requestPath string) error {
94: 	token, err := windows.OpenCurrentProcessToken()
95: 	if err != nil {
96: 		return err
97: 	}
98: 	var appContainer, size uint32
99: 	const tokenIsAppContainer = 29 // TOKEN_INFORMATION_CLASS from Windows SDK winnt.h.
100: 	err = windows.GetTokenInformation(token, tokenIsAppContainer, (*byte)(unsafe.Pointer(&appContainer)), uint32(unsafe.Sizeof(appContainer)), &size)
101: 	token.Close()
102: 	if err != nil || appContainer != 1 {
103: 		return fmt.Errorf("fixture control replay requires AppContainer")
104: 	}
105: 	if err := replayPlain(requestPath); err != nil {
106: 		return err
107: 	}
108: 	input := filepath.Dir(requestPath)
109: 	output, err := os.Getwd()
110: 	if err != nil {
111: 		return err
112: 	}
113: 	if err = replayPlain(output); err != nil {
114: 		return err
115: 	}
116: 	if filepath.Base(requestPath) != "current-case.json" || filepath.Base(input) != "input" || filepath.Base(output) != "output" || !strings.EqualFold(filepath.Dir(input), filepath.Dir(output)) {
117: 		return fmt.Errorf("replay requires isolated sibling input/output roots")
118: 	}
119: 	entries, err := os.ReadDir(output)
120: 	if err != nil || len(entries) != 0 {
121: 		return fmt.Errorf("empty replay output required")
122: 	}
123: 	raw, err := replayRead(requestPath, 64*1024)
124: 	if err != nil {
125: 		return err
126: 	}
127: 	var request evolution.ControlRequest
128: 	if err = evolution.StrictControlJSON(raw, &request); err != nil {
129: 		return err
130: 	}
131: 	if err = evolution.ValidateControlCase(request.Case, request.Binding); err != nil {
132: 		return err
133: 	}
134: 	bundle := evolution.ControlBundle{Binding: request.Binding, Files: map[string][]byte{}}
135: 	for name := range evolution.ControlReleaseHashes() {
136: 		b, e := replayRead(filepath.Join(input, filepath.FromSlash(name)), 2*1024*1024)
137: 		if e != nil {
138: 			return e
139: 		}
140: 		bundle.Files[name] = b
141: 	}
142: 	bundle.Files["snapshot.sqlite"], err = replayRead(filepath.Join(input, "snapshot.sqlite"), 32*1024*1024)
143: 	if err != nil {
144: 		return err
145: 	}
146: 	if err = bundle.Validate(); err != nil {
147: 		return err
148: 	}
149: 	data := filepath.Join(output, "replay-data")
150: 	if err = os.Mkdir(data, 0700); err != nil {
151: 		return err
152: 	}
153: 	path := filepath.Join(data, "researchos.sqlite")
154: 	if err = os.WriteFile(path, bundle.Files["snapshot.sqlite"], 0600); err != nil {
155: 		return err
156: 	}
157: 	lease, err := replayOutputLease(data)
158: 	if err != nil {
159: 		return err
160: 	}
161: 	defer lease.Close()
162: 	db, err := store.Open(path)
163: 	if err != nil {
164: 		return err
165: 	}
166: 	defer db.Close()
167: 	state, err := evolution.ControlDatabaseHash(db)
168: 	if err != nil || state != request.Binding.ProjectionHash {

