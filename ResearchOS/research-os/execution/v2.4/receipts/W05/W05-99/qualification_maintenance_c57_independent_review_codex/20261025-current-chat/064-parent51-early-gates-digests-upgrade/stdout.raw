73: func replayOutputLease(data string) (*os.File, error) {
74: 	if err := replayPlain(data); err != nil {
75: 		return nil, err
76: 	}
77: 	path := filepath.Join(data, "coordinator.lock")
78: 	name, err := windows.UTF16PtrFromString(path)
79: 	if err != nil {
80: 		return nil, err
81: 	}
82: 	h, err := windows.CreateFile(name, windows.GENERIC_READ|windows.GENERIC_WRITE, 0, nil, windows.CREATE_NEW, windows.FILE_ATTRIBUTE_NORMAL, 0)
83: 	if err != nil {
84: 		return nil, err
85: 	}
86: 	if err := qualificationmaintenancejournal.CheckOrdinary(data); err != nil {
87: 		windows.CloseHandle(h)
88: 		return nil, err
89: 	}
90: 	return os.NewFile(uintptr(h), path), nil
91: }
