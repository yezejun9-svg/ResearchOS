25: func TestRestartWitnessStrictDecreaseAndWindow(t *testing.T) {
26: 	sha := strings.Repeat("a", 64)
27: 	pre := BootWitness{Schema: WitnessSchema, OperationID: "0123456789abcdef0123456789abcdef", PlanSHA256: sha, HelperSHA256: sha, FenceSHA256: sha,
28: 		UTC: time.Date(2026, 10, 25, 7, 0, 0, 0, time.UTC), UptimeMilliseconds: 900000,
29: 		LastBootUTC: time.Date(2026, 10, 25, 6, 45, 0, 0, time.UTC), RestartApps: 1,
30: 		BusinessEnabledSIDsSHA256: sha, BusinessPrivilegesSHA256: sha, BusinessElevationType: 3, BusinessIntegritySID: "S-1-16-8192", BusinessLogonSID: "S-1-5-5-1-2",
31: 		BusinessProcessPID: 100, BusinessProcessCreatedUTC: time.Date(2026, 10, 25, 6, 50, 0, 0, time.UTC), BusinessProcessImageSHA256: sha}
32: 	post := pre
33: 	post.UTC = pre.UTC.Add(5 * time.Minute)
34: 	post.LastBootUTC = pre.UTC.Add(30 * time.Second)
35: 	post.UptimeMilliseconds = 270000
36: 	post.FullRestartEvidenceSHA256 = sha
37: 	post.BusinessSessionID = 9
38: 	post.BusinessLogonSID = "S-1-5-5-9-10"
39: 	post.BusinessProcessPID = 200
40: 	post.BusinessProcessCreatedUTC = post.LastBootUTC.Add(time.Minute)
41: 	if err := ValidateRestart(pre, post); err != nil {
42: 		t.Fatalf("valid bounded witness: %v", err)
43: 	}
44: 	cases := map[string]func(*BootWitness){
45: 		"same boot":            func(x *BootWitness) { x.LastBootUTC = pre.LastBootUTC },
46: 		"uptime equal":         func(x *BootWitness) { x.UptimeMilliseconds = pre.UptimeMilliseconds },
47: 		"uptime too long":      func(x *BootWitness) { x.UptimeMilliseconds = uint64(MaxPostUptime / time.Millisecond) },
48: 		"UTC expired":          func(x *BootWitness) { x.UTC = pre.UTC.Add(MaxElapsed + time.Second) },
49: 		"negative UTC":         func(x *BootWitness) { x.UTC = pre.UTC.Add(-time.Second) },
50: 		"plan drift":           func(x *BootWitness) { x.PlanSHA256 = strings.Repeat("b", 64) },
51: 		"boot after post":      func(x *BootWitness) { x.LastBootUTC = x.UTC.Add(time.Second) },
52: 		"unknown RestartApps":  func(x *BootWitness) { x.RestartApps = 2 },
53: 		"business group drift": func(x *BootWitness) { x.BusinessEnabledSIDsSHA256 = strings.Repeat("b", 64) },
54: 		"business IL drift":    func(x *BootWitness) { x.BusinessIntegritySID = "S-1-16-12288" },
55: 		"stale source process": func(x *BootWitness) { x.BusinessProcessCreatedUTC = pre.LastBootUTC },
56: 	}
57: 	for name, mutate := range cases {
58: 		t.Run(name, func(t *testing.T) {
59: 			x := post
60: 			mutate(&x)
61: 			if err := ValidateRestart(pre, x); err == nil {
62: 				t.Fatal("invalid witness accepted")
63: 			}
64: 		})
65: 	}
66: }
