223: 	defer windows.CloseHandle(before.handle)
224: 	u, err := windows.GetCurrentProcessToken().GetTokenUser()
225: 	if err != nil {
226: 		t.Fatal(err)
227: 	}
228: 	installed, err := denyDescriptor(before.identity.SecurityDescriptor, u.User.Sid.String(), u.User.Sid.String(), "executable")
229: 	if err != nil {
230: 		t.Fatal(err)
231: 	}
232: 	if installed == before.identity.SecurityDescriptor {
233: 		t.Fatal("fence did not change descriptor")
234: 	}
235: 	if err = setTargetDescriptor(before.identity, installed); err != nil {
236: 		t.Skipf("fixture WRITE_DAC unavailable: %v", err)
237: 	}
238: 	restoredInBody := false
239: 	defer func() {
240: 		if restoredInBody {
241: 			return
242: 		}
243: 		if err := setTargetDescriptor(withFixtureSD(before.identity, installed), before.identity.SecurityDescriptor); err != nil {
244: 			t.Errorf("fixture descriptor restore: %v", err)
245: 		}
246: 	}()
247: 	after, err := openNative(path, false, true)
248: 	if err != nil {
249: 		t.Fatal(err)
250: 	}
251: 	if !identityCoreEqual(before.identity, after.identity) || after.identity.SecurityDescriptor != installed {
252: 		t.Errorf("installed native identity/readback mismatch: core=%v expectedSD=%q actualSD=%q", identityCoreEqual(before.identity, after.identity), installed, after.identity.SecurityDescriptor)
253: 	}
254: 	if err := windows.CloseHandle(after.handle); err != nil {
255: 		t.Fatal(err)
256: 	}
257: 	w, err := windows.UTF16PtrFromString(path)
258: 	if err != nil {
259: 		t.Fatal(err)
260: 	}
261: 	h, err := windows.CreateFile(w, windows.FILE_EXECUTE, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, nil, windows.OPEN_EXISTING, 0, 0)
262: 	if err == nil {
263: 		windows.CloseHandle(h)
264: 		t.Fatal("business SID execute opened through fence")
265: 	}
266: 	if !errors.Is(err, windows.ERROR_ACCESS_DENIED) {
267: 		t.Fatalf("execute rejection differs: %v", err)
268: 	}
269: 	if err = setTargetDescriptor(withFixtureSD(before.identity, installed), before.identity.SecurityDescriptor); err != nil {
270: 		t.Fatal(err)
271: 	}
272: 	restoredInBody = true
273: 	restored, err := openNative(path, false, true)
274: 	if err != nil {
275: 		t.Fatal(err)
276: 	}
277: 	if !identityEqual(before.identity, restored.identity) {
278: 		t.Error("original descriptor not restored exactly")
279: 	}
280: 	if err := windows.CloseHandle(restored.handle); err != nil {
281: 		t.Fatal(err)
282: 	}
283: }
284: 
285: func TestDistinctManagerPlanTransfersOwnerAndDeniesFenceTamper(t *testing.T) {
286: 	path := filepath.Join(t.TempDir(), "managed-entry.exe")
287: 	if err := os.WriteFile(path, []byte("fixture"), 0600); err != nil {
288: 		t.Fatal(err)
289: 	}
290: 	h, err := openNative(path, false, true)
291: 	if err != nil {
292: 		t.Fatal(err)
293: 	}
294: 	defer windows.CloseHandle(h.handle)
295: 	u, err := windows.GetCurrentProcessToken().GetTokenUser()
296: 	if err != nil {
297: 		t.Fatal(err)
298: 	}
299: 	manager := "S-1-5-32-544" // descriptor-construction fixture only; no privileged owner change
300: 	installed, err := denyDescriptor(h.identity.SecurityDescriptor, u.User.Sid.String(), manager, "executable")
301: 	if err != nil {
302: 		t.Fatal(err)
303: 	}
304: 	sd, err := windows.SecurityDescriptorFromString(installed)
305: 	if err != nil {
306: 		t.Fatal(err)
307: 	}
308: 	owner, _, err := sd.Owner()
309: 	if err != nil || owner.String() != manager {
310: 		t.Fatalf("management owner absent: %v %v", owner, err)
311: 	}
312: 	acl, _, err := sd.DACL()
313: 	if err != nil {
314: 		t.Fatal(err)
315: 	}
316: 	var ace *windows.ACCESS_ALLOWED_ACE
317: 	if err = windows.GetAce(acl, 0, &ace); err != nil {
318: 		t.Fatal(err)
319: 	}
320: 	want := uint32(windows.FILE_EXECUTE | windows.WRITE_DAC | windows.WRITE_OWNER | windows.DELETE | windows.FILE_WRITE_DATA | windows.FILE_APPEND_DATA)
321: 	if ace.Header.AceType != windows.ACCESS_DENIED_ACE_TYPE || uint32(ace.Mask)&want != want || (*windows.SID)(unsafe.Pointer(&ace.SidStart)).String() != u.User.Sid.String() {
322: 		t.Fatal("exact business SID anti-tamper deny absent")
323: 	}
324: }
