106: 	if err := json.Unmarshal(raw, &first); err != nil {
107: 		t.Fatal(err)
108: 	}
109: 	if err := appendEvent(p, []BoundaryEvent{first}, "ARMED"); err == nil {
110: 		t.Fatal("crash phase skip accepted")
111: 	}
112: 	if err := appendEvent(p, []BoundaryEvent{first}, "APPLYING"); err != nil {
113: 		t.Fatal(err)
114: 	}
115: 	secondRaw, err := os.ReadFile(filepath.Join(dir, "event-02.json"))
116: 	if err != nil {
117: 		t.Fatal(err)
118: 	}
119: 	var second BoundaryEvent
120: 	if err := json.Unmarshal(secondRaw, &second); err != nil {
121: 		t.Fatal(err)
122: 	}
123: 	if err := ValidateEvents([]BoundaryEvent{first, second}, p.OperationID, p.PlanSHA256); err != nil {
124: 		t.Fatal(err)
125: 	}
126: 	second.PreviousSHA256 = ""
127: 	if err := ValidateEvents([]BoundaryEvent{first, second}, p.OperationID, p.PlanSHA256); err == nil {
128: 		t.Fatal("broken predecessor accepted")
129: 	}
130: }
