68: func TestBoundaryEventSequenceRejectsGapAndReplay(t *testing.T) {
69: 	p := EntryFencePlan{OperationID: "0123456789abcdef0123456789abcdef", PlanSHA256: strings.Repeat("a", 64)}
70: 	e := BoundaryEvent{Schema: EventSchema, Sequence: 1, OperationID: p.OperationID, PlanSHA256: p.PlanSHA256, State: "PREPARED", UTC: time.Now().UTC()}
71: 	e.SHA256 = digest([]byte(strings.Join([]string{e.Schema, "1", "", e.OperationID, e.PlanSHA256, e.State, e.UTC.Format(time.RFC3339Nano)}, "\x00")))
72: 	if err := ValidateEvents([]BoundaryEvent{e}, p.OperationID, p.PlanSHA256); err != nil {
73: 		t.Fatal(err)
74: 	}
75: 	if err := ValidateEvents([]BoundaryEvent{e, e}, p.OperationID, p.PlanSHA256); err == nil {
76: 		t.Fatal("replayed sequence accepted")
77: 	}
78: 	e.State = "ARMED"
79: 	if err := ValidateEvents([]BoundaryEvent{e}, p.OperationID, p.PlanSHA256); err == nil {
80: 		t.Fatal("phase skip accepted")
81: 	}
82: }
