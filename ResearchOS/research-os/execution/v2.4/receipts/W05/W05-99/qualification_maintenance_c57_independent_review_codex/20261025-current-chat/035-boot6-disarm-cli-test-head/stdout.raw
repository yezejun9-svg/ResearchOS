182: func TestNativeHoldSurvivesGCAndBlocksReplacement(t *testing.T) {
183: 	dir := t.TempDir()
184: 	path := filepath.Join(dir, "entry.exe")
185: 	if err := os.WriteFile(path, []byte("fixture-entry"), 0600); err != nil {
186: 		t.Fatal(err)
187: 	}
188: 	h, err := openNative(path, false, true)
189: 	if err != nil {
190: 		t.Fatal(err)
191: 	}
192: 	if h.identity.FileID == "" || h.identity.Volume == 0 || h.identity.FinalUTF16 == "" || h.identity.SecurityDescriptor == "" || h.identity.SHA256 != digest([]byte("fixture-entry")) {
193: 		t.Fatal("native identity incomplete")
194: 	}
195: 	runtime.GC()
196: 	runtime.GC()
197: 	if err := os.Rename(path, filepath.Join(dir, "replacement.exe")); err == nil {
198: 		t.Fatal("rename succeeded while no-delete native hold live")
199: 	}
200: 	if err := checkHolds([]nativeHold{h}); err != nil {
201: 		t.Fatal(err)
202: 	}
203: 	if err := windows.CloseHandle(h.handle); err != nil {
204: 		t.Fatal(err)
205: 	}
206: 	if err := os.Rename(path, filepath.Join(dir, "replacement.exe")); err != nil {
207: 		t.Fatalf("rename after release: %v", err)
208: 	}
209: }
