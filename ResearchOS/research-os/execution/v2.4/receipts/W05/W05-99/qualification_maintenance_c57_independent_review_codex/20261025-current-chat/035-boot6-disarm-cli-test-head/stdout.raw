1840: 	case "observe":
1841: 		if state != "ARMED" {
1842: 			return "", errors.New("observe requires ARMED")
1843: 		}
1844: 		holds, e := openPlanHolds(p)
1845: 		if e != nil {
1846: 			return "", e
1847: 		}
1848: 		defer func() { errOut = errors.Join(errOut, closeHolds(holds)) }()
1849: 		if e = checkFence(p, holds); e != nil {
1850: 			return "", e
1851: 		}
1852: 		if e = checkAncestorControl(p, holds); e != nil {
1853: 			return "", e
1854: 		}
1855: 		if e = checkNoOfficialProcess(p); e != nil {
1856: 			return "", e
1857: 		}
1858: 		post, e := witness(p, fenceDigest(p))
1859: 		if e != nil {
1860: 			return "", e
1861: 		}
1862: 		currentBusiness, e := inspectExistingBusinessProcess(p, r.Pre.BusinessEnabledSIDsSHA256, r.Pre)
1863: 		if e != nil {
1864: 			return "", e
1865: 		}
1866: 		post.BusinessEnabledSIDsSHA256 = currentBusiness.GroupsSHA256
1867: 		post.BusinessSessionID = currentBusiness.SessionID
1868: 		post.BusinessElevationType = currentBusiness.ElevationType
1869: 		post.BusinessIntegritySID = currentBusiness.IntegritySID
1870: 		post.BusinessLogonSID = currentBusiness.LogonSID
1871: 		post.BusinessPrivilegesSHA256 = currentBusiness.PrivilegesSHA256
1872: 		post.BusinessProcessPID = currentBusiness.ProcessID
1873: 		post.BusinessProcessCreatedUTC = currentBusiness.ProcessCreated
1874: 		post.BusinessProcessImageSHA256 = currentBusiness.ProcessImageSHA
1875: 		post.FullRestartEvidenceSHA256, e = readFullRestartEvidence(p, r.Pre, post.UTC)
1876: 		if e != nil {
1877: 			return "", e
1878: 		}
1879: 		if e = ValidateRestart(r.Pre, post); e != nil {
1880: 			return "", e
1881: 		}
1882: 		if e = writeExclusiveJSON(filepath.Join(dir, "post.json"), post); e != nil {
1883: 			return "", e
1884: 		}
1885: 		if e = appendEvent(p, r.Events, "BOOT_OBSERVED"); e != nil {
1886: 			return "", e
1887: 		}
1888: 		return "BOOT_OBSERVED", nil
1889: 	case "disarm-request":
1890: 		if state == "PREPARED" || state == "APPLYING" || state == "ARMED" || state == "BOOT_OBSERVED" {
1891: 			// The only abort path is a proven pre-BEGIN path under the same
1892: 			// exclusive root lock used by C. Any journal, even malformed or
1893: 			// terminal, requires exact C recovery rather than a no-effect claim.
1894: 			lease, leaseErr := rt.AcquireDataRootLease(p.DataRoot.Path)
1895: 			if leaseErr != nil {
1896: 				return "", leaseErr
1897: 			}
1898: 			defer func() { errOut = errors.Join(errOut, lease.Close()) }()
1899: 			ownJournal := filepath.Join(p.DataRoot.Path, "host", qualificationmaintenancejournal.QualificationNamespace, p.OperationID)
1900: 			if _, statErr := os.Lstat(ownJournal); statErr == nil {
1901: 				return "", errors.New("C journal exists; pre-BEGIN abort forbidden")
1902: 			} else if !errors.Is(statErr, os.ErrNotExist) {
1903: 				return "", statErr
1904: 			}
1905: 			if e = qualificationmaintenancejournal.CheckOrdinary(p.DataRoot.Path); e != nil {
1906: 				return "", e
1907: 			}
1908: 			if e = appendEvent(p, r.Events, "BOUNDARY_ABORTED"); e != nil {
1909: 				return "", e
1910: 			}
1911: 			r, e = readRecord(p)
1912: 			if e != nil {
1913: 				return "", e
1914: 			}
1915: 			state = "BOUNDARY_ABORTED"
1916: 		}
1917: 		if state != "C_DURABLE" && state != "BOUNDARY_ABORTED" && state != "DISARMING" {
1918: 			return "", errors.New("disarm requires durable C or explicit boundary abort")
1919: 		}
1920: 		if state == "C_DURABLE" {
1921: 			if e = checkExactCDurable(p); e != nil {
1922: 				return "", e
1923: 			}
1924: 		}
1925: 		if state == "DISARMING" {
1926: 			// A resumable partial restore is only legal if the earlier event
1927: 			// records a durable C or explicit, non-success abort.
1928: 			if len(r.Events) < 2 || (r.Events[len(r.Events)-2].State != "C_DURABLE" && r.Events[len(r.Events)-2].State != "BOUNDARY_ABORTED") {
1929: 				return "", errors.New("disarm predecessor invalid")
1930: 			}
1931: 			if r.Events[len(r.Events)-2].State == "C_DURABLE" {
1932: 				if e = checkExactCDurable(p); e != nil {
1933: 					return "", e
1934: 				}
1935: 			}
1936: 		}
1937: 		holds, e := openPlanHolds(p)
1938: 		if e != nil {
1939: 			return "", e
1940: 		}
1941: 		defer func() { errOut = errors.Join(errOut, closeHolds(holds)) }()
1942: 		if e = checkAncestorControl(p, holds); e != nil {
1943: 			return "", e
1944: 		}
1945: 		byPath := map[string]FileIdentity{}
1946: 		for _, h := range holds {
1947: 			byPath[strings.ToLower(h.path)] = h.identity
1948: 		}
1949: 		for _, t := range p.Targets {
1950: 			x := byPath[strings.ToLower(t.File.Path)]
1951: 			if !identityCoreEqual(x, t.File) || (x.SecurityDescriptor != t.File.SecurityDescriptor && x.SecurityDescriptor != t.InstalledSD) {
1952: 				return "", errors.New("disarm target differs from exact before/installed descriptor")
1953: 			}
1954: 		}
1955: 		if state != "DISARMING" {
1956: 			if e = appendEvent(p, r.Events, "DISARMING"); e != nil {
1957: 				return "", e
1958: 			}
1959: 		}
1960: 		for _, t := range p.Targets {
1961: 			x := byPath[strings.ToLower(t.File.Path)]
1962: 			if x.SecurityDescriptor == t.File.SecurityDescriptor {
1963: 				continue
1964: 			}
1965: 			expected := t.File
1966: 			expected.SecurityDescriptor = t.InstalledSD
1967: 			if e = setTargetDescriptor(expected, t.File.SecurityDescriptor); e != nil {
1968: 				return "", e
1969: 			}
1970: 			h, e := openNative(t.File.Path, false, true)
1971: 			if e != nil {
1972: 				return "", e
1973: 			}
1974: 			ok := identityEqual(t.File, h.identity)
1975: 			closeErr := windows.CloseHandle(h.handle)
1976: 			if closeErr != nil {
1977: 				return "", closeErr
1978: 			}
1979: 			if !ok {
1980: 				return "", errors.New("disarm exact descriptor readback mismatch")
1981: 			}
1982: 		}
1983: 		r, e = readRecord(p)
1984: 		if e != nil {
1985: 			return "", e
1986: 		}
1987: 		if e = appendEvent(p, r.Events, "CLOSED"); e != nil {
1988: 			return "", e
1989: 		}
1990: 		return "CLOSED", nil
1991: 	}
1992: 	return "", errors.New("unreachable boundary phase")
1993: }
1994: 
1995: func checkExactCDurable(p EntryFencePlan) error {
1996: 	path := filepath.Join(p.DataRoot.Path, "host", qualificationmaintenancejournal.QualificationNamespace, p.OperationID, "plan.json")
1997: 	raw, e := os.ReadFile(path)
1998: 	if e != nil || len(raw) > 256<<10 {
1999: 		return errors.New("C journal plan unavailable")
2000: 	}
2001: 	var view struct {
2002: 		PlanHash string `json:"plan_hash"`
2003: 	}
2004: 	if e = json.Unmarshal(raw, &view); e != nil {
2005: 		return e
2006: 	}
2007: 	_, status, e := qualificationmaintenancejournal.OpenOwnInspection(p.DataRoot.Path, qualificationmaintenancejournal.QualificationNamespace, p.OperationID, view.PlanHash)
2008: 	if e != nil {
2009: 		return e
2010: 	}
2011: 	if status.State != "DURABLE" || !status.Terminal || !status.Applied {
2012: 		return errors.New("exact C operation not durable")
2013: 	}
2014: 	return qualificationmaintenancejournal.CheckOrdinary(p.DataRoot.Path)
2015: }
