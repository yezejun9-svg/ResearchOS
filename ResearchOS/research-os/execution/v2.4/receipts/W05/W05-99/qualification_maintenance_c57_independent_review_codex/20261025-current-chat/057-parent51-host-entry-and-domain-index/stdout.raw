FILE internal/store/qualification_maintenance_windows.go
1: //go:build windows
2: 
3: package store
4: 
5: import (
6: 	"context"
7: 	"crypto/sha256"
8: 	"database/sql"
9: 	"encoding/hex"
10: 	"errors"
11: 	"fmt"
12: 	"net/url"
13: 	"os"
14: 	"path/filepath"
15: 	"sort"
16: 	"strings"
17: 	"time"
18: )
19: 
20: // OpenQualificationMaintenance opens an existing schema-24 database. It never
21: // creates a file, runs migrations, or changes persistent journal settings.
22: // The caller must already hold the root's native lease and identity guards.
23: func OpenQualificationMaintenance(ctx context.Context, path string) (_ *sql.DB, err error) {
24: 	if !filepath.IsAbs(path) || filepath.Clean(path) != path || filepath.Base(path) != "researchos.sqlite" ||
25: 		strings.Contains(path[len(filepath.VolumeName(path)):], ":") {
26: 		return nil, errors.New("qualification maintenance database path invalid")
27: 	}
28: 	info, err := os.Lstat(path)
29: 	if err != nil || !info.Mode().IsRegular() {
30: 		return nil, errors.New("qualification maintenance database absent or nonregular")
31: 	}
32: 	real, err := filepath.EvalSymlinks(path)
33: 	if err != nil || !strings.EqualFold(filepath.Clean(real), path) {
34: 		return nil, errors.New("qualification maintenance database alias")
35: 	}
36: 	u := url.URL{Scheme: "file", Opaque: filepath.ToSlash(path)}
37: 	q := u.Query()
38: 	q.Set("mode", "rw")
39: 	q.Set("_foreign_keys", "1")
40: 	q.Set("_synchronous", "FULL")
41: 	q.Set("_busy_timeout", "5000")
42: 	u.RawQuery = q.Encode()
43: 	db, err := sql.Open("sqlite", u.String())
44: 	if err != nil {
45: 		return nil, err
46: 	}
47: 	db.SetMaxOpenConns(1)
48: 	db.SetMaxIdleConns(1)
49: 	defer func() {
50: 		if err != nil {
51: 			_ = db.Close()
52: 		}
53: 	}()
54: 	if err = db.PingContext(ctx); err != nil {
55: 		return nil, err
56: 	}
57: 	for pragma, want := range map[string]string{"foreign_keys": "1", "journal_mode": "wal", "synchronous": "2", "busy_timeout": "5000"} {
58: 		var got string
59: 		if err = db.QueryRowContext(ctx, "PRAGMA "+pragma).Scan(&got); err != nil || got != want {
60: 			return nil, fmt.Errorf("qualification maintenance %s=%s, want %s: %w", pragma, got, want, err)
61: 		}
62: 	}
63: 	var maximum, minimum, count, applicationTables int
64: 	if err = db.QueryRowContext(ctx, `SELECT max(version),min(version),count(DISTINCT version) FROM schema_migrations`).Scan(&maximum, &minimum, &count); err != nil {
65: 		return nil, err
66: 	}
67: 	if maximum != 24 || minimum != 1 || count != 24 {
68: 		return nil, errors.New("qualification maintenance requires exact schema 24 history")
69: 	}
70: 	if err = db.QueryRowContext(ctx, `SELECT count(*) FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%'`).Scan(&applicationTables); err != nil {
71: 		return nil, err
72: 	}
73: 	if applicationTables != 87 {
74: 		return nil, fmt.Errorf("qualification maintenance requires 87 application tables, got %d", applicationTables)
75: 	}
76: 	verifyCtx, cancel := context.WithTimeout(ctx, 30*time.Second)
77: 	defer cancel()
78: 	var integrity string
79: 	if err = db.QueryRowContext(verifyCtx, "PRAGMA quick_check").Scan(&integrity); err != nil || integrity != "ok" {
80: 		return nil, fmt.Errorf("qualification maintenance quick_check=%s: %w", integrity, err)
81: 	}
82: 	return db, nil
83: }
84: 
85: // QualificationMaintenanceCensus uses the transaction's own connection so
86: // the frozen before image and write reservation refer to the same snapshot.
87: func QualificationMaintenanceCensus(ctx context.Context, tx *sql.Tx) (OwnedStopCensus, error) {
88: 	if tx == nil {
89: 		return OwnedStopCensus{}, errors.New("qualification maintenance transaction required")
90: 	}
91: 	return ownedStopCensus(ctx, tx)
92: }
93: 
94: // QualificationMaintenanceProtectedCensus binds every row of the 78 tables
95: // outside the one transaction's nine-table write allowlist. Row cells use the
96: // same typed, length-delimited framing as the full database census.
97: func QualificationMaintenanceProtectedCensus(ctx context.Context, tx *sql.Tx) (string, error) {
98: 	if tx == nil {
99: 		return "", errors.New("qualification protected census transaction required")
100: 	}
101: 	allowed := map[string]bool{
102: 		"uploaded_content": true, "domain_versions": true, "domain_objects": true,
103: 		"domain_refs": true, "runtime_observations": true, "runtime_dispatches": true,
104: 		"outbox": true, "event_state_snapshots": true, "idempotency": true,
