  993: // Windows may legitimately hard-link its own Explorer image. Read identity
  994: // from one held native handle without applying the product target's hard-link
  995: // ban to this OS image.
  996: func osProcessImageIdentity(path string) (string, error) {
  997: 	ptr, err := windows.UTF16PtrFromString(path)
  998: 	if err != nil {
  999: 		return "", err
 1000: 	}
 1001: 	h, err := windows.CreateFile(ptr, windows.FILE_READ_DATA|windows.FILE_READ_ATTRIBUTES,
 1002: 		windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, nil, windows.OPEN_EXISTING,
 1003: 		windows.FILE_FLAG_OPEN_REPARSE_POINT, 0)
 1004: 	if err != nil {
 1005: 		return "", err
 1006: 	}
 1007: 	defer windows.CloseHandle(h)
 1008: 	var info windows.ByHandleFileInformation
 1009: 	if err = windows.GetFileInformationByHandle(h, &info); err != nil {
 1010: 		return "", err
 1011: 	}
 1012: 	if info.FileAttributes&(windows.FILE_ATTRIBUTE_DIRECTORY|windows.FILE_ATTRIBUTE_REPARSE_POINT) != 0 {
 1013: 		return "", errors.New("OS process image is directory or reparse point")
 1014: 	}
 1015: 	volume, fileID, err := nativeFileID(h)
 1016: 	if err != nil {
 1017: 		return "", err
 1018: 	}
 1019: 	final, err := finalPath(h)
 1020: 	if err != nil {
 1021: 		return "", err
 1022: 	}
 1023: 	sum := sha256.New()
 1024: 	buf := make([]byte, 64<<10)
 1025: 	var total int64
 1026: 	for {
 1027: 		var n uint32
 1028: 		if err = windows.ReadFile(h, buf, &n, nil); err != nil {
 1029: 			return "", err
 1030: 		}
 1031: 		if n == 0 {
 1032: 			break
 1033: 		}
 1034: 		total += int64(n)
 1035: 		if total > 128<<20 {
 1036: 			return "", errors.New("OS process image exceeds hash bound")
 1037: 		}
 1038: 		_, _ = sum.Write(buf[:n])
 1039: 	}
 1040: 	return digest([]byte(fmt.Sprintf("%s|%d|%s|%x", strings.ToLower(final), volume, fileID, sum.Sum(nil)))), nil
 1041: }
