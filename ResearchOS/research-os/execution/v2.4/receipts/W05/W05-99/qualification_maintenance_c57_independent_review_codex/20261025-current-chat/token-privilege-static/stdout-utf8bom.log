   66: func nativeSecurityDescriptor(h windows.Handle, includeSACL bool) ([]byte, string, string, error) {
   67: 	if err := ntQuerySecurityObject.Find(); err != nil {
   68: 		return nil, "", "", err
   69: 	}
   70: 	raw := make([]byte, 64<<10)
   71: 	var needed uint32
   72: 	flags := windows.OWNER_SECURITY_INFORMATION | windows.GROUP_SECURITY_INFORMATION | windows.DACL_SECURITY_INFORMATION
   73: 	if includeSACL {
   74: 		flags |= windows.SACL_SECURITY_INFORMATION
   75: 	}
   76: 	status, _, _ := ntQuerySecurityObject.Call(uintptr(h), uintptr(flags), uintptr(unsafe.Pointer(&raw[0])), uintptr(len(raw)), uintptr(unsafe.Pointer(&needed)))
   77: 	if result := windows.NTStatus(status); result != 0 || needed < 20 || needed > uint32(len(raw)) {
   78: 		if result != 0 {
   79: 			return nil, "", "", &nativeSecurityQueryError{status: result, needed: needed}
   80: 		}
   81: 		return nil, "", "", errors.New("NtQuerySecurityObject length invalid")
   82: 	}
   83: 	raw = raw[:needed]
   84: 	semantic, err := nativeSecuritySemanticSHA256(raw)
   85: 	if err != nil {
   86: 		return nil, "", "", err
   87: 	}
   88: 	sd := (*windows.SECURITY_DESCRIPTOR)(unsafe.Pointer(&raw[0]))
   89: 	if !sd.IsValid() {
   90: 		return nil, "", "", errors.New("native security descriptor invalid")
   91: 	}
   92: 	sddl := sd.String()
   93: 	runtime.KeepAlive(raw)
   94: 	return raw, sddl, semantic, nil
   95: }
   96: 
   97: func nativeSecurityFromSDDL(sddl string) ([]byte, string, error) {
   98: 	sd, err := windows.SecurityDescriptorFromString(sddl)
   99: 	if err != nil {
  100: 		return nil, "", err
  101: 	}
  102: 	raw := append([]byte(nil), unsafe.Slice((*byte)(unsafe.Pointer(sd)), sd.Length())...)
  103: 	semantic, err := nativeSecuritySemanticSHA256(raw)
  104: 	runtime.KeepAlive(sd)
  105: 	return raw, semantic, err
  106: }
