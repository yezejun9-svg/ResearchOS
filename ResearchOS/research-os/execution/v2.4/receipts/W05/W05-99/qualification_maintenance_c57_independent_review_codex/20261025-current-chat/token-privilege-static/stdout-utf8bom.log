 1208: func ownerAssignableWithoutRestore(token windows.Token, owner *windows.SID) (bool, error) {
 1209: 	user, err := token.GetTokenUser()
 1210: 	if err != nil {
 1211: 		return false, err
 1212: 	}
 1213: 	if user.User.Sid.Equals(owner) {
 1214: 		return true, nil
 1215: 	}
 1216: 	groups, err := token.GetTokenGroups()
 1217: 	if err != nil {
 1218: 		return false, err
 1219: 	}
 1220: 	for _, group := range groups.AllGroups() {
 1221: 		if group.Sid.Equals(owner) && group.Attributes&windows.SE_GROUP_OWNER != 0 && group.Attributes&windows.SE_GROUP_ENABLED != 0 && group.Attributes&windows.SE_GROUP_USE_FOR_DENY_ONLY == 0 {
 1222: 			return true, nil
 1223: 		}
 1224: 	}
 1225: 	return false, nil
 1226: }
 1227: 
 1228: // NtSetSecurityObject can restore a foreign original owner only while the actual
 1229: // mutation process token has SeRestorePrivilege enabled. A WRITE_OWNER handle
 1230: // alone proves only that it can assign an eligible owner.
 1231: func ensureOwnerRestorable(managementSID string, originalOwner *windows.SID) error {
 1232: 	var token windows.Token
 1233: 	if err := windows.OpenProcessToken(windows.CurrentProcess(), windows.TOKEN_QUERY|windows.TOKEN_ADJUST_PRIVILEGES, &token); err != nil {
 1234: 		return err
 1235: 	}
 1236: 	defer token.Close()
 1237: 	user, err := token.GetTokenUser()
 1238: 	if err != nil || user.User.Sid.String() != managementSID {
 1239: 		return errors.New("owner restore token is not frozen management SID")
 1240: 	}
 1241: 	eligible, err := ownerAssignableWithoutRestore(token, originalOwner)
 1242: 	if err != nil || eligible {
 1243: 		return err
 1244: 	}
 1245: 	name, err := windows.UTF16PtrFromString("SeRestorePrivilege")
 1246: 	if err != nil {
 1247: 		return err
 1248: 	}
 1249: 	var luid windows.LUID
 1250: 	if err = windows.LookupPrivilegeValue(nil, name, &luid); err != nil {
 1251: 		return err
 1252: 	}
 1253: 	privilegePresent := func() (bool, bool, error) {
 1254: 		raw, err := tokenInfoBytes(token, windows.TokenPrivileges)
 1255: 		if err != nil || len(raw) < 4 {
 1256: 			return false, false, errors.Join(err, errors.New("restore privilege inventory unavailable"))
 1257: 		}
 1258: 		for _, privilege := range (*windows.Tokenprivileges)(unsafe.Pointer(&raw[0])).AllPrivileges() {
 1259: 			if privilege.Luid == luid {
 1260: 				return true, privilege.Attributes&windows.SE_PRIVILEGE_ENABLED != 0, nil
 1261: 			}
 1262: 		}
 1263: 		return false, false, nil
 1264: 	}
 1265: 	present, enabled, err := privilegePresent()
 1266: 	if err != nil {
 1267: 		return err
 1268: 	}
 1269: 	if !present {
 1270: 		return errors.New("SeRestorePrivilege not assigned to management token")
 1271: 	}
 1272: 	if !enabled {
 1273: 		state := windows.Tokenprivileges{PrivilegeCount: 1, Privileges: [1]windows.LUIDAndAttributes{{Luid: luid, Attributes: windows.SE_PRIVILEGE_ENABLED}}}
 1274: 		if err = windows.AdjustTokenPrivileges(token, false, &state, 0, nil, nil); err != nil {
 1275: 			return fmt.Errorf("enable SeRestorePrivilege: %w", err)
 1276: 		}
 1277: 		_, enabled, err = privilegePresent()
 1278: 		if err != nil {
 1279: 			return err
 1280: 		}
 1281: 	}
 1282: 	if !enabled {
 1283: 		return errors.New("SeRestorePrivilege absent after enable readback")
 1284: 	}
 1285: 	return nil
 1286: }
