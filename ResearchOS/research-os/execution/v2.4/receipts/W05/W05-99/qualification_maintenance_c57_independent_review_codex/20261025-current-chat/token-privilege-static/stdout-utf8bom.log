 1173: func preflightManagementRestore(p EntryFencePlan) error {
 1174: 	for _, t := range p.Targets {
 1175: 		original, e := windows.SecurityDescriptorFromString(t.File.SecurityDescriptor)
 1176: 		if e != nil {
 1177: 			return e
 1178: 		}
 1179: 		owner, _, e := original.Owner()
 1180: 		if e != nil || owner == nil {
 1181: 			return errors.New("original target owner unavailable for restore preflight")
 1182: 		}
 1183: 		access := uint32(windows.WRITE_DAC)
 1184: 		if owner.String() != p.ManagementSID {
 1185: 			access |= windows.WRITE_OWNER
 1186: 		}
 1187: 		h, e := openNativeAccess(t.File.Path, false, true, access)
 1188: 		if e != nil {
 1189: 			return fmt.Errorf("management cannot open target for reversible ACL operation: %w", e)
 1190: 		}
 1191: 		matched := identityEqual(h.identity, t.File)
 1192: 		closeErr := windows.CloseHandle(h.handle)
 1193: 		if closeErr != nil {
 1194: 			return closeErr
 1195: 		}
 1196: 		if !matched {
 1197: 			return errors.New("management ACL preflight target identity drift")
 1198: 		}
 1199: 		if owner.String() != p.ManagementSID {
 1200: 			if e = ensureOwnerRestorable(p.ManagementSID, owner); e != nil {
 1201: 				return fmt.Errorf("management cannot restore original owner before APPLYING: %w", e)
 1202: 			}
 1203: 		}
 1204: 	}
 1205: 	return nil
 1206: }
