  126: 
  127: func digest(raw []byte) string { h := sha256.Sum256(raw); return hex.EncodeToString(h[:]) }
  128: 
  129: // nativeSecuritySemanticSHA256 binds the meaningful queried descriptor fields
  130: // without treating self-relative offsets or trailing ACL padding as rights.
  131: // It includes the exact control bits, SID bytes, ACL revision, and every
  132: // ordered ACE byte (including inherited flags). A readable SACL is included;
  133: // an unavailable SACL is recorded separately and never set.
  134: func nativeSecuritySemanticSHA256(raw []byte) (string, error) {
  135: 	if len(raw) < 20 || len(raw) > 64<<10 || raw[0] != 1 {
  136: 		return "", errors.New("native security descriptor length or revision invalid")
  137: 	}
  138: 	control := binary.LittleEndian.Uint16(raw[2:4])
  139: 	if control&0x8000 == 0 || control&0x0004 == 0 {
  140: 		return "", errors.New("native descriptor self-relative or DACL control invalid")
  141: 	}
  142: 	component := func(offset uint32, sid bool) ([]byte, error) {
  143: 		if offset == 0 || uint64(offset) >= uint64(len(raw)) {
  144: 			return nil, errors.New("native security component offset invalid")
  145: 		}
  146: 		at := int(offset)
  147: 		if sid {
  148: 			if len(raw)-at < 8 || raw[at] != 1 {
  149: 				return nil, errors.New("native SID header invalid")
  150: 			}
  151: 			n := 8 + int(raw[at+1])*4
  152: 			if n > len(raw)-at {
  153: 				return nil, errors.New("native SID length invalid")
  154: 			}
  155: 			return raw[at : at+n], nil
  156: 		}
  157: 		if len(raw)-at < 8 {
  158: 			return nil, errors.New("native ACL header invalid")
  159: 		}
  160: 		size := int(binary.LittleEndian.Uint16(raw[at+2 : at+4]))
  161: 		if size < 8 || size > len(raw)-at {
  162: 			return nil, errors.New("native ACL size invalid")
  163: 		}
  164: 		return raw[at : at+size], nil
  165: 	}
  166: 	owner, err := component(binary.LittleEndian.Uint32(raw[4:8]), true)
  167: 	if err != nil {
  168: 		return "", err
  169: 	}
  170: 	group, err := component(binary.LittleEndian.Uint32(raw[8:12]), true)
  171: 	if err != nil {
  172: 		return "", err
  173: 	}
  174: 	acl, err := component(binary.LittleEndian.Uint32(raw[16:20]), false)
  175: 	if err != nil {
  176: 		return "", err
  177: 	}
  178: 	var sacl []byte
  179: 	if offset := binary.LittleEndian.Uint32(raw[12:16]); offset != 0 {
  180: 		sacl, err = component(offset, false)
  181: 		if err != nil {
  182: 			return "", err
  183: 		}
  184: 	}
  185: 	canonical := append([]byte(nil), raw[0], byte(control), byte(control>>8))
  186: 	if control&0x4000 != 0 { // SE_RM_CONTROL_VALID makes Sbz1 meaningful.
  187: 		canonical = append(canonical, raw[1])
  188: 	}
  189: 	for _, part := range [][]byte{owner, group} {
  190: 		canonical = append(canonical, byte(len(part)), byte(len(part)>>8))
  191: 		canonical = append(canonical, part...)
  192: 	}
  193: 	for _, oneACL := range [][]byte{acl, sacl} {
  194: 		if oneACL == nil {
  195: 			canonical = append(canonical, 0)
  196: 			continue
  197: 		}
  198: 		oneCount := int(binary.LittleEndian.Uint16(oneACL[4:6]))
  199: 		canonical = append(canonical, 1, oneACL[0], byte(oneCount), byte(oneCount>>8))
  200: 		at := 8
  201: 		for i := 0; i < oneCount; i++ {
  202: 			if len(oneACL)-at < 4 {
  203: 				return "", errors.New("native ACE header truncated")
  204: 			}
  205: 			size := int(binary.LittleEndian.Uint16(oneACL[at+2 : at+4]))
  206: 			if size < 4 || size > len(oneACL)-at {
  207: 				return "", errors.New("native ACE size invalid")
  208: 			}
  209: 			canonical = append(canonical, oneACL[at:at+size]...)
  210: 			at += size
  211: 		}
  212: 	}
  213: 	return digest(canonical), nil
  214: }
  215: 
  216: func validSACLReadState(file FileIdentity) bool {
  217: 	return file.SACLReadStatus == "READABLE" && file.SACLUnavailableStage == "" && file.SACLUnavailableWin32 == 0 && file.SACLUnavailableNTSTATUS == 0 ||
  218: 		file.SACLReadStatus == "UNAVAILABLE" && file.SACLUnavailableWin32 != 0 && (file.SACLUnavailableStage == "OPEN" && file.SACLUnavailableNTSTATUS == 0 || file.SACLUnavailableStage == "QUERY" && file.SACLUnavailableNTSTATUS != 0) && len(file.NativeSecurityDescriptor) >= 20 && binary.LittleEndian.Uint32(file.NativeSecurityDescriptor[12:16]) == 0
  219: }
  220: func validDigest(s string) bool {
  221: 	if len(s) != 64 {
  222: 		return false
  223: 	}
  224: 	_, e := hex.DecodeString(s)
  225: 	return e == nil && s == strings.ToLower(s)
  226: }
  227: func validOperation(s string) bool {
  228: 	if len(s) != 32 || s != strings.ToLower(s) {
  229: 		return false
  230: 	}
  231: 	for _, c := range s {
  232: 		if !(c >= 'a' && c <= 'f' || c >= '0' && c <= '9') {
  233: 			return false
  234: 		}
  235: 	}
  236: 	return true
  237: }
  238: 
  239: func PlanCoreSHA256(p EntryFencePlan) (string, error) {
  240: 	p.PlanSHA256 = ""
  241: 	p.SourceAcceptanceSHA256 = ""
  242: 	p.NativeAcceptanceSHA256 = ""
  243: 	p.BackupManifestSHA256 = ""
  244: 	p.RecoveryPackageSHA256 = ""
  245: 	raw, e := json.Marshal(p)
  246: 	if e != nil {
  247: 		return "", e
  248: 	}
  249: 	return digest(raw), nil
  250: }
  251: 
  252: func ComputePlanSHA256(p EntryFencePlan) (string, error) {
  253: 	p.PlanSHA256 = ""
  254: 	raw, e := json.Marshal(p)
  255: 	if e != nil {
  256: 		return "", e
  257: 	}
  258: 	return digest(raw), nil
  259: }
  260: 
  261: func ValidatePlan(p EntryFencePlan) error {
  262: 	expected, err := ComputePlanSHA256(p)
  263: 	if err != nil || p.PlanSHA256 != expected {
  264: 		return errors.New("boundary plan canonical digest mismatch")
  265: 	}
  266: 	if p.Schema != PlanSchema || !validOperation(p.OperationID) || !validDigest(p.PlanSHA256) ||
  267: 		!validDigest(p.HostIdentitySHA256) || !validDigest(p.SubjectSHA256) ||
  268: 		!validDigest(p.EvidenceSHA256) || !validDigest(p.BackupManifestSHA256) ||
  269: 		!validDigest(p.SourceAcceptanceSHA256) || !validDigest(p.NativeAcceptanceSHA256) ||
  270: 		!validDigest(p.RecoveryPackageSHA256) || p.BusinessSID == "" || p.ManagementSID == "" ||
  271: 		strings.EqualFold(p.BusinessSID, p.ManagementSID) || len(p.Targets) == 0 || len(p.Targets) > 64 {
  272: 		return errors.New("recovery boundary plan incomplete")
  273: 	}
  274: 	if p.DataRoot.Path == "" || p.Database.Path != filepath.Join(p.DataRoot.Path, "researchos.sqlite") || p.Helper.Path == "" {
  275: 		return errors.New("recovery boundary root, database or helper mismatch")
  276: 	}
  277: 	for _, file := range []FileIdentity{p.DataRoot, p.Database, p.Helper} {
  278: 		semantic, semanticErr := nativeSecuritySemanticSHA256(file.NativeSecurityDescriptor)
  279: 		if semanticErr != nil || semantic != file.NativeSecuritySHA256 || !validSACLReadState(file) {
  280: 			return errors.New("boundary core file native security preimage invalid")
  281: 		}
  282: 	}
  283: 	if len(p.BusinessGroupSIDs) == 0 || len(p.BusinessGroupSIDs) > 64 {
  284: 		return errors.New("business enabled group inventory missing")
  285: 	}
  286: 	seen := map[string]bool{}
  287: 	if len(p.Ancestors) == 0 || len(p.Ancestors) > 256 {
  288: 		return errors.New("boundary ancestor inventory missing")
  289: 	}
  290: 	for _, a := range p.Ancestors {
  291: 		if !a.Directory || a.FileID == "" || a.FinalUTF16 == "" || a.SecurityDescriptor == "" || len(a.NativeSecurityDescriptor) < 20 || len(a.NativeSecurityDescriptor) > 64<<10 || !validDigest(a.NativeSecuritySHA256) || seen[strings.ToLower(a.Path)] {
  292: 			return errors.New("boundary ancestor identity invalid")
  293: 		}
  294: 		semantic, semanticErr := nativeSecuritySemanticSHA256(a.NativeSecurityDescriptor)
  295: 		if semanticErr != nil || semantic != a.NativeSecuritySHA256 || !validSACLReadState(a) {
  296: 			return errors.New("boundary ancestor native security preimage invalid")
  297: 		}
  298: 		seen[strings.ToLower(a.Path)] = true
  299: 	}
  300: 	for _, t := range p.Targets {
  301: 		if t.Mode != "executable" && t.Mode != "script" {
  302: 			return errors.New("unknown fence target mode")
  303: 		}
  304: 		if !filepath.IsAbs(t.File.Path) || filepath.Clean(t.File.Path) != t.File.Path || seen[strings.ToLower(t.File.Path)] || t.File.Directory {
  305: 			return errors.New("fence inventory path invalid")
  306: 		}
  307: 		if len(t.File.NativeSecurityDescriptor) < 20 || len(t.File.NativeSecurityDescriptor) > 64<<10 || !validDigest(t.File.NativeSecuritySHA256) || !validDigest(t.InstalledNativeSecuritySHA256) {
  308: 			return errors.New("fence target native security preimage or installed digest missing")
  309: 		}
  310: 		semantic, semanticErr := nativeSecuritySemanticSHA256(t.File.NativeSecurityDescriptor)
  311: 		if semanticErr != nil || semantic != t.File.NativeSecuritySHA256 || !validSACLReadState(t.File) {
  312: 			return errors.New("fence target native security preimage invalid")
  313: 		}
  314: 		seen[strings.ToLower(t.File.Path)] = true
  315: 		if len(t.RestartArgsSHA256) > 16 {
  316: 			return errors.New("restart argv inventory unbounded")
  317: 		}
  318: 		for _, sha := range t.RestartArgsSHA256 {
  319: 			if !validDigest(sha) {
  320: 				return errors.New("restart argv digest invalid")
  321: 			}
  322: 		}
  323: 	}
  324: 	return nil
  325: }
  326: 
  327: func ValidateRestart(pre, post BootWitness) error {
  328: 	if pre.Schema != WitnessSchema || post.Schema != WitnessSchema || pre.OperationID != post.OperationID || pre.PlanSHA256 != post.PlanSHA256 || pre.HelperSHA256 != post.HelperSHA256 || pre.FenceSHA256 != post.FenceSHA256 || !validDigest(pre.PlanSHA256) || !validDigest(pre.FenceSHA256) || !validDigest(pre.HelperSHA256) {
  329: 		return errors.New("witness binding changed")
  330: 	}
  331: 	if pre.UptimeMilliseconds < uint64(MaxPostUptime/time.Millisecond) || post.UptimeMilliseconds >= uint64(MaxPostUptime/time.Millisecond) || post.UptimeMilliseconds >= pre.UptimeMilliseconds {
  332: 		return errors.New("uptime does not prove fresh restart")
  333: 	}
  334: 	if pre.LastBootUTC.IsZero() || post.LastBootUTC.IsZero() || !post.LastBootUTC.After(pre.LastBootUTC) {
  335: 		return errors.New("boot time did not advance")
  336: 	}
  337: 	if pre.UTC.IsZero() || post.UTC.IsZero() || post.UTC.Before(pre.UTC) || post.UTC.Sub(pre.UTC) > MaxElapsed {
  338: 		return errors.New("witness outside bounded UTC window")
  339: 	}
  340: 	if post.LastBootUTC.Before(pre.UTC.Add(-2*time.Minute)) || post.LastBootUTC.After(post.UTC) {
  341: 		return errors.New("boot time contradicts witness UTC")
  342: 	}
  343: 	for _, w := range []BootWitness{pre, post} {
  344: 		expected := w.UTC.Add(-time.Duration(w.UptimeMilliseconds) * time.Millisecond)
  345: 		if w.LastBootUTC.Before(expected.Add(-2*time.Minute)) || w.LastBootUTC.After(expected.Add(2*time.Minute)) {
  346: 			return errors.New("native uptime and boot time disagree")
  347: 		}
  348: 	}
  349: 	if pre.RestartApps > 1 || post.RestartApps > 1 || pre.RestartApps != post.RestartApps {
  350: 		return errors.New("RestartApps state unknown")
  351: 	}
  352: 	if pre.FullRestartEvidenceSHA256 != "" || !validDigest(post.FullRestartEvidenceSHA256) {
  353: 		return errors.New("explicit FullRestart evidence missing")
  354: 	}
  355: 	if !validDigest(pre.BusinessEnabledSIDsSHA256) || pre.BusinessEnabledSIDsSHA256 != post.BusinessEnabledSIDsSHA256 ||
  356: 		!validDigest(pre.BusinessPrivilegesSHA256) || pre.BusinessPrivilegesSHA256 != post.BusinessPrivilegesSHA256 ||
  357: 		pre.BusinessElevationType < 1 || pre.BusinessElevationType > 3 || pre.BusinessElevationType != post.BusinessElevationType ||
  358: 		pre.BusinessIntegritySID == "" || pre.BusinessIntegritySID != post.BusinessIntegritySID ||
  359: 		pre.BusinessLogonSID == "" || post.BusinessLogonSID == "" {
  360: 		return errors.New("business token permission semantics changed across restart")
  361: 	}
  362: 	for _, w := range []BootWitness{pre, post} {
  363: 		if w.BusinessProcessPID == 0 || !validDigest(w.BusinessProcessImageSHA256) || w.BusinessProcessCreatedUTC.IsZero() ||
  364: 			w.BusinessProcessCreatedUTC.Before(w.LastBootUTC.Add(-2*time.Second)) || w.BusinessProcessCreatedUTC.After(w.UTC.Add(2*time.Second)) {
  365: 			return errors.New("business token source process identity invalid")
  366: 		}
  367: 	}
  368: 	return nil
  369: }
  370: 
  371: func transition(from, to string) bool {
  372: 	switch from {
  373: 	case "":
  374: 		return to == "PREPARED"
  375: 	case "PREPARED":
  376: 		return to == "APPLYING" || to == "BOUNDARY_ABORTED"
  377: 	case "APPLYING":
  378: 		return to == "ARMED" || to == "BOUNDARY_ABORTED"
  379: 	case "ARMED":
  380: 		return to == "BOOT_OBSERVED" || to == "BOUNDARY_ABORTED"
  381: 	case "BOOT_OBSERVED":
  382: 		return to == "C_HELD" || to == "BOUNDARY_ABORTED"
  383: 	case "C_HELD":
  384: 		return to == "C_DURABLE" || to == "BOUNDARY_ABORTED"
  385: 	case "C_DURABLE", "BOUNDARY_ABORTED":
  386: 		return to == "DISARMING"
  387: 	case "DISARMING":
  388: 		return to == "CLOSED"
  389: 	}
  390: 	return false
  391: }
  392: 
  393: func ValidateEvents(events []BoundaryEvent, operation, plan string) error {
  394: 	if len(events) == 0 || len(events) > 16 {
  395: 		return errors.New("boundary event inventory invalid")
  396: 	}
  397: 	prevState, prevHash := "", ""
  398: 	for i, e := range events {
  399: 		if e.Schema != EventSchema || e.Sequence != uint64(i+1) || e.PreviousSHA256 != prevHash || e.OperationID != operation || e.PlanSHA256 != plan || !transition(prevState, e.State) || e.UTC.IsZero() {
  400: 			return fmt.Errorf("boundary event %d invalid", i+1)
  401: 		}
  402: 		copy := e
  403: 		copy.SHA256 = ""
  404: 		raw := []byte(fmt.Sprintf("%s\x00%d\x00%s\x00%s\x00%s\x00%s\x00%s", copy.Schema, copy.Sequence, copy.PreviousSHA256, copy.OperationID, copy.PlanSHA256, copy.State, copy.UTC.UTC().Format(time.RFC3339Nano)))
  405: 		if e.SHA256 != digest(raw) {
  406: 			return fmt.Errorf("boundary event %d hash drift", i+1)
  407: 		}
  408: 		prevState, prevHash = e.State, e.SHA256
  409: 	}
  410: 	return nil
  411: }
