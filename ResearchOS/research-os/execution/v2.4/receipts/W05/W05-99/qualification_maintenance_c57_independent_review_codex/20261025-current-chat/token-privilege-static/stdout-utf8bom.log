  367: func registryRestartApps(businessSID string) (uint32, error) {
  368: 	if _, e := windows.StringToSid(businessSID); e != nil {
  369: 		return 0, e
  370: 	}
  371: 	k, e := registry.OpenKey(registry.USERS, businessSID+`\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon`, registry.QUERY_VALUE)
  372: 	if e != nil {
  373: 		return 0, e
  374: 	}
  375: 	defer k.Close()
  376: 	v, _, e := k.GetIntegerValue("RestartApps")
  377: 	if e != nil || v > 1 {
  378: 		return 0, errors.New("RestartApps registry state unavailable")
  379: 	}
  380: 	return uint32(v), nil
  381: }
