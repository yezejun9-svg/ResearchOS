  389: func restartSettingsForProcess(h windows.Handle) (string, uint32, bool, error) {
  390: 	var size, flags uint32
  391: 	r, _, _ := getApplicationRestartSettings.Call(uintptr(h), 0, uintptr(unsafe.Pointer(&size)), uintptr(unsafe.Pointer(&flags)))
  392: 	if uint32(r) == 0x80070490 {
  393: 		return "", 0, false, nil
  394: 	} // HRESULT_FROM_WIN32(ERROR_NOT_FOUND)
  395: 	if uint32(r) != 0 || size == 0 || size > 1025 {
  396: 		return "", 0, false, fmt.Errorf("restart registration size/status invalid: %#x/%d", uint32(r), size)
  397: 	}
  398: 	buf := make([]uint16, size)
  399: 	r, _, _ = getApplicationRestartSettings.Call(uintptr(h), uintptr(unsafe.Pointer(&buf[0])), uintptr(unsafe.Pointer(&size)), uintptr(unsafe.Pointer(&flags)))
  400: 	if uint32(r) != 0 || size == 0 || size > uint32(len(buf)) || flags&^uint32(0xf) != 0 {
  401: 		return "", 0, false, fmt.Errorf("restart registration read/status invalid: %#x/%d/%#x", uint32(r), size, flags)
  402: 	}
  403: 	return windows.UTF16ToString(buf[:size]), flags, true, nil
  404: }
  405: 
  406: func bootClock() (uint64, time.Time, error) {
  407: 	u, _, e := getTick.Call()
  408: 	if e != windows.ERROR_SUCCESS && e != nil {
  409: 		return 0, time.Time{}, e
  410: 	}
  411: 	var x struct {
  412: 		BootTime          int64
  413: 		CurrentTime       int64
  414: 		TimeZoneBias      int64
  415: 		CurrentTimeZoneID uint32
  416: 		Reserved          uint32
  417: 		BootTimeBias      uint64
  418: 		SleepTimeBias     uint64
  419: 	}
  420: 	r, _, e := ntSystem.Call(3, uintptr(unsafe.Pointer(&x)), unsafe.Sizeof(x), 0)
  421: 	if r != 0 {
  422: 		return 0, time.Time{}, fmt.Errorf("NtQuerySystemInformation status %#x: %v", r, e)
  423: 	}
  424: 	if x.BootTime <= 0 {
  425: 		return 0, time.Time{}, errors.New("native boot time unavailable")
  426: 	}
  427: 	return uint64(u), time.Unix(0, (x.BootTime-116444736000000000)*100).UTC(), nil
  428: }
  429: 
  430: func witness(p EntryFencePlan, fenceHash string) (BootWitness, error) {
  431: 	u, b, e := bootClock()
  432: 	if e != nil {
  433: 		return BootWitness{}, e
  434: 	}
  435: 	r, e := registryRestartApps(p.BusinessSID)
  436: 	if e != nil {
  437: 		return BootWitness{}, e
  438: 	}
  439: 	return BootWitness{Schema: WitnessSchema, OperationID: p.OperationID, PlanSHA256: p.PlanSHA256, HelperSHA256: p.Helper.SHA256, UTC: time.Now().UTC(), UptimeMilliseconds: u, LastBootUTC: b, RestartApps: r, FenceSHA256: fenceHash}, nil
  440: }
  441: 
  442: func stateRoot(p EntryFencePlan) (string, error) {
  443: 	base := os.Getenv("ProgramData")
  444: 	if base == "" || !filepath.IsAbs(base) {
  445: 		return "", errors.New("ProgramData unavailable")
  446: 	}
  447: 	if !validOperation(p.OperationID) {
  448: 		return "", errors.New("operation invalid")
  449: 	}
  450: 	h := digest([]byte(strings.ToLower(p.DataRoot.FinalUTF16) + "\x00" + p.DataRoot.FileID))
  451: 	return filepath.Join(base, "ResearchOS", "RecoveryBoundary", h, p.OperationID), nil
  452: }
  453: 
  454: func readRecord(p EntryFencePlan) (boundaryRecord, error) {
  455: 	var r boundaryRecord
  456: 	dir, e := stateRoot(p)
  457: 	if e != nil {
  458: 		return r, e
  459: 	}
  460: 	// The operation directory and every record must be independently protected.
  461: 	if e = checkManagedChain(p); e != nil {
  462: 		return r, e
  463: 	}
  464: 	if e = checkAcceptanceFiles(p); e != nil {
  465: 		return r, e
  466: 	}
  467: 	entries, e := os.ReadDir(dir)
  468: 	if e != nil {
  469: 		return r, e
  470: 	}
  471: 	if len(entries) < 2 || len(entries) > 24 {
  472: 		return r, errors.New("boundary state inventory invalid")
  473: 	}
  474: 	for _, entry := range entries {
  475: 		if entry.IsDir() || (entry.Name() != "plan.json" && entry.Name() != "pre.json" && entry.Name() != "post.json" && entry.Name() != "full-restart-complete.json" && entry.Name() != "source-accepted.json" && entry.Name() != "native-accepted.json" && entry.Name() != "backup-verified.json" && entry.Name() != "recovery-ready.json" && !strings.HasPrefix(entry.Name(), "event-")) {
  476: 			return r, errors.New("unknown boundary state entry")
  477: 		}
  478: 	}
  479: 	raw, _, e := readManagedFile(filepath.Join(dir, "plan.json"), p.ManagementSID, maxBoundaryPlanBytes)
  480: 	if e != nil {
  481: 		return r, errors.New("boundary plan file unavailable")
  482: 	}
  483: 	if e = json.Unmarshal(raw, &r.Plan); e != nil {
  484: 		return r, e
  485: 	}
  486: 	if r.Plan.OperationID != p.OperationID || r.Plan.PlanSHA256 != p.PlanSHA256 {
  487: 		return r, errors.New("boundary record plan mismatch")
  488: 	}
  489: 	pre, _, e := readManagedFile(filepath.Join(dir, "pre.json"), p.ManagementSID, 16<<10)
  490: 	if e != nil {
  491: 		return r, errors.New("boundary pre witness unavailable")
  492: 	}
  493: 	if e = json.Unmarshal(pre, &r.Pre); e != nil {
  494: 		return r, e
  495: 	}
  496: 	post, _, e := readManagedFile(filepath.Join(dir, "post.json"), p.ManagementSID, 16<<10)
  497: 	if e == nil {
  498: 		if e = json.Unmarshal(post, &r.Post); e != nil {
  499: 			return r, e
  500: 		}
  501: 	} else if !errors.Is(e, os.ErrNotExist) {
  502: 		return r, e
  503: 	}
  504: 	for i := 1; i <= 16; i++ {
  505: 		name := fmt.Sprintf("event-%02d.json", i)
  506: 		raw, _, e := readManagedFile(filepath.Join(dir, name), p.ManagementSID, 16<<10)
  507: 		if errors.Is(e, os.ErrNotExist) {
  508: 			break
  509: 		}
  510: 		if e != nil {
  511: 			return r, errors.New("boundary event missing or oversized")
  512: 		}
  513: 		var ev BoundaryEvent
  514: 		if e = json.Unmarshal(raw, &ev); e != nil {
  515: 			return r, e
  516: 		}
  517: 		r.Events = append(r.Events, ev)
  518: 	}
  519: 	if e = ValidateEvents(r.Events, p.OperationID, p.PlanSHA256); e != nil {
  520: 		return r, e
  521: 	}
  522: 	fullRestartRaw, _, fullRestartErr := readManagedFile(filepath.Join(dir, "full-restart-complete.json"), p.ManagementSID, 16<<10)
  523: 	if fullRestartErr != nil && !errors.Is(fullRestartErr, os.ErrNotExist) {
  524: 		return r, fullRestartErr
  525: 	}
  526: 	if !r.Post.UTC.IsZero() && (fullRestartErr != nil || digest(fullRestartRaw) != r.Post.FullRestartEvidenceSHA256) {
  527: 		return r, errors.New("FullRestart evidence drift")
  528: 	}
  529: 	if len(entries) != 6+len(r.Events)+boolInt(!r.Post.UTC.IsZero())+boolInt(fullRestartErr == nil) {
  530: 		return r, errors.New("boundary event inventory gap")
  531: 	}
  532: 	return r, nil
  533: }
  534: func boolInt(b bool) int {
  535: 	if b {
  536: 		return 1
  537: 	}
  538: 	return 0
  539: }
  540: 
  541: func checkManagedDirectory(path, sid string) error {
  542: 	h, e := openNative(path, true, false)
  543: 	if e != nil {
  544: 		return e
  545: 	}
  546: 	defer windows.CloseHandle(h.handle)
  547: 	sd := (*windows.SECURITY_DESCRIPTOR)(unsafe.Pointer(&h.identity.NativeSecurityDescriptor[0]))
  548: 	return checkManagedDescriptor(sd, sid)
  549: }
  550: 
  551: func checkManagedDescriptor(sd *windows.SECURITY_DESCRIPTOR, sid string) error {
  552: 	if sd == nil {
  553: 		return errors.New("management descriptor missing")
  554: 	}
  555: 	owner, _, e := sd.Owner()
  556: 	if e != nil || owner == nil || owner.String() != sid {
  557: 		return errors.New("boundary management owner mismatch")
  558: 	}
  559: 	control, _, e := sd.Control()
  560: 	if e != nil || control&windows.SE_DACL_PROTECTED == 0 {
  561: 		return errors.New("boundary state DACL not protected")
  562: 	}
  563: 	acl, _, e := sd.DACL()
  564: 	if e != nil || acl == nil || acl.AceCount < 1 || acl.AceCount > 2 {
  565: 		return errors.New("boundary state DACL inventory invalid")
  566: 	}
  567: 	managerFull := false
  568: 	for i := uint32(0); i < uint32(acl.AceCount); i++ {
  569: 		var ace *windows.ACCESS_ALLOWED_ACE
  570: 		if e = windows.GetAce(acl, i, &ace); e != nil {
  571: 			return e
  572: 		}
  573: 		if ace.Header.AceType != windows.ACCESS_ALLOWED_ACE_TYPE || ace.Header.AceFlags&windows.INHERIT_ONLY_ACE != 0 {
  574: 			return errors.New("boundary state ACE type forbidden")
  575: 		}
  576: 		trustee := (*windows.SID)(unsafe.Pointer(&ace.SidStart)).String()
  577: 		if trustee != sid && trustee != "S-1-5-18" {
  578: 			return errors.New("boundary state nonmanagement ACE forbidden")
  579: 		}
  580: 		if trustee == sid && uint32(ace.Mask)&0x001f01ff == 0x001f01ff {
  581: 			managerFull = true
  582: 		} // FILE_ALL_ACCESS
  583: 	}
  584: 	if !managerFull {
  585: 		return errors.New("boundary state manager full access absent")
  586: 	}
  587: 	return nil
  588: }
  589: 
  590: // Every state/attestation file is read from the same pinned native handle
  591: // whose owner, protected DACL and non-reparse/single-link identity passed.
  592: func readManagedFile(path, managerSID string, limit int) ([]byte, FileIdentity, error) {
  593: 	h, err := openNativeAccess(path, false, false, 0)
  594: 	if errors.Is(err, windows.ERROR_FILE_NOT_FOUND) {
  595: 		return nil, FileIdentity{}, os.ErrNotExist
  596: 	}
  597: 	if err != nil {
  598: 		return nil, FileIdentity{}, err
  599: 	}
  600: 	defer windows.CloseHandle(h.handle)
  601: 	sd := (*windows.SECURITY_DESCRIPTOR)(unsafe.Pointer(&h.identity.NativeSecurityDescriptor[0]))
  602: 	if err = checkManagedDescriptor(sd, managerSID); err != nil {
  603: 		return nil, FileIdentity{}, fmt.Errorf("unprotected boundary file %s: %w", path, err)
  604: 	}
  605: 	raw, err := readPinnedBounded(h.handle, limit)
  606: 	if err != nil {
  607: 		return nil, FileIdentity{}, err
  608: 	}
  609: 	h.identity.SHA256 = digest(raw)
  610: 	return raw, h.identity, nil
  611: }
  612: 
  613: func readPinnedBounded(handle windows.Handle, limit int) ([]byte, error) {
  614: 	var raw []byte
  615: 	buf := make([]byte, 32<<10)
  616: 	for {
  617: 		var n uint32
  618: 		if err := windows.ReadFile(handle, buf, &n, nil); err != nil {
  619: 			return nil, err
  620: 		}
  621: 		if n == 0 {
  622: 			break
  623: 		}
  624: 		if len(raw)+int(n) > limit {
  625: 			return nil, errors.New("boundary file exceeds read limit")
  626: 		}
  627: 		raw = append(raw, buf[:n]...)
  628: 	}
  629: 	return raw, nil
  630: }
  631: 
  632: func checkManagedChain(p EntryFencePlan) error {
  633: 	dir, e := stateRoot(p)
  634: 	if e != nil {
  635: 		return e
  636: 	}
  637: 	base := os.Getenv("ProgramData")
  638: 	for _, path := range pathAncestors(dir) {
  639: 		if strings.EqualFold(path, base) {
  640: 			continue
  641: 		}
  642: 		if strings.HasPrefix(strings.ToLower(path), strings.ToLower(base)+string(filepath.Separator)) {
  643: 			if e = checkManagedDirectory(path, p.ManagementSID); e != nil {
  644: 				return e
  645: 			}
  646: 		}
  647: 	}
  648: 	return checkManagedDirectory(dir, p.ManagementSID)
  649: }
  650: 
  651: func checkCurrentBoot(post BootWitness, businessSID string) error {
  652: 	u, b, e := bootClock()
  653: 	if e != nil {
  654: 		return e
  655: 	}
  656: 	if b.Before(post.LastBootUTC.Add(-2*time.Second)) || b.After(post.LastBootUTC.Add(2*time.Second)) || u < post.UptimeMilliseconds {
  657: 		return errors.New("current boot differs from post witness")
  658: 	}
  659: 	if time.Since(post.UTC) < 0 || time.Since(post.UTC) > MaxElapsed {
  660: 		return errors.New("post witness expired")
  661: 	}
  662: 	r, e := registryRestartApps(businessSID)
  663: 	if e != nil {
  664: 		return e
  665: 	}
  666: 	if r != post.RestartApps {
  667: 		return errors.New("RestartApps state changed")
  668: 	}
  669: 	return nil
  670: }
  671: 
  672: func checkPreCurrent(pre BootWitness, businessSID string) error {
  673: 	u, b, e := bootClock()
  674: 	if e != nil {
  675: 		return e
  676: 	}
  677: 	if b.Before(pre.LastBootUTC.Add(-2*time.Second)) || b.After(pre.LastBootUTC.Add(2*time.Second)) || u < pre.UptimeMilliseconds {
  678: 		return errors.New("pre witness boot changed before arm")
  679: 	}
  680: 	if time.Since(pre.UTC) < 0 || time.Since(pre.UTC) > MaxElapsed {
  681: 		return errors.New("pre witness expired before arm")
  682: 	}
  683: 	r, e := registryRestartApps(businessSID)
  684: 	if e != nil {
  685: 		return e
  686: 	}
  687: 	if r != pre.RestartApps {
  688: 		return errors.New("RestartApps changed before arm")
  689: 	}
  690: 	return nil
  691: }
  692: 
  693: func checkFence(p EntryFencePlan, holds []nativeHold) error {
  694: 	byPath := map[string]FileIdentity{}
  695: 	for _, h := range holds {
  696: 		byPath[strings.ToLower(h.path)] = h.identity
  697: 	}
  698: 	for _, t := range p.Targets {
  699: 		x, ok := byPath[strings.ToLower(t.File.Path)]
  700: 		if !ok || !identityCoreEqual(x, t.File) || t.InstalledSD == "" || x.SecurityDescriptor != t.InstalledSD || x.NativeSecuritySHA256 != t.InstalledNativeSecuritySHA256 {
  701: 			return errors.New("fence target readback mismatch")
  702: 		}
  703: 		expected, e := denyDescriptor(t.File.SecurityDescriptor, p.BusinessSID, p.ManagementSID, t.Mode)
  704: 		if e != nil || expected != x.SecurityDescriptor {
  705: 			return errors.New("business SID exact deny descriptor absent")
  706: 		}
  707: 	}
  708: 	return nil
  709: }
  710: 
  711: func businessEnabledGroupDigest(p EntryFencePlan) (string, error) {
  712: 	claimed := append([]string(nil), p.BusinessGroupSIDs...)
  713: 	sort.Strings(claimed)
  714: 	for i, sid := range claimed {
  715: 		if _, err := windows.StringToSid(sid); err != nil || (i > 0 && sid == claimed[i-1]) {
  716: 			return "", errors.New("invalid business enabled group inventory")
  717: 		}
  718: 	}
  719: 	raw, _ := json.Marshal(claimed)
  720: 	return digest(raw), nil
  721: }
  722: 
  723: // Before plan, inspect a live exact official executable's token. Later phases
  724: // use the protected pre witness because the fence deliberately stops that app.
  725: func verifiedBusinessGroups(p EntryFencePlan) (map[string]bool, error) {
  726: 	expected, err := businessEnabledGroupDigest(p)
  727: 	if err != nil {
  728: 		return nil, err
  729: 	}
  730: 	dir, err := stateRoot(p)
  731: 	if err != nil {
  732: 		return nil, err
  733: 	}
  734: 	var pre BootWitness
  735: 	if raw, _, readErr := readManagedFile(filepath.Join(dir, "pre.json"), p.ManagementSID, 16<<10); readErr == nil {
  736: 		if len(raw) > 16<<10 || json.Unmarshal(raw, &pre) != nil || pre.OperationID != p.OperationID || pre.PlanSHA256 != p.PlanSHA256 || pre.BusinessEnabledSIDsSHA256 != expected {
  737: 			return nil, errors.New("business token witness mismatch")
  738: 		}
  739: 		// The pre token was captured before the fence. A restart may change
  740: 		// group activation, so an active business logon token must still match.
  741: 		shape, captureErr := inspectExistingBusinessProcess(p, expected, pre)
  742: 		if captureErr != nil {
  743: 			return nil, captureErr
  744: 		}
  745: 		if postRaw, _, postErr := readManagedFile(filepath.Join(dir, "post.json"), p.ManagementSID, 16<<10); postErr == nil {
  746: 			var post BootWitness
  747: 			if len(postRaw) > 16<<10 || json.Unmarshal(postRaw, &post) != nil || post.OperationID != p.OperationID || post.PlanSHA256 != p.PlanSHA256 || sameCurrentProcessWitness(post, shape) != nil {
  748: 				return nil, errors.New("current business process identity differs from post witness")
  749: 			}
  750: 		} else if !errors.Is(postErr, os.ErrNotExist) {
  751: 			return nil, postErr
  752: 		}
  753: 		return shape.EffectiveSIDs, nil
  754: 	} else if !errors.Is(readErr, os.ErrNotExist) {
  755: 		return nil, readErr
  756: 	} else {
  757: 		shape, captureErr := captureOfficialBusinessToken(p, expected)
  758: 		if captureErr != nil {
  759: 			return nil, captureErr
  760: 		}
  761: 		return shape.EffectiveSIDs, nil
  762: 	}
  763: }
  764: 
  765: func tokenGroupState(token windows.Token, businessSID string) (string, map[string]bool, string, error) {
  766: 	user, userErr := token.GetTokenUser()
  767: 	groups, groupsErr := token.GetTokenGroups()
  768: 	if userErr != nil || groupsErr != nil {
  769: 		return "", nil, "", errors.Join(userErr, groupsErr)
  770: 	}
  771: 	if user.User.Sid.String() != businessSID {
  772: 		return "", nil, "", errors.New("native token user differs from frozen business SID")
  773: 	}
  774: 	return potentialGroupState(groups.AllGroups(), businessSID)
  775: }
  776: 
  777: // A normal disabled group may be enabled later with AdjustTokenGroups. Only
  778: // USE_FOR_DENY_ONLY is irreversibly excluded from ALLOW ACE matching.
  779: func potentialGroupState(groups []windows.SIDAndAttributes, businessSID string) (string, map[string]bool, string, error) {
  780: 	var stable []string
  781: 	var logonSID string
  782: 	potential := map[string]bool{businessSID: true}
  783: 	for _, group := range groups {
  784: 		if group.Attributes&windows.SE_GROUP_LOGON_ID == windows.SE_GROUP_LOGON_ID {
  785: 			if logonSID != "" {
  786: 				return "", nil, "", errors.New("multiple token logon SIDs")
  787: 			}
  788: 			logonSID = group.Sid.String()
  789: 		}
  790: 		if group.Attributes&windows.SE_GROUP_USE_FOR_DENY_ONLY == 0 {
  791: 			potential[group.Sid.String()] = true
  792: 			// Logon SID and integrity label are per logon/boot. Keep them in
  793: 			// the current potential-access map, but not in the frozen hash.
  794: 			if group.Attributes&(windows.SE_GROUP_LOGON_ID|windows.SE_GROUP_INTEGRITY) == 0 {
  795: 				stable = append(stable, group.Sid.String())
  796: 			}
  797: 		}
  798: 	}
  799: 	if logonSID == "" {
  800: 		return "", nil, "", errors.New("token logon SID unavailable")
  801: 	}
  802: 	sort.Strings(stable)
  803: 	raw, _ := json.Marshal(stable)
  804: 	return digest(raw), potential, logonSID, nil
  805: }
  806: 
  807: type businessTokenShape struct {
  808: 	SessionID        uint32
  809: 	ElevationType    uint32
  810: 	IntegritySID     string
  811: 	LogonSID         string
  812: 	PrivilegesSHA256 string
  813: 	GroupsSHA256     string
  814: 	EffectiveSIDs    map[string]bool
  815: 	ProcessID        uint32
  816: 	ProcessCreated   time.Time
  817: 	ProcessImageSHA  string
  818: }
  819: 
  820: func tokenInfoBytes(token windows.Token, class uint32) ([]byte, error) {
  821: 	buf := make([]byte, 128)
  822: 	for {
  823: 		var size uint32
  824: 		err := windows.GetTokenInformation(token, class, &buf[0], uint32(len(buf)), &size)
  825: 		if err == nil {
  826: 			if size > uint32(len(buf)) {
  827: 				return nil, errors.New("token information size invalid")
  828: 			}
  829: 			return buf[:size], nil
  830: 		}
  831: 		if !errors.Is(err, windows.ERROR_INSUFFICIENT_BUFFER) || size > 64<<10 || size <= uint32(len(buf)) {
  832: 			return nil, err
  833: 		}
  834: 		buf = make([]byte, size)
  835: 	}
  836: }
  837: 
  838: func tokenSecurityShape(token windows.Token, pid uint32, businessSID string) (businessTokenShape, error) {
  839: 	var shape businessTokenShape
  840: 	var session, elevation, size uint32
  841: 	if err := windows.ProcessIdToSessionId(pid, &session); err != nil {
  842: 		return shape, err
  843: 	}
  844: 	if err := windows.GetTokenInformation(token, windows.TokenElevationType, (*byte)(unsafe.Pointer(&elevation)), 4, &size); err != nil || size != 4 {
  845: 		return shape, errors.Join(err, errors.New("token elevation type unavailable"))
  846: 	}
  847: 	labelBytes, err := tokenInfoBytes(token, windows.TokenIntegrityLevel)
  848: 	if err != nil || len(labelBytes) < int(unsafe.Sizeof(windows.Tokenmandatorylabel{})) {
  849: 		return shape, errors.Join(err, errors.New("token integrity label unavailable"))
  850: 	}
  851: 	groupSHA, effective, logonSID, err := tokenGroupState(token, businessSID)
  852: 	if err != nil {
  853: 		return shape, err
  854: 	}
  855: 	privBytes, err := tokenInfoBytes(token, windows.TokenPrivileges)
  856: 	if err != nil || len(privBytes) < int(unsafe.Sizeof(windows.Tokenprivileges{})) {
  857: 		return shape, errors.Join(err, errors.New("token privileges unavailable"))
  858: 	}
  859: 	var privilegeLines []string
  860: 	for _, priv := range (*windows.Tokenprivileges)(unsafe.Pointer(&privBytes[0])).AllPrivileges() {
  861: 		privilegeLines = append(privilegeLines, fmt.Sprintf("%08x:%08x:%08x", uint32(priv.Luid.HighPart), priv.Luid.LowPart, priv.Attributes))
  862: 	}
  863: 	sort.Strings(privilegeLines)
  864: 	privJSON, _ := json.Marshal(privilegeLines)
  865: 	shape = businessTokenShape{SessionID: session, ElevationType: elevation, IntegritySID: (*windows.Tokenmandatorylabel)(unsafe.Pointer(&labelBytes[0])).Label.Sid.String(), LogonSID: logonSID, PrivilegesSHA256: digest(privJSON), GroupsSHA256: groupSHA, EffectiveSIDs: effective}
  866: 	return shape, nil
  867: }
  868: 
  869: // Existing Explorer supplies a fresh business process token after restart.
  870: // Its current PID, session and logon SID are evidence, never compared to the
  871: // pre-restart values. Elevated-admin cross-account TOKEN_QUERY is probed.
  872: func inspectExistingBusinessProcess(p EntryFencePlan, expected string, pre BootWitness) (businessTokenShape, error) {
  873: 	var zero businessTokenShape
  874: 	if pre.BusinessLogonSID == "" || !validDigest(pre.BusinessPrivilegesSHA256) || pre.BusinessIntegritySID == "" {
  875: 		return zero, errors.New("pre business token shape unavailable")
  876: 	}
  877: 	systemRoot, rootErr := windows.GetSystemWindowsDirectory()
  878: 	if rootErr != nil || !filepath.IsAbs(systemRoot) || filepath.Clean(systemRoot) != systemRoot {
  879: 		return zero, errors.Join(rootErr, errors.New("native system root unavailable"))
  880: 	}
  881: 	explorerPath := filepath.Join(systemRoot, "explorer.exe")
  882: 	_, currentBoot, err := bootClock()
  883: 	if err != nil {
  884: 		return zero, err
  885: 	}
  886: 	snapshot, err := windows.CreateToolhelp32Snapshot(windows.TH32CS_SNAPPROCESS, 0)
  887: 	if err != nil {
  888: 		return zero, err
  889: 	}
  890: 	defer windows.CloseHandle(snapshot)
  891: 	var entry windows.ProcessEntry32
  892: 	entry.Size = uint32(unsafe.Sizeof(entry))
  893: 	if err = windows.Process32First(snapshot, &entry); err != nil {
  894: 		return zero, err
  895: 	}
  896: 	var matched *businessTokenShape
  897: 	for {
  898: 		if strings.EqualFold(windows.UTF16ToString(entry.ExeFile[:]), "explorer.exe") {
  899: 			proc, openErr := windows.OpenProcess(windows.PROCESS_QUERY_LIMITED_INFORMATION, false, entry.ProcessID)
  900: 			if openErr != nil {
  901: 				return zero, fmt.Errorf("Explorer candidate inaccessible: %w", openErr)
  902: 			}
  903: 			buf := make([]uint16, 32768)
  904: 			n := uint32(len(buf))
  905: 			imageErr := windows.QueryFullProcessImageName(proc, 0, &buf[0], &n)
  906: 			if imageErr != nil {
  907: 				windows.CloseHandle(proc)
  908: 				return zero, imageErr
  909: 			}
  910: 			if !strings.EqualFold(windows.UTF16ToString(buf[:n]), explorerPath) {
  911: 				windows.CloseHandle(proc)
  912: 				goto nextProcess
  913: 			}
  914: 			var created, exited, kernel, userTime windows.Filetime
  915: 			if err = windows.GetProcessTimes(proc, &created, &exited, &kernel, &userTime); err != nil || time.Unix(0, created.Nanoseconds()).Before(currentBoot.Add(-2*time.Second)) {
  916: 				windows.CloseHandle(proc)
  917: 				return zero, errors.Join(err, errors.New("Explorer creation predates current boot"))
  918: 			}
  919: 			var token windows.Token
  920: 			tokenErr := windows.OpenProcessToken(proc, windows.TOKEN_QUERY, &token)
  921: 			if tokenErr != nil {
  922: 				windows.CloseHandle(proc)
  923: 				return zero, tokenErr
  924: 			}
  925: 			user, userErr := token.GetTokenUser()
  926: 			if userErr != nil {
  927: 				token.Close()
  928: 				windows.CloseHandle(proc)
  929: 				return zero, userErr
  930: 			}
  931: 			if user.User.Sid.String() != p.BusinessSID {
  932: 				token.Close()
  933: 				windows.CloseHandle(proc)
  934: 				goto nextProcess
  935: 			}
  936: 			shape, shapeErr := tokenSecurityShape(token, entry.ProcessID, p.BusinessSID)
  937: 			closeErr := token.Close()
  938: 			if shapeErr != nil || closeErr != nil {
  939: 				windows.CloseHandle(proc)
  940: 				return zero, errors.Join(shapeErr, closeErr)
  941: 			}
  942: 			imageSHA, imageErr := osProcessImageIdentity(explorerPath)
  943: 			closeErr = windows.CloseHandle(proc)
  944: 			if imageErr != nil || closeErr != nil {
  945: 				return zero, errors.Join(imageErr, closeErr)
  946: 			}
  947: 			shape.ProcessID = entry.ProcessID
  948: 			shape.ProcessCreated = time.Unix(0, created.Nanoseconds()).UTC()
  949: 			shape.ProcessImageSHA = imageSHA
  950: 			if err := sameBusinessPermissionSemantics(pre, shape, expected); err != nil {
  951: 				return zero, err
  952: 			}
  953: 			if matched != nil {
  954: 				if matched.SessionID != shape.SessionID || matched.LogonSID != shape.LogonSID || matched.ProcessImageSHA != shape.ProcessImageSHA {
  955: 					return zero, errors.New("multiple current business Explorer sessions ambiguous")
  956: 				}
  957: 				if shape.ProcessCreated.Before(matched.ProcessCreated) {
  958: 					matched = &shape
  959: 				}
  960: 			} else {
  961: 				matched = &shape
  962: 			}
  963: 		}
  964: 	nextProcess:
  965: 		err = windows.Process32Next(snapshot, &entry)
  966: 		if errors.Is(err, windows.ERROR_NO_MORE_FILES) {
  967: 			break
  968: 		}
  969: 		if err != nil {
  970: 			return zero, err
  971: 		}
  972: 	}
  973: 	if matched == nil {
  974: 		return zero, errors.New("current business Explorer token unavailable")
  975: 	}
  976: 	return *matched, nil
  977: }
  978: 
  979: func sameBusinessPermissionSemantics(pre BootWitness, current businessTokenShape, expected string) error {
  980: 	if current.LogonSID == "" || current.IntegritySID == "" || current.GroupsSHA256 != expected || current.ElevationType != pre.BusinessElevationType || current.IntegritySID != pre.BusinessIntegritySID || current.PrivilegesSHA256 != pre.BusinessPrivilegesSHA256 {
  981: 		return errors.New("current business token permission semantics differ from pre witness")
  982: 	}
  983: 	return nil
  984: }
  985: 
  986: func sameCurrentProcessWitness(post BootWitness, current businessTokenShape) error {
  987: 	if post.BusinessEnabledSIDsSHA256 != current.GroupsSHA256 || post.BusinessSessionID != current.SessionID || post.BusinessLogonSID != current.LogonSID || post.BusinessProcessPID != current.ProcessID || !post.BusinessProcessCreatedUTC.Equal(current.ProcessCreated) || post.BusinessProcessImageSHA256 != current.ProcessImageSHA {
  988: 		return errors.New("current business process identity changed")
  989: 	}
  990: 	return nil
  991: }
