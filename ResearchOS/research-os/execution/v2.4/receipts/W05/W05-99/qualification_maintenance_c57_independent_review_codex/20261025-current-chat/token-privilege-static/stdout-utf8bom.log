 1048: func captureOfficialBusinessToken(p EntryFencePlan, expected string) (businessTokenShape, error) {
 1049: 	var zero businessTokenShape
 1050: 	snapshot, err := windows.CreateToolhelp32Snapshot(windows.TH32CS_SNAPPROCESS, 0)
 1051: 	if err != nil {
 1052: 		return zero, err
 1053: 	}
 1054: 	defer windows.CloseHandle(snapshot)
 1055: 	var entry windows.ProcessEntry32
 1056: 	entry.Size = uint32(unsafe.Sizeof(entry))
 1057: 	if err = windows.Process32First(snapshot, &entry); err != nil {
 1058: 		return zero, err
 1059: 	}
 1060: 	for {
 1061: 		for _, target := range p.Targets {
 1062: 			if target.Mode != "executable" || !strings.EqualFold(windows.UTF16ToString(entry.ExeFile[:]), filepath.Base(target.File.Path)) {
 1063: 				continue
 1064: 			}
 1065: 			proc, openErr := windows.OpenProcess(windows.PROCESS_QUERY_LIMITED_INFORMATION, false, entry.ProcessID)
 1066: 			if openErr != nil {
 1067: 				return zero, openErr
 1068: 			}
 1069: 			buf := make([]uint16, 32768)
 1070: 			n := uint32(len(buf))
 1071: 			nameErr := windows.QueryFullProcessImageName(proc, 0, &buf[0], &n)
 1072: 			if nameErr != nil {
 1073: 				windows.CloseHandle(proc)
 1074: 				return zero, nameErr
 1075: 			}
 1076: 			if !strings.EqualFold(windows.UTF16ToString(buf[:n]), target.File.Path) {
 1077: 				windows.CloseHandle(proc)
 1078: 				continue
 1079: 			}
 1080: 			var token windows.Token
 1081: 			tokenErr := windows.OpenProcessToken(proc, windows.TOKEN_QUERY, &token)
 1082: 			var created, exited, kernel, userTime windows.Filetime
 1083: 			timeErr := windows.GetProcessTimes(proc, &created, &exited, &kernel, &userTime)
 1084: 			windows.CloseHandle(proc)
 1085: 			if tokenErr != nil || timeErr != nil {
 1086: 				if tokenErr == nil {
 1087: 					token.Close()
 1088: 				}
 1089: 				return zero, errors.Join(tokenErr, timeErr)
 1090: 			}
 1091: 			shape, shapeErr := tokenSecurityShape(token, entry.ProcessID, p.BusinessSID)
 1092: 			closeErr := token.Close()
 1093: 			if shapeErr != nil || closeErr != nil {
 1094: 				return zero, errors.Join(shapeErr, closeErr)
 1095: 			}
 1096: 			if shape.GroupsSHA256 != expected {
 1097: 				return zero, errors.New("actual business token enabled groups differ from frozen inventory")
 1098: 			}
 1099: 			shape.ProcessID = entry.ProcessID
 1100: 			shape.ProcessCreated = time.Unix(0, created.Nanoseconds()).UTC()
 1101: 			shape.ProcessImageSHA = digest([]byte(fmt.Sprintf("%s|%d|%s|%s", strings.ToLower(target.File.FinalUTF16), target.File.Volume, target.File.FileID, target.File.SHA256)))
 1102: 			return shape, nil
 1103: 		}
 1104: 		err = windows.Process32Next(snapshot, &entry)
 1105: 		if errors.Is(err, windows.ERROR_NO_MORE_FILES) {
 1106: 			return zero, errors.New("exact official process token unavailable for ancestor proof")
 1107: 		}
 1108: 		if err != nil {
 1109: 			return zero, err
 1110: 		}
 1111: 	}
 1112: }
