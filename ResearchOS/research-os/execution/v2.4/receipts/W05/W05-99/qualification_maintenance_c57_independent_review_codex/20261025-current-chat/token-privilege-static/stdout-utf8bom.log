 1122: func checkAncestorACL(p EntryFencePlan, holds []nativeHold, enabled map[string]bool) error {
 1123: 	protected := map[string]bool{}
 1124: 	for _, a := range p.Ancestors {
 1125: 		protected[strings.ToLower(a.Path)] = true
 1126: 	}
 1127: 	protected[strings.ToLower(p.DataRoot.Path)] = true
 1128: 	for _, h := range holds {
 1129: 		if !protected[strings.ToLower(h.path)] {
 1130: 			continue
 1131: 		}
 1132: 		sd, e := windows.SecurityDescriptorFromString(h.identity.SecurityDescriptor)
 1133: 		if e != nil {
 1134: 			return e
 1135: 		}
 1136: 		owner, _, e := sd.Owner()
 1137: 		osAnchor := filepath.Dir(h.path) == h.path || strings.EqualFold(h.path, filepath.Join(filepath.VolumeName(h.path)+`\`, "Users"))
 1138: 		ownerTrusted := owner != nil && (owner.String() == p.ManagementSID || owner.String() == "S-1-5-18" || (osAnchor && owner.String() == "S-1-5-80-956008885-3418522649-1831038044-1853292631-2271478464"))
 1139: 		if e != nil || !ownerTrusted || enabled[owner.String()] {
 1140: 			return fmt.Errorf("ancestor owner can revoke boundary: %s", h.path)
 1141: 		}
 1142: 		acl, _, e := sd.DACL()
 1143: 		if e != nil || acl == nil {
 1144: 			return fmt.Errorf("ancestor DACL unavailable: %s", h.path)
 1145: 		}
 1146: 		for i := uint32(0); i < uint32(acl.AceCount); i++ {
 1147: 			var ace *windows.ACCESS_ALLOWED_ACE
 1148: 			if e = windows.GetAce(acl, i, &ace); e != nil {
 1149: 				return e
 1150: 			}
 1151: 			if ace.Header.AceFlags&windows.INHERIT_ONLY_ACE != 0 || ace.Header.AceType == windows.ACCESS_DENIED_ACE_TYPE {
 1152: 				continue
 1153: 			}
 1154: 			if ace.Header.AceType != windows.ACCESS_ALLOWED_ACE_TYPE {
 1155: 				return fmt.Errorf("ancestor ACL ACE unsupported: %s", h.path)
 1156: 			}
 1157: 			trustee := (*windows.SID)(unsafe.Pointer(&ace.SidStart)).String()
 1158: 			if !enabled[trustee] {
 1159: 				continue
 1160: 			}
 1161: 			forbidden := uint32(0x40 | windows.WRITE_DAC | windows.WRITE_OWNER | windows.GENERIC_ALL) // FILE_DELETE_CHILD; GENERIC_WRITE maps to file writes only.
 1162: 			if filepath.Dir(h.path) != h.path {
 1163: 				forbidden |= windows.DELETE
 1164: 			}
 1165: 			if uint32(ace.Mask)&forbidden != 0 {
 1166: 				return fmt.Errorf("business group can replace ancestor: %s", h.path)
 1167: 			}
 1168: 		}
 1169: 	}
 1170: 	return nil
 1171: }
