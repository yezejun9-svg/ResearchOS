 1288: func preflightInstalledRestore(p EntryFencePlan, byPath map[string]FileIdentity) error {
 1289: 	for _, target := range p.Targets {
 1290: 		observed := byPath[strings.ToLower(target.File.Path)]
 1291: 		if observed.SecurityDescriptor == target.File.SecurityDescriptor && observed.NativeSecuritySHA256 == target.File.NativeSecuritySHA256 {
 1292: 			continue
 1293: 		}
 1294: 		original, err := windows.SecurityDescriptorFromString(target.File.SecurityDescriptor)
 1295: 		if err != nil {
 1296: 			return err
 1297: 		}
 1298: 		owner, _, err := original.Owner()
 1299: 		if err != nil || owner == nil {
 1300: 			return errors.New("disarm original owner unavailable")
 1301: 		}
 1302: 		access := uint32(windows.WRITE_DAC)
 1303: 		if owner.String() != p.ManagementSID {
 1304: 			access |= windows.WRITE_OWNER
 1305: 		}
 1306: 		h, err := openNativeAccess(target.File.Path, false, true, access)
 1307: 		if err != nil {
 1308: 			return fmt.Errorf("disarm mutation handle unavailable: %w", err)
 1309: 		}
 1310: 		matching := identityCoreEqual(h.identity, target.File) && h.identity.SecurityDescriptor == target.InstalledSD && h.identity.NativeSecuritySHA256 == target.InstalledNativeSecuritySHA256
 1311: 		closeErr := windows.CloseHandle(h.handle)
 1312: 		if closeErr != nil || !matching {
 1313: 			return errors.Join(closeErr, errors.New("disarm mutation handle identity or installed descriptor drift"))
 1314: 		}
 1315: 		if owner.String() != p.ManagementSID {
 1316: 			if err = ensureOwnerRestorable(p.ManagementSID, owner); err != nil {
 1317: 				return fmt.Errorf("disarm original owner not restorable: %w", err)
 1318: 			}
 1319: 		}
 1320: 	}
 1321: 	return nil
 1322: }
