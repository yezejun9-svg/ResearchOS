 1324: func denyDescriptor(original, sidText, managementSID, mode string) (string, error) {
 1325: 	sid, e := windows.StringToSid(sidText)
 1326: 	if e != nil {
 1327: 		return "", e
 1328: 	}
 1329: 	sd, e := windows.SecurityDescriptorFromString(original)
 1330: 	if e != nil {
 1331: 		return "", e
 1332: 	}
 1333: 	old, _, e := sd.DACL()
 1334: 	if e != nil {
 1335: 		return "", e
 1336: 	}
 1337: 	mask := windows.ACCESS_MASK(windows.FILE_EXECUTE)
 1338: 	if mode == "script" {
 1339: 		mask = windows.ACCESS_MASK(windows.FILE_READ_DATA)
 1340: 	} else if mode != "executable" {
 1341: 		return "", errors.New("unknown target mode")
 1342: 	}
 1343: 	if managementSID != sidText {
 1344: 		mask |= windows.ACCESS_MASK(windows.WRITE_DAC | windows.WRITE_OWNER | windows.DELETE | windows.FILE_WRITE_DATA | windows.FILE_APPEND_DATA)
 1345: 	}
 1346: 	ace := windows.EXPLICIT_ACCESS{AccessPermissions: mask, AccessMode: windows.DENY_ACCESS, Inheritance: windows.NO_INHERITANCE,
 1347: 		Trustee: windows.TRUSTEE{TrusteeForm: windows.TRUSTEE_IS_SID, TrusteeType: windows.TRUSTEE_IS_USER, TrusteeValue: windows.TrusteeValueFromSID(sid)}}
 1348: 	entries := []windows.EXPLICIT_ACCESS{ace}
 1349: 	if managementSID != sidText {
 1350: 		manager, e := windows.StringToSid(managementSID)
 1351: 		if e != nil {
 1352: 			return "", e
 1353: 		}
 1354: 		entries = append(entries, windows.EXPLICIT_ACCESS{AccessPermissions: windows.ACCESS_MASK(windows.FILE_READ_DATA | windows.FILE_READ_ATTRIBUTES | windows.READ_CONTROL | windows.WRITE_DAC | windows.WRITE_OWNER), AccessMode: windows.GRANT_ACCESS, Inheritance: windows.NO_INHERITANCE,
 1355: 			Trustee: windows.TRUSTEE{TrusteeForm: windows.TRUSTEE_IS_SID, TrusteeType: windows.TRUSTEE_IS_USER, TrusteeValue: windows.TrusteeValueFromSID(manager)}})
 1356: 	}
 1357: 	acl, e := windows.ACLFromEntries(entries, old)
 1358: 	if e != nil {
 1359: 		return "", e
 1360: 	}
 1361: 	// Protecting a DACL makes formerly inherited ACEs explicit on the object.
 1362: 	// Normalize the planned descriptor to the native readback representation.
 1363: 	for i := uint32(0); i < uint32(acl.AceCount); i++ {
 1364: 		var item *windows.ACCESS_ALLOWED_ACE
 1365: 		if e = windows.GetAce(acl, i, &item); e != nil {
 1366: 			return "", e
 1367: 		}
 1368: 		item.Header.AceFlags &^= windows.INHERITED_ACE
 1369: 	}
 1370: 	abs, e := sd.ToAbsolute()
 1371: 	if e != nil {
 1372: 		return "", e
 1373: 	}
 1374: 	if managementSID != sidText {
 1375: 		manager, e := windows.StringToSid(managementSID)
 1376: 		if e != nil {
 1377: 			return "", e
 1378: 		}
 1379: 		if e = abs.SetOwner(manager, false); e != nil {
 1380: 			return "", e
 1381: 		}
 1382: 	}
 1383: 	if e = abs.SetDACL(acl, true, false); e != nil {
 1384: 		return "", e
 1385: 	}
 1386: 	if e = abs.SetControl(windows.SE_DACL_PROTECTED, windows.SE_DACL_PROTECTED); e != nil {
 1387: 		return "", e
 1388: 	}
 1389: 	installed, e := abs.ToSelfRelative()
 1390: 	if e != nil {
 1391: 		return "", e
 1392: 	}
 1393: 	return installed.String(), nil
 1394: }
 1395: 
 1396: // OpenCurrentQuiescence reopens a protected BOOT_OBSERVED record. It then
 1397: // retains native no-delete holds through the caller's actual outer transaction.
 1398: func OpenCurrentQuiescence(ctx context.Context, held *rt.DataRootLease, dataRoot, database, operationID, planSHA256 string) (*CurrentQuiescence, error) {
 1399: 	if e := ctx.Err(); e != nil {
 1400: 		return nil, e
 1401: 	}
 1402: 	if held == nil || !held.Held() || held.Root() != dataRoot || database != filepath.Join(dataRoot, "researchos.sqlite") || !validOperation(operationID) || !validDigest(planSHA256) {
 1403: 		return nil, errors.New("current quiescence held lease or binding invalid")
 1404: 	}
 1405: 	lease, e := held.MaintenanceIdentity()
 1406: 	if e != nil {
 1407: 		return nil, e
 1408: 	}
 1409: 	// Discovery is by fixed ProgramData inventory. We never accept a path from
 1410: 	// a caller or a JSON supplied capability.
 1411: 	p, e := discoverPlan(dataRoot, operationID, planSHA256)
 1412: 	if e != nil {
 1413: 		return nil, e
 1414: 	}
 1415: 	if e = ValidatePlan(p); e != nil {
 1416: 		return nil, e
 1417: 	}
 1418: 	if e = managedToken(p); e != nil {
 1419: 		return nil, e
 1420: 	}
 1421: 	if p.DataRoot.Path != dataRoot || p.Database.Path != database {
 1422: 		return nil, errors.New("current quiescence source mismatch")
 1423: 	}
 1424: 	holds, e := openPlanHolds(p)
 1425: 	if e != nil {
 1426: 		return nil, e
 1427: 	}
 1428: 	fail := func(e error) (*CurrentQuiescence, error) { return nil, errors.Join(e, closeHolds(holds)) }
 1429: 	r, e := readRecord(p)
 1430: 	if e != nil {
 1431: 		return fail(e)
 1432: 	}
 1433: 	if len(r.Events) == 0 || r.Events[len(r.Events)-1].State != "BOOT_OBSERVED" {
 1434: 		return fail(errors.New("boundary not boot observed"))
 1435: 	}
 1436: 	if e = ValidateRestart(r.Pre, r.Post); e != nil {
 1437: 		return fail(e)
 1438: 	}
 1439: 	if e = checkCurrentBoot(r.Post, p.BusinessSID); e != nil {
 1440: 		return fail(e)
 1441: 	}
 1442: 	if e = checkNoOfficialProcess(p); e != nil {
 1443: 		return fail(e)
 1444: 	}
 1445: 	if e = checkFence(p, holds); e != nil {
 1446: 		return fail(e)
 1447: 	}
 1448: 	if e = checkAncestorControl(p, holds); e != nil {
 1449: 		return fail(e)
 1450: 	}
 1451: 	if e = checkHolds(holds); e != nil {
 1452: 		return fail(e)
 1453: 	}
 1454: 	if e = lease.Matches(held); e != nil {
 1455: 		return fail(e)
 1456: 	}
 1457: 	q := &CurrentQuiescence{owner: &quiescenceOwner{lease: lease, plan: p, post: r.Post, holds: holds}}
 1458: 	return q, nil
 1459: }
 1460: 
 1461: func discoverPlan(root, operation, sha string) (EntryFencePlan, error) {
 1462: 	var p EntryFencePlan
 1463: 	base := os.Getenv("ProgramData")
 1464: 	if base == "" {
 1465: 		return p, errors.New("ProgramData unavailable")
 1466: 	}
 1467: 	parent := filepath.Join(base, "ResearchOS", "RecoveryBoundary")
 1468: 	entries, e := os.ReadDir(parent)
 1469: 	if e != nil {
 1470: 		return p, e
 1471: 	}
 1472: 	if len(entries) > 128 {
 1473: 		return p, errors.New("boundary root inventory too large")
 1474: 	}
 1475: 	var found int
 1476: 	for _, entry := range entries {
 1477: 		if !entry.IsDir() || !validDigest(entry.Name()) {
 1478: 			return p, errors.New("unknown boundary root inventory")
 1479: 		}
 1480: 		path := filepath.Join(parent, entry.Name(), operation, "plan.json")
 1481: 		h, e := openNativeAccess(path, false, false, 0)
 1482: 		if errors.Is(e, os.ErrNotExist) {
 1483: 			continue
 1484: 		}
 1485: 		if errors.Is(e, windows.ERROR_FILE_NOT_FOUND) || errors.Is(e, windows.ERROR_PATH_NOT_FOUND) {
 1486: 			continue
 1487: 		}
 1488: 		if e != nil {
 1489: 			return p, errors.New("boundary plan unavailable")
 1490: 		}
 1491: 		raw, readErr := readPinnedBounded(h.handle, maxBoundaryPlanBytes)
 1492: 		if readErr != nil {
 1493: 			windows.CloseHandle(h.handle)
 1494: 			return p, readErr
 1495: 		}
 1496: 		var candidate EntryFencePlan
 1497: 		if e = json.Unmarshal(raw, &candidate); e != nil {
 1498: 			windows.CloseHandle(h.handle)
 1499: 			return p, e
 1500: 		}
 1501: 		if candidate.OperationID == operation && candidate.PlanSHA256 == sha && candidate.DataRoot.Path == root {
 1502: 			sd := (*windows.SECURITY_DESCRIPTOR)(unsafe.Pointer(&h.identity.NativeSecurityDescriptor[0]))
 1503: 			if e = checkManagedDescriptor(sd, candidate.ManagementSID); e != nil {
 1504: 				windows.CloseHandle(h.handle)
 1505: 				return p, errors.New("discovered boundary plan file not protected or changed")
 1506: 			}
 1507: 			p = candidate
 1508: 			found++
 1509: 		}
 1510: 		if e = windows.CloseHandle(h.handle); e != nil {
 1511: 			return p, e
 1512: 		}
 1513: 	}
 1514: 	if found != 1 {
 1515: 		return p, errors.New("exact boundary operation not found")
 1516: 	}
 1517: 	return p, nil
 1518: }
 1519: 
 1520: // ReadBoundaryPlan returns evidence for a C preflight. Its return value is
 1521: // serializable data, never authority to enter a transaction.
 1522: func ReadBoundaryPlan(dataRoot, operationID, boundaryPlanSHA256 string) (EntryFencePlan, string, error) {
 1523: 	var zero EntryFencePlan
 1524: 	if !filepath.IsAbs(dataRoot) || !validOperation(operationID) || !validDigest(boundaryPlanSHA256) {
 1525: 		return zero, "", errors.New("boundary selector invalid")
 1526: 	}
 1527: 	p, e := discoverPlan(dataRoot, operationID, boundaryPlanSHA256)
 1528: 	if e != nil {
 1529: 		return zero, "", e
 1530: 	}
 1531: 	if e = ValidatePlan(p); e != nil {
 1532: 		return zero, "", e
 1533: 	}
 1534: 	if e = checkManagedChain(p); e != nil {
 1535: 		return zero, "", e
 1536: 	}
 1537: 	if e = checkAcceptanceFiles(p); e != nil {
 1538: 		return zero, "", e
 1539: 	}
 1540: 	r, e := readRecord(p)
 1541: 	if e != nil {
 1542: 		return zero, "", e
 1543: 	}
 1544: 	state := r.Events[len(r.Events)-1].State
 1545: 	if state == "BOOT_OBSERVED" {
 1546: 		if e = ValidateRestart(r.Pre, r.Post); e != nil {
 1547: 			return zero, "", e
 1548: 		}
 1549: 		if e = checkCurrentBoot(r.Post, p.BusinessSID); e != nil {
 1550: 			return zero, "", e
 1551: 		}
 1552: 	}
 1553: 	return p, state, nil
 1554: }
 1555: 
 1556: func (q *CurrentQuiescence) Check(ctx context.Context, held *rt.DataRootLease, dataRoot, database, operationID, planSHA256 string) error {
 1557: 	if e := ctx.Err(); e != nil {
 1558: 		return e
 1559: 	}
 1560: 	if q == nil || q.owner == nil {
 1561: 		return errors.New("current quiescence absent")
 1562: 	}
 1563: 	o := q.owner
 1564: 	o.mu.Lock()
 1565: 	defer o.mu.Unlock()
 1566: 	if o.closed || o.plan.DataRoot.Path != dataRoot || o.plan.Database.Path != database || o.plan.OperationID != operationID || o.plan.PlanSHA256 != planSHA256 {
 1567: 		return errors.New("current quiescence binding stale")
 1568: 	}
 1569: 	if e := managedToken(o.plan); e != nil {
 1570: 		return e
 1571: 	}
 1572: 	if e := o.lease.Matches(held); e != nil {
 1573: 		return e
 1574: 	}
 1575: 	if e := checkHolds(o.holds); e != nil {
 1576: 		return e
 1577: 	}
 1578: 	r, e := readRecord(o.plan)
 1579: 	if e != nil {
 1580: 		return e
 1581: 	}
 1582: 	if len(r.Events) == 0 || r.Events[len(r.Events)-1].State != "BOOT_OBSERVED" || r.Post != o.post {
 1583: 		return errors.New("current quiescence state changed")
 1584: 	}
 1585: 	if e = ValidateRestart(r.Pre, r.Post); e != nil {
 1586: 		return e
 1587: 	}
 1588: 	if e = checkCurrentBoot(r.Post, o.plan.BusinessSID); e != nil {
 1589: 		return e
 1590: 	}
 1591: 	if e = checkNoOfficialProcess(o.plan); e != nil {
 1592: 		return e
 1593: 	}
 1594: 	if e = checkFence(o.plan, o.holds); e != nil {
 1595: 		return e
 1596: 	}
 1597: 	return checkAncestorControl(o.plan, o.holds)
 1598: }
 1599: 
 1600: func (q *CurrentQuiescence) Close() error {
 1601: 	if q == nil || q.owner == nil {
 1602: 		return errors.New("current quiescence absent")
 1603: 	}
 1604: 	o := q.owner
 1605: 	o.mu.Lock()
 1606: 	defer o.mu.Unlock()
 1607: 	if o.closed {
 1608: 		return errors.New("current quiescence already closed")
 1609: 	}
 1610: 	o.closed = true
 1611: 	err := closeHolds(o.holds)
 1612: 	o.holds = nil
 1613: 	return err
 1614: }
 1615: 
 1616: // MarkCDurable is called only after the outer SQL transaction has actually
 1617: // returned. It reads the independently durable C journal; a caller bool or
 1618: // returned SQL result is insufficient to advance the external fence record.
 1619: func MarkCDurable(ctx context.Context, q *CurrentQuiescence, held *rt.DataRootLease, dataRoot, database, operationID, boundaryPlanSHA256, cPlanDigest string) error {
 1620: 	if q == nil || q.owner == nil {
 1621: 		return errors.New("current quiescence absent")
 1622: 	}
 1623: 	r, err := readRecord(q.owner.plan)
 1624: 	if err != nil {
 1625: 		return err
 1626: 	}
 1627: 	state := r.Events[len(r.Events)-1].State
 1628: 	if state == "BOOT_OBSERVED" {
 1629: 		if err = q.Check(ctx, held, dataRoot, database, operationID, boundaryPlanSHA256); err != nil {
 1630: 			return err
 1631: 		}
 1632: 	} else if state == "C_HELD" {
 1633: 		if err = ctx.Err(); err != nil {
 1634: 			return err
 1635: 		}
 1636: 		if err = managedToken(q.owner.plan); err != nil {
 1637: 			return err
 1638: 		}
 1639: 		q.owner.mu.Lock()
 1640: 		defer q.owner.mu.Unlock()
 1641: 		if q.owner.closed || q.owner.plan.DataRoot.Path != dataRoot || q.owner.plan.Database.Path != database || q.owner.plan.OperationID != operationID || q.owner.plan.PlanSHA256 != boundaryPlanSHA256 {
 1642: 			return errors.New("current quiescence binding stale")
 1643: 		}
 1644: 		if err = q.owner.lease.Matches(held); err != nil {
 1645: 			return err
 1646: 		}
 1647: 		if err = checkHolds(q.owner.holds); err != nil {
 1648: 			return err
 1649: 		}
 1650: 		if err = checkCurrentBoot(q.owner.post, q.owner.plan.BusinessSID); err != nil {
 1651: 			return err
 1652: 		}
 1653: 		if err = checkFence(q.owner.plan, q.owner.holds); err != nil {
 1654: 			return err
 1655: 		}
 1656: 		if err = checkAncestorControl(q.owner.plan, q.owner.holds); err != nil {
 1657: 			return err
 1658: 		}
 1659: 	} else {
 1660: 		return errors.New("boundary not awaiting C durable")
 1661: 	}
 1662: 	if !strings.HasPrefix(cPlanDigest, "sha256:") || !validDigest(strings.TrimPrefix(cPlanDigest, "sha256:")) {
 1663: 		return errors.New("C plan digest invalid")
 1664: 	}
 1665: 	_, status, err := qualificationmaintenancejournal.OpenOwnInspection(dataRoot, qualificationmaintenancejournal.QualificationNamespace, operationID, cPlanDigest)
 1666: 	if err != nil {
 1667: 		return err
 1668: 	}
 1669: 	if !status.Terminal || !status.Applied || status.State != "DURABLE" {
 1670: 		return errors.New("C journal is not durable")
 1671: 	}
 1672: 	if err = qualificationmaintenancejournal.CheckOrdinary(dataRoot); err != nil {
 1673: 		return err
 1674: 	}
 1675: 	r, err = readRecord(q.owner.plan)
 1676: 	if err != nil {
 1677: 		return err
 1678: 	}
 1679: 	if state == "BOOT_OBSERVED" {
 1680: 		if r.Events[len(r.Events)-1].State != "BOOT_OBSERVED" {
 1681: 			return errors.New("boundary state changed before C durable")
 1682: 		}
 1683: 		if err = appendEvent(q.owner.plan, r.Events, "C_HELD"); err != nil {
 1684: 			return err
 1685: 		}
 1686: 		r, err = readRecord(q.owner.plan)
 1687: 		if err != nil {
 1688: 			return err
 1689: 		}
 1690: 	}
 1691: 	if r.Events[len(r.Events)-1].State != "C_HELD" {
 1692: 		return errors.New("boundary C held state changed")
 1693: 	}
 1694: 	return appendEvent(q.owner.plan, r.Events, "C_DURABLE")
 1695: }
 1696: 
 1697: func managedToken(p EntryFencePlan) error {
 1698: 	token := windows.GetCurrentProcessToken()
 1699: 	if !token.IsElevated() {
 1700: 		return errors.New("trusted management elevation required")
 1701: 	}
 1702: 	u, e := token.GetTokenUser()
 1703: 	if e != nil {
 1704: 		return e
 1705: 	}
 1706: 	if u.User.Sid.String() != p.ManagementSID || p.BusinessSID == p.ManagementSID {
 1707: 		return errors.New("management SID cannot be business owner")
 1708: 	}
 1709: 	return nil
 1710: }
 1711: 
 1712: func checkAcceptanceFiles(p EntryFencePlan) error {
 1713: 	dir, e := stateRoot(p)
 1714: 	if e != nil {
 1715: 		return e
 1716: 	}
 1717: 	items := []struct{ name, sha, kind string }{
 1718: 		{"source-accepted.json", p.SourceAcceptanceSHA256, "source"},
 1719: 		{"native-accepted.json", p.NativeAcceptanceSHA256, "native"},
 1720: 		{"backup-verified.json", p.BackupManifestSHA256, "online-backup"},
 1721: 		{"recovery-ready.json", p.RecoveryPackageSHA256, "management-recovery"},
 1722: 	}
 1723: 	for _, item := range items {
 1724: 		raw, identity, e := readManagedFile(filepath.Join(dir, item.name), p.ManagementSID, 16<<10)
 1725: 		if e != nil {
 1726: 			return fmt.Errorf("%s: %w", item.name, e)
 1727: 		}
 1728: 		if identity.SHA256 != item.sha {
 1729: 			return fmt.Errorf("acceptance digest mismatch: %s", item.name)
 1730: 		}
 1731: 		var proof BoundaryAttestation
 1732: 		if e = json.Unmarshal(raw, &proof); e != nil {
 1733: 			return e
 1734: 		}
 1735: 		if e = validateAttestation(p, item.kind, proof); e != nil {
 1736: 			return fmt.Errorf("%s: %w", item.name, e)
 1737: 		}
 1738: 	}
 1739: 	return nil
 1740: }
 1741: 
 1742: func validateAttestation(p EntryFencePlan, kind string, proof BoundaryAttestation) error {
 1743: 	core, e := PlanCoreSHA256(p)
 1744: 	if e != nil || proof.Schema != "researchos.boundary-attestation.v1" || proof.Kind != kind || proof.Status != "ACCEPTED" || proof.OperationID != p.OperationID || proof.PlanCoreSHA256 != core || proof.Issuer == "" || proof.Issuer == p.ManagementSID || !validDigest(proof.EvidenceSHA256) || proof.RecordedUTC.IsZero() {
 1745: 		return errors.New("external acceptance report unqualified")
 1746: 	}
 1747: 	if kind == "online-backup" && (proof.BackupID == "" || !validDigest(proof.RestoreTestSHA256) || !validDigest(proof.CredentialProbeSHA256)) {
 1748: 		return errors.New("online backup has no restoration and credential proof")
 1749: 	}
 1750: 	return nil
 1751: }
 1752: 
 1753: func readFullRestartEvidence(p EntryFencePlan, pre BootWitness, now time.Time) (string, error) {
 1754: 	dir, e := stateRoot(p)
 1755: 	if e != nil {
 1756: 		return "", e
 1757: 	}
 1758: 	path := filepath.Join(dir, "full-restart-complete.json")
 1759: 	raw, identity, e := readManagedFile(path, p.ManagementSID, 16<<10)
 1760: 	if e != nil {
 1761: 		return "", e
 1762: 	}
 1763: 	var evidence struct {
 1764: 		Schema          string    `json:"schema"`
 1765: 		OperationID     string    `json:"operation_id"`
 1766: 		Method          string    `json:"method"`
 1767: 		ConfirmedByUser bool      `json:"confirmed_by_user"`
 1768: 		CompletedUTC    time.Time `json:"completed_utc"`
 1769: 	}
 1770: 	if e = json.Unmarshal(raw, &evidence); e != nil {
 1771: 		return "", e
 1772: 	}
 1773: 	if evidence.Schema != "researchos.full-restart-complete.v1" || evidence.OperationID != p.OperationID || evidence.Method != "FullRestart" || !evidence.ConfirmedByUser || evidence.CompletedUTC.Before(pre.UTC) || evidence.CompletedUTC.After(now) {
 1774: 		return "", errors.New("explicit FullRestart completion evidence invalid")
 1775: 	}
 1776: 	return identity.SHA256, nil
 1777: }
 1778: 
 1779: func fenceDigest(p EntryFencePlan) string {
 1780: 	var parts []string
 1781: 	for _, t := range p.Targets {
 1782: 		parts = append(parts, strings.ToLower(t.File.FinalUTF16)+"\x00"+t.File.FileID+"\x00"+t.InstalledSD+"\x00"+t.InstalledNativeSecuritySHA256)
 1783: 	}
 1784: 	sort.Strings(parts)
 1785: 	return digest([]byte(strings.Join(parts, "\n")))
 1786: }
 1787: 
 1788: func writeExclusiveJSON(path, managementSID string, value any) error {
 1789: 	raw, e := json.Marshal(value)
 1790: 	if e != nil {
 1791: 		return e
 1792: 	}
 1793: 	limit := 256 << 10
 1794: 	if filepath.Base(path) == "plan.json" {
 1795: 		limit = maxBoundaryPlanBytes
 1796: 	}
 1797: 	if len(raw) > limit {
 1798: 		return errors.New("boundary record oversized")
 1799: 	}
 1800: 	sd, e := windows.SecurityDescriptorFromString("O:" + managementSID + "D:P(A;;FA;;;" + managementSID + ")(A;;FA;;;SY)")
 1801: 	if e != nil {
 1802: 		return e
 1803: 	}
 1804: 	if e = checkManagedDescriptor(sd, managementSID); e != nil {
 1805: 		return e
 1806: 	}
 1807: 	ptr, e := windows.UTF16PtrFromString(path)
 1808: 	if e != nil {
 1809: 		return e
 1810: 	}
 1811: 	attributes := windows.SecurityAttributes{SecurityDescriptor: sd}
 1812: 	attributes.Length = uint32(unsafe.Sizeof(attributes))
 1813: 	h, e := windows.CreateFile(ptr, windows.GENERIC_WRITE|windows.READ_CONTROL, windows.FILE_SHARE_READ,
 1814: 		&attributes, windows.CREATE_NEW, windows.FILE_ATTRIBUTE_NORMAL, 0)
 1815: 	if e != nil {
 1816: 		return e
 1817: 	}
 1818: 	closed := false
 1819: 	defer func() {
 1820: 		if !closed {
 1821: 			windows.CloseHandle(h)
 1822: 		}
 1823: 	}()
 1824: 	data := append(raw, '\n')
 1825: 	var n uint32
 1826: 	if e = windows.WriteFile(h, data, &n, nil); e != nil || n != uint32(len(data)) {
 1827: 		return errors.Join(e, errors.New("managed record write incomplete"))
 1828: 	}
 1829: 	if e = windows.FlushFileBuffers(h); e != nil {
 1830: 		return e
 1831: 	}
 1832: 	readback, e := windows.GetSecurityInfo(h, windows.SE_FILE_OBJECT, windows.OWNER_SECURITY_INFORMATION|windows.DACL_SECURITY_INFORMATION)
 1833: 	if e != nil {
 1834: 		return e
 1835: 	}
 1836: 	if e = checkManagedDescriptor(readback, managementSID); e != nil {
 1837: 		return e
 1838: 	}
 1839: 	closed = true
 1840: 	return windows.CloseHandle(h)
 1841: }
 1842: 
 1843: func appendEvent(p EntryFencePlan, events []BoundaryEvent, state string) error {
 1844: 	if e := ValidateEvents(events, p.OperationID, p.PlanSHA256); e != nil && len(events) > 0 {
 1845: 		return e
 1846: 	}
 1847: 	previous, previousHash := "", ""
 1848: 	if len(events) > 0 {
 1849: 		previous = events[len(events)-1].State
 1850: 		previousHash = events[len(events)-1].SHA256
 1851: 	}
 1852: 	if !transition(previous, state) {
 1853: 		return errors.New("boundary phase transition invalid")
 1854: 	}
 1855: 	e := BoundaryEvent{Schema: EventSchema, Sequence: uint64(len(events) + 1), PreviousSHA256: previousHash, OperationID: p.OperationID, PlanSHA256: p.PlanSHA256, State: state, UTC: time.Now().UTC()}
 1856: 	e.SHA256 = digest([]byte(fmt.Sprintf("%s\x00%d\x00%s\x00%s\x00%s\x00%s\x00%s", e.Schema, e.Sequence, e.PreviousSHA256, e.OperationID, e.PlanSHA256, e.State, e.UTC.UTC().Format(time.RFC3339Nano))))
 1857: 	dir, err := stateRoot(p)
 1858: 	if err != nil {
 1859: 		return err
 1860: 	}
 1861: 	return writeExclusiveJSON(filepath.Join(dir, fmt.Sprintf("event-%02d.json", e.Sequence)), p.ManagementSID, e)
 1862: }
 1863: 
 1864: func setTargetDescriptor(expected FileIdentity, desiredSD string, desiredNativeRaw []byte) (outErr error) {
 1865: 	var sd *windows.SECURITY_DESCRIPTOR
 1866: 	var desiredSemantic string
 1867: 	var e error
 1868: 	if len(desiredNativeRaw) > 0 {
 1869: 		desiredSemantic, e = nativeSecuritySemanticSHA256(desiredNativeRaw)
 1870: 		if e != nil {
 1871: 			return e
 1872: 		}
 1873: 		sd = (*windows.SECURITY_DESCRIPTOR)(unsafe.Pointer(&desiredNativeRaw[0]))
 1874: 		if !sd.IsValid() || sd.String() != desiredSD {
 1875: 			return errors.New("desired native security preimage differs from plan SDDL")
 1876: 		}
 1877: 	} else {
 1878: 		sd, e = windows.SecurityDescriptorFromString(desiredSD)
 1879: 		if e != nil {
 1880: 			return e
 1881: 		}
 1882: 		_, desiredSemantic, e = nativeSecurityFromSDDL(desiredSD)
 1883: 		if e != nil {
 1884: 			return e
 1885: 		}
 1886: 	}
 1887: 	owner, _, e := sd.Owner()
 1888: 	if e != nil || owner == nil {
 1889: 		return errors.New("target owner descriptor missing")
 1890: 	}
 1891: 	dacl, _, e := sd.DACL()
 1892: 	if e != nil || dacl == nil {
 1893: 		return errors.Join(e, errors.New("target DACL descriptor missing"))
 1894: 	}
 1895: 	prior, e := windows.SecurityDescriptorFromString(expected.SecurityDescriptor)
 1896: 	if e != nil {
 1897: 		return e
 1898: 	}
 1899: 	priorOwner, _, e := prior.Owner()
 1900: 	if e != nil || priorOwner == nil {
 1901: 		return errors.New("expected target owner descriptor missing")
 1902: 	}
 1903: 	priorControl, _, e := prior.Control()
 1904: 	if e != nil {
 1905: 		return e
 1906: 	}
 1907: 	control, _, e := sd.Control()
 1908: 	if e != nil {
 1909: 		return e
 1910: 	}
 1911: 	if (priorControl&windows.SE_DACL_AUTO_INHERITED != 0) != (control&windows.SE_DACL_AUTO_INHERITED != 0) {
 1912: 		return errors.New("target DACL auto-inheritance class drift")
 1913: 	}
 1914: 	access := uint32(windows.WRITE_DAC)
 1915: 	flags := windows.SECURITY_INFORMATION(windows.DACL_SECURITY_INFORMATION)
 1916: 	if !priorOwner.Equals(owner) {
 1917: 		access |= windows.WRITE_OWNER
 1918: 		flags |= windows.OWNER_SECURITY_INFORMATION
 1919: 	}
 1920: 	hold, e := openNativeAccess(expected.Path, false, true, access)
 1921: 	if e != nil {
 1922: 		return fmt.Errorf("target mutation open READ_CONTROL|READ_DATA|WRITE_DAC plus owner-change access %#x: %w", access, e)
 1923: 	}
 1924: 	defer func() { outErr = errors.Join(outErr, windows.CloseHandle(hold.handle)) }()
 1925: 	if !identityEqual(hold.identity, expected) {
 1926: 		return errors.New("target same-handle native identity or descriptor changed before mutation")
 1927: 	}
 1928: 	if control&windows.SE_DACL_AUTO_INHERITED != 0 {
 1929: 		// SetSecurityInfo retains the auto-inherited class. NtSetSecurityObject
 1930: 		// clears it on this filesystem, so the frozen descriptor selects one
 1931: 		// path before mutation; there is no failure-time fallback.
 1932: 		setFlags := flags | windows.UNPROTECTED_DACL_SECURITY_INFORMATION
 1933: 		if control&windows.SE_DACL_PROTECTED != 0 {
 1934: 			setFlags = flags | windows.PROTECTED_DACL_SECURITY_INFORMATION
 1935: 		}
 1936: 		if e = windows.SetSecurityInfo(hold.handle, windows.SE_FILE_OBJECT, setFlags, owner, nil, dacl, nil); e != nil {
 1937: 			return fmt.Errorf("target mutation SetSecurityInfo owner/DACL: %w", e)
 1938: 		}
 1939: 	} else {
 1940: 		if e = ntSetSecurityObject.Find(); e != nil {
 1941: 			return fmt.Errorf("NtSetSecurityObject unavailable: %w", e)
 1942: 		}
 1943: 		r, _, _ := ntSetSecurityObject.Call(uintptr(hold.handle), uintptr(flags), uintptr(unsafe.Pointer(sd)))
 1944: 		runtime.KeepAlive(sd)
 1945: 		if status := windows.NTStatus(r); status != 0 {
 1946: 			return fmt.Errorf("target mutation NtSetSecurityObject status %#x: %w", uint32(status), status.Errno())
 1947: 		}
 1948: 	}
 1949: 	_, readbackSDDL, readbackSemantic, e := nativeSecurityDescriptor(hold.handle, hold.identity.SACLReadStatus == "READABLE")
 1950: 	if e != nil {
 1951: 		return fmt.Errorf("target mutation GetSecurityInfo readback: %w", e)
 1952: 	}
 1953: 	if readbackSDDL != desiredSD || readbackSemantic != desiredSemantic {
 1954: 		return fmt.Errorf("target descriptor same-handle readback mismatch: expected SDDL %q semantic %s observed SDDL %q semantic %s", desiredSD, desiredSemantic, readbackSDDL, readbackSemantic)
 1955: 	}
 1956: 	v, id, e := nativeFileID(hold.handle)
 1957: 	if e != nil {
 1958: 		return e
 1959: 	}
 1960: 	final, e := finalPath(hold.handle)
 1961: 	if e != nil {
 1962: 		return e
 1963: 	}
 1964: 	if v != expected.Volume || id != expected.FileID || !strings.EqualFold(final, expected.FinalUTF16) {
 1965: 		return errors.New("target native identity changed during ACL mutation")
 1966: 	}
 1967: 	return nil
 1968: }
