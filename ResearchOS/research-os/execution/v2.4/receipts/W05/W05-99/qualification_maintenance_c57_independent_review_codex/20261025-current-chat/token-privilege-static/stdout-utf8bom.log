  141: func openNativeAccess(path string, directory bool, hashFile bool, extraAccess uint32) (nativeHold, error) {
  142: 	if !filepath.IsAbs(path) || filepath.Clean(path) != path {
  143: 		return nativeHold{}, errors.New("native path is not canonical absolute")
  144: 	}
  145: 	if strings.Contains(path[len(filepath.VolumeName(path)):], ":") {
  146: 		return nativeHold{}, errors.New("alternate data stream forbidden")
  147: 	}
  148: 	w, e := windows.UTF16PtrFromString(path)
  149: 	if e != nil {
  150: 		return nativeHold{}, e
  151: 	}
  152: 	// No FILE_SHARE_DELETE: the live owner pins every opened component against
  153: 	// rename/delete until the caller's actual outer transaction has returned.
  154: 	access := uint32(windows.READ_CONTROL | windows.FILE_READ_ATTRIBUTES | windows.FILE_READ_DATA | extraAccess)
  155: 	h, e := windows.CreateFile(w, access|windows.ACCESS_SYSTEM_SECURITY,
  156: 		windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, nil, windows.OPEN_EXISTING,
  157: 		windows.FILE_FLAG_OPEN_REPARSE_POINT|windows.FILE_FLAG_BACKUP_SEMANTICS, 0)
  158: 	saclStatus := "READABLE"
  159: 	var saclUnavailableStage string
  160: 	var saclUnavailableWin32 uint32
  161: 	var saclUnavailableNTSTATUS uint32
  162: 	if errors.Is(e, windows.ERROR_ACCESS_DENIED) || errors.Is(e, windows.ERROR_PRIVILEGE_NOT_HELD) {
  163: 		var errno syscall.Errno
  164: 		if !errors.As(e, &errno) {
  165: 			return nativeHold{}, e
  166: 		}
  167: 		saclUnavailableWin32 = uint32(errno)
  168: 		saclUnavailableStage = "OPEN"
  169: 		saclStatus = "UNAVAILABLE"
  170: 		h, e = windows.CreateFile(w, access,
  171: 			windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, nil, windows.OPEN_EXISTING,
  172: 			windows.FILE_FLAG_OPEN_REPARSE_POINT|windows.FILE_FLAG_BACKUP_SEMANTICS, 0)
  173: 	}
  174: 	if e != nil {
  175: 		return nativeHold{}, e
  176: 	}
  177: 	fail := func(e error) (nativeHold, error) { windows.CloseHandle(h); return nativeHold{}, e }
  178: 	rawSD, sddl, semantic, e := nativeSecurityDescriptor(h, saclStatus == "READABLE")
  179: 	if e != nil && saclStatus == "READABLE" && (errors.Is(e, windows.ERROR_ACCESS_DENIED) || errors.Is(e, windows.ERROR_PRIVILEGE_NOT_HELD)) {
  180: 		var queryErr *nativeSecurityQueryError
  181: 		var errno syscall.Errno
  182: 		if !errors.As(e, &queryErr) || !errors.As(e, &errno) {
  183: 			return fail(e)
  184: 		}
  185: 		saclStatus = "UNAVAILABLE"
  186: 		saclUnavailableStage = "QUERY"
  187: 		saclUnavailableWin32 = uint32(errno)
  188: 		saclUnavailableNTSTATUS = uint32(queryErr.status)
  189: 		if closeErr := windows.CloseHandle(h); closeErr != nil {
  190: 			return nativeHold{}, closeErr
  191: 		}
  192: 		h, e = windows.CreateFile(w, access,
  193: 			windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, nil, windows.OPEN_EXISTING,
  194: 			windows.FILE_FLAG_OPEN_REPARSE_POINT|windows.FILE_FLAG_BACKUP_SEMANTICS, 0)
  195: 		if e != nil {
  196: 			return nativeHold{}, e
  197: 		}
  198: 		rawSD, sddl, semantic, e = nativeSecurityDescriptor(h, false)
  199: 	}
  200: 	if e != nil {
  201: 		return fail(e)
  202: 	}
  203: 	var info windows.ByHandleFileInformation
  204: 	if e = windows.GetFileInformationByHandle(h, &info); e != nil {
  205: 		return fail(e)
  206: 	}
  207: 	if info.FileAttributes&windows.FILE_ATTRIBUTE_REPARSE_POINT != 0 || (info.FileAttributes&windows.FILE_ATTRIBUTE_DIRECTORY != 0) != directory {
  208: 		return fail(errors.New("reparse point or file kind mismatch"))
  209: 	}
  210: 	if !directory && info.NumberOfLinks != 1 {
  211: 		return fail(errors.New("hard-linked boundary file forbidden"))
  212: 	}
  213: 	v, id, e := nativeFileID(h)
  214: 	if e != nil {
  215: 		return fail(e)
  216: 	}
  217: 	final, e := finalPath(h)
  218: 	if e != nil {
  219: 		return fail(e)
  220: 	}
  221: 	x := FileIdentity{Path: path, FinalUTF16: final, Volume: v, FileID: id, SecurityDescriptor: sddl, NativeSecurityDescriptor: rawSD, NativeSecuritySHA256: semantic, SACLReadStatus: saclStatus, SACLUnavailableStage: saclUnavailableStage, SACLUnavailableWin32: saclUnavailableWin32, SACLUnavailableNTSTATUS: saclUnavailableNTSTATUS, Directory: directory}
  222: 	if hashFile {
  223: 		if directory {
  224: 			return fail(errors.New("cannot hash directory"))
  225: 		}
  226: 		s := sha256.New()
  227: 		var total int64
  228: 		buf := make([]byte, 64<<10)
  229: 		for {
  230: 			var n uint32
  231: 			e = windows.ReadFile(h, buf, &n, nil)
  232: 			if e != nil {
  233: 				return fail(e)
  234: 			}
  235: 			if n == 0 {
  236: 				break
  237: 			}
  238: 			total += int64(n)
  239: 			if total > 128<<20 {
  240: 				return fail(errors.New("hash input exceeds bound"))
  241: 			}
  242: 			_, _ = s.Write(buf[:n])
  243: 		}
  244: 		x.SHA256 = hex.EncodeToString(s.Sum(nil))
  245: 	}
  246: 	return nativeHold{path: path, handle: h, identity: x}, nil
  247: }
  248: 
  249: func closeHolds(holds []nativeHold) error {
  250: 	var out error
  251: 	for i := len(holds) - 1; i >= 0; i-- {
  252: 		out = errors.Join(out, windows.CloseHandle(holds[i].handle))
  253: 	}
  254: 	return out
  255: }
  256: 
  257: func identityEqual(a, b FileIdentity) bool {
  258: 	return strings.EqualFold(a.Path, b.Path) && strings.EqualFold(a.FinalUTF16, b.FinalUTF16) && a.Volume == b.Volume && a.FileID == b.FileID && a.SHA256 == b.SHA256 && a.SecurityDescriptor == b.SecurityDescriptor && a.NativeSecuritySHA256 == b.NativeSecuritySHA256 && a.SACLReadStatus == b.SACLReadStatus && a.SACLUnavailableStage == b.SACLUnavailableStage && a.SACLUnavailableWin32 == b.SACLUnavailableWin32 && a.SACLUnavailableNTSTATUS == b.SACLUnavailableNTSTATUS && a.Directory == b.Directory
  259: }
  260: func identityCoreEqual(a, b FileIdentity) bool {
  261: 	a.SecurityDescriptor = ""
  262: 	b.SecurityDescriptor = ""
  263: 	a.NativeSecurityDescriptor = nil
  264: 	b.NativeSecurityDescriptor = nil
  265: 	a.NativeSecuritySHA256 = ""
  266: 	b.NativeSecuritySHA256 = ""
  267: 	return identityEqual(a, b)
  268: }
  269: 
  270: func pathAncestors(path string) []string {
  271: 	var xs []string
  272: 	for p := filepath.Dir(path); ; p = filepath.Dir(p) {
  273: 		xs = append(xs, p)
  274: 		if filepath.Dir(p) == p {
  275: 			break
  276: 		}
  277: 	}
  278: 	for i, j := 0, len(xs)-1; i < j; i, j = i+1, j-1 {
  279: 		xs[i], xs[j] = xs[j], xs[i]
  280: 	}
  281: 	return xs
  282: }
  283: 
  284: func openPlanHolds(p EntryFencePlan) ([]nativeHold, error) {
  285: 	all := []FileIdentity{p.DataRoot, p.Database, p.Helper}
  286: 	all = append(all, p.Ancestors...)
  287: 	for _, t := range p.Targets {
  288: 		all = append(all, t.File)
  289: 	}
  290: 	want := map[string]FileIdentity{}
  291: 	for _, x := range all {
  292: 		semantic, e := nativeSecuritySemanticSHA256(x.NativeSecurityDescriptor)
  293: 		if e != nil || semantic != x.NativeSecuritySHA256 {
  294: 			return nil, fmt.Errorf("native security preimage invalid for %s: %w", x.Path, e)
  295: 		}
  296: 		sd := (*windows.SECURITY_DESCRIPTOR)(unsafe.Pointer(&x.NativeSecurityDescriptor[0]))
  297: 		if !sd.IsValid() || sd.String() != x.SecurityDescriptor {
  298: 			return nil, fmt.Errorf("native security preimage and SDDL disagree for %s", x.Path)
  299: 		}
  300: 		want[strings.ToLower(x.Path)] = x
  301: 	}
  302: 	for _, target := range p.Targets {
  303: 		_, semantic, e := nativeSecurityFromSDDL(target.InstalledSD)
  304: 		if e != nil || semantic != target.InstalledNativeSecuritySHA256 {
  305: 			return nil, fmt.Errorf("installed native descriptor digest invalid for %s: %w", target.File.Path, e)
  306: 		}
  307: 	}
  308: 	for _, x := range all {
  309: 		for _, a := range pathAncestors(x.Path) {
  310: 			if _, ok := want[strings.ToLower(a)]; !ok {
  311: 				return nil, fmt.Errorf("ancestor absent from frozen inventory: %s", a)
  312: 			}
  313: 		}
  314: 	}
  315: 	keys := make([]string, 0, len(want))
  316: 	for k := range want {
  317: 		keys = append(keys, k)
  318: 	}
  319: 	sort.Strings(keys)
  320: 	var holds []nativeHold
  321: 	for _, k := range keys {
  322: 		x := want[k]
  323: 		h, e := openNative(x.Path, x.Directory, !x.Directory)
  324: 		if e != nil {
  325: 			closeHolds(holds)
  326: 			return nil, fmt.Errorf("open boundary identity %s: %w", x.Path, e)
  327: 		}
  328: 		matches := identityEqual(x, h.identity)
  329: 		if !matches {
  330: 			for _, target := range p.Targets {
  331: 				if strings.EqualFold(target.File.Path, x.Path) && identityCoreEqual(x, h.identity) && target.InstalledSD == h.identity.SecurityDescriptor && target.InstalledNativeSecuritySHA256 == h.identity.NativeSecuritySHA256 {
  332: 					matches = true
  333: 					break
  334: 				}
  335: 			}
  336: 		}
  337: 		if !matches {
  338: 			windows.CloseHandle(h.handle)
  339: 			closeHolds(holds)
  340: 			return nil, fmt.Errorf("boundary identity drift: %s", x.Path)
  341: 		}
  342: 		holds = append(holds, h)
  343: 	}
  344: 	return holds, nil
  345: }
  346: 
  347: func checkHolds(holds []nativeHold) error {
  348: 	if len(holds) == 0 {
  349: 		return errors.New("native boundary holds missing")
  350: 	}
  351: 	for _, h := range holds {
  352: 		fresh, e := openNative(h.path, h.identity.Directory, !h.identity.Directory)
  353: 		if e != nil {
  354: 			return e
  355: 		}
  356: 		same := identityEqual(h.identity, fresh.identity)
  357: 		if e = windows.CloseHandle(fresh.handle); e != nil {
  358: 			return e
  359: 		}
  360: 		if !same {
  361: 			return fmt.Errorf("native boundary identity changed: %s", h.path)
  362: 		}
  363: 	}
  364: 	return nil
  365: }
