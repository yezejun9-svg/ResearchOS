  108: func nativeFileID(h windows.Handle) (uint64, string, error) {
  109: 	var x struct {
  110: 		VolumeSerialNumber uint64
  111: 		FileID             [16]byte
  112: 	}
  113: 	if err := windows.GetFileInformationByHandleEx(h, windows.FileIdInfo, (*byte)(unsafe.Pointer(&x)), uint32(unsafe.Sizeof(x))); err != nil {
  114: 		return 0, "", err
  115: 	}
  116: 	return x.VolumeSerialNumber, hex.EncodeToString(x.FileID[:]), nil
  117: }
