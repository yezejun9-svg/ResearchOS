  119: func finalPath(h windows.Handle) (string, error) {
  120: 	buf := make([]uint16, 512)
  121: 	for len(buf) <= 32768 {
  122: 		n, e := windows.GetFinalPathNameByHandle(h, &buf[0], uint32(len(buf)), 0)
  123: 		if e != nil {
  124: 			return "", e
  125: 		}
  126: 		if n == 0 {
  127: 			return "", errors.New("empty final path")
  128: 		}
  129: 		if int(n) < len(buf) {
  130: 			return windows.UTF16ToString(buf[:n]), nil
  131: 		}
  132: 		buf = make([]uint16, int(n)+1)
  133: 	}
  134: 	return "", errors.New("final path exceeds Windows bound")
  135: }
