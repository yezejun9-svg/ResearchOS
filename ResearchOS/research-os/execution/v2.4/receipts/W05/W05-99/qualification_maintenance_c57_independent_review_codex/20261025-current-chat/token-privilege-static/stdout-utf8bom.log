 1970: func checkNoOfficialProcess(p EntryFencePlan) error {
 1971: 	snapshot, e := windows.CreateToolhelp32Snapshot(windows.TH32CS_SNAPPROCESS, 0)
 1972: 	if e != nil {
 1973: 		return e
 1974: 	}
 1975: 	defer windows.CloseHandle(snapshot)
 1976: 	var entry windows.ProcessEntry32
 1977: 	entry.Size = uint32(unsafe.Sizeof(entry))
 1978: 	if e = windows.Process32First(snapshot, &entry); e != nil {
 1979: 		return e
 1980: 	}
 1981: 	for {
 1982: 		name := windows.UTF16ToString(entry.ExeFile[:])
 1983: 		for _, t := range p.Targets {
 1984: 			if t.Mode != "executable" || !strings.EqualFold(name, filepath.Base(t.File.Path)) {
 1985: 				continue
 1986: 			}
 1987: 			proc, err := windows.OpenProcess(windows.PROCESS_QUERY_LIMITED_INFORMATION, false, entry.ProcessID)
 1988: 			if err != nil {
 1989: 				return fmt.Errorf("candidate official process inaccessible: %w", err)
 1990: 			}
 1991: 			buf := make([]uint16, 32768)
 1992: 			n := uint32(len(buf))
 1993: 			err = windows.QueryFullProcessImageName(proc, 0, &buf[0], &n)
 1994: 			closeErr := windows.CloseHandle(proc)
 1995: 			if err != nil || closeErr != nil {
 1996: 				return errors.Join(err, closeErr)
 1997: 			}
 1998: 			if strings.EqualFold(windows.UTF16ToString(buf[:n]), t.File.Path) {
 1999: 				return errors.New("official entry process remains live")
 2000: 			}
 2001: 		}
 2002: 		e = windows.Process32Next(snapshot, &entry)
 2003: 		if errors.Is(e, windows.ERROR_NO_MORE_FILES) {
 2004: 			break
 2005: 		}
 2006: 		if e != nil {
 2007: 			return e
 2008: 		}
 2009: 	}
 2010: 	return nil
 2011: }
 2012: 
 2013: func checkRestartRegistrations(p EntryFencePlan) error {
 2014: 	snapshot, e := windows.CreateToolhelp32Snapshot(windows.TH32CS_SNAPPROCESS, 0)
 2015: 	if e != nil {
 2016: 		return e
 2017: 	}
 2018: 	defer windows.CloseHandle(snapshot)
 2019: 	var entry windows.ProcessEntry32
 2020: 	entry.Size = uint32(unsafe.Sizeof(entry))
 2021: 	if e = windows.Process32First(snapshot, &entry); e != nil {
 2022: 		return e
 2023: 	}
 2024: 	for {
 2025: 		name := windows.UTF16ToString(entry.ExeFile[:])
 2026: 		for _, t := range p.Targets {
 2027: 			if t.Mode != "executable" || !strings.EqualFold(name, filepath.Base(t.File.Path)) {
 2028: 				continue
 2029: 			}
 2030: 			proc, err := windows.OpenProcess(windows.PROCESS_QUERY_LIMITED_INFORMATION|windows.PROCESS_VM_READ, false, entry.ProcessID)
 2031: 			if err != nil {
 2032: 				return fmt.Errorf("official restart candidate inaccessible: %w", err)
 2033: 			}
 2034: 			buf := make([]uint16, 32768)
 2035: 			n := uint32(len(buf))
 2036: 			err = windows.QueryFullProcessImageName(proc, 0, &buf[0], &n)
 2037: 			if err != nil {
 2038: 				windows.CloseHandle(proc)
 2039: 				return err
 2040: 			}
 2041: 			if strings.EqualFold(windows.UTF16ToString(buf[:n]), t.File.Path) {
 2042: 				args, _, registered, readErr := restartSettingsForProcess(proc)
 2043: 				if readErr != nil {
 2044: 					windows.CloseHandle(proc)
 2045: 					return readErr
 2046: 				}
 2047: 				if registered {
 2048: 					match := false
 2049: 					for _, sha := range t.RestartArgsSHA256 {
 2050: 						if sha == digest([]byte(args)) {
 2051: 							match = true
 2052: 							break
 2053: 						}
 2054: 					}
 2055: 					if !match {
 2056: 						windows.CloseHandle(proc)
 2057: 						return errors.New("runtime RestartApps argv outside frozen entry inventory")
 2058: 					}
 2059: 				}
 2060: 			}
 2061: 			if err = windows.CloseHandle(proc); err != nil {
 2062: 				return err
 2063: 			}
 2064: 		}
 2065: 		e = windows.Process32Next(snapshot, &entry)
 2066: 		if errors.Is(e, windows.ERROR_NO_MORE_FILES) {
 2067: 			break
 2068: 		}
 2069: 		if e != nil {
 2070: 			return e
 2071: 		}
 2072: 	}
 2073: 	return nil
 2074: }
 2075: 
 2076: // RunPhase is the fixed management helper state machine. The caller supplies
 2077: // only the exact root/operation/plan selector, never SQL or a target path.
 2078: func RunPhase(ctx context.Context, phase, dataRoot, operationID, planSHA256 string) (stateOut string, errOut error) {
 2079: 	if e := ctx.Err(); e != nil {
 2080: 		return "", e
 2081: 	}
 2082: 	if phase != "plan" && phase != "arm" && phase != "observe" && phase != "status" && phase != "disarm-request" {
 2083: 		return "", errors.New("unsupported boundary phase")
 2084: 	}
 2085: 	if !filepath.IsAbs(dataRoot) || filepath.Clean(dataRoot) != dataRoot || !validOperation(operationID) || !validDigest(planSHA256) {
 2086: 		return "", errors.New("boundary selector invalid")
 2087: 	}
 2088: 	p, e := discoverPlan(dataRoot, operationID, planSHA256)
 2089: 	if e != nil {
 2090: 		return "", e
 2091: 	}
 2092: 	if e = ValidatePlan(p); e != nil {
 2093: 		return "", e
 2094: 	}
 2095: 	dir, e := stateRoot(p)
 2096: 	if e != nil {
 2097: 		return "", e
 2098: 	}
 2099: 	if e = checkManagedChain(p); e != nil {
 2100: 		return "", e
 2101: 	}
 2102: 	if e = checkAcceptanceFiles(p); e != nil {
 2103: 		return "", e
 2104: 	}
 2105: 	if phase == "plan" {
 2106: 		if e = managedToken(p); e != nil {
 2107: 			return "", e
 2108: 		}
 2109: 		entries, e := os.ReadDir(dir)
 2110: 		if e != nil {
 2111: 			return "", e
 2112: 		}
 2113: 		if len(entries) != 5 {
 2114: 			return "", errors.New("plan staging inventory not exact")
 2115: 		}
 2116: 		holds, e := openPlanHolds(p)
 2117: 		if e != nil {
 2118: 			return "", e
 2119: 		}
 2120: 		defer func() { errOut = errors.Join(errOut, closeHolds(holds)) }()
 2121: 		if e = checkAncestorControl(p, holds); e != nil {
 2122: 			return "", e
 2123: 		}
 2124: 		for _, t := range p.Targets {
 2125: 			expected, e := denyDescriptor(t.File.SecurityDescriptor, p.BusinessSID, p.ManagementSID, t.Mode)
 2126: 			if e != nil || expected != t.InstalledSD {
 2127: 				return "", errors.New("fence descriptor plan mismatch")
 2128: 			}
 2129: 			_, installedNative, e := nativeSecurityFromSDDL(expected)
 2130: 			if e != nil || installedNative != t.InstalledNativeSecuritySHA256 {
 2131: 				return "", errors.New("fence native semantic plan mismatch")
 2132: 			}
 2133: 		}
 2134: 		pre, e := witness(p, fenceDigest(p))
 2135: 		if e != nil {
 2136: 			return "", e
 2137: 		}
 2138: 		pre.BusinessEnabledSIDsSHA256, e = businessEnabledGroupDigest(p)
 2139: 		if e != nil {
 2140: 			return "", e
 2141: 		}
 2142: 		shape, e := captureOfficialBusinessToken(p, pre.BusinessEnabledSIDsSHA256)
 2143: 		if e != nil {
 2144: 			return "", e
 2145: 		}
 2146: 		pre.BusinessSessionID = shape.SessionID
 2147: 		pre.BusinessElevationType = shape.ElevationType
 2148: 		pre.BusinessIntegritySID = shape.IntegritySID
 2149: 		pre.BusinessLogonSID = shape.LogonSID
 2150: 		pre.BusinessPrivilegesSHA256 = shape.PrivilegesSHA256
 2151: 		pre.BusinessProcessPID = shape.ProcessID
 2152: 		pre.BusinessProcessCreatedUTC = shape.ProcessCreated
 2153: 		pre.BusinessProcessImageSHA256 = shape.ProcessImageSHA
 2154: 		if pre.UptimeMilliseconds < uint64(MaxPostUptime/time.Millisecond) {
 2155: 			return "", errors.New("pre uptime insufficient")
 2156: 		}
 2157: 		if e = writeExclusiveJSON(filepath.Join(dir, "pre.json"), p.ManagementSID, pre); e != nil {
 2158: 			return "", e
 2159: 		}
 2160: 		if e = appendEvent(p, nil, "PREPARED"); e != nil {
 2161: 			return "", e
 2162: 		}
 2163: 		return "PREPARED", nil
 2164: 	}
 2165: 	r, e := readRecord(p)
 2166: 	if e != nil {
 2167: 		return "", e
 2168: 	}
 2169: 	state := r.Events[len(r.Events)-1].State
 2170: 	if phase == "status" {
 2171: 		return state, nil
 2172: 	}
 2173: 	if e = managedToken(p); e != nil {
 2174: 		return "", e
 2175: 	}
 2176: 	switch phase {
 2177: 	case "arm":
 2178: 		if state != "PREPARED" {
 2179: 			return "", errors.New("arm requires PREPARED")
 2180: 		}
 2181: 		if e = checkPreCurrent(r.Pre, p.BusinessSID); e != nil {
 2182: 			return "", e
 2183: 		}
 2184: 		if e = checkRestartRegistrations(p); e != nil {
 2185: 			return "", e
 2186: 		}
 2187: 		holds, e := openPlanHolds(p)
 2188: 		if e != nil {
 2189: 			return "", e
 2190: 		}
 2191: 		defer func() { errOut = errors.Join(errOut, closeHolds(holds)) }()
 2192: 		if e = checkAncestorControl(p, holds); e != nil {
 2193: 			return "", e
 2194: 		}
 2195: 		if e = preflightManagementRestore(p); e != nil {
 2196: 			return "", e
 2197: 		}
 2198: 		if e = appendEvent(p, r.Events, "APPLYING"); e != nil {
 2199: 			return "", e
 2200: 		}
 2201: 		for _, t := range p.Targets {
 2202: 			if e = setTargetDescriptor(t.File, t.InstalledSD, nil); e != nil {
 2203: 				return "", e
 2204: 			}
 2205: 			h, e := openNativeAccess(t.File.Path, false, true, windows.WRITE_DAC|windows.WRITE_OWNER)
 2206: 			if e != nil {
 2207: 				return "", e
 2208: 			}
 2209: 			ok := identityCoreEqual(t.File, h.identity) && h.identity.SecurityDescriptor == t.InstalledSD && h.identity.NativeSecuritySHA256 == t.InstalledNativeSecuritySHA256
 2210: 			closeErr := windows.CloseHandle(h.handle)
 2211: 			if closeErr != nil {
 2212: 				return "", closeErr
 2213: 			}
 2214: 			if !ok {
 2215: 				return "", errors.New("arm native readback mismatch")
 2216: 			}
 2217: 		}
 2218: 		r, e = readRecord(p)
 2219: 		if e != nil {
 2220: 			return "", e
 2221: 		}
 2222: 		if e = appendEvent(p, r.Events, "ARMED"); e != nil {
 2223: 			return "", e
 2224: 		}
 2225: 		return "ARMED", nil
 2226: 	case "observe":
 2227: 		if state != "ARMED" {
 2228: 			return "", errors.New("observe requires ARMED")
 2229: 		}
 2230: 		holds, e := openPlanHolds(p)
 2231: 		if e != nil {
 2232: 			return "", e
 2233: 		}
 2234: 		defer func() { errOut = errors.Join(errOut, closeHolds(holds)) }()
 2235: 		if e = checkFence(p, holds); e != nil {
 2236: 			return "", e
 2237: 		}
 2238: 		if e = checkAncestorControl(p, holds); e != nil {
 2239: 			return "", e
 2240: 		}
 2241: 		if e = checkNoOfficialProcess(p); e != nil {
 2242: 			return "", e
 2243: 		}
 2244: 		post, e := witness(p, fenceDigest(p))
 2245: 		if e != nil {
 2246: 			return "", e
 2247: 		}
 2248: 		currentBusiness, e := inspectExistingBusinessProcess(p, r.Pre.BusinessEnabledSIDsSHA256, r.Pre)
 2249: 		if e != nil {
 2250: 			return "", e
 2251: 		}
 2252: 		post.BusinessEnabledSIDsSHA256 = currentBusiness.GroupsSHA256
 2253: 		post.BusinessSessionID = currentBusiness.SessionID
 2254: 		post.BusinessElevationType = currentBusiness.ElevationType
 2255: 		post.BusinessIntegritySID = currentBusiness.IntegritySID
 2256: 		post.BusinessLogonSID = currentBusiness.LogonSID
 2257: 		post.BusinessPrivilegesSHA256 = currentBusiness.PrivilegesSHA256
 2258: 		post.BusinessProcessPID = currentBusiness.ProcessID
 2259: 		post.BusinessProcessCreatedUTC = currentBusiness.ProcessCreated
 2260: 		post.BusinessProcessImageSHA256 = currentBusiness.ProcessImageSHA
 2261: 		post.FullRestartEvidenceSHA256, e = readFullRestartEvidence(p, r.Pre, post.UTC)
 2262: 		if e != nil {
 2263: 			return "", e
 2264: 		}
 2265: 		if e = ValidateRestart(r.Pre, post); e != nil {
 2266: 			return "", e
 2267: 		}
 2268: 		if e = writeExclusiveJSON(filepath.Join(dir, "post.json"), p.ManagementSID, post); e != nil {
 2269: 			return "", e
 2270: 		}
 2271: 		if e = appendEvent(p, r.Events, "BOOT_OBSERVED"); e != nil {
 2272: 			return "", e
 2273: 		}
 2274: 		return "BOOT_OBSERVED", nil
 2275: 	case "disarm-request":
 2276: 		if state == "PREPARED" || state == "APPLYING" || state == "ARMED" || state == "BOOT_OBSERVED" {
 2277: 			// The only abort path is a proven pre-BEGIN path under the same
 2278: 			// exclusive root lock used by C. Any journal, even malformed or
 2279: 			// terminal, requires exact C recovery rather than a no-effect claim.
 2280: 			lease, leaseErr := rt.AcquireDataRootLease(p.DataRoot.Path)
 2281: 			if leaseErr != nil {
 2282: 				return "", leaseErr
 2283: 			}
 2284: 			defer func() { errOut = errors.Join(errOut, lease.Close()) }()
 2285: 			ownJournal := filepath.Join(p.DataRoot.Path, "host", qualificationmaintenancejournal.QualificationNamespace, p.OperationID)
 2286: 			if _, statErr := os.Lstat(ownJournal); statErr == nil {
 2287: 				return "", errors.New("C journal exists; pre-BEGIN abort forbidden")
 2288: 			} else if !errors.Is(statErr, os.ErrNotExist) {
 2289: 				return "", statErr
 2290: 			}
 2291: 			if e = qualificationmaintenancejournal.CheckOrdinary(p.DataRoot.Path); e != nil {
 2292: 				return "", e
 2293: 			}
 2294: 			if e = appendEvent(p, r.Events, "BOUNDARY_ABORTED"); e != nil {
 2295: 				return "", e
 2296: 			}
 2297: 			r, e = readRecord(p)
 2298: 			if e != nil {
 2299: 				return "", e
 2300: 			}
 2301: 			state = "BOUNDARY_ABORTED"
 2302: 		}
 2303: 		if state != "C_DURABLE" && state != "BOUNDARY_ABORTED" && state != "DISARMING" {
 2304: 			return "", errors.New("disarm requires durable C or explicit boundary abort")
 2305: 		}
 2306: 		if state == "C_DURABLE" {
 2307: 			if e = checkExactCDurable(p); e != nil {
 2308: 				return "", e
 2309: 			}
 2310: 		}
 2311: 		if state == "DISARMING" {
 2312: 			// A resumable partial restore is only legal if the earlier event
 2313: 			// records a durable C or explicit, non-success abort.
 2314: 			if len(r.Events) < 2 || (r.Events[len(r.Events)-2].State != "C_DURABLE" && r.Events[len(r.Events)-2].State != "BOUNDARY_ABORTED") {
 2315: 				return "", errors.New("disarm predecessor invalid")
 2316: 			}
 2317: 			if r.Events[len(r.Events)-2].State == "C_DURABLE" {
 2318: 				if e = checkExactCDurable(p); e != nil {
 2319: 					return "", e
 2320: 				}
 2321: 			}
 2322: 		}
 2323: 		holds, e := openPlanHolds(p)
 2324: 		if e != nil {
 2325: 			return "", e
 2326: 		}
 2327: 		defer func() { errOut = errors.Join(errOut, closeHolds(holds)) }()
 2328: 		if e = checkAncestorControl(p, holds); e != nil {
 2329: 			return "", e
 2330: 		}
 2331: 		byPath := map[string]FileIdentity{}
 2332: 		for _, h := range holds {
 2333: 			byPath[strings.ToLower(h.path)] = h.identity
 2334: 		}
 2335: 		for _, t := range p.Targets {
 2336: 			x := byPath[strings.ToLower(t.File.Path)]
 2337: 			if !identityCoreEqual(x, t.File) || (x.SecurityDescriptor != t.File.SecurityDescriptor || x.NativeSecuritySHA256 != t.File.NativeSecuritySHA256) && (x.SecurityDescriptor != t.InstalledSD || x.NativeSecuritySHA256 != t.InstalledNativeSecuritySHA256) {
 2338: 				return "", errors.New("disarm target differs from exact before/installed descriptor")
 2339: 			}
 2340: 		}
