1711: func appendEvent(p EntryFencePlan, events []BoundaryEvent, state string) error {
1712: 	if e := ValidateEvents(events, p.OperationID, p.PlanSHA256); e != nil && len(events) > 0 {
1713: 		return e
1714: 	}
1715: 	previous, previousHash := "", ""
1716: 	if len(events) > 0 {
1717: 		previous = events[len(events)-1].State
1718: 		previousHash = events[len(events)-1].SHA256
1719: 	}
1720: 	if !transition(previous, state) {
1721: 		return errors.New("boundary phase transition invalid")
1722: 	}
1723: 	e := BoundaryEvent{Schema: EventSchema, Sequence: uint64(len(events) + 1), PreviousSHA256: previousHash, OperationID: p.OperationID, PlanSHA256: p.PlanSHA256, State: state, UTC: time.Now().UTC()}
1724: 	e.SHA256 = digest([]byte(fmt.Sprintf("%s\x00%d\x00%s\x00%s\x00%s\x00%s\x00%s", e.Schema, e.Sequence, e.PreviousSHA256, e.OperationID, e.PlanSHA256, e.State, e.UTC.UTC().Format(time.RFC3339Nano))))
1725: 	dir, err := stateRoot(p)
1726: 	if err != nil {
1727: 		return err
1728: 	}
1729: 	return writeExclusiveJSON(filepath.Join(dir, fmt.Sprintf("event-%02d.json", e.Sequence)), p.ManagementSID, e)
1730: }
