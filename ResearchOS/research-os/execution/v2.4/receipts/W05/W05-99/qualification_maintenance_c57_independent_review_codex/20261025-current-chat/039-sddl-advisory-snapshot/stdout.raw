1211: 	if e != nil {
1212: 		return "", e
1213: 	}
1214: 	sd, e := windows.SecurityDescriptorFromString(original)
1215: 	if e != nil {
1216: 		return "", e
1217: 	}
1218: 	old, _, e := sd.DACL()
1219: 	if e != nil {
1220: 		return "", e
1221: 	}
1222: 	mask := windows.ACCESS_MASK(windows.FILE_EXECUTE)
1223: 	if mode == "script" {
1224: 		mask = windows.ACCESS_MASK(windows.FILE_READ_DATA)
1225: 	} else if mode != "executable" {
1226: 		return "", errors.New("unknown target mode")
1227: 	}
1228: 	if managementSID != sidText {
1229: 		mask |= windows.ACCESS_MASK(windows.WRITE_DAC | windows.WRITE_OWNER | windows.DELETE | windows.FILE_WRITE_DATA | windows.FILE_APPEND_DATA)
1230: 	}
1231: 	ace := windows.EXPLICIT_ACCESS{AccessPermissions: mask, AccessMode: windows.DENY_ACCESS, Inheritance: windows.NO_INHERITANCE,
1232: 		Trustee: windows.TRUSTEE{TrusteeForm: windows.TRUSTEE_IS_SID, TrusteeType: windows.TRUSTEE_IS_USER, TrusteeValue: windows.TrusteeValueFromSID(sid)}}
1233: 	entries := []windows.EXPLICIT_ACCESS{ace}
1234: 	if managementSID != sidText {
1235: 		manager, e := windows.StringToSid(managementSID)
1236: 		if e != nil {
1237: 			return "", e
1238: 		}
1239: 		entries = append(entries, windows.EXPLICIT_ACCESS{AccessPermissions: windows.ACCESS_MASK(windows.FILE_READ_DATA | windows.FILE_READ_ATTRIBUTES | windows.READ_CONTROL | windows.WRITE_DAC | windows.WRITE_OWNER), AccessMode: windows.GRANT_ACCESS, Inheritance: windows.NO_INHERITANCE,
1240: 			Trustee: windows.TRUSTEE{TrusteeForm: windows.TRUSTEE_IS_SID, TrusteeType: windows.TRUSTEE_IS_USER, TrusteeValue: windows.TrusteeValueFromSID(manager)}})
1241: 	}
1242: 	acl, e := windows.ACLFromEntries(entries, old)
1243: 	if e != nil {
1244: 		return "", e
1245: 	}
1246: 	// Protecting a DACL makes formerly inherited ACEs explicit on the object.
1247: 	// Normalize the planned descriptor to the native readback representation.
1248: 	for i := uint32(0); i < uint32(acl.AceCount); i++ {
1249: 		var item *windows.ACCESS_ALLOWED_ACE
1250: 		if e = windows.GetAce(acl, i, &item); e != nil {
1251: 			return "", e
1252: 		}
1253: 		item.Header.AceFlags &^= windows.INHERITED_ACE
1254: 	}
1255: 	abs, e := sd.ToAbsolute()
1256: 	if e != nil {
1257: 		return "", e
1258: 	}
1259: 	if managementSID != sidText {
1260: 		manager, e := windows.StringToSid(managementSID)
1261: 		if e != nil {
1262: 			return "", e
1263: 		}
1264: 		if e = abs.SetOwner(manager, false); e != nil {
1265: 			return "", e
1266: 		}
1267: 	}
1268: 	if e = abs.SetDACL(acl, true, false); e != nil {
1269: 		return "", e
1270: 	}
1271: 	if e = abs.SetControl(windows.SE_DACL_PROTECTED, windows.SE_DACL_PROTECTED); e != nil {
1272: 		return "", e
1273: 	}
1274: 	installed, e := abs.ToSelfRelative()
1275: 	if e != nil {
1276: 		return "", e
1277: 	}
1278: 	return installed.String(), nil
1279: }
