1660: func writeExclusiveJSON(path, managementSID string, value any) error {
1661: 	raw, e := json.Marshal(value)
1662: 	if e != nil {
1663: 		return e
1664: 	}
1665: 	if len(raw) > 256<<10 {
1666: 		return errors.New("boundary record oversized")
1667: 	}
1668: 	sd, e := windows.SecurityDescriptorFromString("O:" + managementSID + "D:P(A;;FA;;;" + managementSID + ")(A;;FA;;;SY)")
1669: 	if e != nil {
1670: 		return e
1671: 	}
1672: 	if e = checkManagedDescriptor(sd, managementSID); e != nil {
1673: 		return e
1674: 	}
1675: 	ptr, e := windows.UTF16PtrFromString(path)
1676: 	if e != nil {
1677: 		return e
1678: 	}
1679: 	attributes := windows.SecurityAttributes{SecurityDescriptor: sd}
1680: 	attributes.Length = uint32(unsafe.Sizeof(attributes))
1681: 	h, e := windows.CreateFile(ptr, windows.GENERIC_WRITE|windows.READ_CONTROL, windows.FILE_SHARE_READ,
1682: 		&attributes, windows.CREATE_NEW, windows.FILE_ATTRIBUTE_NORMAL, 0)
1683: 	if e != nil {
1684: 		return e
1685: 	}
1686: 	closed := false
1687: 	defer func() {
1688: 		if !closed {
1689: 			windows.CloseHandle(h)
1690: 		}
1691: 	}()
1692: 	data := append(raw, '\n')
1693: 	var n uint32
1694: 	if e = windows.WriteFile(h, data, &n, nil); e != nil || n != uint32(len(data)) {
1695: 		return errors.Join(e, errors.New("managed record write incomplete"))
1696: 	}
1697: 	if e = windows.FlushFileBuffers(h); e != nil {
1698: 		return e
1699: 	}
1700: 	readback, e := windows.GetSecurityInfo(h, windows.SE_FILE_OBJECT, windows.OWNER_SECURITY_INFORMATION|windows.DACL_SECURITY_INFORMATION)
1701: 	if e != nil {
1702: 		return e
1703: 	}
1704: 	if e = checkManagedDescriptor(readback, managementSID); e != nil {
1705: 		return e
1706: 	}
1707: 	closed = true
1708: 	return windows.CloseHandle(h)
1709: }
