1625: func readFullRestartEvidence(p EntryFencePlan, pre BootWitness, now time.Time) (string, error) {
1626: 	dir, e := stateRoot(p)
1627: 	if e != nil {
1628: 		return "", e
1629: 	}
1630: 	path := filepath.Join(dir, "full-restart-complete.json")
1631: 	raw, identity, e := readManagedFile(path, p.ManagementSID, 16<<10)
1632: 	if e != nil {
1633: 		return "", e
1634: 	}
1635: 	var evidence struct {
1636: 		Schema          string    `json:"schema"`
1637: 		OperationID     string    `json:"operation_id"`
1638: 		Method          string    `json:"method"`
1639: 		ConfirmedByUser bool      `json:"confirmed_by_user"`
1640: 		CompletedUTC    time.Time `json:"completed_utc"`
1641: 	}
1642: 	if e = json.Unmarshal(raw, &evidence); e != nil {
1643: 		return "", e
1644: 	}
1645: 	if evidence.Schema != "researchos.full-restart-complete.v1" || evidence.OperationID != p.OperationID || evidence.Method != "FullRestart" || !evidence.ConfirmedByUser || evidence.CompletedUTC.Before(pre.UTC) || evidence.CompletedUTC.After(now) {
1646: 		return "", errors.New("explicit FullRestart completion evidence invalid")
1647: 	}
1648: 	return identity.SHA256, nil
1649: }
