1058: func preflightManagementRestore(p EntryFencePlan) error {
1059: 	for _, t := range p.Targets {
1060: 		original, e := windows.SecurityDescriptorFromString(t.File.SecurityDescriptor)
1061: 		if e != nil {
1062: 			return e
1063: 		}
1064: 		owner, _, e := original.Owner()
1065: 		if e != nil || owner == nil {
1066: 			return errors.New("original target owner unavailable for restore preflight")
1067: 		}
1068: 		access := uint32(windows.WRITE_DAC)
1069: 		if owner.String() != p.ManagementSID {
1070: 			access |= windows.WRITE_OWNER
1071: 		}
1072: 		h, e := openNativeAccess(t.File.Path, false, true, access)
1073: 		if e != nil {
1074: 			return fmt.Errorf("management cannot open target for reversible ACL operation: %w", e)
1075: 		}
1076: 		matched := identityEqual(h.identity, t.File)
1077: 		closeErr := windows.CloseHandle(h.handle)
1078: 		if closeErr != nil {
1079: 			return closeErr
1080: 		}
1081: 		if !matched {
1082: 			return errors.New("management ACL preflight target identity drift")
1083: 		}
1084: 		if owner.String() != p.ManagementSID {
1085: 			if e = ensureOwnerRestorable(p.ManagementSID, owner); e != nil {
1086: 				return fmt.Errorf("management cannot restore original owner before APPLYING: %w", e)
1087: 			}
1088: 		}
1089: 	}
1090: 	return nil
1091: }
