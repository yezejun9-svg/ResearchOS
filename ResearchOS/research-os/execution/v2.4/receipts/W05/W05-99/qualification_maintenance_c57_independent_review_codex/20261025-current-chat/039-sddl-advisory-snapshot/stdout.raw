1093: func ownerAssignableWithoutRestore(token windows.Token, owner *windows.SID) (bool, error) {
1094: 	user, err := token.GetTokenUser()
1095: 	if err != nil {
1096: 		return false, err
1097: 	}
1098: 	if user.User.Sid.Equals(owner) {
1099: 		return true, nil
1100: 	}
1101: 	groups, err := token.GetTokenGroups()
1102: 	if err != nil {
1103: 		return false, err
1104: 	}
1105: 	for _, group := range groups.AllGroups() {
1106: 		if group.Sid.Equals(owner) && group.Attributes&windows.SE_GROUP_OWNER != 0 && group.Attributes&windows.SE_GROUP_ENABLED != 0 && group.Attributes&windows.SE_GROUP_USE_FOR_DENY_ONLY == 0 {
1107: 			return true, nil
1108: 		}
1109: 	}
1110: 	return false, nil
1111: }
