1732: func setTargetDescriptor(expected FileIdentity, desiredSD string) (outErr error) {
1733: 	sd, e := windows.SecurityDescriptorFromString(desiredSD)
1734: 	if e != nil {
1735: 		return e
1736: 	}
1737: 	owner, _, e := sd.Owner()
1738: 	if e != nil || owner == nil {
1739: 		return errors.New("target owner descriptor missing")
1740: 	}
1741: 	dacl, _, e := sd.DACL()
1742: 	if e != nil {
1743: 		return e
1744: 	}
1745: 	control, _, e := sd.Control()
1746: 	if e != nil {
1747: 		return e
1748: 	}
1749: 	flags := windows.SECURITY_INFORMATION(windows.DACL_SECURITY_INFORMATION | windows.UNPROTECTED_DACL_SECURITY_INFORMATION)
1750: 	if control&windows.SE_DACL_PROTECTED != 0 {
1751: 		flags = windows.SECURITY_INFORMATION(windows.DACL_SECURITY_INFORMATION | windows.PROTECTED_DACL_SECURITY_INFORMATION)
1752: 	}
1753: 	prior, e := windows.SecurityDescriptorFromString(expected.SecurityDescriptor)
1754: 	if e != nil {
1755: 		return e
1756: 	}
1757: 	priorOwner, _, e := prior.Owner()
1758: 	if e != nil || priorOwner == nil {
1759: 		return errors.New("expected target owner descriptor missing")
1760: 	}
1761: 	access := uint32(windows.WRITE_DAC)
1762: 	if !priorOwner.Equals(owner) {
1763: 		access |= windows.WRITE_OWNER
1764: 		flags |= windows.OWNER_SECURITY_INFORMATION
1765: 	}
1766: 	hold, e := openNativeAccess(expected.Path, false, true, access)
1767: 	if e != nil {
1768: 		return fmt.Errorf("target mutation open READ_CONTROL|READ_DATA|WRITE_DAC plus owner-change access %#x: %w", access, e)
1769: 	}
1770: 	defer func() { outErr = errors.Join(outErr, windows.CloseHandle(hold.handle)) }()
1771: 	if !identityEqual(hold.identity, expected) {
1772: 		return errors.New("target same-handle native identity or descriptor changed before mutation")
1773: 	}
1774: 	if e = windows.SetSecurityInfo(hold.handle, windows.SE_FILE_OBJECT, flags, owner, nil, dacl, nil); e != nil {
1775: 		return fmt.Errorf("target mutation SetSecurityInfo owner/DACL: %w", e)
1776: 	}
1777: 	readback, e := windows.GetSecurityInfo(hold.handle, windows.SE_FILE_OBJECT, windows.OWNER_SECURITY_INFORMATION|windows.GROUP_SECURITY_INFORMATION|windows.DACL_SECURITY_INFORMATION)
1778: 	if e != nil {
1779: 		return fmt.Errorf("target mutation GetSecurityInfo readback: %w", e)
1780: 	}
1781: 	if readback.String() != desiredSD {
1782: 		return fmt.Errorf("target descriptor same-handle readback mismatch: expected %q observed %q", desiredSD, readback.String())
1783: 	}
1784: 	v, id, e := nativeFileID(hold.handle)
1785: 	if e != nil {
1786: 		return e
1787: 	}
1788: 	final, e := finalPath(hold.handle)
1789: 	if e != nil {
1790: 		return e
1791: 	}
1792: 	if v != expected.Volume || id != expected.FileID || !strings.EqualFold(final, expected.FinalUTF16) {
1793: 		return errors.New("target native identity changed during ACL mutation")
1794: 	}
1795: 	return nil
1796: }
