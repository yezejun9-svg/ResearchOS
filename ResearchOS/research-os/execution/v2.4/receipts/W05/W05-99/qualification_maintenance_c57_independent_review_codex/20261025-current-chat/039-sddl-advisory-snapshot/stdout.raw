1651: func fenceDigest(p EntryFencePlan) string {
1652: 	var parts []string
1653: 	for _, t := range p.Targets {
1654: 		parts = append(parts, strings.ToLower(t.File.FinalUTF16)+"\x00"+t.File.FileID+"\x00"+t.InstalledSD)
1655: 	}
1656: 	sort.Strings(parts)
1657: 	return digest([]byte(strings.Join(parts, "\n")))
1658: }
