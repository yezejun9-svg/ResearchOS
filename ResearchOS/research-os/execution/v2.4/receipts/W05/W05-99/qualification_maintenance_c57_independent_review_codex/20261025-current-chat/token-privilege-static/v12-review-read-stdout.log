839: func tokenSecurityShape(token windows.Token, pid uint32, businessSID string) (businessTokenShape, error) {
840: 	var shape businessTokenShape
841: 	var session, elevation, size uint32
842: 	if err := windows.ProcessIdToSessionId(pid, &session); err != nil {
843: 		return shape, err
844: 	}
845: 	if err := windows.GetTokenInformation(token, windows.TokenElevationType, (*byte)(unsafe.Pointer(&elevation)), 4, &size); err != nil || size != 4 {
846: 		return shape, errors.Join(err, errors.New("token elevation type unavailable"))
847: 	}
848: 	labelBytes, err := tokenInfoBytes(token, windows.TokenIntegrityLevel)
849: 	if err != nil || len(labelBytes) < int(unsafe.Sizeof(windows.Tokenmandatorylabel{})) {
850: 		return shape, errors.Join(err, errors.New("token integrity label unavailable"))
851: 	}
852: 	groupSHA, effective, logonSID, err := tokenGroupState(token, businessSID)
853: 	if err != nil {
854: 		return shape, err
855: 	}
856: 	privBytes, err := tokenInfoBytes(token, windows.TokenPrivileges)
857: 	if err != nil || len(privBytes) < int(unsafe.Sizeof(windows.Tokenprivileges{})) {
858: 		return shape, errors.Join(err, errors.New("token privileges unavailable"))
859: 	}
860: 	if err = rejectFenceBypassPrivileges(privBytes); err != nil {
861: 		return shape, err
862: 	}
863: 	var privilegeLines []string
864: 	for _, priv := range (*windows.Tokenprivileges)(unsafe.Pointer(&privBytes[0])).AllPrivileges() {
865: 		privilegeLines = append(privilegeLines, fmt.Sprintf("%08x:%08x:%08x", uint32(priv.Luid.HighPart), priv.Luid.LowPart, priv.Attributes))
866: 	}
867: 	sort.Strings(privilegeLines)
868: 	privJSON, _ := json.Marshal(privilegeLines)
869: 	shape = businessTokenShape{SessionID: session, ElevationType: elevation, IntegritySID: (*windows.Tokenmandatorylabel)(unsafe.Pointer(&labelBytes[0])).Label.Sid.String(), LogonSID: logonSID, PrivilegesSHA256: digest(privJSON), GroupsSHA256: groupSHA, EffectiveSIDs: effective}
870: 	return shape, nil
871: }
