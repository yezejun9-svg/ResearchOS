821: func tokenInfoBytes(token windows.Token, class uint32) ([]byte, error) {
822: 	buf := make([]byte, 128)
823: 	for {
824: 		var size uint32
825: 		err := windows.GetTokenInformation(token, class, &buf[0], uint32(len(buf)), &size)
826: 		if err == nil {
827: 			if size > uint32(len(buf)) {
828: 				return nil, errors.New("token information size invalid")
829: 			}
830: 			return buf[:size], nil
831: 		}
832: 		if !errors.Is(err, windows.ERROR_INSUFFICIENT_BUFFER) || size > 64<<10 || size <= uint32(len(buf)) {
833: 			return nil, err
834: 		}
835: 		buf = make([]byte, size)
836: 	}
837: }
