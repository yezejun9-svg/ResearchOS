397: func TestDisposableRealPEAndScriptFence(t *testing.T) {
398: 	dir := t.TempDir()
399: 	exe, err := os.Executable()
400: 	if err != nil {
401: 		t.Fatal(err)
402: 	}
403: 	pe := filepath.Join(dir, "owned-entry.exe")
404: 	src, err := os.Open(exe)
405: 	if err != nil {
406: 		t.Fatal(err)
407: 	}
408: 	defer src.Close()
409: 	dst, err := os.OpenFile(pe, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
410: 	if err != nil {
411: 		t.Fatal(err)
412: 	}
413: 	if _, err = io.Copy(dst, src); err != nil {
414: 		dst.Close()
415: 		t.Fatal(err)
416: 	}
417: 	if err = dst.Close(); err != nil {
418: 		t.Fatal(err)
419: 	}
420: 	script := filepath.Join(dir, "owned-entry.ps1")
421: 	if err = os.WriteFile(script, []byte("Write-Output fixture-only\n"), 0600); err != nil {
422: 		t.Fatal(err)
423: 	}
424: 	u, err := windows.GetCurrentProcessToken().GetTokenUser()
425: 	if err != nil {
426: 		t.Fatal(err)
427: 	}
428: 	for _, item := range []struct{ path, mode string }{{pe, "executable"}, {script, "script"}} {
429: 		var before nativeHold
430: 		if item.mode == "script" {
431: 			before, err = openNativeAccess(item.path, false, true, windows.WRITE_DAC|windows.WRITE_OWNER)
432: 		} else {
433: 			before, err = openNative(item.path, false, true)
434: 		}
435: 		if err != nil {
436: 			t.Fatal(err)
437: 		}
438: 		installed, err := denyDescriptor(before.identity.SecurityDescriptor, u.User.Sid.String(), u.User.Sid.String(), item.mode)
439: 		if err != nil {
440: 			windows.CloseHandle(before.handle)
441: 			t.Fatal(err)
442: 		}
443: 		if err = setTargetDescriptor(before.identity, installed); err != nil {
444: 			windows.CloseHandle(before.handle)
445: 			t.Skipf("fixture WRITE_DAC unavailable: %v", err)
446: 		}
447: 		func() {
448: 			defer func() {
449: 				var restoreErr error
450: 				if item.mode == "script" {
451: 					restoreErr = restoreFixtureViaHeldHandle(before)
452: 				} else {
453: 					restoreErr = setTargetDescriptor(withFixtureSD(before.identity, installed), before.identity.SecurityDescriptor)
454: 				}
455: 				if restoreErr != nil {
456: 					t.Errorf("restore owned %s: %v", item.mode, restoreErr)
457: 				}
458: 				windows.CloseHandle(before.handle)
459: 			}()
460: 			if item.mode == "executable" {
461: 				cmd := exec.Command(item.path, "-test.run=TestPEExecutionProbe")
462: 				cmd.Env = append(os.Environ(), "RESEARCHOS_BOOT6_PE_PROBE=1")
463: 				out, runErr := cmd.CombinedOutput()
464: 				if runErr == nil {
465: 					t.Errorf("real PE executed despite exact FILE_EXECUTE fence: %s", out)
466: 				} else if !errors.Is(runErr, windows.ERROR_ACCESS_DENIED) {
467: 					t.Errorf("real PE rejection was not ACCESS_DENIED: %v", runErr)
468: 				} else {
469: 					t.Logf("real PE CreateProcess denied: %v", runErr)
470: 				}
471: 				exerciseSQLiteWALUnderFence(t, dir)
472: 			} else {
473: 				w, err := windows.UTF16PtrFromString(item.path)
474: 				if err != nil {
475: 					t.Error(err)
476: 					return
477: 				}
478: 				h, openErr := windows.CreateFile(w, windows.FILE_READ_DATA, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, nil, windows.OPEN_EXISTING, 0, 0)
479: 				if openErr == nil {
480: 					windows.CloseHandle(h)
481: 					t.Error("script FILE_READ_DATA succeeded")
482: 				} else if !errors.Is(openErr, windows.ERROR_ACCESS_DENIED) {
483: 					t.Errorf("script read denial differs: %v", openErr)
484: 				} else {
485: 					t.Logf("script FILE_READ_DATA denied: %v", openErr)
486: 				}
487: 			}
488: 		}()
489: 	}
490: }
491: 
492: func restoreFixtureViaHeldHandle(h nativeHold) error {
493: 	sd, err := windows.SecurityDescriptorFromString(h.identity.SecurityDescriptor)
494: 	if err != nil {
495: 		return err
496: 	}
497: 	owner, _, err := sd.Owner()
498: 	if err != nil {
499: 		return err
500: 	}
501: 	dacl, _, err := sd.DACL()
502: 	if err != nil {
503: 		return err
504: 	}
505: 	control, _, err := sd.Control()
506: 	if err != nil {
507: 		return err
508: 	}
509: 	flags := windows.SECURITY_INFORMATION(windows.DACL_SECURITY_INFORMATION | windows.OWNER_SECURITY_INFORMATION | windows.UNPROTECTED_DACL_SECURITY_INFORMATION)
510: 	if control&windows.SE_DACL_PROTECTED != 0 {
511: 		flags = windows.SECURITY_INFORMATION(windows.DACL_SECURITY_INFORMATION | windows.OWNER_SECURITY_INFORMATION | windows.PROTECTED_DACL_SECURITY_INFORMATION)
512: 	}
513: 	return windows.SetSecurityInfo(h.handle, windows.SE_FILE_OBJECT, flags, owner, nil, dacl, nil)
514: }
