1388: func managedToken(p EntryFencePlan) error {
1389: 	token := windows.GetCurrentProcessToken()
1390: 	if !token.IsElevated() {
1391: 		return errors.New("trusted management elevation required")
1392: 	}
1393: 	u, e := token.GetTokenUser()
1394: 	if e != nil {
1395: 		return e
1396: 	}
1397: 	if u.User.Sid.String() != p.ManagementSID || p.BusinessSID == p.ManagementSID {
1398: 		return errors.New("management SID cannot be business owner")
1399: 	}
1400: 	return nil
1401: }
1402: 
1403: func checkAcceptanceFiles(p EntryFencePlan) error {
1404: 	dir, e := stateRoot(p)
1405: 	if e != nil {
1406: 		return e
1407: 	}
1408: 	items := []struct{ name, sha, kind string }{
1409: 		{"source-accepted.json", p.SourceAcceptanceSHA256, "source"},
1410: 		{"native-accepted.json", p.NativeAcceptanceSHA256, "native"},
1411: 		{"backup-verified.json", p.BackupManifestSHA256, "online-backup"},
1412: 		{"recovery-ready.json", p.RecoveryPackageSHA256, "management-recovery"},
1413: 	}
1414: 	for _, item := range items {
1415: 		h, e := openNative(filepath.Join(dir, item.name), false, true)
1416: 		if e != nil {
1417: 			return e
1418: 		}
1419: 		if h.identity.SHA256 != item.sha {
1420: 			windows.CloseHandle(h.handle)
1421: 			return fmt.Errorf("acceptance digest mismatch: %s", item.name)
1422: 		}
1423: 		raw, readErr := os.ReadFile(filepath.Join(dir, item.name))
1424: 		if readErr != nil || len(raw) > 16<<10 || digest(raw) != h.identity.SHA256 {
1425: 			windows.CloseHandle(h.handle)
1426: 			return fmt.Errorf("acceptance file changed: %s", item.name)
1427: 		}
1428: 		var proof BoundaryAttestation
1429: 		if readErr = json.Unmarshal(raw, &proof); readErr != nil {
1430: 			windows.CloseHandle(h.handle)
1431: 			return readErr
1432: 		}
1433: 		if readErr = validateAttestation(p, item.kind, proof); readErr != nil {
1434: 			windows.CloseHandle(h.handle)
1435: 			return fmt.Errorf("%s: %w", item.name, readErr)
1436: 		}
1437: 		if e = windows.CloseHandle(h.handle); e != nil {
1438: 			return e
1439: 		}
1440: 	}
1441: 	return nil
1442: }
1443: 
1444: func validateAttestation(p EntryFencePlan, kind string, proof BoundaryAttestation) error {
1445: 	core, e := PlanCoreSHA256(p)
1446: 	if e != nil || proof.Schema != "researchos.boundary-attestation.v1" || proof.Kind != kind || proof.Status != "ACCEPTED" || proof.OperationID != p.OperationID || proof.PlanCoreSHA256 != core || proof.Issuer == "" || proof.Issuer == p.ManagementSID || !validDigest(proof.EvidenceSHA256) || proof.RecordedUTC.IsZero() {
1447: 		return errors.New("external acceptance report unqualified")
1448: 	}
1449: 	if kind == "online-backup" && (proof.BackupID == "" || !validDigest(proof.RestoreTestSHA256) || !validDigest(proof.CredentialProbeSHA256)) {
1450: 		return errors.New("online backup has no restoration and credential proof")
1451: 	}
1452: 	return nil
1453: }
1454: 
1455: func readFullRestartEvidence(p EntryFencePlan, pre BootWitness, now time.Time) (string, error) {
1456: 	dir, e := stateRoot(p)
1457: 	if e != nil {
1458: 		return "", e
1459: 	}
1460: 	path := filepath.Join(dir, "full-restart-complete.json")
1461: 	h, e := openNative(path, false, true)
1462: 	if e != nil {
1463: 		return "", e
1464: 	}
1465: 	defer windows.CloseHandle(h.handle)
1466: 	raw, e := os.ReadFile(path)
1467: 	if e != nil || len(raw) > 16<<10 || digest(raw) != h.identity.SHA256 {
1468: 		return "", errors.New("FullRestart evidence changed during read")
1469: 	}
1470: 	var evidence struct {
1471: 		Schema          string    `json:"schema"`
1472: 		OperationID     string    `json:"operation_id"`
1473: 		Method          string    `json:"method"`
1474: 		ConfirmedByUser bool      `json:"confirmed_by_user"`
1475: 		CompletedUTC    time.Time `json:"completed_utc"`
1476: 	}
1477: 	if e = json.Unmarshal(raw, &evidence); e != nil {
1478: 		return "", e
1479: 	}
1480: 	if evidence.Schema != "researchos.full-restart-complete.v1" || evidence.OperationID != p.OperationID || evidence.Method != "FullRestart" || !evidence.ConfirmedByUser || evidence.CompletedUTC.Before(pre.UTC) || evidence.CompletedUTC.After(now) {
1481: 		return "", errors.New("explicit FullRestart completion evidence invalid")
1482: 	}
1483: 	return h.identity.SHA256, nil
1484: }
1485: 
1486: func fenceDigest(p EntryFencePlan) string {
1487: 	var parts []string
1488: 	for _, t := range p.Targets {
1489: 		parts = append(parts, strings.ToLower(t.File.FinalUTF16)+"\x00"+t.File.FileID+"\x00"+t.InstalledSD)
1490: 	}
1491: 	sort.Strings(parts)
1492: 	return digest([]byte(strings.Join(parts, "\n")))
1493: }
1494: 
1495: func writeExclusiveJSON(path string, value any) error {
1496: 	raw, e := json.Marshal(value)
1497: 	if e != nil {
1498: 		return e
1499: 	}
1500: 	if len(raw) > 256<<10 {
1501: 		return errors.New("boundary record oversized")
1502: 	}
1503: 	f, e := os.OpenFile(path, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0600)
1504: 	if e != nil {
1505: 		return e
1506: 	}
1507: 	_, writeErr := f.Write(append(raw, '\n'))
1508: 	if writeErr == nil {
1509: 		writeErr = f.Sync()
1510: 	}
1511: 	return errors.Join(writeErr, f.Close())
1512: }
1513: 
1514: func appendEvent(p EntryFencePlan, events []BoundaryEvent, state string) error {
1515: 	if e := ValidateEvents(events, p.OperationID, p.PlanSHA256); e != nil && len(events) > 0 {
1516: 		return e
1517: 	}
1518: 	previous, previousHash := "", ""
1519: 	if len(events) > 0 {
1520: 		previous = events[len(events)-1].State
1521: 		previousHash = events[len(events)-1].SHA256
1522: 	}
1523: 	if !transition(previous, state) {
1524: 		return errors.New("boundary phase transition invalid")
1525: 	}
1526: 	e := BoundaryEvent{Schema: EventSchema, Sequence: uint64(len(events) + 1), PreviousSHA256: previousHash, OperationID: p.OperationID, PlanSHA256: p.PlanSHA256, State: state, UTC: time.Now().UTC()}
1527: 	e.SHA256 = digest([]byte(fmt.Sprintf("%s\x00%d\x00%s\x00%s\x00%s\x00%s\x00%s", e.Schema, e.Sequence, e.PreviousSHA256, e.OperationID, e.PlanSHA256, e.State, e.UTC.UTC().Format(time.RFC3339Nano))))
1528: 	dir, err := stateRoot(p)
1529: 	if err != nil {
1530: 		return err
1531: 	}
1532: 	return writeExclusiveJSON(filepath.Join(dir, fmt.Sprintf("event-%02d.json", e.Sequence)), e)
1533: }
1534: 
1535: func setTargetDescriptor(expected FileIdentity, desiredSD string) (outErr error) {
1536: 	sd, e := windows.SecurityDescriptorFromString(desiredSD)
1537: 	if e != nil {
1538: 		return e
1539: 	}
1540: 	owner, _, e := sd.Owner()
1541: 	if e != nil || owner == nil {
1542: 		return errors.New("target owner descriptor missing")
1543: 	}
1544: 	dacl, _, e := sd.DACL()
1545: 	if e != nil {
1546: 		return e
1547: 	}
1548: 	control, _, e := sd.Control()
1549: 	if e != nil {
1550: 		return e
1551: 	}
1552: 	flags := windows.SECURITY_INFORMATION(windows.DACL_SECURITY_INFORMATION | windows.UNPROTECTED_DACL_SECURITY_INFORMATION)
1553: 	if control&windows.SE_DACL_PROTECTED != 0 {
1554: 		flags = windows.SECURITY_INFORMATION(windows.DACL_SECURITY_INFORMATION | windows.PROTECTED_DACL_SECURITY_INFORMATION)
1555: 	}
1556: 	hold, e := openNativeAccess(expected.Path, false, true, windows.WRITE_DAC|windows.WRITE_OWNER)
1557: 	if e != nil {
1558: 		return e
1559: 	}
1560: 	defer func() { outErr = errors.Join(outErr, windows.CloseHandle(hold.handle)) }()
1561: 	if !identityEqual(hold.identity, expected) {
1562: 		return errors.New("target same-handle native identity or descriptor changed before mutation")
1563: 	}
1564: 	if e = windows.SetSecurityInfo(hold.handle, windows.SE_FILE_OBJECT, flags|windows.OWNER_SECURITY_INFORMATION, owner, nil, dacl, nil); e != nil {
1565: 		return e
1566: 	}
1567: 	readback, e := windows.GetSecurityInfo(hold.handle, windows.SE_FILE_OBJECT, windows.OWNER_SECURITY_INFORMATION|windows.DACL_SECURITY_INFORMATION)
1568: 	if e != nil {
1569: 		return e
1570: 	}
1571: 	if readback.String() != desiredSD {
1572: 		return errors.New("target descriptor same-handle readback mismatch")
1573: 	}
1574: 	v, id, e := nativeFileID(hold.handle)
1575: 	if e != nil {
1576: 		return e
1577: 	}
1578: 	final, e := finalPath(hold.handle)
1579: 	if e != nil {
1580: 		return e
1581: 	}
1582: 	if v != expected.Volume || id != expected.FileID || !strings.EqualFold(final, expected.FinalUTF16) {
1583: 		return errors.New("target native identity changed during ACL mutation")
1584: 	}
1585: 	return nil
1586: }
1587: 
1588: func checkNoOfficialProcess(p EntryFencePlan) error {
1589: 	snapshot, e := windows.CreateToolhelp32Snapshot(windows.TH32CS_SNAPPROCESS, 0)
1590: 	if e != nil {
1591: 		return e
1592: 	}
1593: 	defer windows.CloseHandle(snapshot)
1594: 	var entry windows.ProcessEntry32
1595: 	entry.Size = uint32(unsafe.Sizeof(entry))
1596: 	if e = windows.Process32First(snapshot, &entry); e != nil {
1597: 		return e
1598: 	}
1599: 	for {
1600: 		name := windows.UTF16ToString(entry.ExeFile[:])
1601: 		for _, t := range p.Targets {
1602: 			if t.Mode != "executable" || !strings.EqualFold(name, filepath.Base(t.File.Path)) {
1603: 				continue
1604: 			}
1605: 			proc, err := windows.OpenProcess(windows.PROCESS_QUERY_LIMITED_INFORMATION, false, entry.ProcessID)
1606: 			if err != nil {
1607: 				return fmt.Errorf("candidate official process inaccessible: %w", err)
1608: 			}
1609: 			buf := make([]uint16, 32768)
1610: 			n := uint32(len(buf))
1611: 			err = windows.QueryFullProcessImageName(proc, 0, &buf[0], &n)
1612: 			closeErr := windows.CloseHandle(proc)
1613: 			if err != nil || closeErr != nil {
1614: 				return errors.Join(err, closeErr)
1615: 			}
1616: 			if strings.EqualFold(windows.UTF16ToString(buf[:n]), t.File.Path) {
1617: 				return errors.New("official entry process remains live")
1618: 			}
1619: 		}
1620: 		e = windows.Process32Next(snapshot, &entry)
1621: 		if errors.Is(e, windows.ERROR_NO_MORE_FILES) {
1622: 			break
1623: 		}
1624: 		if e != nil {
1625: 			return e
1626: 		}
1627: 	}
1628: 	return nil
1629: }
1630: 
1631: func checkRestartRegistrations(p EntryFencePlan) error {
1632: 	snapshot, e := windows.CreateToolhelp32Snapshot(windows.TH32CS_SNAPPROCESS, 0)
1633: 	if e != nil {
1634: 		return e
1635: 	}
1636: 	defer windows.CloseHandle(snapshot)
1637: 	var entry windows.ProcessEntry32
1638: 	entry.Size = uint32(unsafe.Sizeof(entry))
1639: 	if e = windows.Process32First(snapshot, &entry); e != nil {
1640: 		return e
1641: 	}
1642: 	for {
1643: 		name := windows.UTF16ToString(entry.ExeFile[:])
1644: 		for _, t := range p.Targets {
1645: 			if t.Mode != "executable" || !strings.EqualFold(name, filepath.Base(t.File.Path)) {
1646: 				continue
1647: 			}
1648: 			proc, err := windows.OpenProcess(windows.PROCESS_QUERY_LIMITED_INFORMATION|windows.PROCESS_VM_READ, false, entry.ProcessID)
1649: 			if err != nil {
1650: 				return fmt.Errorf("official restart candidate inaccessible: %w", err)
1651: 			}
1652: 			buf := make([]uint16, 32768)
1653: 			n := uint32(len(buf))
1654: 			err = windows.QueryFullProcessImageName(proc, 0, &buf[0], &n)
1655: 			if err != nil {
1656: 				windows.CloseHandle(proc)
1657: 				return err
1658: 			}
1659: 			if strings.EqualFold(windows.UTF16ToString(buf[:n]), t.File.Path) {
1660: 				args, _, registered, readErr := restartSettingsForProcess(proc)
1661: 				if readErr != nil {
1662: 					windows.CloseHandle(proc)
1663: 					return readErr
1664: 				}
1665: 				if registered {
1666: 					match := false
1667: 					for _, sha := range t.RestartArgsSHA256 {
1668: 						if sha == digest([]byte(args)) {
1669: 							match = true
1670: 							break
1671: 						}
1672: 					}
1673: 					if !match {
1674: 						windows.CloseHandle(proc)
1675: 						return errors.New("runtime RestartApps argv outside frozen entry inventory")
1676: 					}
1677: 				}
1678: 			}
1679: 			if err = windows.CloseHandle(proc); err != nil {
1680: 				return err
1681: 			}
1682: 		}
1683: 		e = windows.Process32Next(snapshot, &entry)
1684: 		if errors.Is(e, windows.ERROR_NO_MORE_FILES) {
1685: 			break
1686: 		}
1687: 		if e != nil {
1688: 			return e
1689: 		}
1690: 	}
1691: 	return nil
1692: }
1693: 
1694: // RunPhase is the fixed management helper state machine. The caller supplies
1695: // only the exact root/operation/plan selector, never SQL or a target path.
1696: func RunPhase(ctx context.Context, phase, dataRoot, operationID, planSHA256 string) (stateOut string, errOut error) {
1697: 	if e := ctx.Err(); e != nil {
1698: 		return "", e
1699: 	}
1700: 	if phase != "plan" && phase != "arm" && phase != "observe" && phase != "status" && phase != "disarm-request" {
1701: 		return "", errors.New("unsupported boundary phase")
1702: 	}
1703: 	if !filepath.IsAbs(dataRoot) || filepath.Clean(dataRoot) != dataRoot || !validOperation(operationID) || !validDigest(planSHA256) {
1704: 		return "", errors.New("boundary selector invalid")
1705: 	}
1706: 	p, e := discoverPlan(dataRoot, operationID, planSHA256)
1707: 	if e != nil {
1708: 		return "", e
1709: 	}
1710: 	if e = ValidatePlan(p); e != nil {
1711: 		return "", e
1712: 	}
1713: 	dir, e := stateRoot(p)
1714: 	if e != nil {
1715: 		return "", e
1716: 	}
1717: 	if e = checkManagedChain(p); e != nil {
1718: 		return "", e
1719: 	}
1720: 	if e = checkAcceptanceFiles(p); e != nil {
1721: 		return "", e
1722: 	}
1723: 	if phase == "plan" {
1724: 		if e = managedToken(p); e != nil {
1725: 			return "", e
1726: 		}
1727: 		entries, e := os.ReadDir(dir)
1728: 		if e != nil {
1729: 			return "", e
1730: 		}
1731: 		if len(entries) != 5 {
1732: 			return "", errors.New("plan staging inventory not exact")
1733: 		}
1734: 		holds, e := openPlanHolds(p)
1735: 		if e != nil {
1736: 			return "", e
1737: 		}
1738: 		defer func() { errOut = errors.Join(errOut, closeHolds(holds)) }()
1739: 		if e = checkAncestorControl(p, holds); e != nil {
1740: 			return "", e
1741: 		}
1742: 		for _, t := range p.Targets {
1743: 			expected, e := denyDescriptor(t.File.SecurityDescriptor, p.BusinessSID, p.ManagementSID, t.Mode)
1744: 			if e != nil || expected != t.InstalledSD {
1745: 				return "", errors.New("fence descriptor plan mismatch")
1746: 			}
1747: 		}
1748: 		pre, e := witness(p, fenceDigest(p))
1749: 		if e != nil {
1750: 			return "", e
1751: 		}
1752: 		pre.BusinessEnabledSIDsSHA256, e = businessEnabledGroupDigest(p)
1753: 		if e != nil {
1754: 			return "", e
1755: 		}
1756: 		shape, e := captureOfficialBusinessToken(p, pre.BusinessEnabledSIDsSHA256)
1757: 		if e != nil {
1758: 			return "", e
1759: 		}
1760: 		pre.BusinessSessionID = shape.SessionID
1761: 		pre.BusinessElevationType = shape.ElevationType
1762: 		pre.BusinessIntegritySID = shape.IntegritySID
1763: 		pre.BusinessLogonSID = shape.LogonSID
1764: 		pre.BusinessPrivilegesSHA256 = shape.PrivilegesSHA256
1765: 		pre.BusinessProcessPID = shape.ProcessID
1766: 		pre.BusinessProcessCreatedUTC = shape.ProcessCreated
1767: 		pre.BusinessProcessImageSHA256 = shape.ProcessImageSHA
1768: 		if pre.UptimeMilliseconds < uint64(MaxPostUptime/time.Millisecond) {
1769: 			return "", errors.New("pre uptime insufficient")
1770: 		}
1771: 		if e = writeExclusiveJSON(filepath.Join(dir, "pre.json"), pre); e != nil {
1772: 			return "", e
1773: 		}
1774: 		if e = appendEvent(p, nil, "PREPARED"); e != nil {
1775: 			return "", e
1776: 		}
1777: 		return "PREPARED", nil
1778: 	}
1779: 	r, e := readRecord(p)
1780: 	if e != nil {
1781: 		return "", e
1782: 	}
1783: 	state := r.Events[len(r.Events)-1].State
1784: 	if phase == "status" {
1785: 		return state, nil
1786: 	}
1787: 	if e = managedToken(p); e != nil {
1788: 		return "", e
1789: 	}
1790: 	switch phase {
1791: 	case "arm":
1792: 		if state != "PREPARED" {
1793: 			return "", errors.New("arm requires PREPARED")
1794: 		}
1795: 		if e = checkPreCurrent(r.Pre, p.BusinessSID); e != nil {
1796: 			return "", e
1797: 		}
1798: 		if e = checkRestartRegistrations(p); e != nil {
1799: 			return "", e
1800: 		}
1801: 		holds, e := openPlanHolds(p)
1802: 		if e != nil {
1803: 			return "", e
1804: 		}
1805: 		defer func() { errOut = errors.Join(errOut, closeHolds(holds)) }()
1806: 		if e = checkAncestorControl(p, holds); e != nil {
1807: 			return "", e
1808: 		}
1809: 		if e = preflightManagementRestore(p); e != nil {
1810: 			return "", e
1811: 		}
1812: 		if e = appendEvent(p, r.Events, "APPLYING"); e != nil {
1813: 			return "", e
1814: 		}
1815: 		for _, t := range p.Targets {
1816: 			if e = setTargetDescriptor(t.File, t.InstalledSD); e != nil {
1817: 				return "", e
1818: 			}
1819: 			h, e := openNativeAccess(t.File.Path, false, true, windows.WRITE_DAC|windows.WRITE_OWNER)
1820: 			if e != nil {
1821: 				return "", e
1822: 			}
1823: 			ok := identityCoreEqual(t.File, h.identity) && h.identity.SecurityDescriptor == t.InstalledSD
1824: 			closeErr := windows.CloseHandle(h.handle)
1825: 			if closeErr != nil {
1826: 				return "", closeErr
1827: 			}
1828: 			if !ok {
1829: 				return "", errors.New("arm native readback mismatch")
1830: 			}
1831: 		}
1832: 		r, e = readRecord(p)
1833: 		if e != nil {
1834: 			return "", e
1835: 		}
1836: 		if e = appendEvent(p, r.Events, "ARMED"); e != nil {
1837: 			return "", e
1838: 		}
1839: 		return "ARMED", nil
1840: 	case "observe":
1841: 		if state != "ARMED" {
1842: 			return "", errors.New("observe requires ARMED")
1843: 		}
1844: 		holds, e := openPlanHolds(p)
1845: 		if e != nil {
1846: 			return "", e
1847: 		}
1848: 		defer func() { errOut = errors.Join(errOut, closeHolds(holds)) }()
1849: 		if e = checkFence(p, holds); e != nil {
1850: 			return "", e
1851: 		}
1852: 		if e = checkAncestorControl(p, holds); e != nil {
1853: 			return "", e
1854: 		}
1855: 		if e = checkNoOfficialProcess(p); e != nil {
1856: 			return "", e
1857: 		}
1858: 		post, e := witness(p, fenceDigest(p))
1859: 		if e != nil {
1860: 			return "", e
1861: 		}
1862: 		currentBusiness, e := inspectExistingBusinessProcess(p, r.Pre.BusinessEnabledSIDsSHA256, r.Pre)
1863: 		if e != nil {
1864: 			return "", e
1865: 		}
1866: 		post.BusinessEnabledSIDsSHA256 = currentBusiness.GroupsSHA256
1867: 		post.BusinessSessionID = currentBusiness.SessionID
1868: 		post.BusinessElevationType = currentBusiness.ElevationType
1869: 		post.BusinessIntegritySID = currentBusiness.IntegritySID
1870: 		post.BusinessLogonSID = currentBusiness.LogonSID
1871: 		post.BusinessPrivilegesSHA256 = currentBusiness.PrivilegesSHA256
1872: 		post.BusinessProcessPID = currentBusiness.ProcessID
1873: 		post.BusinessProcessCreatedUTC = currentBusiness.ProcessCreated
1874: 		post.BusinessProcessImageSHA256 = currentBusiness.ProcessImageSHA
1875: 		post.FullRestartEvidenceSHA256, e = readFullRestartEvidence(p, r.Pre, post.UTC)
1876: 		if e != nil {
1877: 			return "", e
1878: 		}
1879: 		if e = ValidateRestart(r.Pre, post); e != nil {
1880: 			return "", e
1881: 		}
1882: 		if e = writeExclusiveJSON(filepath.Join(dir, "post.json"), post); e != nil {
1883: 			return "", e
1884: 		}
1885: 		if e = appendEvent(p, r.Events, "BOOT_OBSERVED"); e != nil {
1886: 			return "", e
1887: 		}
1888: 		return "BOOT_OBSERVED", nil
1889: 	case "disarm-request":
1890: 		if state == "PREPARED" || state == "APPLYING" || state == "ARMED" || state == "BOOT_OBSERVED" {
1891: 			// The only abort path is a proven pre-BEGIN path under the same
1892: 			// exclusive root lock used by C. Any journal, even malformed or
1893: 			// terminal, requires exact C recovery rather than a no-effect claim.
1894: 			lease, leaseErr := rt.AcquireDataRootLease(p.DataRoot.Path)
1895: 			if leaseErr != nil {
1896: 				return "", leaseErr
1897: 			}
1898: 			defer func() { errOut = errors.Join(errOut, lease.Close()) }()
1899: 			ownJournal := filepath.Join(p.DataRoot.Path, "host", qualificationmaintenancejournal.QualificationNamespace, p.OperationID)
1900: 			if _, statErr := os.Lstat(ownJournal); statErr == nil {
1901: 				return "", errors.New("C journal exists; pre-BEGIN abort forbidden")
1902: 			} else if !errors.Is(statErr, os.ErrNotExist) {
1903: 				return "", statErr
1904: 			}
1905: 			if e = qualificationmaintenancejournal.CheckOrdinary(p.DataRoot.Path); e != nil {
1906: 				return "", e
1907: 			}
1908: 			if e = appendEvent(p, r.Events, "BOUNDARY_ABORTED"); e != nil {
1909: 				return "", e
1910: 			}
1911: 			r, e = readRecord(p)
1912: 			if e != nil {
1913: 				return "", e
1914: 			}
1915: 			state = "BOUNDARY_ABORTED"
1916: 		}
1917: 		if state != "C_DURABLE" && state != "BOUNDARY_ABORTED" && state != "DISARMING" {
1918: 			return "", errors.New("disarm requires durable C or explicit boundary abort")
1919: 		}
1920: 		if state == "C_DURABLE" {
1921: 			if e = checkExactCDurable(p); e != nil {
1922: 				return "", e
1923: 			}
1924: 		}
1925: 		if state == "DISARMING" {
1926: 			// A resumable partial restore is only legal if the earlier event
1927: 			// records a durable C or explicit, non-success abort.
1928: 			if len(r.Events) < 2 || (r.Events[len(r.Events)-2].State != "C_DURABLE" && r.Events[len(r.Events)-2].State != "BOUNDARY_ABORTED") {
1929: 				return "", errors.New("disarm predecessor invalid")
1930: 			}
1931: 			if r.Events[len(r.Events)-2].State == "C_DURABLE" {
1932: 				if e = checkExactCDurable(p); e != nil {
1933: 					return "", e
1934: 				}
1935: 			}
1936: 		}
1937: 		holds, e := openPlanHolds(p)
1938: 		if e != nil {
1939: 			return "", e
1940: 		}
1941: 		defer func() { errOut = errors.Join(errOut, closeHolds(holds)) }()
1942: 		if e = checkAncestorControl(p, holds); e != nil {
1943: 			return "", e
1944: 		}
1945: 		byPath := map[string]FileIdentity{}
1946: 		for _, h := range holds {
1947: 			byPath[strings.ToLower(h.path)] = h.identity
1948: 		}
1949: 		for _, t := range p.Targets {
1950: 			x := byPath[strings.ToLower(t.File.Path)]
1951: 			if !identityCoreEqual(x, t.File) || (x.SecurityDescriptor != t.File.SecurityDescriptor && x.SecurityDescriptor != t.InstalledSD) {
1952: 				return "", errors.New("disarm target differs from exact before/installed descriptor")
1953: 			}
1954: 		}
1955: 		if state != "DISARMING" {
1956: 			if e = appendEvent(p, r.Events, "DISARMING"); e != nil {
1957: 				return "", e
1958: 			}
1959: 		}
1960: 		for _, t := range p.Targets {
1961: 			x := byPath[strings.ToLower(t.File.Path)]
1962: 			if x.SecurityDescriptor == t.File.SecurityDescriptor {
1963: 				continue
1964: 			}
1965: 			expected := t.File
1966: 			expected.SecurityDescriptor = t.InstalledSD
1967: 			if e = setTargetDescriptor(expected, t.File.SecurityDescriptor); e != nil {
1968: 				return "", e
1969: 			}
1970: 			h, e := openNative(t.File.Path, false, true)
1971: 			if e != nil {
1972: 				return "", e
1973: 			}
1974: 			ok := identityEqual(t.File, h.identity)
1975: 			closeErr := windows.CloseHandle(h.handle)
1976: 			if closeErr != nil {
1977: 				return "", closeErr
1978: 			}
1979: 			if !ok {
1980: 				return "", errors.New("disarm exact descriptor readback mismatch")
1981: 			}
1982: 		}
1983: 		r, e = readRecord(p)
1984: 		if e != nil {
1985: 			return "", e
1986: 		}
1987: 		if e = appendEvent(p, r.Events, "CLOSED"); e != nil {
1988: 			return "", e
1989: 		}
1990: 		return "CLOSED", nil
1991: 	}
1992: 	return "", errors.New("unreachable boundary phase")
1993: }
1994: 
1995: func checkExactCDurable(p EntryFencePlan) error {
1996: 	path := filepath.Join(p.DataRoot.Path, "host", qualificationmaintenancejournal.QualificationNamespace, p.OperationID, "plan.json")
1997: 	raw, e := os.ReadFile(path)
1998: 	if e != nil || len(raw) > 256<<10 {
1999: 		return errors.New("C journal plan unavailable")
2000: 	}
2001: 	var view struct {
2002: 		PlanHash string `json:"plan_hash"`
2003: 	}
2004: 	if e = json.Unmarshal(raw, &view); e != nil {
2005: 		return e
2006: 	}
2007: 	_, status, e := qualificationmaintenancejournal.OpenOwnInspection(p.DataRoot.Path, qualificationmaintenancejournal.QualificationNamespace, p.OperationID, view.PlanHash)
2008: 	if e != nil {
2009: 		return e
2010: 	}
2011: 	if status.State != "DURABLE" || !status.Terminal || !status.Applied {
2012: 		return errors.New("exact C operation not durable")
2013: 	}
2014: 	return qualificationmaintenancejournal.CheckOrdinary(p.DataRoot.Path)
2015: }
