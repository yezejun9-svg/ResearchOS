516: func TestOwnProcessRestartRegistrationNativeArgv(t *testing.T) {
517: 	register := windows.NewLazySystemDLL("kernel32.dll").NewProc("RegisterApplicationRestart")
518: 	unregister := windows.NewLazySystemDLL("kernel32.dll").NewProc("UnregisterApplicationRestart")
519: 	arg := "--boot6-native-argv"
520: 	w, err := windows.UTF16PtrFromString(arg)
521: 	if err != nil {
522: 		t.Fatal(err)
523: 	}
524: 	r, _, _ := register.Call(uintptr(unsafe.Pointer(w)), 0)
525: 	if uint32(r) != 0 {
526: 		t.Skipf("own process RestartApps registration unavailable: HRESULT %#x", uint32(r))
527: 	}
528: 	defer unregister.Call()
529: 	actual, flags, registered, err := restartSettingsForProcess(windows.CurrentProcess())
530: 	if err != nil || !registered || actual != arg || flags != 0 {
531: 		t.Fatalf("native restart registration argv: registered=%v args=%q flags=%#x err=%v", registered, actual, flags, err)
532: 	}
533: 	t.Logf("GetApplicationRestartSettings returned own exact argv %q flags %#x", actual, flags)
534: }
