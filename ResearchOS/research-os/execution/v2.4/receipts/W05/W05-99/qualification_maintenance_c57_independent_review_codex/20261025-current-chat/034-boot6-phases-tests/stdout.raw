154: func TestBoundaryPlanDigestBindsAttestationFilesWithoutCycle(t *testing.T) {
155: 	p := EntryFencePlan{Schema: PlanSchema, OperationID: "0123456789abcdef0123456789abcdef", SourceAcceptanceSHA256: strings.Repeat("1", 64), NativeAcceptanceSHA256: strings.Repeat("2", 64)}
156: 	core, err := PlanCoreSHA256(p)
157: 	if err != nil {
158: 		t.Fatal(err)
159: 	}
160: 	full, err := ComputePlanSHA256(p)
161: 	if err != nil {
162: 		t.Fatal(err)
163: 	}
164: 	p.PlanSHA256 = full
165: 	p.SourceAcceptanceSHA256 = strings.Repeat("3", 64)
166: 	coreAfter, err := PlanCoreSHA256(p)
167: 	if err != nil {
168: 		t.Fatal(err)
169: 	}
170: 	fullAfter, err := ComputePlanSHA256(p)
171: 	if err != nil {
172: 		t.Fatal(err)
173: 	}
174: 	if coreAfter != core || fullAfter == full {
175: 		t.Fatal("plan core/receipt digest separation broken")
176: 	}
177: 	if err := ValidatePlan(p); err == nil {
178: 		t.Fatal("modified attestation reference retained old plan hash")
179: 	}
180: }
