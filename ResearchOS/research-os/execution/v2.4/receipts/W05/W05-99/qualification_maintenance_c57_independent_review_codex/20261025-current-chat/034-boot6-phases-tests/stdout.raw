580: func TestOpaqueTokenZeroAndPhaseFailClosed(t *testing.T) {
581: 	var q CurrentQuiescence
582: 	if err := q.Check(context.Background(), nil, "", "", "", ""); err == nil {
583: 		t.Fatal("zero token checked")
584: 	}
585: 	if err := q.Close(); err == nil {
586: 		t.Fatal("zero token closed as valid")
587: 	}
588: 	if _, err := OpenCurrentQuiescence(context.Background(), nil, "", "", "", ""); err == nil {
589: 		t.Fatal("nil lease opened token")
590: 	}
591: 	if _, err := RunPhase(context.Background(), "server", "C:\\fixture", "0123456789abcdef0123456789abcdef", strings.Repeat("a", 64)); err == nil {
592: 		t.Fatal("ordinary server mode accepted")
593: 	}
594: 	ctx, cancel := context.WithCancel(context.Background())
595: 	cancel()
596: 	if _, err := RunPhase(ctx, "status", "C:\\fixture", "0123456789abcdef0123456789abcdef", strings.Repeat("a", 64)); !errors.Is(err, context.Canceled) {
597: 		t.Fatalf("canceled phase: %v", err)
598: 	}
599: }
