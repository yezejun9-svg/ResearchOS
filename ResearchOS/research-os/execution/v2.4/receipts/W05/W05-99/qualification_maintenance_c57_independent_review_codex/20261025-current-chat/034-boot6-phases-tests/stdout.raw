132: func TestOnlineBackupGateRequiresRestorationAndIndependentIssuer(t *testing.T) {
133: 	sha := strings.Repeat("a", 64)
134: 	p := EntryFencePlan{OperationID: "0123456789abcdef0123456789abcdef", PlanSHA256: sha, ManagementSID: "S-1-5-21-1"}
135: 	core, err := PlanCoreSHA256(p)
136: 	if err != nil {
137: 		t.Fatal(err)
138: 	}
139: 	proof := BoundaryAttestation{Schema: "researchos.boundary-attestation.v1", Kind: "online-backup", Status: "ACCEPTED", OperationID: p.OperationID, PlanCoreSHA256: core, Issuer: "independent-review", EvidenceSHA256: sha, RecordedUTC: time.Now().UTC(), BackupID: "backup-1", RestoreTestSHA256: sha, CredentialProbeSHA256: sha}
140: 	if err := validateAttestation(p, "online-backup", proof); err != nil {
141: 		t.Fatal(err)
142: 	}
143: 	proof.RestoreTestSHA256 = ""
144: 	if err := validateAttestation(p, "online-backup", proof); err == nil {
145: 		t.Fatal("static backup claim passed without restore test")
146: 	}
147: 	proof.RestoreTestSHA256 = sha
148: 	proof.Issuer = p.ManagementSID
149: 	if err := validateAttestation(p, "online-backup", proof); err == nil {
150: 		t.Fatal("manager self acceptance passed")
151: 	}
152: }
