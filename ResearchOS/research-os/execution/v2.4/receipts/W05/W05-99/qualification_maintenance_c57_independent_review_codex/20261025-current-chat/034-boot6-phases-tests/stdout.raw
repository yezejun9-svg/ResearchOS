670: func TestBusinessTokenPermissionSemanticsAcrossRestart(t *testing.T) {
671: 	pre := BootWitness{BusinessSessionID: 3, BusinessElevationType: 3, BusinessIntegritySID: "S-1-16-8192", BusinessLogonSID: "S-1-5-5-1-2", BusinessPrivilegesSHA256: strings.Repeat("a", 64)}
672: 	current := businessTokenShape{SessionID: 9, ElevationType: 3, IntegritySID: pre.BusinessIntegritySID, LogonSID: "S-1-5-5-9-10", PrivilegesSHA256: pre.BusinessPrivilegesSHA256, GroupsSHA256: strings.Repeat("b", 64)}
673: 	if err := sameBusinessPermissionSemantics(pre, current, current.GroupsSHA256); err != nil {
674: 		t.Fatalf("fresh session/logon identity should keep same permission semantics: %v", err)
675: 	}
676: 	current.ElevationType = 2
677: 	if err := sameBusinessPermissionSemantics(pre, current, current.GroupsSHA256); err == nil {
678: 		t.Fatal("elevation change accepted")
679: 	}
680: 	current.ElevationType = pre.BusinessElevationType
681: 	current.ProcessID = 555
682: 	current.ProcessCreated = time.Date(2026, 10, 25, 7, 1, 0, 0, time.UTC)
683: 	current.ProcessImageSHA = strings.Repeat("c", 64)
684: 	post := BootWitness{BusinessEnabledSIDsSHA256: current.GroupsSHA256, BusinessSessionID: current.SessionID, BusinessLogonSID: current.LogonSID, BusinessProcessPID: current.ProcessID, BusinessProcessCreatedUTC: current.ProcessCreated, BusinessProcessImageSHA256: current.ProcessImageSHA}
685: 	if err := sameCurrentProcessWitness(post, current); err != nil {
686: 		t.Fatalf("current process witness did not bind exact source: %v", err)
687: 	}
688: 	current.ProcessID++
689: 	if err := sameCurrentProcessWitness(post, current); err == nil {
690: 		t.Fatal("replacement process accepted as same post witness")
691: 	}
692: }
