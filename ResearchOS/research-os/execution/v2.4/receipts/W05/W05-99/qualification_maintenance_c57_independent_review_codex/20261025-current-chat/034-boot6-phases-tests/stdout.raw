536: func exerciseSQLiteWALUnderFence(t *testing.T, parent string) {
537: 	t.Helper()
538: 	root := filepath.Join(parent, "data-root")
539: 	if err := os.Mkdir(root, 0700); err != nil {
540: 		t.Fatal(err)
541: 	}
542: 	lease, err := rt.AcquireDataRootLease(root)
543: 	if err != nil {
544: 		t.Fatalf("business root lease under fence: %v", err)
545: 	}
546: 	defer func() {
547: 		if err := lease.Close(); err != nil {
548: 			t.Errorf("business lease close: %v", err)
549: 		}
550: 	}()
551: 	if !lease.Held() {
552: 		t.Fatal("business root lease not held")
553: 	}
554: 	dbPath := filepath.Join(root, "researchos.sqlite")
555: 	db, err := sql.Open("sqlite", dbPath)
556: 	if err != nil {
557: 		t.Fatal(err)
558: 	}
559: 	defer db.Close()
560: 	var mode string
561: 	if err = db.QueryRow(`PRAGMA journal_mode=WAL`).Scan(&mode); err != nil || strings.ToLower(mode) != "wal" {
562: 		t.Fatalf("business WAL unavailable: %q %v", mode, err)
563: 	}
564: 	if _, err = db.Exec(`CREATE TABLE fixture (id INTEGER PRIMARY KEY, value TEXT NOT NULL)`); err != nil {
565: 		t.Fatal(err)
566: 	}
567: 	if _, err = db.Exec(`INSERT INTO fixture(value) VALUES ('fence-compatible')`); err != nil {
568: 		t.Fatal(err)
569: 	}
570: 	var got string
571: 	if err = db.QueryRow(`SELECT value FROM fixture WHERE id=1`).Scan(&got); err != nil || got != "fence-compatible" {
572: 		t.Fatalf("business SQLite read under fence: %q %v", got, err)
573: 	}
574: 	if _, err = os.Stat(dbPath + "-wal"); err != nil {
575: 		t.Fatalf("business WAL file missing while DB open: %v", err)
576: 	}
577: 	t.Log("business data-root lease held; SQLite read/write and WAL file remained usable under executable fence")
578: }
