694: func TestExistingBusinessExplorerTokenNativeProbe(t *testing.T) {
695: 	token := windows.GetCurrentProcessToken()
696: 	user, err := token.GetTokenUser()
697: 	if err != nil {
698: 		t.Fatal(err)
699: 	}
700: 	p := EntryFencePlan{BusinessSID: user.User.Sid.String()}
701: 	shape, err := tokenSecurityShape(token, windows.GetCurrentProcessId(), p.BusinessSID)
702: 	if err != nil {
703: 		t.Fatal(err)
704: 	}
705: 	pre := BootWitness{BusinessSessionID: shape.SessionID, BusinessElevationType: shape.ElevationType, BusinessIntegritySID: shape.IntegritySID, BusinessLogonSID: shape.LogonSID, BusinessPrivilegesSHA256: shape.PrivilegesSHA256}
706: 	actual, err := inspectExistingBusinessProcess(p, shape.GroupsSHA256, pre)
707: 	if err != nil {
708: 		t.Fatalf("native Explorer TOKEN_QUERY boundary unavailable: %v", err)
709: 	}
710: 	t.Logf("native existing business Explorer token verified: current session=%d, elevation=%d, integrity=%s, logon SID present=%t", actual.SessionID, actual.ElevationType, actual.IntegritySID, actual.LogonSID != "")
711: }
