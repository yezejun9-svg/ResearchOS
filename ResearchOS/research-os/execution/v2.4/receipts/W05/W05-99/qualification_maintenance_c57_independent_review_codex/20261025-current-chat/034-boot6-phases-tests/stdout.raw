635: func TestLiveBusinessTokenGroupCapture(t *testing.T) {
636: 	token := windows.GetCurrentProcessToken()
637: 	user, err := token.GetTokenUser()
638: 	if err != nil {
639: 		t.Fatal(err)
640: 	}
641: 	groups, err := token.GetTokenGroups()
642: 	if err != nil {
643: 		t.Fatal(err)
644: 	}
645: 	var enabled []string
646: 	for _, group := range groups.AllGroups() {
647: 		if group.Attributes&windows.SE_GROUP_ENABLED != 0 && group.Attributes&(windows.SE_GROUP_USE_FOR_DENY_ONLY|windows.SE_GROUP_LOGON_ID|windows.SE_GROUP_INTEGRITY) == 0 {
648: 			enabled = append(enabled, group.Sid.String())
649: 		}
650: 	}
651: 	exe, err := os.Executable()
652: 	if err != nil {
653: 		t.Fatal(err)
654: 	}
655: 	p := EntryFencePlan{BusinessSID: user.User.Sid.String(), BusinessGroupSIDs: enabled, Targets: []FenceTarget{{File: FileIdentity{Path: exe}, Mode: "executable"}}}
656: 	sha, err := businessEnabledGroupDigest(p)
657: 	if err != nil {
658: 		t.Fatal(err)
659: 	}
660: 	if err = inspectLiveBusinessToken(p, sha); err != nil {
661: 		t.Fatalf("native business token group capture: %v", err)
662: 	}
663: 	p.BusinessGroupSIDs = []string{"S-1-5-32-544"}
664: 	sha, _ = businessEnabledGroupDigest(p)
665: 	if err := inspectLiveBusinessToken(p, sha); err == nil {
666: 		t.Fatal("frozen business group claim accepted without matching live token")
667: 	}
668: }
