84: func TestAppendOnlyBoundaryCrashSequence(t *testing.T) {
85: 	base := t.TempDir()
86: 	t.Setenv("ProgramData", base)
87: 	p := EntryFencePlan{OperationID: "0123456789abcdef0123456789abcdef", PlanSHA256: strings.Repeat("a", 64), DataRoot: FileIdentity{Path: `C:\fixture`, FinalUTF16: `\\?\C:\fixture`, FileID: strings.Repeat("1", 32)}}
88: 	dir, err := stateRoot(p)
89: 	if err != nil {
90: 		t.Fatal(err)
91: 	}
92: 	if err := os.MkdirAll(dir, 0700); err != nil {
93: 		t.Fatal(err)
94: 	}
95: 	if err := appendEvent(p, nil, "PREPARED"); err != nil {
96: 		t.Fatal(err)
97: 	}
98: 	if err := appendEvent(p, nil, "PREPARED"); err == nil {
99: 		t.Fatal("duplicate create replaced historical event")
100: 	}
101: 	raw, err := os.ReadFile(filepath.Join(dir, "event-01.json"))
102: 	if err != nil {
103: 		t.Fatal(err)
104: 	}
105: 	var first BoundaryEvent
106: 	if err := json.Unmarshal(raw, &first); err != nil {
107: 		t.Fatal(err)
108: 	}
109: 	if err := appendEvent(p, []BoundaryEvent{first}, "ARMED"); err == nil {
110: 		t.Fatal("crash phase skip accepted")
111: 	}
112: 	if err := appendEvent(p, []BoundaryEvent{first}, "APPLYING"); err != nil {
113: 		t.Fatal(err)
114: 	}
115: 	secondRaw, err := os.ReadFile(filepath.Join(dir, "event-02.json"))
116: 	if err != nil {
117: 		t.Fatal(err)
118: 	}
119: 	var second BoundaryEvent
120: 	if err := json.Unmarshal(secondRaw, &second); err != nil {
121: 		t.Fatal(err)
122: 	}
123: 	if err := ValidateEvents([]BoundaryEvent{first, second}, p.OperationID, p.PlanSHA256); err != nil {
124: 		t.Fatal(err)
125: 	}
126: 	second.PreviousSHA256 = ""
127: 	if err := ValidateEvents([]BoundaryEvent{first, second}, p.OperationID, p.PlanSHA256); err == nil {
128: 		t.Fatal("broken predecessor accepted")
129: 	}
130: }
