359: 		t.Fatal(err)
360: 	}
361: 	defer windows.CloseHandle(h.handle)
362: 	u, err := windows.GetCurrentProcessToken().GetTokenUser()
363: 	if err != nil {
364: 		t.Fatal(err)
365: 	}
366: 	installed, err := denyDescriptor(h.identity.SecurityDescriptor, u.User.Sid.String(), u.User.Sid.String(), "executable")
367: 	if err != nil {
368: 		t.Fatal(err)
369: 	}
370: 	if err = setTargetDescriptor(h.identity, installed); err != nil {
371: 		t.Fatal(err)
372: 	}
373: 	if err = setTargetDescriptor(withFixtureSD(h.identity, installed), h.identity.SecurityDescriptor); err != nil {
374: 		t.Fatal(err)
375: 	}
376: 	if err = setTargetDescriptor(withFixtureSD(h.identity, installed), h.identity.SecurityDescriptor); err == nil {
377: 		t.Fatal("stale installed descriptor overwrote changed target")
378: 	}
379: 	fresh, err := openNative(path, false, true)
380: 	if err != nil {
381: 		t.Fatal(err)
382: 	}
383: 	if !identityEqual(h.identity, fresh.identity) {
384: 		t.Error("stale attempt changed restored target")
385: 	}
386: 	if err = windows.CloseHandle(fresh.handle); err != nil {
387: 		t.Fatal(err)
388: 	}
389: }
