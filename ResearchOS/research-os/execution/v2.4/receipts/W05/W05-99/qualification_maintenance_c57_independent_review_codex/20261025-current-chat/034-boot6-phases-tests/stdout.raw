601: func TestRetainedOSAncestorEffectiveACE(t *testing.T) {
602: 	const rootSD = "O:SYG:SYD:(A;OICIIO;SDGXGWGR;;;AU)(A;;0x1301bf;;;AU)(A;;FA;;;SY)(A;OICIIO;GA;;;SY)(A;OICIIO;GA;;;BA)(A;;FA;;;BA)(A;;0x1200a9;;;BU)(A;OICIIO;GXGR;;;BU)"
603: 	root := FileIdentity{Path: `D:\`, SecurityDescriptor: rootSD}
604: 	p := EntryFencePlan{BusinessSID: "S-1-5-21-1-2-3-1001", ManagementSID: "S-1-5-21-1-2-3-1002", Ancestors: []FileIdentity{root}}
605: 	holds := []nativeHold{{path: root.Path, identity: root}}
606: 	medium := map[string]bool{p.BusinessSID: true, "S-1-5-11": true, "S-1-5-32-545": true} // BA is deny-only in the observed Medium token.
607: 	if err := checkAncestorACL(p, holds, medium); err != nil {
608: 		t.Fatalf("retained D root with effective AU read/modify and deny-only BA: %v", err)
609: 	}
610: 	medium["S-1-5-32-544"] = true
611: 	if err := checkAncestorACL(p, holds, medium); err == nil {
612: 		t.Fatal("BA enabled token accepted BA FullControl ancestor")
613: 	}
614: 	delete(medium, "S-1-5-32-544")
615: 	bad := root
616: 	bad.SecurityDescriptor = "O:SYG:SYD:(A;;FA;;;SY)(A;;FA;;;AU)"
617: 	if err := checkAncestorACL(p, []nativeHold{{path: root.Path, identity: bad}}, medium); err == nil {
618: 		t.Fatal("business effective FullControl on OS root accepted")
619: 	}
620: 	bad.SecurityDescriptor = "O:SYG:SYD:(A;;FA;;;SY)(A;OICIIO;FA;;;AU)"
621: 	if err := checkAncestorACL(p, []nativeHold{{path: root.Path, identity: bad}}, medium); err != nil {
622: 		t.Fatalf("inherit-only business grant incorrectly treated as effective on root: %v", err)
623: 	}
624: 	product := FileIdentity{Path: `D:\product`, SecurityDescriptor: "O:SYG:SYD:(A;;FA;;;SY)(A;;0x40;;;AU)"}
625: 	p.Ancestors = []FileIdentity{product}
626: 	if err := checkAncestorACL(p, []nativeHold{{path: product.Path, identity: product}}, medium); err == nil {
627: 		t.Fatal("business FILE_DELETE_CHILD on product ancestor accepted")
628: 	}
629: 	product.SecurityDescriptor = "O:AUG:SYD:(A;;FA;;;SY)"
630: 	if err := checkAncestorACL(p, []nativeHold{{path: product.Path, identity: product}}, medium); err == nil {
631: 		t.Fatal("business-owned product ancestor accepted")
632: 	}
633: }
