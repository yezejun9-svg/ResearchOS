326: func TestManagedStateRejectsCustomBusinessGroupACE(t *testing.T) {
327: 	manager := "S-1-5-21-100-200-300-1001"
328: 	base := "O:" + manager + "D:P(A;OICI;FA;;;" + manager + ")"
329: 	sd, err := windows.SecurityDescriptorFromString(base)
330: 	if err != nil {
331: 		t.Fatal(err)
332: 	}
333: 	if err = checkManagedDescriptor(sd, manager); err != nil {
334: 		t.Fatalf("private manager descriptor rejected: %v", err)
335: 	}
336: 	custom, err := windows.SecurityDescriptorFromString(base + "(A;OICI;FA;;;S-1-5-21-100-200-300-1002)")
337: 	if err != nil {
338: 		t.Fatal(err)
339: 	}
340: 	if err = checkManagedDescriptor(custom, manager); err == nil {
341: 		t.Fatal("custom business group full-control ACE accepted")
342: 	}
343: 	unprotected, err := windows.SecurityDescriptorFromString(strings.Replace(base, "D:P", "D:", 1))
344: 	if err != nil {
345: 		t.Fatal(err)
346: 	}
347: 	if err = checkManagedDescriptor(unprotected, manager); err == nil {
348: 		t.Fatal("unprotected state DACL accepted")
349: 	}
350: }
