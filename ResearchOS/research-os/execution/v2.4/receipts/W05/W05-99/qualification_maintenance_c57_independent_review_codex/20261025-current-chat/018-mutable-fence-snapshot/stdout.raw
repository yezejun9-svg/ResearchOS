1024:	sd, e := windows.SecurityDescriptorFromString(sddl)
1025:	if e != nil {
1026:		return e
1027:	}
1136:							break
1137:						}
1138:					}
1139:					if !match {
1140:						windows.CloseHandle(proc)
1141:						return errors.New("runtime RestartApps argv outside frozen entry inventory")
1142:					}
1143:				}
1144:			}
1145:			if err = windows.CloseHandle(proc); err != nil {
1146:				return err
1147:			}
1148:		}
1149:		e = windows.Process32Next(snapshot, &entry)
1150:		if errors.Is(e, windows.ERROR_NO_MORE_FILES) {
1151:			break
1152:		}
1153:		if e != nil {
1154:			return e
1155:		}
1156:	}
1157:	return nil
1158:}
1159:
1160:// RunPhase is the fixed management helper state machine. The caller supplies
1161:// only the exact root/operation/plan selector, never SQL or a target path.
1162:func RunPhase(ctx context.Context, phase, dataRoot, operationID, planSHA256 string) (stateOut string, errOut error) {
1163:	if e := ctx.Err(); e != nil {
1164:		return "", e
1165:	}
1166:	if phase != "plan" && phase != "arm" && phase != "observe" && phase != "status" && phase != "disarm-request" {
1167:		return "", errors.New("unsupported boundary phase")
1168:	}
1169:	if !filepath.IsAbs(dataRoot) || filepath.Clean(dataRoot) != dataRoot || !validOperation(operationID) || !validDigest(planSHA256) {
1170:		return "", errors.New("boundary selector invalid")
1171:	}
1172:	p, e := discoverPlan(dataRoot, operationID, planSHA256)
1173:	if e != nil {
1174:		return "", e
1175:	}
1176:	if e = ValidatePlan(p); e != nil {
1177:		return "", e
1178:	}
1179:	dir, e := stateRoot(p)
1180:	if e != nil {
1181:		return "", e
1182:	}
1183:	if e = checkManagedChain(p); e != nil {
1184:		return "", e
1185:	}
1186:	if e = checkAcceptanceFiles(p); e != nil {
1187:		return "", e
1188:	}
1189:	if phase == "plan" {
1190:		if e = managedToken(p); e != nil {
1191:			return "", e
1192:		}
1193:		entries, e := os.ReadDir(dir)
1194:		if e != nil {
1195:			return "", e
1196:		}
1197:		if len(entries) != 5 {
1198:			return "", errors.New("plan staging inventory not exact")
1199:		}
1200:		holds, e := openPlanHolds(p)
1201:		if e != nil {
1202:			return "", e
1203:		}
1204:		defer func() { errOut = errors.Join(errOut, closeHolds(holds)) }()
1205:		for _, t := range p.Targets {
1206:			expected, e := denyDescriptor(t.File.SecurityDescriptor, p.BusinessSID, p.ManagementSID,t.Mode)
1207:			if e != nil || expected != t.InstalledSD {
1208:				return "", errors.New("fence descriptor plan mismatch")
1209:			}
1210:		}
1211:		pre, e := witness(p, fenceDigest(p))
1212:		if e != nil {
1213:			return "", e
1214:		}
1215:		if pre.UptimeMilliseconds < uint64(MaxPostUptime/time.Millisecond) {
1216:			return "", errors.New("pre uptime insufficient")
1217:		}
1218:		if e = writeExclusiveJSON(filepath.Join(dir, "pre.json"), pre); e != nil {
1219:			return "", e
1220:		}
1221:		if e = appendEvent(p, nil, "PREPARED"); e != nil {
1222:			return "", e
1223:		}
1224:		return "PREPARED", nil
1225:	}
1226:	r, e := readRecord(p)
1227:	if e != nil {
1228:		return "", e
1229:	}
1230:	state := r.Events[len(r.Events)-1].State
1231:	if phase == "status" {
1232:		return state, nil
1233:	}
1234:	if e = managedToken(p); e != nil {
1235:		return "", e
1236:	}
1237:	switch phase {
1238:	case "arm":
1239:		if state != "PREPARED" {
1240:			return "", errors.New("arm requires PREPARED")
1241:		}
1242:		if e = checkPreCurrent(r.Pre, p.BusinessSID); e != nil {
1243:			return "", e
1244:		}
1245:		if e = checkRestartRegistrations(p); e != nil {
1246:			return "", e
1247:		}
1248:		holds, e := openPlanHolds(p)
1249:		if e != nil {
1250:			return "", e
1251:		}
1252:		defer func() { errOut = errors.Join(errOut, closeHolds(holds)) }()
1253:		if e = appendEvent(p, r.Events, "APPLYING"); e != nil {
1254:			return "", e
1255:		}
1256:		for _, t := range p.Targets {
1257:			if e = setTargetDescriptor(t.File.Path, t.InstalledSD); e != nil {
1258:				return "", e
1259:			}
1260:			h, e := openNative(t.File.Path, false, true)
1261:			if e != nil {
1262:				return "", e
1263:			}
1264:			ok := identityCoreEqual(t.File, h.identity) && h.identity.SecurityDescriptor == t.InstalledSD
1265:			closeErr := windows.CloseHandle(h.handle)
1266:			if closeErr != nil {
1267:				return "", closeErr
1268:			}
1269:			if !ok {
1270:				return "", errors.New("arm native readback mismatch")
1271:			}
1272:		}
1273:		r, e = readRecord(p)
1274:		if e != nil {
1275:			return "", e
1276:		}
1277:		if e = appendEvent(p, r.Events, "ARMED"); e != nil {
1278:			return "", e
1279:		}
1280:		return "ARMED", nil
1281:	case "observe":
1282:		if state != "ARMED" {
1283:			return "", errors.New("observe requires ARMED")
1284:		}
1285:		holds, e := openPlanHolds(p)
1286:		if e != nil {
