147:
148:func ValidatePlan(p EntryFencePlan) error {
149:	expected, err := ComputePlanSHA256(p)
150:	if err != nil || p.PlanSHA256 != expected {
151:		return errors.New("boundary plan canonical digest mismatch")
152:	}
153:	if p.Schema != PlanSchema || !validOperation(p.OperationID) || !validDigest(p.PlanSHA256) ||
154:		!validDigest(p.HostIdentitySHA256) || !validDigest(p.SubjectSHA256) ||
155:		!validDigest(p.EvidenceSHA256) || !validDigest(p.BackupManifestSHA256) ||
156:		!validDigest(p.SourceAcceptanceSHA256) || !validDigest(p.NativeAcceptanceSHA256) ||
157:		!validDigest(p.RecoveryPackageSHA256) || p.BusinessSID == "" || p.ManagementSID == "" ||
158:		strings.EqualFold(p.BusinessSID, p.ManagementSID) || len(p.Targets) == 0 || len(p.Targets) > 64 {
159:		return errors.New("recovery boundary plan incomplete")
160:	}
161:	if p.DataRoot.Path == "" || p.Database.Path != filepath.Join(p.DataRoot.Path, "researchos.sqlite") || p.Helper.Path == "" {
162:		return errors.New("recovery boundary root, database or helper mismatch")
163:	}
164:	if len(p.BusinessGroupSIDs)==0 || len(p.BusinessGroupSIDs)>64 { return errors.New("business enabled group inventory missing") }
165:	seen := map[string]bool{}
166:	if len(p.Ancestors) == 0 || len(p.Ancestors) > 256 {
167:		return errors.New("boundary ancestor inventory missing")
168:	}
169:	for _, a := range p.Ancestors {
170:		if !a.Directory || a.FileID == "" || a.FinalUTF16 == "" || a.SecurityDescriptor == "" || seen[strings.ToLower(a.Path)] {
171:			return errors.New("boundary ancestor identity invalid")
172:		}
173:		seen[strings.ToLower(a.Path)] = true
174:	}
175:	for _, t := range p.Targets {
176:		if t.Mode != "executable" && t.Mode != "script" {
177:			return errors.New("unknown fence target mode")
178:		}
179:		if !filepath.IsAbs(t.File.Path) || filepath.Clean(t.File.Path) != t.File.Path || seen[strings.ToLower(t.File.Path)] || t.File.Directory {
180:			return errors.New("fence inventory path invalid")
181:		}
182:		seen[strings.ToLower(t.File.Path)] = true
183:		if len(t.RestartArgsSHA256) > 16 {
184:			return errors.New("restart argv inventory unbounded")
185:		}
186:		for _, sha := range t.RestartArgsSHA256 {
187:			if !validDigest(sha) {
188:				return errors.New("restart argv digest invalid")
189:			}
190:		}
191:	}
192:	return nil
internal/recoveryboundary/boot_windows.go
81:func openNative(path string, directory bool, hashFile bool) (nativeHold, error) {
82:	if !filepath.IsAbs(path) || filepath.Clean(path) != path {
83:		return nativeHold{}, errors.New("native path is not canonical absolute")
84:	}
85:	if strings.Contains(path[len(filepath.VolumeName(path)):], ":") {
86:		return nativeHold{}, errors.New("alternate data stream forbidden")
87:	}
88:	w, e := windows.UTF16PtrFromString(path)
89:	if e != nil {
90:		return nativeHold{}, e
91:	}
92:	// No FILE_SHARE_DELETE: the live owner pins every opened component against
93:	// rename/delete until the caller's actual outer transaction has returned.
94:	h, e := windows.CreateFile(w, windows.READ_CONTROL|windows.FILE_READ_ATTRIBUTES|windows.FILE_READ_DATA,
95:		windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, nil, windows.OPEN_EXISTING,
96:		windows.FILE_FLAG_OPEN_REPARSE_POINT|windows.FILE_FLAG_BACKUP_SEMANTICS, 0)
97:	if e != nil {
98:		return nativeHold{}, e
99:	}
100:	fail := func(e error) (nativeHold, error) { windows.CloseHandle(h); return nativeHold{}, e }
101:	var info windows.ByHandleFileInformation
102:	if e = windows.GetFileInformationByHandle(h, &info); e != nil {
103:		return fail(e)
104:	}
105:	if info.FileAttributes&windows.FILE_ATTRIBUTE_REPARSE_POINT != 0 || (info.FileAttributes&windows.FILE_ATTRIBUTE_DIRECTORY != 0) != directory {
106:		return fail(errors.New("reparse point or file kind mismatch"))
107:	}
108:	if !directory && info.NumberOfLinks != 1 {
109:		return fail(errors.New("hard-linked boundary file forbidden"))
110:	}
111:	v, id, e := nativeFileID(h)
112:	if e != nil {
113:		return fail(e)
114:	}
115:	final, e := finalPath(h)
116:	if e != nil {
117:		return fail(e)
118:	}
119:	sd, e := windows.GetSecurityInfo(h, windows.SE_FILE_OBJECT, windows.OWNER_SECURITY_INFORMATION|windows.DACL_SECURITY_INFORMATION)
120:	if e != nil {
121:		return fail(e)
122:	}
123:	x := FileIdentity{Path: path, FinalUTF16: final, Volume: v, FileID: id, SecurityDescriptor: sd.String(), Directory: directory}
124:	if hashFile {
125:		if directory {
126:			return fail(errors.New("cannot hash directory"))
127:		}
128:		s := sha256.New()
129:		var total int64
130:		buf := make([]byte, 64<<10)
131:		for {
132:			var n uint32
133:			e = windows.ReadFile(h, buf, &n, nil)
134:			if e != nil {
135:				return fail(e)
136:			}
137:			if n == 0 {
138:				break
139:			}
140:			total += int64(n)
141:			if total > 128<<20 {
142:				return fail(errors.New("hash input exceeds bound"))
143:			}
144:			_, _ = s.Write(buf[:n])
145:		}
146:		x.SHA256 = hex.EncodeToString(s.Sum(nil))
147:	}
148:	return nativeHold{path: path, handle: h, identity: x}, nil
149:}
150:
182:func openPlanHolds(p EntryFencePlan) ([]nativeHold, error) {
183:	all := []FileIdentity{p.DataRoot, p.Database, p.Helper}
184:	all = append(all, p.Ancestors...)
185:	for _, t := range p.Targets {
186:		all = append(all, t.File)
187:	}
188:	want := map[string]FileIdentity{}
189:	for _, x := range all {
190:		want[strings.ToLower(x.Path)] = x
191:	}
192:	for _, x := range all {
193:		for _, a := range pathAncestors(x.Path) {
194:			if _, ok := want[strings.ToLower(a)]; !ok {
195:				return nil, fmt.Errorf("ancestor absent from frozen inventory: %s", a)
196:			}
197:		}
198:	}
199:	keys := make([]string, 0, len(want))
200:	for k := range want {
201:		keys = append(keys, k)
202:	}
203:	sort.Strings(keys)
204:	var holds []nativeHold
205:	for _, k := range keys {
206:		x := want[k]
207:		h, e := openNative(x.Path, x.Directory, !x.Directory)
208:		if e != nil {
209:			closeHolds(holds)
210:			return nil, fmt.Errorf("open boundary identity %s: %w", x.Path, e)
211:		}
212:		matches := identityEqual(x, h.identity)
213:		if !matches {
214:			for _, target := range p.Targets {
215:				if strings.EqualFold(target.File.Path, x.Path) && identityCoreEqual(x, h.identity) && target.InstalledSD == h.identity.SecurityDescriptor {
216:					matches = true
217:					break
218:				}
219:			}
220:		}
221:		if !matches {
222:			windows.CloseHandle(h.handle)
223:			closeHolds(holds)
224:			return nil, fmt.Errorf("boundary identity drift: %s", x.Path)
225:		}
226:		holds = append(holds, h)
227:	}
228:	return holds, nil
229:}
230:
231:func checkHolds(holds []nativeHold) error {
232:	if len(holds) == 0 {
233:		return errors.New("native boundary holds missing")
234:	}
235:	for _, h := range holds {
236:		fresh, e := openNative(h.path, h.identity.Directory, !h.identity.Directory)
237:		if e != nil {
238:			return e
239:		}
240:		same := identityEqual(h.identity, fresh.identity)
241:		if e = windows.CloseHandle(fresh.handle); e != nil {
242:			return e
243:		}
244:		if !same {
245:			return fmt.Errorf("native boundary identity changed: %s", h.path)
246:		}
247:	}
248:	return nil
249:}
423:func checkManagedDirectory(path, sid string) error {
424:	h, e := openNative(path, true, false)
425:	if e != nil {
426:		return e
427:	}
428:	defer windows.CloseHandle(h.handle)
429:	sd, e := windows.GetSecurityInfo(h.handle, windows.SE_FILE_OBJECT, windows.OWNER_SECURITY_INFORMATION|windows.DACL_SECURITY_INFORMATION)
430:	if e != nil {
431:		return e
432:	}
433:	owner, _, e := sd.Owner()
434:	if e != nil || owner == nil || owner.String() != sid {
435:		return errors.New("boundary management owner mismatch")
436:	}
437:	control, _, e := sd.Control()
438:	if e != nil || control&windows.SE_DACL_PROTECTED == 0 {
439:		return errors.New("boundary state DACL not protected")
440:	}
441:	if strings.Contains(h.identity.SecurityDescriptor, ";;;WD)") || strings.Contains(h.identity.SecurityDescriptor, ";;;AU)") || strings.Contains(h.identity.SecurityDescriptor, ";;;BU)") {
442:		return errors.New("boundary state broad access ACE present")
443:	}
444:	return nil
445:}
446:
447:func checkManagedChain(p EntryFencePlan) error {
448:	dir, e := stateRoot(p)
449:	if e != nil {
450:		return e
451:	}
452:	base := os.Getenv("ProgramData")
453:	for _, path := range pathAncestors(dir) {
454:		if strings.EqualFold(path, base) {
455:			continue
456:		}
457:		if strings.HasPrefix(strings.ToLower(path), strings.ToLower(base)+string(filepath.Separator)) {
458:			if e = checkManagedDirectory(path, p.ManagementSID); e != nil {
459:				return e
460:			}
461:		}
462:	}
463:	return checkManagedDirectory(dir, p.ManagementSID)
464:}
465:
508:func checkFence(p EntryFencePlan, holds []nativeHold) error {
509:	byPath := map[string]FileIdentity{}
510:	for _, h := range holds {
511:		byPath[strings.ToLower(h.path)] = h.identity
512:	}
513:	for _, t := range p.Targets {
514:		x, ok := byPath[strings.ToLower(t.File.Path)]
515:		if !ok || !identityCoreEqual(x, t.File) || t.InstalledSD == "" || x.SecurityDescriptor != t.InstalledSD {
516:			return errors.New("fence target readback mismatch")
517:		}
518:		expected, e := denyDescriptor(t.File.SecurityDescriptor, p.BusinessSID, p.ManagementSID,t.Mode)
519:		if e != nil || expected != x.SecurityDescriptor {
520:			return errors.New("business SID exact deny descriptor absent")
521:		}
522:	}
523:	return nil
524:}
525:
526:func checkAncestorControl(p EntryFencePlan,holds []nativeHold) error {
527:	protected:=map[string]bool{}
528:	for _,a:=range p.Ancestors { protected[strings.ToLower(a.Path)]=true }
529:	protected[strings.ToLower(p.DataRoot.Path)]=true
530:	groups:=map[string]bool{p.BusinessSID:true,"S-1-1-0":true,"S-1-5-11":true,"S-1-5-32-545":true}
531:	for _,group:=range p.BusinessGroupSIDs { if _,e:=windows.StringToSid(group); e!=nil { return e }; groups[group]=true }
532:	for _,h:=range holds {
533:		if !protected[strings.ToLower(h.path)] { continue }
534:		sd,e:=windows.SecurityDescriptorFromString(h.identity.SecurityDescriptor); if e!=nil { return e }
535:		owner,_,e:=sd.Owner(); if e!=nil || owner==nil || owner.String()==p.BusinessSID { return fmt.Errorf("ancestor owner can revoke boundary: %s",h.path) }
536:		acl,_,e:=sd.DACL(); if e!=nil || acl==nil { return fmt.Errorf("ancestor DACL unavailable: %s",h.path) }
537:		for i:=uint32(0);i<uint32(acl.AceCount);i++ {
538:			var ace *windows.ACCESS_ALLOWED_ACE
539:			if e=windows.GetAce(acl,i,&ace); e!=nil { return e }
540:			if ace.Header.AceType==windows.ACCESS_DENIED_ACE_TYPE { continue }
541:			if ace.Header.AceType!=windows.ACCESS_ALLOWED_ACE_TYPE { return fmt.Errorf("ancestor ACL ACE unsupported: %s",h.path) }
542:			if !groups[(*windows.SID)(unsafe.Pointer(&ace.SidStart)).String()] { continue }
543:			forbidden:=uint32(windows.FILE_DELETE_CHILD|windows.WRITE_DAC|windows.WRITE_OWNER|windows.GENERIC_ALL)
544:			if filepath.Dir(h.path)!=h.path { forbidden|=windows.DELETE }
545:			if ace.Mask&forbidden!=0 { return fmt.Errorf("business group can replace ancestor: %s",h.path) }
546:		}
547:	}
548:	return nil
549:}
550:
551:func denyDescriptor(original, sidText, managementSID, mode string) (string, error) {
552:	sid, e := windows.StringToSid(sidText)
553:	if e != nil {
554:		return "", e
555:	}
556:	sd, e := windows.SecurityDescriptorFromString(original)
557:	if e != nil {
558:		return "", e
559:	}
560:	old, _, e := sd.DACL()
561:	if e != nil {
562:		return "", e
563:	}
564:	mask := windows.ACCESS_MASK(windows.FILE_EXECUTE)
565:	if mode == "script" {
566:		mask = windows.ACCESS_MASK(windows.FILE_READ_DATA)
567:	} else if mode != "executable" {
568:		return "", errors.New("unknown target mode")
569:	}
570:	if managementSID!=sidText {
571:		mask |= windows.ACCESS_MASK(windows.WRITE_DAC|windows.WRITE_OWNER|windows.DELETE|windows.FILE_WRITE_DATA|windows.FILE_APPEND_DATA)
572:	}
573:	ace := windows.EXPLICIT_ACCESS{AccessPermissions: mask, AccessMode: windows.DENY_ACCESS, Inheritance: windows.NO_INHERITANCE,
574:		Trustee: windows.TRUSTEE{TrusteeForm: windows.TRUSTEE_IS_SID, TrusteeType: windows.TRUSTEE_IS_USER, TrusteeValue: windows.TrusteeValueFromSID(sid)}}
575:	acl, e := windows.ACLFromEntries([]windows.EXPLICIT_ACCESS{ace}, old)
576:	if e != nil {
577:		return "", e
578:	}
579:	// Protecting a DACL makes formerly inherited ACEs explicit on the object.
580:	// Normalize the planned descriptor to the native readback representation.
581:	for i := uint32(0); i < uint32(acl.AceCount); i++ {
582:		var item *windows.ACCESS_ALLOWED_ACE
583:		if e = windows.GetAce(acl, i, &item); e != nil {
584:			return "", e
585:		}
997:		writeErr = f.Sync()
998:	}
999:	return errors.Join(writeErr, f.Close())
1000:}
1001:
1002:func appendEvent(p EntryFencePlan, events []BoundaryEvent, state string) error {
1003:	if e := ValidateEvents(events, p.OperationID, p.PlanSHA256); e != nil && len(events) > 0 {
1004:		return e
1005:	}
1006:	previous, previousHash := "", ""
1007:	if len(events) > 0 {
1008:		previous = events[len(events)-1].State
1009:		previousHash = events[len(events)-1].SHA256
1010:	}
1011:	if !transition(previous, state) {
1012:		return errors.New("boundary phase transition invalid")
1013:	}
1014:	e := BoundaryEvent{Schema: EventSchema, Sequence: uint64(len(events) + 1), PreviousSHA256: previousHash, OperationID: p.OperationID, PlanSHA256: p.PlanSHA256, State: state, UTC: time.Now().UTC()}
1015:	e.SHA256 = digest([]byte(fmt.Sprintf("%s\x00%d\x00%s\x00%s\x00%s\x00%s\x00%s", e.Schema, e.Sequence, e.PreviousSHA256, e.OperationID, e.PlanSHA256, e.State, e.UTC.UTC().Format(time.RFC3339Nano))))
1016:	dir, err := stateRoot(p)
1017:	if err != nil {
1018:		return err
1019:	}
1020:	return writeExclusiveJSON(filepath.Join(dir, fmt.Sprintf("event-%02d.json", e.Sequence)), e)
1021:}
