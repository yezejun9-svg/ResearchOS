+			if len(current.Rows) != len(old.Rows)+1 {
+				return fmt.Errorf("PREPARED_UPGRADE_MIGRATION_HISTORY_CHANGED")
+			}
+		} else if !reflect.DeepEqual(old.Rows, current.Rows) {
