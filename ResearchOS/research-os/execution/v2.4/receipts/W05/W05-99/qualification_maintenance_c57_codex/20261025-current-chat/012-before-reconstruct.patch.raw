+	var b preparedBackupHandoffBinding
+	if !preparedHandoffDigest(handoff.BindingSHA256) {
+		return b, fmt.Errorf("PREPARED_HANDOFF_BINDING_PIN_REQUIRED")
+	}
+	raw, err := os.ReadFile(handoff.BindingFile)
+	if err != nil || Digest(raw) != handoff.BindingSHA256 {
+		return b, fmt.Errorf("PREPARED_HANDOFF_BINDING_CHANGED")
+	}
+	dec := json.NewDecoder(bytes.NewReader(raw))
+	dec.DisallowUnknownFields()
+	if err = dec.Decode(&b); err != nil {
+		return b, err
+	}
+	if err = dec.Decode(new(any)); err != io.EOF {
+		return b, fmt.Errorf("PREPARED_HANDOFF_BINDING_TRAILING_DATA")
+	}
+	sourcePath, err := upgradePath(b.SourceDatabase, true)
+	if err != nil || !strings.EqualFold(sourcePath, opt.Source) {
+		return b, fmt.Errorf("PREPARED_HANDOFF_SOURCE_PATH")
+	}
+	backupPath, err := upgradePath(b.BackupDirectory, true)
+	if err != nil || !strings.EqualFold(backupPath, opt.Snapshot) {
+		return b, fmt.Errorf("PREPARED_HANDOFF_BACKUP_PATH")
+	}
+	source, target, err := preparedUpgradeProgramHashes(opt, true)
+	if err != nil {
+		return b, err
