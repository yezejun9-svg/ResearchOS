-    return preparedUpgradeIntegrity(ctx, tx)
+	if Digest(raw) != preparedUpgradeSQLHash {
+		return fmt.Errorf("PREPARED_UPGRADE_SQL_HASH")
+	}
+	if err := preparedUpgradeVersions(tx, 23); err != nil {
+		return err
+	}
+	schema, err := preparedUpgradeSchema(tx)
+	if err != nil || schema != sourceSchema {
+		return fmt.Errorf("PREPARED_UPGRADE_SOURCE_SCHEMA")
+	}
+	current, err := preparedUpgradeSnapshot(tx)
+	if err != nil || Hash(current) != Hash(before) {
+		return fmt.Errorf("PREPARED_UPGRADE_BASELINE_CHANGED")
+	}
+	if _, err = tx.ExecContext(ctx, string(raw)); err != nil {
+		return err
+	}
+	if _, err = tx.ExecContext(ctx, "INSERT INTO schema_migrations(version) VALUES(24)"); err != nil {
+		return err
+	}
+	after, err := preparedUpgradeSnapshot(tx)
+	if err != nil {
+		return err
+	}
+	if err = preparedUpgradeRowInvariant(before, after); err != nil {
+		return err
+	}
+	if err = preparedUpgradeVersions(tx, 24); err != nil {
+		return err
+	}
+	schema, err = preparedUpgradeSchema(tx)
+	if err != nil || schema != targetSchema {
+		return fmt.Errorf("PREPARED_UPGRADE_TARGET_SCHEMA")
+	}
+	return preparedUpgradeIntegrity(ctx, tx)
 }
 
 func preparedUpgradeTemplate(ctx context.Context, sqls [][]byte, contracts *Contracts) (preparedUpgradeSchemas, error) {
