+	if result.Restored23, err = preparedUpgradeSchema(db); err != nil {
+		return result, err
+	}
+	if _, err = db.ExecContext(ctx, string(sqls[23])); err != nil {
+		return result, err
+	}
+	result.Restored24, err = preparedUpgradeSchema(db)
+	return result, err
