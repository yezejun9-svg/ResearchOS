+		if err = rows.Scan(&version, &typ); err != nil {
+			return err
+		}
+		seen++
+		if version != seen || typ != "integer" || seen > n {
+			return fmt.Errorf("PREPARED_UPGRADE_MIGRATION_INVENTORY")
