776: // Observation is host-created. PID creation time is represented as decimal
777: // text to retain all 64 bits through canonical JSON, unlike a float64 number.
778: func (j BridgeJournal) Observation() (map[string]any, error) {
779: 	manifest, e := bridgeMap(j.Manifest)
780: 	if e != nil {
781: 		return nil, e
782: 	}
783: 	admission, _ := manifest["admission"].(map[string]any)
784: 	profile, _ := admission["profile"].(map[string]any)
785: 	spec := map[string]any{"run_id": manifest["run_id"], "task_id": manifest["task_id"], "epoch": manifest["epoch"], "profile_hash": admission["profile_hash"], "technical_hash": admission["technical_hash"], "capabilities": []any{"start"}}
786: 	if j.ContextReady {
787: 		spec["capabilities"] = []any{"start", "context_rebuild"}
788: 	}
789: 	for _, key := range []string{"build_hash", "backend", "model", "sandbox", "platform", "adapter", "adapter_revision", "credential_revision"} {
790: 		spec[key] = profile[key]
791: 	}
792: 	state := j.State
793: 	if state == "EXITED" {
794: 		state = "UNKNOWN"
795: 	}
796: 	if j.Cancelled && j.Receipt.Stopped && j.Receipt.StreamsDrained {
797: 		state = "CANCELLED"
798: 	}
799: 	return map[string]any{"spec": spec, "dispatch_key": j.DispatchKey, "manifest_hash": j.ManifestHash, "worker": j.Worker, "identity": map[string]any{"pid": j.Identity.PID, "process_created_ns": strconv.FormatInt(j.Identity.Created, 10), "job": j.Identity.Job, "appcontainer_sid": j.Identity.SID, "profile": j.Identity.Profile, "staging_directory": j.Identity.StagingDirectory}, "observation_sequence": j.Sequence, "state": state, "reason": j.Reason, "children_stopped": j.Receipt.Stopped, "queue_empty": j.Acknowledged == j.Frames && (!j.QueueRequired || j.QueueSealed || j.Cancelled && j.QueueCancelIdle), "streams_drained": j.Receipt.StreamsDrained, "cleanup_complete": j.Receipt.CleanupComplete, "exit_code": j.Receipt.ExitCode, "ended": j.Ended, "protocol": map[string]any{"settled": state == "SETTLED" && j.ProtocolComplete && j.Receipt.StreamsDrained, "frames": j.Frames, "acknowledged": j.Acknowledged}, "artifacts": j.Artifacts, "stdout_hash": j.StdoutHash, "stderr_hash": j.StderrHash}, nil
800: }
