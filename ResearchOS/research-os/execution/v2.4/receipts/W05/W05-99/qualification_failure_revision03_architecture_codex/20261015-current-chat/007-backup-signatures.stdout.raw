412:func upgradePreparedAbandonmentLocal(ctx context.Context, opt LocalUpgradeOptions, verifier upgradeVerifier) (report RestoreReport, err error) {
413:    report = RestoreReport{Started: Now(), Status: "FAILED"}
414:    if opt.Plan != PreparedAbandonmentSchemaUpgradePlan { return report, fmt.Errorf("PREPARED_UPGRADE_PLAN_UNSUPPORTED") }
415:    if err := upgradePaths(&opt); err != nil { return report, err }
416:    lease, err := acquirePreparedUpgradeRootLease(filepath.Dir(opt.Source))
417:    if err != nil { return report, err }
418:    defer func() {
419:        if closeErr := lease.Close(); closeErr != nil && err == nil { err = closeErr }
420:    }()
421:    sourceRelease, _, err := preparedUpgradeRelease(opt.SourceRoot, 23)
422:    if err != nil { return report, err }
423:    targetRelease, sqls, err := preparedUpgradeRelease(opt.TargetRoot, 24)
424:    if err != nil { return report, err }
425:    sourceProgram, targetProgram, err := preparedUpgradeProgramHashes(opt, false)
426:    if err != nil { return report, err }
427:    contracts, err := LoadContracts(filepath.Join(opt.TargetRoot, "spec/v2.0/contracts"))
428:    if err != nil { return report, err }
429:    schemas, err := preparedUpgradeTemplate(ctx, sqls, contracts)
430:    if err != nil { return report, err }
431:    key, err := os.ReadFile(opt.KeyFile)
432:    if err != nil || len(key) != 32 { return report, fmt.Errorf("BACKUP_KEY_UNAVAILABLE") }
433:    defer clear(key)
434:    db, err := upgradeOpenExclusive(ctx, opt.Source)
435:    if err != nil { return report, err }
436:    defer db.Close()
437:    if err = preparedUpgradeVersions(db, 23); err != nil { return report, err }
438:    schema, err := preparedUpgradeSchema(db)
439:    if err != nil || schema != schemas.Source23 { return report, fmt.Errorf("PREPARED_UPGRADE_SOURCE_SCHEMA") }
440:    guard := &upgradeQueueProtection{upgradeProtection: upgradeProtection{ctx: ctx, verifier: verifier}, contracts: contracts}
