21:type preparedUpgradeRootLease struct { native *runtimeadapter.DataRootLease }
22:
23:func acquirePreparedUpgradeRootLease(root string) (*preparedUpgradeRootLease, error) {
24:    lease, err := runtimeadapter.AcquireDataRootLease(root)
25:    if err != nil { return nil, err }
26:    return &preparedUpgradeRootLease{native: lease}, nil
27:}
28:func (l *preparedUpgradeRootLease) Check() error {
29:    if l == nil || l.native == nil || !l.native.Held() {
30:        return fmt.Errorf("PREPARED_UPGRADE_DATA_ROOT_LEASE_REQUIRED")
31:    }
32:    return nil
33:}
34:func (l *preparedUpgradeRootLease) Close() error {
35:    if l == nil { return nil }
36:    return l.native.Close()
37:}
