175:
176:func upgradePreparedAbandonmentBackup(ctx context.Context, handoff PreparedBackupHandoffOptions, verifier upgradeVerifier) (report RestoreReport, err error) {
177:    opt := handoff.Upgrade
178:    report = RestoreReport{Started: Now(), Status: "FAILED"}
179:    if opt.Plan != PreparedAbandonmentSchemaUpgradePlan { return report, fmt.Errorf("PREPARED_UPGRADE_PLAN_UNSUPPORTED") }
180:    if err := preparedHandoffPaths(&opt, &handoff); err != nil { return report, err }
181:    lease, err := acquirePreparedUpgradeRootLease(filepath.Dir(opt.Source))
182:    if err != nil { return report, err }
183:    defer func() {
184:        if closeErr := lease.Close(); closeErr != nil && err == nil { err = closeErr }
185:    }()
186:    sourceRelease, _, err := preparedUpgradeRelease(opt.SourceRoot, 23)
187:    if err != nil { return report, err }
188:    targetRelease, sqls, err := preparedUpgradeRelease(opt.TargetRoot, 24)
189:    if err != nil { return report, err }
190:    sourceProgram, targetProgram, err := preparedUpgradeProgramHashes(opt, true)
191:    if err != nil { return report, err }
192:    binding, err := preparedHandoffCheck(opt, handoff)
193:    if err != nil { return report, err }
194:    contracts, err := LoadContracts(filepath.Join(opt.TargetRoot, "spec/v2.0/contracts"))
195:    if err != nil { return report, err }
196:    schemas, err := preparedUpgradeTemplate(ctx, sqls, contracts)
197:    if err != nil { return report, err }
198:    key, err := os.ReadFile(opt.KeyFile)
199:    if err != nil || len(key) != 32 { return report, fmt.Errorf("BACKUP_KEY_UNAVAILABLE") }
200:    defer clear(key)
201:    if err = preparedHandoffVerifyBackup(opt, key, binding); err != nil { return report, err }
202:    db, err := upgradeOpenExclusive(ctx, opt.Source)
