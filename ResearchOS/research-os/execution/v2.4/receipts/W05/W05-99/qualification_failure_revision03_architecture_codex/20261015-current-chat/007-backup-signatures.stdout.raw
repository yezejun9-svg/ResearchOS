19:
20:func run() error {
21:	dbPath := flag.String("db", "", "fixture authority SQLite path")
22:	contracts := flag.String("contracts", "", "contracts directory")
23:	migration := flag.String("migration", "", "migration path")
24:	private := flag.String("private", "", "existing CanaryStore root")
25:	project := flag.String("project", "", "project")
26:	operation := flag.String("operation", "", "operation")
27:	control := flag.String("control", "", "exact actual-control fixture executable")
28:	root := flag.String("root", "", "existing fixture host root")
29:	work := flag.String("work-dir", "", "control working directory")
30:	web := flag.String("web-dir", "", "fixture web build directory")
31:	listen := flag.String("listen", "", "control loopback listener")
32:	flag.Parse()
33:	if *control != "" {
34:		return runControlHost(*control, *root, *work, *web, *listen, *private, *contracts)
35:	}
36:	if *dbPath == "" || *contracts == "" || *migration == "" || *private == "" || *project == "" || *operation == "" {
37:		return fmt.Errorf("R2_FIXTURE_ARGUMENTS_REQUIRED")
38:	}
39:	protected, err := protectedstore.OpenCanary(*private)
40:	if err != nil {
41:		return err
42:	}
43:	defer protected.Close()
44:	lease, err := rt.AcquireDataRootLease(filepath.Dir(*dbPath))
45:	if err != nil {
46:		return fmt.Errorf("offline legacy fixture authority required: %w", err)
47:	}
48:	defer lease.Close()
49:	db, err := store.Open(*dbPath)
50:	if err != nil {
51:		return err
52:	}
53:	defer db.Close()
54:	svc, err := domain.New(db, *contracts, *migration)
55:	if err != nil {
56:		return err
57:	}
58:	svc.Protected = protected
59:	result, err := svc.RunEvolutionReleaseFixtureOnce(context.Background(), *project, *operation)
60:	if err != nil {
61:		return err
62:	}
63:	return json.NewEncoder(os.Stdout).Encode(result)
64:}
