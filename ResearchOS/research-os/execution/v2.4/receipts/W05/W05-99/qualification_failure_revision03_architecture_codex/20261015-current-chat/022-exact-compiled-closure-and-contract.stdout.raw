382: // goEnvironment permits only offline, deterministic Go configuration. Writable
383: // paths stay in the output root; GOROOT is read-only staged input. No PATH or
384: // host environment is inherited by the AppContainer.
385: func goEnvironment(values map[string]string, input, output string, remap func(string) string) (map[string]string, error) {
386: 	result := make(map[string]string, len(values))
387: 	within := func(root, path string) bool {
388: 		if !filepath.IsAbs(path) {
389: 			return false
390: 		}
391: 		rel, err := filepath.Rel(root, path)
392: 		return err == nil && rel != ".." && !strings.HasPrefix(rel, ".."+string(os.PathSeparator))
393: 	}
394: 	for key, value := range values {
395: 		if key != strings.ToUpper(key) || strings.ContainsAny(key+value, "=\x00") || value == "" {
396: 			return nil, fmt.Errorf("invalid Go environment %q", key)
397: 		}
398: 		switch key {
399: 		case "GOROOT":
400: 			if !within(input, value) {
401: 				return nil, fmt.Errorf("GOROOT must be in staged input")
402: 			}
403: 		case "GOPATH", "GOCACHE", "GOTMPDIR":
404: 			if !within(output, value) {
405: 				return nil, fmt.Errorf("%s must be in staged output", key)
406: 			}
407: 		case "GOTOOLCHAIN":
408: 			if value != "local" {
409: 				return nil, fmt.Errorf("GOTOOLCHAIN must be local")
410: 			}
