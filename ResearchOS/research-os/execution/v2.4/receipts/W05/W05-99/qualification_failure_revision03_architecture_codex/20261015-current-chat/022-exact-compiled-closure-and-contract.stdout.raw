53: func providerEndpointAllowed(provider RuntimeProviderRoute) bool {
54: 	u, err := url.Parse(provider.Endpoint)
55: 	if err != nil || u.User != nil || u.Fragment != "" || u.Hostname() == "" {
56: 		return false
57: 	}
58: 	if u.Scheme == "https" {
59: 		return true
60: 	}
61: 	if u.Scheme != "http" {
62: 		return false
63: 	}
64: 	if provider.Capability == "MODEL" && provider.MeasurementMode == "LIVE" {
65: 		return clientConfigurationLoopbackModelEndpoint(provider.Endpoint)
66: 	}
67: 	ip := net.ParseIP(u.Hostname())
68: 	return provider.MeasurementMode == "FIXTURE" && ip != nil && ip.IsLoopback()
69: }
