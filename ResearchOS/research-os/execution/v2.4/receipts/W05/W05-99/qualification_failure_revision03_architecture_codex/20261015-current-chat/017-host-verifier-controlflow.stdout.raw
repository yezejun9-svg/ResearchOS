35:func (c *RuntimeCoordinator) localQualification(tx *sql.Tx, p Principal, request LocalRuntimeQualificationRequest) (Object, Object, error) {
36:	if request.RequestID == "" || request.AuthorizePurpose != "mu_turn" || request.PurposeSeconds < 1 || request.PurposeSeconds > 3600 || request.PlanHash == "" || request.ProfileHash == "" {
37:		return nil, nil, Fail(422, "GATE_FAILED", "explicit bounded local qualification request required")
38:	}
39:	candidate := RuntimeSetupCandidate{ProjectID: request.ProjectID, SessionID: request.SessionID, PrincipalID: p.ID, ModelRef: request.ModelRef}
40:	if _, e := c.service.runtimeSetupConfiguration(context.Background(), tx, p, candidate, c.config.ClientSchema, c.config.ConfigurationAuthority); e != nil {
41:		return nil, nil, e
42:	}
43:	runtime, profile, e := c.sessionModel(tx, request.ProjectID, request.ModelRef)
44:	if e != nil || runtime["id"] != request.RuntimeID {
45:		return nil, nil, Fail(412, "STALE_INPUT", "configured runtime differs from managed qualification request")
46:	}
47:	plan, digest, root, e := qualificationPlan(tx, request.ProjectID, request.TaskID, request.RuntimeID)
48:	ownerRoot, rootErr := currentAuthorityRoot(tx, p.ID)
49:	if e != nil || rootErr != nil || root != ownerRoot || digest != request.PlanHash || Hash(plan["profile_ref"]) != request.ProfileHash {
50:		return nil, nil, Fail(412, "STALE_INPUT", "managed qualification plan, profile or Owner changed")
51:	}
52:	config, _ := profile["model_config"].(map[string]any)
53:	if config["ref"] != request.ModelRef {
54:		return nil, nil, Fail(422, "GATE_FAILED", "exact configured local Mu profile required")
55:	}
56:	if e = validateLocalQualificationProfile(profile); e != nil {
57:		return nil, nil, e
58:	}
59:	if profile["coding_authorization"] != nil {
60:		var workspace string
61:		if e = tx.QueryRow(`SELECT workspace_ref FROM client_sessions WHERE id=? AND project_id=?`, request.SessionID, request.ProjectID).Scan(&workspace); e != nil {
62:			return nil, nil, e
63:		}
64:		if e = c.validateCodingWorkspace(context.Background(), tx, p.ID, request.ProjectID, request.SessionID, workspace, profile); e != nil {
65:			return nil, nil, e
66:		}
67:	}
68:	task, e := load(tx, request.ProjectID, "Task", request.TaskID)
69:	if e != nil || qualificationTaskHash(task) != plan["task_hash"] {
70:		return nil, nil, Fail(412, "STALE_INPUT", "qualification task inputs changed")
71:	}
72:	return runtime, task, nil
73:}
74:
75:// ValidateLocalQualification is read-only and exposes no token or execution
76:// capability. The same checks run again under the sole scan lock before Begin.
77:func (c *RuntimeCoordinator) ValidateLocalQualification(ctx context.Context, ownerToken string, request LocalRuntimeQualificationRequest) error {
78:	tx, e := c.service.DB.BeginTx(ctx, nil)
79:	if e != nil {
80:		return e
81:	}
82:	defer tx.Rollback()
83:	p, e := authenticate(tx, ownerToken)
84:	if e != nil {
85:		return e
86:	}
87:	_, task, e := c.localQualification(tx, p, request)
88:	if e == nil {
89:		e = c.validateLocalConfirmation(ctx, tx, p, request)
90:	}
91:	if e == nil && task["status"] != "DRAFT" {
92:		return Fail(409, "STATE_CONFLICT", "qualification request was already consumed; no automatic retry")
93:	}
94:	return e
95:}
96:
97:// ExecuteLocalQualification joins the single coordinator lifecycle. Scan does
98:// not claim qualification tasks, so a trusted explicit request must bridge
99:// Begin to RunAdmitted exactly once. Cancellation/recovery never relaunches it.
100:func (c *RuntimeCoordinator) ExecuteLocalQualification(ctx context.Context, ownerToken string, request LocalRuntimeQualificationRequest) (Object, error) {
101:	c.scanMu.Lock()
102:	unlock := true
103:	defer func() {
104:		if unlock {
105:			c.scanMu.Unlock()
106:		}
107:	}()
108:	if c.quiesced || !c.qualificationActive || c.qualificationRequest != request.RequestID {
109:		return nil, Fail(409, "RESOURCE_BLOCKED", "runtime intake is fenced")
110:	}
111:	if !c.startupComplete {
112:		if e := c.Recover(ctx); e != nil {
113:			return nil, e
114:		}
115:		c.startupComplete = true
116:	}
117:	tx, e := c.service.DB.BeginTx(ctx, nil)
118:	if e != nil {
119:		return nil, e
120:	}
121:	p, e := authenticate(tx, ownerToken)
122:	if e != nil {
123:		tx.Rollback()
124:		return nil, e
125:	}
126:	_, task, e := c.localQualification(tx, p, request)
127:	if e != nil {
128:		tx.Rollback()
129:		return nil, e
130:	}
131:	if task["status"] != "DRAFT" {
132:		tx.Rollback()
133:		return nil, Fail(409, "STATE_CONFLICT", "qualification already consumed; no automatic retry")
134:	}
135:	var route RuntimeCoordinatorRoute
136:	for _, current := range c.runtimeRoutes() {
137:		if current.ProjectID == request.ProjectID && current.RuntimeID == request.RuntimeID {
138:			if route.RuntimeID != "" {
139:				tx.Rollback()
140:				return nil, errors.New("ambiguous qualification route")
141:			}
142:			route = current
143:		}
144:	}
145:	if route.RuntimeID == "" {
146:		tx.Rollback()
147:		return nil, Fail(503, "MODEL_UNAVAILABLE", "prepared route unavailable")
148:	}
149:	var active int
150:	e = tx.QueryRow(`SELECT count(*) FROM domain_objects WHERE project=? AND kind='Run' AND json_extract(body,'$.executor_principal_id')=? AND json_extract(body,'$.status') NOT IN ('SETTLED','FAILED','CANCELLED')`, route.ProjectID, route.ExecutorID).Scan(&active)
151:	tx.Rollback()
152:	if e != nil {
153:		return nil, e
154:	}
155:	key := route.ProjectID + "/" + route.ExecutorID
156:	c.mu.Lock()
157:	busy := c.active[key]
158:	c.mu.Unlock()
159:	if active != 0 || busy {
160:		return nil, Fail(409, "STATE_CONFLICT", "executor has outstanding work; qualification not started")
161:	}
162:	if e = c.authority(ctx, route); e != nil {
163:		return nil, e
164:	}
165:	run, lease, e := c.beginManagedLocalQualification(ctx, ownerToken, request, route.ExecutorID)
166:	if e != nil {
167:		return nil, e
168:	}
169:	c.mu.Lock()
170:	c.active[key] = true
171:	c.mu.Unlock()
172:	c.workers.Add(1)
173:	c.scanMu.Unlock()
174:	unlock = false
175:	defer c.workers.Done()
176:	defer func() { c.mu.Lock(); delete(c.active, key); c.mu.Unlock() }()
177:	return run, c.RunAdmitted(ctx, route, run, lease)
178:}
179:
180:func (c *RuntimeCoordinator) beginManagedLocalQualification(ctx context.Context, token string, request LocalRuntimeQualificationRequest, executor string) (Object, string, error) {
181:	s := c.service
182:	if e := s.Contracts.Validate("Id", request.RequestID); e != nil {
183:		return nil, "", e
184:	}
185:	tx, e := s.DB.BeginTx(ctx, nil)
186:	if e != nil {
187:		return nil, "", e
188:	}
189:	defer tx.Rollback()
190:	p, e := resourcePrincipal(tx, token, request.ProjectID, "OWNER")
