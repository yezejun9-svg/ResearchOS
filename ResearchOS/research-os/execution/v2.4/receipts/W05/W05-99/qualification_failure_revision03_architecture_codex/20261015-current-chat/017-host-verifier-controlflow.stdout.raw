154:// QualifyLocalRuntime performs an explicitly requested managed operation. The
155:// coordinator remains the sole launcher; this administrative host has no model
156:// client. Separate verifier credentials never enter the coordinator or worker.
157:func (h *Host) QualifyLocalRuntime(ctx context.Context, service *domain.Service, coordinator *domain.RuntimeCoordinator, apiURL string, request domain.LocalRuntimeQualificationRequest, install RuntimeVerifierInstallation) (domain.Object, error) {
158:	if e := coordinator.BeginLocalQualificationWindow(ctx, request.RequestID); e != nil {
159:		return nil, e
160:	}
161:	defer coordinator.EndLocalQualificationWindow(context.Background())
162:	if _, e := h.reverify(); e != nil {
163:		return nil, e
164:	}
165:	owner := h.boundPrincipal()
166:	if owner == "" {
167:		return nil, errors.New("managed qualification requires existing OS-bound Owner")
168:	}
169:	if _, e := h.ConfigurationMetadata(ctx, owner, "", nil); e != nil {
170:		return nil, e
171:	}
172:	ownerToken, e := service.IssueCredential(ctx, owner, 5*time.Minute)
173:	if e != nil {
174:		return nil, e
175:	}
176:	defer h.revokeCredentialByHash(context.Background(), owner, domain.Digest([]byte(ownerToken)))
177:	if e = coordinator.ValidateLocalQualification(ctx, ownerToken, request); e != nil {
178:		return nil, e
179:	}
180:	process, e := startRuntimeVerifier(ctx, install)
181:	if e != nil {
182:		return nil, e
183:	}
184:	defer process.close()
185:	root, principal, e := h.ensureRuntimeVerifier(ctx, owner, request.ProjectID, install)
186:	if e != nil {
187:		return nil, e
188:	}
189:	provenance := domain.Object{"schema": "researchos.local-runtime-administration.v1", "action": "EXPLICIT_QUALIFICATION_REQUEST", "request": request, "request_hash": domain.Hash(request), "installation": install, "installation_hash": domain.Hash(install), "service_root": root, "verifier_principal": principal, "process_identity": process.identity, "handshake_nonce": process.nonce, "owner": owner, "owner_host": h.InstanceID(), "os_principal_ref": h.identity.Ref, "application_separation": true, "protected_holdout": false}
190:	proof, e := service.RecordLocalRuntimeAdministration(ctx, ownerToken, request.ProjectID, provenance)
191:	if e != nil {
192:		return nil, e
193:	}
194:	run, e := coordinator.ExecuteLocalQualification(ctx, ownerToken, request)
195:	if e != nil {
196:		return domain.Object{"administration_ref": domain.Ref(proof, "Artifact"), "run": run, "state": "QUALIFICATION_NOT_ACCEPTED"}, e
197:	}
198:	review, e := service.LocalQualificationReview(ctx, ownerToken, request, domain.Str(run, "id"))
199:	if e != nil {
200:		return nil, e
201:	}
202:	// Issue only after execution is settled. The child process is still the same
203:	// verified PID/image/creation identity; it alone receives the short token.
204:	token, e := service.IssueCredential(ctx, principal, 2*time.Minute)
205:	if e != nil {
206:		return nil, e
207:	}
208:	defer h.revokeCredentialByHash(context.Background(), principal, domain.Digest([]byte(token)))
209:	epoch, _ := domain.Num(review, "epoch")
210:	job := verifier.Job{APIURL: apiURL, Token: token, PrincipalID: principal, ServiceRoot: root, ProjectID: request.ProjectID, RuntimeID: request.RuntimeID, TaskRef: review["task_ref"].(map[string]any), RunRef: review["run_ref"].(map[string]any), ProfileRef: review["profile_ref"].(map[string]any), ObservationRef: review["observation_ref"].(map[string]any), PlanHash: domain.Str(review, "plan_hash"), ExecutorID: domain.Str(review, "executor_id"), Epoch: epoch}
211:	job.VerificationSnapshot = review["verification_snapshot"].(map[string]any)
212:	job.VerificationSnapshotHash = domain.Str(review, "verification_snapshot_hash")
213:	result, e := process.verify(ctx, job)
214:	job.Token = ""
215:	if e != nil {
216:		return domain.Object{"state": "QUALIFICATION_NOT_ACCEPTED", "check_status": review["diagnostic_status"], "check_reason": review["diagnostic_reason"], "administration_ref": domain.Ref(proof, "Artifact")}, e
217:	}
218:	if domain.Str(result.RuntimeRef, "id") != request.RuntimeID {
219:		return nil, errors.New("verified runtime differs from Owner request")
220:	}
221:	// This re-enters the unchanged admission checks, including actual accepted
222:	// receipt/root/profile evidence. A child stdout claim cannot authorize use.
223:	expires := time.Now().UTC().Add(time.Duration(request.PurposeSeconds) * time.Second)
224:	if e = service.AuthorizeRuntimePurpose(ctx, ownerToken, request.ProjectID, request.RuntimeID, "mu_turn", expires); e != nil {
225:		return nil, e
226:	}
227:	completed := domain.Object{"schema": "researchos.local-runtime-administration.v1", "action": "VERIFIED_PURPOSE_AUTHORIZATION", "request_hash": domain.Hash(request), "administration_ref": domain.Ref(proof, "Artifact"), "verifier_process": process.identity, "service_root": root, "verifier_principal": principal, "acceptance_ref": result.AcceptanceRef, "runtime_ref": result.RuntimeRef, "observation_ref": result.ObservationRef, "purpose": "mu_turn", "expires_at": expires.Format(time.RFC3339Nano), "application_separation": true, "protected_holdout": false}
228:	final, e := service.RecordLocalRuntimeAdministration(ctx, ownerToken, request.ProjectID, completed)
229:	if e != nil {
230:		return nil, e
231:	}
232:	return domain.Object{"state": "QUALIFIED_PURPOSE_AUTHORIZED", "runtime_ref": result.RuntimeRef, "acceptance_ref": result.AcceptanceRef, "administration_ref": domain.Ref(final, "Artifact"), "purpose": "mu_turn", "protected_holdout": false}, nil
233:}
