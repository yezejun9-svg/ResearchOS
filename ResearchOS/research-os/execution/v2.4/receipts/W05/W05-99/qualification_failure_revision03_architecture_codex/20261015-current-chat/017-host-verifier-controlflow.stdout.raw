25:type RuntimeVerifierInstallation struct {
26:	Schema         string   `json:"schema"`
27:	ServiceID      string   `json:"service_id"`
28:	Protocol       string   `json:"protocol"`
29:	Executable     string   `json:"executable"`
30:	ExecutableHash string   `json:"executable_hash"`
31:	SourceCommit   string   `json:"source_commit"`
32:	Arguments      []string `json:"arguments"`
33:}
34:
35:// LoadRuntimeVerifierInstallation reads a local administrator's bounded install
36:// manifest. SourceCommit is declared build provenance, not proof of OS isolation.
37:// The actual executable bytes, PID and creation time are verified again at start.
38:func LoadRuntimeVerifierInstallation(path string) (RuntimeVerifierInstallation, error) {
39:	var install RuntimeVerifierInstallation
40:	raw, e := readRuntimeManagedFile(path, 64<<10)
41:	if e != nil {
42:		return install, e
43:	}
44:	if e = decodeRuntimeManaged(raw, &install); e != nil {
45:		return install, e
46:	}
47:	if install.Schema != "researchos.runtime-verifier-installation.v1" || install.ServiceID != verifier.ServiceID || install.Protocol != verifier.Protocol || len(install.Arguments) != 0 || len(install.SourceCommit) != 40 {
48:		return install, errors.New("fixed runtime verifier installation required")
49:	}
50:	if _, e = hex.DecodeString(install.SourceCommit); e != nil {
51:		return install, errors.New("verifier build commit invalid")
52:	}
53:	if e = verifyRuntimeVerifierImage(install); e != nil {
54:		return install, e
55:	}
56:	return install, nil
57:}
58:func verifyRuntimeVerifierImage(install RuntimeVerifierInstallation) error {
59:	// Direct trusted Go callers have the same installation contract as the
60:	// managed startup manifest loader.
61:	if install.Schema != "researchos.runtime-verifier-installation.v1" || install.ServiceID != verifier.ServiceID || install.Protocol != verifier.Protocol || len(install.Arguments) != 0 || len(install.SourceCommit) != 40 {
62:		return errors.New("fixed runtime verifier installation required")
63:	}
64:	if _, e := hex.DecodeString(install.SourceCommit); e != nil {
65:		return errors.New("verifier build commit invalid")
66:	}
67:	raw, e := readRuntimeManagedFile(install.Executable, 128<<20)
68:	if e != nil || domain.Digest(raw) != install.ExecutableHash || len(raw) < 2 || string(raw[:2]) != "MZ" || !strings.EqualFold(filepath.Ext(install.Executable), ".exe") {
69:		return errors.New("installed verifier executable bytes unavailable or changed")
70:	}
71:	return nil
72:}
73:func readRuntimeManagedFile(path string, limit int64) ([]byte, error) {
74:	if !filepath.IsAbs(path) {
75:		return nil, errors.New("absolute managed resource path required")
76:	}
77:	resolved, e := filepath.EvalSymlinks(path)
78:	if e != nil || !strings.EqualFold(filepath.Clean(resolved), filepath.Clean(path)) {
79:		return nil, errors.New("managed resource path unavailable or redirected")
80:	}
81:	info, e := os.Lstat(path)
82:	if e != nil || !info.Mode().IsRegular() || info.Size() < 1 || info.Size() > limit {
83:		return nil, errors.New("bounded regular managed resource required")
84:	}
85:	return os.ReadFile(path)
86:}
87:func decodeRuntimeManaged(raw []byte, target any) error {
88:	strict, e := canonical.JSON(raw)
89:	if e != nil {
90:		return errors.New("managed runtime JSON must have unique keys and valid encoding")
91:	}
92:	d := json.NewDecoder(strings.NewReader(string(strict)))
93:	d.DisallowUnknownFields()
94:	if d.Decode(target) != nil {
95:		return errors.New("managed runtime request invalid")
96:	}
97:	var extra any
98:	if d.Decode(&extra) != io.EOF {
99:		return errors.New("managed runtime request has trailing data")
100:	}
101:	return nil
102:}
103:
104:type runtimeVerifierProcess struct {
105:	cmd      *exec.Cmd
106:	in       io.WriteCloser
107:	out      io.ReadCloser
108:	cancel   context.CancelFunc
109:	identity supervisor.ProcessIdentity
110:	nonce    string
111:	waited   bool
112:}
113:
114:func startRuntimeVerifier(ctx context.Context, install RuntimeVerifierInstallation) (*runtimeVerifierProcess, error) {
115:	if e := verifyRuntimeVerifierImage(install); e != nil {
116:		return nil, e
117:	}
118:	deadline, cancel := context.WithTimeout(ctx, 3*time.Minute)
119:	p := &runtimeVerifierProcess{cancel: cancel}
120:	p.cmd = exec.CommandContext(deadline, install.Executable)
121:	p.cmd.Dir = filepath.Dir(install.Executable)
122:	p.cmd.Env = []string{}
123:	for _, name := range []string{"SystemRoot", "WINDIR", "TEMP", "TMP"} {
124:		if value := os.Getenv(name); value != "" {
125:			p.cmd.Env = append(p.cmd.Env, name+"="+value)
126:		}
127:	}
128:	p.cmd.SysProcAttr = &syscall.SysProcAttr{HideWindow: true}
129:	// These are dedicated inherited anonymous pipes. No token is placed in argv,
130:	// environment, a file, logs, worker configuration or the scheduler object.
131:	var e error
132:	if p.in, e = p.cmd.StdinPipe(); e != nil {
133:		cancel()
134:		return nil, e
135:	}
136:	if p.out, e = p.cmd.StdoutPipe(); e != nil {
137:		p.in.Close()
138:		cancel()
139:		return nil, e
140:	}
141:	p.cmd.Stderr = io.Discard
142:	if e = p.cmd.Start(); e != nil {
143:		p.in.Close()
144:		p.out.Close()
145:		cancel()
146:		return nil, errors.New("installed verifier process could not start")
147:	}
148:	ok := false
149:	defer func() {
150:		if !ok {
151:			p.close()
152:		}
153:	}()
154:	p.identity, e = supervisor.ObserveProcess(uint32(p.cmd.Process.Pid))
155:	if e != nil || "sha256:"+p.identity.ImageSHA256 != install.ExecutableHash {
156:		return nil, errors.New("verifier process does not match installed image")
157:	}
158:	var nonce [32]byte
159:	if _, e = rand.Read(nonce[:]); e != nil {
160:		return nil, e
161:	}
162:	p.nonce = hex.EncodeToString(nonce[:])
163:	if e = verifier.WriteFrame(p.in, verifier.Challenge{Protocol: verifier.Protocol, Nonce: p.nonce}); e != nil {
164:		return nil, errors.New("verifier handshake write failed")
165:	}
166:	var hello verifier.Hello
167:	if e = p.read(deadline, &hello); e != nil {
168:		return nil, e
169:	}
170:	if hello.Protocol != verifier.Protocol || hello.ServiceID != verifier.ServiceID || hello.Nonce != p.nonce || hello.PID != p.cmd.Process.Pid {
171:		return nil, errors.New("verifier process handshake identity differs")
172:	}
173:	ok = true
174:	return p, nil
175:}
176:func (p *runtimeVerifierProcess) read(ctx context.Context, target any) error {
177:	done := make(chan error, 1)
178:	go func() { done <- verifier.ReadFrame(p.out, target) }()
179:	timer := time.NewTimer(20 * time.Second)
180:	defer timer.Stop()
181:	select {
182:	case e := <-done:
183:		return e
184:	case <-ctx.Done():
185:		p.cancel()
186:		return errors.New("verifier process cancelled")
187:	case <-timer.C:
188:		p.cancel()
189:		return errors.New("verifier reply deadline exceeded")
190:	}
191:}
192:func (p *runtimeVerifierProcess) verify(ctx context.Context, job verifier.Job) (verifier.Result, error) {
193:	var result verifier.Result
194:	observed, e := supervisor.ObserveProcess(uint32(p.cmd.Process.Pid))
195:	if e != nil || observed != p.identity {
196:		return result, errors.New("verifier process identity changed before credential transfer")
197:	}
198:	job.Protocol, job.Nonce = verifier.Protocol, p.nonce
199:	if e = verifier.WriteFrame(p.in, job); e != nil {
200:		return result, errors.New("private verifier job transfer failed")
201:	}
202:	job.Token = ""
203:	_ = p.in.Close()
204:	if e = p.read(ctx, &result); e != nil {
205:		return result, e
206:	}
207:	e = p.cmd.Wait()
208:	p.waited = true
209:	if e != nil || result.Protocol != verifier.Protocol || result.Nonce != p.nonce || result.Status != "QUALIFIED" || result.ErrorCode != "" {
210:		for _, code := range []string{"TASK_RUN_BINDING", "PROFILE_EVIDENCE", "NATIVE_OBSERVATION", "OUTPUT_EVIDENCE", "FROZEN_CHECKS", "DETERMINISTIC_CHECK", "SERVER_ACCEPTANCE", "SERVER_QUALIFICATION"} {
211:			if result.ErrorCode == code {
212:				return result, errors.New("independent verifier rejected stage " + code)
213:			}
214:		}
215:		return result, errors.New("independent verifier did not qualify the runtime")
216:	}
217:	return result, nil
218:}
219:func (p *runtimeVerifierProcess) close() {
220:	p.cancel()
221:	_ = p.in.Close()
222:	_ = p.out.Close()
223:	if !p.waited {
224:		_ = p.cmd.Wait()
225:		p.waited = true
226:	}
227:}
