12:
13:// LocalRuntimeQualificationRequest is a trusted managed-host request, never a
14:// new public client method. Every field is frozen before any model dispatch.
15:type LocalRuntimeQualificationRequest struct {
16:	RequestID         string `json:"request_id"`
17:	ProjectID         string `json:"project_id"`
18:	SessionID         string `json:"session_id"`
19:	ModelRef          string `json:"model_config_ref"`
20:	RuntimeID         string `json:"runtime_id"`
21:	TaskID            string `json:"task_id"`
22:	PlanHash          string `json:"plan_hash"`
23:	ProfileHash       string `json:"profile_hash"`
24:	AuthorizePurpose  string `json:"authorize_purpose"`
25:	PurposeSeconds    int    `json:"purpose_seconds"`
26:	OwnerHost         string `json:"owner_host"`
27:	OwnerPrincipal    string `json:"owner_principal"`
28:	OwnerRoot         string `json:"owner_root"`
29:	SessionHash       string `json:"session_hash"`
30:	ConfigurationHash string `json:"configuration_hash"`
31:	IssuedAt          string `json:"issued_at"`
32:	ExpiresAt         string `json:"expires_at"`
33:}
