180: func (c *RuntimeCoordinator) beginManagedLocalQualification(ctx context.Context, token string, request LocalRuntimeQualificationRequest, executor string) (Object, string, error) {
181: 	s := c.service
182: 	if e := s.Contracts.Validate("Id", request.RequestID); e != nil {
183: 		return nil, "", e
184: 	}
185: 	tx, e := s.DB.BeginTx(ctx, nil)
186: 	if e != nil {
187: 		return nil, "", e
188: 	}
189: 	defer tx.Rollback()
190: 	p, e := resourcePrincipal(tx, token, request.ProjectID, "OWNER")
191: 	if e != nil {
192: 		return nil, "", e
193: 	}
194: 	if _, _, e = c.localQualification(tx, p, request); e != nil {
195: 		return nil, "", e
196: 	}
197: 	if e = c.validateLocalConfirmation(ctx, tx, p, request); e != nil {
198: 		return nil, "", e
199: 	}
200: 	if e = localQualificationIdle(tx); e != nil {
201: 		return nil, "", e
202: 	}
203: 	var prior string
204: 	e = tx.QueryRow(`SELECT request_hash FROM idempotency WHERE principal=? AND project=? AND operation='host:managed-runtime-qualification' AND key=?`, p.ID, request.ProjectID, request.RequestID).Scan(&prior)
205: 	if e == nil {
206: 		return nil, "", Fail(409, "STATE_CONFLICT", "managed qualification request already consumed; no automatic replay")
207: 	}
208: 	if e != sql.ErrNoRows {
209: 		return nil, "", e
210: 	}
211: 	// These are the same Owner, frozen plan, budget and claim gates used by the
212: 	// public trusted Go BeginRuntimeQualification wrapper, in the same transaction
213: 	// as the non-secret request-consumption receipt. No lease enters the receipt.
214: 	run, lease, e := s.beginRuntimeQualification(tx, p, request.ProjectID, request.TaskID, request.RuntimeID, executor)
215: 	if e != nil {
216: 		return nil, "", e
217: 	}
218: 	// Recheck the wall-clock deadline after all claim gates; an expired claim is
219: 	// rolled back together with consumption, even if earlier checks were slow.
220: 	if e = validateLocalConfirmationTime(request); e != nil {
221: 		return nil, "", e
222: 	}
223: 	_, e = tx.Exec(`INSERT INTO idempotency(principal,project,operation,key,request_hash,status,body,headers,created_at) VALUES(?,?,'host:managed-runtime-qualification',?,?,201,?,'{}',?)`, p.ID, request.ProjectID, request.RequestID, Hash(request), Bytes(Object{"request_hash": Hash(request), "run_ref": Ref(run, "Run"), "task_id": request.TaskID, "runtime_id": request.RuntimeID}), Now())
224: 	if e != nil {
225: 		return nil, "", e
226: 	}
227: 	return run, lease, tx.Commit()
228: }
