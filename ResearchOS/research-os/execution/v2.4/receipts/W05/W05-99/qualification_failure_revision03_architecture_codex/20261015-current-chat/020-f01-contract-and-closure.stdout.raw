328: // LocalQualificationReview locates the exact observed LOG and current frozen
329: // references. The separate verifier must re-read them through its own API grant.
330: func (s *Service) LocalQualificationReview(ctx context.Context, token string, request LocalRuntimeQualificationRequest, runID string) (Object, error) {
