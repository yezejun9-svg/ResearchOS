286: // RecordLocalRuntimeAdministration seals provenance of a trusted local action;
287: // this is not an AcceptanceReceipt and confers no availability.
288: func (s *Service) RecordLocalRuntimeAdministration(ctx context.Context, token, project string, evidence Object) (Object, error) {
289: 	tx, e := s.DB.BeginTx(ctx, nil)
290: 	if e != nil {
291: 		return nil, e
292: 	}
293: 	defer tx.Rollback()
294: 	p, e := resourcePrincipal(tx, token, project, "OWNER")
295: 	if e != nil {
296: 		return nil, e
297: 	}
298: 	if evidence["schema"] != "researchos.local-runtime-administration.v1" {
299: 		return nil, Fail(422, "GATE_FAILED", "local administration evidence schema required")
300: 	}
301: 	if evidence["action"] == "EXPLICIT_QUALIFICATION_REQUEST" {
302: 		child, root := Str(evidence, "verifier_principal"), Str(evidence, "service_root")
303: 		actual, e := currentAuthorityRoot(tx, child)
304: 		ownerRoot, ownerErr := currentAuthorityRoot(tx, p.ID)
305: 		var parent string
306: 		if e != nil || ownerErr != nil || actual != root || root == ownerRoot || root == child || !runtimeRoleAndGrant(tx, child, project, "VERIFIER") || tx.QueryRow(`SELECT parent FROM orchestration_identity WHERE principal=?`, child).Scan(&parent) != nil || parent != root {
307: 			return nil, Fail(403, "FORBIDDEN", "explicit active independent verifier lineage required")
308: 		}
309: 		anchor := Object{"schema": "researchos.managed-verifier-lineage.v1", "principal": child, "root": root, "project_id": project, "registered_by": p.ID}
310: 		var prior string
311: 		e = tx.QueryRow(`SELECT request_hash FROM idempotency WHERE principal=? AND project=? AND operation='host:managed-verifier-lineage' AND key=?`, child, project, child).Scan(&prior)
312: 		if e == sql.ErrNoRows {
313: 			_, e = tx.Exec(`INSERT INTO idempotency(principal,project,operation,key,request_hash,status,body,headers,created_at) VALUES(?,?,'host:managed-verifier-lineage',?,?,200,?,'{}',?)`, child, project, child, Hash(anchor), Bytes(anchor), Now())
314: 		} else if e == nil && prior != Hash(anchor) {
315: 			e = Fail(403, "FORBIDDEN", "managed verifier original lineage changed")
316: 		}
317: 		if e != nil {
318: 			return nil, e
319: 		}
320: 	}
321: 	a, e := s.serverArtifactMode(tx, project, p.ID, "MANIFEST", "LIVE", Bytes(evidence), Empty())
322: 	if e != nil {
323: 		return nil, e
324: 	}
325: 	return a, tx.Commit()
326: }
