1: //go:build windows
2: 
3: package sandbox
4: 
5: import (
6: 	"bytes"
7: 	"context"
8: 	"errors"
9: 	"io"
10: 	"os"
11: 	"sync"
12: 	"time"
13: )
14: 
15: const MaxStreamBytes = 4 * 1024 * 1024
16: 
17: // Identity is collected by the host while the process is still suspended.
18: // BeforeResume must durably bind it to the admitted dispatch before returning.
19: type Identity struct {
20: 	PID              uint32 `json:"pid"`
21: 	Created          int64  `json:"process_created_ns,string"`
22: 	Job              string `json:"job"`
23: 	SID              string `json:"appcontainer_sid"`
24: 	Profile          string `json:"profile"`
25: 	StagingDirectory string `json:"staging_directory"`
26: }
27: 
28: type StreamChunk struct {
29: 	Stream string `json:"stream"`
30: 	Offset int64  `json:"offset"`
31: 	Data   []byte `json:"data"`
32: }
33: 
34: type StartOptions struct {
35: 	BeforeResume func(Identity) error
36: 	// OnStream must consume bounded chunks promptly. An error stops the Job;
37: 	// the final receipt never treats a lost or truncated stream as drained.
38: 	OnStream    func(StreamChunk) error
39: 	Interactive bool
40: 	// AllowCodingTurnTimeout is reserved for the trusted Mu coding bridge.
41: 	// It raises only the per-process upper bound from 5 to 15 minutes;
42: 	// Run and ordinary Start calls retain the 5-minute default.
43: 	AllowCodingTurnTimeout bool
44: }
45: 
46: type Process struct {
47: 	mu        sync.Mutex
48: 	writeGate chan struct{}
49: 	stopped   <-chan struct{}
50: 	stdin     *os.File
51: 	cancel    context.CancelFunc
52: 	done      chan struct{}
53: 	ready     chan error
54: 	receipt   Receipt
55: 	err       error
56: }
57: 
58: // Start returns after suspended identity persistence and ResumeThread succeed.
59: // It owns process termination, stream draining and staging cleanup until Wait.
60: func Start(ctx context.Context, c Command, options StartOptions) (*Process, error) {
61: 	child, cancel := context.WithCancel(ctx)
62: 	p := &Process{cancel: cancel, done: make(chan struct{}), ready: make(chan error, 1), writeGate: make(chan struct{}, 1), stopped: child.Done()}
63: 	go func() {
64: 		r, err := runSandbox(child, c, options, p)
65: 		p.mu.Lock()
66: 		p.receipt, p.err = r, err
67: 		if p.stdin != nil {
68: 			p.stdin.Close()
69: 			p.stdin = nil
70: 		}
71: 		p.mu.Unlock()
72: 		select {
73: 		case p.ready <- err:
74: 		default:
75: 		}
76: 		cancel()
77: 		close(p.done)
78: 	}()
79: 	select {
80: 	case err := <-p.ready:
81: 		if err != nil {
82: 			<-p.done
83: 			return nil, err
84: 		}
85: 		return p, nil
86: 	case <-ctx.Done():
87: 		cancel()
88: 		// The caller receives no Process handle on startup failure. Keep this
89: 		// boundary until termination, stream closure and staging cleanup finish.
90: 		<-p.done
91: 		return nil, ctx.Err()
92: 	}
93: }
94: 
95: func (p *Process) Write(ctx context.Context, frame []byte) error {
96: 	if len(frame) == 0 || len(frame) > 64*1024 {
97: 		return errors.New("bounded protocol frame required")
98: 	}
99: 	bounded, cancel := context.WithTimeout(ctx, 5*time.Second)
100: 	defer cancel()
101: 	if err := bounded.Err(); err != nil {
102: 		return err
103: 	}
104: 	select {
105: 	case p.writeGate <- struct{}{}:
106: 	case <-bounded.Done():
107: 		return bounded.Err()
108: 	case <-p.stopped:
109: 		return errors.New("process input closed")
110: 	case <-p.done:
111: 		return errors.New("process completed")
112: 	}
113: 	defer func() { <-p.writeGate }()
114: 	if err := bounded.Err(); err != nil {
115: 		return err
116: 	}
117: 	select {
118: 	case <-p.stopped:
119: 		return errors.New("process input closed")
120: 	default:
121: 	}
122: 	frame = append([]byte(nil), frame...)
123: 	p.mu.Lock()
124: 	f := p.stdin
125: 	p.mu.Unlock()
126: 	if f == nil {
127: 		return errors.New("process input closed")
128: 	}
129: 	// Windows anonymous pipes are synchronous and reject SetWriteDeadline.
130: 	// On timeout cancel the Job, which closes the child's read handle and
131: 	// releases this one pending write; never continue the protocol afterwards.
132: 	done := make(chan error, 1)
133: 	go func() {
134: 		n, err := f.Write(frame)
135: 		if err == nil && n != len(frame) {
136: 			err = io.ErrShortWrite
137: 		}
138: 		done <- err
139: 	}()
140: 	select {
141: 	case err := <-done:
142: 		return err
143: 	case <-bounded.Done():
144: 		p.cancel()
145: 		return bounded.Err()
146: 	case <-p.stopped:
147: 		return errors.New("process input closed")
148: 	}
149: }
150: 
151: func (p *Process) CloseInput() error {
152: 	p.mu.Lock()
153: 	defer p.mu.Unlock()
154: 	if p.stdin == nil {
155: 		return nil
156: 	}
157: 	err := p.stdin.Close()
158: 	p.stdin = nil
159: 	return err
160: }
161: 
162: func (p *Process) Cancel() { p.cancel(); p.CloseInput() }
163: 
164: func (p *Process) Wait(ctx context.Context) (Receipt, error) {
165: 	select {
166: 	case <-p.done:
167: 		p.mu.Lock()
168: 		defer p.mu.Unlock()
169: 		return p.receipt, p.err
170: 	case <-ctx.Done():
171: 		return Receipt{}, ctx.Err()
172: 	}
173: }
174: 
175: type streamResult struct {
176: 	bytes []byte
177: 	err   error
178: }
179: 
180: func collectStream(reader *os.File, name string, callback func(StreamChunk) error, cancel context.CancelFunc, result chan<- streamResult) {
181: 	defer reader.Close()
182: 	var captured bytes.Buffer
183: 	buffer := make([]byte, 16*1024)
184: 	for {
185: 		n, err := reader.Read(buffer)
186: 		if n > 0 {
187: 			if captured.Len()+n > MaxStreamBytes {
188: 				cancel()
189: 				result <- streamResult{captured.Bytes(), errors.New(name + " stream limit exceeded")}
190: 				return
191: 			}
192: 			offset := captured.Len()
193: 			captured.Write(buffer[:n])
194: 			if callback != nil {
195: 				if e := callback(StreamChunk{Stream: name, Offset: int64(offset), Data: append([]byte(nil), buffer[:n]...)}); e != nil {
196: 					cancel()
197: 					result <- streamResult{captured.Bytes(), e}
198: 					return
199: 				}
200: 			}
201: 		}
202: 		if err != nil {
203: 			capturedBytes := captured.Bytes()
204: 			if errors.Is(err, io.EOF) {
205: 				err = nil
206: 				if capturedBytes == nil {
207: 					capturedBytes = []byte{}
208: 				}
209: 			} else {
210: 				cancel()
211: 			}
212: 			result <- streamResult{capturedBytes, err}
213: 			return
214: 		}
215: 	}
216: }
