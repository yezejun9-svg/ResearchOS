230: // PreparedLocalQualification is for the privileged managed producer. It emits
231: // the current immutable identifiers and a short-lived private confirmation
232: // record without starting work or granting authority.
233: func (c *RuntimeCoordinator) PreparedLocalQualification(ctx context.Context, ownerToken string, candidate RuntimeSetupCandidate, seconds int) (LocalRuntimeQualificationRequest, error) {
234: 	var request LocalRuntimeQualificationRequest
235: 	tx, e := c.service.DB.BeginTx(ctx, nil)
236: 	if e != nil {
237: 		return request, e
238: 	}
239: 	defer tx.Rollback()
240: 	p, e := authenticate(tx, ownerToken)
241: 	if e != nil {
242: 		return request, e
243: 	}
244: 	record, e := c.service.runtimeSetupConfiguration(ctx, tx, p, candidate, c.config.ClientSchema, c.config.ConfigurationAuthority)
245: 	if e != nil {
246: 		return request, e
247: 	}
248: 	runtime, _, e := c.sessionModel(tx, candidate.ProjectID, candidate.ModelRef)
249: 	if e != nil {
250: 		return request, e
251: 	}
252: 	var taskID string
253: 	if e = tx.QueryRow(`SELECT task FROM runtime_qualification_plans WHERE project=? AND runtime=?`, candidate.ProjectID, runtime["id"]).Scan(&taskID); e != nil {
254: 		return request, e
255: 	}
256: 	plan, hash, _, e := qualificationPlan(tx, candidate.ProjectID, taskID, Str(runtime, "id"))
257: 	if e != nil {
258: 		return request, e
259: 	}
260: 	request = LocalRuntimeQualificationRequest{RequestID: ID(), ProjectID: candidate.ProjectID, SessionID: candidate.SessionID, ModelRef: candidate.ModelRef, RuntimeID: Str(runtime, "id"), TaskID: taskID, PlanHash: hash, ProfileHash: Hash(plan["profile_ref"]), AuthorizePurpose: "mu_turn", PurposeSeconds: seconds}
261: 	request.OwnerHost, request.OwnerPrincipal, request.ConfigurationHash = record.Owner, p.ID, record.ConfigHash
262: 	request.OwnerRoot, e = currentAuthorityRoot(tx, p.ID)
263: 	if e != nil {
264: 		return request, e
265: 	}
266: 	request.SessionHash, e = localConfirmationSessionHash(ctx, tx, request)
267: 	if e != nil {
268: 		return request, e
269: 	}
270: 	issued := time.Now().UTC()
271: 	request.IssuedAt, request.ExpiresAt = issued.Format(time.RFC3339Nano), issued.Add(time.Minute).Format(time.RFC3339Nano)
272: 	_, task, e := c.localQualification(tx, p, request)
273: 	if e != nil {
274: 		return request, e
275: 	}
276: 	if task["status"] != "DRAFT" {
277: 		return request, Fail(409, "STATE_CONFLICT", "qualification already consumed; no automatic retry")
278: 	}
279: 	_, e = tx.Exec(`INSERT INTO idempotency(principal,project,operation,key,request_hash,status,body,headers,created_at) VALUES(?,?,'host:qualification-confirmation',?,?,200,?,'{}',?)`, p.ID, request.ProjectID, request.RequestID, Hash(request), Bytes(request), Now())
280: 	if e != nil {
281: 		return request, e
282: 	}
283: 	return request, tx.Commit()
284: }
