INPUT execution/v2.4/receipts/W05/W05-99/qualification_failure_revision02_independent_review_codex/20261015-current-chat/C-minimal-addendum.json
{
  "status": "REQUIRED_BEFORE_C_SOURCE_CARD",
  "reason": "Concrete nested lease handoff and uncovered official release_host entry",
  "existing_paths_add": [
    "internal/domain/backup_upgrade.go",
    "internal/domain/backup_prepared_abandonment_upgrade.go",
    "internal/domain/backup_prepared_abandonment_handoff.go",
    "internal/domain/backup_prepared_abandonment_upgrade_other.go",
    "ops/supervisor/release_host/main.go"
  ],
  "already_allowed_paths_reused": [
    "ops/backup/main.go",
    "ops/backup/maintenance_gate_windows.go",
    "ops/backup/maintenance_gate_other.go",
    "internal/domain/backup_prepared_abandonment_upgrade_windows.go",
    "adapters/runtime/data_root_windows.go",
    "internal/host/maintenance_startup_gate_windows.go"
  ],
  "new_paths_add": [
    "internal/domain/backup_source_lease_windows.go",
    "internal/domain/backup_source_lease_other.go",
    "ops/supervisor/release_host/maintenance_gate_windows.go",
    "ops/supervisor/release_host/maintenance_gate_other.go"
  ],
  "test_paths_add": [
    "internal/domain/backup_source_lease_windows_test.go",
    "internal/domain/backup_prepared_abandonment_handoff_test.go",
    "internal/domain/backup_prepared_abandonment_upgrade_windows_test.go",
    "ops/supervisor/release_host/maintenance_gate_windows_test.go"
  ],
  "tests_already_allowed_reused": [
    "ops/backup/maintenance_gate_windows_test.go",
    "internal/host/maintenance_startup_gate_windows_test.go",
    "adapters/runtime/qualification_maintenance_gate_windows_test.go"
  ],
  "concrete_design": [
    "Windows CLI helper canonicalizes exact source/root/file identity, acquires ONE checked DataRootLease, invokes combined qualification+replacement gate before keys, protected store, DB opening or upgrade template operations; defer closes only after full workflow return.",
    "Add narrow Windows domain entry adapters UpgradeLocalUnderSourceLease and UpgradePreparedAbandonmentBackupUnderSourceLease taking held *runtime.DataRootLease (not JSON/bool/callback). They validate native lease root and opt.Source mapping, create package-private borrowed preparedUpgradeRootLease, and delegate to existing workflows.",
    "LocalUpgradeOptions carries an unexported sourceLease capability (excluded from JSON/hash); private prepared workflows call acquirePreparedUpgradeRootLease(root,opt.sourceLease). A borrowed lease validates Held/root and never closes underlying handle; outer owner alone closes. An internally acquired lease retains original owner/Close semantics. No close/reopen or second acquisition between gate and source open.",
    "All UpgradeLocal dispatch branches (schema13, configuration, queue, prepared23) are entered under the outer held capability. Existing standalone/default package APIs may not be used as an official command bypass; their policy must fail closed or use the same guarded adapter. No free-form callback is accepted.",
    "release_host main must invoke a platform wrapper acquiring the exact root lease and combined gate BEFORE OpenCanary/store.Open; existing control-fixture launch branch must retain its own disposable-root validation. C namespace guard in LockDataRoot alone does not implement replacement history validation.",
    "Nonwindows adapters must reject unsupported maintenance capability or preserve explicit fixture-only behavior; no nil-authority success masquerading as a Windows lease.",
    "Carry the full pre-existing C allowlist unchanged plus these exact additions; freeze signatures/ownership and test inventory in addendum before source. This is a proposed minimal coherent design, not implemented code."
  ],
  "required_cuts": [
    "pending qualification BEGIN blocks each CLI before protected/key/DB access",
    "pending verifier replacement blocks each CLI under same lease",
    "borrowed correct root succeeds without native reacquisition",
    "wrong-root/closed/reused/forged capability rejects",
    "inner failure never closes borrowed outer lease",
    "outer release only after DB and workflow close",
    "all five upgrade plan branches and create/export entries",
    "release_host legacy and control fixture modes",
    "inherited recovery/migration token held before+after combined gate",
    "normal/Core/replacement/C own-recover exact exemption matrices"
  ],
  "formal_increment": 0
}

INPUT execution/v2.4/receipts/W05/W05-99/qualification_failure_revision02_independent_review_codex/20261015-current-chat/STOP-alternative-proof-prerequisites.json
{
  "strict_current_stop": "STOP_UNAVAILABLE",
  "native_closure_missing": true,
  "possible_class": "SOURCE_DERIVED_NEVER_JOB_AUTHORIZED_V1",
  "accepted": false,
  "minimal_missing_evidence": [
    "Exact actual installed verifier image digest/create identity/parent binding to immutable build receipt and compiled main_windows.go, protocol.go, client.go plus all package init effects relevant before main; no current build substitute",
    "Exact historical managed response and Run/dispatch facts bind ExecuteLocalQualification error return196, excluding later LocalQualificationReview/token/verify path; no private job/token read required",
    "Complete source call graph proves sole job writer is process.verify, no alternate stdin writer, inherited credential handle/env, DB direct-open, background init side effect or alternate token mint/transfer path",
    "Authority distinction: ensureRuntimeVerifier creates principal/grants before run but principal declaration alone is not possession of bearer; show old verifier job never obtained any existing credential",
    "Independent acceptance of a new operational invariant that a possibly alive, never-job-authorized, pipe-closed exact verifier is safe for this specific stop; do not call it exited, stopped, waited or numerically successful",
    "If adopted, freeze separate STOP architecture/source allowlist/tests and an exact approved operation; existing mandatory all-native-closure contract remains unchanged until then"
  ],
  "source_derived_close_limit": "Calling and returning from ignored Cmd.Wait is not success evidence. No original exit code can be recreated after the fact. PID absence or new current fixture cannot repair it.",
  "no_replay_alternative": "Continue evidence-only recovery of existing exact original native wait/exit artifacts; or independently review the never-job class above. Neither launches/verifies/replays old request. If neither can be established, keep strict actual STOP and dependent C blocked.",
  "authorization_anchor": {
    "required": "Independent non-self-asserted exact operation authorization anchor with real nonempty accepted hash before usable commit path",
    "minimal_option": "Operation-specific build pins exact approved operation plan hash plus independently frozen F01/native evidence manifest hashes; source/proof parsing still revalidates all facts. A separate local protected registry is acceptable only with an explicit owner/update contract; caller JSON or expect-plan-sha256 alone is integrity, not approval.",
    "limitation": "Same-SID local registry or compiled pins do not create cryptographic independence against a malicious same-user administrator. Trust basis remains declared OS Owner plus controlled operator workflow; do not claim protected holdout.",
    "source_freeze": "An empty allowlist may safely disable commit temporarily but is not complete delivery of an operational Source contract. Freeze concrete anchor loading/validation/fixtures before acceptance; future actual plan pins remain separate authority."
  },
  "formal_increment": 0,
  "late_binding_supplement": {
    "manifest_sha256": "29872605ae6a972dbcbbfaf77b675859b4f8c975ee270b9ae974ae38ed36c558",
    "supported": "f255f4d4 installed image plus installation and three exact4f source hashes recorded in joint historical compile vector",
    "still_missing": "Verifier-specific transitive init closure; exact historical196 branch inference and all credential/job paths; independently approved new proof class. Nativeclosure remains missing."
  }
}

