func independentClone(o Object, omit ...string) Object {
 c:=Object{};for k,v:=range o{c[k]=v};for _,k:=range omit{delete(c,k)};return c
}
func independentNumber(t *testing.T,o Object,k string) int64 {t.Helper();var n int64;var e error;if s,ok:=o[k].(string);ok{n,e=strconv.ParseInt(s,10,64)}else{n,e=Num(o,k)};if e!=nil{t.Fatal("integer",k,e)};return n}
func independentBody(t *testing.T,r Object) Object {t.Helper();b,e:=Decode([]byte(Str(r,"body")));if e!=nil{t.Fatal(e)};return b}
func independentTime(t *testing.T,value,start,end string){t.Helper();v,e:=time.Parse(time.RFC3339Nano,value);lo,e1:=time.Parse(time.RFC3339Nano,start);hi,e2:=time.Parse(time.RFC3339Nano,end);if e!=nil||e1!=nil||e2!=nil||v.Before(lo)||v.After(hi){t.Fatal("restore time outside actual invocation",value,start,end)}}
func independentObjectKey(r Object)string{return Str(r,"project")+"|"+Str(r,"kind")+"|"+Str(r,"id")}
func independentNewRows(t *testing.T,before,after Object,name string) []Object {
 t.Helper();b:=independentRows(before,name);a:=independentRows(after,name);independentSubset(t,b,a,name);known:=map[string]int{};for _,s:=range b{known[s]++};objects:=independentCellRows(after,name);newRows:=[]Object{};for i,s:=range a{if known[s]>0{known[s]--}else{newRows=append(newRows,objects[i])}};return newRows
}
func independentRestoreDelta(t *testing.T,before,after Object,destination,start,end string) Object {
 t.Helper()
 allowed:=map[string]bool{"domain_objects":true,"domain_versions":true,"domain_refs":true,"outbox":true,"event_state_snapshots":true,"resource_effects":true,"auth_credentials":true,"backup_restore_barriers":true,"client_command_queue":true,"client_control_receipts":true,"client_queue_fences":true,"client_control_requests":true,"client_sessions":true,"retrieval_roots":true}
 delta:=Object{};old:=before["tables"].(Object);cur:=after["tables"].(Object)
 for n,b:=range old{a,ok:=cur[n];if !ok{t.Fatal("restore removed table",n)};if Hash(b)!=Hash(a){if !allowed[n]{t.Fatal("unexpected restored table change",n)};delta[n]=Object{"before":Hash(b),"after":Hash(a)}}}
 for n:=range cur{if _,ok:=old[n];!ok&&n!="backup_restore_barriers"{t.Fatal("unexpected new restore table",n)}}
 // Full old schema objects survive. Only the named existing restore fence
 // producers may append schema; their actual SQL remains in the full vector.
 bs:=before["schema"].(Object)["typed_row_multiset"].([]string);as:=after["schema"].(Object)["typed_row_multiset"].([]string);independentSubset(t,bs,as,"sqlite_schema");knownSchema:=map[string]bool{};for _,v:=range bs{knownSchema[v]=true};allowedSchema:=map[string]bool{"backup_restore_barriers":true,"sqlite_autoindex_backup_restore_barriers_1":true,"backup_require_fresh_observation":true,"client_session_epoch_no_regression":true,"client_session_require_fresh":true};for _,v:=range as{if knownSchema[v]{continue};var cells [][]any;if json.Unmarshal([]byte(v),&cells)!=nil||len(cells)<4||len(cells[1])<2||!allowedSchema[fmt.Sprint(cells[1][1])]{t.Fatal("unexpected restore schema append",v)}}
 oldobj:=map[string]Object{};newobj:=map[string]Object{};for _,r:=range independentCellRows(before,"domain_objects"){oldobj[independentObjectKey(r)]=r};for _,r:=range independentCellRows(after,"domain_objects"){newobj[independentObjectKey(r)]=r}
 active:=map[string]Object{};states:=map[string]Object{};activeStates:=map[string]bool{"QUEUED":true,"STARTING":true,"RUNNING":true,"CANCEL_REQUESTED":true,"RECONCILING":true,"LOST":true};expectedVersions:=map[string]Object{};oldWorkspace:=Object{}
 for key,r:=range oldobj{if r["kind"]=="WorkspaceBinding"{b:=independentBody(t,r);if b["authorized_workspace_ref"]=="tool-workspace"{oldWorkspace=b}};if r["kind"]=="ProjectState"{states[Str(r,"project")]=independentBody(t,r)};if r["kind"]=="Run"{b:=independentBody(t,r);if activeStates[Str(b,"status")]{active[key]=b}}}
 versionKey:=func(project,kind,id string,rev int64)string{return project+"|"+kind+"|"+id+"|"+fmt.Sprint(rev)}
 for key,r:=range oldobj {
  a,ok:=newobj[key];if !ok{t.Fatal("missing original object",key)};b:=independentBody(t,r);ab:=independentBody(t,a);kind:=Str(r,"kind")
  if orig,yes:=active[key];yes{
   if Hash(independentClone(orig,"status","lease_token_hash","lease_expires_at","revision","updated_at"))!=Hash(independentClone(ab,"status","lease_token_hash","lease_expires_at","revision","updated_at")){t.Fatal("Run immutable fields changed",key)}
   status:="RECONCILING";if orig["status"]=="CANCEL_REQUESTED"{status="CANCEL_REQUESTED"};if ab["status"]!=status||ab["lease_expires_at"]!="1970-01-01T00:00:00Z"||independentNumber(t,ab,"revision")!=independentNumber(t,orig,"revision")+1||Str(ab,"lease_token_hash")==""||ab["lease_token_hash"]==orig["lease_token_hash"]{t.Fatal("bad exact Run fence",key)};independentTime(t,Str(ab,"updated_at"),start,end)
   expectedVersions[versionKey(Str(a,"project"),kind,Str(a,"id"),independentNumber(t,ab,"revision"))]=Object{"body":ab,"content_hash":nil}
  }else if kind=="ProjectState"{
   if Hash(independentClone(b,"event_sequence","revision","updated_at"))!=Hash(independentClone(ab,"event_sequence","revision","updated_at")){t.Fatal("ProjectState unrelated mutation")}
  }else if kind=="WorkspaceBinding"&&Str(b,"authorized_workspace_ref")=="tool-workspace"&&b["status"]=="ACTIVE" {
   expected:=independentClone(b);expected["real_path"]=BackupWorkspaceDestination(destination,"tool-workspace");expected["display_path"]=expected["real_path"];expected["revision"]=independentNumber(t,b,"revision")+2;expected["status"]="ACTIVE";expected["host_principal_ref"]="SYNTHETIC_INDEPENDENT_RESTORE";if Hash(expected)!=Hash(ab)||a["content_hash"]!=Digest([]byte(Str(a,"body"))){t.Fatal("workspace exact two-stage remap")}
  }else if kind=="Project"&&b["authorized_workspace_ref"]=="tool-workspace"&&len(oldWorkspace)>0{
   if b["id"]!="00172b0dce9cbf45a78a9625552efd10"||b["real_path"]!=oldWorkspace["real_path"]{t.Fatal("original Project workspace binding")};expected:=independentClone(b);expected["real_path"]=BackupWorkspaceDestination(destination,"tool-workspace");expected["revision"]=independentNumber(t,b,"revision")+1;if Hash(expected)!=Hash(ab)||a["content_hash"]!=Digest([]byte(Str(a,"body"))){t.Fatal("Project exact opaque remap")}
  }else if Hash(r)!=Hash(a){t.Fatal("unrelated original object changed",key)}
  if Hash(r)!=Hash(a){if Hash(independentClone(r,"body","revision","content_hash"))!=Hash(independentClone(a,"body","revision","content_hash")){t.Fatal("SQL identity or immutable flag changed",key)};if independentNumber(t,a,"revision")!=independentNumber(t,ab,"revision"){t.Fatal("SQL/body revision mismatch")};if kind=="Run"||kind=="ProjectState"{if a["content_hash"]!=nil{t.Fatal("mutable typed object unexpected hash")}}}
 }
 events:=independentNewRows(t,before,after,"outbox");snapshots:=independentNewRows(t,before,after,"event_state_snapshots");if len(events)!=len(active)||len(snapshots)!=len(active){t.Fatal("restore event/snapshot/run count",len(events),len(snapshots),len(active))}
 sort.Slice(events,func(i,j int)bool{if events[i]["project"]!=events[j]["project"]{return Str(events[i],"project")<Str(events[j],"project")};return independentNumber(t,events[i],"sequence")<independentNumber(t,events[j],"sequence")})
 maxSeq:=map[string]int64{};for _,r:=range independentCellRows(before,"outbox"){p:=Str(r,"project");n:=independentNumber(t,r,"sequence");if n>maxSeq[p]{maxSeq[p]=n}}
 snapshotByEvent:=map[string]Object{};for _,s:=range snapshots{if snapshotByEvent[Str(s,"event_id")]!=nil{t.Fatal("duplicate snapshot")};snapshotByEvent[Str(s,"event_id")]=s};seenRun:=map[string]bool{};seenEvent:=map[string]bool{};chain:=[]any{}
 for _,row:=range events{
  ev:=independentBody(t,row);project:=Str(row,"project");id:=Str(ev,"id");aggregate,ok:=ev["aggregate_ref"].(map[string]any);if !ok{t.Fatal("restore aggregate")};key:=project+"|Run|"+Str(aggregate,"id");original,ok:=active[key];if !ok||seenRun[key]{t.Fatal("event not bijective to original active run",key)};seenRun[key]=true;seenEvent[id]=true;run:=independentBody(t,newobj[key]);if Hash(aggregate)!=Hash(Ref(run,"Run")){t.Fatal("event restored Run reference")}
  if ev["event_type"]!="RUN_CHANGED"||ev["actor_id"]!="restore-local-admin"||ev["project_id"]!=project||ev["causation_id"]!=nil||ev["event_data_artifact_ref"]!=nil||Str(ev,"correlation_id")==""||ev["receipt_hash"]!=Receipt(ev)||independentNumber(t,ev,"revision")!=1||row["id"]!=id||independentNumber(t,row,"acknowledged")!=0{t.Fatal("restore event producer mismatch")};independentTime(t,Str(ev,"created_at"),start,end)
  state,ok:=states[project];if !ok{t.Fatal("original ProjectState missing")};seq:=independentNumber(t,state,"event_sequence");if maxSeq[project]>seq{seq=maxSeq[project]};seq++;if independentNumber(t,ev,"sequence")!=seq||independentNumber(t,row,"sequence")!=seq{t.Fatal("restore event sequence")}
  snap:=snapshotByEvent[id];if snap==nil||snap["project"]!=project{t.Fatal("unmatched restore snapshot")};sb:=independentBody(t,snap);expected:=independentClone(state);expected["revision"]=independentNumber(t,state,"revision")+1;expected["event_sequence"]=seq;expected["updated_at"]=sb["updated_at"];independentTime(t,Str(sb,"updated_at"),start,end);if Hash(expected)!=Hash(sb)||independentNumber(t,snap,"revision")!=independentNumber(t,sb,"revision"){t.Fatal("snapshot not exact next ProjectState")};states[project]=sb;maxSeq[project]=seq
  erow,ok:=newobj[project+"|EventEnvelope|"+id];if !ok||Str(erow,"body")!=Str(row,"body")||erow["content_hash"]!=ev["receipt_hash"]||independentNumber(t,erow,"immutable")!=1{t.Fatal("event original object/outbox/hash")}
  expectedVersions[versionKey(project,"ProjectState",Str(sb,"id"),independentNumber(t,sb,"revision"))]=Object{"body":sb,"content_hash":nil};expectedVersions[versionKey(project,"EventEnvelope",id,1)]=Object{"body":ev,"content_hash":ev["receipt_hash"]};chain=append(chain,Object{"original_run":original,"restored_run":run,"event":ev,"snapshot":sb})
 }
 for project,state:=range states{found:=false;for _,r:=range newobj{if r["project"]==project&&r["kind"]=="ProjectState"{found=true;if Hash(independentBody(t,r))!=Hash(state){t.Fatal("final ProjectState mismatch")}}};if !found{t.Fatal("final state absent")}}
 for key,r:=range newobj{if _,exists:=oldobj[key];!exists{if r["kind"]!="EventEnvelope"||!seenEvent[Str(r,"id")]{t.Fatal("unexpected new domain object",key)}}}
 versions:=independentNewRows(t,before,after,"domain_versions");if len(versions)!=len(expectedVersions){t.Fatal("unexpected historical append count",len(versions),len(expectedVersions))};for _,r:=range versions{k:=versionKey(Str(r,"project"),Str(r,"kind"),Str(r,"id"),independentNumber(t,r,"revision"));expected:=expectedVersions[k];if expected==nil||Hash(independentBody(t,r))!=Hash(expected["body"])||Hash(r["content_hash"])!=Hash(expected["content_hash"]){t.Fatal("unexpected historical producer append",k)}}
 // Original references stay, and each new reference must belong to one of the
 // exact new versions. Targets must resolve to the actual full immutable row.
 refs:=independentNewRows(t,before,after,"domain_refs");for _,r:=range refs{k:=versionKey(Str(r,"project"),Str(r,"kind"),Str(r,"id"),independentNumber(t,r,"revision"));expected:=expectedVersions[k];if expected==nil{t.Fatal("unrelated new reference",k)};owner:=expected["body"].(Object);field:=Str(r,"field");var value any=owner;for _,part:=range strings.Split(strings.TrimPrefix(field,"/"),"/"){switch v:=value.(type){case map[string]any:value=v[part];case []any:i,e:=strconv.Atoi(part);if e!=nil||i<0||i>=len(v){t.Fatal("reference array index")};value=v[i];default:t.Fatal("reference field unavailable",field)}};targetID:=Str(r,"target_id");if v,ok:=value.(map[string]any);ok{if v["id"]!=targetID||v["entity_type"]!=r["target_kind"]||independentNumber(t,v,"revision")!=independentNumber(t,r,"target_revision"){t.Fatal("new VersionRef mismatch")}}else if value!=targetID{t.Fatal("new relation target mismatch",field)}}
 // Every original effect row remains. Appends equal the original latest state
 // with only the five fields written by backupFence/effectAppend changed.
 latest:=map[string]Object{};for _,r:=range independentCellRows(before,"resource_effects"){k:=Str(r,"project")+"|"+Str(r,"run")+"|"+Str(r,"effect_key");if latest[k]==nil||independentNumber(t,r,"sequence")>independentNumber(t,latest[k],"sequence"){latest[k]=r}};need:=map[string]Object{};for k,r:=range latest{b:=independentBody(t,r);if b["state"]=="PREPARED"||b["state"]=="STARTED"||b["state"]=="UNKNOWN"{need[k]=r}}
 appended:=independentNewRows(t,before,after,"resource_effects");if len(appended)!=len(need){t.Fatal("restore effect append count")};for _,r:=range appended{k:=Str(r,"project")+"|"+Str(r,"run")+"|"+Str(r,"effect_key");prior:=need[k];if prior==nil{t.Fatal("unexpected restored effect")};delete(need,k);b:=independentBody(t,prior);ab:=independentBody(t,r);n:=independentNumber(t,prior,"sequence")+1;if independentNumber(t,r,"sequence")!=n||independentNumber(t,ab,"sequence")!=n||ab["state"]!="UNKNOWN"||ab["restore_reason"]!="SNAPSHOT_MAY_PREDATE_EXTERNAL_DISPATCH"||Hash(independentClone(b,"sequence","observed_at","state","restore_reason"))!=Hash(independentClone(ab,"sequence","observed_at","state","restore_reason")){t.Fatal("restore effect original identity/cost changed")};independentTime(t,Str(ab,"observed_at"),start,end)}
 delta["restore_event_chain"]=chain;delta["original_immutable_rows_retained"]=true;delta["schema_before"]=Hash(before["schema"]);delta["schema_after"]=Hash(after["schema"]);return delta
}
