diff --git a/internal/recoveryboundary/contract.go b/internal/recoveryboundary/contract.go
new file mode 100644
index 00000000..b8d230b3
--- /dev/null
+++ b/internal/recoveryboundary/contract.go
@@ -0,0 +1,290 @@
+package recoveryboundary
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"path/filepath"
+	"strings"
+	"time"
+)
+
+const (
+	PlanSchema    = "researchos.recovery-boundary-plan.v1"
+	EventSchema   = "researchos.recovery-boundary-event.v1"
+	WitnessSchema = "researchos.post-restart-current-quiescence.v1"
+	// CurrentQuiescenceClass is scoped only to the C maintenance transaction.
+	// It is not a historical Wait, STOP closure, B drain ticket, or D proof.
+	CurrentQuiescenceClass = "POST_RESTART_CURRENT_QUIESCENCE_V1"
+	MaxElapsed             = 30 * time.Minute
+	MaxPostUptime          = 10 * time.Minute
+)
+
+// FileIdentity is evidence only. The native checker always reopens the object.
+type FileIdentity struct {
+	Path               string `json:"path"`
+	FinalUTF16         string `json:"final_utf16"`
+	Volume             uint64 `json:"volume"`
+	FileID             string `json:"file_id"`
+	SHA256             string `json:"sha256,omitempty"`
+	SecurityDescriptor string `json:"security_descriptor"`
+	Directory          bool   `json:"directory"`
+}
+
+type FenceTarget struct {
+	File              FileIdentity `json:"file"`
+	Mode              string       `json:"mode"` // executable or script; exact access is checked natively
+	InstalledSD       string       `json:"installed_sd,omitempty"`
+	RestartArgsSHA256 []string     `json:"restart_args_sha256,omitempty"`
+}
+
+// EntryFencePlan describes the complete, frozen official entry inventory.
+// Merely decoding one never grants an operation.
+type EntryFencePlan struct {
+	Schema                 string         `json:"schema"`
+	OperationID            string         `json:"operation_id"`
+	PlanSHA256             string         `json:"plan_sha256"`
+	DataRoot               FileIdentity   `json:"data_root"`
+	Database               FileIdentity   `json:"database"`
+	Helper                 FileIdentity   `json:"helper"`
+	BusinessSID            string         `json:"business_sid"`
+	BusinessGroupSIDs      []string       `json:"business_group_sids"` // native enabled groups excluding only per-logon SID and integrity label
+	ManagementSID          string         `json:"management_sid"`
+	HostIdentitySHA256     string         `json:"host_identity_sha256"`
+	SubjectSHA256          string         `json:"subject_sha256"`
+	EvidenceSHA256         string         `json:"evidence_sha256"`
+	BackupManifestSHA256   string         `json:"backup_manifest_sha256"`
+	SourceAcceptanceSHA256 string         `json:"source_acceptance_sha256"`
+	NativeAcceptanceSHA256 string         `json:"native_acceptance_sha256"`
+	RecoveryPackageSHA256  string         `json:"recovery_package_sha256"`
+	Targets                []FenceTarget  `json:"targets"`
+	Ancestors              []FileIdentity `json:"ancestors"`
+}
+
+type BootWitness struct {
+	Schema                     string    `json:"schema"`
+	OperationID                string    `json:"operation_id"`
+	PlanSHA256                 string    `json:"plan_sha256"`
+	HelperSHA256               string    `json:"helper_sha256"`
+	UTC                        time.Time `json:"utc"`
+	UptimeMilliseconds         uint64    `json:"uptime_milliseconds"`
+	LastBootUTC                time.Time `json:"last_boot_utc"`
+	RestartApps                uint32    `json:"restart_apps"`
+	FenceSHA256                string    `json:"fence_sha256"`
+	BusinessEnabledSIDsSHA256  string    `json:"business_enabled_sids_sha256,omitempty"`
+	BusinessSessionID          uint32    `json:"business_session_id,omitempty"`
+	BusinessElevationType      uint32    `json:"business_elevation_type,omitempty"`
+	BusinessIntegritySID       string    `json:"business_integrity_sid,omitempty"`
+	BusinessLogonSID           string    `json:"business_logon_sid,omitempty"`
+	BusinessPrivilegesSHA256   string    `json:"business_privileges_sha256,omitempty"`
+	BusinessProcessPID         uint32    `json:"business_process_pid,omitempty"`
+	BusinessProcessCreatedUTC  time.Time `json:"business_process_created_utc,omitempty"`
+	BusinessProcessImageSHA256 string    `json:"business_process_image_sha256,omitempty"`
+	FullRestartEvidenceSHA256  string    `json:"full_restart_evidence_sha256,omitempty"`
+}
+
+type BoundaryEvent struct {
+	Schema         string    `json:"schema"`
+	Sequence       uint64    `json:"sequence"`
+	PreviousSHA256 string    `json:"previous_sha256"`
+	SHA256         string    `json:"sha256"`
+	OperationID    string    `json:"operation_id"`
+	PlanSHA256     string    `json:"plan_sha256"`
+	State          string    `json:"state"`
+	UTC            time.Time `json:"utc"`
+}
+
+// BoundaryAttestation is a protected external reviewer or backup report.
+// A digest alone, a static copy, or a caller assertion cannot satisfy arm.
+type BoundaryAttestation struct {
+	Schema                string    `json:"schema"`
+	Kind                  string    `json:"kind"`
+	Status                string    `json:"status"`
+	OperationID           string    `json:"operation_id"`
+	PlanCoreSHA256        string    `json:"plan_core_sha256"`
+	Issuer                string    `json:"issuer"`
+	EvidenceSHA256        string    `json:"evidence_sha256"`
+	BackupID              string    `json:"backup_id,omitempty"`
+	RestoreTestSHA256     string    `json:"restore_test_sha256,omitempty"`
+	CredentialProbeSHA256 string    `json:"credential_probe_sha256,omitempty"`
+	RecordedUTC           time.Time `json:"recorded_utc"`
+}
+
+func digest(raw []byte) string { h := sha256.Sum256(raw); return hex.EncodeToString(h[:]) }
+func validDigest(s string) bool {
+	if len(s) != 64 {
+		return false
+	}
+	_, e := hex.DecodeString(s)
+	return e == nil && s == strings.ToLower(s)
+}
+func validOperation(s string) bool {
+	if len(s) != 32 || s != strings.ToLower(s) {
+		return false
+	}
+	for _, c := range s {
+		if !(c >= 'a' && c <= 'f' || c >= '0' && c <= '9') {
+			return false
+		}
+	}
+	return true
+}
+
+func PlanCoreSHA256(p EntryFencePlan) (string, error) {
+	p.PlanSHA256 = ""
+	p.SourceAcceptanceSHA256 = ""
+	p.NativeAcceptanceSHA256 = ""
+	p.BackupManifestSHA256 = ""
+	p.RecoveryPackageSHA256 = ""
+	raw, e := json.Marshal(p)
+	if e != nil {
+		return "", e
+	}
+	return digest(raw), nil
+}
+
+func ComputePlanSHA256(p EntryFencePlan) (string, error) {
+	p.PlanSHA256 = ""
+	raw, e := json.Marshal(p)
+	if e != nil {
+		return "", e
+	}
+	return digest(raw), nil
+}
+
+func ValidatePlan(p EntryFencePlan) error {
+	expected, err := ComputePlanSHA256(p)
+	if err != nil || p.PlanSHA256 != expected {
+		return errors.New("boundary plan canonical digest mismatch")
+	}
+	if p.Schema != PlanSchema || !validOperation(p.OperationID) || !validDigest(p.PlanSHA256) ||
+		!validDigest(p.HostIdentitySHA256) || !validDigest(p.SubjectSHA256) ||
+		!validDigest(p.EvidenceSHA256) || !validDigest(p.BackupManifestSHA256) ||
+		!validDigest(p.SourceAcceptanceSHA256) || !validDigest(p.NativeAcceptanceSHA256) ||
+		!validDigest(p.RecoveryPackageSHA256) || p.BusinessSID == "" || p.ManagementSID == "" ||
+		strings.EqualFold(p.BusinessSID, p.ManagementSID) || len(p.Targets) == 0 || len(p.Targets) > 64 {
+		return errors.New("recovery boundary plan incomplete")
+	}
+	if p.DataRoot.Path == "" || p.Database.Path != filepath.Join(p.DataRoot.Path, "researchos.sqlite") || p.Helper.Path == "" {
+		return errors.New("recovery boundary root, database or helper mismatch")
+	}
+	if len(p.BusinessGroupSIDs) == 0 || len(p.BusinessGroupSIDs) > 64 {
+		return errors.New("business enabled group inventory missing")
+	}
+	seen := map[string]bool{}
+	if len(p.Ancestors) == 0 || len(p.Ancestors) > 256 {
+		return errors.New("boundary ancestor inventory missing")
+	}
+	for _, a := range p.Ancestors {
+		if !a.Directory || a.FileID == "" || a.FinalUTF16 == "" || a.SecurityDescriptor == "" || seen[strings.ToLower(a.Path)] {
+			return errors.New("boundary ancestor identity invalid")
+		}
+		seen[strings.ToLower(a.Path)] = true
+	}
+	for _, t := range p.Targets {
+		if t.Mode != "executable" && t.Mode != "script" {
+			return errors.New("unknown fence target mode")
+		}
+		if !filepath.IsAbs(t.File.Path) || filepath.Clean(t.File.Path) != t.File.Path || seen[strings.ToLower(t.File.Path)] || t.File.Directory {
+			return errors.New("fence inventory path invalid")
+		}
+		seen[strings.ToLower(t.File.Path)] = true
+		if len(t.RestartArgsSHA256) > 16 {
+			return errors.New("restart argv inventory unbounded")
+		}
+		for _, sha := range t.RestartArgsSHA256 {
+			if !validDigest(sha) {
+				return errors.New("restart argv digest invalid")
+			}
+		}
+	}
+	return nil
+}
+
+func ValidateRestart(pre, post BootWitness) error {
+	if pre.Schema != WitnessSchema || post.Schema != WitnessSchema || pre.OperationID != post.OperationID || pre.PlanSHA256 != post.PlanSHA256 || pre.HelperSHA256 != post.HelperSHA256 || pre.FenceSHA256 != post.FenceSHA256 || !validDigest(pre.PlanSHA256) || !validDigest(pre.FenceSHA256) || !validDigest(pre.HelperSHA256) {
+		return errors.New("witness binding changed")
+	}
+	if pre.UptimeMilliseconds < uint64(MaxPostUptime/time.Millisecond) || post.UptimeMilliseconds >= uint64(MaxPostUptime/time.Millisecond) || post.UptimeMilliseconds >= pre.UptimeMilliseconds {
+		return errors.New("uptime does not prove fresh restart")
+	}
+	if pre.LastBootUTC.IsZero() || post.LastBootUTC.IsZero() || !post.LastBootUTC.After(pre.LastBootUTC) {
+		return errors.New("boot time did not advance")
+	}
+	if pre.UTC.IsZero() || post.UTC.IsZero() || post.UTC.Before(pre.UTC) || post.UTC.Sub(pre.UTC) > MaxElapsed {
+		return errors.New("witness outside bounded UTC window")
+	}
+	if post.LastBootUTC.Before(pre.UTC.Add(-2*time.Minute)) || post.LastBootUTC.After(post.UTC) {
+		return errors.New("boot time contradicts witness UTC")
+	}
+	for _, w := range []BootWitness{pre, post} {
+		expected := w.UTC.Add(-time.Duration(w.UptimeMilliseconds) * time.Millisecond)
+		if w.LastBootUTC.Before(expected.Add(-2*time.Minute)) || w.LastBootUTC.After(expected.Add(2*time.Minute)) {
+			return errors.New("native uptime and boot time disagree")
+		}
+	}
+	if pre.RestartApps > 1 || post.RestartApps > 1 || pre.RestartApps != post.RestartApps {
+		return errors.New("RestartApps state unknown")
+	}
+	if pre.FullRestartEvidenceSHA256 != "" || !validDigest(post.FullRestartEvidenceSHA256) {
+		return errors.New("explicit FullRestart evidence missing")
+	}
+	if !validDigest(pre.BusinessEnabledSIDsSHA256) || pre.BusinessEnabledSIDsSHA256 != post.BusinessEnabledSIDsSHA256 ||
+		!validDigest(pre.BusinessPrivilegesSHA256) || pre.BusinessPrivilegesSHA256 != post.BusinessPrivilegesSHA256 ||
+		pre.BusinessElevationType < 1 || pre.BusinessElevationType > 3 || pre.BusinessElevationType != post.BusinessElevationType ||
+		pre.BusinessIntegritySID == "" || pre.BusinessIntegritySID != post.BusinessIntegritySID ||
+		pre.BusinessLogonSID == "" || post.BusinessLogonSID == "" {
+		return errors.New("business token permission semantics changed across restart")
+	}
+	for _, w := range []BootWitness{pre, post} {
+		if w.BusinessProcessPID == 0 || !validDigest(w.BusinessProcessImageSHA256) || w.BusinessProcessCreatedUTC.IsZero() ||
+			w.BusinessProcessCreatedUTC.Before(w.LastBootUTC.Add(-2*time.Second)) || w.BusinessProcessCreatedUTC.After(w.UTC.Add(2*time.Second)) {
+			return errors.New("business token source process identity invalid")
+		}
+	}
+	return nil
+}
+
+func transition(from, to string) bool {
+	switch from {
+	case "":
+		return to == "PREPARED"
+	case "PREPARED":
+		return to == "APPLYING" || to == "BOUNDARY_ABORTED"
+	case "APPLYING":
+		return to == "ARMED" || to == "BOUNDARY_ABORTED"
+	case "ARMED":
+		return to == "BOOT_OBSERVED" || to == "BOUNDARY_ABORTED"
+	case "BOOT_OBSERVED":
+		return to == "C_HELD" || to == "BOUNDARY_ABORTED"
+	case "C_HELD":
+		return to == "C_DURABLE" || to == "BOUNDARY_ABORTED"
+	case "C_DURABLE", "BOUNDARY_ABORTED":
+		return to == "DISARMING"
+	case "DISARMING":
+		return to == "CLOSED"
+	}
+	return false
+}
+
+func ValidateEvents(events []BoundaryEvent, operation, plan string) error {
+	if len(events) == 0 || len(events) > 16 {
+		return errors.New("boundary event inventory invalid")
+	}
+	prevState, prevHash := "", ""
+	for i, e := range events {
+		if e.Schema != EventSchema || e.Sequence != uint64(i+1) || e.PreviousSHA256 != prevHash || e.OperationID != operation || e.PlanSHA256 != plan || !transition(prevState, e.State) || e.UTC.IsZero() {
+			return fmt.Errorf("boundary event %d invalid", i+1)
+		}
+		copy := e
+		copy.SHA256 = ""
+		raw := []byte(fmt.Sprintf("%s\x00%d\x00%s\x00%s\x00%s\x00%s\x00%s", copy.Schema, copy.Sequence, copy.PreviousSHA256, copy.OperationID, copy.PlanSHA256, copy.State, copy.UTC.UTC().Format(time.RFC3339Nano)))
+		if e.SHA256 != digest(raw) {
+			return fmt.Errorf("boundary event %d hash drift", i+1)
+		}
+		prevState, prevHash = e.State, e.SHA256
+	}
+	return nil
+}
diff --git a/internal/recoveryboundary/boot_windows.go b/internal/recoveryboundary/boot_windows.go
new file mode 100644
index 00000000..bc10fc1c
--- /dev/null
+++ b/internal/recoveryboundary/boot_windows.go
@@ -0,0 +1,2015 @@
+//go:build windows
+
+package recoveryboundary
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"sync"
+	"time"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+	"golang.org/x/sys/windows/registry"
+	rt "researchos.local/research-os/adapters/runtime"
+	"researchos.local/research-os/internal/qualificationmaintenancejournal"
+)
+
+type nativeHold struct {
+	path     string
+	handle   windows.Handle
+	identity FileIdentity
+}
+type quiescenceOwner struct {
+	mu     sync.Mutex
+	closed bool
+	lease  rt.DataRootLeaseIdentity
+	plan   EntryFencePlan
+	post   BootWitness
+	holds  []nativeHold
+}
+
+// CurrentQuiescence has no public constructor or serializable authority.
+// Value copies share one owner; Close consumes every copy's held native state.
+type CurrentQuiescence struct{ owner *quiescenceOwner }
+
+type boundaryRecord struct {
+	Plan       EntryFencePlan  `json:"plan"`
+	Pre        BootWitness     `json:"pre"`
+	Post       BootWitness     `json:"post"`
+	Events     []BoundaryEvent `json:"events"`
+	Generation uint64          `json:"generation"`
+}
+
+func nativeFileID(h windows.Handle) (uint64, string, error) {
+	var x struct {
+		VolumeSerialNumber uint64
+		FileID             [16]byte
+	}
+	if err := windows.GetFileInformationByHandleEx(h, windows.FileIdInfo, (*byte)(unsafe.Pointer(&x)), uint32(unsafe.Sizeof(x))); err != nil {
+		return 0, "", err
+	}
+	return x.VolumeSerialNumber, hex.EncodeToString(x.FileID[:]), nil
+}
+
+func finalPath(h windows.Handle) (string, error) {
+	buf := make([]uint16, 512)
+	for len(buf) <= 32768 {
+		n, e := windows.GetFinalPathNameByHandle(h, &buf[0], uint32(len(buf)), 0)
+		if e != nil {
+			return "", e
+		}
+		if n == 0 {
+			return "", errors.New("empty final path")
+		}
+		if int(n) < len(buf) {
+			return windows.UTF16ToString(buf[:n]), nil
+		}
+		buf = make([]uint16, int(n)+1)
+	}
+	return "", errors.New("final path exceeds Windows bound")
+}
+
+func openNative(path string, directory bool, hashFile bool) (nativeHold, error) {
+	return openNativeAccess(path, directory, hashFile, 0)
+}
+
+func openNativeAccess(path string, directory bool, hashFile bool, extraAccess uint32) (nativeHold, error) {
+	if !filepath.IsAbs(path) || filepath.Clean(path) != path {
+		return nativeHold{}, errors.New("native path is not canonical absolute")
+	}
+	if strings.Contains(path[len(filepath.VolumeName(path)):], ":") {
+		return nativeHold{}, errors.New("alternate data stream forbidden")
+	}
+	w, e := windows.UTF16PtrFromString(path)
+	if e != nil {
+		return nativeHold{}, e
+	}
+	// No FILE_SHARE_DELETE: the live owner pins every opened component against
+	// rename/delete until the caller's actual outer transaction has returned.
+	h, e := windows.CreateFile(w, windows.READ_CONTROL|windows.FILE_READ_ATTRIBUTES|windows.FILE_READ_DATA|extraAccess,
+		windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, nil, windows.OPEN_EXISTING,
+		windows.FILE_FLAG_OPEN_REPARSE_POINT|windows.FILE_FLAG_BACKUP_SEMANTICS, 0)
+	if e != nil {
+		return nativeHold{}, e
+	}
+	fail := func(e error) (nativeHold, error) { windows.CloseHandle(h); return nativeHold{}, e }
+	var info windows.ByHandleFileInformation
+	if e = windows.GetFileInformationByHandle(h, &info); e != nil {
+		return fail(e)
+	}
+	if info.FileAttributes&windows.FILE_ATTRIBUTE_REPARSE_POINT != 0 || (info.FileAttributes&windows.FILE_ATTRIBUTE_DIRECTORY != 0) != directory {
+		return fail(errors.New("reparse point or file kind mismatch"))
+	}
+	if !directory && info.NumberOfLinks != 1 {
+		return fail(errors.New("hard-linked boundary file forbidden"))
+	}
+	v, id, e := nativeFileID(h)
+	if e != nil {
+		return fail(e)
+	}
+	final, e := finalPath(h)
+	if e != nil {
+		return fail(e)
+	}
+	sd, e := windows.GetSecurityInfo(h, windows.SE_FILE_OBJECT, windows.OWNER_SECURITY_INFORMATION|windows.DACL_SECURITY_INFORMATION)
+	if e != nil {
+		return fail(e)
+	}
+	x := FileIdentity{Path: path, FinalUTF16: final, Volume: v, FileID: id, SecurityDescriptor: sd.String(), Directory: directory}
+	if hashFile {
+		if directory {
+			return fail(errors.New("cannot hash directory"))
+		}
+		s := sha256.New()
+		var total int64
+		buf := make([]byte, 64<<10)
+		for {
+			var n uint32
+			e = windows.ReadFile(h, buf, &n, nil)
+			if e != nil {
+				return fail(e)
+			}
+			if n == 0 {
+				break
+			}
+			total += int64(n)
+			if total > 128<<20 {
+				return fail(errors.New("hash input exceeds bound"))
+			}
+			_, _ = s.Write(buf[:n])
+		}
+		x.SHA256 = hex.EncodeToString(s.Sum(nil))
+	}
+	return nativeHold{path: path, handle: h, identity: x}, nil
+}
+
+func closeHolds(holds []nativeHold) error {
+	var out error
+	for i := len(holds) - 1; i >= 0; i-- {
+		out = errors.Join(out, windows.CloseHandle(holds[i].handle))
+	}
+	return out
+}
+
+func identityEqual(a, b FileIdentity) bool {
+	return strings.EqualFold(a.Path, b.Path) && strings.EqualFold(a.FinalUTF16, b.FinalUTF16) && a.Volume == b.Volume && a.FileID == b.FileID && a.SHA256 == b.SHA256 && a.SecurityDescriptor == b.SecurityDescriptor && a.Directory == b.Directory
+}
+func identityCoreEqual(a, b FileIdentity) bool {
+	a.SecurityDescriptor = ""
+	b.SecurityDescriptor = ""
+	return identityEqual(a, b)
+}
+
+func pathAncestors(path string) []string {
+	var xs []string
+	for p := filepath.Dir(path); ; p = filepath.Dir(p) {
+		xs = append(xs, p)
+		if filepath.Dir(p) == p {
+			break
+		}
+	}
+	for i, j := 0, len(xs)-1; i < j; i, j = i+1, j-1 {
+		xs[i], xs[j] = xs[j], xs[i]
+	}
+	return xs
+}
+
+func openPlanHolds(p EntryFencePlan) ([]nativeHold, error) {
+	all := []FileIdentity{p.DataRoot, p.Database, p.Helper}
+	all = append(all, p.Ancestors...)
+	for _, t := range p.Targets {
+		all = append(all, t.File)
+	}
+	want := map[string]FileIdentity{}
+	for _, x := range all {
+		want[strings.ToLower(x.Path)] = x
+	}
+	for _, x := range all {
+		for _, a := range pathAncestors(x.Path) {
+			if _, ok := want[strings.ToLower(a)]; !ok {
+				return nil, fmt.Errorf("ancestor absent from frozen inventory: %s", a)
+			}
+		}
+	}
+	keys := make([]string, 0, len(want))
+	for k := range want {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	var holds []nativeHold
+	for _, k := range keys {
+		x := want[k]
+		h, e := openNative(x.Path, x.Directory, !x.Directory)
+		if e != nil {
+			closeHolds(holds)
+			return nil, fmt.Errorf("open boundary identity %s: %w", x.Path, e)
+		}
+		matches := identityEqual(x, h.identity)
+		if !matches {
+			for _, target := range p.Targets {
+				if strings.EqualFold(target.File.Path, x.Path) && identityCoreEqual(x, h.identity) && target.InstalledSD == h.identity.SecurityDescriptor {
+					matches = true
+					break
+				}
+			}
+		}
+		if !matches {
+			windows.CloseHandle(h.handle)
+			closeHolds(holds)
+			return nil, fmt.Errorf("boundary identity drift: %s", x.Path)
+		}
+		holds = append(holds, h)
+	}
+	return holds, nil
+}
+
+func checkHolds(holds []nativeHold) error {
+	if len(holds) == 0 {
+		return errors.New("native boundary holds missing")
+	}
+	for _, h := range holds {
+		fresh, e := openNative(h.path, h.identity.Directory, !h.identity.Directory)
+		if e != nil {
+			return e
+		}
+		same := identityEqual(h.identity, fresh.identity)
+		if e = windows.CloseHandle(fresh.handle); e != nil {
+			return e
+		}
+		if !same {
+			return fmt.Errorf("native boundary identity changed: %s", h.path)
+		}
+	}
+	return nil
+}
+
+func registryRestartApps(businessSID string) (uint32, error) {
+	if _, e := windows.StringToSid(businessSID); e != nil {
+		return 0, e
+	}
+	k, e := registry.OpenKey(registry.USERS, businessSID+`\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon`, registry.QUERY_VALUE)
+	if e != nil {
+		return 0, e
+	}
+	defer k.Close()
+	v, _, e := k.GetIntegerValue("RestartApps")
+	if e != nil || v > 1 {
+		return 0, errors.New("RestartApps registry state unavailable")
+	}
+	return uint32(v), nil
+}
+
+var getTick = windows.NewLazySystemDLL("kernel32.dll").NewProc("GetTickCount64")
+var ntSystem = windows.NewLazySystemDLL("ntdll.dll").NewProc("NtQuerySystemInformation")
+var getApplicationRestartSettings = windows.NewLazySystemDLL("kernel32.dll").NewProc("GetApplicationRestartSettings")
+
+func restartSettingsForProcess(h windows.Handle) (string, uint32, bool, error) {
+	var size, flags uint32
+	r, _, _ := getApplicationRestartSettings.Call(uintptr(h), 0, uintptr(unsafe.Pointer(&size)), uintptr(unsafe.Pointer(&flags)))
+	if uint32(r) == 0x80070490 {
+		return "", 0, false, nil
+	} // HRESULT_FROM_WIN32(ERROR_NOT_FOUND)
+	if uint32(r) != 0 || size == 0 || size > 1025 {
+		return "", 0, false, fmt.Errorf("restart registration size/status invalid: %#x/%d", uint32(r), size)
+	}
+	buf := make([]uint16, size)
+	r, _, _ = getApplicationRestartSettings.Call(uintptr(h), uintptr(unsafe.Pointer(&buf[0])), uintptr(unsafe.Pointer(&size)), uintptr(unsafe.Pointer(&flags)))
+	if uint32(r) != 0 || size == 0 || size > uint32(len(buf)) || flags&^uint32(0xf) != 0 {
+		return "", 0, false, fmt.Errorf("restart registration read/status invalid: %#x/%d/%#x", uint32(r), size, flags)
+	}
+	return windows.UTF16ToString(buf[:size]), flags, true, nil
+}
+
+func bootClock() (uint64, time.Time, error) {
+	u, _, e := getTick.Call()
+	if e != windows.ERROR_SUCCESS && e != nil {
+		return 0, time.Time{}, e
+	}
+	var x struct {
+		BootTime          int64
+		CurrentTime       int64
+		TimeZoneBias      int64
+		CurrentTimeZoneID uint32
+		Reserved          uint32
+		BootTimeBias      uint64
+		SleepTimeBias     uint64
+	}
+	r, _, e := ntSystem.Call(3, uintptr(unsafe.Pointer(&x)), unsafe.Sizeof(x), 0)
+	if r != 0 {
+		return 0, time.Time{}, fmt.Errorf("NtQuerySystemInformation status %#x: %v", r, e)
+	}
+	if x.BootTime <= 0 {
+		return 0, time.Time{}, errors.New("native boot time unavailable")
+	}
+	return uint64(u), time.Unix(0, (x.BootTime-116444736000000000)*100).UTC(), nil
+}
+
+func witness(p EntryFencePlan, fenceHash string) (BootWitness, error) {
+	u, b, e := bootClock()
+	if e != nil {
+		return BootWitness{}, e
+	}
+	r, e := registryRestartApps(p.BusinessSID)
+	if e != nil {
+		return BootWitness{}, e
+	}
+	return BootWitness{Schema: WitnessSchema, OperationID: p.OperationID, PlanSHA256: p.PlanSHA256, HelperSHA256: p.Helper.SHA256, UTC: time.Now().UTC(), UptimeMilliseconds: u, LastBootUTC: b, RestartApps: r, FenceSHA256: fenceHash}, nil
+}
+
+func stateRoot(p EntryFencePlan) (string, error) {
+	base := os.Getenv("ProgramData")
+	if base == "" || !filepath.IsAbs(base) {
+		return "", errors.New("ProgramData unavailable")
+	}
+	if !validOperation(p.OperationID) {
+		return "", errors.New("operation invalid")
+	}
+	h := digest([]byte(strings.ToLower(p.DataRoot.FinalUTF16) + "\x00" + p.DataRoot.FileID))
+	return filepath.Join(base, "ResearchOS", "RecoveryBoundary", h, p.OperationID), nil
+}
+
+func readRecord(p EntryFencePlan) (boundaryRecord, error) {
+	var r boundaryRecord
+	dir, e := stateRoot(p)
+	if e != nil {
+		return r, e
+	}
+	// The operation directory and every record must be independently protected.
+	if e = checkManagedChain(p); e != nil {
+		return r, e
+	}
+	entries, e := os.ReadDir(dir)
+	if e != nil {
+		return r, e
+	}
+	if len(entries) < 2 || len(entries) > 24 {
+		return r, errors.New("boundary state inventory invalid")
+	}
+	for _, entry := range entries {
+		if entry.IsDir() || (entry.Name() != "plan.json" && entry.Name() != "pre.json" && entry.Name() != "post.json" && entry.Name() != "full-restart-complete.json" && entry.Name() != "source-accepted.json" && entry.Name() != "native-accepted.json" && entry.Name() != "backup-verified.json" && entry.Name() != "recovery-ready.json" && !strings.HasPrefix(entry.Name(), "event-")) {
+			return r, errors.New("unknown boundary state entry")
+		}
+	}
+	raw, e := os.ReadFile(filepath.Join(dir, "plan.json"))
+	if e != nil || len(raw) > 256<<10 {
+		return r, errors.New("boundary plan file unavailable")
+	}
+	if e = json.Unmarshal(raw, &r.Plan); e != nil {
+		return r, e
+	}
+	if r.Plan.OperationID != p.OperationID || r.Plan.PlanSHA256 != p.PlanSHA256 {
+		return r, errors.New("boundary record plan mismatch")
+	}
+	pre, e := os.ReadFile(filepath.Join(dir, "pre.json"))
+	if e != nil || len(pre) > 16<<10 {
+		return r, errors.New("boundary pre witness unavailable")
+	}
+	if e = json.Unmarshal(pre, &r.Pre); e != nil {
+		return r, e
+	}
+	post, e := os.ReadFile(filepath.Join(dir, "post.json"))
+	if e == nil {
+		if len(post) > 16<<10 {
+			return r, errors.New("boundary post witness oversized")
+		}
+		if e = json.Unmarshal(post, &r.Post); e != nil {
+			return r, e
+		}
+	} else if !errors.Is(e, os.ErrNotExist) {
+		return r, e
+	}
+	for i := 1; i <= 16; i++ {
+		name := fmt.Sprintf("event-%02d.json", i)
+		raw, e := os.ReadFile(filepath.Join(dir, name))
+		if errors.Is(e, os.ErrNotExist) {
+			break
+		}
+		if e != nil || len(raw) > 16<<10 {
+			return r, errors.New("boundary event missing or oversized")
+		}
+		var ev BoundaryEvent
+		if e = json.Unmarshal(raw, &ev); e != nil {
+			return r, e
+		}
+		r.Events = append(r.Events, ev)
+	}
+	if e = ValidateEvents(r.Events, p.OperationID, p.PlanSHA256); e != nil {
+		return r, e
+	}
+	fullRestartRaw, fullRestartErr := os.ReadFile(filepath.Join(dir, "full-restart-complete.json"))
+	if fullRestartErr != nil && !errors.Is(fullRestartErr, os.ErrNotExist) {
+		return r, fullRestartErr
+	}
+	if !r.Post.UTC.IsZero() && (fullRestartErr != nil || digest(fullRestartRaw) != r.Post.FullRestartEvidenceSHA256) {
+		return r, errors.New("FullRestart evidence drift")
+	}
+	if len(entries) != 6+len(r.Events)+boolInt(!r.Post.UTC.IsZero())+boolInt(fullRestartErr == nil) {
+		return r, errors.New("boundary event inventory gap")
+	}
+	return r, nil
+}
+func boolInt(b bool) int {
+	if b {
+		return 1
+	}
+	return 0
+}
