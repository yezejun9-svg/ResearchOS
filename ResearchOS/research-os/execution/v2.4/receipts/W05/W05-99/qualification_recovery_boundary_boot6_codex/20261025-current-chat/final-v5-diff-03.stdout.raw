+func TestDisposableRealPEAndScriptFence(t *testing.T) {
+	dir := t.TempDir()
+	exe, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	pe := filepath.Join(dir, "owned-entry.exe")
+	src, err := os.Open(exe)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer src.Close()
+	dst, err := os.OpenFile(pe, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = io.Copy(dst, src); err != nil {
+		dst.Close()
+		t.Fatal(err)
+	}
+	if err = dst.Close(); err != nil {
+		t.Fatal(err)
+	}
+	script := filepath.Join(dir, "owned-entry.ps1")
+	if err = os.WriteFile(script, []byte("Write-Output fixture-only\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	u, err := windows.GetCurrentProcessToken().GetTokenUser()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, item := range []struct{ path, mode string }{{pe, "executable"}, {script, "script"}} {
+		var before nativeHold
+		if item.mode == "script" {
+			before, err = openNativeAccess(item.path, false, true, windows.WRITE_DAC|windows.WRITE_OWNER)
+		} else {
+			before, err = openNative(item.path, false, true)
+		}
+		if err != nil {
+			t.Fatal(err)
+		}
+		installed, err := denyDescriptor(before.identity.SecurityDescriptor, u.User.Sid.String(), u.User.Sid.String(), item.mode)
+		if err != nil {
+			windows.CloseHandle(before.handle)
+			t.Fatal(err)
+		}
+		if err = setTargetDescriptor(before.identity, installed); err != nil {
+			windows.CloseHandle(before.handle)
+			t.Skipf("fixture WRITE_DAC unavailable: %v", err)
+		}
+		func() {
+			defer func() {
+				var restoreErr error
+				if item.mode == "script" {
+					restoreErr = restoreFixtureViaHeldHandle(before)
+				} else {
+					restoreErr = setTargetDescriptor(withFixtureSD(before.identity, installed), before.identity.SecurityDescriptor)
+				}
+				if restoreErr != nil {
+					t.Errorf("restore owned %s: %v", item.mode, restoreErr)
+				}
+				windows.CloseHandle(before.handle)
+			}()
+			if item.mode == "executable" {
+				cmd := exec.Command(item.path, "-test.run=TestPEExecutionProbe")
+				cmd.Env = append(os.Environ(), "RESEARCHOS_BOOT6_PE_PROBE=1")
+				out, runErr := cmd.CombinedOutput()
+				if runErr == nil {
+					t.Errorf("real PE executed despite exact FILE_EXECUTE fence: %s", out)
+				} else if !errors.Is(runErr, windows.ERROR_ACCESS_DENIED) {
+					t.Errorf("real PE rejection was not ACCESS_DENIED: %v", runErr)
+				} else {
+					t.Logf("real PE CreateProcess denied: %v", runErr)
+				}
+				exerciseSQLiteWALUnderFence(t, dir)
+			} else {
+				w, err := windows.UTF16PtrFromString(item.path)
+				if err != nil {
+					t.Error(err)
+					return
+				}
+				h, openErr := windows.CreateFile(w, windows.FILE_READ_DATA, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, nil, windows.OPEN_EXISTING, 0, 0)
+				if openErr == nil {
+					windows.CloseHandle(h)
+					t.Error("script FILE_READ_DATA succeeded")
+				} else if !errors.Is(openErr, windows.ERROR_ACCESS_DENIED) {
+					t.Errorf("script read denial differs: %v", openErr)
+				} else {
+					t.Logf("script FILE_READ_DATA denied: %v", openErr)
+				}
+			}
+		}()
+	}
+}
+
+func restoreFixtureViaHeldHandle(h nativeHold) error {
+	sd, err := windows.SecurityDescriptorFromString(h.identity.SecurityDescriptor)
+	if err != nil {
+		return err
+	}
+	owner, _, err := sd.Owner()
+	if err != nil {
+		return err
+	}
+	dacl, _, err := sd.DACL()
+	if err != nil {
+		return err
+	}
+	control, _, err := sd.Control()
+	if err != nil {
+		return err
+	}
+	flags := windows.SECURITY_INFORMATION(windows.DACL_SECURITY_INFORMATION | windows.OWNER_SECURITY_INFORMATION | windows.UNPROTECTED_DACL_SECURITY_INFORMATION)
+	if control&windows.SE_DACL_PROTECTED != 0 {
+		flags = windows.SECURITY_INFORMATION(windows.DACL_SECURITY_INFORMATION | windows.OWNER_SECURITY_INFORMATION | windows.PROTECTED_DACL_SECURITY_INFORMATION)
+	}
+	return windows.SetSecurityInfo(h.handle, windows.SE_FILE_OBJECT, flags, owner, nil, dacl, nil)
+}
+
+func TestOwnProcessRestartRegistrationNativeArgv(t *testing.T) {
+	register := windows.NewLazySystemDLL("kernel32.dll").NewProc("RegisterApplicationRestart")
+	unregister := windows.NewLazySystemDLL("kernel32.dll").NewProc("UnregisterApplicationRestart")
+	arg := "--boot6-native-argv"
+	w, err := windows.UTF16PtrFromString(arg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	r, _, _ := register.Call(uintptr(unsafe.Pointer(w)), 0)
+	if uint32(r) != 0 {
+		t.Skipf("own process RestartApps registration unavailable: HRESULT %#x", uint32(r))
+	}
+	defer unregister.Call()
+	actual, flags, registered, err := restartSettingsForProcess(windows.CurrentProcess())
+	if err != nil || !registered || actual != arg || flags != 0 {
+		t.Fatalf("native restart registration argv: registered=%v args=%q flags=%#x err=%v", registered, actual, flags, err)
+	}
+	t.Logf("GetApplicationRestartSettings returned own exact argv %q flags %#x", actual, flags)
+}
+
+func exerciseSQLiteWALUnderFence(t *testing.T, parent string) {
+	t.Helper()
+	root := filepath.Join(parent, "data-root")
+	if err := os.Mkdir(root, 0700); err != nil {
+		t.Fatal(err)
+	}
+	lease, err := rt.AcquireDataRootLease(root)
+	if err != nil {
+		t.Fatalf("business root lease under fence: %v", err)
+	}
+	defer func() {
+		if err := lease.Close(); err != nil {
+			t.Errorf("business lease close: %v", err)
+		}
+	}()
+	if !lease.Held() {
+		t.Fatal("business root lease not held")
+	}
+	dbPath := filepath.Join(root, "researchos.sqlite")
+	db, err := sql.Open("sqlite", dbPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	var mode string
+	if err = db.QueryRow(`PRAGMA journal_mode=WAL`).Scan(&mode); err != nil || strings.ToLower(mode) != "wal" {
+		t.Fatalf("business WAL unavailable: %q %v", mode, err)
+	}
+	if _, err = db.Exec(`CREATE TABLE fixture (id INTEGER PRIMARY KEY, value TEXT NOT NULL)`); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = db.Exec(`INSERT INTO fixture(value) VALUES ('fence-compatible')`); err != nil {
+		t.Fatal(err)
+	}
+	var got string
+	if err = db.QueryRow(`SELECT value FROM fixture WHERE id=1`).Scan(&got); err != nil || got != "fence-compatible" {
+		t.Fatalf("business SQLite read under fence: %q %v", got, err)
+	}
+	if _, err = os.Stat(dbPath + "-wal"); err != nil {
+		t.Fatalf("business WAL file missing while DB open: %v", err)
+	}
+	t.Log("business data-root lease held; SQLite read/write and WAL file remained usable under executable fence")
+}
+
+func TestOpaqueTokenZeroAndPhaseFailClosed(t *testing.T) {
+	var q CurrentQuiescence
+	if err := q.Check(context.Background(), nil, "", "", "", ""); err == nil {
+		t.Fatal("zero token checked")
+	}
+	if err := q.Close(); err == nil {
+		t.Fatal("zero token closed as valid")
+	}
+	if _, err := OpenCurrentQuiescence(context.Background(), nil, "", "", "", ""); err == nil {
+		t.Fatal("nil lease opened token")
+	}
+	if _, err := RunPhase(context.Background(), "server", "C:\\fixture", "0123456789abcdef0123456789abcdef", strings.Repeat("a", 64)); err == nil {
+		t.Fatal("ordinary server mode accepted")
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if _, err := RunPhase(ctx, "status", "C:\\fixture", "0123456789abcdef0123456789abcdef", strings.Repeat("a", 64)); !errors.Is(err, context.Canceled) {
+		t.Fatalf("canceled phase: %v", err)
+	}
+}
+
+func TestRetainedOSAncestorEffectiveACE(t *testing.T) {
+	const rootSD = "O:SYG:SYD:(A;OICIIO;SDGXGWGR;;;AU)(A;;0x1301bf;;;AU)(A;;FA;;;SY)(A;OICIIO;GA;;;SY)(A;OICIIO;GA;;;BA)(A;;FA;;;BA)(A;;0x1200a9;;;BU)(A;OICIIO;GXGR;;;BU)"
+	root := FileIdentity{Path: `D:\`, SecurityDescriptor: rootSD}
+	p := EntryFencePlan{BusinessSID: "S-1-5-21-1-2-3-1001", ManagementSID: "S-1-5-21-1-2-3-1002", Ancestors: []FileIdentity{root}}
+	holds := []nativeHold{{path: root.Path, identity: root}}
+	medium := map[string]bool{p.BusinessSID: true, "S-1-5-11": true, "S-1-5-32-545": true} // BA is deny-only in the observed Medium token.
+	if err := checkAncestorACL(p, holds, medium); err != nil {
+		t.Fatalf("retained D root with effective AU read/modify and deny-only BA: %v", err)
+	}
+	medium["S-1-5-32-544"] = true
+	if err := checkAncestorACL(p, holds, medium); err == nil {
+		t.Fatal("BA enabled token accepted BA FullControl ancestor")
+	}
+	delete(medium, "S-1-5-32-544")
+	bad := root
+	bad.SecurityDescriptor = "O:SYG:SYD:(A;;FA;;;SY)(A;;FA;;;AU)"
+	if err := checkAncestorACL(p, []nativeHold{{path: root.Path, identity: bad}}, medium); err == nil {
+		t.Fatal("business effective FullControl on OS root accepted")
+	}
+	bad.SecurityDescriptor = "O:SYG:SYD:(A;;FA;;;SY)(A;OICIIO;FA;;;AU)"
+	if err := checkAncestorACL(p, []nativeHold{{path: root.Path, identity: bad}}, medium); err != nil {
+		t.Fatalf("inherit-only business grant incorrectly treated as effective on root: %v", err)
+	}
+	product := FileIdentity{Path: `D:\product`, SecurityDescriptor: "O:SYG:SYD:(A;;FA;;;SY)(A;;0x40;;;AU)"}
+	p.Ancestors = []FileIdentity{product}
+	if err := checkAncestorACL(p, []nativeHold{{path: product.Path, identity: product}}, medium); err == nil {
+		t.Fatal("business FILE_DELETE_CHILD on product ancestor accepted")
+	}
+	product.SecurityDescriptor = "O:AUG:SYD:(A;;FA;;;SY)"
+	if err := checkAncestorACL(p, []nativeHold{{path: product.Path, identity: product}}, medium); err == nil {
+		t.Fatal("business-owned product ancestor accepted")
+	}
+}
+
+func TestLiveBusinessTokenGroupCapture(t *testing.T) {
+	token := windows.GetCurrentProcessToken()
+	user, err := token.GetTokenUser()
+	if err != nil {
+		t.Fatal(err)
+	}
+	groups, err := token.GetTokenGroups()
+	if err != nil {
+		t.Fatal(err)
+	}
+	var enabled []string
+	for _, group := range groups.AllGroups() {
+		if group.Attributes&windows.SE_GROUP_ENABLED != 0 && group.Attributes&(windows.SE_GROUP_USE_FOR_DENY_ONLY|windows.SE_GROUP_LOGON_ID|windows.SE_GROUP_INTEGRITY) == 0 {
+			enabled = append(enabled, group.Sid.String())
+		}
+	}
+	exe, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	p := EntryFencePlan{BusinessSID: user.User.Sid.String(), BusinessGroupSIDs: enabled, Targets: []FenceTarget{{File: FileIdentity{Path: exe}, Mode: "executable"}}}
+	sha, err := businessEnabledGroupDigest(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = inspectLiveBusinessToken(p, sha); err != nil {
+		t.Fatalf("native business token group capture: %v", err)
+	}
+	p.BusinessGroupSIDs = []string{"S-1-5-32-544"}
+	sha, _ = businessEnabledGroupDigest(p)
+	if err := inspectLiveBusinessToken(p, sha); err == nil {
+		t.Fatal("frozen business group claim accepted without matching live token")
+	}
+}
+
+func TestBusinessTokenPermissionSemanticsAcrossRestart(t *testing.T) {
+	pre := BootWitness{BusinessSessionID: 3, BusinessElevationType: 3, BusinessIntegritySID: "S-1-16-8192", BusinessLogonSID: "S-1-5-5-1-2", BusinessPrivilegesSHA256: strings.Repeat("a", 64)}
+	current := businessTokenShape{SessionID: 9, ElevationType: 3, IntegritySID: pre.BusinessIntegritySID, LogonSID: "S-1-5-5-9-10", PrivilegesSHA256: pre.BusinessPrivilegesSHA256, GroupsSHA256: strings.Repeat("b", 64)}
+	if err := sameBusinessPermissionSemantics(pre, current, current.GroupsSHA256); err != nil {
+		t.Fatalf("fresh session/logon identity should keep same permission semantics: %v", err)
+	}
+	current.ElevationType = 2
+	if err := sameBusinessPermissionSemantics(pre, current, current.GroupsSHA256); err == nil {
+		t.Fatal("elevation change accepted")
+	}
+	current.ElevationType = pre.BusinessElevationType
+	current.ProcessID = 555
+	current.ProcessCreated = time.Date(2026, 10, 25, 7, 1, 0, 0, time.UTC)
+	current.ProcessImageSHA = strings.Repeat("c", 64)
+	post := BootWitness{BusinessEnabledSIDsSHA256: current.GroupsSHA256, BusinessSessionID: current.SessionID, BusinessLogonSID: current.LogonSID, BusinessProcessPID: current.ProcessID, BusinessProcessCreatedUTC: current.ProcessCreated, BusinessProcessImageSHA256: current.ProcessImageSHA}
+	if err := sameCurrentProcessWitness(post, current); err != nil {
+		t.Fatalf("current process witness did not bind exact source: %v", err)
+	}
+	current.ProcessID++
+	if err := sameCurrentProcessWitness(post, current); err == nil {
+		t.Fatal("replacement process accepted as same post witness")
+	}
+}
+
+func TestExistingBusinessExplorerTokenNativeProbe(t *testing.T) {
+	token := windows.GetCurrentProcessToken()
+	user, err := token.GetTokenUser()
+	if err != nil {
+		t.Fatal(err)
+	}
+	p := EntryFencePlan{BusinessSID: user.User.Sid.String()}
+	shape, err := tokenSecurityShape(token, windows.GetCurrentProcessId(), p.BusinessSID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	pre := BootWitness{BusinessSessionID: shape.SessionID, BusinessElevationType: shape.ElevationType, BusinessIntegritySID: shape.IntegritySID, BusinessLogonSID: shape.LogonSID, BusinessPrivilegesSHA256: shape.PrivilegesSHA256}
+	actual, err := inspectExistingBusinessProcess(p, shape.GroupsSHA256, pre)
+	if err != nil {
+		t.Fatalf("native Explorer TOKEN_QUERY boundary unavailable: %v", err)
+	}
+	t.Logf("native existing business Explorer token verified: current session=%d, elevation=%d, integrity=%s, logon SID present=%t", actual.SessionID, actual.ElevationType, actual.IntegritySID, actual.LogonSID != "")
+}
