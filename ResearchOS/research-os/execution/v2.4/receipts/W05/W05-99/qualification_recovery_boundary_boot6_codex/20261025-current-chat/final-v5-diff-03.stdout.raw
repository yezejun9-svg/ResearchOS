+func TestSameHandleDescriptorMutationRejectsStaleExpected(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "stale-entry.exe")
+	if err := os.WriteFile(path, []byte("fixture"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	h, err := openNative(path, false, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer windows.CloseHandle(h.handle)
+	u, err := windows.GetCurrentProcessToken().GetTokenUser()
+	if err != nil {
+		t.Fatal(err)
+	}
+	installed, err := denyDescriptor(h.identity.SecurityDescriptor, u.User.Sid.String(), u.User.Sid.String(), "executable")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = setTargetDescriptor(h.identity, installed); err != nil {
+		t.Fatal(err)
+	}
+	if err = setTargetDescriptor(withFixtureSD(h.identity, installed), h.identity.SecurityDescriptor); err != nil {
+		t.Fatal(err)
+	}
+	if err = setTargetDescriptor(withFixtureSD(h.identity, installed), h.identity.SecurityDescriptor); err == nil {
+		t.Fatal("stale installed descriptor overwrote changed target")
+	}
+	fresh, err := openNative(path, false, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !identityEqual(h.identity, fresh.identity) {
+		t.Error("stale attempt changed restored target")
+	}
+	if err = windows.CloseHandle(fresh.handle); err != nil {
+		t.Fatal(err)
+	}
+}
