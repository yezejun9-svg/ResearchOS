84: // This smoke uses production Host registration, domain workspace/project/session
85: // creation, and the compiled ops/backup CLI. The chooser callback supplies a
86: // temporary test path; it is not evidence that a human clicked the Windows UI.
87: func TestW1802ProductionBackupCLIWorkspaceContinuation(t *testing.T) {
88: 	ctx := context.Background()
89: 	repo := backupTestRepo(t)
90: 	root := t.TempDir()
91: 	sourceData := filepath.Join(root, "source-data")
92: 	workspace := filepath.Join(root, "chosen-workspace")
93: 	if err := os.MkdirAll(filepath.Join(workspace, "src"), 0700); err != nil {
94: 		t.Fatal(err)
95: 	}
96: 	if err := os.Mkdir(filepath.Join(workspace, "empty"), 0700); err != nil {
97: 		t.Fatal(err)
98: 	}
99: 	if err := os.WriteFile(filepath.Join(workspace, "src", "main.go"), []byte("package continued\n"), 0600); err != nil {
100: 		t.Fatal(err)
101: 	}
102: 	if err := os.MkdirAll(sourceData, 0700); err != nil {
103: 		t.Fatal(err)
104: 	}
105: 	db, err := store.Open(filepath.Join(sourceData, "researchos.sqlite"))
106: 	if err != nil {
107: 		t.Fatal(err)
108: 	}
109: 	if err := store.Bootstrap(ctx, db, filepath.Join(repo, "migrations", "sqlite", "0001_bootstrap.sql")); err != nil {
110: 		t.Fatal(err)
111: 	}
112: 	svc, err := domain.New(db, filepath.Join(repo, "spec", "v2.0", "contracts"), filepath.Join(repo, "migrations", "sqlite", "0002_domain.sql"))
113: 	if err != nil {
114: 		t.Fatal(err)
115: 	}
116: 	h := backupTestHost(t, db, sourceData, repo)
117: 	owner, err := h.BootstrapOwner(ctx)
118: 	if err != nil {
119: 		t.Fatal(err)
120: 	}
121: 	credentialRef, err := h.ImportCredential("fixture-provider", "API_KEY", "synthetic-private-value", "")
122: 	if err != nil || h.CredentialStatus(credentialRef) != host.StatusAvailable {
123: 		t.Fatalf("source host credential fixture unavailable: %v", err)
124: 	}
125: 	frame, err := json.Marshal(map[string]any{"kind": host.KindWorkspaceChooseRequest,
126: 		"client_id": "backup-smoke-cli", "payload": map[string]any{"requested_path": workspace, "requested_access": host.AccessReadWrite}})
127: 	if err != nil {
128: 		t.Fatal(err)
129: 	}
130: 	reply, err := h.HandleNative(frame, true, func(string) (string, error) { return workspace, nil })
131: 	if err != nil {
132: 		t.Fatal(err)
133: 	}
134: 	var chosen struct {
135: 		Payload struct {
136: 			Ref string `json:"selection_ref"`
137: 		} `json:"payload"`
138: 	}
139: 	if err := json.Unmarshal(reply, &chosen); err != nil || chosen.Payload.Ref == "" {
140: 		t.Fatalf("native selection failed: %v", err)
141: 	}
142: 	doc, err := api.ClientProtocolDocument()
143: 	if err != nil {
144: 		t.Fatal(err)
145: 	}
146: 	principal := domain.Principal{ID: owner.PrincipalID, Roles: []string{"OWNER"}, CanCreateProject: true}
147: 	authority := localworkspace.NewAuthority(h)
148: 	registered, err := svc.RegisterWorkspace(ctx, principal, authority, doc, domain.RegisterWorkspaceInput{
149: 		SelectionRef: chosen.Payload.Ref, DisplayName: "continued workspace", RequestedAccess: host.AccessReadWrite,
150: 		ClientID: "backup-smoke-cli", CommandID: "backup-smoke-register"})
151: 	if err != nil {
152: 		t.Fatal(err)
153: 	}
154: 	ref := domain.Str(registered, "authorized_workspace_ref")
155: 	project, err := svc.BootstrapProject(ctx, principal, authority, doc, localworkspace.NewScanner(), domain.BootstrapProjectInput{
156: 		AuthorizedWorkspaceRef: ref, DisplayName: "continued project", ClientID: "backup-smoke-cli",
157: 		CommandID: "backup-smoke-project", MeasurementMode: "FIXTURE"})
158: 	if err != nil {
159: 		t.Fatal(err)
160: 	}
161: 	projectID := domain.Str(project, "project_id")
162: 	if projectID == "" || ref == "" {
163: 		t.Fatal("production project or authorized workspace identity missing")
164: 	}
165: 	projectPath := "/v1/projects/" + projectID
166: 	_, stateTag := backupHTTP(t, svc, owner.Session.Token, "GET", projectPath+"/state", nil, "", 200)
167: 	requirement, requirementTag := backupHTTP(t, svc, owner.Session.Token, "POST", projectPath+"/requirements",
168: 		domain.Object{"requirement_key": "W18-BACKUP", "text": "continue the same work after restore", "basis": "USER_STATED",
169: 			"source_refs": domain.Empty(), "rationale": "fixture continuation", "supersedes_id": nil, "acceptance_check_ids": domain.Empty()}, stateTag, 201)
170: 	requirement, _ = backupHTTP(t, svc, owner.Session.Token, "POST", projectPath+"/requirements/"+domain.Str(requirement, "id")+"/actions",
171: 		domain.Object{"action": "ACCEPT", "reason": "fixture continuation", "source_validation_refs": domain.Empty()}, requirementTag, 200)
172: 	_, stateTag = backupHTTP(t, svc, owner.Session.Token, "GET", projectPath+"/state", nil, "", 200)
173: 	contract := domain.Object{"contract_hash": domain.Digest([]byte("backup-smoke-contract")), "contract_revision": 1,
174: 		"checks": []any{domain.Object{"check_id": "backup-continue", "kind": "DETERMINISTIC", "required": true,
175: 			"expected": "same pending task", "command_key": "test.backup", "rubric_ref": nil, "qualification_id": nil, "not_applicable_reason": nil}},
176: 		"require_independent_verifier": true, "version_policy": "EXACT", "frozen_at": domain.Now()}
177: 	goal, goalTag := backupHTTP(t, svc, owner.Session.Token, "POST", projectPath+"/goals",
178: 		domain.Object{"title": "continue backup task", "original_intent": "preserve next step", "scope": "PROJECT",
179: 			"requirement_refs": []any{domain.Ref(requirement, "Requirement")}, "problem_ids": []any{"backup-source"},
180: 			"deliverables": []any{"same pending task"}, "acceptance_contract": contract}, stateTag, 201)
=== internal/host/host.go ===
185: 
186: // Identity exposes the verified OS principal reference (never the raw SID).
187: func (h *Host) Identity() auth.Identity { return h.identity }
188: 
189: // InstanceID is a stable local host identifier for handshake responses; it is derived from
190: // the private directory path plus the principal reference, so it changes if either does.
191: func (h *Host) InstanceID() string {
192: 	sum := sha256.Sum256([]byte(h.dir + "|" + h.identity.Ref))
193: 	return "host-" + hex.EncodeToString(sum[:6])
194: }
195: 
196: // writePrivate stores a file with 0600 plus the current-user-only DACL and a durable rename,
197: // so a crash cannot leave a half-written credential or root registry.
198: func writePrivate(dir, name string, payload any) error {
199: 	raw, err := json.MarshalIndent(payload, "", "  ")
200: 	if err != nil {
201: 		return err
202: 	}
203: 	tmp, err := os.CreateTemp(dir, name+".tmp-")
204: 	if err != nil {
205: 		return err
206: 	}
207: 	defer os.Remove(tmp.Name())
208: 	if err := tmp.Chmod(0o600); err != nil {
209: 		tmp.Close()
210: 		return err
211: 	}
212: 	if _, err := tmp.Write(raw); err != nil {
213: 		tmp.Close()
214: 		return err
215: 	}
216: 	if err := tmp.Sync(); err != nil {
217: 		tmp.Close()
218: 		return err
219: 	}
220: 	if err := tmp.Close(); err != nil {
221: 		return err
222: 	}
223: 	if err := privateFile(tmp.Name()); err != nil {
224: 		return err
225: 	}
226: 	return os.Rename(tmp.Name(), filepath.Join(dir, name))
227: }
228: 
229: func readPrivate(dir, name string, into any) error {
230: 	raw, err := os.ReadFile(filepath.Join(dir, name))
231: 	if err != nil {
232: 		if errors.Is(err, os.ErrNotExist) {
233: 			return nil
234: 		}
235: 		return err
236: 	}
237: 	return json.Unmarshal(raw, into)
238: }
