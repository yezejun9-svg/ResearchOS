26: 
27: func backupCLI(t *testing.T, binary, repo string, args ...string) ([]byte, error) {
28: 	t.Helper()
29: 	cmd := exec.Command(binary, args...)
30: 	cmd.Dir = repo
31: 	return cmd.CombinedOutput()
32: }
33: 
34: func backupTestRepo(t *testing.T) string {
35: 	t.Helper()
36: 	root, err := filepath.Abs(filepath.Join("..", ".."))
37: 	if err != nil {
38: 		t.Fatal(err)
39: 	}
40: 	return root
41: }
42: 
43: func backupTestHost(t *testing.T, db *sql.DB, dataRoot, repo string) *host.Host {
44: 	t.Helper()
45: 	h, err := host.New(host.Config{DB: db, Dir: filepath.Join(dataRoot, "host"),
46: 		ContractsDir:  filepath.Join(repo, "spec", "v2.0", "contracts"),
47: 		MigrationFile: filepath.Join(repo, "migrations", "sqlite", "0002_domain.sql"),
48: 		SchemaDir:     filepath.Join(repo, "internal", "api", "contracts")})
49: 	if err != nil {
50: 		t.Fatal(err)
51: 	}
52: 	return h
53: }
54: 
55: func backupHTTP(t *testing.T, svc *domain.Service, token, method, path string, body any, etag string, want int) (domain.Object, string) {
56: 	t.Helper()
57: 	var raw []byte
58: 	if body != nil {
59: 		raw = domain.Bytes(body)
60: 	}
61: 	request := httptest.NewRequest(method, path, strings.NewReader(string(raw)))
62: 	request.Header.Set("Authorization", "Bearer "+token)
63: 	if body != nil {
64: 		request.Header.Set("Content-Type", "application/json")
65: 	}
66: 	if method != http.MethodGet {
67: 		request.Header.Set("Idempotency-Key", domain.ID())
68: 	}
69: 	if etag != "" {
70: 		request.Header.Set("If-Match", etag)
71: 	}
72: 	response := httptest.NewRecorder()
73: 	svc.Handler().ServeHTTP(response, request)
74: 	if response.Code != want {
75: 		t.Fatalf("%s %s expected %d, got %d: %s", method, path, want, response.Code, response.Body.String())
76: 	}
77: 	var value domain.Object
78: 	if err := json.Unmarshal(response.Body.Bytes(), &value); err != nil {
79: 		t.Fatal(err)
80: 	}
81: 	return value, response.Header().Get("ETag")
82: }
