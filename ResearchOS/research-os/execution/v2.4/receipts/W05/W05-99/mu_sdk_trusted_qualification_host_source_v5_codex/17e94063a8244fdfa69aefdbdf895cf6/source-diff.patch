+// readPinnedOwnedJobObject permits one lossless FILETIME integer in pinned
+// owned-Job evidence. Every other number retains domain.Decode's safety check.
+func readPinnedOwnedJobObject(p pinnedFile) (domain.Object, error) {
+	raw, err := verifiedBytes(p)
+	if err != nil {
+		return nil, err
+	}
+	// Validate original syntax, Unicode, duplicate keys, and the full document.
+	// Canonical bytes are intentionally discarded: JCS rounds this FILETIME.
+	if _, err = canonical.JSON(raw); err != nil {
+		return nil, err
+	}
+	decoder := json.NewDecoder(bytes.NewReader(raw))
+	decoder.UseNumber()
+	var obj domain.Object
+	if err = decoder.Decode(&obj); err != nil {
+		return nil, err
+	}
+	if obj == nil {
+		return nil, errors.New("owned Host Job evidence must be an object")
+	}
+	schema, ok := obj["schema"].(string)
+	if !ok || (schema != "researchos.mu-trial-host-job.v1" && schema != "researchos.mu-trial-host-job-probe.v1") {
+		return nil, errors.New("unknown owned Host Job evidence schema")
+	}
+	held, ok := obj["held_identity"].(map[string]any)
+	if !ok {
+		return nil, errors.New("owned Host Job held identity missing")
+	}
+	filetime, ok := held["creation_time_100ns"].(json.Number)
+	if !ok {
+		return nil, errors.New("owned Host Job FILETIME must be a JSON number")
+	}
+	literal := filetime.String()
+	if len(literal) == 0 || literal[0] < '1' || literal[0] > '9' {
+		return nil, errors.New("owned Host Job FILETIME must be a positive decimal uint64 integer")
+	}
+	for i := 1; i < len(literal); i++ {
+		if literal[i] < '0' || literal[i] > '9' {
+			return nil, errors.New("owned Host Job FILETIME must be a positive decimal uint64 integer")
+		}
+	}
+	parsed, err := strconv.ParseUint(literal, 10, 64)
+	if err != nil {
+		return nil, errors.New("owned Host Job FILETIME exceeds uint64")
+	}
+	held["creation_time_100ns"] = strconv.FormatUint(parsed, 10)
+	normalized, err := json.Marshal(obj)
+	if err != nil {
+		return nil, err
+	}
+	return domain.Decode(normalized)
+}
