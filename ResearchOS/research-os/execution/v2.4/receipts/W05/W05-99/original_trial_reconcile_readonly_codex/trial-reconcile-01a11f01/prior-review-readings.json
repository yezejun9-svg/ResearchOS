      "decision": "CUSTOM_GAP_NO_EXISTING_TERMINAL_PREDISPATCH_API",
      "formal": false,
      "execution_authority": false,
      "scope": "Read-only domain/API/migration/schema source inspection; no live database, private state, Native, provider, Source or Main changes. Root-reported current state is not independently attested here.",
      "reported_live_tuple": {
        "run_id": "7d5bc49c4951a20d0f5b3c9c344b8b45",
        "run_status": "QUEUED",
        "epoch": 1,
        "task_id": "e0e1efbb8acd7fd8c3d0dc3a6895ddfc",
