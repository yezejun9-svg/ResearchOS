+// clientAttachRestoreTime compares instants in UTC, never RFC3339Nano text.
+// A malformed timestamp has unknown order and cannot be ignored as an old fact.
+func clientAttachRestoreTime(value string) (time.Time, bool) {
+	parsed, err := time.Parse(time.RFC3339Nano, value)
+	if err != nil || parsed.IsZero() {
+		return time.Time{}, false
+	}
+	return parsed.UTC(), true
+}
+
+type clientAttachObservationOrder struct {
+	latest time.Time
+	seen, valid bool
+}
+
+func (order *clientAttachObservationOrder) add(observed time.Time, valid bool) {
+	if !order.seen || observed.After(order.latest) {
+		order.latest, order.seen, order.valid = observed, true, valid
+	} else if observed.Equal(order.latest) {
+		// Equal instants do not establish an ordering between conflicting facts.
+		// Every fact at the latest instant must be settled and correctly bound.
+		order.valid = order.valid && valid
+	}
+}
