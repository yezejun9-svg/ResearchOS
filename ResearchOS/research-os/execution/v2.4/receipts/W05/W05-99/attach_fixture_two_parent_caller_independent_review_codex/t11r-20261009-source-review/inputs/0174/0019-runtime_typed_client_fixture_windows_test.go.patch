+// This fixture is for ordinary (not restored) synchronous attach. It neither
+// manufactures settlement nor converts an ACK/read-only response to completion.
+func typedRuntimeFixtureAttachTransition(before, after typedRuntimeFixtureSnapshot, client string, started, finished time.Time) (bool, error) {
+	if before.Writer == nil || after.Writer == nil || client == "" || finished.Before(started) ||
+		before.ProjectID != after.ProjectID || before.SessionID != after.SessionID ||
+		before.WorkspaceRef != after.WorkspaceRef || before.ModelConfigRef != after.ModelConfigRef ||
+		before.NativeSessionRef != after.NativeSessionRef || before.CoreBuildID != after.CoreBuildID ||
+		before.ProtocolVersion != ProtocolV2 || after.ProtocolVersion != ProtocolV2 ||
+		before.Revision < 1 || after.Revision < 1 || before.Writer.Epoch < 1 || after.Writer.Epoch < 1 ||
+		before.EventSequence < 0 || after.EventSequence < 0 || before.Preserved == "" || before.Preserved != after.Preserved ||
+		after.Writer.ClientID != client {
+		return false, fmt.Errorf("attach changed fixture identity or protected snapshot state")
+	}
+	oldExpiry, oldErr := time.Parse(time.RFC3339Nano, before.Writer.ExpiresAt)
+	newExpiry, newErr := time.Parse(time.RFC3339Nano, after.Writer.ExpiresAt)
+	if oldErr != nil || newErr != nil || !newExpiry.After(finished) {
+		return false, fmt.Errorf("attach writer lease is not valid")
+	}
+	if after.Writer.Epoch == before.Writer.Epoch {
+		if before.Writer.ClientID != client || !started.Before(oldExpiry) ||
+			after.Revision != before.Revision || after.EventSequence != before.EventSequence {
+			return false, fmt.Errorf("lease renewal changed generation or used an expired owner")
+		}
+		return false, nil
+	}
+	if after.Writer.Epoch-before.Writer.Epoch != 1 || after.Revision-before.Revision != 2 ||
+		after.EventSequence-before.EventSequence != 1 ||
+		(before.Writer.ClientID == client && finished.Before(oldExpiry)) {
+		return false, fmt.Errorf("attach did not perform one permitted synchronous transfer")
+	}
+	return true, nil
+}
