+func TestTypedRuntimeFixtureAttachTransitionUsesExactGeneration(t *testing.T) {
+	now := time.Now().UTC()
+	before := typedRuntimeFixtureSnapshot{ProjectID:"project",SessionID:"session",WorkspaceRef:"workspace",
+		ModelConfigRef:"model",NativeSessionRef:"native",CoreBuildID:"core",ProtocolVersion:ProtocolV2,
+		Revision:int64(9007199254741007),EventSequence:int64(9007199254741013),Preserved:"unchanged-snapshot",
+		Writer:&typedRuntimeFixtureWriter{ClientID:"owner",Epoch:int64(9007199254740993),ExpiresAt:now.Add(time.Hour).Format(time.RFC3339Nano)}}
+	copySnapshot := func(value typedRuntimeFixtureSnapshot) typedRuntimeFixtureSnapshot {
+		writer := *value.Writer
+		value.Writer = &writer
+		return value
+	}
+	renewed := copySnapshot(before)
+	if transferred, err := typedRuntimeFixtureAttachTransition(before, renewed, "owner", now, now); err != nil || transferred {
+		t.Fatalf("exact int64 renewal tuple refused: %v %v", transferred, err)
+	}
+	moved := copySnapshot(before)
+	moved.Writer.ClientID = "new-owner"
+	moved.Writer.Epoch++
+	moved.Revision += 2
+	moved.EventSequence++
+	if transferred, err := typedRuntimeFixtureAttachTransition(before, moved, "new-owner", now, now); err != nil || !transferred {
+		t.Fatalf("one-transfer tuple refused: %v %v", transferred, err)
+	}
+	expired := copySnapshot(before)
+	expired.Writer.ExpiresAt = now.Add(-time.Minute).Format(time.RFC3339Nano)
+	reacquired := copySnapshot(moved)
+	reacquired.Writer.ClientID = "owner"
+	if transferred, err := typedRuntimeFixtureAttachTransition(expired, reacquired, "owner", now, now); err != nil || !transferred {
+		t.Fatalf("expired-owner reacquisition tuple refused: %v %v", transferred, err)
+	}
+	for _, mode := range []string{"stale-revision","stale-epoch","missing-journal","double-generation","same-owner-live-transfer","expired-owner-no-transfer","changed-protected-state"} {
+		t.Run(mode, func(t *testing.T) {
+			old, after, client := copySnapshot(before), copySnapshot(moved), "new-owner"
+			switch mode {
+			case "stale-revision": after.Revision = before.Revision
+			case "stale-epoch": after.Writer.Epoch = before.Writer.Epoch
+			case "missing-journal": after.EventSequence = before.EventSequence
+			case "double-generation": after.Writer.Epoch++
+			case "same-owner-live-transfer": after.Writer.ClientID, client = "owner", "owner"
+			case "expired-owner-no-transfer": old, after, client = copySnapshot(expired), copySnapshot(renewed), "owner"
+			case "changed-protected-state": after.Preserved = "changed-resume-or-queue-state"
+			}
+			if _, err := typedRuntimeFixtureAttachTransition(old, after, client, now, now); err == nil {
+				t.Fatalf("%s accepted a stale or fabricated generation tuple", mode)
+			}
+		})
+	}
+}
