+// The production schema validates the complete snapshot before this typed
+// projection. JSON -> int64 preserves integer values without a float64 cast.
+func typedRuntimeFixtureSnapshotBinding(doc *SchemaDoc, raw map[string]any) (typedRuntimeFixtureSnapshot, error) {
+	var snapshot typedRuntimeFixtureSnapshot
+	if doc == nil {
+		return snapshot, fmt.Errorf("typed snapshot schema required")
+	}
+	if err := doc.ValidateDef("SessionSnapshot", normalizeNumbers(raw)); err != nil {
+		return snapshot, err
+	}
+	encoded, err := json.Marshal(raw)
+	if err != nil {
+		return snapshot, err
+	}
+	if err = json.Unmarshal(encoded, &snapshot); err != nil {
+		return snapshot, err
+	}
+	if snapshot.ProjectID == "" || snapshot.SessionID == "" || snapshot.WorkspaceRef == "" ||
+		snapshot.ModelConfigRef == "" || snapshot.NativeSessionRef == "" || snapshot.CoreBuildID == "" ||
+		snapshot.ProtocolVersion != ProtocolV2 || snapshot.Revision < 1 || snapshot.EventSequence < 0 ||
+		(snapshot.Writer != nil && (snapshot.Writer.ClientID == "" || snapshot.Writer.Epoch < 1)) {
+		return snapshot, fmt.Errorf("typed snapshot binding incomplete")
+	}
+	var preserved map[string]json.RawMessage
+	if err = json.Unmarshal(encoded, &preserved); err != nil {
+		return snapshot, err
+	}
+	// These are the only snapshot fields that a synchronous ownership change
+	// may alter. Goal/run/queue/resume flags and all identity bindings remain.
+	for _, name := range []string{"revision", "writer", "event_sequence", "updated_at"} {
+		delete(preserved, name)
+	}
+	snapshot.Preserved = Digest(Bytes(preserved))
+	return snapshot, nil
+}
