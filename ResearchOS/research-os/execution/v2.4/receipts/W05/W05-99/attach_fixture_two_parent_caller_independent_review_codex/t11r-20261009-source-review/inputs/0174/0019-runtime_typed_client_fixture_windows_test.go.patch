+// These additional fixture checks use ordinary typed transaction fixtures or
+// pure binding tuples. They grant no native or restored-positive authority.
+func TestTypedRuntimeFixtureAttachRejectsAlteredTerminal(t *testing.T) {
+	f := contextFixture(t)
+	client := "typed-binding-client"
+	service, sid, _ := handlerTypedSession(t, f, client)
+	_, before := typedRuntimeFixtureReadSnapshot(t, f, service, sid, client)
+	env := &Envelope{ProtocolVersion: strptr(ProtocolV2), CommandID: strptr(ID()), ClientID: &client,
+		ProjectID: &f.project, SessionID: &sid, ExpectedRevision: revPtr(before.Revision),
+		Method: strptr("session.attach"), Payload: Bytes(Object{"request_write_owner": true, "after_sequence": before.EventSequence})}
+	started := time.Now().UTC()
+	real := muClientCall(t, f, service, env)
+	finished := time.Now().UTC()
+	binding, err := typedRuntimeFixtureAttachSnapshot(service.Doc, env, real)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if transfer, err := typedRuntimeFixtureAttachTransition(before, binding, client, started, finished); err != nil || transfer {
+		t.Fatalf("ordinary actual lease renewal rejected: transfer=%v err=%v", transfer, err)
+	}
+	for _, mode := range []string{"ack", "readonly", "wrong-command", "wrong-method", "wrong-project", "wrong-session",
+		"wrong-owner", "wrong-revision", "unknown-result", "unknown-snapshot", "invalid-lease", "expired-lease",
+		"wrong-native", "wrong-workspace", "wrong-model", "epoch-jump", "missing-writer"} {
+		t.Run(mode, func(t *testing.T) {
+			var altered Response
+			if err := json.Unmarshal(Bytes(real), &altered); err != nil { t.Fatal(err) }
+			snapshot := altered.Result["snapshot"].(map[string]any)
+			writer := snapshot["writer"].(map[string]any)
+			switch mode {
+			case "ack": altered.Status = strptr("ACKNOWLEDGED")
+			case "readonly": altered.Result["write_owner_acquired"] = false
+			case "wrong-command": altered.CommandID = strptr(ID())
+			case "wrong-method": altered.Method = strptr("session.get")
+			case "wrong-project": snapshot["project_id"] = ID()
+			case "wrong-session": snapshot["session_id"] = ID()
+			case "wrong-owner": writer["client_id"] = "other-client"
+			case "wrong-revision": altered.Revision = revPtr(*real.Revision + 1)
+			case "unknown-result": altered.Result["unpublished"] = true
+			case "unknown-snapshot": snapshot["unpublished"] = true
+			case "invalid-lease": writer["expires_at"] = "unknown"
+			case "expired-lease": writer["expires_at"] = started.Add(-time.Minute).Format(time.RFC3339Nano)
+			case "wrong-native": snapshot["native_session_ref"] = ID()
+			case "wrong-workspace": snapshot["workspace_ref"] = "other-workspace"
+			case "wrong-model": snapshot["model_config_ref"] = "other-model"
+			case "epoch-jump": writer["epoch"] = before.Writer.Epoch + 2
+			case "missing-writer": snapshot["writer"] = nil
+			}
+			rebound, err := typedRuntimeFixtureAttachSnapshot(service.Doc, env, &altered)
+			if err == nil {
+				_, err = typedRuntimeFixtureAttachTransition(before, rebound, client, started, finished)
+			}
+			if err == nil { t.Fatalf("%s weakened original attach completion or binding", mode) }
+		})
+	}
+}
