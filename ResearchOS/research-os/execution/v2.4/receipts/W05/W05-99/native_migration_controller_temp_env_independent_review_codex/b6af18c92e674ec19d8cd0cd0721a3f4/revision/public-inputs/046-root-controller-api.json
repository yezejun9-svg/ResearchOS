{
  "schema": "researchos.root-native-controller-api.v1",
  "api": {
    "serve": [
      "config_ref"
    ],
    "poll": [
      "config_ref",
      "timeout"
    ],
    "snapshot": [
      "config_ref"
    ],
    "sign_reviewed": [
      "config_ref",
      "approval_ref",
      "issuer_dpapi_path_runtime"
    ],
    "publish_signed": [
      "config_ref",
      "approval_ref"
    ],
    "release_fixture": [
      "config_ref",
      "approval_ref"
    ],
    "stop": [
      "config_ref"
    ]
  },
  "public_ref_shape": {
    "path": "absolute canonical public path",
    "sha256": "sha256:<64hex>",
    "bytes": "integer"
  },
  "issuer_dpapi_path": "runtime sign_reviewed argument only; never configured, saved or printed",
  "state_sequence": [
    "serve-start",
    "release snapshot",
    "Root sign approval",
    "sign_reviewed",
    "Root signed-document review approval",
    "publish_signed",
    "grant snapshot",
    "Root sign approval",
    "sign_reviewed",
    "Root signed-document review approval",
    "publish_signed",
    "fixture-retained snapshot",
    "Root actual fixture inspection",
    "release_fixture",
    "owned Job and guard closure"
  ],
  "automatic_signing": false,
  "automatic_approval": false,
  "nine_case_loop": false
}