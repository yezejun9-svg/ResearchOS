    "source": {
      "path": "snapshot/internal/domain/client_protocol_configuration.go",
      "sha256": "2139047fe178c93cd96061ff5182724616ae84ef4094230a9f3a30c42101f933",
      "bytes": 43661
    },
    "start_line": 1004,
    "end_line": 1114,
    "lines": [
      {
        "line": 1004,
        "text": "func (s *ClientService) configurationSettled(ctx context.Context, tx *sql.Tx, env *Envelope, principal string, sess *clientSessionRow) error {"
      },
      {
        "line": 1005,
        "text": "\tvar lease string"
      },
      {
        "line": 1006,
        "text": "\tif e := tx.QueryRowContext(ctx, `SELECT COALESCE(lease_expires_at,'') FROM client_sessions WHERE id=?`, sess.sessionID).Scan(&lease); e != nil {"
      },
      {
        "line": 1007,
        "text": "\t\treturn e"
      },
      {
        "line": 1008,
        "text": "\t}"
      },
      {
        "line": 1009,
        "text": "\tuntil, e := time.Parse(time.RFC3339Nano, lease)"
      },
      {
        "line": 1010,
        "text": "\tif e != nil || !until.After(time.Now()) {"
      },
      {
        "line": 1011,
        "text": "\t\treturn Fail(409, \"LEASE_EXPIRED\", \"writer lease expired\")"
      },
      {
        "line": 1012,
        "text": "\t}"
      },
      {
        "line": 1013,
        "text": "\toriginalTasks, e := s.originalSessionTasks(ctx, tx, principal, sess.project, sess.sessionID)"
      },
      {
        "line": 1014,
        "text": "\tif e != nil {"
      },
      {
        "line": 1015,
        "text": "\t\treturn e"
      },
      {
        "line": 1016,
        "text": "\t}"
      },
      {
        "line": 1017,
        "text": "\trows, e := tx.QueryContext(ctx, `SELECT DISTINCT t.body FROM domain_objects t WHERE t.project=? AND t.kind='Task' AND (t.id=(SELECT task_id FROM client_sessions WHERE id=?) OR json_extract(t.body,'$.goal_id') IN(SELECT COALESCE(json_extract(body,'$.result.goal_id'),json_extract(body,'$.result.snapshot.goal_id')) FROM idempotency WHERE project=? AND operation IN('v2:goal.start','v2:session.send') AND json_extract(body,'$.status')='COMPLETED' AND (json_extract(body,'$.session_id')=? OR json_extract(body,'$.result.snapshot.session_id')=?)) OR t.id IN(SELECT task_id FROM client_queue_fences WHERE project=? AND session_id=?))`, sess.project, sess.sessionID, sess.project, sess.sessionID, sess.sessionID, sess.project, sess.sessionID)"
      },
      {
        "line": 1018,
        "text": "\tif e != nil {"
      },
      {
        "line": 1019,
        "text": "\t\treturn e"
      },
      {
        "line": 1020,
        "text": "\t}"
      },
      {
        "line": 1021,
        "text": "\ttasks := originalTasks"
      },
      {
        "line": 1022,
        "text": "\tfor rows.Next() {"
      },
      {
        "line": 1023,
        "text": "\t\tvar raw string"
      },
      {
        "line": 1024,
        "text": "\t\tif e = rows.Scan(&raw); e != nil {"
      },
      {
        "line": 1025,
        "text": "\t\t\trows.Close()"
      },
      {
        "line": 1026,
        "text": "\t\t\treturn e"
      },
      {
        "line": 1027,
        "text": "\t\t}"
      },
      {
        "line": 1028,
        "text": "\t\ttask, e := Decode([]byte(raw))"
      },
      {
        "line": 1029,
        "text": "\t\tif e != nil {"
      },
      {
        "line": 1030,
        "text": "\t\t\trows.Close()"
      },
      {
        "line": 1031,
        "text": "\t\t\treturn e"
      },
      {
        "line": 1032,
        "text": "\t\t}"
      },
      {
        "line": 1033,
        "text": "\t\ttasks = append(tasks, task)"
      },
      {
        "line": 1034,
        "text": "\t}"
      },
      {
        "line": 1035,
        "text": "\te = rows.Err()"
      },
      {
        "line": 1036,
        "text": "\trows.Close()"
      },
      {
        "line": 1037,
        "text": "\tif e != nil {"
      },
      {
        "line": 1038,
        "text": "\t\treturn e"
      },
      {
        "line": 1039,
        "text": "\t}"
      },
      {
        "line": 1040,
        "text": "\tfor _, task := range tasks {"
      },
      {
        "line": 1041,
        "text": "\t\tif !clientTurnSettled(tx, sess.project, sess.sessionID, task) {"
      },
      {
        "line": 1042,
        "text": "\t\t\treturn Fail(409, \"SESSION_BUSY\", \"session task is not settled\")"
      },
      {
        "line": 1043,
        "text": "\t\t}"
      },
      {
        "line": 1044,
        "text": "\t\t// A later active_run_id cannot hide an older generation's unresolved"
      },
      {
        "line": 1045,
        "text": "\t\t// effects or child process. Reuse the actual settlement predicate for"
      },
      {
        "line": 1046,
        "text": "\t\t// each canonical Run belonging to the original Task, without writes."
      },
      {
        "line": 1047,
        "text": "\t\truns, err := tx.QueryContext(ctx, `SELECT id FROM domain_objects WHERE project=? AND kind='Run' AND json_extract(body,'$.task_id')=?`, sess.project, Str(task, \"id\"))"
      },
      {
        "line": 1048,
        "text": "\t\tif err != nil {"
      },
      {
        "line": 1049,
        "text": "\t\t\treturn err"
      },
      {
        "line": 1050,
        "text": "\t\t}"
      },
      {
        "line": 1051,
        "text": "\t\tids := []string{}"
      },
      {
        "line": 1052,
        "text": "\t\tfor runs.Next() {"
      },
      {
        "line": 1053,
        "text": "\t\t\tvar id string"
      },
      {
        "line": 1054,
        "text": "\t\t\tif err = runs.Scan(&id); err != nil {"
      },
      {
        "line": 1055,
        "text": "\t\t\t\truns.Close()"
      },
      {
        "line": 1056,
        "text": "\t\t\t\treturn err"
      },
      {
        "line": 1057,
        "text": "\t\t\t}"
      },
      {
        "line": 1058,
        "text": "\t\t\tids = append(ids, id)"
      },
      {
        "line": 1059,
        "text": "\t\t}"
      },
      {
        "line": 1060,
        "text": "\t\terr = runs.Err()"
      },
      {
        "line": 1061,
        "text": "\t\truns.Close()"
      },
      {
        "line": 1062,
        "text": "\t\tif err != nil {"
      },
      {
        "line": 1063,
        "text": "\t\t\treturn err"
      },
      {
        "line": 1064,
        "text": "\t\t}"
      },
      {
        "line": 1065,
        "text": "\t\tfor _, id := range ids {"
      },
      {
        "line": 1066,
        "text": "\t\t\thistorical := Object{}"
      },
      {
        "line": 1067,
        "text": "\t\t\tfor k, v := range task {"
      },
      {
        "line": 1068,
        "text": "\t\t\t\thistorical[k] = v"
      },
      {
        "line": 1069,
        "text": "\t\t\t}"
      },
      {
        "line": 1070,
        "text": "\t\t\thistorical[\"active_run_id\"] = id"
      },
      {
        "line": 1071,
        "text": "\t\t\tif !clientTurnSettled(tx, sess.project, sess.sessionID, historical) {"
      },
      {
        "line": 1072,
        "text": "\t\t\t\treturn Fail(409, \"SESSION_BUSY\", \"earlier session run is not settled\")"
      },
      {
        "line": 1073,
        "text": "\t\t\t}"
      },
      {
        "line": 1074,
        "text": "\t\t}"
      },
      {
        "line": 1075,
        "text": "\t}"
      },
      {
        "line": 1076,
        "text": "\tvar pending int"
      },
      {
        "line": 1077,
        "text": "\te = tx.QueryRowContext(ctx, `SELECT (SELECT count(*) FROM client_command_queue WHERE project=? AND session_id=? AND state NOT IN('CONSUMED','DROPPED'))+(SELECT count(*) FROM client_control_requests WHERE project=? AND session_id=? AND state<>'CONFIRMED')+(SELECT count(*) FROM client_queue_fences WHERE project=? AND session_id=? AND (restore_fenced<>0 OR state='RECONCILING'))`, sess.project, sess.sessionID, sess.project, sess.sessionID, sess.project, sess.sessionID).Scan(&pending)"
      },
      {
        "line": 1078,
        "text": "\tif e != nil {"
      },
      {
        "line": 1079,
        "text": "\t\treturn e"
      },
      {
        "line": 1080,
        "text": "\t}"
      },
      {
        "line": 1081,
        "text": "\tif pending != 0 {"
      },
      {
        "line": 1082,
        "text": "\t\treturn Fail(409, \"SESSION_BUSY\", \"session controls remain unresolved\")"
      },
      {
        "line": 1083,
        "text": "\t}"
      },
      {
        "line": 1084,
        "text": "\trows, e = tx.QueryContext(ctx, `SELECT q.state,q.command_id,q.generation,COALESCE(r.kind,''),COALESCE(r.body,''),COALESCE(r.body_hash,'') FROM client_command_queue q LEFT JOIN client_control_receipts r ON r.receipt_id=q.last_receipt_id AND r.project=q.project AND r.generation=q.generation AND r.command_id=q.command_id WHERE q.project=? AND q.session_id=?`, sess.project, sess.sessionID)"
      },
      {
        "line": 1085,
        "text": "\tif e != nil {"
      },
      {
        "line": 1086,
        "text": "\t\treturn e"
      },
      {
        "line": 1087,
        "text": "\t}"
      },
      {
        "line": 1088,
        "text": "\tfor rows.Next() {"
      },
      {
        "line": 1089,
        "text": "\t\tvar state, command, generation, kind, body, hash string"
      },
      {
        "line": 1090,
        "text": "\t\tif e = rows.Scan(&state, &command, &generation, &kind, &body, &hash); e != nil {"
      },
      {
        "line": 1091,
        "text": "\t\t\trows.Close()"
      },
      {
        "line": 1092,
        "text": "\t\t\treturn e"
      },
      {
        "line": 1093,
        "text": "\t\t}"
      },
      {
        "line": 1094,
        "text": "\t\tif Digest([]byte(body)) != hash || (state == \"CONSUMED\" && kind != \"command.consumed\") || (state == \"DROPPED\" && kind != \"command.cleared\") {"
      },
      {
        "line": 1095,
        "text": "\t\t\trows.Close()"
      },
      {
        "line": 1096,
        "text": "\t\t\treturn Fail(409, \"SESSION_BUSY\", \"queue settlement receipt unavailable\")"
      },
      {
        "line": 1097,
        "text": "\t\t}"
      },
      {
        "line": 1098,
        "text": "\t}"
      },
      {
        "line": 1099,
        "text": "\te = rows.Err()"
      },
      {
        "line": 1100,
        "text": "\trows.Close()"
      },
      {
        "line": 1101,
        "text": "\tif e != nil {"
      },
      {
        "line": 1102,
        "text": "\t\treturn e"
      },
      {
        "line": 1103,
        "text": "\t}"
      },
      {
        "line": 1104,
        "text": "\t// Permission facts are related to the original Session even after its head"
      },
      {
        "line": 1105,
        "text": "\t// Task/Run has advanced; inspect the complete relation, not just the head."
      },
      {
        "line": 1106,
        "text": "\te = tx.QueryRowContext(ctx, `SELECT count(*) FROM resource_effects x JOIN domain_objects r ON r.project=x.project AND r.kind='ResourceRequest' AND r.id=json_extract(x.body,'$.permission.request_id') WHERE x.project=? AND json_extract(x.body,'$.permission.session_id')=? AND json_extract(r.body,'$.status') IN('OPEN','ACKNOWLEDGED')`, sess.project, sess.sessionID).Scan(&pending)"
      },
      {
        "line": 1107,
        "text": "\tif e != nil {"
      },
      {
        "line": 1108,
        "text": "\t\treturn e"
      },
      {
        "line": 1109,
        "text": "\t}"
      },
      {
        "line": 1110,
        "text": "\tif pending > 0 {"
      },
      {
        "line": 1111,
        "text": "\t\treturn Fail(409, \"SESSION_BUSY\", \"session permission remains unresolved\")"
      },
      {
        "line": 1112,
        "text": "\t}"
      },
      {
        "line": 1113,
        "text": "\treturn nil"
      },
      {
        "line": 1114,
        "text": "}"
      }
    ]
  },
  {
    "source": {
      "path": "context/internal/domain/client_protocol_queue_control.go",
      "sha256": "38616234985ef06bba6850b1629cb1774296edff4364dee3cc211c4c13131576",
