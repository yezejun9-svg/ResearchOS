    "lines": [
      {
        "line": 46,
        "text": "func fenceClientTask(tx *sql.Tx, project, task string) error {"
      },
      {
        "line": 47,
        "text": "\tinstalled, err := clientQueueInstalled(tx)"
      },
      {
        "line": 48,
        "text": "\tif err != nil || !installed {"
      },
      {
        "line": 49,
        "text": "\t\treturn err"
      },
      {
        "line": 50,
        "text": "\t}"
      },
      {
        "line": 51,
        "text": "\tvar session string"
      },
      {
        "line": 52,
        "text": "\terr = tx.QueryRow(`SELECT id FROM client_sessions WHERE project_id=? AND task_id=?`, project, task).Scan(&session)"
      },
      {
        "line": 53,
        "text": "\tif err == sql.ErrNoRows {"
      },
      {
        "line": 54,
        "text": "\t\treturn nil"
      },
      {
        "line": 55,
        "text": "\t}"
      },
      {
        "line": 56,
        "text": "\tif err != nil {"
      },
      {
        "line": 57,
        "text": "\t\treturn err"
      },
      {
        "line": 58,
        "text": "\t}"
      },
      {
        "line": 59,
        "text": "\tif err = ensureClientQueue(tx, project, session, task); err != nil {"
      },
      {
        "line": 60,
        "text": "\t\treturn err"
      },
      {
        "line": 61,
        "text": "\t}"
      },
      {
        "line": 62,
        "text": "\tvar generation string"
      },
      {
        "line": 63,
        "text": "\tif err = tx.QueryRow(`SELECT generation FROM client_queue_fences WHERE project=? AND task_id=?`, project, task).Scan(&generation); err != nil {"
      },
      {
        "line": 64,
        "text": "\t\treturn err"
      },
      {
        "line": 65,
        "text": "\t}"
      },
      {
        "line": 66,
        "text": "\tif _, err = tx.Exec(`UPDATE client_queue_fences SET state='CANCEL_FENCED',revision=revision+1 WHERE generation=? AND state<>'SEALED'`, generation); err != nil {"
      },
      {
        "line": 67,
        "text": "\t\treturn err"
      },
      {
        "line": 68,
        "text": "\t}"
      },
      {
        "line": 69,
        "text": "\trows, err := tx.Query(`SELECT command_id,state,last_receipt_id FROM client_command_queue WHERE generation=? AND state IN ('ENQUEUED','SENDING','SDK_ACCEPTED')`, generation)"
      },
      {
        "line": 70,
        "text": "\tif err != nil {"
      },
      {
        "line": 71,
        "text": "\t\treturn err"
      },
      {
        "line": 72,
        "text": "\t}"
      },
      {
        "line": 73,
        "text": "\ttype entry struct {"
      },
      {
        "line": 74,
        "text": "\t\tid, state string"
      },
      {
        "line": 75,
        "text": "\t\tprior     sql.NullString"
      },
      {
        "line": 76,
        "text": "\t}"
      },
      {
        "line": 77,
        "text": "\tentries := []entry{}"
      },
      {
        "line": 78,
        "text": "\tfor rows.Next() {"
      },
      {
        "line": 79,
        "text": "\t\tvar item entry"
      },
      {
        "line": 80,
        "text": "\t\tif err = rows.Scan(&item.id, &item.state, &item.prior); err != nil {"
      },
      {
        "line": 81,
        "text": "\t\t\trows.Close()"
      },
      {
        "line": 82,
        "text": "\t\t\treturn err"
      },
      {
        "line": 83,
        "text": "\t\t}"
      },
      {
        "line": 84,
        "text": "\t\tentries = append(entries, item)"
      },
      {
        "line": 85,
        "text": "\t}"
      },
      {
        "line": 86,
        "text": "\terr = rows.Err()"
      },
      {
        "line": 87,
        "text": "\trows.Close()"
      },
      {
        "line": 88,
        "text": "\tif err != nil {"
      },
      {
        "line": 89,
        "text": "\t\treturn err"
      },
      {
        "line": 90,
        "text": "\t}"
      },
      {
        "line": 91,
        "text": "\tfor _, item := range entries {"
      },
      {
        "line": 92,
        "text": "\t\tnext := \"DROP_REQUESTED\""
      },
      {
        "line": 93,
        "text": "\t\tif item.state == \"ENQUEUED\" {"
      },
      {
        "line": 94,
        "text": "\t\t\tnext = \"DROPPED\""
      },
      {
        "line": 95,
        "text": "\t\t}"
      },
      {
        "line": 96,
        "text": "\t\treceipt := ID()"
      },
      {
        "line": 97,
        "text": "\t\tvar previous any"
      },
      {
        "line": 98,
        "text": "\t\tif item.prior.Valid {"
      },
      {
        "line": 99,
        "text": "\t\t\tprevious = item.prior.String"
      },
      {
        "line": 100,
        "text": "\t\t}"
      },
      {
        "line": 101,
        "text": "\t\tif err = appendClientReceipt(tx, project, generation, item.id, \"CANCEL_FENCE\", receipt, Object{\"task_id\": task, \"from\": item.state, \"to\": next}, previous); err != nil {"
      },
      {
        "line": 102,
        "text": "\t\t\treturn err"
      },
      {
        "line": 103,
        "text": "\t\t}"
      },
      {
        "line": 104,
        "text": "\t\tif _, err = tx.Exec(`UPDATE client_command_queue SET state=?,revision=revision+1,last_receipt_id=? WHERE generation=? AND command_id=?`, next, receipt, generation, item.id); err != nil {"
      },
      {
        "line": 105,
        "text": "\t\t\treturn err"
      },
      {
        "line": 106,
        "text": "\t\t}"
      }
    ]
  },
  {
    "source": {
      "path": "context/internal/domain/client_protocol_queue_control.go",
      "sha256": "38616234985ef06bba6850b1629cb1774296edff4364dee3cc211c4c13131576",
      "bytes": 10724
    },
    "start_line": 216,
    "end_line": 287,
    "lines": [
      {
        "line": 216,
        "text": "func (s *ClientService) finalizeClientCancel(ctx context.Context, tx *sql.Tx, env *Envelope, principal string, sess *clientSessionRow) (*Response, error) {"
      },
      {
        "line": 217,
        "text": "\tvar tasks, target, control, state string"
      },
      {
        "line": 218,
        "text": "\terr := tx.QueryRow(`SELECT task_ids,target_id,control_request_id,state FROM client_control_requests WHERE principal=? AND project=? AND command_id=?`, principal, deref(env.ProjectID), deref(env.CommandID)).Scan(&tasks, &target, &control, &state)"
      },
      {
        "line": 219,
        "text": "\tif err == sql.ErrNoRows {"
      },
      {
        "line": 220,
        "text": "\t\treturn nil, nil"
      },
      {
        "line": 221,
        "text": "\t}"
      },
      {
        "line": 222,
        "text": "\tif err != nil {"
      },
      {
        "line": 223,
        "text": "\t\treturn nil, err"
      },
      {
        "line": 224,
        "text": "\t}"
      },
      {
        "line": 225,
        "text": "\tif state == \"CONFIRMED\" || state == \"RECONCILING\" {"
      },
      {
        "line": 226,
        "text": "\t\treturn nil, nil"
      },
      {
        "line": 227,
        "text": "\t}"
      },
      {
        "line": 228,
        "text": "\tvar ids []string"
      },
      {
        "line": 229,
        "text": "\tif err = json.Unmarshal([]byte(tasks), &ids); err != nil {"
      },
      {
        "line": 230,
        "text": "\t\treturn nil, err"
      },
      {
        "line": 231,
        "text": "\t}"
      },
      {
        "line": 232,
        "text": "\tfor _, id := range ids {"
      },
      {
        "line": 233,
        "text": "\t\ttask, e := load(tx, deref(env.ProjectID), \"Task\", id)"
      },
      {
        "line": 234,
        "text": "\t\tif e != nil {"
      },
      {
        "line": 235,
        "text": "\t\t\treturn nil, e"
      },
      {
        "line": 236,
        "text": "\t\t}"
      },
      {
        "line": 237,
        "text": "\t\tif run := Str(task, \"active_run_id\"); run != \"\" {"
      },
      {
        "line": 238,
        "text": "\t\t\tr, e := load(tx, deref(env.ProjectID), \"Run\", run)"
      },
      {
        "line": 239,
        "text": "\t\t\tif e != nil {"
      },
      {
        "line": 240,
        "text": "\t\t\t\treturn nil, e"
      },
      {
        "line": 241,
        "text": "\t\t\t}"
      },
      {
        "line": 242,
        "text": "\t\t\tif !runTerminal(r) || r[\"children_stopped\"] != true || r[\"queue_empty\"] != true || effectsReconciled(tx, deref(env.ProjectID), run) != nil || clientQueueSettled(tx, deref(env.ProjectID), run) != nil {"
      },
      {
        "line": 243,
        "text": "\t\t\t\treturn nil, nil"
      },
      {
        "line": 244,
        "text": "\t\t\t}"
      },
      {
        "line": 245,
        "text": "\t\t\tif r[\"status\"] == \"CANCELLED\" && Str(r, \"cancel_confirmed_at\") == \"\" {"
      },
      {
        "line": 246,
        "text": "\t\t\t\treturn nil, nil"
      },
      {
        "line": 247,
        "text": "\t\t\t}"
      },
      {
        "line": 248,
        "text": "\t\t} else {"
      },
      {
