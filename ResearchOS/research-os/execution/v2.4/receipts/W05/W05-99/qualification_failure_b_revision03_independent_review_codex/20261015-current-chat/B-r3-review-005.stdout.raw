func TestQualificationFailurePrivateConsumerRechecksOriginalFiles(t *testing.T) {
	c, route, r, calls := qualificationFailureLoopbackFixture(t)
	if err := c.RunAdmitted(context.Background(), route, r.run, r.lease); err == nil || calls.Load() != 1 {
		t.Fatalf("controlled native first gate did not close once: %v calls=%d", err, calls.Load())
	}
	epoch, err := Num(r.run, "lease_epoch")
	if err != nil {
		t.Fatal(err)
	}
	var locator, marker string
	var proof []byte
	if err := r.f.db.QueryRow("SELECT journal_locator FROM runtime_dispatches WHERE project=? AND run=?", r.f.project, r.run["id"]).Scan(&locator); err != nil {
		t.Fatal(err)
	}
	if err := r.f.db.QueryRow("SELECT body FROM idempotency WHERE project=? AND operation='host:qualification-failure-closure'", r.f.project).Scan(&marker); err != nil {
		t.Fatal(err)
	}
	if err := r.f.db.QueryRow("SELECT bytes FROM uploaded_content WHERE project=? ORDER BY rowid DESC LIMIT 1", r.f.project).Scan(&proof); err != nil {
		t.Fatal(err)
	}
	directory := filepath.Join(c.config.DataRoot, "runtime-dispatches", locator)
	check := func() error {
		tx, err := r.f.db.Begin()
		if err != nil {
			return err
		}
		closure, validationErr := r.f.s.validatedQualificationFailureTx(tx, r.f.project, Str(r.task, "id"), Str(r.run, "id"), epoch)
		if validationErr == nil {
			validationErr = closure.Check()
		}
		return errors.Join(validationErr, tx.Rollback(), closure.Close())
	}
	if err := check(); err != nil {
		t.Fatalf("unchanged private consumer refused closure: %v", err)
	}
	for _, name := range []string{"stdout.raw", "stderr.raw", "bridge.json", "qualification-rejection-00000000000000000003.json"} {
		t.Run(name, func(t *testing.T) {
			path := filepath.Join(directory, name)
			original, err := os.ReadFile(path)
			if err != nil {
				t.Fatal(err)
			}
			if err := os.WriteFile(path, append(append([]byte(nil), original...), byte('x')), 0600); err != nil {
				t.Fatal(err)
			}
			if err := check(); err == nil {
				t.Fatal("private consumer accepted changed original native bytes")
			}
			if err := os.WriteFile(path, original, 0600); err != nil {
				t.Fatal(err)
			}
			if err := check(); err != nil {
				t.Fatalf("restored original bytes were refused: %v", err)
			}
		})
	}
	t.Run("rejection_whitespace", func(t *testing.T) {
		path := filepath.Join(directory, "qualification-rejection-00000000000000000003.json")
		original, err := os.ReadFile(path)
		if err != nil {
			t.Fatal(err)
		}
		if err := os.WriteFile(path, append([]byte{' '}, original...), 0600); err != nil {
			t.Fatal(err)
		}
		if err := check(); err == nil {
			t.Fatal("private consumer accepted recoded original rejection bytes")
		}
		if err := os.WriteFile(path, original, 0600); err != nil {
			t.Fatal(err)
		}
	})
	if err := check(); err != nil {
		t.Fatalf("final baseline closure refused: %v", err)
	}
	var markerAfter string
	var proofAfter []byte
	if err := r.f.db.QueryRow("SELECT body FROM idempotency WHERE project=? AND operation='host:qualification-failure-closure'", r.f.project).Scan(&markerAfter); err != nil {
		t.Fatal(err)
	}
	if err := r.f.db.QueryRow("SELECT bytes FROM uploaded_content WHERE project=? ORDER BY rowid DESC LIMIT 1", r.f.project).Scan(&proofAfter); err != nil {
		t.Fatal(err)
	}
	if marker != markerAfter || !bytes.Equal(proof, proofAfter) || calls.Load() != 1 {
		t.Fatal("native-file cuts changed sealed marker/proof or repeated MODEL")
	}
}

func TestQualificationFailurePrivateConsumerHoldsNativeFilesThroughTransaction(t *testing.T) {
	c, route, r, _ := qualificationFailureLoopbackFixture(t)
	if err := c.RunAdmitted(context.Background(), route, r.run, r.lease); err == nil {
		t.Fatal("expected controlled first-gate denial")
	}
	epoch, err := Num(r.run, "lease_epoch")
	if err != nil {
		t.Fatal(err)
	}
	tx, err := r.f.db.Begin()
	if err != nil {
		t.Fatal(err)
	}
	closure, err := r.f.s.validatedQualificationFailureTx(tx, r.f.project, Str(r.task, "id"), Str(r.run, "id"), epoch)
	if err != nil {
		tx.Rollback()
		t.Fatal(err)
	}
	var locator string
	if err := tx.QueryRow("SELECT journal_locator FROM runtime_dispatches WHERE project=? AND run=?", r.f.project, r.run["id"]).Scan(&locator); err != nil {
		tx.Rollback()
		closure.Close()
		t.Fatal(err)
	}
	directory := filepath.Join(c.config.DataRoot, "runtime-dispatches", locator)
	path := filepath.Join(directory, "stdout.raw")
	original, err := os.ReadFile(path)
	if err != nil {
		tx.Rollback()
		closure.Close()
		t.Fatal(err)
	}
	if err := os.WriteFile(path, original, 0600); err == nil {
		t.Fatal("native source changed while private closure was in use")
	}
	if err := os.Rename(directory, directory+"-moved"); err == nil {
		t.Fatal("selected dispatch directory changed while private closure was in use")
	}
	if err := closure.Check(); err != nil {
		t.Fatal(err)
	}
	if err := tx.Rollback(); err != nil {
		t.Fatal(err)
	}
	if err := closure.Check(); err != nil {
		t.Fatal(err)
	}
	if err := closure.Close(); err != nil {
		t.Fatal(err)
	}
	if err := os.WriteFile(path, original, 0600); err != nil {
		t.Fatalf("native source remained locked after transaction hold release: %v", err)
	}
}

func TestQualificationFailureGenericThirdFrameDoesNotConvert(t *testing.T) {
	for _, mutation := range []struct{ name, from, to string }{
		{"unknown_route", "key:subject+':tool:1',route,capability:'TOOL'", "key:subject+':tool:1',route:'unbound-route',capability:'TOOL'"},
		{"malformed_tool", "payload:{name:'run_check',arguments:{}}", "payload:{name:'run_check',arguments:'malformed'}"},
		{"second_model", "key:subject+':tool:1',route,capability:'TOOL'", "key:subject+':tool:1',route,capability:'MODEL'"},
	} {
		t.Run(mutation.name, func(t *testing.T) {
			child := strings.Replace(qualificationDenialChild, mutation.from, mutation.to, 1)
			if child == qualificationDenialChild {
				t.Fatal("fixture mutation missed")
			}
			c, route, r, calls := qualificationFailureLoopbackFixtureChild(t, child)
			err := c.RunAdmitted(context.Background(), route, r.run, r.lease)
			var typed *qualificationPreEffectRejection
			if err == nil || errors.As(err, &typed) {
				t.Fatalf("generic frame became typed: %v", err)
			}
			var status, dispatchState, locator string
			if e := r.f.db.QueryRow("SELECT json_extract(body,'$.status') FROM domain_objects WHERE kind='Run' AND id=?", r.run["id"]).Scan(&status); e != nil {
				t.Fatal(e)
			}
			if e := r.f.db.QueryRow("SELECT state,journal_locator FROM runtime_dispatches WHERE run=?", r.run["id"]).Scan(&dispatchState, &locator); e != nil {
	plan, planHash, planRoot, err := qualificationPlan(tx, project, taskID, Str(run, "runtime_id"))
	if err != nil || planRoot != ownerRoot || plan["task_hash"] != qualificationTaskHash(task) {
		return unavailable()
	}
	var markerCount int
	if err = tx.QueryRow(`SELECT count(*) FROM runtime_qualification_runs WHERE project=? AND task=? AND run=? AND runtime=? AND epoch=? AND plan_hash=? AND owner_root=?`, project, taskID, runID, run["runtime_id"], epoch, planHash, ownerRoot).Scan(&markerCount); err != nil || markerCount != 1 {
		return unavailable()
	}
	ref, ok := marker["proof_ref"].(map[string]any)
	if !ok || ref["entity_type"] != "Artifact" {
		return unavailable()
	}
	artifact, err := version(tx, project, ref)
	if err != nil || artifact["kind"] != "MANIFEST" || artifact["evidence_kind"] != "GENERATED" || artifact["measurement_mode"] != "LIVE" || artifact["run_id"] != nil || artifact["access_class"] != "PROJECT" || artifact["produced_by"] != principal.ID || artifact["sealed_at"] == nil || artifact["validity"] != "CURRENT" || artifact["media_type"] != "application/json" || Hash(Ref(artifact, "Artifact")) != Hash(ref) || len(Arr(artifact, "input_refs")) != 1 || Hash(Arr(artifact, "input_refs")[0]) != Hash(plan["profile_ref"]) || len(Arr(artifact, "source_refs")) != 0 {
		return unavailable()
	}
	profileRef, profileOK := plan["profile_ref"].(map[string]any)
	if !profileOK || s.effective(tx, project, Object(profileRef)) != nil {
		return unavailable()
	}
	var raw []byte
	var uploadHash, uploadPrincipal string
	var sealed int
	if err = tx.QueryRow(`SELECT bytes,content_hash,principal,sealed FROM uploaded_content WHERE project=? AND storage_key=?`, project, artifact["storage_key"]).Scan(&raw, &uploadHash, &uploadPrincipal, &sealed); err != nil || sealed != 1 || uploadPrincipal != principal.ID || uploadHash != Digest(raw) || artifact["content_hash"] != uploadHash || Hash(artifact["byte_size"]) != Hash(len(raw)) || len(raw) == 0 || len(raw) > 64*1024 {
		return unavailable()
	}
	proof, err := Decode(raw)
	if err != nil || proof["schema"] != "researchos.qualification-failure-proof.v1" || proof["kind"] != onlineQualificationDenial || proof["author"] != principal.ID || proof["owner_root"] != ownerRoot || Hash(proof["subject"]) != Hash(subject) || proof["rejection_digest"] != marker["denial_digest"] {
		return unavailable()
	}
	core, ok := proof["plan_core"].(map[string]any)
	if !ok || Hash(core) != proof["plan_hash"] || proof["plan_hash"] != marker["plan_hash"] || marker["plan_file_sha256"] != Digest(Bytes(Object{"core": core, "proof": proof})) || core["author"] != principal.ID || core["owner_root"] != ownerRoot || Hash(core["subject"]) != Hash(subject) || core["upload_key"] != artifact["storage_key"] || core["artifact_id"] != artifact["id"] || core["before_dispatch_hash"] != Hash(core["before_dispatch"]) || core["observation_hash"] != marker["observation_hash"] || core["observed_at"] != proof["observed_at"] || run["runtime_settled_at"] != core["observed_at"] || run["ended_at"] != core["observed_at"] {
		return unavailable()
	}
	rejection, ok := proof["rejection"].(map[string]any)
	if !ok || rejection["schema"] != "researchos.qualification-pre-effect-rejection.v1" || rejection["kind"] != onlineQualificationDenial || rejection["stage"] != "BEFORE_PREPARE_EFFECT_TX" || rejection["outcome"] != "NO_EFFECT" || rejection["rule"] != "QUALIFICATION_MODEL_ONLY_V1" || Hash(rejection) != marker["denial_digest"] || rejection["frame_key"] != proof["rejected_effect_key"] || rejection["frame_route"] != proof["model_route"] || rejection["frame_sequence"] == nil || Hash(rejection["frame_sequence"]) != Hash(3) || rejection["plan_hash"] != planHash || rejection["project_id"] != project || rejection["task_id"] != taskID || rejection["run_id"] != runID || Hash(rejection["epoch"]) != Hash(epoch) {
		return unavailable()
	}
	observation, ok := proof["derived_observation"].(map[string]any)
	protocol, protocolOK := observation["protocol"].(map[string]any)
	qf, qfOK := observation["qualification_failure"].(map[string]any)
	if !ok || !protocolOK || !qfOK || observation["state"] != "FAILED" || observation["queue_empty"] != true || observation["children_stopped"] != true || observation["streams_drained"] != true || observation["cleanup_complete"] != true || Hash(protocol["frames"]) != Hash(3) || Hash(protocol["acknowledged"]) != Hash(2) || Hash(protocol["verified_rejected"]) != Hash(1) || qf["denial_digest"] != marker["denial_digest"] || qf["raw_stdout_hash"] == "" || qf["raw_bridge_hash"] == "" || Hash(observation) != marker["observation_hash"] || Hash(run["exit_code"]) != Hash(observation["exit_code"]) {
		return unavailable()
	}
	native, nativeOK := proof["native"].(map[string]any)
	broker, brokerOK := proof["broker"].(map[string]any)
	if !nativeOK || !brokerOK || native["journal_hash"] != qf["raw_bridge_hash"] || native["stdout_hash"] != qf["raw_stdout_hash"] || native["stderr_hash"] != qf["raw_stderr_hash"] || native["ended"] != qf["native_ended"] || Hash(native["exit_code"]) != Hash(run["exit_code"]) || Hash(native["frames"]) != Hash(3) || Hash(native["acknowledged"]) != Hash(2) || native["cancelled"] != true || Hash(broker["accepted"]) != Hash(2) || Hash(broker["completed"]) != Hash(2) || Hash(broker["pending"]) != Hash(0) || Hash(broker["rejected_sequence"]) != Hash(3) {
		return unavailable()
	}
	var observedRaw string
	if err = tx.QueryRow(`SELECT body FROM runtime_observations WHERE project=? AND run=? AND epoch=? AND receipt_hash=?`, project, runID, epoch, marker["observation_hash"]).Scan(&observedRaw); err != nil || observedRaw != string(Bytes(observation)) {
		return unavailable()
	}
	dispatch, err := runtimeDispatch(tx, project, runID, epoch)
	if err != nil || dispatch["state"] != "OBSERVED" || dispatch["observation_hash"] != marker["observation_hash"] || Hash(dispatch["observation_sequence"]) != Hash(core["dispatch_observation_sequence"]) || dispatch["manifest_hash"] != rejection["manifest_hash"] || dispatch["dispatch_key"] != rejection["dispatch_key"] {
		return unavailable()
	}
	beforeDispatch, _ := core["before_dispatch"].(map[string]any)
	if beforeDispatch == nil || beforeDispatch["dispatch_key"] != dispatch["dispatch_key"] || beforeDispatch["manifest_hash"] != dispatch["manifest_hash"] || Hash(beforeDispatch["manifest"]) != Hash(dispatch["manifest"]) || beforeDispatch["worker"] != dispatch["worker"] || Hash(beforeDispatch["identity"]) != Hash(dispatch["identity"]) {
		return unavailable()
	}
	var effectCount, rejectCount int
	if err = tx.QueryRow(`SELECT count(DISTINCT effect_key),sum(CASE WHEN effect_key=? THEN 1 ELSE 0 END) FROM resource_effects WHERE project=? AND run=?`, proof["rejected_effect_key"], project, runID).Scan(&effectCount, &rejectCount); err != nil || effectCount != 1 || rejectCount != 0 {
		return unavailable()
	}
	modelBinding, bindingOK := proof["model_binding"].(map[string]any)
	if !bindingOK || modelBinding["effect_key"] != proof["model_effect_key"] || modelBinding["route"] != proof["model_route"] || Str(modelBinding, "payload_hash") == "" {
		return unavailable()
	}
	directory := Str(modelBinding, "directory")
	if !filepath.IsAbs(directory) || filepath.Base(directory) != Str(dispatch, "dispatch_key") || filepath.Base(filepath.Dir(directory)) != "runtime-dispatches" {
		return unavailable()
	}
	facts, nativeHold, nativeErr := rt.HoldQualificationNativeFacts(directory, Str(dispatch, "manifest_hash"), Str(proof, "model_effect_key"))
	if nativeErr != nil {
		return unavailable()
	}
	defer func() {
		if nativeHold != nil {
			nativeHold.Close()
		}
	}()
	if !qualificationNativeClosureMatches(facts, proof, marker, rejection, observation, qf, native, broker, dispatch, modelBinding) {
		return unavailable()
	}
	currentBinding, bindingErr := qualificationModelBindingTx(tx, project, runID, epoch, dispatch, Str(modelBinding, "directory"), Str(proof, "model_effect_key"), Str(proof, "model_route"), Str(modelBinding, "payload_hash"))
	if bindingErr != nil || Hash(currentBinding) != Hash(modelBinding) {
		return unavailable()
	}
	var ledgerRaw string
	var ledgerCount int
	if err = tx.QueryRow(`SELECT count(*),coalesce(max(body),'') FROM domain_objects WHERE project=? AND kind='BudgetLedgerEntry' AND json_extract(body,'$.run_id')=?`, project, runID).Scan(&ledgerCount, &ledgerRaw); err != nil || ledgerCount != 1 {
		return unavailable()
	}
	ledger, err := Decode([]byte(ledgerRaw))
	if err != nil || ledger["operation"] != "UNKNOWN" || ledger["money"] != nil || ledger["provider_request_id"] != proof["model_effect_key"] || ledger["id"] != modelBinding["reservation_id"] {
		return unavailable()
	}
	link, err := load(tx, project, "ImpactLink", Str(core, "impact_link_id"))
	event, eventErr := load(tx, project, "EventEnvelope", Str(core, "event_id"))
	var snapshotRaw, outboxRaw string
	if err != nil || eventErr != nil || link["relation"] != "DERIVED_FROM" || Hash(link["from_ref"]) != Hash(ref) || Hash(link["to_ref"]) != Hash(plan["profile_ref"]) || event["event_type"] != "RUN_CHANGED" || event["actor_id"] != principal.ID || event["correlation_id"] != core["correlation_id"] || Hash(event["aggregate_ref"]) != Hash(Ref(run, "Run")) || tx.QueryRow(`SELECT body FROM event_state_snapshots WHERE project=? AND event_id=?`, project, event["id"]).Scan(&snapshotRaw) != nil || tx.QueryRow(`SELECT body FROM outbox WHERE project=? AND sequence=? AND id=?`, project, core["event_sequence"], event["id"]).Scan(&outboxRaw) != nil || outboxRaw != string(Bytes(event)) {
		return unavailable()
	}
	state, err := Decode([]byte(snapshotRaw))
	if err != nil || Hash(state["event_sequence"]) != Hash(core["event_sequence"]) {
		return unavailable()
	}
	outcomeHash := Hash(Object{"artifact": artifact, "impact_link": link, "run": run, "project_state": state, "event": event, "observation": observation, "dispatch_state": "OBSERVED", "dispatch_sequence": core["dispatch_observation_sequence"], "before_run_hash": core["before_run_hash"], "before_state_hash": core["before_state_hash"], "before_dispatch_hash": core["before_dispatch_hash"]})
	if outcomeHash != marker["outcome_hash"] {
		return unavailable()
	}
	if nativeHold.Check() != nil {
		return unavailable()
	}
	closure := qualificationFailureClosure{subjectValue: qualificationFailureSubject{project: project, task: taskID, run: runID, epoch: epoch}, proofValue: Object(ref), seal: Hash(marker), nativeHold: nativeHold}
	nativeHold = nil
	return closure, nil
}
	StderrHash     string
	Frames         []BridgeFrame
	FrameHashes    []string
	AuxAfterThird  bool
	Rejection      []byte
}

// QualificationNativeHold pins the selected directory namespace and the
// original terminal files until the consuming transaction has finished using
// the facts. The caller must Close it after commit or rollback.
type QualificationNativeHold struct {
	mu     sync.Mutex
	guard  *qualificationPathGuard
	files  []*qualificationSourceFile
	closed bool
}

func (h *QualificationNativeHold) Check() error {
	if h == nil {
		return errors.New("qualification native hold unavailable")
	}
	h.mu.Lock()
	defer h.mu.Unlock()
	if h.closed || h.guard == nil {
		return errors.New("qualification native hold closed")
	}
	if err := h.guard.Check(); err != nil {
		return err
	}
	for _, f := range h.files {
		if err := f.Check(); err != nil {
			return err
		}
	}
	return nil
}

func (h *QualificationNativeHold) Close() error {
	if h == nil {
		return nil
	}
	h.mu.Lock()
	defer h.mu.Unlock()
	if h.closed {
		return nil
	}
	h.closed = true
	var err error
	for i := len(h.files) - 1; i >= 0; i-- {
		err = errors.Join(err, h.files[i].file.Close())
	}
	if h.guard != nil {
		h.guard.Close()
	}
	return err
}

// HoldQualificationNativeFacts rereads the bounded native evidence while
// retaining its original file and MODEL Host fact handles for the transaction.
func HoldQualificationNativeFacts(directory, manifestHash, modelKey string) (QualificationNativeFacts, *QualificationNativeHold, error) {
	var zero QualificationNativeFacts
	if modelKey == "" {
		return zero, nil, errors.New("qualification model key required")
	}
	guard, err := qualificationGuardDirectory(directory, true)
	if err != nil {
		return zero, nil, err
	}
	hold := &QualificationNativeHold{guard: guard}
	modelName := "effect-" + strings.TrimPrefix(Hash([]byte(modelKey)), "sha256:") + ".json"
	for _, name := range []string{"bridge.json", "stdout.raw", "stderr.raw", qualificationRejectionFile, modelName} {
		f, openErr := qualificationOpenSource(filepath.Join(directory, name), guard.current, false)
		if openErr != nil {
			hold.Close()
			return zero, nil, openErr
		}
		hold.files = append(hold.files, f)
	}
	facts, err := ReadQualificationNativeFacts(directory, manifestHash)
	if err == nil {
		err = hold.Check()
	}
	if err != nil {
		hold.Close()
		return zero, nil, err
	}
	return facts, hold, nil
}

func ReadQualificationNativeFacts(directory, manifestHash string) (QualificationNativeFacts, error) {
	var facts QualificationNativeFacts
	guard, err := qualificationGuardDirectory(directory, true)
	if err != nil {
		return facts, err
	}
	defer guard.Close()
	files := make(map[string]*qualificationSourceFile)
	defer func() {
		for _, f := range files {
			f.file.Close()
		}
	}()
	open := func(name string) (*qualificationSourceFile, error) {
		f, err := qualificationOpenSource(filepath.Join(directory, name), guard.current, false)
		if err == nil {
			files[name] = f
		}
		return f, err
	}
	journalFile, err := open("bridge.json")
	if err != nil {
		return facts, err
	}
	journalRaw, err := journalFile.ReadBounded(4 * 1024 * 1024)
	if err != nil {
		return facts, err
	}
	var expected BridgeJournal
	if err := json.Unmarshal(journalRaw, &expected); err != nil {
		return facts, err
	}
	stdoutFile, err := open("stdout.raw")
	if err != nil {
		return facts, err
	}
	stderrFile, err := open("stderr.raw")
	if err != nil {
		return facts, err
	}
	rejectionFile, err := open(qualificationRejectionFile)
	if err != nil {
		return facts, err
	}
	if expected.Checkpoint != nil {
		if _, err := open("checkpoint.sealed.json"); err != nil {
			return facts, err
		}
	}
	var artifactGuards []*qualificationPathGuard
	defer func() {
