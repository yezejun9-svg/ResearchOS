param([Parameter(Mandatory=$true)][string]$Id)
$ErrorActionPreference='Stop'
$utf8=[Text.UTF8Encoding]::new($false)
[Console]::OutputEncoding=$utf8
$recipePath=Join-Path $PSScriptRoot ($Id+'.recipe.json')
$rawRecipe=[IO.File]::ReadAllText($recipePath,$utf8)
$recipe=$rawRecipe|ConvertFrom-Json
$vars=[ordered]@{PSVersion=$PSVersionTable.PSVersion.ToString()}
foreach($p in $recipe.environment.PSObject.Properties){[Environment]::SetEnvironmentVariable($p.Name,[string]$p.Value,'Process');$vars[$p.Name]=[string]$p.Value}
$exe=(Get-Command -Name $recipe.executable -CommandType Application -ErrorAction Stop|Select-Object -First 1).Source
$inv=[ordered]@{schema='researchos.independent-native-invocation.v1';id=$Id;recipe=$recipePath;recipeSHA256=(Get-FileHash -LiteralPath $recipePath -Algorithm SHA256).Hash.ToLowerInvariant();argv=@($exe)+@($recipe.argv);cwd=$recipe.cwd;environment=$vars;inheritedEnvironment='not exhaustively captured; no secret enumeration';started=[DateTime]::UtcNow.ToString('o');runnerSHA256=(Get-FileHash -LiteralPath $PSCommandPath -Algorithm SHA256).Hash.ToLowerInvariant()}
[IO.File]::WriteAllText((Join-Path $PSScriptRoot ($Id+'.invocation.json')),($inv|ConvertTo-Json -Depth 20),$utf8)
$stdout=Join-Path $PSScriptRoot ($Id+'.stdout.raw')
$stderr=Join-Path $PSScriptRoot ($Id+'.stderr.raw')
$exitCode=$null;$failure=$null
$old=(Get-Location).Path
try {Set-Location -LiteralPath $recipe.cwd;& $exe @($recipe.argv) 1> $stdout 2> $stderr;$exitCode=$LASTEXITCODE}
catch {$failure=$_|Out-String;[IO.File]::AppendAllText($stderr,$failure,$utf8)}
finally {Set-Location -LiteralPath $old}
if(!(Test-Path -LiteralPath $stdout)){[IO.File]::WriteAllText($stdout,'',$utf8)}
if(!(Test-Path -LiteralPath $stderr)){[IO.File]::WriteAllText($stderr,'',$utf8)}
$result=[ordered]@{id=$Id;nativeExit=$exitCode;runnerFailure=$failure;finished=[DateTime]::UtcNow.ToString('o');invocationSHA256=(Get-FileHash -LiteralPath (Join-Path $PSScriptRoot ($Id+'.invocation.json')) -Algorithm SHA256).Hash.ToLowerInvariant();stdoutSHA256=(Get-FileHash -LiteralPath $stdout -Algorithm SHA256).Hash.ToLowerInvariant();stderrSHA256=(Get-FileHash -LiteralPath $stderr -Algorithm SHA256).Hash.ToLowerInvariant()}
[IO.File]::WriteAllText((Join-Path $PSScriptRoot ($Id+'.result.json')),($result|ConvertTo-Json -Depth 15),$utf8)
Get-Content -LiteralPath $stdout -Raw -Encoding utf8
Get-Content -LiteralPath $stderr -Raw -Encoding utf8
if($null -eq $exitCode){exit 1}
exit $exitCode

//go:build windows

package domain

import (
	"context"
	"database/sql"
	"encoding/json"
	"errors"
	"fmt"
	"os"
	"path/filepath"
	"reflect"
	rt "researchos.local/research-os/adapters/runtime"
	"sort"
	"strings"
	"testing"
	"unsafe"
)

// This independent overlay adds no production code or acceptance hooks.
func independentB2Census(t *testing.T, db *sql.DB) map[string][]string {
	t.Helper()
	rows, err := db.Query("SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%' ORDER BY name")
	if err != nil {
		t.Fatal(err)
	}
	var names []string
	for rows.Next() {
		var n string
		if err := rows.Scan(&n); err != nil {
			t.Fatal(err)
		}
		names = append(names, n)
	}
	if err := rows.Err(); err != nil {
		t.Fatal(err)
	}
	rows.Close()
	out := map[string][]string{}
	for _, n := range names {
		rr, err := db.Query("SELECT * FROM \"" + strings.ReplaceAll(n, "\"", "\"\"") + "\"")
		if err != nil {
			t.Fatal(err)
		}
		cols, err := rr.Columns()
		if err != nil {
			t.Fatal(err)
		}
		contents := []string{}
		for rr.Next() {
			values := make([]any, len(cols))
			targets := make([]any, len(cols))
			for i := range targets {
				targets[i] = &values[i]
			}
			if err := rr.Scan(targets...); err != nil {
				t.Fatal(err)
			}
			raw, err := json.Marshal(values)
			if err != nil {
				t.Fatal(err)
			}
			contents = append(contents, string(raw))
		}
		if err := rr.Err(); err != nil {
			t.Fatal(err)
		}
		rr.Close()
		sort.Strings(contents)
		out[n] = contents
	}
	return out
}
func independentB2VersionKinds(t *testing.T, db *sql.DB) map[string]int {
	t.Helper()
	rows, err := db.Query("SELECT kind,count(*) FROM domain_versions GROUP BY kind")
	if err != nil {
		t.Fatal(err)
	}
	defer rows.Close()
	m := map[string]int{}
	for rows.Next() {
		var k string
		var n int
		if err := rows.Scan(&k, &n); err != nil {
			t.Fatal(err)
		}
		m[k] = n
	}
	if err := rows.Err(); err != nil {
		t.Fatal(err)
	}
	return m
}

func TestIndependentB2ClosureFullCensusReplayAndNativeRevalidation(t *testing.T) {
	c, route, r, calls := qualificationFailureLoopbackFixture(t)
	var before map[string][]string
	var beforeKinds map[string]int
	hookCount := 0
	c.boundaryHook = func(name string, _ Object) {
		if name == "qualification_plan_frozen" {
			hookCount++
			before = independentB2Census(t, r.f.db)
			beforeKinds = independentB2VersionKinds(t, r.f.db)
		}
	}
	runErr := c.RunAdmitted(context.Background(), route, r.run, r.lease)
	c.boundaryHook = nil
	if runErr == nil || !strings.Contains(runErr.Error(), "qualification grants no unplanned effect authority") || calls.Load() != 1 || hookCount != 1 {
		t.Fatalf("positive gate did not complete: %v calls=%d hooks=%d", runErr, calls.Load(), hookCount)
	}
	epoch, err := Num(r.run, "lease_epoch")
	if err != nil {
		t.Fatal(err)
	}
	check := func() error {
		tx, err := r.f.db.Begin()
		if err != nil {
			return err
		}
		defer tx.Rollback()
		_, err = r.f.s.validatedQualificationFailureTx(tx, r.f.project, Str(r.task, "id"), Str(r.run, "id"), epoch)
		return err
	}
	if err := check(); err != nil {
		t.Fatalf("positive private consumer: %v", err)
	}
	after := independentB2Census(t, r.f.db)
	allowed := map[string]bool{"domain_versions": true, "domain_objects": true, "domain_refs": true, "uploaded_content": true, "runtime_observations": true, "runtime_dispatches": true, "outbox": true, "event_state_snapshots": true, "idempotency": true}
	if len(before) != len(after) {
		t.Fatal("closure altered table schema")
	}
	changed := []string{}
	for name, rows := range before {
		if !reflect.DeepEqual(rows, after[name]) {
			changed = append(changed, name)
			if !allowed[name] {
				t.Errorf("unexpected logical table mutation %s", name)
			}
		}
	}
	sort.Strings(changed)
	if len(after["domain_versions"])-len(before["domain_versions"]) != 5 || len(after["uploaded_content"])-len(before["uploaded_content"]) != 1 {
		t.Fatal("closure exact five versions / one upload mismatch")
	}
	kinds := independentB2VersionKinds(t, r.f.db)
	wantKinds := map[string]bool{"Artifact": true, "ImpactLink": true, "Run": true, "ProjectState": true, "EventEnvelope": true}
	for k, n := range kinds {
		delta := n - beforeKinds[k]
		if wantKinds[k] {
			if delta != 1 {
				t.Errorf("version %s delta=%d", k, delta)
			}
		} else if delta != 0 {
			t.Errorf("unexpected version kind %s delta=%d", k, delta)
		}
	}
	t.Logf("all-table logical census=%d changed=%v; exact five version kinds + one upload", len(before), changed)
	var locator, manifestHash, markerBefore string
	if err := r.f.db.QueryRow("SELECT journal_locator,manifest_hash FROM runtime_dispatches WHERE project=? AND run=?", r.f.project, r.run["id"]).Scan(&locator, &manifestHash); err != nil {
		t.Fatal(err)
	}
	if err := r.f.db.QueryRow("SELECT body FROM idempotency WHERE project=? AND operation='host:qualification-failure-closure'", r.f.project).Scan(&markerBefore); err != nil {
		t.Fatal(err)
	}
	directory := filepath.Join(c.config.DataRoot, "runtime-dispatches", locator)
	facts, err := rt.ReadQualificationNativeFacts(directory, manifestHash)
	if err != nil {
		t.Fatal(err)
	}
	if facts.Journal.Frames != 3 || facts.Journal.Acknowledged != 2 || facts.Journal.ProtocolComplete || calls.Load() != 1 {
		t.Fatal("raw3/ACK2/one model positive changed")
	}
	receipt, err := Decode(facts.Rejection)
	if err != nil {
		t.Fatal(err)
	}
	bridge := new(rt.Bridge)
	field := reflect.ValueOf(bridge).Elem().FieldByName("directory")
	reflect.NewAt(field.Type(), unsafe.Pointer(field.UnsafeAddr())).Elem().SetString(directory)
	denial := &qualificationPreEffectRejection{receipt: receipt, digest: Hash(receipt), cause: errors.New("independent replay")}
	if err := c.closeOnlineQualificationFailure(context.Background(), route, Str(r.run, "id"), epoch, locator, bridge, denial, qualificationBrokerDrain{}); err != nil {
		t.Fatal(err)
	}
	if got := independentB2Census(t, r.f.db); !reflect.DeepEqual(got, after) || calls.Load() != 1 {
		t.Fatal("exact completed-marker replay altered full logical census")
	}
	t.Log("completed-marker actual closure replay zero logical delta across all tables")
	for _, cut := range []struct{ name, path string }{
		{"receipt_id", "$.receipt.receipt_id"}, {"request_body", "$.payload.payload.body.model"}, {"request_hash", "$.request_hash"}, {"route", "$.payload.route"}, {"credential_revision", "$.payload.credential_revision"}, {"key", "$.key"}, {"history", "$.sequence"},
	} {
		t.Run(cut.name, func(t *testing.T) {
			tx, err := r.f.db.Begin()
			if err != nil {
				t.Fatal(err)
			}
			defer tx.Rollback()
			qualificationDropTableTriggers(t, tx, "resource_effects")
			result, err := tx.Exec("UPDATE resource_effects SET body=json_set(body,?,'independent-forged') WHERE project=? AND run=? AND json_extract(body,'$.state')='CONFIRMED'", cut.path, r.f.project, r.run["id"])
			if err != nil {
				t.Fatal(err)
			}
			if n, err := result.RowsAffected(); err != nil || n != 1 {
				t.Fatalf("mutation rows=%d err=%v", n, err)
			}
			if _, err := r.f.s.validatedQualificationFailureTx(tx, r.f.project, Str(r.task, "id"), Str(r.run, "id"), epoch); err == nil {
				t.Fatal("private consumer accepted independent DB tamper")
			}
		})
	}
	if err := check(); err != nil {
		t.Fatal("rollback did not restore baseline", err)
	}
	for _, name := range []string{"stdout.raw", "stderr.raw", "bridge.json", "qualification-rejection-00000000000000000003.json"} {
		t.Run("raw_"+name, func(t *testing.T) {
			path := filepath.Join(directory, name)
			original, err := os.ReadFile(path)
			if err != nil {
				t.Fatal(err)
			}
			defer func() {
				if err := os.WriteFile(path, original, 0600); err != nil {
					t.Error(err)
				}
			}()
			if err := os.WriteFile(path, append(append([]byte(nil), original...), byte('x')), 0600); err != nil {
				t.Fatal(err)
			}
			if name != "qualification-rejection-00000000000000000003.json" {
				if _, err := rt.ReadQualificationNativeFacts(directory, manifestHash); err == nil {
					t.Fatal("tamper did not trip native source reader")
				}
			}
			if err := check(); err == nil {
				t.Errorf("private consumer accepted changed original %s while sealed marker/proof/DB were unchanged", name)
			}
		})
	}
	if err := check(); err != nil {
		t.Fatal("raw restore did not restore baseline", err)
	}
	var markerAfter string
	if err := r.f.db.QueryRow("SELECT body FROM idempotency WHERE project=? AND operation='host:qualification-failure-closure'", r.f.project).Scan(&markerAfter); err != nil {
		t.Fatal(err)
	}
	if markerBefore != markerAfter || !reflect.DeepEqual(after, independentB2Census(t, r.f.db)) || calls.Load() != 1 {
		t.Fatal("independent cuts changed baseline DB/marker or repeated MODEL")
	}
	t.Log(fmt.Sprintf("preserved full database/marker and one controlled-loopback MODEL after cuts"))
}

//go:build windows

package runtime

import (
	"golang.org/x/sys/windows"
	"os"
	"os/user"
	"path/filepath"
	"testing"
)

func independentB2SetACL(t *testing.T, path, sddl string) {
	t.Helper()
	sd, err := windows.SecurityDescriptorFromString(sddl)
	if err != nil {
		t.Fatal(err)
	}
	acl, _, err := sd.DACL()
	if err != nil {
		t.Fatal(err)
	}
	if err := windows.SetNamedSecurityInfo(path, windows.SE_FILE_OBJECT, windows.DACL_SECURITY_INFORMATION|windows.PROTECTED_DACL_SECURITY_INFORMATION, nil, nil, acl, nil); err != nil {
		t.Fatal(err)
	}
}
func TestIndependentB2NativeACLAndIdentityContinuity(t *testing.T) {
	current, err := user.Current()
	if err != nil {
		t.Fatal(err)
	}
	sid, err := windows.StringToSid(current.Uid)
	if err != nil {
		t.Fatal(err)
	}
	for _, cut := range []struct {
		name, acl string
		accept    bool
	}{
		{"safe_file_all", "(A;OICI;FA;;;" + current.Uid + ")", true},
		{"safe_generic_all", "(A;OICI;GA;;;" + current.Uid + ")", true},
		{"world_write_dac", "(A;OICI;FA;;;" + current.Uid + ")(A;;WD;;;WD)", false},
		{"world_generic_all", "(A;OICI;FA;;;" + current.Uid + ")(A;;GA;;;WD)", false},
		{"inherit_only_owner", "(A;OIIO;FA;;;" + current.Uid + ")", false},
		{"unsupported_deny", "(D;;WD;;;WD)(A;OICI;FA;;;" + current.Uid + ")", false},
		{"system_extra_principal", "(A;OICI;FA;;;" + current.Uid + ")(A;;FA;;;SY)", false},
	} {
		t.Run(cut.name, func(t *testing.T) {
			directory := t.TempDir()
			independentB2SetACL(t, directory, "D:P"+cut.acl)
			defer func() {
				if _, err := PrivateDirectory(directory); err != nil {
					t.Error(err)
				}
			}()
			g, err := qualificationGuardDirectory(directory, true)
			if g != nil {
				defer g.Close()
			}
			if (err == nil) != cut.accept {
				t.Fatalf("accept=%t error=%v", cut.accept, err)
			}
		})
	}
	t.Run("native_locks_across_read_write_flush", func(t *testing.T) {
		root := t.TempDir()
		directory := filepath.Join(root, "dispatch")
		if err := os.Mkdir(directory, 0700); err != nil {
			t.Fatal(err)
		}
		if _, err := PrivateDirectory(directory); err != nil {
			t.Fatal(err)
		}
		guard, err := qualificationGuardDirectory(directory, true)
		if err != nil {
			t.Fatal(err)
		}
		defer guard.Close()
		if err := os.Rename(root, root+"-moved"); err == nil {
			t.Fatal("held ancestor could be renamed")
		}
		if err := os.Rename(directory, directory+"-moved"); err == nil {
			t.Fatal("held directory could be renamed")
		}
		path := filepath.Join(directory, "fact.json")
		f, err := qualificationOpenSource(path, sid, true)
		if err != nil {
			t.Fatal(err)
		}
		raw := []byte("{\"independent\":true}")
		if _, err := f.file.Write(raw); err != nil {
			t.Fatal(err)
		}
		if err := os.WriteFile(path, []byte("replaced"), 0600); err == nil {
			t.Fatal("write-open allowed competing writer")
		}
		if err := os.Remove(path); err == nil {
			t.Fatal("write-open allowed deletion")
		}
		if err := f.file.Sync(); err != nil {
			t.Fatal(err)
		}
		if err := f.Check(); err != nil {
			t.Fatal(err)
		}
		if err := guard.Check(); err != nil {
			t.Fatal(err)
		}
		if err := f.file.Close(); err != nil {
			t.Fatal(err)
		}
		reader, err := qualificationOpenSource(path, sid, false)
		if err != nil {
			t.Fatal(err)
		}
		defer reader.file.Close()
		if err := os.WriteFile(path, []byte("replaced"), 0600); err == nil {
			t.Fatal("read-open allowed competing writer")
		}
		if err := os.Rename(path, path+".moved"); err == nil {
			t.Fatal("read-open allowed rename")
		}
		got, err := reader.ReadBounded(1024)
		if err != nil || string(got) != string(raw) {
			t.Fatalf("native continuous bytes: %s %v", got, err)
		}
	})
}

//go:build windows

package runtime

import (
	"golang.org/x/sys/windows"
	"os"
	"os/user"
	"path/filepath"
	"testing"
)

func TestIndependentB2GuardNamespaceSwap(t *testing.T) {
	root := t.TempDir()
	directory := filepath.Join(root, "dispatch")
	if err := os.Mkdir(directory, 0700); err != nil {
		t.Fatal(err)
	}
	if _, err := PrivateDirectory(directory); err != nil {
		t.Fatal(err)
	}
	guard, err := qualificationGuardDirectory(directory, true)
	if err != nil {
		t.Fatal(err)
	}
	defer guard.Close()
	heldID := guard.ids[len(guard.ids)-1]
	moved := directory + "-held"
	if err := os.Rename(directory, moved); err != nil {
		t.Logf("native no-delete guard prevented namespace change: %v", err)
		return
	}
	if err := os.Mkdir(directory, 0700); err != nil {
		t.Fatal(err)
	}
	if _, err := PrivateDirectory(directory); err != nil {
		t.Fatal(err)
	}
	replacement, err := qualificationGuardDirectory(directory, true)
	if err != nil {
		t.Fatal(err)
	}
	defer replacement.Close()
	newID := replacement.ids[len(replacement.ids)-1]
	if heldID == newID {
		t.Fatal("namespace mutation did not change selected file identity")
	}
	checkErr := guard.Check()
	path := filepath.Join(directory, qualificationRejectionFile)
	file, err := qualificationOpenSource(path, guard.current, true)
	if err != nil {
		t.Fatal(err)
	}
	raw := []byte("{\"replacement_namespace\":true}")
	if _, err := file.file.Write(raw); err != nil {
		t.Fatal(err)
	}
	if err := file.file.Sync(); err != nil {
		t.Fatal(err)
	}
	fileCheck := file.Check()
	if err := file.file.Close(); err != nil {
		t.Fatal(err)
	}
	oldBytes, oldErr := os.ReadFile(filepath.Join(moved, qualificationRejectionFile))
	newBytes, newErr := os.ReadFile(path)
	if !os.IsNotExist(oldErr) || newErr != nil || string(newBytes) != string(raw) || len(oldBytes) != 0 {
		t.Fatalf("namespace cut not realized: old=%v new=%v", oldErr, newErr)
	}
	t.Logf("held native directory id=%+v replacement id=%+v; write+flush landed only in replacement namespace; guard.Check=%v file.Check=%v", heldID, newID, checkErr, fileCheck)
	if checkErr == nil && fileCheck == nil {
		t.Fatal("original directory guard accepted replacement pathname identity")
	}
}

func TestIndependentB2FileHandlesRetainContent(t *testing.T) {
	directory := t.TempDir()
	if _, err := PrivateDirectory(directory); err != nil {
		t.Fatal(err)
	}
	current, err := user.Current()
	if err != nil {
		t.Fatal(err)
	}
	sid, err := windows.StringToSid(current.Uid)
	if err != nil {
		t.Fatal(err)
	}
	guard, err := qualificationGuardDirectory(directory, true)
	if err != nil {
		t.Fatal(err)
	}
	defer guard.Close()
	path := filepath.Join(directory, "fact.json")
	f, err := qualificationOpenSource(path, sid, true)
	if err != nil {
		t.Fatal(err)
	}
	raw := []byte("{\"continuous\":true}")
	if _, err := f.file.Write(raw); err != nil {
		t.Fatal(err)
	}
	if err := os.WriteFile(path, []byte("replaced"), 0600); err == nil {
		t.Fatal("write-open allowed competing writer")
	}
	if err := os.Remove(path); err == nil {
		t.Fatal("write-open allowed deletion")
	}
	if err := f.file.Sync(); err != nil {
		t.Fatal(err)
	}
	if err := f.Check(); err != nil {
		t.Fatal(err)
	}
	if err := guard.Check(); err != nil {
		t.Fatal(err)
	}
	if err := f.file.Close(); err != nil {
		t.Fatal(err)
	}
	reader, err := qualificationOpenSource(path, sid, false)
	if err != nil {
		t.Fatal(err)
	}
	defer reader.file.Close()
	if err := os.WriteFile(path, []byte("replaced"), 0600); err == nil {
		t.Fatal("read-open allowed competing writer")
	}
	if err := os.Rename(path, path+".moved"); err == nil {
		t.Fatal("read-open allowed rename")
	}
	got, err := reader.ReadBounded(1024)
	if err != nil || string(got) != string(raw) {
		t.Fatalf("native read/write/flush continuity: %s %v", got, err)
	}
	t.Log("native writer/read handles blocked competing writes and file delete/rename; original bytes and identity survived write+flush+read")
}

