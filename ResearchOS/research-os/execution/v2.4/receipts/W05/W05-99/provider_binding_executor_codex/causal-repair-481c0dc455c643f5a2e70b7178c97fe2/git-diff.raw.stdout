+// One process executes exactly one explicitly supplied, hashed public archive
+// control. The driver stops on its first unexpected result. This never calls a
+// coordinator, native worker, qualification helper or HTTP client/server.
+func TestProviderBindingInventoryCausalControl(t *testing.T) {
+	raw, err := os.ReadFile(os.Getenv("RESEARCHOS_PROVIDER_CAUSAL_CASE"))
+	if err != nil {
+		t.Fatal("explicit zero-model control specification required", err)
+	}
+	spec, err := Decode(raw)
+	if err != nil {
+		t.Fatal(err)
+	}
+	input, err := os.ReadFile(Str(spec, "input"))
+	if err != nil || Digest(input) != spec["input_sha256"] {
+		t.Fatal("sealed public input mismatch", err)
+	}
+	dir := Str(spec, "output")
+	if err = os.Mkdir(dir, 0700); err != nil {
+		t.Fatal("new immutable case directory required", err)
+	}
+	path := filepath.Join(dir, "case.sqlite")
+	if err = os.WriteFile(path, input, 0600); err != nil {
+		t.Fatal(err)
+	}
+	db, err := store.Open(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	result := Object{"case": spec["case"], "mutation": spec["mutation"], "input_sha256": Digest(input), "mode": "ZERO_MODEL_PUBLIC_ARCHIVE_CONTROL", "http_calls": 0, "model_calls": 0, "worker_starts": 0}
+	t.Cleanup(func() {
+		if _, e := db.Exec(`PRAGMA wal_checkpoint(TRUNCATE)`); e != nil {
+			t.Error(e)
+		}
+		if e := db.Close(); e != nil {
+			t.Error(e)
+		}
+		closed, e := os.ReadFile(path)
+		if e != nil {
+			t.Error(e)
+		}
+		result["closed_db_sha256"] = Digest(closed)
+		original, e := os.ReadFile(Str(spec, "input"))
+		if e != nil || Digest(original) != spec["input_sha256"] {
+			t.Error("source input drift", e)
+		}
+		result["input_after_sha256"] = Digest(original)
+		result["test_failed"] = t.Failed()
+		if e = os.WriteFile(filepath.Join(dir, "actual.json"), Bytes(result), 0600); e != nil {
+			t.Error(e)
+		}
+	})
+	// Preserve and restore all original triggers, including unrelated ones:
+	// acceptance cannot be attributed to a weakened trigger inventory.
+	readTriggers := func() Object {
+		rows, e := db.Query(`SELECT name,sql FROM sqlite_master WHERE type='trigger' ORDER BY name`)
+		if e != nil {
+			t.Fatal(e)
+		}
+		out := Object{}
+		for rows.Next() {
+			var name, statement string
+			if e = rows.Scan(&name, &statement); e != nil {
+				t.Fatal(e)
+			}
+			out[name] = statement
+		}
+		e = rows.Err()
+		rows.Close()
+		if e != nil {
+			t.Fatal(e)
+		}
+		return out
+	}
+	triggers := readTriggers()
+	result["original_triggers"] = triggers
+	mode := Str(spec, "mutation")
+	if mode != "none" {
+		for name := range triggers {
+			if _, err = db.Exec(`DROP TRIGGER "` + strings.ReplaceAll(name, `"`, `""`) + `"`); err != nil {
+				t.Fatal(err)
+			}
+		}
+		statements := []string{}
+		switch mode {
+		case "missing-dispatch-transport":
+			statements = []string{`DELETE FROM runtime_dispatches`, `UPDATE resource_effects SET body=json_remove(body,'$.payload.provider_transport') WHERE json_extract(body,'$.payload.capability')='MODEL'`}
+		case "double-marker":
+			statements = []string{`UPDATE runtime_dispatches SET manifest=json_remove(manifest,'$.admission.profile.model_config.provider_policy')`, `UPDATE resource_effects SET body=json_remove(body,'$.payload.provider_transport') WHERE json_extract(body,'$.payload.capability')='MODEL'`}
+		case "missing-admission", "missing-profile-ref", "missing-runtime-ref":
+			field := map[string]string{"missing-admission": "$.admission", "missing-profile-ref": "$.admission.profile_ref", "missing-runtime-ref": "$.admission.runtime_ref"}[mode]
+			statements = []string{`UPDATE runtime_dispatches SET manifest=json_remove(manifest,'` + field + `')`, `UPDATE resource_effects SET body=json_remove(body,'$.payload.provider_transport') WHERE json_extract(body,'$.payload.capability')='MODEL'`}
+		case "missing-binding":
+			statements = []string{`DELETE FROM runtime_bindings`}
+		case "missing-qualification":
+			statements = []string{`DELETE FROM runtime_qualification_runs`, `DELETE FROM runtime_qualification_plans`}
+		case "forged-fixture-deleted-native":
+			statements = []string{`INSERT OR IGNORE INTO orchestration_fixtures(project,runtime) SELECT project,runtime FROM runtime_bindings`, `DELETE FROM runtime_dispatches`, `DELETE FROM runtime_bindings`, `DELETE FROM runtime_qualification_runs`, `DELETE FROM runtime_qualification_plans`, `UPDATE resource_effects SET body=json_remove(body,'$.payload.provider_transport')`}
+		case "missing-all-run-history":
+			statements = []string{`DELETE FROM domain_versions WHERE kind='Run'`, `DELETE FROM runtime_dispatches`, `DELETE FROM runtime_bindings`, `UPDATE resource_effects SET body=json_remove(body,'$.payload.provider_transport')`}
+		case "cross-run":
+			statements = []string{`UPDATE runtime_dispatches SET manifest=json_set(manifest,'$.run_id','foreign-run')`}
+		case "foreign-runtime-ref":
+			statements = []string{`UPDATE runtime_dispatches SET manifest=json_set(manifest,'$.admission.runtime_ref.id','foreign-runtime')`}
+		case "ambiguous-epoch":
+			statements = []string{`UPDATE domain_versions SET body=json_set(body,'$.runtime_id','foreign-runtime') WHERE kind='Run' AND revision=(SELECT max(v.revision) FROM domain_versions v WHERE v.project=domain_versions.project AND v.kind='Run' AND v.id=domain_versions.id)`}
+		case "wrong-request-hash":
+			statements = []string{`UPDATE resource_effects SET body=json_set(body,'$.request_hash','sha256:forged')`}
+		case "changed-capability":
+			statements = []string{`UPDATE resource_effects SET body=json_set(body,'$.payload.capability','TOOL') WHERE json_extract(body,'$.payload.capability')='MODEL'`}
+		case "changed-key-and-capability":
+			statements = []string{`UPDATE resource_effects SET effect_key=replace(effect_key,':model:',':tool:'),body=json_set(body,'$.key',replace(effect_key,':model:',':tool:'),'$.payload.capability','TOOL') WHERE json_extract(body,'$.payload.capability')='MODEL'`}
+		case "sparse-sequence":
+			statements = []string{`UPDATE resource_effects SET sequence=sequence+100,body=json_set(body,'$.sequence',sequence+100)`}
+		case "no-prepared":
+			statements = []string{`DELETE FROM resource_effects WHERE sequence=1`}
+		case "wrong-epoch":
+			statements = []string{`UPDATE resource_effects SET body=json_set(body,'$.epoch',999)`}
+		case "wrong-sql-key":
+			statements = []string{`UPDATE resource_effects SET effect_key='foreign-'||effect_key`}
+		default:
+			t.Fatal("unregistered control mutation", mode)
+		}
+		result["mutation_statements"] = statements
+		for _, statement := range statements {
+			if _, err = db.Exec(statement); err != nil {
+				t.Fatal("explicit corruption setup", err)
+			}
+		}
+		// Rehash altered dispatches so the semantic provenance guard, rather
+		// than only the preexisting manifest digest guard, must reject them.
+		rows, e := db.Query(`SELECT project,run,epoch,manifest FROM runtime_dispatches`)
+		if e != nil {
+			t.Fatal(e)
+		}
+		manifests := []Object{}
+		for rows.Next() {
+			var p, r, text string
+			var epoch int64
+			if e = rows.Scan(&p, &r, &epoch, &text); e != nil {
+				t.Fatal(e)
+			}
+			m, e := Decode([]byte(text))
+			if e != nil {
+				t.Fatal(e)
+			}
+			manifests = append(manifests, Object{"project": p, "run": r, "epoch": epoch, "hash": Hash(m)})
+		}
+		e = rows.Err()
+		rows.Close()
+		if e != nil {
+			t.Fatal(e)
+		}
+		for _, m := range manifests {
+			if _, err = db.Exec(`UPDATE runtime_dispatches SET manifest_hash=? WHERE project=? AND run=? AND epoch=?`, m["hash"], m["project"], m["run"], m["epoch"]); err != nil {
+				t.Fatal(err)
+			}
+		}
+		for _, statement := range triggers {
+			if _, err = db.Exec(statement.(string)); err != nil {
+				t.Fatal(err)
+			}
+		}
+	}
+	result["triggers_after"] = readTriggers()
+	if Hash(result["triggers_after"]) != Hash(triggers) {
+		t.Fatal("original trigger inventory not restored")
+	}
+	tx, err := db.Begin()
+	if err != nil {
+		t.Fatal(err)
+	}
+	inventory, inventoryErr := validateProviderInventory(tx, "", "")
+	if err = tx.Rollback(); err != nil {
+		t.Fatal(err)
+	}
+	backupErr := validateModelStreamBackup(db)
+	result["inventory"] = inventory
+	result["inventory_count"] = len(inventory)
+	result["inventory_error"], result["stream_backup_error"] = nil, nil
+	if inventoryErr != nil {
+		result["inventory_error"] = inventoryErr.Error()
+	}
+	if backupErr != nil {
+		result["stream_backup_error"] = backupErr.Error()
+	}
+	if spec["want_error"] == true {
+		if inventoryErr == nil || backupErr == nil {
+			t.Fatal("unexpected corrupted original accepted", inventoryErr, backupErr)
+		}
+	} else if inventoryErr != nil || backupErr != nil || len(inventory) == 0 {
+		t.Fatal("unexpected sealed original rejected/empty", inventoryErr, backupErr, len(inventory))
+	}
+}
+
+func TestProviderBindingInventorySyntheticProvenance(t *testing.T) {
+	// SYNTHETIC_NOT_PRODUCT: focused original-reference compatibility, without
+	// qualification, model transport or a claim that this is a historical DB.
+	dir := os.Getenv("RESEARCHOS_PROVIDER_SYNTHETIC_DIR")
+	mode := os.Getenv("RESEARCHOS_PROVIDER_SYNTHETIC_MODE")
+	if dir == "" || os.Mkdir(dir, 0700) != nil {
+		t.Fatal("new synthetic evidence directory required")
+	}
+	db, err := store.Open(filepath.Join(dir, "synthetic.sqlite"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	files, err := filepath.Glob(filepath.Join("..", "..", "migrations", "sqlite", "[0-9][0-9][0-9][0-9]_*.sql"))
+	if err != nil || len(files) == 0 {
+		t.Fatal("actual numbered SQL required", err)
+	}
+	for _, name := range files {
+		raw, e := os.ReadFile(name)
+		if e != nil {
+			t.Fatal(e)
+		}
+		if _, e = db.Exec(string(raw)); e != nil {
+			t.Fatal(name, e)
+		}
+	}
+	project := "synthetic-provider-inventory"
+	runtime := Object{"project_id": project, "id": "runtime", "revision": 1, "adapter": "fixture", "measurement_mode": "FIXTURE", "qualification_ids": Empty()}
+	run := Object{"project_id": project, "id": "run", "revision": 1, "task_id": "task", "runtime_id": "runtime", "lease_epoch": 1, "created_at": "2026-01-01T00:00:00Z", "executor_principal_id": "synthetic"}
+	profile := Object{"runtime_id": "runtime", "technical_hash": runtimeTechnicalHash(runtime), "model_config": Object{"provider": "legacy-fixture"}}
+	content := Bytes(profile)
+	artifact := Object{"project_id": project, "id": "profile", "revision": 1, "storage_key": "synthetic-profile", "content_hash": Digest(content)}
+	for kind, value := range map[string]Object{"Run": run, "RuntimeRegistration": runtime, "Artifact": artifact} {
+		if _, err = db.Exec(`INSERT INTO domain_versions(project,kind,id,revision,body,content_hash) VALUES(?,?,?,?,?,?)`, project, kind, value["id"], 1, string(Bytes(value)), value["content_hash"]); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if _, err = db.Exec(`INSERT INTO auth_principals(id,roles) VALUES('synthetic','["EXECUTOR"]')`); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = db.Exec(`INSERT INTO uploaded_content(storage_key,project,principal,bytes,content_hash,expires_at,sealed) VALUES(?,?,'synthetic',?,?,'2099-01-01T00:00:00Z',1)`, artifact["storage_key"], project, content, artifact["content_hash"]); err != nil {
+		t.Fatal(err)
+	}
+	ref := Ref(artifact, "Artifact")
+	if _, err = db.Exec(`INSERT INTO runtime_bindings(project,runtime,profile_ref,profile_hash,technical_hash,owner) VALUES(?,?,?,?,?,?)`, project, "runtime", string(Bytes(ref)), Hash(ref), runtimeTechnicalHash(runtime), "synthetic"); err != nil {
+		t.Fatal(err)
+	}
+	manifest := Object{"project_id": project, "run_id": "run", "task_id": "task", "runtime_id": "runtime", "executor_principal_id": "synthetic", "epoch": 1, "dispatch_key": "dispatch", "admission": Object{"runtime_ref": Ref(runtime, "RuntimeRegistration"), "profile_ref": ref, "profile_hash": Hash(ref), "profile": profile, "technical_hash": runtimeTechnicalHash(runtime), "mode": "FIXTURE"}}
+	if mode != "generic-missing-ref" {
+		if _, err = db.Exec(`INSERT INTO runtime_dispatches(project,run,epoch,dispatch_key,manifest,manifest_hash,state,prepared_at,updated_at) VALUES(?,?,?,?,?,?,'PREPARED','synthetic','synthetic')`, project, "run", 1, "dispatch", string(Bytes(manifest)), Hash(manifest)); err != nil {
+			t.Fatal(err)
+		}
+	}
+	effect := Object{"project_id": project, "run_id": "run", "task_id": "task", "epoch": 1, "key": "task:run:1:model:1", "sequence": 1, "state": "PREPARED", "payload": Object{"capability": "MODEL"}}
+	if _, err = db.Exec(`INSERT INTO resource_effects(project,run,effect_key,sequence,body) VALUES(?,?,?,?,?)`, project, "run", effect["key"], 1, string(Bytes(effect))); err != nil {
+		t.Fatal(err)
+	}
+	wantError := false
+	switch mode {
+	case "sealed-no-policy":
+	case "later-runtime-revision":
+		later := Merge(runtime, Object{"revision": 2, "adapter": "changed-later"})
+		if _, err = db.Exec(`INSERT INTO domain_versions(project,kind,id,revision,body) VALUES(?,'RuntimeRegistration','runtime',2,?)`, project, string(Bytes(later))); err != nil {
+			t.Fatal(err)
+		}
+		if _, err = db.Exec(`INSERT INTO domain_objects(project,kind,id,revision,body) VALUES(?,'RuntimeRegistration','runtime',2,?)`, project, string(Bytes(later))); err != nil {
+			t.Fatal(err)
+		}
+	case "generic-missing-ref":
+		wantError = true
+		if _, err = db.Exec(`DELETE FROM runtime_bindings`); err != nil {
+			t.Fatal(err)
+		}
+		if _, err = db.Exec(`INSERT INTO orchestration_fixtures(project,runtime) VALUES(?,'runtime')`, project); err != nil {
+			t.Fatal(err)
+		}
+	case "missing-binding":
+		wantError = true
+		if _, err = db.Exec(`DELETE FROM runtime_bindings`); err != nil {
+			t.Fatal(err)
+		}
+	default:
+		t.Fatal("unknown synthetic mode")
+	}
+	tx, err := db.Begin()
+	if err != nil {
+		t.Fatal(err)
+	}
+	inventory, e := validateProviderInventory(tx, project, "run")
+	if err = tx.Rollback(); err != nil {
+		t.Fatal(err)
+	}
+	result := Object{"label": "SYNTHETIC_NOT_PRODUCT", "mode": mode, "inventory": inventory, "want_error": wantError, "error": nil, "models": 0, "workers": 0, "http": 0}
+	if e != nil {
+		result["error"] = e.Error()
+	}
+	if err = os.WriteFile(filepath.Join(dir, "actual.json"), Bytes(result), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if (e != nil) != wantError || len(inventory) != 0 {
+		t.Fatal("unexpected synthetic provenance decision", e, len(inventory))
+	}
+}
