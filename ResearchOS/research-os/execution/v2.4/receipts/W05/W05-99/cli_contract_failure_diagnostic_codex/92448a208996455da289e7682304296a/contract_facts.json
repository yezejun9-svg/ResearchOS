{
  "product_cli": {
    "binary": "researchos",
    "commands": [
      {
        "id": "interactive",
        "syntax": "researchos [--project <path-or-id>]",
        "local_operations": [
          "session.list",
          "session.create",
          "session.attach",
          "session.send"
        ],
        "required": true
      },
      {
        "id": "init",
        "syntax": "researchos init <path>",
        "local_operations": [
          "project.bootstrap"
        ],
        "required": true
      },
      {
        "id": "run",
        "syntax": "researchos run <prompt> --project <id> --output jsonl",
        "local_operations": [
          "session.send",
          "session.events"
        ],
        "required": true
      },
      {
        "id": "goal",
        "syntax": "researchos goal <text> [--project <id>]",
        "local_operations": [
          "goal.start"
        ],
        "required": true
      },
      {
        "id": "resume",
        "syntax": "researchos resume <session-id>",
        "local_operations": [
          "session.attach",
          "session.control"
        ],
        "required": true
      },
      {
        "id": "status",
        "syntax": "researchos status [--project <id>]",
        "local_operations": [
          "session.get",
          "host.status"
        ],
        "required": true
      },
      {
        "id": "cancel",
        "syntax": "researchos cancel <run-or-goal-id>",
        "local_operations": [
          "session.control"
        ],
        "required": true
      },
      {
        "id": "doctor",
        "syntax": "researchos doctor",
        "local_operations": [
          "host.status"
        ],
        "required": true
      },
      {
        "id": "config",
        "syntax": "researchos config",
        "local_operations": [
          "host.configure"
        ],
        "required": true
      }
    ],
    "slash_commands": [
      "/goal",
      "/status",
      "/resume",
      "/cancel",
      "/model",
      "/help"
    ],
    "headless_format": "JSONL",
    "stdout_only_structured_when_jsonl": true,
    "exit_codes": {
      "0": "execution_result_reported; independent acceptance separate",
      "1": "execution_or_check_failed",
      "2": "invalid_input_or_configuration",
      "3": "blocked_missing_resource_or_authorization",
      "130": "cancelled_by_user"
    }
  },
