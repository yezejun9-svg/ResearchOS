          "line": 121,
          "text": "//go:linkname loadsystemlibrary"
        },
        {
          "line": 122,
          "text": "func loadsystemlibrary(filename *uint16) (uintptr, Errno) {"
        },
        {
          "line": 123,
          "text": "\tconst _LOAD_LIBRARY_SEARCH_SYSTEM32 = 0x00000800"
        },
        {
          "line": 124,
          "text": "\thandle, _, err := SyscallN(uintptr(__LoadLibraryExW), uintptr(unsafe.Pointer(filename)), 0, _LOAD_LIBRARY_SEARCH_SYSTEM32)"
        },
        {
          "line": 125,
          "text": "\tif handle != 0 {"
        },
        {
          "line": 126,
          "text": "\t\terr = 0"
        },
        {
          "line": 127,
          "text": "\t}"
        },
        {
          "line": 128,
          "text": "\treturn handle, err"
        },
        {
          "line": 129,
          "text": "}"
        },
        {
          "line": 130,
          "text": ""
        },
        {
          "line": 131,
          "text": "//go:linkname getprocaddress"
        },
        {
          "line": 132,
          "text": "func getprocaddress(handle uintptr, procname *uint8) (uintptr, Errno) {"
        },
        {
          "line": 133,
          "text": "\tproc, _, err := SyscallN(uintptr(__GetProcAddress), handle, uintptr(unsafe.Pointer(procname)))"
        },
        {
          "line": 134,
          "text": "\tif proc != 0 {"
        },
        {
          "line": 135,
          "text": "\t\terr = 0"
        },
        {
          "line": 136,
          "text": "\t}"
        },
        {
          "line": 137,
          "text": "\treturn proc, err"
        },
        {
          "line": 138,
          "text": "}"
        },
        {
          "line": 139,
          "text": ""
        },
        {
          "line": 140,
          "text": "// A DLL implements access to a single DLL."
        },
        {
          "line": 141,
          "text": "type DLL struct {"
        },
        {
          "line": 142,
          "text": "\tName   string"
        },
        {
          "line": 143,
          "text": "\tHandle Handle"
        },
        {
          "line": 144,
          "text": "}"
        },
        {
          "line": 145,
          "text": ""
        },
        {
          "line": 146,
          "text": "// LoadDLL loads the named DLL file into memory."
        },
        {
          "line": 147,
          "text": "//"
        },
        {
          "line": 148,
          "text": "// If name is not an absolute path and is not a known system DLL used by"
        },
        {
          "line": 149,
          "text": "// Go, Windows will search for the named DLL in many locations, causing"
        },
        {
          "line": 150,
          "text": "// potential DLL preloading attacks."
        },
        {
          "line": 151,
          "text": "//"
        },
        {
          "line": 152,
          "text": "// Use [LazyDLL] in golang.org/x/sys/windows for a secure way to"
        },
        {
          "line": 153,
          "text": "// load system DLLs."
        },
        {
          "line": 154,
          "text": "func LoadDLL(name string) (*DLL, error) {"
        },
        {
          "line": 155,
          "text": "\tnamep, err := UTF16PtrFromString(name)"
        },
        {
          "line": 156,
          "text": "\tif err != nil {"
        },
        {
          "line": 157,
          "text": "\t\treturn nil, err"
        },
        {
          "line": 158,
          "text": "\t}"
        },
        {
          "line": 159,
          "text": "\tvar h uintptr"
        },
        {
          "line": 160,
          "text": "\tvar e Errno"
        },
        {
          "line": 161,
          "text": "\tif sysdll.IsSystemDLL[name] {"
        },
        {
          "line": 162,
          "text": "\t\th, e = loadsystemlibrary(namep)"
        },
        {
          "line": 163,
          "text": "\t} else {"
        },
        {
          "line": 164,
          "text": "\t\th, e = loadlibrary(namep)"
        },
        {
          "line": 165,
          "text": "\t}"
        }
      ]
