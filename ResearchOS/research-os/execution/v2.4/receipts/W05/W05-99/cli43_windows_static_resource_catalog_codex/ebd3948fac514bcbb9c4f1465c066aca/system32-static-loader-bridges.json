        },
        {
          "line": 7,
          "text": "// Package sysdll is an internal leaf package that records and reports"
        },
        {
          "line": 8,
          "text": "// which Windows DLL names are used by Go itself. These DLLs are then"
        },
        {
          "line": 9,
          "text": "// only loaded from the System32 directory. See Issue 14959."
        },
        {
          "line": 10,
          "text": "package sysdll"
        },
        {
          "line": 11,
          "text": ""
        },
        {
          "line": 12,
          "text": "// IsSystemDLL reports whether the named dll key (a base name, like"
        },
        {
          "line": 13,
          "text": "// \"foo.dll\") is a system DLL which should only be loaded from the"
        },
        {
          "line": 14,
          "text": "// Windows SYSTEM32 directory."
        },
        {
          "line": 15,
          "text": "//"
        },
        {
          "line": 16,
          "text": "// Filenames are case sensitive, but that doesn't matter because"
        },
        {
          "line": 17,
          "text": "// the case registered with Add is also the same case used with"
        },
        {
          "line": 18,
          "text": "// LoadDLL later."
        },
        {
          "line": 19,
          "text": "//"
        },
        {
          "line": 20,
          "text": "// It has no associated mutex and should only be mutated serially"
        },
        {
          "line": 21,
          "text": "// (currently: during init), and not concurrent with DLL loading."
        },
        {
          "line": 22,
          "text": "var IsSystemDLL = map[string]bool{}"
        },
        {
          "line": 23,
          "text": ""
        },
        {
          "line": 24,
          "text": "// Add notes that dll is a system32 DLL which should only be loaded"
        },
        {
          "line": 25,
          "text": "// from the Windows SYSTEM32 directory. It returns its argument back,"
        },
        {
          "line": 26,
          "text": "// for ease of use in generated code."
        },
        {
          "line": 27,
          "text": "func Add(dll string) string {"
        },
        {
          "line": 28,
          "text": "\tIsSystemDLL[dll] = true"
        },
        {
          "line": 29,
          "text": "\treturn dll"
        },
        {
          "line": 30,
          "text": "}"
        }
      ]
    },
