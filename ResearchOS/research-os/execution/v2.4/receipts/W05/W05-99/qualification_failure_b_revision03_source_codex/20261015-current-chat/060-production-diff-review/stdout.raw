 func (c qualificationFailureClosure) proofRef() Object                     { return c.proofValue }
 func (c qualificationFailureClosure) subject() qualificationFailureSubject { return c.subjectValue }
+func (c qualificationFailureClosure) Check() error {
+	if c.nativeHold == nil {
+		return qualificationDenialUnavailable("native source hold missing")
+	}
+	return c.nativeHold.Check()
+}
+func (c qualificationFailureClosure) Close() error { return c.nativeHold.Close() }
+
+// The raw files are read again at private consumption. Raw byte digests bind
+// bridge/stdout/stderr, while the decoded frame/rejection objects use the
+// canonical domain hash. The original rejection bytes equal the persisted
+// canonical receipt bytes; changing only its whitespace is still drift.
+func qualificationNativeClosureMatches(facts rt.QualificationNativeFacts, proof, marker, rejection, observation, qf, native, broker, dispatch, modelBinding map[string]any) bool {
+	j := facts.Journal
+	if facts.RawJournalHash != native["journal_hash"] || facts.StdoutHash != native["stdout_hash"] || facts.StderrHash != native["stderr_hash"] || facts.StdoutHash != j.StdoutHash || facts.StderrHash != j.StderrHash || facts.RawJournalHash != qf["raw_bridge_hash"] || facts.StdoutHash != qf["raw_stdout_hash"] || facts.StderrHash != qf["raw_stderr_hash"] {
+		return false
+	}
+	if j.DispatchKey != dispatch["dispatch_key"] || j.ManifestHash != dispatch["manifest_hash"] || j.Worker != dispatch["worker"] || Hash(runtimeNativeIdentity(j.Identity)) != Hash(dispatch["identity"]) || j.Ended != native["ended"] || j.Ended != qf["native_ended"] || j.Cancelled != true || j.Cancelled != native["cancelled"] || j.Cancelled != qf["raw_cancelled"] || j.Receipt.TimedOut != native["timed_out"] || j.Receipt.TimedOut != qf["raw_timed_out"] || Hash(j.Receipt.ExitCode) != Hash(native["exit_code"]) || Hash(j.Receipt.ExitCode) != Hash(qf["raw_exit_code"]) || j.Frames != 3 || j.Acknowledged != 2 || j.QueueRequired || j.QueueInitSequence != 0 || len(j.CommandReceipts) != 0 || j.Checkpoint != nil || j.CheckpointSequence != 0 || j.Paused || j.ProtocolComplete || facts.AuxAfterThird || (j.State != "FAILED" && j.State != "UNKNOWN") || j.Reason != "qualification first dispatch gate denied TOOL" || !j.Receipt.Stopped || !j.Receipt.StreamsDrained || !j.Receipt.CleanupComplete || !j.Receipt.OutputCopied {
+		return false
+	}
+	if len(facts.Frames) != 3 || len(facts.FrameHashes) != 3 || Hash(j.Frames) != Hash(native["frames"]) || Hash(j.Acknowledged) != Hash(native["acknowledged"]) || observation["children_stopped"] != j.Receipt.Stopped || observation["streams_drained"] != j.Receipt.StreamsDrained || observation["cleanup_complete"] != j.Receipt.CleanupComplete {
+		return false
+	}
+	f1, f2, f3 := facts.Frames[0], facts.Frames[1], facts.Frames[2]
+	frameHashes, hashesOK := broker["frame_hashes"].(map[string]any)
+	if !hashesOK || f1.Sequence != 1 || f1.Type != "context.ready" || f2.Sequence != 2 || f2.Type != "effect.request" || f2.Capability != "MODEL" || f3.Sequence != 3 || f3.Type != "effect.request" || f3.Capability != "TOOL" || f2.Key == "" || f3.Key == "" || f2.Key == f3.Key || f2.Key != proof["model_effect_key"] || f2.Route != proof["model_route"] || f3.Key != proof["rejected_effect_key"] || f3.Route != f2.Route || Hash(f2) != frameHashes["2"] || Hash(f3) != frameHashes["3"] || Hash(qf["frame_hashes"]) != Hash([]any{Hash(f1), Hash(f2), Hash(f3)}) || Hash(f3) != rejection["frame_hash"] || Digest(f3.Payload) != rejection["raw_payload_hash"] || f3.Key != rejection["frame_key"] || f3.Route != rejection["frame_route"] {
+		return false
+	}
+	modelPayload, modelErr := Decode(f2.Payload)
+	rejectedPayload, rejectedErr := Decode(f3.Payload)
+	if modelErr != nil || rejectedErr != nil || Hash(modelPayload) != modelBinding["payload_hash"] || Hash(rejectedPayload) != rejection["payload_hash"] {
+		return false
+	}
+	decodedRejection, err := Decode(facts.Rejection)
+	if err != nil || !bytes.Equal(facts.Rejection, Bytes(Object(rejection))) || Hash(decodedRejection) != marker["denial_digest"] || Hash(decodedRejection) != Hash(rejection) || rejection["first_cause"] != qf["original_cause"] {
+		return false
+	}
+	rawObservation, err := j.Observation()
+	if err != nil {
+		return false
+	}
+	for _, key := range []string{"spec", "dispatch_key", "manifest_hash", "worker", "identity", "observation_sequence", "reason", "children_stopped", "streams_drained", "cleanup_complete", "exit_code", "ended", "artifacts", "stdout_hash", "stderr_hash"} {
+		if Hash(rawObservation[key]) != Hash(observation[key]) {
+			return false
+		}
+	}
+	return true
+}
 
