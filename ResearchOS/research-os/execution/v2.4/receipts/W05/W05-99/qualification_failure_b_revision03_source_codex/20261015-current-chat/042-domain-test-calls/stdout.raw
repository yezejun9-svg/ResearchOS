420: 		if err := r.f.db.QueryRow(`SELECT body FROM domain_versions WHERE project=? AND kind=? AND id=? ORDER BY revision DESC LIMIT 1`, r.f.project, row.kind, row.id).Scan(&currentRaw); err != nil {
421: 			t.Fatal(err)
422: 		}
423: 		if err := r.f.db.QueryRow(`SELECT body FROM domain_versions WHERE project=? AND kind=? AND id=? ORDER BY revision DESC LIMIT 1 OFFSET 1`, r.f.project, row.kind, row.id).Scan(&previousRaw); err != nil {
424: 			t.Fatal(err)
425: 		}
426: 		previous, previousErr := Decode([]byte(previousRaw))
427: 		current, currentErr := Decode([]byte(currentRaw))
428: 		if previousErr != nil || currentErr != nil || Hash(previous) != row.beforeHash || current["updated_at"] != core["observed_at"] {
429: 			t.Fatalf("closure %s did not add one bound version", row.kind)
430: 		}
431: 	}
432: 	var money, operation string
433: 	if scanErr := r.f.db.QueryRow("SELECT coalesce(json_extract(body,'$.money'),'null'),json_extract(body,'$.operation') FROM domain_objects WHERE kind='BudgetLedgerEntry' AND json_extract(body,'$.run_id')=?", r.run["id"]).Scan(&money, &operation); scanErr != nil || money != "null" || operation != "UNKNOWN" {
434: 		t.Fatalf("unknown cost changed: money=%s operation=%s err=%v", money, operation, scanErr)
435: 	}
436: 	epoch, err := Num(r.run, "lease_epoch")
437: 	if err != nil {
438: 		t.Fatal(err)
439: 	}
440: 	sourceTx(t, r.f.db, func(tx *sql.Tx) error {
441: 		_, verifyErr := r.f.s.validatedQualificationFailureTx(tx, r.f.project, Str(r.task, "id"), Str(r.run, "id"), epoch)
442: 		return verifyErr
443: 	})
444: 	if duplicateErr := c.RunAdmitted(context.Background(), route, r.run, r.lease); duplicateErr == nil {
445: 		t.Fatal("duplicate dispatch admitted")
446: 	}
447: 	var replayClosure, replayObservation, replayProof int
448: 	if err := r.f.db.QueryRow("SELECT count(*) FROM idempotency WHERE operation='host:qualification-failure-closure' AND project=?", r.f.project).Scan(&replayClosure); err != nil {
560: }
