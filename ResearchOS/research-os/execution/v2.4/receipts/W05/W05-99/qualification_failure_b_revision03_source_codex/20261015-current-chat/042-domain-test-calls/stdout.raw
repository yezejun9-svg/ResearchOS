562: func TestQualificationFailurePrivateConsumerRejectsTampering(t *testing.T) {
563: 	c, route, r, calls := qualificationFailureLoopbackFixture(t)
564: 	if err := c.RunAdmitted(context.Background(), route, r.run, r.lease); err == nil {
565: 		t.Fatal("expected first-gate denial")
566: 	}
567: 	if calls.Load() != 1 {
568: 		t.Fatal("real MODEL was not called once")
569: 	}
570: 	epoch, err := Num(r.run, "lease_epoch")
571: 	if err != nil {
572: 		t.Fatal(err)
573: 	}
574: 	check := func(tx *sql.Tx) error {
575: 		_, e := r.f.s.validatedQualificationFailureTx(tx, r.f.project, Str(r.task, "id"), Str(r.run, "id"), epoch)
576: 		return e
577: 	}
578: 	sourceTx(t, r.f.db, check)
579: 	for _, mutation := range []struct {
580: 		name, table, sql string
581: 		args             []any
582: 	}{
680: 	if err = grantTx.Rollback(); err != nil {
681: 		t.Fatal(err)
682: 	}
683: 	if err = r.f.s.RevokePrincipal(context.Background(), r.f.owner); err != nil {
684: 		t.Fatal(err)
685: 	}
686: 	tx, err := r.f.db.Begin()
687: 	if err != nil {
688: 		t.Fatal(err)
689: 	}
690: 	defer tx.Rollback()
691: 	if err = check(tx); err == nil {
692: 		t.Fatal("revoked current Owner still authorized closure")
693: 	}
694: }
