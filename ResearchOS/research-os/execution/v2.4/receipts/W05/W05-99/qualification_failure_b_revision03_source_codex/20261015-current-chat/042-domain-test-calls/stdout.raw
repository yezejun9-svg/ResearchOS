696: func TestQualificationFailureNativeSourceTamperingRefused(t *testing.T) {
697: 	c, route, r, _ := qualificationFailureLoopbackFixture(t)
698: 	if err := c.RunAdmitted(context.Background(), route, r.run, r.lease); err == nil {
699: 		t.Fatal("expected first-gate denial")
700: 	}
701: 	var locator, manifestHash string
702: 	if err := r.f.db.QueryRow("SELECT journal_locator,manifest_hash FROM runtime_dispatches WHERE run=?", r.run["id"]).Scan(&locator, &manifestHash); err != nil {
703: 		t.Fatal(err)
704: 	}
705: 	directory := filepath.Join(c.config.DataRoot, "runtime-dispatches", locator)
706: 	if _, err := rt.ReadQualificationNativeFacts(directory, manifestHash); err != nil {
707: 		t.Fatal(err)
708: 	}
709: 	for _, name := range []string{"stdout.raw", "stderr.raw", "bridge.json"} {
710: 		t.Run(name, func(t *testing.T) {
711: 			path := filepath.Join(directory, name)
712: 			original, readErr := os.ReadFile(path)
713: 			if readErr != nil {
714: 				t.Fatal(readErr)
715: 			}
716: 			defer os.WriteFile(path, original, 0600)
717: 			if writeErr := os.WriteFile(path, append(append([]byte(nil), original...), byte('x')), 0600); writeErr != nil {
718: 				t.Fatal(writeErr)
719: 			}
720: 			if _, verifyErr := rt.ReadQualificationNativeFacts(directory, manifestHash); verifyErr == nil {
721: 				t.Fatal("damaged native source was accepted")
722: 			}
723: 		})
724: 	}
725: 	journalPath := filepath.Join(directory, "bridge.json")
726: 	originalJournal, err := os.ReadFile(journalPath)
727: 	if err != nil {
728: 		t.Fatal(err)
729: 	}
730: 	for _, mutation := range []struct {
731: 		name, section, field string
732: 		value                any
733: 	}{
734: 		{"stopped_missing", "sandbox_receipt", "children_stopped", false},
735: 		{"streams_not_drained", "sandbox_receipt", "streams_drained", false},
736: 		{"cleanup_incomplete", "sandbox_receipt", "cleanup_complete", false},
737: 		{"output_not_copied", "sandbox_receipt", "output_copied", false},
738: 		{"receipt_pid_changed", "sandbox_receipt", "pid", 0},
739: 		{"identity_pid_missing", "identity", "pid", 0},
740: 		{"identity_job_changed", "identity", "job", "forged"},
741: 		{"identity_sid_missing", "identity", "appcontainer_sid", ""},
742: 		{"ended_missing", "", "ended", ""},
743: 	} {
744: 		t.Run(mutation.name, func(t *testing.T) {
745: 			journal, decodeErr := Decode(originalJournal)
746: 			if decodeErr != nil {
747: 				t.Fatal(decodeErr)
748: 			}
749: 			if mutation.section == "" {
750: 				journal[mutation.field] = mutation.value
751: 			} else {
752: 				section, ok := journal[mutation.section].(map[string]any)
753: 				if !ok {
754: 					t.Fatal("native field section unavailable")
755: 				}
756: 				section[mutation.field] = mutation.value
757: 			}
758: 			if err := os.WriteFile(journalPath, Bytes(journal), 0600); err != nil {
759: 				t.Fatal(err)
760: 			}
761: 			defer os.WriteFile(journalPath, originalJournal, 0600)
762: 			if _, err := rt.ReadQualificationNativeFacts(directory, manifestHash); err == nil {
763: 				t.Fatal("damaged native terminal predicate was accepted")
764: 			}
765: 		})
