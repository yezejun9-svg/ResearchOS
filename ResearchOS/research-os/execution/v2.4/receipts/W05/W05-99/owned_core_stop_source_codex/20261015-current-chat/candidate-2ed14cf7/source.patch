@@ -0,0 +1,76 @@
+//go:build windows
+
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"flag"
+	"fmt"
+	"os"
+	"time"
+
+	"researchos.local/research-os/internal/ownedcorestop"
+)
+
+func main() { os.Exit(run(os.Args[1:])) }
+
+func run(args []string) int {
+	if len(args) == 0 {
+		fmt.Fprintln(os.Stderr, "usage: owned_core_stop preflight|commit|inspect")
+		return 2
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 45*time.Second)
+	defer cancel()
+	var result any
+	var err error
+	switch args[0] {
+	case "preflight":
+		fs := flag.NewFlagSet("preflight", flag.ContinueOnError)
+		input := fs.String("input", "", "strict subject JSON")
+		operationID := fs.String("operation-id", "", "exact operation ID")
+		out := fs.String("out", "", "new private directory outside data root")
+		if fs.Parse(args[1:]) != nil || fs.NArg() != 0 || *input == "" || *operationID == "" || *out == "" {
+			return 2
+		}
+		var plan ownedcorestop.Plan
+		var sha string
+		plan, sha, err = ownedcorestop.Preflight(ctx, *input, *operationID, *out)
+		if err == nil {
+			result = struct {
+				Plan       ownedcorestop.Plan `json:"plan"`
+				PlanSHA256 string             `json:"plan_sha256"`
+			}{plan, sha}
+		}
+	case "commit":
+		fs := flag.NewFlagSet("commit", flag.ContinueOnError)
+		plan := fs.String("plan", "", "reviewed plan.json")
+		sha := fs.String("expect-plan-sha256", "", "exact reviewed SHA256")
+		if fs.Parse(args[1:]) != nil || fs.NArg() != 0 || *plan == "" || *sha == "" {
+			return 2
+		}
+		result, err = ownedcorestop.Commit(ctx, *plan, *sha)
+	case "inspect":
+		fs := flag.NewFlagSet("inspect", flag.ContinueOnError)
+		plan := fs.String("plan", "", "plan.json")
+		if fs.Parse(args[1:]) != nil || fs.NArg() != 0 || *plan == "" {
+			return 2
+		}
+		result, err = ownedcorestop.Inspect(*plan)
+	default:
+		fmt.Fprintln(os.Stderr, "unknown command")
+		return 2
+	}
+	if err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		return 1
+	}
+	if err = json.NewEncoder(os.Stdout).Encode(result); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		return 1
+	}
+	if r, ok := result.(ownedcorestop.Result); ok && r.State != "STOPPED_LEASE_VERIFIED" {
+		return 3
+	}
+	return 0
+}
diff --git a/ops/owned_core_stop/main_windows_test.go b/ops/owned_core_stop/main_windows_test.go
new file mode 100644
index 00000000..6ff09b6b
--- /dev/null
+++ b/ops/owned_core_stop/main_windows_test.go
@@ -0,0 +1,135 @@
+//go:build windows
+
+package main
+
+import (
+	"context"
+	"database/sql"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"testing"
+	"time"
+
+	_ "modernc.org/sqlite"
+	rt "researchos.local/research-os/adapters/runtime"
+	"researchos.local/research-os/internal/store"
+	"researchos.local/research-os/ops/supervisor"
+)
+
+func waitFixtureFile(t *testing.T, path string) {
+	t.Helper()
+	for deadline := time.Now().Add(6 * time.Second); time.Now().Before(deadline); time.Sleep(20 * time.Millisecond) {
+		if _, e := os.Stat(path); e == nil {
+			return
+		}
+	}
+	t.Fatalf("fixture marker absent: %s", path)
+}
+
+func TestOwnedCoreControlledCrashWALAndLease(t *testing.T) {
+	fixture := os.Getenv("RESEARCHOS_OWNED_STOP_FIXTURE_EXE")
+	if fixture == "" {
+		t.Fatal("built new owned fixture exe required; no skip")
+	}
+	root := filepath.Join(t.TempDir(), "data")
+	if err := os.Mkdir(root, 0700); err != nil {
+		t.Fatal(err)
+	}
+	dbPath := filepath.Join(root, "researchos.sqlite")
+	db, err := sql.Open("sqlite", dbPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = db.Exec(`PRAGMA journal_mode=WAL;PRAGMA synchronous=FULL;CREATE TABLE stop_fixture_rows(id TEXT PRIMARY KEY,payload BLOB)`); err != nil {
+		db.Close()
+		t.Fatal(err)
+	}
+	if err = db.Close(); err != nil {
+		t.Fatal(err)
+	}
+	out := t.TempDir()
+	ready := filepath.Join(out, "ready")
+	attempt := filepath.Join(out, "attempt")
+	attempted := filepath.Join(out, "attempted")
+	cmd := exec.Command(fixture, "--root", root, "--ready", ready, "--attempt", attempt, "--attempted", attempted)
+	if err = cmd.Start(); err != nil {
+		t.Fatal(err)
+	}
+	defer cmd.Wait()
+	waitFixtureFile(t, ready)
+	baseline, backupHash, err := store.OnlineOwnedStopBackup(context.Background(), dbPath, filepath.Join(out, "backup.sqlite"))
+	if err != nil || backupHash == "" || baseline.Rows != 1 {
+		t.Fatalf("WAL online backup failed: %+v %q %v", baseline, backupHash, err)
+	}
+	identity, err := supervisor.ObserveOwnedCoreReadOnly(uint32(cmd.Process.Pid))
+	if err != nil {
+		t.Fatal(err)
+	}
+	h, err := supervisor.OpenOwnedCoreRetained(identity)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer h.Close()
+	barrier, err := store.AcquireOwnedStopBarrier(context.Background(), dbPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer barrier.Close()
+	current, err := barrier.Census(context.Background())
+	if err != nil || current != baseline {
+		t.Fatalf("baseline differs before signal: %+v %v", current, err)
+	}
+	if err = os.WriteFile(attempt, []byte("go"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	waitFixtureFile(t, attempted)
+	// The fixture has a deferred transaction attempting a write. The reserved
+	// writer lock prevents its durable PREPARED/row commit before the crash.
+	exit, err := h.TerminateOnceAndWait(5 * time.Second)
+	if err != nil || exit.TerminateCalls != 1 || !exit.ExitObserved || exit.ExitCode != supervisor.OwnedCoreMaintenanceExitCode {
+		t.Fatalf("exact controlled crash unavailable: %+v %v", exit, err)
+	}
+	if err = barrier.Close(); err != nil {
+		t.Fatal(err)
+	}
+	lease, err := rt.AcquireDataRootLease(root)
+	if err != nil {
+		t.Fatalf("native exit did not release real root lease: %v", err)
+	}
+	defer lease.Close()
+	if !lease.Held() {
+		t.Fatal("poststop real lease not held")
+	}
+	post, err := store.ReadOwnedStopCensus(context.Background(), dbPath)
+	if err != nil || post != baseline {
+		t.Fatalf("committed WAL lost or in-flight row escaped: %+v %v", post, err)
+	}
+	read, err := sql.Open("sqlite", dbPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer read.Close()
+	var committed, inflight int
+	if err = read.QueryRow(`SELECT count(*) FROM stop_fixture_rows WHERE id='committed'`).Scan(&committed); err != nil {
+		t.Fatal(err)
+	}
+	if err = read.QueryRow(`SELECT count(*) FROM stop_fixture_rows WHERE id='inflight'`).Scan(&inflight); err != nil {
+		t.Fatal(err)
+	}
+	if committed != 1 || inflight != 0 {
+		t.Fatalf("wrong crash durability: committed=%d inflight=%d", committed, inflight)
+	}
+}
+
+func TestOwnedCoreCLIRequiresExactArguments(t *testing.T) {
+	if got := run([]string{"commit", "--plan", "missing"}); got != 2 {
+		t.Fatalf("commit accepted missing reviewed SHA: %d", got)
+	}
+	if got := run([]string{"preflight", "--input", "missing", "--operation-id", "a"}); got != 2 {
+		t.Fatalf("preflight accepted missing new out: %d", got)
+	}
+	if got := run([]string{"inspect"}); got != 2 {
+		t.Fatalf("inspect accepted missing plan: %d", got)
+	}
+}
diff --git a/ops/supervisor/owned_core_handle_windows.go b/ops/supervisor/owned_core_handle_windows.go
new file mode 100644
index 00000000..b5b3cf98
--- /dev/null
+++ b/ops/supervisor/owned_core_handle_windows.go
@@ -0,0 +1,360 @@
+//go:build windows
+
+package supervisor
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+// OwnedCoreNativeIdentity is entirely observed from retained native handles.
+// ParentProcessID comes from one Toolhelp snapshot and is then bound to its
+// own retained process handle, creation time, SID and image file identity.
+type OwnedCoreNativeIdentity struct {
+	PID               uint32 `json:"pid"`
+	CreatedNS         int64  `json:"created_ns"`
+	SID               string `json:"sid"`
+	ImagePath         string `json:"image_path"`
+	ImageSHA256       string `json:"image_sha256"`
+	ImageVolume       uint32 `json:"image_volume"`
+	ImageIndex        uint64 `json:"image_index"`
+	ParentPID         uint32 `json:"parent_pid"`
+	ParentCreatedNS   int64  `json:"parent_created_ns"`
+	ParentSID         string `json:"parent_sid"`
+	ParentImagePath   string `json:"parent_image_path"`
+	ParentImageSHA256 string `json:"parent_image_sha256"`
+	ParentImageVolume uint32 `json:"parent_image_volume"`
+	ParentImageIndex  uint64 `json:"parent_image_index"`
+}
+
+type ownedNativeProcess struct {
+	handle  windows.Handle
+	image   *os.File
+	path    string
+	created int64
+	sid     string
+	sha     string
+	volume  uint32
+	index   uint64
+}
+
+func (p *ownedNativeProcess) close() {
+	if p.image != nil {
+		_ = p.image.Close()
+		p.image = nil
+	}
+	if p.handle != 0 {
+		_ = windows.CloseHandle(p.handle)
+		p.handle = 0
+	}
+}
+
+func ownedNativePath(h windows.Handle) (string, error) {
+	buf := make([]uint16, 32768)
+	size := uint32(len(buf))
+	if err := windows.QueryFullProcessImageName(h, 0, &buf[0], &size); err != nil {
+		return "", err
+	}
+	path := windows.UTF16ToString(buf[:size])
+	if !filepath.IsAbs(path) || filepath.Clean(path) != path || !strings.EqualFold(filepath.Ext(path), ".exe") {
+		return "", errors.New("canonical executable path required")
+	}
+	actual, err := filepath.EvalSymlinks(path)
+	if err != nil || !strings.EqualFold(actual, path) {
+		return "", errors.New("executable path reparse rejected")
+	}
+	return path, nil
+}
+
+func ownedNativeImage(path string) (*os.File, string, uint32, uint64, error) {
+	wide, err := windows.UTF16PtrFromString(path)
+	if err != nil {
+		return nil, "", 0, 0, err
+	}
+	h, err := windows.CreateFile(wide, windows.GENERIC_READ, windows.FILE_SHARE_READ, nil, windows.OPEN_EXISTING, windows.FILE_FLAG_OPEN_REPARSE_POINT, 0)
+	if err != nil {
+		return nil, "", 0, 0, err
+	}
+	f := os.NewFile(uintptr(h), path)
+	var before windows.ByHandleFileInformation
+	if err = windows.GetFileInformationByHandle(h, &before); err != nil {
+		f.Close()
+		return nil, "", 0, 0, err
+	}
+	if before.FileAttributes&(windows.FILE_ATTRIBUTE_REPARSE_POINT|windows.FILE_ATTRIBUTE_DIRECTORY) != 0 || before.NumberOfLinks != 1 || before.FileSizeHigh != 0 || before.FileSizeLow > 256<<20 {
+		f.Close()
+		return nil, "", 0, 0, errors.New("image reparse/alias/size rejected")
+	}
+	hash := sha256.New()
+	n, err := io.Copy(hash, io.LimitReader(f, 256<<20+1))
+	if err != nil {
+		f.Close()
+		return nil, "", 0, 0, err
+	}
+	var after windows.ByHandleFileInformation
+	if err = windows.GetFileInformationByHandle(h, &after); err != nil {
+		f.Close()
+		return nil, "", 0, 0, err
+	}
+	if n != int64(before.FileSizeLow) || before.VolumeSerialNumber != after.VolumeSerialNumber || before.FileIndexHigh != after.FileIndexHigh || before.FileIndexLow != after.FileIndexLow || before.FileSizeLow != after.FileSizeLow || before.LastWriteTime != after.LastWriteTime {
+		f.Close()
+		return nil, "", 0, 0, errors.New("image changed during retained read")
+	}
+	return f, hex.EncodeToString(hash.Sum(nil)), before.VolumeSerialNumber, uint64(before.FileIndexHigh)<<32 | uint64(before.FileIndexLow), nil
+}
+
+func ownedNativeProcessFromHandle(h windows.Handle) (p ownedNativeProcess, err error) {
+	p = ownedNativeProcess{handle: h}
+	defer func() {
+		if err != nil {
+			p.close()
+		}
+	}()
+	var created, exited, kernel, user windows.Filetime
+	if err = windows.GetProcessTimes(h, &created, &exited, &kernel, &user); err != nil {
+		return p, err
+	}
+	p.created = created.Nanoseconds()
+	var token windows.Token
+	if err = windows.OpenProcessToken(h, windows.TOKEN_QUERY, &token); err != nil {
+		return p, err
+	}
+	tu, e := token.GetTokenUser()
+	_ = token.Close()
+	if e != nil || tu.User.Sid == nil || !tu.User.Sid.IsValid() {
+		return p, errors.New("process SID unavailable")
+	}
+	p.sid = tu.User.Sid.String()
+	if p.path, err = ownedNativePath(h); err != nil {
+		return p, err
+	}
+	p.image, p.sha, p.volume, p.index, err = ownedNativeImage(p.path)
+	return p, err
+}
+
+func ownedNativeParentPID(pid uint32) (uint32, error) {
+	snap, err := windows.CreateToolhelp32Snapshot(windows.TH32CS_SNAPPROCESS, 0)
+	if err != nil {
+		return 0, err
+	}
+	defer windows.CloseHandle(snap)
+	entry := windows.ProcessEntry32{Size: uint32(unsafe.Sizeof(windows.ProcessEntry32{}))}
+	if err = windows.Process32First(snap, &entry); err != nil {
+		return 0, err
+	}
+	for {
+		if entry.ProcessID == pid {
+			if entry.ParentProcessID == 0 || entry.ParentProcessID == pid {
+				return 0, errors.New("invalid parent identity")
+			}
+			return entry.ParentProcessID, nil
+		}
+		err = windows.Process32Next(snap, &entry)
+		if errors.Is(err, windows.ERROR_NO_MORE_FILES) {
+			break
+		}
+		if err != nil {
+			return 0, err
+		}
+	}
+	return 0, errors.New("process absent from snapshot")
+}
+
+// OwnedCoreRetainedHandle is the sole native termination capability. The
+// capability never exports its process handle. The caller must first verify
+// the reviewed plan and all external proofs before opening it.
+type OwnedCoreRetainedHandle struct {
+	core           ownedNativeProcess
+	parent         ownedNativeProcess
+	identity       OwnedCoreNativeIdentity
+	terminateCalls int
+	closed         bool
+	// Per-handle native call seams allow deterministic failure-path fixture cuts.
+	// Nil always uses the Windows APIs; callers outside this package cannot set them.
+	terminate func(windows.Handle, uint32) error
+	wait      func(windows.Handle, uint32) (uint32, error)
+}
+
+func (h *OwnedCoreRetainedHandle) nativeWait(ms uint32) (uint32, error) {
+	if h.wait != nil {
+		return h.wait(h.core.handle, ms)
+	}
+	return windows.WaitForSingleObject(h.core.handle, ms)
+}
+
+func (h *OwnedCoreRetainedHandle) nativeTerminate(code uint32) error {
+	if h.terminate != nil {
+		return h.terminate(h.core.handle, code)
+	}
+	return windows.TerminateProcess(h.core.handle, code)
+}
+
+func ownedCoreOpen(pid uint32, access uint32) (out *OwnedCoreRetainedHandle, err error) {
+	if pid == 0 {
+		return nil, errors.New("zero PID")
+	}
+	h, err := windows.OpenProcess(access|windows.PROCESS_QUERY_LIMITED_INFORMATION|windows.SYNCHRONIZE, false, pid)
+	if err != nil {
+		return nil, err
+	}
+	out = &OwnedCoreRetainedHandle{}
+	defer func() {
+		if err != nil {
+			out.Close()
+			out = nil
+		}
+	}()
+	out.core, err = ownedNativeProcessFromHandle(h)
+	if err != nil {
+		return nil, err
+	}
+	actualPID, e := windows.GetProcessId(out.core.handle)
+	if e != nil || actualPID != pid {
+		return nil, errors.New("process handle PID mismatch")
+	}
+	parentPID, e := ownedNativeParentPID(pid)
+	if e != nil {
+		return nil, e
+	}
+	parentH, e := windows.OpenProcess(windows.PROCESS_QUERY_LIMITED_INFORMATION|windows.SYNCHRONIZE, false, parentPID)
+	if e != nil {
+		return nil, e
+	}
+	out.parent, err = ownedNativeProcessFromHandle(parentH)
+	if err != nil {
+		return nil, err
+	}
+	actualParent, e := windows.GetProcessId(out.parent.handle)
+	if e != nil || actualParent != parentPID {
+		return nil, errors.New("parent handle PID mismatch")
+	}
+	out.identity = OwnedCoreNativeIdentity{PID: pid, CreatedNS: out.core.created, SID: out.core.sid, ImagePath: out.core.path, ImageSHA256: out.core.sha, ImageVolume: out.core.volume, ImageIndex: out.core.index, ParentPID: parentPID, ParentCreatedNS: out.parent.created, ParentSID: out.parent.sid, ParentImagePath: out.parent.path, ParentImageSHA256: out.parent.sha, ParentImageVolume: out.parent.volume, ParentImageIndex: out.parent.index}
+	return out, nil
+}
+
+// ObserveOwnedCoreReadOnly cannot terminate. It is suitable for preflight.
+func ObserveOwnedCoreReadOnly(pid uint32) (OwnedCoreNativeIdentity, error) {
+	h, err := ownedCoreOpen(pid, 0)
+	if err != nil {
+		return OwnedCoreNativeIdentity{}, err
+	}
+	defer h.Close()
+	return h.identity, nil
+}
+
+// OpenOwnedCoreRetained binds the sole termination handle to a complete exact
+// native identity obtained during reviewed preflight. It cannot accept a
+// partial PID-only expectation.
+func OpenOwnedCoreRetained(expected OwnedCoreNativeIdentity) (*OwnedCoreRetainedHandle, error) {
+	if expected.PID == 0 || expected.CreatedNS == 0 || expected.SID == "" || expected.ImageSHA256 == "" || expected.ImagePath == "" || expected.ImageIndex == 0 || expected.ParentPID == 0 || expected.ParentCreatedNS == 0 || expected.ParentSID == "" || expected.ParentImageSHA256 == "" || expected.ParentImageIndex == 0 {
+		return nil, errors.New("complete reviewed native identity required")
+	}
+	h, err := ownedCoreOpen(expected.PID, windows.PROCESS_TERMINATE)
+	if err != nil {
+		return nil, err
+	}
+	if h.identity != expected {
+		h.Close()
+		return nil, errors.New("retained native identity differs from plan")
+	}
+	return h, nil
+}
+
+func (h *OwnedCoreRetainedHandle) Identity() OwnedCoreNativeIdentity {
+	if h == nil {
+		return OwnedCoreNativeIdentity{}
+	}
+	return h.identity
+}
+
+func (h *OwnedCoreRetainedHandle) verifyRetained() error {
+	if h == nil || h.closed || h.core.handle == 0 {
+		return errors.New("native handle closed")
+	}
+	pid, err := windows.GetProcessId(h.core.handle)
+	if err != nil || pid != h.identity.PID {
+		return errors.New("retained PID changed")
+	}
+	var created, exited, kernel, user windows.Filetime
+	if err = windows.GetProcessTimes(h.core.handle, &created, &exited, &kernel, &user); err != nil || created.Nanoseconds() != h.identity.CreatedNS {
+		return errors.New("retained process creation changed")
+	}
+	// File share mode prevents replacement while the retained image is open.
+	var info windows.ByHandleFileInformation
+	if err = windows.GetFileInformationByHandle(windows.Handle(h.core.image.Fd()), &info); err != nil || info.VolumeSerialNumber != h.identity.ImageVolume || uint64(info.FileIndexHigh)<<32|uint64(info.FileIndexLow) != h.identity.ImageIndex {
+		return errors.New("retained image file changed")
+	}
+	return nil
+}
+
+// OwnedCoreNativeExit records whether the one call was made and the numeric
+// exit code from the same retained handle. Unknown wait is never retried.
+type OwnedCoreNativeExit struct {
+	TerminateCalls int    `json:"terminate_calls"`
+	ExitObserved   bool   `json:"exit_observed"`
+	ExitCode       uint32 `json:"exit_code"`
+	BeforeSignal   bool   `json:"before_signal"`
+}
+
+const OwnedCoreMaintenanceExitCode uint32 = 0x52534f53
+
+func (h *OwnedCoreRetainedHandle) TerminateOnceAndWait(timeout time.Duration) (OwnedCoreNativeExit, error) {
+	var out OwnedCoreNativeExit
+	if timeout <= 0 || timeout > 30*time.Second {
+		return out, errors.New("bounded native wait required")
+	}
+	if err := h.verifyRetained(); err != nil {
+		return out, err
+	}
+	if h.terminateCalls != 0 {
+		return out, errors.New("native termination already attempted")
+	}
+	status, err := h.nativeWait(0)
+	if err != nil {
+		return out, err
+	}
+	if status == windows.WAIT_OBJECT_0 {
+		out.BeforeSignal = true
+		out.ExitObserved = true
+		if err = windows.GetExitCodeProcess(h.core.handle, &out.ExitCode); err != nil {
+			return out, err
+		}
+		return out, nil
+	}
+	if status != uint32(windows.WAIT_TIMEOUT) {
+		return out, fmt.Errorf("unexpected native wait status %d", status)
+	}
+	h.terminateCalls = 1
+	out.TerminateCalls = 1
+	if err = h.nativeTerminate(OwnedCoreMaintenanceExitCode); err != nil {
+		return out, fmt.Errorf("one TerminateProcess failed: %w", err)
+	}
+	status, err = h.nativeWait(uint32(timeout.Milliseconds()))
+	if err != nil || status != windows.WAIT_OBJECT_0 {
+		return out, fmt.Errorf("native wait unknown: status=%d err=%v", status, err)
+	}
+	out.ExitObserved = true
+	if err = windows.GetExitCodeProcess(h.core.handle, &out.ExitCode); err != nil {
+		return out, err
+	}
+	return out, nil
+}
+
+func (h *OwnedCoreRetainedHandle) Close() {
+	if h == nil || h.closed {
+		return
+	}
+	h.closed = true
+	h.core.close()
+	h.parent.close()
+}
diff --git a/ops/supervisor/owned_core_handle_windows_test.go b/ops/supervisor/owned_core_handle_windows_test.go
new file mode 100644
index 00000000..79719346
--- /dev/null
+++ b/ops/supervisor/owned_core_handle_windows_test.go
@@ -0,0 +1,134 @@
+//go:build windows
+
+package supervisor
+
+import (
+	"errors"
+	"os"
+	"os/exec"
+	"strings"
+	"testing"
+	"time"
+
+	"golang.org/x/sys/windows"
+)
+
+func TestOwnedCoreFixtureChild(t *testing.T) {
+	if os.Getenv("RESEARCHOS_OWNED_CORE_CHILD") != "yes" {
+		return
+	}
+	time.Sleep(12 * time.Second)
+}
+
+func TestOwnedCoreTerminateFailureIsSingleUnknownAttempt(t *testing.T) {
+	core := ownedCoreChild(t)
+	defer func() { _ = core.Process.Kill(); _ = core.Wait() }()
+	id, err := ObserveOwnedCoreReadOnly(uint32(core.Process.Pid))
+	if err != nil {
+		t.Fatal(err)
+	}
+	h, err := OpenOwnedCoreRetained(id)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer h.Close()
+	called := 0
+	h.terminate = func(windows.Handle, uint32) error { called++; return errors.New("injected native failure") }
+	exit, err := h.TerminateOnceAndWait(time.Second)
+	if err == nil || exit.TerminateCalls != 1 || exit.ExitObserved || called != 1 {
+		t.Fatalf("one-call failure was not UNKNOWN: %+v calls=%d err=%v", exit, called, err)
+	}
+	if again, err := h.TerminateOnceAndWait(time.Second); err == nil || again.TerminateCalls != 0 || called != 1 {
+		t.Fatalf("native failure retried: %+v calls=%d err=%v", again, called, err)
+	}
+	if _, err := ObserveOwnedCoreReadOnly(uint32(core.Process.Pid)); err != nil {
+		t.Fatalf("injected failure affected target before cleanup: %v", err)
+	}
+}
+
+func TestOwnedCoreWaitDeadlineNeverRetriesSignal(t *testing.T) {
+	core := ownedCoreChild(t)
+	defer func() { _ = core.Wait() }()
+	id, err := ObserveOwnedCoreReadOnly(uint32(core.Process.Pid))
+	if err != nil {
+		t.Fatal(err)
+	}
+	h, err := OpenOwnedCoreRetained(id)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer h.Close()
+	waits := 0
+	h.wait = func(handle windows.Handle, ms uint32) (uint32, error) {
+		waits++
+		if waits == 2 {
+			return uint32(windows.WAIT_TIMEOUT), nil
+		}
+		return windows.WaitForSingleObject(handle, ms)
+	}
+	exit, err := h.TerminateOnceAndWait(time.Second)
+	if err == nil || exit.TerminateCalls != 1 || exit.ExitObserved || waits != 2 {
+		t.Fatalf("deadline not reported UNKNOWN: %+v waits=%d err=%v", exit, waits, err)
+	}
+	if again, err := h.TerminateOnceAndWait(time.Second); err == nil || again.TerminateCalls != 0 || waits != 2 {
+		t.Fatalf("deadline retried signal/wait: %+v waits=%d err=%v", again, waits, err)
+	}
+}
+
+func ownedCoreChild(t *testing.T) *exec.Cmd {
+	t.Helper()
+	exe, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	cmd := exec.Command(exe, "-test.run=^TestOwnedCoreFixtureChild$")
+	cmd.Env = append(os.Environ(), "RESEARCHOS_OWNED_CORE_CHILD=yes")
+	if err = cmd.Start(); err != nil {
+		t.Fatal(err)
+	}
+	return cmd
+}
+
+func TestOwnedCoreRetainedHandleSingleChildAndUnrelatedSurvives(t *testing.T) {
+	core := ownedCoreChild(t)
+	unrelated := ownedCoreChild(t)
+	defer func() { _ = core.Wait(); _ = unrelated.Wait() }()
+	observed, err := ObserveOwnedCoreReadOnly(uint32(core.Process.Pid))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if observed.PID != uint32(core.Process.Pid) || observed.CreatedNS == 0 || observed.SID == "" || observed.ParentPID != uint32(os.Getpid()) || observed.ImageIndex == 0 || observed.ParentImageIndex == 0 {
+		t.Fatalf("incomplete retained identity: %+v", observed)
+	}
+	wrong := observed
+	wrong.CreatedNS++
+	if h, e := OpenOwnedCoreRetained(wrong); e == nil {
+		h.Close()
+		t.Fatal("PID reuse identity accepted")
+	}
+	wrong = observed
+	wrong.ImageSHA256 = strings.Repeat("0", 64)
+	if h, e := OpenOwnedCoreRetained(wrong); e == nil {
+		h.Close()
+		t.Fatal("replacement image identity accepted")
+	}
+	h, err := OpenOwnedCoreRetained(observed)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer h.Close()
+	if h.Identity() != observed {
+		t.Fatal("retained identity changed")
+	}
+	exit, err := h.TerminateOnceAndWait(5 * time.Second)
+	if err != nil || exit.TerminateCalls != 1 || !exit.ExitObserved || exit.ExitCode != OwnedCoreMaintenanceExitCode || exit.BeforeSignal {
+		t.Fatalf("single exact termination failed: %+v %v", exit, err)
+	}
+	if second, e := h.TerminateOnceAndWait(time.Second); e == nil || second.TerminateCalls != 0 {
+		t.Fatalf("second termination accepted: %+v %v", second, e)
+	}
+	other, e := ObserveOwnedCoreReadOnly(uint32(unrelated.Process.Pid))
+	if e != nil || other.PID != uint32(unrelated.Process.Pid) {
+		t.Fatalf("same-console unrelated child lost: %+v %v", other, e)
+	}
+}
