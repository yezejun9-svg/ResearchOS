114: func startRuntimeVerifier(ctx context.Context, install RuntimeVerifierInstallation) (*runtimeVerifierProcess, error) {
115: 	if e := verifyRuntimeVerifierImage(install); e != nil {
116: 		return nil, e
117: 	}
118: 	deadline, cancel := context.WithTimeout(ctx, 3*time.Minute)
119: 	p := &runtimeVerifierProcess{cancel: cancel}
120: 	p.cmd = exec.CommandContext(deadline, install.Executable)
121: 	p.cmd.Dir = filepath.Dir(install.Executable)
122: 	p.cmd.Env = []string{}
123: 	for _, name := range []string{"SystemRoot", "WINDIR", "TEMP", "TMP"} {
124: 		if value := os.Getenv(name); value != "" {
125: 			p.cmd.Env = append(p.cmd.Env, name+"="+value)
126: 		}
127: 	}
128: 	p.cmd.SysProcAttr = &syscall.SysProcAttr{HideWindow: true}
129: 	// These are dedicated inherited anonymous pipes. No token is placed in argv,
130: 	// environment, a file, logs, worker configuration or the scheduler object.
131: 	var e error
132: 	if p.in, e = p.cmd.StdinPipe(); e != nil {
133: 		cancel()
134: 		return nil, e
135: 	}
136: 	if p.out, e = p.cmd.StdoutPipe(); e != nil {
137: 		p.in.Close()
138: 		cancel()
139: 		return nil, e
140: 	}
141: 	p.cmd.Stderr = io.Discard
142: 	if e = p.cmd.Start(); e != nil {
143: 		p.in.Close()
144: 		p.out.Close()
145: 		cancel()
146: 		return nil, errors.New("installed verifier process could not start")
147: 	}
148: 	ok := false
149: 	defer func() {
150: 		if !ok {
151: 			p.close()
152: 		}
153: 	}()
154: 	p.identity, e = supervisor.ObserveProcess(uint32(p.cmd.Process.Pid))
155: 	if e != nil || "sha256:"+p.identity.ImageSHA256 != install.ExecutableHash {
156: 		return nil, errors.New("verifier process does not match installed image")
157: 	}
158: 	var nonce [32]byte
159: 	if _, e = rand.Read(nonce[:]); e != nil {
160: 		return nil, e
161: 	}
162: 	p.nonce = hex.EncodeToString(nonce[:])
163: 	if e = verifier.WriteFrame(p.in, verifier.Challenge{Protocol: verifier.Protocol, Nonce: p.nonce}); e != nil {
164: 		return nil, errors.New("verifier handshake write failed")
165: 	}
166: 	var hello verifier.Hello
167: 	if e = p.read(deadline, &hello); e != nil {
168: 		return nil, e
169: 	}
170: 	if hello.Protocol != verifier.Protocol || hello.ServiceID != verifier.ServiceID || hello.Nonce != p.nonce || hello.PID != p.cmd.Process.Pid {
171: 		return nil, errors.New("verifier process handshake identity differs")
172: 	}
173: 	ok = true
174: 	return p, nil
175: }
