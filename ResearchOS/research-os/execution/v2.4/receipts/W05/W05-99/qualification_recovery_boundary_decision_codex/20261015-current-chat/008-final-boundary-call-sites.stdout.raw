316: 
317: // Called only after an observed native exit and release of the reserved writer.
318: // A real DataRootLease plus fresh database and authority reads determine state.
319: func finishAfterNativeExit(ctx context.Context, p Plan, planSHA string, exit supervisor.OwnedCoreNativeExit) (Result, error) {
320: 	if !exit.ExitObserved {
321: 		return persistStopResult(p, stopResult(p, planSHA, "UNKNOWN", "native exit not observed"))
322: 	}
323: 	lease, err := rt.AcquireDataRootLease(p.Input.DataRoot)
324: 	if err != nil {
325: 		result := stopResult(p, planSHA, "STOP_OBSERVED_MAINTENANCE_BLOCKED", "real DataRootLease unavailable")
326: 		result.Native = &exit
327: 		return persistStopResult(p, result)
328: 	}
329: 	defer lease.Close()
330: 	if !lease.Held() {
331: 		result := stopResult(p, planSHA, "STOP_OBSERVED_MAINTENANCE_BLOCKED", "real DataRootLease not held")
332: 		result.Native = &exit
333: 		return persistStopResult(p, result)
334: 	}
335: 	post, postErr := store.ReadOwnedStopCensus(ctx, p.Host.Database)
336: 	postAuthority, authorityErr := host.ReadOwnedCoreStopPublicIdentity(ctx, p.Input.DataRoot)
337: 	result := stopResult(p, planSHA, "STOPPED_LEASE_VERIFIED", "")
338: 	result.Native = &exit
339: 	result.Postflight = &post
340: 	if exit.BeforeSignal {
341: 		result.State = "OBSERVED_BEFORE_SIGNAL"
342: 	}
343: 	if postErr != nil || authorityErr != nil || post != p.Baseline || postAuthority != p.Host {
344: 		result.State = "STOP_OBSERVED_MAINTENANCE_BLOCKED"
345: 		result.Reason = "poststop logical/schema/authority/integrity drift"
346: 	}
347: 	return persistStopResult(p, result)
