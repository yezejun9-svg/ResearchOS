//go:build windows

package ownedcorestop

import (
	"bytes"
	"crypto/sha256"
	"encoding/base64"
	"encoding/hex"
	"encoding/json"
	"errors"
	"fmt"
	"io"
	"os"
	"path/filepath"
	"strconv"
	"strings"
	"sync"
	"time"

	"researchos.local/research-os/internal/host"
	"researchos.local/research-os/internal/store"
	"researchos.local/research-os/ops/supervisor"
)

// The only operation authority is injected when a dedicated binary is linked.
// There is intentionally no setter, environment fallback, or caller-supplied
// grant path. Inspect shares structural validation but may run after expiry.
var compiledOperationGrantBase64 string
var compiledGrantOnce sync.Once
var compiledGrant operationGrant
var compiledGrantErr error

const grantSchema = "researchos.owned-core-stop-compiled-grant.v1"

type grantDocument struct {
	Path   string `json:"path"`
	SHA256 string `json:"sha256"`
}

type grantFileIdentity struct {
	Path   string `json:"path"`
	Volume uint32 `json:"volume"`
	Index  uint64 `json:"index"`
}

type grantNativeIdentity struct {
	PID                uint32 `json:"pid"`
	Created100NS       string `json:"created_100ns"`
	SID                string `json:"sid"`
	ImagePath          string `json:"image_path"`
	ImageSHA256        string `json:"image_sha256"`
	ImageVolume        uint32 `json:"image_volume"`
	ImageIndex         uint64 `json:"image_index"`
	ParentPID          uint32 `json:"parent_pid"`
	ParentCreated100NS string `json:"parent_created_100ns"`
	ParentSID          string `json:"parent_sid"`
	ParentImagePath    string `json:"parent_image_path"`
	ParentImageSHA256  string `json:"parent_image_sha256"`
	ParentImageVolume  uint32 `json:"parent_image_volume"`
	ParentImageIndex   uint64 `json:"parent_image_index"`
}

type operationGrant struct {
	Schema                    string                           `json:"schema"`
	GrantKind                 string                           `json:"grant_kind"`
	OperationID               string                           `json:"operation_id"`
	IssuedAt                  string                           `json:"issued_at"`
	NotBefore                 string                           `json:"not_before"`
	ExpiresAt                 string                           `json:"expires_at"`
	Purpose                   string                           `json:"purpose"`
	TrustedOperatorSID        string                           `json:"trusted_operator_sid"`
	DataRoot                  grantFileIdentity                `json:"data_root"`
	Database                  grantFileIdentity                `json:"database"`
	OperationDir              grantFileIdentity                `json:"operation_dir"`
	Native                    grantNativeIdentity              `json:"native"`
	Host                      host.OwnedCoreStopPublicIdentity `json:"host"`
	Subject                   store.OwnedStopSubject           `json:"subject"`
	RequiredProofKinds        []string                         `json:"required_proof_kinds"`
	RulesetVersion            string                           `json:"ruleset_version"`
	SchemaSHA256              string                           `json:"schema_sha256"`
	AllowedActions            []string                         `json:"allowed_actions"`
	TerminateCount            int                              `json:"terminate_count"`
	Proposal                  grantDocument                    `json:"proposal"`
	PreflightScope            grantDocument                    `json:"preflight_scope"`
	PreflightReview           grantDocument                    `json:"preflight_review"`
	HistoricalManifest        grantDocument                    `json:"historical_evidence_manifest"`
	PlanSHA256                string                           `json:"plan_sha256"`
	PreflightManifestSHA256   string                           `json:"preflight_manifest_sha256"`
	StopReview                grantDocument                    `json:"stop_review"`
	RootOperationScope        grantDocument                    `json:"root_operation_scope"`
	PreflightGrantSHA256      string                           `json:"preflight_grant_sha256"`
	PreflightExecutableSHA256 string                           `json:"preflight_executable_sha256"`
	digest                    string
	notBefore                 time.Time
	expires                   time.Time
}

func parseDecimal100NS(s string) (int64, error) {
	if s == "" || (len(s) > 1 && s[0] == '0') {
		return 0, errors.New("noncanonical creation time")
	}
	v, err := strconv.ParseInt(s, 10, 64)
	if err != nil || v <= 0 {
		return 0, errors.New("invalid creation time")
	}
	return v, nil
}

func (n grantNativeIdentity) observed() (supervisor.OwnedCoreNativeIdentity, error) {
	c, err := parseDecimal100NS(n.Created100NS)
	if err != nil {
		return supervisor.OwnedCoreNativeIdentity{}, err
	}
	p, err := parseDecimal100NS(n.ParentCreated100NS)
	if err != nil {
		return supervisor.OwnedCoreNativeIdentity{}, err
	}
	// Windows FILETIME.Nanoseconds() is the observed representation in the
	// retained native handle. The grant stores the exact 100ns unit as a string.
	if c > int64(^uint64(0)>>1)/100 || p > int64(^uint64(0)>>1)/100 {
		return supervisor.OwnedCoreNativeIdentity{}, errors.New("creation time overflow")
	}
	return supervisor.OwnedCoreNativeIdentity{PID: n.PID, CreatedNS: c * 100, SID: n.SID, ImagePath: n.ImagePath, ImageSHA256: n.ImageSHA256, ImageVolume: n.ImageVolume, ImageIndex: n.ImageIndex, ParentPID: n.ParentPID, ParentCreatedNS: p * 100, ParentSID: n.ParentSID, ParentImagePath: n.ParentImagePath, ParentImageSHA256: n.ParentImageSHA256, ParentImageVolume: n.ParentImageVolume, ParentImageIndex: n.ParentImageIndex}, nil
}

func validGrantDocument(d grantDocument) bool {
	return cleanOwnedLocalPath(d.Path) == nil && validSHA(d.SHA256)
}

func parseCompiledOperationGrant(encoded string) (operationGrant, error) {
	var g operationGrant
	if encoded == "" {
		return g, errors.New("STOP_GRANT_UNCONFIGURED")
	}
	if len(encoded) > base64.StdEncoding.EncodedLen(64<<10) {
		return g, errors.New("STOP_GRANT_INVALID: oversized base64")
	}
	raw, err := base64.StdEncoding.Strict().DecodeString(encoded)
	if err != nil || len(raw) == 0 || len(raw) > 64<<10 || base64.StdEncoding.EncodeToString(raw) != encoded {
		return g, errors.New("STOP_GRANT_INVALID: noncanonical base64")
	}
	if err = strictJSON(raw, &g); err != nil {
		return operationGrant{}, fmt.Errorf("STOP_GRANT_INVALID: %w", err)
	}
	canonical, err := canonicalMapJSON(raw)
	if err != nil || !bytes.Equal(raw, canonical) {
		return operationGrant{}, errors.New("STOP_GRANT_INVALID: noncanonical JSON")
	}
	g.digest = digest(raw)
	if err = g.validateStructure(); err != nil {
		return operationGrant{}, fmt.Errorf("STOP_GRANT_INVALID: %w", err)
	}
	return g, nil
}

func canonicalMapJSON(raw []byte) ([]byte, error) {
	d := json.NewDecoder(bytes.NewReader(raw))
	d.UseNumber()
	var v map[string]any
	if err := d.Decode(&v); err != nil {
		return nil, err
	}
	if v == nil {
		return nil, errors.New("JSON object required")
	}
	out, err := json.MarshalIndent(v, "", "  ")
	if err != nil {
		return nil, err
	}
	return append(out, '\n'), nil
}

func loadCompiledOperationGrant() (operationGrant, error) {
	compiledGrantOnce.Do(func() { compiledGrant, compiledGrantErr = parseCompiledOperationGrant(compiledOperationGrantBase64) })
	return compiledGrant, compiledGrantErr
}

func (g *operationGrant) validateStructure() error {
	if g.Schema != grantSchema || !validID(g.OperationID) || g.Purpose != "EXACT_RETAINED_CORE_CRASH_STOP" || g.TrustedOperatorSID == "" || g.RulesetVersion != "strict-closure-v1" || !validSHA(g.SchemaSHA256) {
		return errors.New("grant identity/ruleset")
	}
	issued, e1 := time.Parse(time.RFC3339Nano, g.IssuedAt)
	before, e2 := time.Parse(time.RFC3339Nano, g.NotBefore)
	expiry, e3 := time.Parse(time.RFC3339Nano, g.ExpiresAt)
	if e1 != nil || e2 != nil || e3 != nil || !issued.Equal(before) && issued.After(before) || !expiry.After(before) || expiry.Sub(before) > 30*time.Minute {
		return errors.New("grant interval")
	}
	g.notBefore, g.expires = before, expiry
	for _, f := range []grantFileIdentity{g.DataRoot, g.Database, g.OperationDir} {
		if cleanOwnedLocalPath(f.Path) != nil || f.Volume == 0 || f.Index == 0 {
			return errors.New("grant native file identity")
		}
	}
	if outsideDataRoot(g.OperationDir.Path, g.DataRoot.Path) != nil || g.Database.Path != filepath.Join(g.DataRoot.Path, "researchos.sqlite") {
		return errors.New("grant root/database path")
	}
	n, err := g.Native.observed()
	if err != nil || n.PID == 0 || n.ParentPID == 0 || n.SID != g.TrustedOperatorSID || n.ParentSID != g.TrustedOperatorSID || !validSHA(n.ImageSHA256) || !validSHA(n.ParentImageSHA256) || n.ImageIndex == 0 || n.ParentImageIndex == 0 || cleanOwnedLocalPath(n.ImagePath) != nil || cleanOwnedLocalPath(n.ParentImagePath) != nil {
		return errors.New("grant native process identity")
	}
	if g.Host.DataRoot != g.DataRoot.Path || g.Host.Database != g.Database.Path || g.Host.DatabaseVolume != g.Database.Volume || g.Host.DatabaseIndex != g.Database.Index || g.Host.SID != g.TrustedOperatorSID || g.Host.SchemaVersion != 24 || g.Host.HostID == "" || g.Host.OwnerID == "" || g.Host.OwnerRoot == "" || g.Host.PrincipalRef == "" || !validSHA(g.Host.HostStateSHA256) {
		return errors.New("grant Host/Owner identity")
	}
	if g.Subject.Run != OldRun || g.Subject.Epoch != 1 || g.Subject.DispatchKey != OldDispatch || g.Subject.RequestKey != OldRequest || g.Subject.Project == "" {
		return errors.New("grant old subject")
	}
	if len(g.RequiredProofKinds) != len(proofKinds) {
		return errors.New("proof classes")
	}
	for i, k := range proofKinds {
		if g.RequiredProofKinds[i] != k {
			return errors.New("proof class mismatch")
		}
	}
	if !validGrantDocument(g.HistoricalManifest) {
		return errors.New("historical manifest pin")
	}
	switch g.GrantKind {
	case "PREFLIGHT_ONLY":
		if g.TerminateCount != 0 || len(g.AllowedActions) != 2 || g.AllowedActions[0] != "preflight" || g.AllowedActions[1] != "inspect" || !validGrantDocument(g.Proposal) || !validGrantDocument(g.PreflightScope) || !validGrantDocument(g.PreflightReview) || g.PlanSHA256 != "" || g.PreflightManifestSHA256 != "" || g.StopReview.Path != "" || g.RootOperationScope.Path != "" || g.PreflightGrantSHA256 != "" || g.PreflightExecutableSHA256 != "" {
			return errors.New("preflight grant actions/pins")
		}
	case "STOP_ONCE":
		if g.TerminateCount != 1 || len(g.AllowedActions) != 2 || g.AllowedActions[0] != "commit" || g.AllowedActions[1] != "inspect" || !validSHA(g.PlanSHA256) || !validSHA(g.PreflightManifestSHA256) || !validGrantDocument(g.StopReview) || !validGrantDocument(g.RootOperationScope) || !validSHA(g.PreflightGrantSHA256) || !validSHA(g.PreflightExecutableSHA256) || g.Proposal.Path != "" || g.PreflightScope.Path != "" || g.PreflightReview.Path != "" {
			return errors.New("stop grant actions/pins")
		}
	default:
		return errors.New("grant kind")
	}
	return nil
}

func (g operationGrant) checkAction(action string, live bool) (time.Time, error) {
	allowed := false
	for _, a := range g.AllowedActions {
		if a == action {
			allowed = true
		}
	}
	if !allowed {
		return time.Time{}, errors.New("STOP_GRANT_ACTION_DENIED")
	}
	if !live {
		return time.Time{}, nil
	}
	now := time.Now()
	if now.Before(g.notBefore) || !now.Before(g.expires) {
		return time.Time{}, errors.New("STOP_GRANT_EXPIRED")
	}
	return now.Add(g.expires.Sub(now)), nil
}

const (
	InputSchema      = "researchos.owned-core-stop-input.v1"
	PlanSchema       = "researchos.owned-core-stop-plan.v1"
	ResultSchema     = "researchos.owned-core-stop-result.v1"
	SourceBaseCommit = "4f4023c956f84d65743f39ce77d6c8899a21ada1"
	OldRun           = "f3dcb996b2e43cf52cba874be7abfc70"
	OldDispatch      = "705b11ec99044fef19e85f57e2d2b712"
	OldRequest       = "bc269e772ada7e1bce54439fd080550c"
)

type EvidenceRef struct {
	Kind   string `json:"kind"`
	Path   string `json:"path"`
	SHA256 string `json:"sha256"`
}

// Input names the historical subject and evidence locations, not permission
// flags. It cannot assert that a proof is accepted or a native child is closed.
type Input struct {
	Schema           string                 `json:"schema"`
	OperationID      string                 `json:"operation_id"`
	SourceRepository string                 `json:"source_repository"`
	DataRoot         string                 `json:"data_root"`
	CorePID          uint32                 `json:"core_pid"`
	Subject          store.OwnedStopSubject `json:"subject"`
	Evidence         []EvidenceRef          `json:"evidence"`
	PlanReviewPath   string                 `json:"plan_review_path"`
}

type Plan struct {
	Schema                    string                             `json:"schema"`
	OperationID               string                             `json:"operation_id"`
	SourceBaseCommit          string                             `json:"source_base_commit"`
	OutputDir                 string                             `json:"output_dir"`
	InputSHA256               string                             `json:"input_sha256"`
	GrantSHA256               string                             `json:"grant_sha256,omitempty"`
	PreflightExecutableSHA256 string                             `json:"preflight_executable_sha256,omitempty"`
	Input                     Input                              `json:"input"`
	Native                    supervisor.OwnedCoreNativeIdentity `json:"native"`
	Host                      host.OwnedCoreStopPublicIdentity   `json:"host"`
	BackupPath                string                             `json:"backup_path"`
	BackupSHA256              string                             `json:"backup_sha256"`
	Baseline                  store.OwnedStopCensus              `json:"baseline"`
	PreflightSafety           store.OwnedStopSafetySnapshot      `json:"preflight_safety"`
	EvidenceSHA256            string                             `json:"evidence_sha256,omitempty"`
	Eligibility               string                             `json:"eligibility"`
	Missing                   []string                           `json:"missing,omitempty"`
}

type Result struct {
	Schema          string                          `json:"schema"`
	OperationID     string                          `json:"operation_id"`
	PlanSHA256      string                          `json:"plan_sha256"`
	StopGrantSHA256 string                          `json:"stop_grant_sha256,omitempty"`
	State           string                          `json:"state"`
	Reason          string                          `json:"reason,omitempty"`
	Native          *supervisor.OwnedCoreNativeExit `json:"native,omitempty"`
	Postflight      *store.OwnedStopCensus          `json:"postflight,omitempty"`
}

func digest(raw []byte) string { sum := sha256.Sum256(raw); return hex.EncodeToString(sum[:]) }
func validSHA(s string) bool {
	b, e := hex.DecodeString(s)
	if e != nil || len(b) != 32 || strings.ToLower(s) != s {
		return false
	}
	for _, v := range b {
		if v != 0 {
			return true
		}
	}
	return false
}
func validID(s string) bool {
	b, e := hex.DecodeString(s)
	return e == nil && len(b) == 16 && strings.ToLower(s) == s
}

func strictJSON(raw []byte, v any) error {
	if err := rejectDuplicateJSON(raw); err != nil {
		return err
	}
	d := json.NewDecoder(bytes.NewReader(raw))
	d.DisallowUnknownFields()
	if err := d.Decode(v); err != nil {
		return err
	}
	var rest any
	if err := d.Decode(&rest); err != io.EOF {
		return errors.New("trailing JSON data")
	}
	return nil
}

func rejectDuplicateJSON(raw []byte) error {
	d := json.NewDecoder(bytes.NewReader(raw))
	var walk func(int) error
	walk = func(depth int) error {
		if depth > 64 {
			return errors.New("JSON nesting too deep")
		}
		tok, err := d.Token()
		if err != nil {
			return err
		}
		opening, ok := tok.(json.Delim)
		if !ok {
			return nil
		}
		switch opening {
		case '{':
			seen := make(map[string]struct{})
			for d.More() {
				keyToken, err := d.Token()
				if err != nil {
					return err
				}
				key, ok := keyToken.(string)
				if !ok {
					return errors.New("JSON object key expected")
				}
				if _, exists := seen[key]; exists {
					return errors.New("duplicate JSON key: " + key)
				}
				seen[key] = struct{}{}
				if err := walk(depth + 1); err != nil {
					return err
				}
			}
		case '[':
			for d.More() {
				if err := walk(depth + 1); err != nil {
					return err
				}
			}
		default:
			return errors.New("unexpected JSON delimiter")
		}
		_, err = d.Token()
		return err
	}
	if err := walk(0); err != nil {
		return err
	}
	if _, err := d.Token(); err != io.EOF {
		return errors.New("trailing JSON data")
	}
	return nil
}
func canonicalJSON(v any) ([]byte, error) {
	raw, e := json.MarshalIndent(v, "", "  ")
	if e != nil {
		return nil, e
	}
	return append(raw, '\n'), nil
}

func readInput(path string) (Input, string, error) {
	var in Input
	raw, e := os.ReadFile(path)
	if e != nil {
		return in, "", e
	}
	if len(raw) > 64<<10 {
		return in, "", errors.New("bounded input required")
	}
	if e = strictJSON(raw, &in); e != nil {
		return in, "", e
	}
	if e = validateInput(in); e != nil {
		return in, "", e
	}
	return in, digest(raw), nil
}

func validateInput(in Input) error {
	if in.Schema != InputSchema || !validID(in.OperationID) || in.CorePID == 0 {
		return errors.New("invalid input identity")
	}
	if in.Subject.Run != OldRun || in.Subject.Epoch != 1 || in.Subject.DispatchKey != OldDispatch || in.Subject.RequestKey != OldRequest || in.Subject.Project == "" {
		return errors.New("subject differs from frozen historical window")
	}
	for _, path := range []string{in.SourceRepository, in.DataRoot} {
		if !filepath.IsAbs(path) || filepath.Clean(path) != path || len(filepath.VolumeName(path)) != 2 {
			return errors.New("canonical absolute local roots required")
		}
	}
	return nil
}

func validatePlan(p Plan) error {
	if p.Schema != PlanSchema || p.SourceBaseCommit != SourceBaseCommit || p.OperationID != p.Input.OperationID || p.OutputDir == "" || p.BackupPath != filepath.Join(p.OutputDir, "backup.sqlite") || !validSHA(p.InputSHA256) || !validSHA(p.BackupSHA256) || p.Native.PID != p.Input.CorePID || p.Host.DataRoot != p.Input.DataRoot || p.Host.SID != p.Native.SID || p.Host.SID != p.Native.ParentSID {
		return errors.New("plan field binding invalid")
	}
	if e := validateInput(p.Input); e != nil {
		return e
	}
	if p.Baseline.SHA256 == "" || p.Baseline.QuickCheck != "ok" || p.Host.SchemaVersion != 24 {
		return errors.New("plan baseline invalid")
	}
	return nil
}

REF {'path': 'D:\\作品集\\ResearchOS\\research-os\\.local\\worktrees\\owned-core-stop-anchor-r2-20261015\\internal\\ownedcorestop\\proof_windows.go', 'sha256': 'a2f1ad70a120829ddc50f5780c84524cd51bc29bf29c68601e4a469a14186a62', 'start': 1, 'end': 331}
//go:build windows

package ownedcorestop

import (
	"errors"
	"fmt"
	"os"
	"path/filepath"
	"strings"

	"researchos.local/research-os/internal/host"
	"researchos.local/research-os/internal/store"
)

const proofSchema = "researchos.owned-core-stop-independent-evidence.v1"
const planReviewSchema = "researchos.owned-core-stop-independent-plan-review.v1"
const grantAuthoritySchema = "researchos.owned-core-stop-authority-document.v1"
const historicalManifestSchema = "researchos.owned-core-stop-historical-manifest.v1"

var proofKinds = []string{"f01_ready", "retained_window", "native_entry_gates", "worker_native_exit", "verifier_native_exit", "effect_census", "independent_evidence_review"}

type grantAuthorityDocument struct {
	Schema                    string                           `json:"schema"`
	Role                      string                           `json:"role"`
	OperationID               string                           `json:"operation_id"`
	Action                    string                           `json:"action"`
	Subject                   store.OwnedStopSubject           `json:"subject"`
	Native                    grantNativeIdentity              `json:"native"`
	Host                      host.OwnedCoreStopPublicIdentity `json:"host"`
	OperationDir              grantFileIdentity                `json:"operation_dir"`
	HistoricalManifestSHA256  string                           `json:"historical_manifest_sha256"`
	PlanSHA256                string                           `json:"plan_sha256,omitempty"`
	PreflightManifestSHA256   string                           `json:"preflight_manifest_sha256,omitempty"`
	PreflightGrantSHA256      string                           `json:"preflight_grant_sha256,omitempty"`
	PreflightExecutableSHA256 string                           `json:"preflight_executable_sha256,omitempty"`
	Reviewer                  string                           `json:"reviewer"`
	Verdict                   string                           `json:"verdict"`
}

type historicalManifest struct {
	Schema      string        `json:"schema"`
	OperationID string        `json:"operation_id"`
	Evidence    []EvidenceRef `json:"evidence"`
}

func decodeCanonicalAuthority(raw []byte, v any) error {
	return strictJSON(raw, v)
}

func validateAuthorityDocument(d grantAuthorityDocument, g operationGrant, role, action string) error {
	if d.Schema != grantAuthoritySchema || d.Role != role || d.OperationID != g.OperationID || d.Action != action || d.Subject != g.Subject || d.Native != g.Native || d.Host != g.Host || d.OperationDir != g.OperationDir || d.HistoricalManifestSHA256 != g.HistoricalManifest.SHA256 || d.Reviewer == "" || strings.Contains(d.Reviewer, "owned_core_stop_builder") || d.Verdict != "ACCEPTED" {
		return errors.New("authority document semantics differ")
	}
	if action == "preflight" {
		if d.PlanSHA256 != "" || d.PreflightManifestSHA256 != "" || d.PreflightGrantSHA256 != "" || d.PreflightExecutableSHA256 != "" {
			return errors.New("preflight authority refers to future output")
		}
	} else if d.PlanSHA256 != g.PlanSHA256 || d.PreflightManifestSHA256 != g.PreflightManifestSHA256 || d.PreflightGrantSHA256 != g.PreflightGrantSHA256 || d.PreflightExecutableSHA256 != g.PreflightExecutableSHA256 {
		return errors.New("stop authority predecessor differs")
	}
	return nil
}

func validateHistoricalManifest(g operationGrant, d *heldDocuments, evidence []EvidenceRef) error {
	raw, err := d.read(g.HistoricalManifest, 128<<10)
	if err != nil {
		return err
	}
	var m historicalManifest
	if err = decodeCanonicalAuthority(raw, &m); err != nil {
		return err
	}
	if m.Schema != historicalManifestSchema || m.OperationID != g.OperationID || len(m.Evidence) != len(proofKinds) || len(evidence) != len(proofKinds) {
		return errors.New("historical manifest identity/count")
	}
	for i, k := range proofKinds {
		if m.Evidence[i] != evidence[i] || evidence[i].Kind != k || !validSHA(evidence[i].SHA256) {
			return errors.New("historical manifest class/order/binding")
		}
	}
	return nil
}

func validatePreflightAuthority(g operationGrant, d *heldDocuments, in Input) error {
	if err := validateHistoricalManifest(g, d, in.Evidence); err != nil {
		return err
	}
	for _, item := range []struct {
		ref  grantDocument
		role string
	}{{g.PreflightScope, "root_preflight_scope"}, {g.PreflightReview, "independent_preflight_review"}} {
		if err := verifierPath(in.SourceRepository, item.ref.Path); err != nil {
			return err
		}
		raw, err := d.read(item.ref, 128<<10)
		if err != nil {
			return err
		}
		var doc grantAuthorityDocument
		if err = decodeCanonicalAuthority(raw, &doc); err != nil {
			return err
		}
		if err = validateAuthorityDocument(doc, g, item.role, "preflight"); err != nil {
			return err
		}
	}
	return nil
}

func validateStopAuthority(g operationGrant, d *heldDocuments, p Plan, planSHA string) error {
	if err := validateHistoricalManifest(g, d, p.Input.Evidence); err != nil {
		return err
	}
	for _, item := range []struct {
		ref  grantDocument
		role string
	}{{g.StopReview, "independent_stop_review"}, {g.RootOperationScope, "root_operation_scope"}} {
		if err := verifierPath(p.Input.SourceRepository, item.ref.Path); err != nil {
			return err
		}
		raw, err := d.read(item.ref, 128<<10)
		if err != nil {
			return err
		}
		var doc grantAuthorityDocument
		if err = decodeCanonicalAuthority(raw, &doc); err != nil {
			return err
		}
		if err = validateAuthorityDocument(doc, g, item.role, "commit"); err != nil {
			return err
		}
	}
	if p.Input.PlanReviewPath != g.StopReview.Path || planSHA != g.PlanSHA256 {
		return errors.New("plan review path/hash differs")
	}
	return nil
}

// These are observations in independent receipts, not caller-side booleans.
// Every required digest names a separate raw artifact retained by its reviewer.
type historicalEvidence struct {
	Schema                   string                 `json:"schema"`
	Kind                     string                 `json:"kind"`
	OperationID              string                 `json:"operation_id"`
	SourceCommit             string                 `json:"source_commit"`
	CorePID                  uint32                 `json:"core_pid"`
	CoreCreatedNS            int64                  `json:"core_created_ns"`
	CoreImageSHA256          string                 `json:"core_image_sha256"`
	HostID                   string                 `json:"host_id"`
	OwnerID                  string                 `json:"owner_id"`
	OwnerRoot                string                 `json:"owner_root"`
	Subject                  store.OwnedStopSubject `json:"subject"`
	Reviewer                 string                 `json:"reviewer"`
	RawSHA256                map[string]string      `json:"raw_sha256"`
	NativePID                uint32                 `json:"native_pid,omitempty"`
	NativeCreatedNS          int64                  `json:"native_created_ns,omitempty"`
	NativeExitCode           uint32                 `json:"native_exit_code,omitempty"`
	NativeWaitAPI            string                 `json:"native_wait_api,omitempty"`
	NativeWaitResult         uint32                 `json:"native_wait_result,omitempty"`
	NativeExitAPI            string                 `json:"native_exit_api,omitempty"`
	NativeHandleRecordSHA256 string                 `json:"native_handle_record_sha256,omitempty"`
	BaselineSHA256           string                 `json:"baseline_sha256,omitempty"`
}

type operationPlanReview struct {
	Schema                   string `json:"schema"`
	OperationID              string `json:"operation_id"`
	PlanSHA256               string `json:"plan_sha256"`
	EvidenceSHA256           string `json:"evidence_sha256"`
	SourceCommit             string `json:"source_commit"`
	CoreCreatedNS            int64  `json:"core_created_ns"`
	CoreImageSHA256          string `json:"core_image_sha256"`
	Reviewer                 string `json:"reviewer"`
	Verdict                  string `json:"verdict"`
	RootOperationScopeSHA256 string `json:"root_operation_scope_sha256"`
}

func verifierPath(repo, path string) error {
	if !filepath.IsAbs(repo) || !filepath.IsAbs(path) || filepath.Clean(path) != path {
		return errors.New("canonical independent evidence path required")
	}
	root := filepath.Join(repo, "execution", "verifier")
	rel, err := filepath.Rel(root, path)
	if err != nil || rel == "." || strings.HasPrefix(rel, ".."+string(filepath.Separator)) || rel == ".." || filepath.IsAbs(rel) {
		return errors.New("evidence outside independent verifier namespace")
	}
	actual, err := filepath.EvalSymlinks(path)
	if err != nil || !strings.EqualFold(actual, path) {
		return errors.New("evidence reparse or absence")
	}
	return nil
}

func readEvidence(repo string, ref EvidenceRef) (historicalEvidence, error) {
	var out historicalEvidence
	if !validSHA(ref.SHA256) {
		return out, errors.New("evidence hash required")
	}
	if err := verifierPath(repo, ref.Path); err != nil {
		return out, err
	}
	raw, err := os.ReadFile(ref.Path)
	if err != nil {
		return out, err
	}
	if len(raw) == 0 || len(raw) > 128<<10 || digest(raw) != ref.SHA256 {
		return out, errors.New("evidence content/hash mismatch")
	}
	if err = strictJSON(raw, &out); err != nil {
		return out, err
	}
	if out.Schema != proofSchema || out.Kind != ref.Kind || out.Reviewer == "" || strings.Contains(out.Reviewer, "owned_core_stop_builder") {
		return out, errors.New("independent evidence identity invalid")
	}
	return out, nil
}

func proofNeeds(kind string) []string {
	switch kind {
	case "f01_ready":
		return []string{"main4f_build", "store_open_ready", "wal_full_live_core", "startup_native_identity"}
	case "retained_window":
		return []string{"consumed_original_request", "begin_window_marker", "end_unresolved_return", "scan_durable_fence"}
	case "native_entry_gates":
		return []string{"all_entry_map", "durable_prepare_before_effect", "dispatch_before_worker", "serial_desktop_serve", "no_alternate_bypass"}
	case "worker_native_exit":
		return []string{"original_os_wait_capture", "numeric_exit_capture", "job_drained", "owner_lock_released"}
	case "verifier_native_exit":
		return []string{"original_os_wait_capture", "numeric_exit_capture", "original_verifier_registration"}
	case "effect_census":
		return []string{"complete_current_census", "original_model_receipt", "original_request_hash", "original_dispatch_hash"}
	case "independent_evidence_review":
		return proofKinds[:6]
	default:
		return nil
	}
}

func validateHistoricalEvidence(plan Plan, held ...*heldDocuments) (string, []string) {
	missing := []string{}
	refs := map[string]EvidenceRef{}
	for _, r := range plan.Input.Evidence {
		if _, exists := refs[r.Kind]; exists {
			missing = append(missing, "duplicate "+r.Kind)
		}
		refs[r.Kind] = r
	}
	if len(refs) != len(proofKinds) {
		missing = append(missing, "exact seven independent receipts required")
	}
	observed := map[string]string{}
	for _, kind := range proofKinds {
		ref, ok := refs[kind]
		if !ok {
			missing = append(missing, kind+": missing")
			continue
		}
		var receipt historicalEvidence
		var err error
		if len(held) > 0 && held[0] != nil {
			if err = verifierPath(plan.Input.SourceRepository, ref.Path); err == nil {
				var raw []byte
				raw, err = held[0].read(grantDocument{Path: ref.Path, SHA256: ref.SHA256}, 128<<10)
				if err == nil {
					err = decodeCanonicalAuthority(raw, &receipt)
				}
				if err == nil && (receipt.Schema != proofSchema || receipt.Kind != ref.Kind || receipt.Reviewer == "" || strings.Contains(receipt.Reviewer, "owned_core_stop_builder")) {
					err = errors.New("independent evidence identity invalid")
				}
			}
		} else {
			receipt, err = readEvidence(plan.Input.SourceRepository, ref)
		}
		if err != nil {
			missing = append(missing, kind+": "+err.Error())
			continue
		}
		if receipt.OperationID != plan.OperationID || receipt.SourceCommit != SourceBaseCommit || receipt.CorePID != plan.Native.PID || receipt.CoreCreatedNS != plan.Native.CreatedNS || receipt.CoreImageSHA256 != plan.Native.ImageSHA256 || receipt.HostID != plan.Host.HostID || receipt.OwnerID != plan.Host.OwnerID || receipt.OwnerRoot != plan.Host.OwnerRoot || receipt.Subject != plan.Input.Subject {
			missing = append(missing, kind+": subject/authority/core binding differs")
			continue
		}
		if kind == "worker_native_exit" || kind == "verifier_native_exit" {
			// An ignored cmd.Wait error, a PID-list absence, or an assumed exit 0
			// cannot satisfy this typed original OS wait and numeric-exit receipt.
			if receipt.NativePID == 0 || receipt.NativePID == plan.Native.PID || receipt.NativeCreatedNS == 0 || receipt.NativeWaitAPI != "WaitForSingleObject" || receipt.NativeWaitResult != 0 || receipt.NativeExitAPI != "GetExitCodeProcess" || !validSHA(receipt.NativeHandleRecordSHA256) {
				missing = append(missing, kind+": captured exact OS wait/exit/handle identity absent")
			}
		}
		if kind == "effect_census" && receipt.BaselineSHA256 != plan.Baseline.SHA256 {
			missing = append(missing, kind+": full baseline differs")
		}
		for _, name := range proofNeeds(kind) {
			hash := receipt.RawSHA256[name]
			if !validSHA(hash) {
				missing = append(missing, fmt.Sprintf("%s: %s raw receipt missing", kind, name))
			}
			if kind == "independent_evidence_review" && hash != observed[name] {
				missing = append(missing, kind+": evidence hash differs for "+name)
			}
		}
		observed[kind] = ref.SHA256
	}
	// Bind the seven references and their order into a single reviewable digest.
	raw, _ := canonicalJSON(plan.Input.Evidence)
	return digest(raw), missing
}

func validatePlanReview(plan Plan, planSHA string) error {
	if plan.Input.PlanReviewPath == "" {
		return errors.New("independent operation plan review missing")
	}
	if err := verifierPath(plan.Input.SourceRepository, plan.Input.PlanReviewPath); err != nil {
		return err
	}
	raw, err := os.ReadFile(plan.Input.PlanReviewPath)
	if err != nil {
		return err
	}
	if len(raw) == 0 || len(raw) > 64<<10 {
		return errors.New("bounded plan review required")
	}
	var r operationPlanReview
	if err = strictJSON(raw, &r); err != nil {
		return err
	}
	if r.Schema != planReviewSchema || r.OperationID != plan.OperationID || r.PlanSHA256 != planSHA || r.EvidenceSHA256 != plan.EvidenceSHA256 || r.SourceCommit != SourceBaseCommit || r.CoreCreatedNS != plan.Native.CreatedNS || r.CoreImageSHA256 != plan.Native.ImageSHA256 || r.Reviewer == "" || strings.Contains(r.Reviewer, "owned_core_stop_builder") || r.Verdict != "ACCEPTED" || !validSHA(r.RootOperationScopeSHA256) {
		return errors.New("independent exact plan/root-scope review unavailable")
	}
	return nil
}

