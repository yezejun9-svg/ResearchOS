+.workbench-conversation-pane .session-composer{margin-top:auto}
+.workbench-context-pane .workspace-layout{grid-template-columns:minmax(0,1fr)}
+.workbench-context-pane .workspace-layout>*{min-width:0}
+.workbench-context-pane .workspace-layout label{margin:8px 0}
+.workbench-context-pane .file-editor{min-height:180px}
+.workbench-context-pane .file-list{max-height:180px;overflow:auto}
+.workbench-layout .session-picker button[aria-current=page]{background:var(--accent-soft);color:var(--text);font-weight:650}
+.workbench-layout .conversation-message{padding:12px 0}
+.workbench-layout .section-heading h2{overflow-wrap:anywhere}
+.workbench-layout pre,.workbench-layout .break-all{overflow-wrap:anywhere}
+.browser-workbench{display:grid;grid-template-columns:minmax(0,1fr) minmax(250px,290px);gap:16px;align-items:start}
+.browser-workbench>*{min-width:0}
+.browser-inspector .panel{padding:16px;margin-bottom:12px}
+.browser-inspector .section-heading{margin-bottom:10px}
+.browser-inspector .empty-state{padding:0}
+.workbench-facts{margin:0 0 10px}
+.workbench-facts>div{display:flex;justify-content:space-between;gap:12px;padding:7px 0;border-bottom:1px solid var(--border)}
+.workbench-facts dt{color:var(--muted)}
+.workbench-facts dd{margin:0;text-align:right;font-weight:650;overflow-wrap:anywhere}
+.setup-disclosure{margin:12px 0;padding:8px 0;border-top:1px solid var(--border);border-bottom:1px solid var(--border)}
+.setup-disclosure>summary{color:var(--accent);font-weight:650;cursor:pointer;min-height:36px;display:list-item;list-style-position:inside}
+.setup-disclosure[open]>summary{margin-bottom:12px}
+.drawer-overlay.visible{display:block;position:fixed;inset:var(--header-height,56px) 0 0;background:#0008;z-index:30}
+.workbench-route .progress-rail.drawer-open{display:block;position:fixed;right:0;top:var(--header-height,56px);bottom:0;width:min(320px,90vw);z-index:32;overflow:auto}
+.workbench-route .progress-rail.drawer-open .drawer-close{display:inline-grid}
+@media(max-width:1279px){.app-grid.workbench-route{grid-template-columns:64px minmax(0,1fr)}}
+@media(max-width:1000px){.workbench-layout{grid-template-columns:minmax(160px,0.26fr) minmax(0,1fr)}.workbench-context-pane{grid-column:1/-1}.workbench-context-pane .workspace-layout{grid-template-columns:minmax(160px,0.28fr) minmax(0,1fr)}}
+@media(max-width:850px){.browser-workbench{grid-template-columns:minmax(0,1fr)}}
+@media(max-width:767px){.app-grid.workbench-route{display:block}.workbench-route .main-area{padding:20px 12px 92px}.workbench-layout{grid-template-columns:minmax(0,1fr)}.workbench-context-pane{grid-column:auto}.workbench-context-pane .workspace-layout{grid-template-columns:minmax(0,1fr)}.workbench-session-pane .session-picker{max-height:none;display:flex;flex-wrap:wrap;gap:6px}.workbench-session-pane .session-picker li{flex:1 1 140px}.workbench-conversation-pane>.session-center>.panel:first-child{min-height:0}.workbench-conversation-pane .conversation-transcript{max-height:none}.workbench-route .page-heading{margin-bottom:18px}}
+:root{font-family:'Segoe UI','Microsoft YaHei UI','Microsoft YaHei','PingFang SC',system-ui,sans-serif}
