+    {deviceSession.device && <div className="connection-banner" role="status">{(api?.deviceRole() || deviceSession.device.role) === 'READER' ? '此设备为只读监督；控制操作需要电脑显式授权。' : '此设备可控制已授权项目；设备和全局设置仍由电脑管理。'}</div>}
+    {feedback && <div className={`feedback ${feedback.kind}`} role="status"><span>{feedback.text}</span><button aria-label="关闭提示" onClick={() => setFeedback(null)}><Icon name="close"/></button></div>}
+    <div className={`drawer-overlay ${drawer ? 'visible' : ''}`} onClick={() => setDrawer(null)}/>
+    <div className={`app-grid ${route.kind === 'workbench' ? 'workbench-route' : ''}`}><nav className={`sidebar ${drawer === 'nav' ? 'drawer-open' : ''}`} aria-label="主导航" inert={(compact || !!drawer) && drawer !== 'nav'}><div className="sidebar-inner"><div className="sidebar-head"><span>项目空间</span><button className="icon-button drawer-close" aria-label="关闭导航" onClick={() => setDrawer(null)}><Icon name="close"/></button></div><Link to="/" navigate={navigate} className="project-switch">{profile?.name || '选择项目'}<small>{projectId ? '切换项目' : '项目入口'}</small></Link><div className="nav-group">{navigation.map(([icon, label, kind]) => <Link key={kind} to={navUrl(kind)} navigate={navigate} aria-label={label} className={`nav-link ${route.kind === kind ? 'active' : ''}`}><Icon name={icon}/><span>{label}</span></Link>)}</div><div className="sidebar-bottom"><span className={`connection-dot ${events.online ? '' : 'offline-dot'}`}/> {events.online ? '已连接' : events.message || '连接中断'}<small>开发阶段 · 以服务回执为准</small></div></div></nav>
