267-func TestClientQueueBackupRequiresMatchingPortableSidecar(t *testing.T) {
268-	for _, mode := range []string{"missing", "disagreement"} {
269-		t.Run(mode, func(t *testing.T) {
270-			f, _, _, _ := queueBackupFixture(t)
271-			key := backupTestKey(t)
272-			backup, manifest := backupTestCreate(t, f.s, key)
273-			kept := []BackupFile{}
274-			for _, entry := range manifest.Files {
275-				if entry.Name != "command-queue.json" {
276-					kept = append(kept, entry)
277-					continue
278-				}
279-				if mode == "disagreement" {
280-					plain := Bytes(Object{"format": "RESEARCHOS_COMMAND_QUEUE_V1", "client_command_queue": Empty()})
281-					cipher, err := backupCipher(key)
282-					if err != nil {
283-						t.Fatal(err)
284-					}
285-					raw, err := backupEncrypt(cipher, manifest.ID, entry.Name, plain)
286-					if err != nil {
287-						t.Fatal(err)
288-					}
289-					if err = os.WriteFile(filepath.Join(backup, entry.Name+".enc"), raw, 0600); err != nil {
290-						t.Fatal(err)
291-					}
292-					entry.Hash = Digest(plain)
293-					entry.Size = len(plain)
294-					kept = append(kept, entry)
295-				}
296-			}
297-			manifest.Files = kept
298-			manifest.MAC = backupMAC(manifest, key)
299-			if err := os.WriteFile(filepath.Join(backup, "manifest.json"), Bytes(manifest), 0600); err != nil {
300-				t.Fatal(err)
301-			}
302-			if _, err := RestoreBackup(context.Background(), backup, filepath.Join(t.TempDir(), "restore"), backupOpt(t, f.s, key)); err == nil {
303-				t.Fatal("authenticated but incomplete/disagreeing queue sidecar accepted")
304-			}
305-		})
306-	}
307-}
308-func TestClientQueueFreshInstallRollsBackMissingAdditiveSchema(t *testing.T) {
309-	for _, mode := range []string{"missing", "corrupt"} {
310-		t.Run(mode, func(t *testing.T) {
311-			root := t.TempDir()
312-			migrationDir := filepath.Join(root, "migrations")
313-			if err := os.Mkdir(migrationDir, 0700); err != nil {
314-				t.Fatal(err)
315-			}
316-			entries, err := os.ReadDir("../../migrations/sqlite")
317-			if err != nil {
318-				t.Fatal(err)
319-			}
320-			for _, entry := range entries {
321-				if entry.IsDir() || entry.Name() == "next_v24_sessions.sql" {
322-					continue
323-				}
324-				raw, err := os.ReadFile(filepath.Join("../../migrations/sqlite", entry.Name()))
325-				if err != nil {
326-					t.Fatal(err)
327-				}
328-				if err = os.WriteFile(filepath.Join(migrationDir, entry.Name()), raw, 0600); err != nil {
329-					t.Fatal(err)
330-				}
331-			}
332-			if mode == "corrupt" {
333-				if err = os.WriteFile(filepath.Join(migrationDir, "next_v24_sessions.sql"), []byte("CREATE TABLE partial_schema(id TEXT); invalid SQL;"), 0600); err != nil {
334-					t.Fatal(err)
335-				}
336-			}
337-			db, err := store.Open(filepath.Join(root, "state.sqlite"))
338-			if err != nil {
339-				t.Fatal(err)
340-			}
341-			defer db.Close()
342-			if err = store.Bootstrap(context.Background(), db, filepath.Join(migrationDir, "0001_bootstrap.sql")); err != nil {
343-				t.Fatal(err)
344-			}
345-			if _, err = New(db, "../../spec/v2.0/contracts", filepath.Join(migrationDir, "0002_domain.sql")); err == nil {
346-				t.Fatal("missing/corrupt additive schema accepted")
347-			}
348-			var version, tables int
349-			if err = db.QueryRow(`SELECT max(version) FROM schema_migrations`).Scan(&version); err != nil {
350-				t.Fatal(err)
351-			}
352-			if err = db.QueryRow(`SELECT count(*) FROM sqlite_master WHERE type='table' AND name IN ('client_command_queue','client_queue_fences','partial_schema')`).Scan(&tables); err != nil {
353-				t.Fatal(err)
354-			}
355-			if version != 1 || tables != 0 {
356-				t.Fatalf("partially installed numbered/additive migration: version=%d tables=%d", version, tables)
357-			}
358-		})
359-	}
360-}
