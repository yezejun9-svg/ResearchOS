1:param([ValidateSet('Q01','Q02')][string]$Case,[string]$Attempt='')
2:$ErrorActionPreference = 'Stop'
3:$evidence = Split-Path -Parent $MyInvocation.MyCommand.Path
4:$logger = Join-Path $evidence 'Invoke-EvidenceCommand.ps1'
5:$repo = 'D:/作品集/ResearchOS/research-os/.local/worktrees/online-backup-fixture-qualification-20261015'
6:$task = 'D:/作品集/ResearchOS/research-os/.local/online-backup-fixture-qualification-20261015-tmp'
7:$caseRoot = Join-Path (Join-Path $task 'fixture') $Case
8:$data = Join-Path $caseRoot 'source-data'
9:$db = Join-Path $data 'researchos.sqlite'
10:$suffix = if ($Attempt) { "-$Attempt" } else { '' }
11:$key = Join-Path (Join-Path $task 'private') "$Case$suffix-recovery.key"
12:$package = Join-Path $caseRoot "encrypted-backup$suffix"
13:$restored = Join-Path $caseRoot "restored-data$suffix"
14:$prefix = $Case.ToLowerInvariant() + $suffix
15:$python = 'python'
16:$backup = Join-Path (Join-Path $task 'build') 'backup.exe'
17:$holderExe = Join-Path (Join-Path $task 'build') 'lease_holder.exe'
18:$probe = Join-Path (Join-Path $task 'build') 'lease_probe.exe'
19:$envTask = @{TMP=(Join-Path $task 'tmp');TEMP=(Join-Path $task 'tmp');GOTMPDIR=(Join-Path $task 'go-tmp');GOCACHE=(Join-Path $task 'go-cache')}
21:& $logger -Id "$prefix-keygen" -Exe $backup -Arguments @('keygen','--key-file',$key) -WorkingDirectory $repo -EnvOverride $envTask -Quiet
22:if ($LASTEXITCODE -ne 0) { throw 'keygen failed' }
24:$holderId = "$prefix-holder"
25:$holderRecipe = [ordered]@{id=$holderId;at_utc=[DateTime]::UtcNow.ToString('o');exe=$holderExe;argv=@($data);cwd=$repo;env_override=$envTask;stdout="$holderId.stdout.raw";stderr="$holderId.stderr.raw";status='prewritten';expected_normal_exit=0}
26:$holderRecipe | ConvertTo-Json -Depth 8 | Set-Content -LiteralPath (Join-Path $evidence "$holderId.recipe.json") -Encoding utf8NoBOM
27:$psi = [Diagnostics.ProcessStartInfo]::new()
28:$psi.FileName = $holderExe
29:$psi.WorkingDirectory = $repo
30:$psi.UseShellExecute = $false
31:$psi.RedirectStandardInput = $true
32:$psi.RedirectStandardOutput = $true
33:$psi.RedirectStandardError = $true
34:foreach($name in $envTask.Keys) { $psi.Environment[$name] = [string]$envTask[$name] }
35:[void]$psi.ArgumentList.Add($data)
36:$process = [Diagnostics.Process]::new()
37:$process.StartInfo = $psi
38:$ready = $null
39:$holderError = $null
40:try {
41:    [void]$process.Start()
42:    $lineTask = $process.StandardOutput.ReadLineAsync()
43:    if (-not $lineTask.Wait(15000)) { throw 'holder readiness timed out' }
44:    $ready = $lineTask.Result
45:    if ($ready -notmatch '"status":"HELD"' -or $ready -notmatch '"held":true') { throw "holder did not report live lease: $ready" }
46:    & $logger -Id "$prefix-probe-before" -Exe $probe -Arguments @($data) -WorkingDirectory $repo -EnvOverride $envTask -Quiet
47:    if ($LASTEXITCODE -ne 10) { throw "lease challenger before create exited $LASTEXITCODE" }
48:    & $logger -Id "$prefix-db-before" -Exe $python -Arguments @('-B','-Xutf8',(Join-Path $evidence 'census.py'),'db',$db) -WorkingDirectory $repo -EnvOverride $envTask -Quiet
49:    if ($LASTEXITCODE -ne 0) { throw 'db baseline failed' }
50:    & $logger -Id "$prefix-files-before" -Exe $python -Arguments @('-B','-Xutf8',(Join-Path $evidence 'census.py'),'files',$data) -WorkingDirectory $repo -EnvOverride $envTask -Quiet
51:    if ($LASTEXITCODE -ne 0) { throw 'file baseline failed' }
52:    & $logger -Id "$prefix-acl-before" -Exe icacls -Arguments @($data,'/T') -WorkingDirectory $repo -EnvOverride $envTask -Quiet
53:    if ($LASTEXITCODE -ne 0) { throw 'ACL baseline failed' }
54:    & $logger -Id "$prefix-create" -Exe $backup -Arguments @('create','--db',$db,'--out',$package,'--key-file',$key,'--root',$repo) -WorkingDirectory $repo -EnvOverride $envTask -Quiet
55:    if ($LASTEXITCODE -ne 0) { throw "CLI create failed with $LASTEXITCODE" }
56:    if ($process.HasExited) { throw 'lease holder exited during create' }
57:    & $logger -Id "$prefix-probe-after" -Exe $probe -Arguments @($data) -WorkingDirectory $repo -EnvOverride $envTask -Quiet
58:    if ($LASTEXITCODE -ne 10) { throw "lease challenger after create exited $LASTEXITCODE" }
59:    & $logger -Id "$prefix-db-after" -Exe $python -Arguments @('-B','-Xutf8',(Join-Path $evidence 'census.py'),'db',$db) -WorkingDirectory $repo -EnvOverride $envTask -Quiet
60:    if ($LASTEXITCODE -ne 0) { throw 'db after failed' }
61:    & $logger -Id "$prefix-files-after" -Exe $python -Arguments @('-B','-Xutf8',(Join-Path $evidence 'census.py'),'files',$data) -WorkingDirectory $repo -EnvOverride $envTask -Quiet
62:    if ($LASTEXITCODE -ne 0) { throw 'file after failed' }
63:    & $logger -Id "$prefix-acl-after" -Exe icacls -Arguments @($data,'/T') -WorkingDirectory $repo -EnvOverride $envTask -Quiet
64:    if ($LASTEXITCODE -ne 0) { throw 'ACL after failed' }
65:} catch { $holderError = $_.Exception.Message }
66:finally {
67:    if (-not $process.HasExited) {
68:        $process.StandardInput.WriteLine('release')
69:        $process.StandardInput.Flush()
70:        $process.StandardInput.Close()
71:    }
72:    if (-not $process.WaitForExit(15000)) { $holderError = "holder did not exit normally: $holderError" }
73:    $tail = $process.StandardOutput.ReadToEnd()
74:    $ready + "`n" + $tail | Set-Content -LiteralPath (Join-Path $evidence "$holderId.stdout.raw") -Encoding utf8NoBOM -NoNewline
75:    $process.StandardError.ReadToEnd() | Set-Content -LiteralPath (Join-Path $evidence "$holderId.stderr.raw") -Encoding utf8NoBOM -NoNewline
76:    [ordered]@{id=$holderId;pid=$process.Id;native_exit=$process.ExitCode;held_ready=($ready -match '"status":"HELD"');at_utc=[DateTime]::UtcNow.ToString('o');error=$holderError} | ConvertTo-Json -Compress | Set-Content -LiteralPath (Join-Path $evidence "$holderId.exit.json") -Encoding utf8NoBOM
77:}
78:if ($holderError) { throw $holderError }
79:if ($process.ExitCode -ne 0) { throw "holder exited $($process.ExitCode)" }
80:& $logger -Id "$prefix-probe-released" -Exe $probe -Arguments @($data) -WorkingDirectory $repo -EnvOverride $envTask -Quiet
81:if ($LASTEXITCODE -ne 0) { throw "released lease not reacquirable: $LASTEXITCODE" }
82:& $logger -Id "$prefix-restore" -Exe $backup -Arguments @('restore','--as-data-root','--backup',$package,'--out',$restored,'--key-file',$key,'--root',$repo) -WorkingDirectory $repo -EnvOverride $envTask -Quiet
83:if ($LASTEXITCODE -ne 0) { throw "restore failed: $LASTEXITCODE" }
84:& $logger -Id "$prefix-db-restored" -Exe $python -Arguments @('-B','-Xutf8',(Join-Path $evidence 'census.py'),'db',(Join-Path $restored 'researchos.sqlite')) -WorkingDirectory $repo -EnvOverride $envTask -Quiet
85:if ($LASTEXITCODE -ne 0) { throw 'restored DB census failed' }
86:Write-Output "$Case CREATE_AND_RESTORE_COMPLETED holder_exit=$($process.ExitCode)"
