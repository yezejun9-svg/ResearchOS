118-func TestClientQueueFreshNumberedSchema(t *testing.T) {
119-	f := setup(t)
120-	_, sqls, err := upgradeConfigurationRelease("../..", 23)
121-	if err != nil || len(sqls) != 24 {
122-		t.Fatalf("exact installed schema23 release: %d %v", len(sqls), err)
123-	}
124-	want := len(sqls) - 1 // The final entry is the separately pinned additive SQL.
125-	rows, err := f.db.Query(`SELECT version FROM schema_migrations ORDER BY version`)
126-	if err != nil {
127-		t.Fatal(err)
128-	}
129-	count := 0
130-	for rows.Next() {
131-		count++
132-		var applied int
133-		if err = rows.Scan(&applied); err != nil || applied != count {
134-			rows.Close()
135-			t.Fatalf("noncontiguous installed migration %d: %d %v", count, applied, err)
136-		}
137-	}
138-	if err = rows.Err(); err != nil || count != want {
139-		rows.Close()
140-		t.Fatalf("installed migration count=%d want=%d %v", count, want, err)
141-	}
142-	rows.Close()
143-	var version int
144-	if err := f.db.QueryRow(`SELECT max(version) FROM schema_migrations`).Scan(&version); err != nil || version != want {
145-		t.Fatalf("migration=%d %v", version, err)
146-	}
147-	for _, table := range clientQueueTables {
148-		var n int
149-		if err := f.db.QueryRow(`SELECT count(*) FROM ` + table).Scan(&n); err != nil || n != 0 {
150-			t.Fatalf("fresh table %s %d %v", table, n, err)
151-		}
152-	}
153-	if raw, err := os.ReadFile("../../migrations/sqlite/0022_client_command_queue.sql"); err != nil || len(raw) == 0 {
154-		t.Fatal("numbered SQL absent", err)
155-	}
156-	configurationEvidenceSnapshot(t, f.db, "fresh-current23")
157-}
