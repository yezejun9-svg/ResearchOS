99-					_, err := tx.Exec(`INSERT INTO client_control_receipts(receipt_id,project,generation,kind,body,body_hash,created_at) VALUES(?,?,?,'TEST','{}','bad',?)`, ID(), f.project, generation, Now())
100-					return err
