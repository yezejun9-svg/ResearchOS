55-	db.QueryRow(`SELECT count(*) FROM client_control_receipts WHERE kind='RESTORE_UNKNOWN'`).Scan(&receipts)
56-	db.QueryRow(`SELECT count(*) FROM domain_objects WHERE kind='Run'`).Scan(&runs)
