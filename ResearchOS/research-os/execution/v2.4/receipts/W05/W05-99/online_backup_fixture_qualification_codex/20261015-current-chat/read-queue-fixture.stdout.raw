66-	}
67-	restoredService := &Service{DB: db, Contracts: f.s.Contracts}
68-	again := filepath.Join(t.TempDir(), "rebackup")
69-	if _, err = restoredService.CreateBackup(context.Background(), again, key); err != nil {
70-		t.Fatal(err)
71-	}
72-	if _, err = RestoreBackup(context.Background(), again, filepath.Join(t.TempDir(), "restore-again"), backupOpt(t, restoredService, key)); err != nil {
73-		t.Fatal(err)
74-	}
75-}
