internal/store/sqlite.go:50:// Ready checks the live connection settings, rather than treating a file as readiness.
internal/store/sqlite.go:51:func Ready(ctx context.Context, db *sql.DB) error {
internal/store/sqlite.go:52:	for pragma, want := range map[string]string{
internal/store/sqlite.go:53:		"foreign_keys": "1", "journal_mode": "wal", "synchronous": "2", "busy_timeout": "5000",
internal/store/sqlite.go:54:	} {
internal/store/sqlite.go:55:		var got string
internal/store/sqlite.go:56:		if err := db.QueryRowContext(ctx, "PRAGMA "+pragma).Scan(&got); err != nil {
