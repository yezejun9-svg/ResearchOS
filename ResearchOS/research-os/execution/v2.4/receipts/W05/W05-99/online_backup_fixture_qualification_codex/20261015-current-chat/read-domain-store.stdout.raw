internal/store/sqlite.go:61:		}
internal/store/sqlite.go:62:	}
internal/store/sqlite.go:63:	var integrity string
internal/store/sqlite.go:64:	if err := db.QueryRowContext(ctx, "PRAGMA quick_check").Scan(&integrity); err != nil {
internal/store/sqlite.go:65:		return err
internal/store/sqlite.go:66:	}
internal/store/sqlite.go:67:	if integrity != "ok" {
internal/store/sqlite.go:68:		return fmt.Errorf("sqlite quick_check: %s", integrity)
internal/store/sqlite.go:69:	}
internal/store/sqlite.go:70:	return nil
internal/store/sqlite.go:71:}
