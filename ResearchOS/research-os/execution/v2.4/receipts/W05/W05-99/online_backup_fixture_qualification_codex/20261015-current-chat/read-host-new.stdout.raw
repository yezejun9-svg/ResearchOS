internal/host/host.go:23:	"researchos.local/research-os/internal/auth"
internal/host/host.go:24:	"researchos.local/research-os/internal/domain"
internal/host/host.go:25:)
internal/host/host.go:27:const (
internal/host/host.go:28:	// MaxSessionTTL mirrors the existing host credential ceiling (22: short sessions only).
internal/host/host.go:29:	MaxSessionTTL = 15 * time.Minute
internal/host/host.go:30:	// DefaultSessionTTL is what the host issues unless configured lower.
internal/host/host.go:31:	DefaultSessionTTL = MaxSessionTTL
internal/host/host.go:32:	// SelectionTTL is the published single-use window for a workspace selection reference.
internal/host/host.go:33:	SelectionTTL = 5 * time.Minute
internal/host/host.go:34:	// MaxSelectionRecords bounds the local reference table so a hostile loop cannot grow it.
internal/host/host.go:35:	MaxSelectionRecords = 256
internal/host/host.go:36:)
internal/host/host.go:38:var (
internal/host/host.go:39:	ErrNoOwner            = errors.New("OWNER_NOT_INITIALIZED")
internal/host/host.go:40:	ErrMultipleOwners     = errors.New("MULTIPLE_OWNER_STATE")
internal/host/host.go:41:	ErrOwnerTaken         = errors.New("OWNER_ALREADY_INITIALIZED")
internal/host/host.go:42:	ErrPrincipalRevoked   = errors.New("PRINCIPAL_REVOKED")
internal/host/host.go:43:	ErrHostIdentity       = errors.New("OS_IDENTITY_MISMATCH")
internal/host/host.go:44:	ErrUntrustedTransport = errors.New("UNTRUSTED_TRANSPORT")
internal/host/host.go:45:	// ErrUntrustedPathChoice refuses a directory a client named by itself when no user chooser
internal/host/host.go:46:	// confirmed it: binding a caller-typed path is how a "user-chosen workspace" becomes a
internal/host/host.go:47:	// drive-by path.
internal/host/host.go:48:	ErrUntrustedPathChoice = errors.New("FORBIDDEN")
internal/host/host.go:49:	ErrBadState            = errors.New("HOST_STATE_INVALID")
internal/host/host.go:50:)
internal/host/host.go:52:// Config wires the host onto an already-migrated database. ContractsDir and MigrationFile are
internal/host/host.go:53:// the existing host inputs (same values apps/control uses) so domain validation stays one
internal/host/host.go:54:// implementation rather than a second one tuned for tests.
internal/host/host.go:55:type Config struct {
internal/host/host.go:56:	DB            *sql.DB
internal/host/host.go:57:	Dir           string
internal/host/host.go:58:	// Trial-only read access to one existing DPAPI record; the new DB stays isolated.
internal/host/host.go:59:	ReadOnlyModelVaultDir string
internal/host/host.go:60:	ReadOnlyModelCredentialRef string
internal/host/host.go:61:	ReadOnlyModelProvider string
internal/host/host.go:62:	ContractsDir  string
internal/host/host.go:63:	MigrationFile string
internal/host/host.go:64:	SessionTTL    time.Duration
internal/host/host.go:65:	// SchemaDir holds the pinned client.protocol.schema.json plus domain.schema.json the bridge
internal/host/host.go:66:	// grades its frames against. Without it the host refuses to start rather than accepting
internal/host/host.go:67:	// frames nobody has graded.
internal/host/host.go:68:	SchemaDir string
internal/host/host.go:69:	Now       func() time.Time
internal/host/host.go:70:	// AllowNonWindows is only used to keep the package buildable; the bootstrap path refuses
internal/host/host.go:71:	// to run anywhere the OS identity cannot be verified as the local principal.
internal/host/host.go:72:	AllowNonWindows bool
internal/host/host.go:73:	// PeerIdentityResolver decides who is on the other end of a native connection. The default
internal/host/host.go:74:	// is the real OS lookup (auth.ProcessIdentity). Qualification may substitute it to prove the
internal/host/host.go:75:	// serve path refuses a peer whose resolved principal is not the host owner: the seam only
internal/host/host.go:76:	// replaces the OS answer, it cannot replace the comparison, so a host that stopped comparing
internal/host/host.go:77:	// would accept a peer the resolver called foreign.
internal/host/host.go:78:	PeerIdentityResolver func(pid uint32) (auth.Identity, error)
internal/host/host.go:79:	// ProtocolVersion is the version this host stamps into bridge replies. It defaults to the
internal/host/host.go:80:	// pinned researchos-client/2; a host built for any other version has its replies refused by
internal/host/host.go:81:	// contract grading, which is what keeps the bridge from growing a private dialect.
internal/host/host.go:82:	ProtocolVersion string
internal/host/host.go:83:}
