internal/host/bootstrap.go:57:		}
internal/host/bootstrap.go:58:		sess, err := h.issue(ctx, ownerID)
internal/host/bootstrap.go:59:		if err != nil {
internal/host/bootstrap.go:60:			return nil, err
internal/host/bootstrap.go:61:		}
internal/host/bootstrap.go:62:		h.state.PrincipalID = ownerID
internal/host/bootstrap.go:63:		h.state.PrincipalRef = fresh.Ref
internal/host/bootstrap.go:64:		if h.state.HostInstanceID == "" {
internal/host/bootstrap.go:65:			h.state.HostInstanceID = h.InstanceID()
internal/host/bootstrap.go:66:			h.state.BootstrapAt = h.nowUTC().Format(time.RFC3339Nano)
internal/host/bootstrap.go:67:		}
internal/host/bootstrap.go:68:		h.state.BootstrapIterations++
internal/host/bootstrap.go:69:		h.state.CreatedOwner = h.state.CreatedOwner || false
internal/host/bootstrap.go:70:		if err := h.saveState(h.state); err != nil {
internal/host/bootstrap.go:71:			return nil, err
internal/host/bootstrap.go:72:		}
internal/host/bootstrap.go:73:		return &BootstrapResult{PrincipalID: ownerID, PrincipalRef: fresh.Ref, BoundExisting: true,
internal/host/bootstrap.go:74:			CreatedOwner: false, Iterations: h.state.BootstrapIterations, Session: sess}, nil
internal/host/bootstrap.go:75:	case owners == 0 && total > 0:
internal/host/bootstrap.go:76:		// Principals exist but none is an OWNER: the local admin path created them, and this
internal/host/bootstrap.go:77:		// bootstrap must not silently promote one of them.
internal/host/bootstrap.go:78:		return nil, ErrNoOwner
internal/host/bootstrap.go:79:	case owners == 0 && total == 0:
internal/host/bootstrap.go:80:		id := "owner-" + domain.ID()
internal/host/bootstrap.go:81:		if err := h.domain.ProvisionPrincipal(ctx, domain.Principal{
internal/host/bootstrap.go:82:			ID: id, Roles: []string{"OWNER"}, CanCreateProject: true,
internal/host/bootstrap.go:83:		}); err != nil {
internal/host/bootstrap.go:84:			return nil, fmt.Errorf("owner initialisation failed: %w", err)
internal/host/bootstrap.go:85:		}
internal/host/bootstrap.go:86:		sess, err := h.issue(ctx, id)
internal/host/bootstrap.go:87:		if err != nil {
internal/host/bootstrap.go:88:			return nil, fmt.Errorf("owner session failed: %w", err)
internal/host/bootstrap.go:89:		}
internal/host/bootstrap.go:90:		h.state = &hostState{Version: 1, PrincipalID: id, PrincipalRef: fresh.Ref,
internal/host/bootstrap.go:91:			HostInstanceID: h.InstanceID(), BootstrapAt: h.nowUTC().Format(time.RFC3339Nano),
internal/host/bootstrap.go:92:			CreatedOwner: true, BootstrapIterations: 1}
internal/host/bootstrap.go:93:		h.state.ActiveCredentialHash = domain.Digest([]byte(sess.Token))
internal/host/bootstrap.go:94:		if err := h.saveState(h.state); err != nil {
internal/host/bootstrap.go:95:			return nil, err
internal/host/bootstrap.go:96:		}
internal/host/bootstrap.go:97:		return &BootstrapResult{PrincipalID: id, PrincipalRef: fresh.Ref, CreatedOwner: true,
internal/host/bootstrap.go:98:			Iterations: 1, Session: sess}, nil
internal/host/bootstrap.go:99:	}
internal/host/bootstrap.go:100:	return nil, errors.New("unreachable bootstrap state")
internal/host/bootstrap.go:101:}
internal/host/bootstrap.go:103:// issue creates the short credential and hands it to the local user through the host's private
internal/host/bootstrap.go:104:// 0600 file. The bridge reply deliberately does not carry it, so the renderer never sees a token
internal/host/bootstrap.go:105:// and the user never copies one out of a log or console. A renewal supersedes the credential it
internal/host/bootstrap.go:106:// replaces: the old one is revoked immediately rather than left live for the rest of its TTL,
internal/host/bootstrap.go:107:// because "the token in the file" must be the only token that works.
internal/host/bootstrap.go:108:func (h *Host) issue(ctx context.Context, principalID string) (Session, error) {
internal/host/bootstrap.go:109:	previous := ""
internal/host/bootstrap.go:110:	if h.state != nil {
internal/host/bootstrap.go:111:		previous = h.state.ActiveCredentialHash
internal/host/bootstrap.go:112:	}
internal/host/bootstrap.go:113:	token, err := h.domain.IssueCredential(ctx, principalID, h.ttl)
internal/host/bootstrap.go:114:	if err != nil {
internal/host/bootstrap.go:115:		return Session{}, err
internal/host/bootstrap.go:116:	}
internal/host/bootstrap.go:117:	hash := domain.Digest([]byte(token))
internal/host/bootstrap.go:118:	if previous != "" && previous != hash {
internal/host/bootstrap.go:119:		if err := h.revokeCredentialByHash(ctx, principalID, previous); err != nil {
internal/host/bootstrap.go:120:			return Session{}, err
internal/host/bootstrap.go:121:		}
internal/host/bootstrap.go:122:	}
internal/host/bootstrap.go:123:	now := h.nowUTC()
internal/host/bootstrap.go:124:	sess := Session{PrincipalID: principalID, PrincipalRef: h.identity.Ref, Token: token,
internal/host/bootstrap.go:125:		IssuedAt: now, ExpiresAt: now.Add(h.ttl), TTLSec: int64(h.ttl / time.Second)}
internal/host/bootstrap.go:126:	if err := h.writeSessionFile(sess); err != nil {
internal/host/bootstrap.go:127:		return Session{}, err
internal/host/bootstrap.go:128:	}
internal/host/bootstrap.go:129:	if h.state != nil {
internal/host/bootstrap.go:130:		h.state.ActiveCredentialHash = hash
internal/host/bootstrap.go:131:	}
internal/host/bootstrap.go:132:	return sess, nil
internal/host/bootstrap.go:133:}
internal/host/bootstrap.go:135:// revokeCredentialByHash marks exactly one credential row revoked, identified by the hash the
internal/host/bootstrap.go:136:// host itself issued. The host never searches or decrypts a token and never touches another
internal/host/bootstrap.go:137:// principal's rows: an already-absent row is not an error.
internal/host/bootstrap.go:138:func (h *Host) revokeCredentialByHash(ctx context.Context, principalID, tokenHash string) error {
internal/host/bootstrap.go:139:	if principalID == "" || tokenHash == "" {
internal/host/bootstrap.go:140:		return nil
internal/host/bootstrap.go:141:	}
internal/host/bootstrap.go:142:	_, err := h.db.ExecContext(ctx, `UPDATE auth_credentials SET revoked=1 WHERE principal=? AND token_hash=?`,
internal/host/bootstrap.go:143:		principalID, tokenHash)
internal/host/bootstrap.go:144:	return err
internal/host/bootstrap.go:145:}
internal/host/bootstrap.go:147:// scanPrincipals counts OWNER principals and all principals. Roles are stored as a JSON array
internal/host/bootstrap.go:148:// by the domain layer; an unparsable row counts as "not an OWNER" rather than being trusted.
internal/host/bootstrap.go:149:func (h *Host) scanPrincipals(ctx context.Context) (owners, total int, ownerID string) {
internal/host/bootstrap.go:150:	rows, err := h.db.QueryContext(ctx, `SELECT id, roles, revoked FROM auth_principals ORDER BY id`)
internal/host/bootstrap.go:151:	if err != nil {
internal/host/bootstrap.go:152:		return -1, -1, ""
internal/host/bootstrap.go:153:	}
internal/host/bootstrap.go:154:	defer rows.Close()
internal/host/bootstrap.go:155:	for rows.Next() {
internal/host/bootstrap.go:156:		var id, roles string
internal/host/bootstrap.go:157:		var revoked int
internal/host/bootstrap.go:158:		if err := rows.Scan(&id, &roles, &revoked); err != nil {
internal/host/bootstrap.go:159:			return -1, -1, ""
internal/host/bootstrap.go:160:		}
internal/host/bootstrap.go:161:		total++
internal/host/bootstrap.go:162:		if revoked != 0 {
internal/host/bootstrap.go:163:			continue
internal/host/bootstrap.go:164:		}
internal/host/bootstrap.go:165:		var list []string
internal/host/bootstrap.go:166:		if err := json.Unmarshal([]byte(roles), &list); err != nil {
internal/host/bootstrap.go:167:			continue
internal/host/bootstrap.go:168:		}
internal/host/bootstrap.go:169:		for _, r := range list {
internal/host/bootstrap.go:170:			if r == "OWNER" {
internal/host/bootstrap.go:171:				owners++
internal/host/bootstrap.go:172:				ownerID = id
internal/host/bootstrap.go:173:			}
internal/host/bootstrap.go:174:		}
internal/host/bootstrap.go:175:	}
internal/host/bootstrap.go:176:	if err := rows.Err(); err != nil {
internal/host/bootstrap.go:177:		return -1, -1, ""
internal/host/bootstrap.go:178:	}
internal/host/bootstrap.go:179:	return owners, total, ownerID
internal/host/bootstrap.go:180:}
internal/host/bootstrap.go:182:// reverify is the identity check every privileged host operation performs first: the OS
internal/host/bootstrap.go:183:// principal asking now must be the same principal this host was started for.
internal/host/bootstrap.go:184:func (h *Host) reverify() (identitySnapshot, error) {
internal/host/bootstrap.go:185:	fresh, err := auth.Current()
internal/host/bootstrap.go:186:	if err != nil {
internal/host/bootstrap.go:187:		return identitySnapshot{}, err
internal/host/bootstrap.go:188:	}
internal/host/bootstrap.go:189:	if !h.identity.SameUser(fresh) {
internal/host/bootstrap.go:190:		return identitySnapshot{}, ErrHostIdentity
internal/host/bootstrap.go:191:	}
internal/host/bootstrap.go:192:	return identitySnapshot{Ref: fresh.Ref}, nil
internal/host/bootstrap.go:193:}
internal/host/bootstrap.go:195:type identitySnapshot struct{ Ref string }
internal/host/host.go:1:// Package host is the trusted local host boundary (W17-01). It owns three things the plain
internal/host/host.go:2:// command protocol must never own: the one-time OWNER bootstrap bound to the OS user, the
internal/host/host.go:3:// short-lived session credential that can be renewed without the user ever copying a token,
internal/host/host.go:4:// and the protected storage for provider credentials and workspace-root bindings.
internal/host/host.go:5://
internal/host/host.go:6:// Business truth stays in the existing domain layer: this package calls domain.ProvisionPrincipal
internal/host/host.go:7:// and domain.IssueCredential instead of writing auth_* tables itself, and its own local state
internal/host/host.go:8:// (credential vault, root registry, single-use selection references) lives in a private
internal/host/host.go:9:// current-user directory as files, never as a second set of business tables.
internal/host/host.go:10:package host
internal/host/host.go:12:import (
internal/host/host.go:13:	"crypto/sha256"
internal/host/host.go:14:	"database/sql"
