internal/host/bootstrap.go:38:// BootstrapOwner implements 22 §OS bootstrap: verify the OS principal, then bind an existing
internal/host/bootstrap.go:39:// OWNER or, only when the database has no principal at all, initialise one exactly once.
internal/host/bootstrap.go:40:// There is no route by which an untrusted caller (renderer, ordinary HTTP request, phone
internal/host/bootstrap.go:41:// pairing) reaches this function, and it never resets permissions or data.
internal/host/bootstrap.go:42:func (h *Host) BootstrapOwner(ctx context.Context) (*BootstrapResult, error) {
internal/host/bootstrap.go:43:	fresh, err := h.reverify()
internal/host/bootstrap.go:44:	if err != nil {
internal/host/bootstrap.go:45:		return nil, err
internal/host/bootstrap.go:46:	}
internal/host/bootstrap.go:47:	owners, total, ownerID := h.scanPrincipals(ctx)
internal/host/bootstrap.go:48:	switch {
internal/host/bootstrap.go:49:	case owners > 1:
internal/host/bootstrap.go:50:		// A database with more than one OWNER is a corrupted or tampered state; refusing is
internal/host/bootstrap.go:51:		// safer than picking one, because either choice could hand another user's project set
internal/host/bootstrap.go:52:		// to the current caller.
internal/host/bootstrap.go:53:		return nil, ErrMultipleOwners
internal/host/bootstrap.go:54:	case owners == 1:
internal/host/bootstrap.go:55:		if bound := h.boundPrincipal(); bound != "" && bound != ownerID {
