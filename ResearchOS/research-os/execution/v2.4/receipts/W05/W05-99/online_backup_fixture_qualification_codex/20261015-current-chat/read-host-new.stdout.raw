internal/host/host.go:196:// writePrivate stores a file with 0600 plus the current-user-only DACL and a durable rename,
internal/host/host.go:197:// so a crash cannot leave a half-written credential or root registry.
internal/host/host.go:198:func writePrivate(dir, name string, payload any) error {
internal/host/host.go:199:	raw, err := json.MarshalIndent(payload, "", "  ")
internal/host/host.go:200:	if err != nil {
internal/host/host.go:201:		return err
internal/host/host.go:202:	}
internal/host/host.go:203:	tmp, err := os.CreateTemp(dir, name+".tmp-")
internal/host/host.go:204:	if err != nil {
internal/host/host.go:205:		return err
internal/host/host.go:206:	}
internal/host/host.go:207:	defer os.Remove(tmp.Name())
internal/host/host.go:208:	if err := tmp.Chmod(0o600); err != nil {
internal/host/host.go:209:		tmp.Close()
internal/host/host.go:210:		return err
internal/host/host.go:211:	}
internal/host/host.go:212:	if _, err := tmp.Write(raw); err != nil {
internal/host/host.go:213:		tmp.Close()
internal/host/host.go:214:		return err
internal/host/host.go:215:	}
internal/host/host.go:216:	if err := tmp.Sync(); err != nil {
internal/host/host.go:217:		tmp.Close()
internal/host/host.go:218:		return err
internal/host/host.go:219:	}
internal/host/host.go:220:	if err := tmp.Close(); err != nil {
internal/host/host.go:221:		return err
internal/host/host.go:222:	}
internal/host/host.go:223:	if err := privateFile(tmp.Name()); err != nil {
internal/host/host.go:224:		return err
internal/host/host.go:225:	}
internal/host/host.go:226:	return os.Rename(tmp.Name(), filepath.Join(dir, name))
internal/host/host.go:227:}
internal/host/host.go:229:func readPrivate(dir, name string, into any) error {
