39-func TestClientQueueDurableReplayAndWriterFence(t *testing.T) {
40-	f, svc, client, sid := queueClientFixture(t)
41-	_, goals, tasks, runs := goalCounts(t, f)
42-	payload := Object{"text": "同样的完整输入", "attachment_artifact_ids": Empty(), "delivery": "STEER"}
43-	env := queueClientEnvelope(t, f, client, sid, "session.send", payload)
44-	reply, replay := goalCommand(t, f, svc, env)
45-	if replay || deref(reply.Status) != "COMPLETED" {
46-		t.Fatalf("enqueue: %s", Bytes(reply))
47-	}
48-	repeated, replayed := goalCommand(t, f, svc, env)
49-	if !replayed || Hash(repeated) != Hash(reply) {
50-		t.Fatal("enqueue identity changed on replay")
51-	}
52-	env2 := queueClientEnvelope(t, f, client, sid, "session.send", payload)
53-	second, _ := goalCommand(t, f, svc, env2)
54-	if second.Result["message_id"] == reply.Result["message_id"] {
55-		t.Fatal("duplicate text lost message identity")
56-	}
57-	pending := Arr(second.Result["snapshot"].(map[string]any), "pending_command_ids")
58-	if len(pending) != 2 {
59-		t.Fatalf("pending ids=%v", pending)
60-	}
61-	stale := *env
62-	stale.CommandID = strptr(ID())
63-	rejected, _ := goalCommand(t, f, svc, &stale)
64-	if deref(rejected.Status) != "REJECTED" {
65-		t.Fatal("stale CAS accepted")
66-	}
67-	fresh := queueClientEnvelope(t, f, client, sid, "session.send", payload)
68-	fresh.WriterEpoch = revPtr(123)
69-	rejected, _ = goalCommand(t, f, svc, fresh)
70-	if deref(rejected.ErrorCode) != "STALE_WRITER_EPOCH" {
71-		t.Fatal("stale writer accepted")
72-	}
73-	_, g, task, run := goalCounts(t, f)
74-	if goals != g || tasks != task || runs != run {
75-		t.Fatal("queue created business execution")
76-	}
77-	var count int
78-	if err := f.db.QueryRow(`SELECT count(*) FROM client_command_queue`).Scan(&count); err != nil || count != 2 {
79-		t.Fatalf("durable count=%d err=%v", count, err)
80-	}
81-}
