391: // ObserveOwnedCoreReadOnly cannot terminate. It is suitable for preflight.
392: func ObserveOwnedCoreReadOnly(pid uint32) (OwnedCoreNativeIdentity, error) {
393: 	h, err := ownedCoreOpen(pid, 0)
394: 	if err != nil {
395: 		return OwnedCoreNativeIdentity{}, err
396: 	}
397: 	defer h.Close()
398: 	return h.identity, nil
399: }
400: 
401: // OpenOwnedCoreRetained binds the sole termination handle to a complete exact
402: // native identity obtained during reviewed preflight. It cannot accept a
403: // partial PID-only expectation.
404: func OpenOwnedCoreRetained(expected OwnedCoreNativeIdentity) (*OwnedCoreRetainedHandle, error) {
405: 	if expected.PID == 0 || expected.CreatedNS == 0 || expected.SID == "" || expected.ImageSHA256 == "" || expected.ImagePath == "" || expected.ImageIndex == 0 || expected.ParentPID == 0 || expected.ParentCreatedNS == 0 || expected.ParentSID == "" || expected.ParentImageSHA256 == "" || expected.ParentImageIndex == 0 {
406: 		return nil, errors.New("complete reviewed native identity required")
407: 	}
408: 	h, err := ownedCoreOpen(expected.PID, windows.PROCESS_TERMINATE)
409: 	if err != nil {
410: 		return nil, err
411: 	}
412: 	if h.identity != expected {
413: 		h.Close()
414: 		return nil, errors.New("retained native identity differs from plan")
415: 	}
416: 	return h, nil
417: }
418: 
419: func (h *OwnedCoreRetainedHandle) Identity() OwnedCoreNativeIdentity {
420: 	if h == nil {
421: 		return OwnedCoreNativeIdentity{}
422: 	}
423: 	return h.identity
424: }
425: 
426: func verifyOwnedImageFile(image *ownedImageFile, volume uint32, index uint64) error {
427: 	if image == nil || image.file == nil || image.final.volume != volume || image.final.index != index {
428: 		return errors.New("retained image identity absent")
429: 	}
430: 	for _, original := range image.ancestors {
431: 		current, _, err := observeOwnedImageAnchor(original.handle, true)
432: 		if err != nil || current.volume != original.volume || current.index != original.index || current.security != original.security {
433: 			return errors.New("retained image ancestor identity/ACL changed")
434: 		}
435: 	}
436: 	current, _, err := observeOwnedImageAnchor(windows.Handle(image.file.Fd()), false)
437: 	if err != nil || current.volume != image.final.volume || current.index != image.final.index || current.security != image.final.security {
438: 		return errors.New("retained image file identity/ACL changed")
439: 	}
440: 	return nil
441: }
442: 
443: func (h *OwnedCoreRetainedHandle) verifyRetained() error {
444: 	if h == nil || h.closed || h.core.handle == 0 {
445: 		return errors.New("native handle closed")
446: 	}
447: 	pid, err := windows.GetProcessId(h.core.handle)
448: 	if err != nil || pid != h.identity.PID {
449: 		return errors.New("retained PID changed")
450: 	}
451: 	var created, exited, kernel, user windows.Filetime
452: 	if err = windows.GetProcessTimes(h.core.handle, &created, &exited, &kernel, &user); err != nil || created.Nanoseconds() != h.identity.CreatedNS {
453: 		return errors.New("retained process creation changed")
454: 	}
455: 	// Every path component remains open without delete sharing. The final image
456: 	// also denies write sharing; identity and security are rechecked by handle.
457: 	if err = verifyOwnedImageFile(h.core.image, h.identity.ImageVolume, h.identity.ImageIndex); err != nil {
458: 		return err
459: 	}
460: 	parentPID, err := windows.GetProcessId(h.parent.handle)
461: 	if err != nil || parentPID != h.identity.ParentPID {
462: 		return errors.New("retained parent PID changed")
463: 	}
464: 	if err = windows.GetProcessTimes(h.parent.handle, &created, &exited, &kernel, &user); err != nil || created.Nanoseconds() != h.identity.ParentCreatedNS {
465: 		return errors.New("retained parent creation changed")
466: 	}
467: 	parentStatus, err := h.nativeParentWait()
468: 	if err != nil || parentStatus != uint32(windows.WAIT_TIMEOUT) {
469: 		return errors.New("retained parent no longer live")
470: 	}
471: 	if err = verifyOwnedImageFile(h.parent.image, h.identity.ParentImageVolume, h.identity.ParentImageIndex); err != nil {
472: 		return err
473: 	}
474: 	return nil
475: }
476: 
477: func (h *OwnedCoreRetainedHandle) nativeParentWait() (uint32, error) {
478: 	return windows.WaitForSingleObject(h.parent.handle, 0)
479: }
480: 
481: // OwnedCoreNativeExit records whether the one call was made and the numeric
482: // exit code from the same retained handle. Unknown wait is never retried.
483: type OwnedCoreNativeExit struct {
484: 	TerminateCalls int    `json:"terminate_calls"`
485: 	ExitObserved   bool   `json:"exit_observed"`
486: 	ExitCode       uint32 `json:"exit_code"`
487: 	BeforeSignal   bool   `json:"before_signal"`
488: }
489: 
490: const OwnedCoreMaintenanceExitCode uint32 = 0x52534f53
491: 
492: func (h *OwnedCoreRetainedHandle) TerminateOnceAndWait(timeout time.Duration) (OwnedCoreNativeExit, error) {
493: 	return h.TerminateOnceAndWaitUntil(timeout, time.Now().Add(time.Hour), time.Now().Add(time.Hour))
494: }
495: 
496: // TerminateOnceAndWaitUntil applies both the invocation monotonic deadline and
497: // the grant's wall expiry at the last native boundary, after pre-signal waits.
498: // A failed deadline check returns with zero TerminateProcess calls; the caller's
499: // already-durable intent remains consumed.
500: func (h *OwnedCoreRetainedHandle) TerminateOnceAndWaitUntil(timeout time.Duration, invocationDeadline, wallExpiry time.Time) (OwnedCoreNativeExit, error) {
501: 	return h.TerminateOnceAndWaitUntilContext(context.Background(), timeout, invocationDeadline, wallExpiry)
502: }
503: 
504: func (h *OwnedCoreRetainedHandle) TerminateOnceAndWaitUntilContext(ctx context.Context, timeout time.Duration, invocationDeadline, wallExpiry time.Time) (OwnedCoreNativeExit, error) {
505: 	var out OwnedCoreNativeExit
506: 	if ctx == nil {
507: 		return out, errors.New("caller context required")
508: 	}
509: 	if timeout <= 0 || timeout > 30*time.Second {
510: 		return out, errors.New("bounded native wait required")
511: 	}
512: 	if earlier, ok := ctx.Deadline(); ok && earlier.Before(invocationDeadline) {
513: 		invocationDeadline = earlier
514: 	}
515: 	if err := ctx.Err(); err != nil {
516: 		return out, fmt.Errorf("caller unavailable before native signal: %w", err)
517: 	}
518: 	if err := h.verifyRetained(); err != nil {
519: 		return out, err
520: 	}
521: 	if h.terminateCalls != 0 {
522: 		return out, errors.New("native termination already attempted")
523: 	}
524: 	status, err := h.nativeWait(0)
525: 	if err != nil {
526: 		return out, err
527: 	}
528: 	if status == windows.WAIT_OBJECT_0 {
529: 		out.BeforeSignal = true
530: 		out.ExitObserved = true
531: 		if err = windows.GetExitCodeProcess(h.core.handle, &out.ExitCode); err != nil {
532: 			return out, err
533: 		}
534: 		return out, nil
535: 	}
536: 	if status != uint32(windows.WAIT_TIMEOUT) {
537: 		return out, fmt.Errorf("unexpected native wait status %d", status)
538: 	}
539: 	if err := ctx.Err(); err != nil {
540: 		return out, fmt.Errorf("caller unavailable before native signal: %w", err)
541: 	}
542: 	if now := time.Now(); !now.Before(invocationDeadline) || !now.Before(wallExpiry) {
543: 		return out, errors.New("invocation or grant expired before native signal")
544: 	}
545: 	if err := ctx.Err(); err != nil {
546: 		return out, fmt.Errorf("caller unavailable before native signal: %w", err)
547: 	}
548: 	h.terminateCalls = 1
549: 	out.TerminateCalls = 1
550: 	if err = h.nativeTerminate(OwnedCoreMaintenanceExitCode); err != nil {
551: 		return out, fmt.Errorf("one TerminateProcess failed: %w", err)
552: 	}
553: 	status, err = h.nativeWait(uint32(timeout.Milliseconds()))
554: 	if err != nil || status != windows.WAIT_OBJECT_0 {
555: 		return out, fmt.Errorf("native wait unknown: status=%d err=%v", status, err)
556: 	}
557: 	out.ExitObserved = true
558: 	if err = windows.GetExitCodeProcess(h.core.handle, &out.ExitCode); err != nil {
559: 		return out, err
560: 	}
561: 	return out, nil
562: }
563: 
564: func (h *OwnedCoreRetainedHandle) Close() {
565: 	if h == nil || h.closed {
566: 		return
567: 	}
568: 	h.closed = true
569: 	h.core.close()
570: 	h.parent.close()
571: }

