22: const qualificationRejectionFile = "qualification-rejection-00000000000000000003.json"
23: 
24: // These handles deny FILE_SHARE_DELETE while each pathname and its descendants
25: // are inspected. Reparse points and a changed DACL fail closed; no caller path
26: // is repaired or made private by the proof reader/writer.
27: type qualificationPathGuard struct {
28: 	handles []windows.Handle
29: 	ids     []qualificationFileID
30: 	current *windows.SID
31: 	private bool
32: }
33: 
34: type qualificationFileID struct {
35: 	volume, high, low uint32
36: }
37: 
38: func qualificationIdentity(h windows.Handle, directory bool) (qualificationFileID, error) {
39: 	var info windows.ByHandleFileInformation
40: 	if err := windows.GetFileInformationByHandle(h, &info); err != nil {
41: 		return qualificationFileID{}, err
42: 	}
43: 	if info.FileAttributes&windows.FILE_ATTRIBUTE_REPARSE_POINT != 0 || (info.FileAttributes&windows.FILE_ATTRIBUTE_DIRECTORY != 0) != directory {
44: 		return qualificationFileID{}, errors.New("qualification source reparse or type mismatch")
45: 	}
46: 	return qualificationFileID{info.VolumeSerialNumber, info.FileIndexHigh, info.FileIndexLow}, nil
47: }
48: 
49: type qualificationACLHeader struct {
50: 	revision, reserved     byte
51: 	size, count, reserved2 uint16
52: }
53: 
54: func qualificationPrivateACL(h windows.Handle, current *windows.SID, protected bool) error {
55: 	sd, err := windows.GetSecurityInfo(h, windows.SE_FILE_OBJECT, windows.OWNER_SECURITY_INFORMATION|windows.DACL_SECURITY_INFORMATION)
56: 	if err != nil || sd == nil {
57: 		return errors.New("qualification source security descriptor unavailable")
58: 	}
59: 	owner, _, err := sd.Owner()
60: 	if err != nil || owner == nil || !owner.Equals(current) {
61: 		return errors.New("qualification source owner differs")
62: 	}
63: 	control, _, err := sd.Control()
64: 	if err != nil || protected && control&windows.SE_DACL_PROTECTED == 0 {
65: 		return errors.New("qualification source DACL is not protected")
66: 	}
67: 	acl, _, err := sd.DACL()
68: 	if err != nil || acl == nil {
69: 		return errors.New("qualification source DACL unavailable")
70: 	}
71: 	header := (*qualificationACLHeader)(unsafe.Pointer(acl))
72: 	if header.size < uint16(unsafe.Sizeof(qualificationACLHeader{})) || header.count == 0 || header.count > 32 {
73: 		return errors.New("qualification source DACL shape invalid")
74: 	}
75: 	effectiveCurrent := false
76: 	for i := uint16(0); i < header.count; i++ {
77: 		var ace *windows.ACCESS_ALLOWED_ACE
78: 		if err := windows.GetAce(acl, uint32(i), &ace); err != nil || ace == nil || ace.Header.AceType != windows.ACCESS_ALLOWED_ACE_TYPE || ace.Header.AceSize < uint16(unsafe.Sizeof(windows.ACCESS_ALLOWED_ACE{})) {
79: 			return errors.New("qualification source contains unsupported ACE")
80: 		}
81: 		sid := (*windows.SID)(unsafe.Pointer(&ace.SidStart))
82: 		if !sid.IsValid() || !sid.Equals(current) {
83: 			return errors.New("qualification source grants access to another principal")
84: 		}
85: 		// INHERIT_ONLY does not grant access on this object. The same SID may
86: 		// inherit a second effective ACE on a child, but it cannot replace one.
87: 		if ace.Header.AceFlags&windows.INHERIT_ONLY_ACE == 0 {
88: 			const fileAllAccess = 0x001f01ff
89: 			if uint32(ace.Mask)&fileAllAccess == fileAllAccess || uint32(ace.Mask)&windows.GENERIC_ALL != 0 {
90: 				effectiveCurrent = true
91: 			}
92: 		}
93: 	}
94: 	if !effectiveCurrent {
95: 		return errors.New("qualification source lacks current owner access")
96: 	}
97: 	return nil
98: }
99: 
100: func qualificationGuardDirectory(directory string, protected bool) (*qualificationPathGuard, error) {
101: 	if !filepath.IsAbs(directory) {
102: 		return nil, errors.New("absolute qualification dispatch directory required")
103: 	}
104: 	currentUser, err := user.Current()
105: 	if err != nil {
106: 		return nil, err
107: 	}
108: 	current, err := windows.StringToSid(currentUser.Uid)
109: 	if err != nil || current == nil {
110: 		return nil, errors.New("current qualification SID unavailable")
111: 	}
112: 	g := &qualificationPathGuard{current: current, private: protected}
113: 	paths := []string{}
114: 	for path := filepath.Clean(directory); ; path = filepath.Dir(path) {
115: 		paths = append(paths, path)
116: 		if next := filepath.Dir(path); next == path {
117: 			break
118: 		}
119: 	}
120: 	for i := len(paths) - 1; i >= 0; i-- {
121: 		name, err := windows.UTF16PtrFromString(paths[i])
122: 		if err != nil {
123: 			g.Close()
124: 			return nil, err
125: 		}
126: 		// Metadata-only access does not participate in CreateFile sharing checks.
127: 		// Listing access makes a retained directory handle reject DELETE opens,
128: 		// including rename, while its children are opened by pathname.
129: 		h, err := windows.CreateFile(name, windows.FILE_LIST_DIRECTORY|windows.FILE_READ_ATTRIBUTES|windows.READ_CONTROL, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, nil, windows.OPEN_EXISTING, windows.FILE_FLAG_BACKUP_SEMANTICS|windows.FILE_FLAG_OPEN_REPARSE_POINT, 0)
130: 		if err != nil {
131: 			g.Close()
132: 			return nil, err
133: 		}
134: 		id, err := qualificationIdentity(h, true)
135: 		if err != nil {
136: 			windows.CloseHandle(h)
137: 			g.Close()
138: 			return nil, err
139: 		}
140: 		g.handles = append(g.handles, h)
141: 		g.ids = append(g.ids, id)
142: 	}
143: 	if err := qualificationPrivateACL(g.handles[len(g.handles)-1], current, protected); err != nil {
144: 		g.Close()
145: 		return nil, err
146: 	}
147: 	return g, nil
148: }
149: 
150: func (g *qualificationPathGuard) Check() error {
151: 	for i, h := range g.handles {
152: 		id, err := qualificationIdentity(h, true)
153: 		if err != nil || id != g.ids[i] {
154: 			return errors.New("qualification directory identity changed")
155: 		}
156: 	}
157: 	return qualificationPrivateACL(g.handles[len(g.handles)-1], g.current, g.private)
158: }
159: 
160: func (g *qualificationPathGuard) Close() {
161: 	for i := len(g.handles) - 1; i >= 0; i-- {
162: 		windows.CloseHandle(g.handles[i])
163: 	}
164: }
165: 
