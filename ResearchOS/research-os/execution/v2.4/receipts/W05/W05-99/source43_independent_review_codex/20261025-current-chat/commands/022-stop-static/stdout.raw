127: func TestOwnedCoreStopInvalidPreflightNeverCreatesOutput(t *testing.T) {
128: 	base := t.TempDir()
129: 	out := filepath.Join(base, "new-output")
130: 	in := Input{Schema: InputSchema, OperationID: strings.Repeat("b", 32), SourceRepository: base, DataRoot: filepath.Join(base, "data"), CorePID: 1,
131: 		Subject: store.OwnedStopSubject{Run: OldRun, Epoch: 1, DispatchKey: OldDispatch, RequestKey: "wrong", Project: "fixture"}}
132: 	raw, err := json.Marshal(in)
133: 	if err != nil {
134: 		t.Fatal(err)
135: 	}
136: 	inputPath := filepath.Join(base, "input.json")
137: 	if err := os.WriteFile(inputPath, raw, 0600); err != nil {
138: 		t.Fatal(err)
139: 	}
140: 	if _, _, err := Preflight(context.Background(), inputPath, in.OperationID, out); err == nil {
141: 		t.Fatal("wrong historical subject passed preflight")
142: 	}
143: 	if _, err := os.Stat(out); !os.IsNotExist(err) {
144: 		t.Fatalf("invalid preflight created output: %v", err)
145: 	}
146: }
147: 
148: func TestCommitSignalBoundaryHonorsCallerCancellationAndEarlierDeadline(t *testing.T) {
149: 	now := time.Now()
150: 	g := operationGrant{AllowedActions: []string{"commit"}, notBefore: now.Add(-time.Minute), expires: now.Add(time.Minute)}
151: 	ctx, cancel := context.WithCancel(context.Background())
152: 	cancel()
153: 	if err := checkCommitSignalBoundary(ctx, g); err != context.Canceled {
154: 		t.Fatalf("canceled caller reached intent: %v", err)
155: 	}
156: 	ctx, cancel = context.WithDeadline(context.Background(), now.Add(-time.Second))
157: 	defer cancel()
158: 	if err := checkCommitSignalBoundary(ctx, g); err != context.DeadlineExceeded {
159: 		t.Fatalf("earlier caller deadline reached intent: %v", err)
160: 	}
161: 	if err := checkCommitSignalBoundary(context.Background(), g); err != nil {
162: 		t.Fatalf("valid caller/grant denied: %v", err)
163: 	}
164: }

