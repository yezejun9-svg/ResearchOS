59: +
60: +func source43FixtureRoot(t *testing.T) string {
61: +	t.Helper()
62: +	base := os.Getenv("RESEARCHOS_SOURCE43_ASCII_FIXTURE_ROOT")
63: +	if base == "" {
64: +		base = os.TempDir()
65: +	}
66: +	base, err := filepath.Abs(base)
67: +	if err != nil {
68: +		t.Fatal(err)
69: +	}
70: +	if err := os.MkdirAll(base, 0o700); err != nil {
71: +		t.Fatal(err)
72: +	}
73: +	root, err := os.MkdirTemp(base, "roots-windows-")
74: +	if err != nil {
75: +		t.Fatal(err)
76: +	}
77: +	t.Cleanup(func() {
78: +		resolvedBase, baseErr := filepath.EvalSymlinks(base)
79: +		resolvedRoot, rootErr := filepath.EvalSymlinks(root)
80: +		if baseErr != nil || rootErr != nil {
81: +			t.Errorf("resolve fixture cleanup path: base=%v root=%v", baseErr, rootErr)
82: +			return
83: +		}
84: +		rel, relErr := filepath.Rel(resolvedBase, resolvedRoot)
85: +		if relErr != nil || rel == "." || rel == ".." || strings.HasPrefix(rel, ".."+string(filepath.Separator)) {
86: +			t.Errorf("fixture cleanup escaped explicit root: %q, %v", rel, relErr)
87: +			return
88: +		}
89: +		if err := os.RemoveAll(root); err != nil {
90: +			t.Errorf("remove fixture: %v", err)
91: +		}
92: +	})
93: +	return root
94: +}
95: +
96: +func TestBoundedFinalPathUTF16(t *testing.T) {
97: +	want := `\\?\C:\作品集\工作区😀`
98: +	units := utf16.Encode([]rune(want))
99: +	buf := make([]uint16, len(units)+2)
100: +	copy(buf, units)
101: +	buf[len(units)] = 'X'
102: +	got, err := boundedFinalPathUTF16(buf, uint32(len(units)))
103: +	if err != nil || got != want {
104: +		t.Fatalf("bounded conversion = %q, %v; want %q", got, err, want)
105: +	}
106: +	for _, n := range []uint32{0, uint32(len(buf)), uint32(len(buf) + 1)} {
107: +		if got, err := boundedFinalPathUTF16(buf, n); err == nil || got != "" {
108: +			t.Fatalf("invalid length %d accepted: %q, %v", n, got, err)
109: +		}
110: +	}
111: +}
112: +
113: +func TestFileIdentityUnicodeFinalPath(t *testing.T) {
114: +	root := source43FixtureRoot(t)
115: +	if os.Getenv("RESEARCHOS_SOURCE43_ASCII_FIXTURE_ROOT") != "" {
116: +		for _, r := range root {
117: +			if r > 127 {
118: +				t.Fatalf("ASCII control fixture root is not ASCII: %q", root)
119: +			}
120: +		}
121: +	}
122: +	paths := map[string]string{
123: +		"ascii-control":             filepath.Join(root, "ascii-control"),
124: +		"CJK-ancestor-and-basename": filepath.Join(root, "父目录", "工作区"),
125: +		"non-BMP":                   filepath.Join(root, "emoji-😀"),
126: +		"common-prefix-one":         filepath.Join(root, "共同前缀", "collision-000001"),
127: +		"common-prefix-two":         filepath.Join(root, "共同前缀", "collision-000002"),
128: +	}
129: +	type identity struct {
130: +		volume string
131: +		id     uint64
132: +		final  string
133: +	}
134: +	seen := map[string]identity{}
135: +	for label, path := range paths {
136: +		if err := os.MkdirAll(path, 0o700); err != nil {
137: +			t.Fatal(err)
138: +		}
139: +		volume, id, final, err := fileIdentity(path)
140: +		if err != nil {
141: +			t.Fatalf("%s: %v", label, err)
142: +		}
143: +		if !utf8.ValidString(final) || final != filepath.Clean(path) || volume == "" || id == 0 {
144: +			t.Fatalf("%s: final=%q want=%q utf8=%v volume=%q id=%d", label, final, filepath.Clean(path), utf8.ValidString(final), volume, id)
145: +		}
146: +		seen[label] = identity{volume, id, final}
147: +	}
148: +	one, two := seen["common-prefix-one"], seen["common-prefix-two"]
149: +	if one.final == two.final || (one.volume == two.volume && one.id == two.id) {
150: +		t.Fatalf("distinct suffixes collapsed: one=%+v two=%+v", one, two)
151: +	}
152: +}
153: +
154: +func TestRootRegistryUnicodeFinalPathRoundTrip(t *testing.T) {
155: +	root := source43FixtureRoot(t)
156: +	path := filepath.Join(root, "父目录", "工作区😀")
157: +	if err := os.MkdirAll(path, 0o700); err != nil {
158: +		t.Fatal(err)
159: +	}
160: +	_, _, expectedFinal, err := fileIdentity(path)
161: +	if err != nil {
162: +		t.Fatal(err)
163: +	}
164: +	registryDir := filepath.Join(root, "registry")
165: +	registry, err := openRootRegistry(registryDir)
166: +	if err != nil {
167: +		t.Fatal(err)
168: +	}
169: +	const ref = "source43-unicode-root"
170: +	binding, err := registry.Register(ref, path, AccessReadOnly, time.Date(2026, 10, 15, 0, 0, 0, 0, time.UTC))
171: +	if err != nil {
172: +		t.Fatal(err)
173: +	}
174: +	if binding.FinalPath != expectedFinal || binding.RealPath != filepath.Clean(path) || binding.VolumeID == "" || binding.FileID == 0 {
175: +		t.Fatalf("registered root lost native path or identity: %+v", binding)
176: +	}
177: +	reopened, err := openRootRegistry(registryDir)
178: +	if err != nil {
179: +		t.Fatal(err)
180: +	}
181: +	got := reopened.roots[ref]
182: +	if got == nil || got.FinalPath != expectedFinal || got.RealPath != filepath.Clean(path) || got.VolumeID != binding.VolumeID || got.FileID != binding.FileID || !utf8.ValidString(got.FinalPath) {
183: +		t.Fatalf("reopened root lost full Unicode paths or identity: %+v", got)
184: +	}
185: +}

