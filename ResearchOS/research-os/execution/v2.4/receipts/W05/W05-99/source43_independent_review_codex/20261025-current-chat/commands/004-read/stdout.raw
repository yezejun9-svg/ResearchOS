41: new file mode 100644
42: index 00000000..9b6cd089
43: --- /dev/null
44: +++ b/internal/host/roots_windows_test.go
45: @@ -0,0 +1,140 @@
46: +//go:build windows
47: +
48: +package host
49: +
50: +import (
51: +	"os"
52: +	"path/filepath"
53: +	"strings"
54: +	"testing"
55: +	"time"
56: +	"unicode/utf16"
57: +	"unicode/utf8"
