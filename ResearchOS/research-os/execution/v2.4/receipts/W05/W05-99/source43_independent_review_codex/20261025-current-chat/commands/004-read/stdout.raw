1: diff --git a/internal/host/roots_windows.go b/internal/host/roots_windows.go
2: index 9057ffb9..ff6bc671 100644
3: --- a/internal/host/roots_windows.go
4: +++ b/internal/host/roots_windows.go
5: @@ -33,17 +33,29 @@ func fileIdentity(path string) (volume string, fileID uint64, final string, err
6:  	id := uint64(info.FileIndexHigh)<<32 | uint64(info.FileIndexLow)
7:  	buf := make([]uint16, 4096)
8:  	n, err := windows.GetFinalPathNameByHandle(h, &buf[0], uint32(len(buf)), 0)
9: -	if err != nil || n == 0 {
10: -		return vol, id, "", fmt.Errorf("final path unavailable for %s: %v", path, err)
11: +	if err != nil {
12: +		return vol, id, "", fmt.Errorf("final path unavailable for %s: %w", path, err)
13:  	}
14: -	final = windows.UTF16PtrToString(&buf[0])
15: -	if l := int(n); len(final) > l {
16: -		final = final[:l]
17: +	final, err = boundedFinalPathUTF16(buf, n)
18: +	if err != nil {
19: +		return vol, id, "", fmt.Errorf("final path unavailable for %s: %w", path, err)
20:  	}
21:  	final = strings.TrimPrefix(final, `\\?\`)
22:  	return vol, id, final, nil
23:  }
24:  
25: +// GetFinalPathNameByHandleW reports UTF-16 code units, not UTF-8 bytes. On
26: +// insufficient capacity its return is the required capacity, including NUL.
27: +func boundedFinalPathUTF16(buf []uint16, n uint32) (string, error) {
28: +	if n == 0 {
29: +		return "", fmt.Errorf("empty final path")
30: +	}
31: +	if n >= uint32(len(buf)) {
32: +		return "", fmt.Errorf("final path needs %d UTF-16 units; capacity is %d", n, len(buf))
33: +	}
34: +	return windows.UTF16ToString(buf[:n]), nil
35: +}
36: +
37:  // chainHasReparsePoint walks every prefix of the path, so a junction anywhere above the target
38:  // is caught even when the final component is an ordinary file.
39:  func chainHasReparsePoint(path string) (bool, error) {
