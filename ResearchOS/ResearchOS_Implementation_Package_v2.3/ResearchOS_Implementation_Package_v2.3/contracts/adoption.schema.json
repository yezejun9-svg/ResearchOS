{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchos.local/contracts/v2.3/adoption.schema.json",
  "title": "Evidence-bound source reuse Artifact payloads",
  "$defs": {
    "ArtifactRef": {
      "allOf": [
        {
          "$ref": "domain.schema.json#/$defs/VersionRef"
        },
        {
          "properties": {
            "entity_type": {
              "const": "Artifact"
            },
            "content_hash": {
              "$ref": "domain.schema.json#/$defs/Digest"
            }
          }
        }
      ]
    },
    "SourceCandidatePayload": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "2.3.0"
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "capability_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "source_kind": {
          "enum": [
            "LOCAL",
            "UPSTREAM"
          ]
        },
        "source_locator": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot_ref": {
          "anyOf": [
            {
              "allOf": [
                {
                  "$ref": "domain.schema.json#/$defs/VersionRef"
                },
                {
                  "properties": {
                    "entity_type": {
                      "const": "Artifact"
                    },
                    "content_hash": {
                      "$ref": "domain.schema.json#/$defs/Digest"
                    }
                  }
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "local_inventory_ref": {
          "allOf": [
            {
              "$ref": "domain.schema.json#/$defs/VersionRef"
            },
            {
              "properties": {
                "entity_type": {
                  "const": "Artifact"
                },
                "content_hash": {
                  "$ref": "domain.schema.json#/$defs/Digest"
                }
              }
            }
          ]
        },
        "reusable_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "fit_summary": {
          "type": "string",
          "minLength": 1
        },
        "license_evidence_refs": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "domain.schema.json#/$defs/VersionRef"
              },
              {
                "properties": {
                  "entity_type": {
                    "const": "Artifact"
                  },
                  "content_hash": {
                    "$ref": "domain.schema.json#/$defs/Digest"
                  }
                }
              }
            ]
          },
          "minItems": 0
        },
        "compatibility_evidence_refs": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "domain.schema.json#/$defs/VersionRef"
              },
              {
                "properties": {
                  "entity_type": {
                    "const": "Artifact"
                  },
                  "content_hash": {
                    "$ref": "domain.schema.json#/$defs/Digest"
                  }
                }
              }
            ]
          },
          "minItems": 0
        },
        "trial_experiment_ref": {
          "anyOf": [
            {
              "$ref": "domain.schema.json#/$defs/VersionRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "patch_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "known_gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "maintenance_and_cost": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "domain.schema.json#/$defs/VersionRef"
              },
              {
                "properties": {
                  "entity_type": {
                    "const": "Artifact"
                  },
                  "content_hash": {
                    "$ref": "domain.schema.json#/$defs/Digest"
                  }
                }
              }
            ]
          },
          "minItems": 0
        },
        "observed_at": {
          "$ref": "domain.schema.json#/$defs/UtcTime"
        }
      },
      "required": [
        "schema_version",
        "project_id",
        "capability_id",
        "candidate_id",
        "source_kind",
        "source_locator",
        "source_revision",
        "snapshot_ref",
        "local_inventory_ref",
        "reusable_paths",
        "fit_summary",
        "license_evidence_refs",
        "compatibility_evidence_refs",
        "trial_experiment_ref",
        "patch_scope",
        "known_gaps",
        "maintenance_and_cost",
        "evidence_refs",
        "observed_at"
      ],
      "additionalProperties": false
    },
    "JevAdoptionSignal": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "NOT_RUN",
            "DECIDED",
            "ABSTAIN",
            "ERROR"
          ]
        },
        "mode": {
          "$ref": "domain.schema.json#/$defs/DecisionMode"
        },
        "scope": {
          "allOf": [
            {
              "$ref": "domain.schema.json#/$defs/QualificationScope"
            },
            {
              "properties": {
                "task_type": {
                  "const": "reuse_selection"
                }
              }
            }
          ]
        },
        "measurement_mode": {
          "$ref": "domain.schema.json#/$defs/MeasurementMode"
        },
        "jev_called": {
          "type": "boolean"
        },
        "decision_receipt_ref": {
          "anyOf": [
            {
              "$ref": "domain.schema.json#/$defs/VersionRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "qualification_ref": {
          "anyOf": [
            {
              "$ref": "domain.schema.json#/$defs/VersionRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "raw_output_ref": {
          "anyOf": [
            {
              "allOf": [
                {
                  "$ref": "domain.schema.json#/$defs/VersionRef"
                },
                {
                  "properties": {
                    "entity_type": {
                      "const": "Artifact"
                    },
                    "content_hash": {
                      "$ref": "domain.schema.json#/$defs/Digest"
                    }
                  }
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "missing_reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "cost": {
          "anyOf": [
            {
              "$ref": "domain.schema.json#/$defs/Money"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "mode",
        "scope",
        "measurement_mode",
        "jev_called",
        "decision_receipt_ref",
        "qualification_ref",
        "raw_output_ref",
        "missing_reason",
        "cost"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "NOT_RUN"
              }
            }
          },
          "then": {
            "properties": {
              "jev_called": {
                "const": false
              },
              "decision_receipt_ref": {
                "type": "null"
              },
              "raw_output_ref": {
                "type": "null"
              },
              "missing_reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "DECIDED"
              }
            }
          },
          "then": {
            "properties": {
              "raw_output_ref": {
                "allOf": [
                  {
                    "$ref": "domain.schema.json#/$defs/VersionRef"
                  },
                  {
                    "properties": {
                      "entity_type": {
                        "const": "Artifact"
                      },
                      "content_hash": {
                        "$ref": "domain.schema.json#/$defs/Digest"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "BOUNDED_AUTO"
              }
            }
          },
          "then": {
            "properties": {
              "status": {
                "const": "DECIDED"
              },
              "jev_called": {
                "const": true
              },
              "measurement_mode": {
                "const": "LIVE"
              },
              "qualification_ref": {
                "$ref": "domain.schema.json#/$defs/VersionRef"
              },
              "decision_receipt_ref": {
                "$ref": "domain.schema.json#/$defs/VersionRef"
              }
            }
          }
        }
      ]
    },
    "AdoptionDecisionPayload": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "2.3.0"
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "capability_id": {
          "type": "string",
          "minLength": 1
        },
        "input_revision": {
          "type": "integer",
          "minimum": 1
        },
        "input_hash": {
          "$ref": "domain.schema.json#/$defs/Digest"
        },
        "execution_phase": {
          "enum": [
            "BOOTSTRAP",
            "PRODUCT"
          ]
        },
        "local_inventory_ref": {
          "allOf": [
            {
              "$ref": "domain.schema.json#/$defs/VersionRef"
            },
            {
              "properties": {
                "entity_type": {
                  "const": "Artifact"
                },
                "content_hash": {
                  "$ref": "domain.schema.json#/$defs/Digest"
                }
              }
            }
          ]
        },
        "candidate_refs": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "domain.schema.json#/$defs/VersionRef"
              },
              {
                "properties": {
                  "entity_type": {
                    "const": "Artifact"
                  },
                  "content_hash": {
                    "$ref": "domain.schema.json#/$defs/Digest"
                  }
                }
              }
            ]
          },
          "minItems": 0
        },
        "baseline_ref": {
          "allOf": [
            {
              "$ref": "domain.schema.json#/$defs/VersionRef"
            },
            {
              "properties": {
                "entity_type": {
                  "const": "Artifact"
                },
                "content_hash": {
                  "$ref": "domain.schema.json#/$defs/Digest"
                }
              }
            }
          ]
        },
        "rubric_ref": {
          "allOf": [
            {
              "$ref": "domain.schema.json#/$defs/VersionRef"
            },
            {
              "properties": {
                "entity_type": {
                  "const": "Artifact"
                },
                "content_hash": {
                  "$ref": "domain.schema.json#/$defs/Digest"
                }
              }
            }
          ]
        },
        "disposition": {
          "enum": [
            "ADOPT",
            "REJECT",
            "WATCH",
            "INCONCLUSIVE"
          ]
        },
        "reuse_strategy": {
          "anyOf": [
            {
              "enum": [
                "REUSE_LOCAL",
                "ADOPT_UPSTREAM",
                "ADAPT_UPSTREAM",
                "CUSTOM_GAP"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "reuse_extent": {
          "enum": [
            "WHOLE_REPOSITORY",
            "MODULE",
            "DEPENDENCY",
            "LOCAL",
            "GAP_ONLY",
            "NONE"
          ]
        },
        "selected_candidate_ref": {
          "anyOf": [
            {
              "allOf": [
                {
                  "$ref": "domain.schema.json#/$defs/VersionRef"
                },
                {
                  "properties": {
                    "entity_type": {
                      "const": "Artifact"
                    },
                    "content_hash": {
                      "$ref": "domain.schema.json#/$defs/Digest"
                    }
                  }
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "selected_source_revision": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "decision_basis": {
          "enum": [
            "BOOTSTRAP_VERIFIER",
            "INDEPENDENT_VERIFIER",
            "ADVISORY_WITH_VERIFIER",
            "QUALIFIED_JEV_WITH_HARD_GATES"
          ]
        },
        "jev": {
          "$ref": "#/$defs/JevAdoptionSignal"
        },
        "hard_checks": {
          "type": "array",
          "items": {
            "$ref": "domain.schema.json#/$defs/CheckResult"
          },
          "minItems": 0
        },
        "independent_review_ref": {
          "anyOf": [
            {
              "allOf": [
                {
                  "$ref": "domain.schema.json#/$defs/VersionRef"
                },
                {
                  "properties": {
                    "entity_type": {
                      "const": "Artifact"
                    },
                    "content_hash": {
                      "$ref": "domain.schema.json#/$defs/Digest"
                    }
                  }
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "experiment_refs": {
          "type": "array",
          "items": {
            "$ref": "domain.schema.json#/$defs/VersionRef"
          },
          "minItems": 0
        },
        "implementation_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "rollback_ref": {
          "anyOf": [
            {
              "allOf": [
                {
                  "$ref": "domain.schema.json#/$defs/VersionRef"
                },
                {
                  "properties": {
                    "entity_type": {
                      "const": "Artifact"
                    },
                    "content_hash": {
                      "$ref": "domain.schema.json#/$defs/Digest"
                    }
                  }
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "missing_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "revisit_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "rejected_alternatives": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "remaining_gap": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "project_id",
        "capability_id",
        "input_revision",
        "input_hash",
        "execution_phase",
        "local_inventory_ref",
        "candidate_refs",
        "baseline_ref",
        "rubric_ref",
        "disposition",
        "reuse_strategy",
        "reuse_extent",
        "selected_candidate_ref",
        "selected_source_revision",
        "decision_basis",
        "jev",
        "hard_checks",
        "independent_review_ref",
        "experiment_refs",
        "implementation_scope",
        "rollback_ref",
        "rationale",
        "missing_evidence",
        "revisit_conditions",
        "rejected_alternatives",
        "remaining_gap"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "ADOPT"
              }
            }
          },
          "then": {
            "properties": {
              "reuse_strategy": {
                "enum": [
                  "REUSE_LOCAL",
                  "ADOPT_UPSTREAM",
                  "ADAPT_UPSTREAM",
                  "CUSTOM_GAP"
                ]
              },
              "reuse_extent": {
                "not": {
                  "const": "NONE"
                }
              },
              "selected_candidate_ref": {
                "allOf": [
                  {
                    "$ref": "domain.schema.json#/$defs/VersionRef"
                  },
                  {
                    "properties": {
                      "entity_type": {
                        "const": "Artifact"
                      },
                      "content_hash": {
                        "$ref": "domain.schema.json#/$defs/Digest"
                      }
                    }
                  }
                ]
              },
              "selected_source_revision": {
                "type": "string",
                "minLength": 1
              },
              "independent_review_ref": {
                "allOf": [
                  {
                    "$ref": "domain.schema.json#/$defs/VersionRef"
                  },
                  {
                    "properties": {
                      "entity_type": {
                        "const": "Artifact"
                      },
                      "content_hash": {
                        "$ref": "domain.schema.json#/$defs/Digest"
                      }
                    }
                  }
                ]
              },
              "rollback_ref": {
                "allOf": [
                  {
                    "$ref": "domain.schema.json#/$defs/VersionRef"
                  },
                  {
                    "properties": {
                      "entity_type": {
                        "const": "Artifact"
                      },
                      "content_hash": {
                        "$ref": "domain.schema.json#/$defs/Digest"
                      }
                    }
                  }
                ]
              },
              "hard_checks": {
                "type": "array",
                "items": {
                  "$ref": "domain.schema.json#/$defs/CheckResult"
                },
                "minItems": 7
              }
            }
          },
          "else": {
            "properties": {
              "reuse_strategy": {
                "type": "null"
              },
              "reuse_extent": {
                "const": "NONE"
              },
              "implementation_scope": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reuse_strategy": {
                "const": "CUSTOM_GAP"
              }
            }
          },
          "then": {
            "properties": {
              "remaining_gap": {
                "type": "string",
                "minLength": 1
              },
              "rejected_alternatives": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "implementation_scope": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "decision_basis": {
                "const": "QUALIFIED_JEV_WITH_HARD_GATES"
              }
            }
          },
          "then": {
            "properties": {
              "jev": {
                "properties": {
                  "mode": {
                    "const": "BOUNDED_AUTO"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "execution_phase": {
                "const": "PRODUCT"
              },
              "disposition": {
                "const": "ADOPT"
              }
            }
          },
          "then": {
            "properties": {
              "experiment_refs": {
                "type": "array",
                "items": {
                  "$ref": "domain.schema.json#/$defs/VersionRef"
                },
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
