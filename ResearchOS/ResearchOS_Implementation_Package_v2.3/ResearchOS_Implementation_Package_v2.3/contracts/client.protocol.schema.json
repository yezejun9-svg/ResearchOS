{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchos.invalid/spec/v2.3/client.protocol.schema.json",
  "title": "ResearchOS local client protocol; implementation NOT_STARTED",
  "$defs": {
    "CommandEnvelope": {
      "type": "object",
      "properties": {
        "protocol_version": {
          "const": "researchos-client/1"
        },
        "command_id": {
          "type": "string",
          "minLength": 1
        },
        "client_id": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "session_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_revision": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "writer_epoch": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "method": {
          "enum": [
            "host.status",
            "host.configure",
            "project.bootstrap",
            "session.list",
            "session.create",
            "session.get",
            "session.attach",
            "session.send",
            "session.control",
            "session.events",
            "session.handoff",
            "goal.start"
          ]
        },
        "payload": {
          "type": "object"
        }
      },
      "required": [
        "protocol_version",
        "command_id",
        "client_id",
        "project_id",
        "session_id",
        "expected_revision",
        "writer_epoch",
        "method",
        "payload"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "method": {
                "const": "host.status"
              }
            },
            "required": [
              "method"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/EmptyPayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "host.configure"
              }
            },
            "required": [
              "method"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/ConfigurePayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "project.bootstrap"
              }
            },
            "required": [
              "method"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/BootstrapPayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "session.list"
              }
            },
            "required": [
              "method"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/ListSessionsPayload"
              },
              "project_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "session.create"
              }
            },
            "required": [
              "method"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/CreateSessionPayload"
              },
              "project_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "session.get"
              }
            },
            "required": [
              "method"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/EmptyPayload"
              },
              "project_id": {
                "type": "string",
                "minLength": 1
              },
              "session_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "session.attach"
              }
            },
            "required": [
              "method"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/AttachPayload"
              },
              "project_id": {
                "type": "string",
                "minLength": 1
              },
              "session_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "session.send"
              }
            },
            "required": [
              "method"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/SendMessagePayload"
              },
              "project_id": {
                "type": "string",
                "minLength": 1
              },
              "session_id": {
                "type": "string",
                "minLength": 1
              },
              "expected_revision": {
                "type": "integer",
                "minimum": 1
              },
              "writer_epoch": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "session.control"
              }
            },
            "required": [
              "method"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/ControlPayload"
              },
              "project_id": {
                "type": "string",
                "minLength": 1
              },
              "session_id": {
                "type": "string",
                "minLength": 1
              },
              "expected_revision": {
                "type": "integer",
                "minimum": 1
              },
              "writer_epoch": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "session.events"
              }
            },
            "required": [
              "method"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/ReadEventsPayload"
              },
              "project_id": {
                "type": "string",
                "minLength": 1
              },
              "session_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "session.handoff"
              }
            },
            "required": [
              "method"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/HandoffPayload"
              },
              "project_id": {
                "type": "string",
                "minLength": 1
              },
              "session_id": {
                "type": "string",
                "minLength": 1
              },
              "expected_revision": {
                "type": "integer",
                "minimum": 1
              },
              "writer_epoch": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "goal.start"
              }
            },
            "required": [
              "method"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/StartGoalPayload"
              },
              "project_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "CommandResponse": {
      "type": "object",
      "properties": {
        "command_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "ACKNOWLEDGED",
            "REJECTED",
            "COMPLETED"
          ]
        },
        "session_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "result": {
          "type": "object"
        }
      },
      "required": [
        "command_id",
        "status",
        "session_id",
        "revision",
        "error_code",
        "result"
      ],
      "additionalProperties": false
    },
    "SessionEvent": {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "core_build_id": {
          "type": "string",
          "minLength": 1
        },
        "protocol_version": {
          "const": "researchos-client/1"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "command_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "enum": [
            "MESSAGE",
            "TOOL_STARTED",
            "TOOL_RESULT",
            "JUDGE_DECISION",
            "RUN_STATE",
            "GOAL_STATE",
            "ARTIFACT",
            "USAGE",
            "CHECKPOINT",
            "CLIENT_HANDOFF",
            "BOOTSTRAP_STATE"
          ]
        },
        "payload": {
          "type": "object"
        }
      },
      "required": [
        "event_id",
        "session_id",
        "sequence",
        "core_build_id",
        "protocol_version",
        "run_id",
        "command_id",
        "kind",
        "payload"
      ],
      "additionalProperties": false
    },
    "SendMessagePayload": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "attachment_artifact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "delivery": {
          "enum": [
            "NORMAL",
            "STEER",
            "FOLLOW_UP"
          ]
        }
      },
      "required": [
        "text",
        "attachment_artifact_ids",
        "delivery"
      ],
      "additionalProperties": false
    },
    "ControlPayload": {
      "type": "object",
      "properties": {
        "action": {
          "enum": [
            "PAUSE",
            "RESUME",
            "CANCEL"
          ]
        },
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "action",
        "target_id",
        "reason"
      ],
      "additionalProperties": false
    },
    "ReuseDecisionPayload": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "capability_id": {
          "type": "string",
          "minLength": 1
        },
        "input_revision": {
          "type": "integer",
          "minimum": 1
        },
        "local_inventory_artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "research_artifact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "decision": {
          "enum": [
            "REUSE_LOCAL",
            "ADOPT_UPSTREAM",
            "ADAPT_UPSTREAM",
            "CUSTOM_GAP"
          ]
        },
        "chosen_source": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "type": "string",
          "minLength": 1
        },
        "license_ref": {
          "type": "string",
          "minLength": 1
        },
        "patch_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rejected_alternatives": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "remaining_gap": {
          "type": "string"
        },
        "evidence_artifact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "adoption_decision_ref": {
          "allOf": [
            {
              "$ref": "domain.schema.json#/$defs/VersionRef"
            },
            {
              "properties": {
                "entity_type": {
                  "const": "Artifact"
                },
                "content_hash": {
                  "$ref": "domain.schema.json#/$defs/Digest"
                }
              }
            }
          ]
        }
      },
      "required": [
        "project_id",
        "capability_id",
        "input_revision",
        "local_inventory_artifact_id",
        "research_artifact_ids",
        "decision",
        "chosen_source",
        "source_revision",
        "license_ref",
        "patch_scope",
        "rejected_alternatives",
        "remaining_gap",
        "evidence_artifact_ids",
        "adoption_decision_ref"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "const": "CUSTOM_GAP"
              }
            },
            "required": [
              "decision"
            ]
          },
          "then": {
            "properties": {
              "remaining_gap": {
                "type": "string",
                "minLength": 1
              },
              "rejected_alternatives": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "patch_scope": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "EmptyPayload": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "ConfigurePayload": {
      "type": "object",
      "properties": {
        "config_revision": {
          "type": "integer",
          "minimum": 1
        },
        "provider_id": {
          "type": "string",
          "minLength": 1
        },
        "base_url": {
          "type": "string",
          "format": "uri"
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "credential_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "config_revision",
        "provider_id",
        "base_url",
        "model_id",
        "credential_ref"
      ],
      "additionalProperties": false
    },
    "BootstrapPayload": {
      "type": "object",
      "properties": {
        "authorized_workspace_ref": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "authorized_workspace_ref",
        "display_name"
      ],
      "additionalProperties": false
    },
    "ListSessionsPayload": {
      "type": "object",
      "properties": {
        "cursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "cursor",
        "limit"
      ],
      "additionalProperties": false
    },
    "CreateSessionPayload": {
      "type": "object",
      "properties": {
        "workspace_ref": {
          "type": "string",
          "minLength": 1
        },
        "model_config_ref": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "workspace_ref",
        "model_config_ref",
        "title"
      ],
      "additionalProperties": false
    },
    "AttachPayload": {
      "type": "object",
      "properties": {
        "after_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "request_write_owner": {
          "type": "boolean"
        }
      },
      "required": [
        "after_sequence",
        "request_write_owner"
      ],
      "additionalProperties": false
    },
    "ReadEventsPayload": {
      "type": "object",
      "properties": {
        "after_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      },
      "required": [
        "after_sequence",
        "limit"
      ],
      "additionalProperties": false
    },
    "HandoffPayload": {
      "type": "object",
      "properties": {
        "target_client_id": {
          "type": "string",
          "minLength": 1
        },
        "handoff_mode": {
          "enum": [
            "WHEN_SETTLED",
            "PAUSE_THEN_TRANSFER"
          ]
        }
      },
      "required": [
        "target_client_id",
        "handoff_mode"
      ],
      "additionalProperties": false
    },
    "StartGoalPayload": {
      "type": "object",
      "properties": {
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "contract_artifact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "start_as_draft": {
          "type": "boolean"
        }
      },
      "required": [
        "objective",
        "contract_artifact_ids",
        "start_as_draft"
      ],
      "additionalProperties": false
    },
    "LocalInventoryPayload": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "authorized_scope_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "capability": {
                "type": "string",
                "minLength": 1
              },
              "location_ref": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "FOUND",
                  "NOT_FOUND",
                  "NOT_CHECKED",
                  "NOT_ACCESSIBLE"
                ]
              },
              "revision_or_hash": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "notes": {
                "type": "string"
              }
            },
            "required": [
              "capability",
              "location_ref",
              "status",
              "revision_or_hash",
              "notes"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "project_id",
        "authorized_scope_refs",
        "environment",
        "observed_at",
        "entries"
      ],
      "additionalProperties": false
    }
  }
}
