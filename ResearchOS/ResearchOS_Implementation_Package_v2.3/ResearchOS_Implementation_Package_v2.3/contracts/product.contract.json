  "cli": {
    "binary": "researchos",
    "commands": [
      {
        "id": "interactive",
        "syntax": "researchos [--project <path-or-id>]",
        "local_operations": [
          "session.list",
          "session.create",
          "session.attach",
          "session.send"
        ],
        "required": true
      },
      {
        "id": "init",
        "syntax": "researchos init <path>",
        "local_operations": [
          "project.bootstrap"
        ],
        "required": true
      },
      {
        "id": "run",
        "syntax": "researchos run <prompt> --project <id> --output jsonl",
        "local_operations": [
          "session.send",
          "session.events"
        ],
        "required": true
      },
      {
        "id": "goal",
        "syntax": "researchos goal <text> [--project <id>]",
        "local_operations": [
          "goal.start"
        ],
        "required": true
      },
      {
        "id": "resume",
        "syntax": "researchos resume <session-id>",
        "local_operations": [
          "session.attach",
          "session.control"
        ],
        "required": true
      },
      {
        "id": "status",
        "syntax": "researchos status [--project <id>]",
        "local_operations": [
          "session.get",
          "host.status"
        ],
        "required": true
      },
      {
        "id": "cancel",
        "syntax": "researchos cancel <run-or-goal-id>",
        "local_operations": [
          "session.control"
        ],
        "required": true
      },
      {
        "id": "doctor",
        "syntax": "researchos doctor",
        "local_operations": [
          "host.status"
        ],
        "required": true
      },
      {
        "id": "config",
        "syntax": "researchos config",
        "local_operations": [
          "host.configure"
        ],
        "required": true
      }
    ],
    "slash_commands": [
      "/goal",
      "/status",
      "/resume",
      "/cancel",
      "/model",
      "/help"
    ],
    "headless_format": "JSONL",
    "stdout_only_structured_when_jsonl": true,
    "exit_codes": {
      "0": "execution_result_reported; independent acceptance separate",
      "1": "execution_or_check_failed",
      "2": "invalid_input_or_configuration",
      "3": "blocked_missing_resource_or_authorization",
      "130": "cancelled_by_user"
    }
  },
  "desktop": {
    "preferred_base": "Mu Desktop at fixed source commit",
    "installer_required": true,
    "bundled_runtime_required": true,
    "source_only_not_delivery": true,
    "shared_core_with_cli": true,
    "mandatory_flows": [
      "project_folder_picker",
      "provider_setup",
      "agent_conversation",
      "tool_events",
      "file_tree",
      "diff_review",
      "artifact_preview",
      "goal_pause_resume_cancel",
      "cost_and_blockers",
      "settings"
    ],
    "renderer_has_general_shell_or_fs": false,
    "remote_server_required_for_local_use": false
  },
  "local_protocol": {
    "version": "researchos-client/1",
    "schema": "client.protocol.schema.json",
    "transport_options": [
      "authenticated_named_pipe",
      "authenticated_local_socket",
      "authenticated_loopback"
    ],
    "one_write_owner_per_session": true,
    "command_id_dedup": true,
    "events_replayable": true,
    "methods": [
      "host.status",
      "host.configure",
      "project.bootstrap",
      "session.list",
      "session.create",
      "session.get",
      "session.attach",
      "session.send",
      "session.control",
      "session.events",
      "session.handoff",
      "goal.start"
    ],
    "domain_operations": [
      "createProject",
      "getProjectState",
      "createGoal",
      "actOnGoal",
      "cancelRun",
      "getRun",
      "listRun",
      "createContextBundle",
      "listArtifact",
      "getArtifactContent",
      "recordDecision",
      "sealArtifact",
      "streamEvents"
    ],
    "bound_by": "W02 maps transport; W03/W05 implement handlers; W13 consumes the same contract",
    "payload_definitions": {
      "host.status": "EmptyPayload",
      "host.configure": "ConfigurePayload",
      "project.bootstrap": "BootstrapPayload",
      "session.list": "ListSessionsPayload",
      "session.create": "CreateSessionPayload",
      "session.get": "EmptyPayload",
      "session.attach": "AttachPayload",
      "session.send": "SendMessagePayload",
      "session.control": "ControlPayload",
      "session.events": "ReadEventsPayload",
      "session.handoff": "HandoffPayload",
      "goal.start": "StartGoalPayload"
    }
  },
  "bootstrap": {
    "order": [
      "LOCAL_INVENTORY",
      "RESEARCH",
      "REUSE_DECISION",
      "IMPLEMENTATION"
    ],
    "outcomes": [
      "REUSE_LOCAL",
      "ADOPT_UPSTREAM",
      "ADAPT_UPSTREAM",
      "CUSTOM_GAP"
    ],
    "unavailable_is_not_empty": true,
    "cached_research_requires_revision_and_relevance": true,
    "custom_requires_gap_and_rejected_alternatives": true,
    "storage": "Immutable Artifact payloads with project/task/decision references and existing EventEnvelope; not a second state database.",
    "decision_substeps": [
      "CANDIDATE_EVIDENCE",
      "JEV_ADVISORY_OR_QUALIFIED_JUDGMENT",
      "DETERMINISTIC_GATES",
      "INDEPENDENT_REVIEW",
      "BOUNDED_TRIAL_AND_FINAL_DISPOSITION"
    ],
    "negative_dispositions": [
      "REJECT",
      "WATCH",
      "INCONCLUSIVE"
    ],
    "inspection_clone_is_adoption": false,
    "judgment_contract": "adoption.contract.json"
  },
  "route_policy": {
    "preferred": "MU_FORK",
    "reuse_alternative": "PI_COMPOSE",
    "gap_route": "GAP_ONLY_COMPOSE",
    "allowed_selected_routes": [
      "MU_FORK",
      "PI_COMPOSE",
      "GAP_ONLY_COMPOSE"
    ],
    "maximum_reuse_routes": 2,
    "repairs_per_route": 1,
    "custom_only_after_evidence": true,
    "single_business_scheduler": true
  }
}
