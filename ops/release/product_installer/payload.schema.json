{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchos.local/schemas/static-payload-v1",
  "title": "ResearchOS reviewed static product payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "candidate_marker_sha256", "metadata", "binaries", "files", "verifier_template"],
  "properties": {
    "schema": {"const": "researchos.static-payload/1"},
    "candidate_marker_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "metadata": {
      "type": "object",
      "required": ["schema", "mode", "source_commit", "source_digest", "product_version", "client_protocol", "schema_version", "tool_hashes", "go_compiled_input_sha256", "mu_compiled_input_sha256", "mu_vendor_5083_sha256", "client_wire_input_digest"],
      "properties": {
        "schema": {"const": "researchos.product-layout/1"},
        "mode": {"const": "OWNED_PRODUCT_LAYOUT_NOT_INSTALLER"},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "product_version": {"const": "2.4.0"},
        "client_protocol": {"const": "researchos-client/2"},
        "schema_version": {"const": 24},
        "tool_hashes": {"type": "object"},
        "go_compiled_input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "mu_compiled_input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "mu_vendor_5083_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "client_wire_input_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "binaries": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/binary"},
      "required": ["cli", "control", "electron", "verifier", "validator"]
    },
    "files": {"type": "array", "minItems": 100, "items": {"$ref": "#/$defs/row"}},
    "verifier_template": {"type": "object", "required": ["schema", "service_id", "protocol", "source_commit", "arguments"]}
  },
  "$defs": {
    "row": {"type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "bytes": {"type": "integer", "minimum": 0}}},
    "binary": {"type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
  }
}
