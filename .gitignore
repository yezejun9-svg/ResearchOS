# Rebuildable dependencies, tools and local runtime data
/.local/
**/node_modules/
**/__pycache__/
*.pyc
/apps/web/dist/
/apps/desktop/resources/
/apps/desktop/out/
/dist/
/build/
/coverage/

# Credentials and private databases stay on the development machine
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm
**/.git-credentials

# Logs and OS/editor scratch files
*.log
.DS_Store
Thumbs.db
*.tmp

# Upstream ignores this public catalog, but offline Mu builds need it.
!third_party/mu/packages/ai/src/providers/data/
!third_party/mu/packages/ai/src/providers/data/**
