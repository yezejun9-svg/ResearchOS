            "IDEMPOTENCY_CONFLICT",
            "UNSUPPORTED_CAPABILITY",
            "HARNESS_UNAVAILABLE",
            "HARNESS_AUTH_REQUIRED",
            "WORKSPACE_REVOKED",
            "EXECUTION_UNKNOWN",
            "INTERNAL_ERROR"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 1024
        },
        "retryable": {
          "type": "boolean"
        },
        "task_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "current_task_revision": {
          "anyOf": [
