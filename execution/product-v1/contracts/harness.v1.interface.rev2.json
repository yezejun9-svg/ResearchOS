{
  "contract_id": "researchos.host-harness.v1",
  "contract_revision": 2,
  "status": "ROOT_FROZEN_IMPLEMENTATION_INTERFACE_NOT_RUNTIME_QUALIFICATION",
  "api_prefix": "/harness/v1",
  "wire_version": "harness.v1",
  "encoding": "UTF-8 JSON; JSON bodies reject duplicate and unknown fields.",
  "scope": "One Codex readonly ephemeral turn through the existing Coordinator, canonical Task/Run/lease/dispatch/receipt/outbox/idempotency. Existing V2/Mu contracts unchanged; no parallel business DB or scheduler.",
  "routes": [
    {
      "method": "GET",
      "path": "/harness/v1/capabilities",
      "query": {},
      "success_status": 200,
      "response": "CapabilitiesResponse",
      "semantics": "Metadata query never launches a CLI, prompt, model, login or qualification."
    },
    {
      "method": "POST",
      "path": "/harness/v1/tasks",
      "request": "SubmitRequest",
      "success_status": 202,
      "response": "SubmitResponse",
      "semantics": "Atomic original Task creation and request idempotency only. Returns QUEUED/run=null. Sole Coordinator.Scan claims/creates Run and launches after commit."
    },
    {
      "method": "GET",
      "path": "/harness/v1/tasks",
      "query": {
        "project_id": {
          "required": true,
          "type": "string"
        },
        "cursor": {
          "required": false,
          "type": "Decimal",
          "default": "0"
        },
        "limit": {
          "required": false,
          "type": "integer",
          "default": 20,
          "minimum": 1,
          "maximum": 100
        },
        "request_id": {
          "required": false,
          "type": "RequestID"
        }
      },
      "success_status": 200,
      "response": "ListResponse",
      "semantics": "Authoritative persisted recent-task list. Initial cursor0 lists newest first; subsequent decimal cursor is an exclusive older creation boundary. Exact request_id lookup ignores pagination and returns FOUND or NOT_FOUND."
    },
    {
      "method": "GET",
      "path": "/harness/v1/tasks/{task_id}",
      "query": {
        "project_id": {
          "required": true,
          "type": "string"
        }
      },
      "success_status": 200,
      "response": "TaskResponse",
      "semantics": "Read authoritative Task/active Run/revision and final message. No renderer cache authority."
    },
    {
      "method": "GET",
      "path": "/harness/v1/tasks/{task_id}/events",
      "query": {
        "project_id": {
          "required": true,
          "type": "string"
        },
        "cursor": {
          "required": false,
          "type": "Decimal",
          "default": "0"
        },
        "limit": {
          "required": false,
          "type": "integer",
          "default": 100,
          "minimum": 1,
          "maximum": 500
        }
      },
      "success_status": 200,
      "response": "EventsResponse",
      "semantics": "Non-blocking durable event page, ascending sequence strictly after cursor. First release uses polling, not SSE; empty live pages may be retried with bounded backoff."
    },
    {
      "method": "POST",
      "path": "/harness/v1/tasks/{task_id}/cancel",
      "query": {
        "project_id": {
          "required": true,
          "type": "string"
        }
      },
      "request": "CancelRequest",
      "success_status": 200,
      "response": "CancelResponse",
      "semantics": "Atomic compare-and-set against actual Task revision and Run/epoch; never renderer-trusted. Cancellation request is not proof of stopped process."
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Decimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "x-int64-max": "9223372036854775807"
    },
    "PositiveDecimal": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$",
      "x-int64-max": "9223372036854775807"
    },
