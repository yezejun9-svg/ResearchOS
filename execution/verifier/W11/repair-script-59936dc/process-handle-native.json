{
  "probe": "Get-Process on current reviewer PowerShell process; read-only reflection before and after explicit SafeHandle access",
  "powershell": "7.6.5",
  "dotnet": "10.0.11",
  "before": {
    "have_process_handle": false,
    "process_handle_is_null": true
  },
  "after": {
    "have_process_handle": true,
    "process_handle_is_null": false,
    "safe_handle_invalid": false,
    "safe_handle_closed": false
  },
  "service_process_accessed": false,
  "process_terminated": false
}
