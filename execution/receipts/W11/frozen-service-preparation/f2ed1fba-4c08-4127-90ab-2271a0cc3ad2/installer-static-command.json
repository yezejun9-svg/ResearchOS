{
  "argv": [
    "pwsh",
    "-NoProfile",
    "-Command",
    "$ErrorActionPreference='Stop'\n$errors=$null;$tokens=$null\n[void][Management.Automation.Language.Parser]::ParseFile((Resolve-Path tests/jev/protected/deployment.ps1),[ref]$tokens,[ref]$errors)\nif ($errors.Count -gt 0){throw 'INSTALLER_PARSE_FAILED'}\n$source=Get-Content tests/jev/protected/deployment.ps1 -Raw\n$cs=[regex]::Match($source,\"(?s)Add-Type -TypeDefinition @'\\r?\\n(.*?)\\r?\\n'@\").Groups[1].Value\nif (!$cs){throw 'EMBEDDED_CS_NOT_FOUND'}\nAdd-Type -TypeDefinition $cs\nWrite-Output 'INSTALLER_PARSE_AND_EMBEDDED_CS_COMPILE_PASS'\n"
  ],
  "exit": 0,
  "executed_installer": false
}
