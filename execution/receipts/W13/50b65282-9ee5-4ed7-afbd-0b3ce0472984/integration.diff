+func TestCanaryClientWaitsForBusyPipe(t *testing.T) {
+	name := fmt.Sprintf(`\\.\pipe\ResearchOSBusyClient-%d-%d`, os.Getpid(), time.Now().UnixNano())
+	h, e := windows.CreateNamedPipe(windows.StringToUTF16Ptr(name), windows.PIPE_ACCESS_DUPLEX|windows.FILE_FLAG_FIRST_PIPE_INSTANCE, windows.PIPE_TYPE_MESSAGE|windows.PIPE_READMODE_MESSAGE|windows.PIPE_NOWAIT|windows.PIPE_REJECT_REMOTE_CLIENTS, 1, 4096, 64, 0, nil)
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer windows.CloseHandle(h)
+	first, e := openClientPipe(name, time.Now().Add(time.Second))
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer windows.CloseHandle(first)
+	started := time.Now()
+	_, e = openClientPipe(name, started.Add(50*time.Millisecond))
+	if e != windows.ERROR_PIPE_BUSY || time.Since(started) < 45*time.Millisecond || time.Since(started) > time.Second {
+		t.Fatalf("busy deadline not enforced: %v %v", e, time.Since(started))
+	}
+	disconnected := make(chan error, 1)
+	go func() {
+		time.Sleep(50 * time.Millisecond)
+		if e := windows.DisconnectNamedPipe(h); e != nil {
+			disconnected <- e
+			return
+		}
+		e := windows.ConnectNamedPipe(h, nil)
+		if e == windows.ERROR_PIPE_LISTENING || e == windows.ERROR_PIPE_CONNECTED {
+			e = nil
+		}
+		disconnected <- e
+	}()
+	second, e := openClientPipe(name, time.Now().Add(time.Second))
+	if e != nil {
+		t.Fatal("client did not wait for prior disconnect", e)
+	}
+	windows.CloseHandle(second)
+	if e = <-disconnected; e != nil {
+		t.Fatal(e)
+	}
+}
