+// advanceRuntimeMessageWatermark advances only MESSAGE observation position.
+// The runtime caller rechecks the original effect/dispatch/queue authority in
+// this transaction; client/control calls continue through AdvanceWatermark.
+func advanceRuntimeMessageWatermark(ctx context.Context, tx *sql.Tx, project, id string, epoch, revision, previous, next int64) error {
+	if next != previous+1 {
+		return ErrEventSequence
+	}
+	result, err := tx.ExecContext(ctx, `UPDATE client_sessions SET event_watermark=?,updated_at=?
+ WHERE id=? AND project_id=? AND writer_epoch=? AND revision=? AND event_watermark=? AND sealed_at IS NULL`, next, time.Now().UTC().Format(time.RFC3339Nano), id, project, epoch, revision, previous)
+	if err != nil {
+		return err
+	}
+	n, err := result.RowsAffected()
+	if err != nil {
+		return err
+	}
+	if n != 1 {
+		return ErrStaleWatermark
+	}
+	return nil
+}
