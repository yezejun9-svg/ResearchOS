+// Full deterministic public logical image, captured through a read-only
+// immutable connection before store.Open and again after its final close.
+// Rows retain SQLite value types and rowid where it is stored authority.
+func providerSemanticVector(path, output string) (Object, error) {
+	u := url.URL{Scheme: "file", Opaque: filepath.ToSlash(path)}
+	q := u.Query()
+	q.Set("mode", "ro")
+	q.Set("immutable", "1")
+	u.RawQuery = q.Encode()
+	db, err := sql.Open("sqlite", u.String())
+	if err != nil {
+		return nil, err
+	}
+	defer db.Close()
+	read := func(query string) (Object, error) {
+		rows, e := db.Query(query)
+		if e != nil {
+			return nil, e
+		}
+		defer rows.Close()
+		columns, e := rows.Columns()
+		if e != nil {
+			return nil, e
+		}
+		encoded := []string{}
+		for rows.Next() {
+			values := make([]any, len(columns))
+			args := make([]any, len(columns))
+			for i := range values {
+				args[i] = &values[i]
+			}
+			if e = rows.Scan(args...); e != nil {
+				return nil, e
+			}
+			typed := []any{}
+			for _, value := range values {
+				switch v := value.(type) {
+				case nil:
+					typed = append(typed, []any{"null"})
+				case int64:
+					typed = append(typed, []any{"integer", fmt.Sprint(v)})
+				case float64:
+					typed = append(typed, []any{"real-ieee754", fmt.Sprintf("%016x", math.Float64bits(v))})
+				case string:
+					typed = append(typed, []any{"text", v})
+				case []byte:
+					typed = append(typed, []any{"blob-hex", fmt.Sprintf("%x", v)})
+				default:
+					return nil, fmt.Errorf("unrecorded SQLite value type %T", value)
+				}
+			}
+			encoded = append(encoded, string(Bytes(typed)))
+		}
+		if e = rows.Err(); e != nil {
+			return nil, e
+		}
+		sort.Strings(encoded)
+		return Object{"columns": columns, "row_count": len(encoded), "typed_row_multiset": encoded}, nil
+	}
+	schema, err := read(`SELECT type,name,tbl_name,sql FROM sqlite_schema`)
+	if err != nil {
+		return nil, err
+	}
+	rows, err := db.Query(`SELECT name,coalesce(sql,'') FROM sqlite_schema WHERE type='table' ORDER BY name`)
+	if err != nil {
+		return nil, err
+	}
+	tableSQL := map[string]string{}
+	for rows.Next() {
+		var name, statement string
+		if err = rows.Scan(&name, &statement); err != nil {
+			rows.Close()
+			return nil, err
+		}
+		tableSQL[name] = statement
+	}
+	err = rows.Err()
+	rows.Close()
+	if err != nil {
+		return nil, err
+	}
+	tables := Object{}
+	for name, statement := range tableSQL {
+		quoted := `"` + strings.ReplaceAll(name, `"`, `""`) + `"`
+		projection := "rowid,*"
+		if strings.Contains(strings.ToUpper(statement), "WITHOUT ROWID") || strings.Contains(strings.ToUpper(statement), "CREATE VIRTUAL TABLE") {
+			projection = "*"
+		}
+		data, e := read("SELECT " + projection + " FROM " + quoted)
+		if e != nil {
+			return nil, e
+		}
+		columns, e := read("PRAGMA table_xinfo(" + quoted + ")")
+		if e != nil {
+			return nil, e
+		}
+		tables[name] = Object{"rows": data, "column_metadata": columns}
+	}
+	vector := Object{"format": "researchos.sqlite-public-semantic.v1", "schema": schema, "tables": tables}
+	f, err := os.OpenFile(output, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+	if err != nil {
+		return nil, err
+	}
+	z := gzip.NewWriter(f)
+	_, err = z.Write(Bytes(vector))
+	ce := z.Close()
+	fe := f.Close()
+	if err != nil {
+		return nil, err
+	}
+	if ce != nil {
+		return nil, ce
+	}
+	if fe != nil {
+		return nil, fe
+	}
+	return vector, nil
+}
+
+func TestProviderBindingInventorySyntheticProvenance(t *testing.T) {
+	// SYNTHETIC_NOT_PRODUCT: focused original-reference compatibility, without
+	// qualification, model transport or a claim that this is a historical DB.
+	dir := os.Getenv("RESEARCHOS_PROVIDER_SYNTHETIC_DIR")
+	mode := os.Getenv("RESEARCHOS_PROVIDER_SYNTHETIC_MODE")
+	if dir == "" || os.Mkdir(dir, 0700) != nil {
+		t.Fatal("new synthetic evidence directory required")
+	}
+	db, err := store.Open(filepath.Join(dir, "synthetic.sqlite"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	files, err := filepath.Glob(filepath.Join("..", "..", "migrations", "sqlite", "[0-9][0-9][0-9][0-9]_*.sql"))
+	if err != nil || len(files) == 0 {
+		t.Fatal("actual numbered SQL required", err)
+	}
+	for _, name := range files {
+		raw, e := os.ReadFile(name)
+		if e != nil {
+			t.Fatal(e)
+		}
+		if _, e = db.Exec(string(raw)); e != nil {
+			t.Fatal(name, e)
+		}
+	}
+	project := "synthetic-provider-inventory"
+	runtime := Object{"project_id": project, "id": "runtime", "revision": 1, "adapter": "fixture", "measurement_mode": "FIXTURE", "qualification_ids": Empty()}
+	run := Object{"project_id": project, "id": "run", "revision": 1, "task_id": "task", "runtime_id": "runtime", "lease_epoch": 1, "created_at": "2026-01-01T00:00:00Z", "executor_principal_id": "synthetic"}
+	profile := Object{"runtime_id": "runtime", "technical_hash": runtimeTechnicalHash(runtime), "model_config": Object{"provider": "legacy-fixture"}}
+	content := Bytes(profile)
+	artifact := Object{"project_id": project, "id": "profile", "revision": 1, "storage_key": "synthetic-profile", "content_hash": Digest(content)}
+	for kind, value := range map[string]Object{"Run": run, "RuntimeRegistration": runtime, "Artifact": artifact} {
+		if _, err = db.Exec(`INSERT INTO domain_versions(project,kind,id,revision,body,content_hash) VALUES(?,?,?,?,?,?)`, project, kind, value["id"], 1, string(Bytes(value)), value["content_hash"]); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if _, err = db.Exec(`INSERT INTO auth_principals(id,roles) VALUES('synthetic','["EXECUTOR"]')`); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = db.Exec(`INSERT INTO uploaded_content(storage_key,project,principal,bytes,content_hash,expires_at,sealed) VALUES(?,?,'synthetic',?,?,'2099-01-01T00:00:00Z',1)`, artifact["storage_key"], project, content, artifact["content_hash"]); err != nil {
+		t.Fatal(err)
+	}
+	ref := Ref(artifact, "Artifact")
+	if _, err = db.Exec(`INSERT INTO runtime_bindings(project,runtime,profile_ref,profile_hash,technical_hash,owner) VALUES(?,?,?,?,?,?)`, project, "runtime", string(Bytes(ref)), Hash(ref), runtimeTechnicalHash(runtime), "synthetic"); err != nil {
+		t.Fatal(err)
+	}
+	manifest := Object{"project_id": project, "run_id": "run", "task_id": "task", "runtime_id": "runtime", "executor_principal_id": "synthetic", "epoch": 1, "dispatch_key": "dispatch", "admission": Object{"runtime_ref": Ref(runtime, "RuntimeRegistration"), "profile_ref": ref, "profile_hash": Hash(ref), "profile": profile, "technical_hash": runtimeTechnicalHash(runtime), "mode": "FIXTURE"}}
+	if mode != "generic-missing-ref" {
+		if _, err = db.Exec(`INSERT INTO runtime_dispatches(project,run,epoch,dispatch_key,manifest,manifest_hash,state,prepared_at,updated_at) VALUES(?,?,?,?,?,?,'PREPARED','synthetic','synthetic')`, project, "run", 1, "dispatch", string(Bytes(manifest)), Hash(manifest)); err != nil {
+			t.Fatal(err)
+		}
+	}
+	effect := Object{"project_id": project, "run_id": "run", "task_id": "task", "epoch": 1, "key": "task:run:1:model:1", "sequence": 1, "state": "PREPARED", "payload": Object{"capability": "MODEL"}}
+	if _, err = db.Exec(`INSERT INTO resource_effects(project,run,effect_key,sequence,body) VALUES(?,?,?,?,?)`, project, "run", effect["key"], 1, string(Bytes(effect))); err != nil {
+		t.Fatal(err)
+	}
+	wantError := false
+	switch mode {
+	case "sealed-no-policy":
+	case "later-runtime-revision":
+		later := Merge(runtime, Object{"revision": 2, "adapter": "changed-later"})
+		if _, err = db.Exec(`INSERT INTO domain_versions(project,kind,id,revision,body) VALUES(?,'RuntimeRegistration','runtime',2,?)`, project, string(Bytes(later))); err != nil {
+			t.Fatal(err)
+		}
+		if _, err = db.Exec(`INSERT INTO domain_objects(project,kind,id,revision,body) VALUES(?,'RuntimeRegistration','runtime',2,?)`, project, string(Bytes(later))); err != nil {
+			t.Fatal(err)
+		}
+	case "generic-missing-ref":
+		wantError = true
+		if _, err = db.Exec(`DELETE FROM runtime_bindings`); err != nil {
+			t.Fatal(err)
+		}
+		if _, err = db.Exec(`INSERT INTO orchestration_fixtures(project,runtime) VALUES(?,'runtime')`, project); err != nil {
+			t.Fatal(err)
+		}
+	case "missing-binding":
+		wantError = true
+		if _, err = db.Exec(`DELETE FROM runtime_bindings`); err != nil {
+			t.Fatal(err)
+		}
+	default:
+		t.Fatal("unknown synthetic mode")
+	}
+	tx, err := db.Begin()
+	if err != nil {
+		t.Fatal(err)
+	}
+	inventory, e := validateProviderInventory(tx, project, "run")
+	if err = tx.Rollback(); err != nil {
+		t.Fatal(err)
+	}
+	result := Object{"label": "SYNTHETIC_NOT_PRODUCT", "mode": mode, "inventory": inventory, "want_error": wantError, "error": nil, "models": 0, "workers": 0, "http": 0}
+	if e != nil {
+		result["error"] = e.Error()
+	}
+	if err = os.WriteFile(filepath.Join(dir, "actual.json"), Bytes(result), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if (e != nil) != wantError || len(inventory) != 0 {
+		t.Fatal("unexpected synthetic provenance decision", e, len(inventory))
+	}
+}
+
+// These helpers only mutate newly copied, explicitly synthetic/corrupt fixture
+// databases after the harness has saved every original trigger and logical row.
+// They never generate model traffic or manufacture original accepted history.
+func providerCopiedBodies(db *sql.DB, table string, where string) ([]Object, error) {
+	rows, err := db.Query(`SELECT rowid,body FROM ` + table + ` WHERE ` + where + ` ORDER BY rowid`)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	items := []Object{}
+	for rows.Next() {
+		var row int64
+		var raw string
+		if err = rows.Scan(&row, &raw); err != nil {
+			return nil, err
+		}
+		body, e := Decode([]byte(raw))
+		if e != nil {
+			return nil, e
+		}
+		items = append(items, Object{"rowid": row, "body": body})
+	}
+	return items, rows.Err()
+}
+
+func providerCopiedCost(ledger Object) Object {
+	cost := Object{}
+	for _, key := range []string{"policy_id", "run_id", "operation", "money", "provider_request_id", "provider_event_id", "reservation_id", "cost_basis", "occurred_at"} {
+		cost[key] = ledger[key]
+	}
+	return cost
+}
+
+func providerRehashCopiedEffects(db *sql.DB) error {
+	items, err := providerCopiedBodies(db, "resource_effects", "1=1")
+	if err != nil {
+		return err
+	}
+	for _, item := range items {
+		e := item["body"].(map[string]any)
+		var raw string
+		if err = db.QueryRow(`SELECT body FROM domain_objects WHERE project=? AND kind='BudgetLedgerEntry' AND id=?`, e["project_id"], e["reservation_id"]).Scan(&raw); err != nil {
+			return err
+		}
+		ledger, er := Decode([]byte(raw))
+		if er != nil {
+			return er
+		}
+		e["request_hash"] = Hash([]any{e["payload"], providerCopiedCost(ledger)})
+		if _, err = db.Exec(`UPDATE resource_effects SET body=? WHERE rowid=?`, string(Bytes(e)), item["rowid"]); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func providerWriteCopiedLedger(db *sql.DB, ledger Object) error {
+	ledger["receipt_hash"] = Receipt(ledger)
+	for _, table := range []string{"domain_objects", "domain_versions"} {
+		r, err := db.Exec(`UPDATE `+table+` SET body=?,content_hash=? WHERE project=? AND kind='BudgetLedgerEntry' AND id=? AND revision=?`, string(Bytes(ledger)), ledger["receipt_hash"], ledger["project_id"], ledger["id"], ledger["revision"])
+		if err != nil {
+			return err
+		}
+		n, err := r.RowsAffected()
+		if err != nil || n != 1 {
+			return fmt.Errorf("synthetic ledger exact row: %d %v", n, err)
+		}
+	}
+	return nil
+}
+
+func providerMutateToolCost(db *sql.DB, mode string) error {
+	items, err := providerCopiedBodies(db, "domain_objects", `kind='BudgetLedgerEntry' AND id IN (SELECT json_extract(body,'$.reservation_id') FROM resource_effects WHERE json_extract(body,'$.payload.capability')='TOOL')`)
+	if err != nil {
+		return err
+	}
+	if len(items) == 0 {
+		return fmt.Errorf("no original TOOL reservation")
+	}
+	for _, item := range items {
+		ledger := item["body"].(map[string]any)
+		switch mode {
+		case "tool-cost-event":
+			ledger["provider_event_id"] = "forged/" + Str(ledger, "provider_request_id")
+		case "tool-cost-time":
+			ledger["occurred_at"] = "2026-01-01T00:00:00Z"
+		case "tool-cost-basis":
+			ledger["cost_basis"] = "ACTUAL"
+		case "tool-cost-policy":
+			ledger["policy_id"] = "forged-policy"
+		case "tool-cost-money":
+			ledger["money"] = Object{"currency": "USD", "amount": "99"}
+		default:
+			return fmt.Errorf("unknown copied cost mutation")
+		}
+		if err = providerWriteCopiedLedger(db, ledger); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func providerSyntheticTypedProfile(db *sql.DB, mode string) error {
+	// This is a counterfactual schema-valid copy of the one-PREPARED archive,
+	// not a qualification or an assertion that the modified history occurred.
+	var project, runtime, rawRef string
+	if err := db.QueryRow(`SELECT project,runtime,profile_ref FROM runtime_bindings`).Scan(&project, &runtime, &rawRef); err != nil {
+		return err
+	}
+	ref, err := Decode([]byte(rawRef))
+	if err != nil {
+		return err
+	}
+	var artifactRaw string
+	if err = db.QueryRow(`SELECT body FROM domain_objects WHERE project=? AND kind='Artifact' AND id=?`, project, ref["id"]).Scan(&artifactRaw); err != nil {
+		return err
+	}
+	artifact, err := Decode([]byte(artifactRaw))
+	if err != nil {
+		return err
+	}
+	var content []byte
+	if err = db.QueryRow(`SELECT bytes FROM uploaded_content WHERE storage_key=?`, artifact["storage_key"]).Scan(&content); err != nil {
+		return err
+	}
+	profile, err := Decode(content)
+	if err != nil {
+		return err
+	}
+	routes := Arr(profile, "effect_routes")
+	var model Object
+	for _, value := range routes {
+		r := value.(map[string]any)
+		if r["capability"] == "MODEL" {
+			if model != nil {
+				return fmt.Errorf("synthetic base MODEL tuple ambiguous")
+			}
+			model = r
+		}
+	}
+	if model == nil {
+		return fmt.Errorf("synthetic base MODEL route absent")
+	}
+	zero := mode == "synthetic-zero-model" || mode == "synthetic-zero-disguise"
+	if zero {
+		bound := model["upper_bound"].(map[string]any)
+		bound["amount"] = "0"
+	}
+	if mode == "synthetic-shared-route" {
+		routes = append(routes, Object{"id": model["id"], "capability": "TOOL", "credential_revision": "synthetic-tool", "upper_bound": model["upper_bound"]})
+	}
+	if mode == "synthetic-duplicate-route" || mode == "synthetic-duplicate-bound" {
+		duplicate, e := Decode(Bytes(model))
+		if e != nil {
+			return e
+		}
+		if mode == "synthetic-duplicate-bound" {
+			duplicate["upper_bound"].(map[string]any)["amount"] = "7"
+		}
+		routes = append(routes, duplicate)
+	}
+	profile["effect_routes"] = routes
+	oldContentHash := Str(ref, "content_hash")
+	newContentHash := Digest(Bytes(profile))
+	ref["content_hash"] = newContentHash
+	// Exact digest substitution updates only the synthetic profile asset and
+	// its VersionRefs. All ordinary task/run/budget identities remain fixed.
+	for _, table := range []string{"domain_objects", "domain_versions"} {
+		items, e := providerCopiedBodies(db, table, "1=1")
+		if e != nil {
+			return e
+		}
+		for _, item := range items {
+			body := item["body"].(map[string]any)
+			before := string(Bytes(body))
+			changed := strings.ReplaceAll(before, oldContentHash, newContentHash)
+			if changed == before {
+				continue
+			}
+			if _, e = db.Exec(`UPDATE `+table+` SET body=?,content_hash=CASE WHEN content_hash=? THEN ? ELSE content_hash END WHERE rowid=?`, changed, oldContentHash, newContentHash, item["rowid"]); e != nil {
+				return e
+			}
+		}
+	}
+	if _, err = db.Exec(`UPDATE uploaded_content SET bytes=?,content_hash=? WHERE storage_key=?`, Bytes(profile), newContentHash, artifact["storage_key"]); err != nil {
+		return err
+	}
+	if _, err = db.Exec(`UPDATE runtime_bindings SET profile_ref=?,profile_hash=? WHERE project=? AND runtime=?`, string(Bytes(ref)), Hash(ref), project, runtime); err != nil {
+		return err
+	}
+	var taskID, planRaw string
+	if err = db.QueryRow(`SELECT task,plan FROM runtime_qualification_plans WHERE project=? AND runtime=?`, project, runtime).Scan(&taskID, &planRaw); err != nil {
+		return err
+	}
+	plan, err := Decode([]byte(planRaw))
+	if err != nil {
+		return err
+	}
+	var taskRaw string
+	if err = db.QueryRow(`SELECT body FROM domain_objects WHERE project=? AND kind='Task' AND id=?`, project, taskID).Scan(&taskRaw); err != nil {
+		return err
+	}
+	task, err := Decode([]byte(taskRaw))
+	if err != nil {
+		return err
+	}
+	plan["profile_ref"], plan["task_hash"] = ref, qualificationTaskHash(task)
+	if _, err = db.Exec(`UPDATE runtime_qualification_plans SET plan=?,plan_hash=? WHERE project=? AND task=?`, string(Bytes(plan)), Hash(plan), project, taskID); err != nil {
+		return err
+	}
+	var dispatchRaw, runID string
+	var epoch int64
+	if err = db.QueryRow(`SELECT run,epoch,manifest FROM runtime_dispatches WHERE project=?`, project).Scan(&runID, &epoch, &dispatchRaw); err != nil {
+		return err
+	}
+	m, err := Decode([]byte(dispatchRaw))
+	if err != nil {
+		return err
+	}
+	m, err = Decode([]byte(strings.ReplaceAll(string(Bytes(m)), oldContentHash, newContentHash)))
+	if err != nil {
+		return err
+	}
+	a := m["admission"].(map[string]any)
+	a["profile"], a["profile_ref"], a["profile_hash"] = profile, ref, Hash(ref)
+	if permission, ok := a["permission"].(map[string]any); ok {
+		permission["plan_hash"] = Hash(plan)
+	}
+	if _, err = db.Exec(`UPDATE runtime_qualification_runs SET plan_hash=?,profile_hash=?,input_hash=? WHERE project=? AND task=?`, Hash(plan), Hash(ref), Hash(m["input_refs"]), project, taskID); err != nil {
+		return err
+	}
+	if _, err = db.Exec(`UPDATE runtime_dispatches SET manifest=?,manifest_hash=? WHERE project=? AND run=? AND epoch=?`, string(Bytes(m)), Hash(m), project, runID, epoch); err != nil {
+		return err
+	}
+	if zero {
+		items, e := providerCopiedBodies(db, "domain_objects", `kind='BudgetLedgerEntry' AND json_extract(body,'$.operation')='RESERVE' AND instr(json_extract(body,'$.provider_request_id'),':model:')>0 AND substr(json_extract(body,'$.provider_event_id'),1,8)='prepare/'`)
+		if e != nil {
+			return e
+		}
+		if len(items) != 1 {
+			return fmt.Errorf("synthetic PREPARED expected one MODEL reserve")
+		}
+		ledger := items[0]["body"].(map[string]any)
+		ledger["money"] = model["upper_bound"]
+		if err = providerWriteCopiedLedger(db, ledger); err != nil {
+			return err
+		}
+	}
+	items, err := providerCopiedBodies(db, "resource_effects", "1=1")
+	if err != nil {
+		return err
+	}
+	if len(items) != 1 {
+		return fmt.Errorf("synthetic requires one PREPARED, no observations")
+	}
+	effect := items[0]["body"].(map[string]any)
+	tx, err := db.Begin()
+	if err != nil {
+		return err
+	}
+	run, e := providerOriginalRun(tx, project, runID, effect)
+	var dispatch, transport Object
+	if e == nil {
+		dispatch, e = runtimeDispatch(tx, project, runID, epoch)
+	}
+	if e == nil {
+		transport, e = providerTransport(tx, project, run, dispatch)
+	}
+	rollbackErr := tx.Rollback()
+	if e != nil {
+		return e
+	}
+	if rollbackErr != nil {
+		return rollbackErr
+	}
+	effect["payload"].(map[string]any)["provider_transport"] = transport
+	if _, err = db.Exec(`UPDATE resource_effects SET body=? WHERE rowid=?`, string(Bytes(effect)), items[0]["rowid"]); err != nil {
+		return err
+	}
+	if err = providerRehashCopiedEffects(db); err != nil {
+		return err
+	}
+	if mode == "synthetic-zero-disguise" {
+		_, err = db.Exec(`UPDATE resource_effects SET effect_key=replace(effect_key,':model:',':tool:'),body=json_remove(json_set(body,'$.key',replace(effect_key,':model:',':tool:'),'$.payload.capability','TOOL','$.payload.credential_revision','synthetic-tool'),'$.payload.provider_transport')`)
+	}
+	return err
+}
+
+func TestProviderBindingOriginalEpochCausalControl(t *testing.T) {
+	mode := os.Getenv("RESEARCHOS_PROVIDER_EPOCH_MODE")
+	dir := os.Getenv("RESEARCHOS_PROVIDER_EPOCH_DIR")
+	if dir == "" || os.Mkdir(dir, 0700) != nil {
+		t.Fatal("new explicit epoch control directory required")
+	}
+	db, err := store.Open(filepath.Join(dir, "epoch.sqlite"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	// Exact existing domain schema, no product admission or history creation.
+	schema, err := os.ReadFile(filepath.Join("..", "..", "migrations", "sqlite", "0002_domain.sql"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = db.Exec(string(schema)); err != nil {
+		t.Fatal(err)
+	}
+	for rev := 1; rev <= 3; rev++ {
+		runtime, epoch := "original-runtime", 1
+		if rev == 3 {
+			runtime, epoch = "later-runtime", 2
+		}
+		run := Object{"project_id": "synthetic", "id": "run", "revision": rev, "task_id": "task", "runtime_id": runtime, "lease_epoch": epoch, "created_at": "synthetic", "executor_principal_id": "synthetic", "status": fmt.Sprint(rev)}
+		if _, err = db.Exec(`INSERT INTO domain_versions(project,kind,id,revision,body) VALUES('synthetic','Run','run',?,?)`, rev, string(Bytes(run))); err != nil {
+			t.Fatal(err)
+		}
+	}
+	effect, err := Decode([]byte(`{"epoch":1,"task_id":"task"}`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := ""
+	switch mode {
+	case "decoded-number":
+		if _, ok := effect["epoch"].(json.Number); !ok {
+			t.Fatal("control must exercise real Decode json.Number")
+		}
+	case "int64":
+		effect["epoch"] = int64(1)
+	case "missing":
+		delete(effect, "epoch")
+		want = "provider original Run epoch invalid"
+	case "string", "fraction", "zero", "negative", "overflow":
+		effect["epoch"] = map[string]any{"string": "1", "fraction": json.Number("1.5"), "zero": json.Number("0"), "negative": json.Number("-1"), "overflow": json.Number("9223372036854775808")}[mode]
+		want = "provider original Run epoch invalid"
+	case "no-match":
+		effect["epoch"] = int64(3)
+		want = "provider original Run epoch unavailable"
+	case "ambiguous":
+		run := Object{"project_id": "synthetic", "id": "run", "revision": 4, "task_id": "task", "runtime_id": "ambiguous-runtime", "lease_epoch": 1, "created_at": "synthetic", "executor_principal_id": "synthetic"}
+		if _, err = db.Exec(`INSERT INTO domain_versions(project,kind,id,revision,body) VALUES('synthetic','Run','run',4,?)`, string(Bytes(run))); err != nil {
+			t.Fatal(err)
+		}
+		want = "provider ambiguous original Run epoch"
+	default:
+		t.Fatal("unregistered epoch control")
+	}
+	tx, err := db.Begin()
+	if err != nil {
+		t.Fatal(err)
+	}
+	run, e := providerOriginalRun(tx, "synthetic", "run", effect)
+	if err = tx.Rollback(); err != nil {
+		t.Fatal(err)
+	}
+	result := Object{"label": "SYNTHETIC_NOT_PRODUCT", "mode": mode, "epoch_type": fmt.Sprintf("%T", effect["epoch"]), "epoch_repr": fmt.Sprint(effect["epoch"]), "run": run, "required_cause": want, "error": nil, "models": 0, "workers": 0, "http": 0}
+	if e != nil {
+		result["error"] = e.Error()
+	}
+	if err = os.WriteFile(filepath.Join(dir, "actual.json"), Bytes(result), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if want != "" {
+		if e == nil || !strings.HasSuffix(e.Error(), want) {
+			t.Fatal("incorrect epoch refusal layer", e, want)
+		}
+	} else if e != nil || run["runtime_id"] != "original-runtime" || Hash(run["lease_epoch"]) != Hash(1) {
+		t.Fatal("original epoch not selected", e, run)
+	}
+}
