+// One process executes exactly one explicitly supplied, hashed public archive
+// control. The driver stops on its first unexpected result. This never calls a
+// coordinator, native worker, qualification helper or HTTP client/server.
+func TestProviderBindingInventoryCausalControl(t *testing.T) {
+	raw, err := os.ReadFile(os.Getenv("RESEARCHOS_PROVIDER_CAUSAL_CASE"))
+	if err != nil {
+		t.Fatal("explicit zero-model control specification required", err)
+	}
+	spec, err := Decode(raw)
+	if err != nil {
+		t.Fatal(err)
+	}
+	input, err := os.ReadFile(Str(spec, "input"))
+	if err != nil || Digest(input) != spec["input_sha256"] {
+		t.Fatal("sealed public input mismatch", err)
+	}
+	dir := Str(spec, "output")
+	if err = os.Mkdir(dir, 0700); err != nil {
+		t.Fatal("new immutable case directory required", err)
+	}
+	path := filepath.Join(dir, "case.sqlite")
+	if err = os.WriteFile(path, input, 0600); err != nil {
+		t.Fatal(err)
+	}
+	before, err := providerSemanticVector(path, filepath.Join(dir, "semantic-before.json.gz"))
+	if err != nil {
+		t.Fatal("pre-open full semantic vector", err)
+	}
+	preOpen, err := os.ReadFile(path)
+	if err != nil || Digest(preOpen) != Digest(input) {
+		t.Fatal("pre-open exact copy drift", err)
+	}
+	db, err := store.Open(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	result := Object{"case": spec["case"], "mutation": spec["mutation"], "input_sha256": Digest(input), "pre_open_copy_sha256": Digest(preOpen), "semantic_before_hash": Hash(before), "mode": "ZERO_MODEL_PUBLIC_ARCHIVE_CONTROL", "http_calls": 0, "model_calls": 0, "worker_starts": 0}
+	t.Cleanup(func() {
+		if _, e := db.Exec(`PRAGMA wal_checkpoint(TRUNCATE)`); e != nil {
+			t.Error(e)
+		}
+		if e := db.Close(); e != nil {
+			t.Error(e)
+		}
+		closed, e := os.ReadFile(path)
+		if e != nil {
+			t.Error(e)
+		}
+		result["closed_db_sha256"] = Digest(closed)
+		after, semanticErr := providerSemanticVector(path, filepath.Join(dir, "semantic-after.json.gz"))
+		if semanticErr != nil {
+			t.Error("closed full semantic vector", semanticErr)
+			result["semantic_error"] = semanticErr.Error()
+		} else {
+			result["semantic_after_hash"] = Hash(after)
+			result["semantic_equal"] = Hash(before) == Hash(after)
+			changed := []any{}
+			bt, _ := before["tables"].(map[string]any)
+			at, _ := after["tables"].(map[string]any)
+			allowed := map[string]bool{}
+			for _, name := range Arr(spec, "allowed_mutation_tables") {
+				allowed[fmt.Sprint(name)] = true
+			}
+			if Hash(before["schema"]) != Hash(after["schema"]) || len(bt) != len(at) {
+				t.Error("schema/all-table inventory drift")
+			}
+			for name, value := range bt {
+				if Hash(value) != Hash(at[name]) {
+					changed = append(changed, name)
+					if !allowed[name] || spec["mutation"] == "none" {
+						t.Error("unregistered semantic table delta", name)
+					}
+				}
+			}
+			result["changed_tables"] = changed
+			if spec["want_error"] == false && spec["mutation"] == "none" && Hash(before) != Hash(after) {
+				t.Error("positive archive changed semantically")
+			}
+		}
+		original, e := os.ReadFile(Str(spec, "input"))
+		if e != nil || Digest(original) != spec["input_sha256"] {
+			t.Error("source input drift", e)
+		}
+		result["input_after_sha256"] = Digest(original)
+		result["test_failed"] = t.Failed()
+		if e = os.WriteFile(filepath.Join(dir, "actual.json"), Bytes(result), 0600); e != nil {
+			t.Error(e)
+		}
+	})
+	// Preserve and restore all original triggers, including unrelated ones:
+	// acceptance cannot be attributed to a weakened trigger inventory.
+	counts := Object{}
+	for _, capability := range []string{"MODEL", "TOOL"} {
+		var n int64
+		if err = db.QueryRow(`SELECT count(*) FROM (SELECT project,run,effect_key FROM resource_effects WHERE json_extract(body,'$.payload.capability')=? GROUP BY project,run,effect_key)`, capability).Scan(&n); err != nil {
+			t.Fatal(err)
+		}
+		counts[capability] = n
+	}
+	result["original_effect_key_counts"] = counts
+	if expected, ok := spec["original_effect_key_counts"]; ok && Hash(counts) != Hash(expected) {
+		t.Fatal("original key count mismatch", counts, expected)
+	}
+	budgetRows, err := providerCopiedBodies(db, "domain_objects", `kind='BudgetLedgerEntry'`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	result["original_budget_rows"] = budgetRows
+	result["original_budget_rows_hash"] = Hash(budgetRows)
+	readTriggers := func() Object {
+		rows, e := db.Query(`SELECT name,sql FROM sqlite_master WHERE type='trigger' ORDER BY name`)
+		if e != nil {
+			t.Fatal(e)
+		}
+		out := Object{}
+		for rows.Next() {
+			var name, statement string
+			if e = rows.Scan(&name, &statement); e != nil {
+				t.Fatal(e)
+			}
+			out[name] = statement
+		}
+		e = rows.Err()
+		rows.Close()
+		if e != nil {
+			t.Fatal(e)
+		}
+		return out
+	}
+	triggers := readTriggers()
+	result["original_triggers"] = triggers
+	mode := Str(spec, "mutation")
+	if mode != "none" {
+		for name := range triggers {
+			if _, err = db.Exec(`DROP TRIGGER "` + strings.ReplaceAll(name, `"`, `""`) + `"`); err != nil {
+				t.Fatal(err)
+			}
+		}
+		statements := []string{}
+		switch mode {
+		case "disguise-model-as-tool":
+			statements = []string{`UPDATE resource_effects SET effect_key=replace(effect_key,':model:',':tool:99'),body=json_remove(json_set(body,'$.key',replace(effect_key,':model:',':tool:99'),'$.payload.capability','TOOL','$.payload.credential_revision','local-tools-v1'),'$.payload.provider_transport') WHERE json_extract(body,'$.payload.capability')='MODEL'`}
+		case "swap-tool-reservation", "swap-tool-reservation-rehashed":
+			statements = []string{`UPDATE resource_effects SET body=json_set(body,'$.reservation_id',(SELECT json_extract(t.body,'$.reservation_id') FROM resource_effects t WHERE t.project=resource_effects.project AND t.run=resource_effects.run AND json_extract(t.body,'$.payload.capability')='TOOL' ORDER BY t.sequence LIMIT 1)) WHERE json_extract(body,'$.payload.capability')='MODEL' AND EXISTS(SELECT 1 FROM resource_effects t WHERE t.project=resource_effects.project AND t.run=resource_effects.run AND json_extract(t.body,'$.payload.capability')='TOOL')`}
+		case "erase-model-effects":
+			statements = []string{`DELETE FROM resource_effects WHERE json_extract(body,'$.payload.capability')='MODEL'`}
+		case "tool-key":
+			statements = []string{`UPDATE resource_effects SET effect_key=effect_key||'9',body=json_set(body,'$.key',effect_key||'9') WHERE json_extract(body,'$.payload.capability')='TOOL'`}
+		case "tool-epoch":
+			statements = []string{`UPDATE resource_effects SET body=json_set(body,'$.epoch',999) WHERE json_extract(body,'$.payload.capability')='TOOL'`}
+		case "tool-credential":
+			statements = []string{`UPDATE resource_effects SET body=json_set(body,'$.payload.credential_revision','forged') WHERE json_extract(body,'$.payload.capability')='TOOL'`}
+		case "tool-request-hash":
+			statements = []string{`UPDATE resource_effects SET body=json_set(body,'$.request_hash','sha256:forged') WHERE json_extract(body,'$.payload.capability')='TOOL'`}
+		case "tool-cost-event", "tool-cost-time", "tool-cost-basis", "tool-cost-policy", "tool-cost-money":
+			if err = providerMutateToolCost(db, mode); err != nil {
+				t.Fatal("explicit stored cost mutation", err)
+			}
+		case "synthetic-zero-model", "synthetic-zero-disguise", "synthetic-shared-route", "synthetic-duplicate-route", "synthetic-duplicate-bound":
+			result["mode"] = "SYNTHETIC_NOT_PRODUCT"
+			if err = providerSyntheticTypedProfile(db, mode); err != nil {
+				t.Fatal("synthetic typed proof construction", err)
+			}
+		case "missing-dispatch-transport":
+			statements = []string{`DELETE FROM runtime_dispatches`, `UPDATE resource_effects SET body=json_remove(body,'$.payload.provider_transport') WHERE json_extract(body,'$.payload.capability')='MODEL'`}
+		case "double-marker":
+			statements = []string{`UPDATE runtime_dispatches SET manifest=json_remove(manifest,'$.admission.profile.model_config.provider_policy')`, `UPDATE resource_effects SET body=json_remove(body,'$.payload.provider_transport') WHERE json_extract(body,'$.payload.capability')='MODEL'`}
+		case "missing-admission", "missing-profile-ref", "missing-runtime-ref":
+			field := map[string]string{"missing-admission": "$.admission", "missing-profile-ref": "$.admission.profile_ref", "missing-runtime-ref": "$.admission.runtime_ref"}[mode]
+			statements = []string{`UPDATE runtime_dispatches SET manifest=json_remove(manifest,'` + field + `')`, `UPDATE resource_effects SET body=json_remove(body,'$.payload.provider_transport') WHERE json_extract(body,'$.payload.capability')='MODEL'`}
+		case "missing-binding":
+			statements = []string{`DELETE FROM runtime_bindings`}
+		case "missing-qualification":
+			statements = []string{`DELETE FROM runtime_qualification_runs`, `DELETE FROM runtime_qualification_plans`}
+		case "forged-fixture-deleted-native":
+			statements = []string{`INSERT OR IGNORE INTO orchestration_fixtures(project,runtime) SELECT project,runtime FROM runtime_bindings`, `DELETE FROM runtime_dispatches`, `DELETE FROM runtime_bindings`, `DELETE FROM runtime_qualification_runs`, `DELETE FROM runtime_qualification_plans`, `UPDATE resource_effects SET body=json_remove(body,'$.payload.provider_transport')`}
+		case "missing-all-run-history":
+			statements = []string{`DELETE FROM domain_refs WHERE (kind='Run' AND (project,id) IN (SELECT project,run FROM resource_effects)) OR (target_kind='Run' AND (target_project,target_id) IN (SELECT project,run FROM resource_effects))`, `DELETE FROM domain_versions WHERE kind='Run' AND (project,id) IN (SELECT project,run FROM resource_effects)`, `DELETE FROM runtime_dispatches`, `DELETE FROM runtime_bindings`, `UPDATE resource_effects SET body=json_remove(body,'$.payload.provider_transport')`}
+		case "cross-run":
+			statements = []string{`UPDATE runtime_dispatches SET manifest=json_set(manifest,'$.run_id','foreign-run')`}
+		case "foreign-runtime-ref":
+			statements = []string{`UPDATE runtime_dispatches SET manifest=json_set(manifest,'$.admission.runtime_ref.id','foreign-runtime')`}
+		case "ambiguous-epoch":
+			statements = []string{`UPDATE domain_versions SET body=json_set(body,'$.runtime_id','foreign-runtime') WHERE kind='Run' AND revision=(SELECT max(v.revision) FROM domain_versions v WHERE v.project=domain_versions.project AND v.kind='Run' AND v.id=domain_versions.id)`}
+		case "wrong-request-hash":
+			statements = []string{`UPDATE resource_effects SET body=json_set(body,'$.request_hash','sha256:forged')`}
+		case "changed-capability":
+			statements = []string{`UPDATE resource_effects SET body=json_set(body,'$.payload.capability','TOOL') WHERE json_extract(body,'$.payload.capability')='MODEL'`}
+		case "changed-key-and-capability":
+			statements = []string{`UPDATE resource_effects SET effect_key=replace(effect_key,':model:',':tool:'),body=json_set(body,'$.key',replace(effect_key,':model:',':tool:'),'$.payload.capability','TOOL') WHERE json_extract(body,'$.payload.capability')='MODEL'`}
+		case "sparse-sequence":
+			statements = []string{`UPDATE resource_effects SET sequence=sequence+100,body=json_set(body,'$.sequence',sequence+100)`}
+		case "no-prepared":
+			statements = []string{`DELETE FROM resource_effects WHERE sequence=1`}
+		case "wrong-epoch":
+			statements = []string{`UPDATE resource_effects SET body=json_set(body,'$.epoch',999)`}
+		case "wrong-sql-key":
+			statements = []string{`UPDATE resource_effects SET effect_key='foreign-'||effect_key`}
+		default:
+			t.Fatal("unregistered control mutation", mode)
+		}
+		result["mutation_statements"] = statements
+		affected := []any{}
+		for _, statement := range statements {
+			changed, e := db.Exec(statement)
+			if e != nil {
+				err = e
+				t.Fatal("explicit corruption setup", err)
+			}
+			n, e := changed.RowsAffected()
+			if e != nil {
+				t.Fatal(e)
+			}
+			affected = append(affected, Object{"statement": statement, "rows": n})
+		}
+		result["mutation_affected_rows"] = affected
+		if mode == "swap-tool-reservation-rehashed" {
+			if err = providerRehashCopiedEffects(db); err != nil {
+				t.Fatal("explicit forged copied request hash", err)
+			}
+		}
+		// Rehash altered dispatches so the semantic provenance guard, rather
+		// than only the preexisting manifest digest guard, must reject them.
+		rows, e := db.Query(`SELECT project,run,epoch,manifest FROM runtime_dispatches`)
+		if e != nil {
+			t.Fatal(e)
+		}
+		manifests := []Object{}
+		for rows.Next() {
+			var p, r, text string
+			var epoch int64
+			if e = rows.Scan(&p, &r, &epoch, &text); e != nil {
+				t.Fatal(e)
+			}
+			m, e := Decode([]byte(text))
+			if e != nil {
+				t.Fatal(e)
+			}
+			manifests = append(manifests, Object{"project": p, "run": r, "epoch": epoch, "hash": Hash(m)})
+		}
+		e = rows.Err()
+		rows.Close()
+		if e != nil {
+			t.Fatal(e)
+		}
+		for _, m := range manifests {
+			if _, err = db.Exec(`UPDATE runtime_dispatches SET manifest_hash=? WHERE project=? AND run=? AND epoch=?`, m["hash"], m["project"], m["run"], m["epoch"]); err != nil {
+				t.Fatal(err)
+			}
+		}
+		for _, statement := range triggers {
+			if _, err = db.Exec(statement.(string)); err != nil {
+				t.Fatal(err)
+			}
+		}
+	}
+	result["triggers_after"] = readTriggers()
+	if Hash(result["triggers_after"]) != Hash(triggers) {
+		t.Fatal("original trigger inventory not restored")
+	}
+	tx, err := db.Begin()
+	if err != nil {
+		t.Fatal(err)
+	}
+	inventory, inventoryErr := validateProviderInventory(tx, "", "")
+	if err = tx.Rollback(); err != nil {
+		t.Fatal(err)
+	}
+	backupErr := validateModelStreamBackup(db)
+	result["inventory"] = inventory
+	result["inventory_count"] = len(inventory)
+	result["inventory_error"], result["stream_backup_error"] = nil, nil
+	if inventoryErr != nil {
+		result["inventory_error"] = inventoryErr.Error()
+	}
+	if backupErr != nil {
+		result["stream_backup_error"] = backupErr.Error()
+	}
+	if spec["want_error"] == true {
+		if inventoryErr == nil || backupErr == nil {
+			t.Fatal("unexpected corrupted original accepted", inventoryErr, backupErr)
+		}
+		if cause := Str(spec, "required_cause"); cause != "" && (!strings.HasSuffix(inventoryErr.Error(), cause) || !strings.HasSuffix(backupErr.Error(), cause)) {
+			t.Fatal("wrong causal rejection layer", inventoryErr, backupErr, cause)
+		}
+	} else {
+		want, e := Num(spec, "expected_inventory")
+		if e != nil || inventoryErr != nil || backupErr != nil || int64(len(inventory)) != want || want < 1 {
+			t.Fatal("unexpected sealed original rejected/inventory", inventoryErr, backupErr, len(inventory), want)
+		}
+		for key := range inventory {
+			if !strings.Contains(key, ":model:") {
+				t.Fatal("non-MODEL leaked into inventory", key)
+			}
+		}
+	}
+}
