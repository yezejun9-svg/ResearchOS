{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchos.invalid/persistence-v24.schema.json",
  "oneOf": [
    {
      "$ref": "#/$defs/ProjectBinding"
    },
    {
      "$ref": "#/$defs/ProjectState"
    },
    {
      "$ref": "#/$defs/Goal"
    },
    {
      "$ref": "#/$defs/Task"
    },
    {
      "$ref": "#/$defs/EvaluationSummary"
    }
  ],
  "$defs": {
    "AcceptanceContract": {
      "type": "object",
      "properties": {
        "contract_hash": {
          "$ref": "#/$defs/Digest"
        },
        "contract_revision": {
          "$ref": "#/$defs/Revision"
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CheckSpec"
          },
          "minItems": 1
        },
        "require_independent_verifier": {
          "const": true
        },
        "version_policy": {
          "const": "EXACT"
        },
        "frozen_at": {
          "$ref": "#/$defs/UtcTime"
        }
      },
      "required": [
        "contract_hash",
        "contract_revision",
        "checks",
        "require_independent_verifier",
        "version_policy",
        "frozen_at"
      ],
      "additionalProperties": false
    },
    "Amount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "CheckSpec": {
      "type": "object",
      "properties": {
        "check_id": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "type": "string",
          "enum": [
            "DETERMINISTIC",
            "MODEL_RUBRIC",
            "PREFERENCE"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "expected": {
          "type": "string",
          "minLength": 1
        },
        "command_key": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "rubric_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/VersionRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "qualification_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "not_applicable_reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "check_id",
        "kind",
        "required",
        "expected",
        "command_key",
        "rubric_ref",
        "qualification_id",
        "not_applicable_reason"
      ],
      "additionalProperties": false
    },
    "Currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "EvaluationCounts": {
      "type": "object",
      "properties": {
        "expected_count": {
          "type": "integer",
          "minimum": 1
        },
        "observed_count": {
          "type": "integer",
          "minimum": 0
        },
        "pass_count": {
          "type": "integer",
          "minimum": 0
        },
        "fail_count": {
          "type": "integer",
          "minimum": 0
        },
        "error_count": {
          "type": "integer",
          "minimum": 0
        },
        "abstain_count": {
          "type": "integer",
          "minimum": 0
        },
        "missing_count": {
          "type": "integer",
          "minimum": 0
        },
        "duplicate_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "expected_count",
        "observed_count",
        "pass_count",
        "fail_count",
        "error_count",
        "abstain_count",
        "missing_count",
        "duplicate_count"
      ],
      "additionalProperties": false
    },
    "EvaluationSummary": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "2.4.0"
        },
        "project_id": {
          "$ref": "#/$defs/Id"
        },
        "experiment_id": {
          "$ref": "#/$defs/Id"
        },
        "run_id": {
          "$ref": "#/$defs/Id"
        },
        "report_artifact_ref": {
          "$ref": "#/$defs/VersionRef"
        },
        "dataset_split": {
          "type": "string",
          "enum": [
            "DEVELOPMENT",
            "HOLDOUT"
          ]
        },
        "counts": {
          "$ref": "#/$defs/EvaluationCounts"
        },
        "dataset_hash": {
          "$ref": "#/$defs/Digest"
        },
        "candidate_hash": {
          "$ref": "#/$defs/Digest"
        },
        "baseline_hash": {
          "$ref": "#/$defs/Digest"
        },
        "rubric_hash": {
          "$ref": "#/$defs/Digest"
        },
        "integrity_status": {
          "type": "string",
          "enum": [
            "COMPLETE",
            "INCOMPLETE",
            "INVALID"
          ]
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "cost": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "created_at": {
          "$ref": "#/$defs/UtcTime"
        }
      },
      "required": [
        "schema_version",
        "project_id",
        "experiment_id",
        "run_id",
        "report_artifact_ref",
        "dataset_split",
        "counts",
        "dataset_hash",
        "candidate_hash",
        "baseline_hash",
        "rubric_hash",
        "integrity_status",
        "duration_ms",
        "cost",
        "limitations",
        "created_at"
      ],
      "additionalProperties": false
    },
    "Goal": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "project_id": {
          "$ref": "#/$defs/Id"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "created_at": {
          "$ref": "#/$defs/UtcTime"
        },
        "updated_at": {
          "$ref": "#/$defs/UtcTime"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "original_intent": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "enum": [
            "PROJECT",
            "SYSTEM"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "DRAFT",
            "ACTIVE",
            "PAUSED",
            "VERIFYING",
            "ACCEPTED",
            "BLOCKED",
            "CANCELLED",
            "NEEDS_REVALIDATION"
          ]
        },
        "requirement_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VersionRef"
          },
          "minItems": 1
        },
        "problem_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "minItems": 1
        },
        "task_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "minItems": 0
        },
        "deliverables": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "acceptance_contract": {
          "$ref": "#/$defs/AcceptanceContract"
        },
        "budget_policy_id": {
          "$ref": "#/$defs/Id"
        },
        "outcome": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "ADOPT",
                "REJECT",
                "WATCH",
                "INCONCLUSIVE"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "acceptance_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "binding": {
          "$ref": "#/$defs/ProjectBinding"
        }
      },
      "required": [
        "id",
        "project_id",
        "revision",
        "created_at",
        "updated_at",
        "title",
        "original_intent",
        "scope",
        "status",
        "requirement_refs",
        "problem_ids",
        "task_ids",
        "deliverables",
        "acceptance_contract",
        "budget_policy_id",
        "outcome",
        "acceptance_id",
        "binding"
      ],
      "additionalProperties": false
    },
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "Money": {
      "type": "object",
      "properties": {
        "amount": {
          "$ref": "#/$defs/Amount"
        },
        "currency": {
          "$ref": "#/$defs/Currency"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "additionalProperties": false
    },
    "ProjectBinding": {
      "type": "object",
      "properties": {
        "route": {
          "type": "string",
          "enum": [
            "MU_FORK",
            "PI_COMPOSE",
            "GAP_ONLY_COMPOSE"
          ]
        },
        "upstream_project_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "upstream_goal_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "upstream_task_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "route",
        "upstream_project_id",
        "upstream_goal_id",
        "upstream_task_id"
      ],
      "additionalProperties": false
    },
    "ProjectState": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "project_id": {
          "$ref": "#/$defs/Id"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "created_at": {
          "$ref": "#/$defs/UtcTime"
        },
        "updated_at": {
          "$ref": "#/$defs/UtcTime"
        },
        "profile_revision": {
          "$ref": "#/$defs/Revision"
        },
        "current_requirement_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VersionRef"
          },
          "minItems": 0
        },
        "current_decision_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VersionRef"
          },
          "minItems": 0
        },
        "active_goal_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "minItems": 0
        },
        "active_cycle_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "blocking_conflict_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "minItems": 0
        },
        "pending_change_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "minItems": 0
        },
        "latest_release_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "event_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "policy_revision": {
          "$ref": "#/$defs/Revision"
        },
        "binding": {
          "$ref": "#/$defs/ProjectBinding"
        }
      },
      "required": [
        "id",
        "project_id",
        "revision",
        "created_at",
        "updated_at",
        "profile_revision",
        "current_requirement_refs",
        "current_decision_refs",
        "active_goal_ids",
        "active_cycle_id",
        "blocking_conflict_ids",
        "pending_change_ids",
        "latest_release_id",
        "event_sequence",
        "policy_revision",
        "binding"
      ],
      "additionalProperties": false,
      "description": "每project_id唯一。由域事务维护；没有通用客户端PATCH接口。"
    },
    "Revision": {
      "type": "integer",
      "minimum": 1
    },
    "Stage": {
      "type": "string",
      "enum": [
        "discovery",
        "verification",
        "experiment",
        "review",
        "delivery",
        "follow_up"
      ]
    },
    "StopPolicy": {
      "type": "object",
      "properties": {
        "wall_time_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "max_parallel_runs": {
          "type": "integer",
          "minimum": 1
        },
        "stop_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "wall_time_seconds",
        "max_attempts",
        "max_parallel_runs",
        "stop_conditions"
      ],
      "additionalProperties": false
    },
    "Task": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "project_id": {
          "$ref": "#/$defs/Id"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "created_at": {
          "$ref": "#/$defs/UtcTime"
        },
        "updated_at": {
          "$ref": "#/$defs/UtcTime"
        },
        "goal_id": {
          "$ref": "#/$defs/Id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "task_type": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "$ref": "#/$defs/Stage"
        },
        "status": {
          "$ref": "#/$defs/TaskStatus"
        },
        "dependency_task_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "minItems": 0
        },
        "requirement_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VersionRef"
          },
          "minItems": 0
        },
        "input_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VersionRef"
          },
          "minItems": 0
        },
        "context_bundle_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "acceptance_contract": {
          "$ref": "#/$defs/AcceptanceContract"
        },
        "assigned_principal_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "active_run_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "output_artifact_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "minItems": 0
        },
        "acceptance_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "blocking_conflict_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "minItems": 0
        },
        "no_progress_record_id": {
          "$ref": "#/$defs/Id"
        },
        "stop_policy": {
          "$ref": "#/$defs/StopPolicy"
        },
        "binding": {
          "$ref": "#/$defs/ProjectBinding"
        }
      },
      "required": [
        "id",
        "project_id",
        "revision",
        "created_at",
        "updated_at",
        "goal_id",
        "title",
        "task_type",
        "stage",
        "status",
        "dependency_task_ids",
        "requirement_refs",
        "input_refs",
        "context_bundle_id",
        "acceptance_contract",
        "assigned_principal_id",
        "active_run_id",
        "output_artifact_ids",
        "acceptance_id",
        "blocking_conflict_ids",
        "no_progress_record_id",
        "stop_policy",
        "binding"
      ],
      "additionalProperties": false
    },
    "TaskStatus": {
      "type": "string",
      "enum": [
        "DRAFT",
        "READY",
        "RUNNING",
        "EXECUTION_REPORTED",
        "VERIFYING",
        "ACCEPTED",
        "FAILED",
        "BLOCKED",
        "CANCELLED",
        "NEEDS_REVALIDATION",
        "DEFERRED_NO_PROGRESS"
      ]
    },
    "UtcTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "VersionRef": {
      "type": "object",
      "properties": {
        "entity_type": {
          "type": "string",
          "enum": [
            "ProjectProfile",
            "ProjectState",
            "Requirement",
            "Goal",
            "Task",
            "Run",
            "Artifact",
            "Evidence",
            "ResearchCycle",
            "Experiment",
            "DecisionReceipt",
            "Qualification",
            "ContextBundle",
            "ChangeProposal",
            "ImpactLink",
            "BudgetPolicy",
            "RunPolicy",
            "ResourceRequest",
            "MilestoneRelease",
            "ProgressProjection",
            "SkillVersion",
            "SystemCandidate",
            "AcceptanceReceipt",
            "AgentMessage",
            "SourceCursor",
            "BudgetLedgerEntry",
            "NoProgressRecord",
            "RuntimeRegistration",
            "Notification",
            "Conflict",
            "EventEnvelope"
          ]
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "content_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "entity_type",
        "id",
        "revision",
        "content_hash"
      ],
      "additionalProperties": false,
      "description": "实体类型必须是本文件核心实体名；服务器验证项目归属、存在性和当前版本。不可变对象 revision 恒为1。"
    }
  },
  "x-source": {
    "package_version": "2.4.0",
    "source_path": "contracts/domain.schema.json",
    "source_sha256": "b53d9e6eddfeed89d27ee65c378d8067ae8b0c46de2ba2a098856a7557df1c54",
    "roots": [
      "ProjectBinding",
      "ProjectState",
      "Goal",
      "Task",
      "EvaluationSummary"
    ],
    "derivation": "Exact transitive $defs closure; no thresholds, properties or required fields changed."
  }
}
