+func harnessPreparationLedger(t *testing.T, f *fixture, fence harnessPreparationFence) ([]Object, string) {
+	t.Helper()
+	request := "runtime-local-launch/" + fence.runID + "/" + strconv.FormatInt(fence.epoch, 10)
+	rows, err := f.db.Query("SELECT body FROM domain_objects WHERE project=? AND kind='BudgetLedgerEntry' AND json_extract(body,'$.provider_request_id')=? ORDER BY rowid", f.project, request)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer rows.Close()
+	entries := []Object{}
+	for rows.Next() {
+		var raw string
+		if err := rows.Scan(&raw); err != nil {
+			t.Fatal(err)
+		}
+		entry, err := Decode([]byte(raw))
+		if err != nil {
+			t.Fatal(err)
+		}
+		entries = append(entries, entry)
+	}
+	if err := rows.Err(); err != nil {
+		t.Fatal(err)
+	}
+	return entries, request
+}
+
+func harnessPreparationReleased(t *testing.T, f *fixture, fence harnessPreparationFence, original []byte) {
+	t.Helper()
+	entries, request := harnessPreparationLedger(t, f, fence)
+	if len(entries) != 2 || entries[0]["operation"] != "RESERVE" || entries[1]["operation"] != "RELEASE" ||
+		entries[1]["reservation_id"] != entries[0]["id"] || entries[1]["provider_event_id"] != request+"/released" ||
+		entries[1]["money"] == nil || entries[1]["receipt_hash"] != Receipt(entries[1]) || !bytes.Equal(Bytes(entries[0]), original) {
+		t.Fatal("C5 did not retain exact zero hold and append one linked release", entries)
+	}
+	money := entries[1]["money"].(map[string]any)
+	amount, err := moneyAmount(money)
+	if err != nil || amount.Sign() != 0 {
+		t.Fatal("nonzero local release", entries[1], err)
+	}
+}
