+func TestHarnessPreparationExistingReleaseConflictRefusesRepeat(t *testing.T) {
+	f, c, fence, proof := harnessPreparationFixture(t)
+	if err := c.finishHarnessPreparationFailure(fence, proof); err != nil {
+		t.Fatal(err)
+	}
+	entries, request := harnessPreparationLedger(t, f, fence)
+	if len(entries) != 2 {
+		t.Fatal("missing settled history", entries)
+	}
+	if _, err := f.db.Exec("DROP TRIGGER objects_immutable"); err != nil {
+		t.Fatal(err)
+	}
+	release := entries[1]
+	release["reservation_id"] = ID()
+	release["receipt_hash"] = Receipt(release)
+	if _, err := f.db.Exec("UPDATE domain_objects SET body=?,content_hash=? WHERE project=? AND kind='BudgetLedgerEntry' AND id=?", Bytes(release), release["receipt_hash"], f.project, release["id"]); err != nil {
+		t.Fatal(err)
+	}
+	if err := c.finishHarnessPreparationFailure(fence, proof); err == nil {
+		t.Fatal("conflicting release accepted idempotently")
+	}
+	var count int
+	if err := f.db.QueryRow("SELECT count(*) FROM domain_objects WHERE project=? AND kind='BudgetLedgerEntry' AND json_extract(body,'$.provider_request_id')=?", f.project, request).Scan(&count); err != nil {
+		t.Fatal(err)
+	}
+	if count != 2 {
+		t.Fatal("repeat appended a new release", count)
+	}
+}
