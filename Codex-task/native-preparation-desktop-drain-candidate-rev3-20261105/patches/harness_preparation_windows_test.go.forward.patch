+func TestHarnessPreparationLocalHoldConflictsRollBackSettlement(t *testing.T) {
+	cases := []string{"missing", "duplicate", "wrong_run", "wrong_project", "wrong_policy", "wrong_request", "wrong_epoch", "wrong_event", "nonzero", "wrong_currency", "parent", "bad_receipt", "unknown", "conflicting_release", "reused_event"}
+	for _, name := range cases {
+		t.Run(name, func(t *testing.T) {
+			f, c, fence, proof := harnessPreparationFixture(t)
+			initial, request := harnessPreparationLedger(t, f, fence)
+			if len(initial) != 1 {
+				t.Fatal("missing claim hold", initial)
+			}
+			hold := initial[0]
+			if name == "missing" {
+				if _, err := f.db.Exec("DELETE FROM domain_objects WHERE project=? AND kind='BudgetLedgerEntry' AND id=?", f.project, hold["id"]); err != nil {
+					t.Fatal(err)
+				}
+			} else if name == "duplicate" || name == "unknown" || name == "conflicting_release" || name == "reused_event" {
+				other := Object{}
+				for k, v := range hold {
+					other[k] = v
+				}
+				other["id"] = ID()
+				other["provider_event_id"] = request + "/extra"
+				if name == "unknown" {
+					other["operation"] = "UNKNOWN"
+					other["money"] = nil
+					other["cost_basis"] = "UNKNOWN"
+					other["reservation_id"] = hold["id"]
+				}
+				if name == "conflicting_release" {
+					other["operation"] = "RELEASE"
+					other["cost_basis"] = "ACTUAL"
+					other["reservation_id"] = hold["id"]
+				}
+				if name == "reused_event" {
+					other["provider_request_id"] = request + "/other"
+					other["provider_event_id"] = request + "/released"
+				}
+				other["receipt_hash"] = Receipt(other)
+				if _, err := f.db.Exec("INSERT INTO domain_objects(project,kind,id,revision,body,content_hash,immutable) VALUES(?,'BudgetLedgerEntry',?,1,?,?,1)", f.project, other["id"], Bytes(other), other["receipt_hash"]); err != nil {
+					t.Fatal(err)
+				}
+			} else {
+				// Disposable DB corruption tests exercise the Host validator. The
+				// production immutable-receipt trigger remains untouched elsewhere.
+				if _, err := f.db.Exec("DROP TRIGGER objects_immutable"); err != nil {
+					t.Fatal(err)
+				}
+				switch name {
+				case "wrong_run":
+					hold["run_id"] = ID()
+				case "wrong_project":
+					hold["project_id"] = ID()
+				case "wrong_policy":
+					hold["policy_id"] = ID()
+				case "wrong_request":
+					hold["provider_request_id"] = request + "/other"
+				case "wrong_epoch":
+					hold["provider_request_id"] = "runtime-local-launch/" + fence.runID + "/" + strconv.FormatInt(fence.epoch+1, 10)
+				case "wrong_event":
+					hold["provider_event_id"] = request + "/other"
+				case "nonzero":
+					hold["money"].(map[string]any)["amount"] = "1"
+				case "wrong_currency":
+					hold["money"].(map[string]any)["currency"] = "EUR"
+				case "parent":
+					hold["reservation_id"] = ID()
+				}
+				if name != "bad_receipt" {
+					hold["receipt_hash"] = Receipt(hold)
+				} else {
+					hold["receipt_hash"] = Digest([]byte("wrong receipt"))
+				}
+				if _, err := f.db.Exec("UPDATE domain_objects SET body=?,content_hash=? WHERE project=? AND kind='BudgetLedgerEntry' AND id=?", Bytes(hold), hold["receipt_hash"], f.project, hold["id"]); err != nil {
+					t.Fatal(err)
+				}
+			}
+			if err := c.finishHarnessPreparationFailure(fence, proof); err == nil {
+				t.Fatal("conflicted local hold committed C5")
+			}
+			var state, status string
+			if err := f.db.QueryRow("SELECT state FROM runtime_dispatches WHERE project=? AND run=? AND epoch=?", f.project, fence.runID, fence.epoch).Scan(&state); err != nil {
+				t.Fatal(err)
+			}
+			if err := f.db.QueryRow("SELECT json_extract(body,'$.status') FROM domain_objects WHERE project=? AND kind='Run' AND id=?", f.project, fence.runID).Scan(&status); err != nil {
+				t.Fatal(err)
+			}
+			var audits, releases int
+			if err := f.db.QueryRow("SELECT count(*) FROM uploaded_content WHERE project=? AND sealed=1 AND CAST(bytes AS TEXT) LIKE '%researchos.native-preparation-outcome.v1%'", f.project).Scan(&audits); err != nil {
+				t.Fatal(err)
+			}
+			if err := f.db.QueryRow("SELECT count(*) FROM domain_objects WHERE project=? AND kind='BudgetLedgerEntry' AND json_extract(body,'$.provider_request_id')=? AND json_extract(body,'$.provider_event_id')=?", f.project, request, request+"/released").Scan(&releases); err != nil {
+				t.Fatal(err)
+			}
+			if state != "STARTED" || status != "QUEUED" || audits != 0 || releases != 0 {
+				t.Fatal("C5 conflict partially committed", state, status, audits, releases)
+			}
+		})
+	}
+}
