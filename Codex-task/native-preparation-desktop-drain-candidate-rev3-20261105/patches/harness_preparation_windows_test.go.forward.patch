+func TestHarnessPreparationReleaseAppendFailureRollsBackC5(t *testing.T) {
+	f, c, fence, proof := harnessPreparationFixture(t)
+	if _, err := f.db.Exec(`CREATE TRIGGER fail_c5_release BEFORE INSERT ON domain_objects
+		WHEN NEW.kind='BudgetLedgerEntry' AND json_extract(NEW.body,'$.operation')='RELEASE'
+		BEGIN SELECT RAISE(ABORT,'inert release fault'); END`); err != nil {
+		t.Fatal(err)
+	}
+	if err := c.finishHarnessPreparationFailure(fence, proof); err == nil {
+		t.Fatal("release failure committed C5")
+	}
+	if _, err := f.db.Exec("DROP TRIGGER fail_c5_release"); err != nil {
+		t.Fatal(err)
+	}
+	entries, _ := harnessPreparationLedger(t, f, fence)
+	var status, reason string
+	if err := f.db.QueryRow("SELECT json_extract(body,'$.status') FROM domain_objects WHERE project=? AND kind='Run' AND id=?", f.project, fence.runID).Scan(&status); err != nil {
+		t.Fatal(err)
+	}
+	if err := f.db.QueryRow("SELECT reason FROM runtime_dispatches WHERE project=? AND run=? AND epoch=?", f.project, fence.runID, fence.epoch).Scan(&reason); err != nil {
+		t.Fatal(err)
+	}
+	var audits int
+	if err := f.db.QueryRow("SELECT count(*) FROM uploaded_content WHERE project=? AND sealed=1 AND CAST(bytes AS TEXT) LIKE '%researchos.native-preparation-outcome.v1%'", f.project).Scan(&audits); err != nil {
+		t.Fatal(err)
+	}
+	if len(entries) != 1 || status != "QUEUED" || reason != "" || audits != 0 {
+		t.Fatal("append failure leaked partial C5 settlement", entries, status, reason, audits)
+	}
+	if err := c.finishHarnessPreparationFailure(fence, proof); err != nil {
+		t.Fatal("original consumed attempt could not settle after rollback", err)
+	}
+	harnessPreparationReleased(t, f, fence, Bytes(entries[0]))
+}
