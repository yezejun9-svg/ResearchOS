+//go:build windows
+
+package runtime
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func TestQualificationCaptureBoundsAndExclusiveReceipt(t *testing.T) {
+	for _, size := range []int{19, qualificationStreamCap + 1} {
+		r, w, err := os.Pipe()
+		if err != nil {
+			t.Fatal(err)
+		}
+		out := make(chan qualificationStream, 1)
+		partial := filepath.Join(t.TempDir(), "stream.partial")
+		go boundedQualificationStream(r, out, partial)
+		payload := bytes.Repeat([]byte{'x'}, size)
+		written := make(chan error, 1)
+		go func() { _, e := w.Write(payload); written <- e; _ = w.Close() }()
+		stream := <-out
+		if err = <-written; err != nil && size <= qualificationStreamCap {
+			t.Fatal(err)
+		}
+		rawPartial, err := os.ReadFile(partial)
+		if err != nil || !bytes.Equal(rawPartial, payload[:min(size, qualificationPrefixCap)]) {
+			t.Fatal("durable partial prefix missing", err, len(rawPartial))
+		}
+		if size < qualificationStreamCap && (!stream.drained || stream.overflow || stream.hash == "") {
+			t.Fatal("complete stream lost", stream)
+		}
+		if size > qualificationStreamCap && (!stream.overflow || len(stream.prefix) != qualificationPrefixCap || stream.hash != "") {
+			t.Fatal("overflow claimed full hash", stream.overflow, len(stream.prefix), stream.hash)
+		}
+	}
+	path := filepath.Join(t.TempDir(), "capture.json")
+	if err := persistQualificationCapture(path, qualificationCapture{PID: 42, JobZero: true, Exited: true, StreamsDrained: true, CleanupComplete: true}, "QUALIFICATION_INCOMPLETE"); err != nil {
+		t.Fatal(err)
+	}
+	first, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = persistQualificationCapture(path, qualificationCapture{}, "PASS"); !errors.Is(err, os.ErrExist) {
+		t.Fatal("exclusive receipt replaced", err)
+	}
+	second, _ := os.ReadFile(path)
+	if !bytes.Equal(first, second) {
+		t.Fatal("partial evidence overwritten")
+	}
+}
+func TestQualificationJobLimitsBeforeAnyChild(t *testing.T) {
+	job, err := qualificationJob("researchos-qualification-fake-" + time.Now().Format("150405.000000000"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer closeJob(job)
+	ids, err := jobPIDs(job)
+	if err != nil || len(ids) != 0 {
+		t.Fatal("empty limited job unverified", ids, err)
+	}
+}
+
+// The supervised Go fixture launches only its own test binary in the new Job.
+// It never invokes Native, auth, sandbox setup, or a model.
+func TestQualificationFakeChild(t *testing.T) {
+	switch os.Getenv("RESEARCHOS_QUALIFICATION_FAKE_CHILD") {
+	case "small":
+		os.Stdout.Write([]byte("synthetic partial diagnostic\n"))
+		return
+	case "overflow":
+		os.Stdout.Write(bytes.Repeat([]byte{'x'}, qualificationStreamCap+8192))
+		return
+	default:
+		return
+	}
+}
+func TestQualificationCollectorOwnedFakeChild(t *testing.T) {
+	exe, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, mode := range []string{"small", "overflow"} {
+		t.Run(mode, func(t *testing.T) {
+			ctx, cancel := context.WithTimeout(context.Background(), 20*time.Second)
+			defer cancel()
+			env := append(Environment(""), "RESEARCHOS_QUALIFICATION_FAKE_CHILD="+mode)
+			capture := collectQualification(ctx, exe, []string{"-test.run=^TestQualificationFakeChild$"}, env, t.TempDir(), "researchos-qualification-fake-"+mode+"-"+time.Now().Format("150405.000000000"), filepath.Join(t.TempDir(), "receipt"))
+			if capture.PID == 0 || !capture.JobZero || !capture.Exited {
+				t.Fatal("owned fake child cleanup not proved", capture.PID, capture.JobZero, capture.Exited, capture.Err)
+			}
+			if mode == "small" && (!capture.StreamsDrained || capture.LimitExceeded || capture.Stdout.hash == "") {
+				t.Fatal("small fake stream incomplete", capture)
+			}
+			if mode == "overflow" && (!capture.LimitExceeded || qualificationCaptureReason(capture) == "") {
+				t.Fatal("overflow fake child qualified", capture)
+			}
+		})
+	}
+}
diff --git a/internal/qualificationprobe/plan.go b/internal/qualificationprobe/plan.go
new file mode 100644
--- /dev/null
+++ b/internal/qualificationprobe/plan.go
@@ -0,0 +1,142 @@
+package qualificationprobe
+
+import (
+	"bytes"
+	"encoding/base64"
+	"encoding/json"
+	"errors"
+	"path/filepath"
+	"strings"
+)
+
+const Schema = "researchos.native-qualification-plan.v1"
+const EventSchema = "researchos.native-qualification-event.v1"
+
+var Cases = [...]string{"source_read", "denied_read", "source_write_open", "working_write_open", "source_create", "working_create", "loopback_connect"}
+
+const CompleteBitmap = (1 << len(Cases)) - 1
+
+type Plan struct {
+	Schema  string   `json:"schema"`
+	Source  string   `json:"source"`
+	Working string   `json:"working"`
+	Denied  string   `json:"denied"`
+	Nonce   string   `json:"nonce"`
+	Port    uint16   `json:"port"`
+	Cases   []string `json:"cases"`
+}
+type Event struct {
+	Schema string `json:"schema"`
+	Phase  string `json:"phase"`
+	Case   string `json:"case"`
+	Errno  int    `json:"errno"`
+	Opened bool   `json:"opened"`
+	Digest string `json:"digest"`
+	Bytes  int    `json:"bytes"`
+	Bitmap uint32 `json:"bitmap"`
+}
+
+func FixedCases() []string { return append([]string(nil), Cases[:]...) }
+func Validate(p Plan) error {
+	if p.Schema != Schema || p.Port == 0 || len(p.Cases) != len(Cases) || !strings.HasPrefix(p.Nonce, "researchos-readonly-") || len(p.Nonce) != len("researchos-readonly-")+32 {
+		return errors.New("QUALIFICATION_PLAN_INVALID")
+	}
+	for i, c := range Cases {
+		if p.Cases[i] != c {
+			return errors.New("QUALIFICATION_PLAN_CASES_CHANGED")
+		}
+	}
+	for _, c := range p.Nonce[len("researchos-readonly-"):] {
+		if !strings.ContainsRune("0123456789abcdef", c) {
+			return errors.New("QUALIFICATION_PLAN_NONCE_INVALID")
+		}
+	}
+	paths := []string{p.Source, p.Working, p.Denied}
+	for _, path := range paths {
+		if !filepath.IsAbs(path) || filepath.Clean(path) != path || strings.ContainsAny(path, "\x00\r\n;") {
+			return errors.New("QUALIFICATION_PLAN_PATH_INVALID")
+		}
+	}
+	if filepath.Base(p.Source) != "S" || filepath.Base(p.Working) != "QW" || filepath.Base(p.Denied) != "D" || !strings.EqualFold(filepath.Dir(p.Source), filepath.Dir(p.Working)) || !strings.EqualFold(filepath.Dir(p.Source), filepath.Dir(p.Denied)) {
+		return errors.New("QUALIFICATION_PLAN_ROOTS_OVERLAP")
+	}
+	if strings.EqualFold(paths[0], paths[1]) || strings.EqualFold(paths[0], paths[2]) || strings.EqualFold(paths[1], paths[2]) {
+		return errors.New("QUALIFICATION_PLAN_ROOTS_OVERLAP")
+	}
+	for _, other := range paths[1:] {
+		rel, err := filepath.Rel(paths[0], other)
+		if err != nil || rel == "." || rel != ".." && !strings.HasPrefix(rel, ".."+string(filepath.Separator)) {
+			return errors.New("QUALIFICATION_PLAN_ROOTS_OVERLAP")
+		}
+	}
+	return nil
+}
+func Encode(p Plan) (string, error) {
+	if err := Validate(p); err != nil {
+		return "", err
+	}
+	raw, err := json.Marshal(p)
+	if err != nil {
+		return "", err
+	}
+	if len(raw) > 4096 {
+		return "", errors.New("QUALIFICATION_PLAN_TOO_LARGE")
+	}
+	return base64.RawURLEncoding.EncodeToString(raw), nil
+}
+func Decode(encoded string) (Plan, error) {
+	var p Plan
+	if len(encoded) == 0 || len(encoded) > 5500 {
+		return p, errors.New("QUALIFICATION_PLAN_TOO_LARGE")
+	}
+	raw, err := base64.RawURLEncoding.DecodeString(encoded)
+	if err != nil || len(raw) > 4096 {
+		return p, errors.New("QUALIFICATION_PLAN_INVALID")
+	}
+	if json.Unmarshal(raw, &p) != nil {
+		return p, errors.New("QUALIFICATION_PLAN_INVALID")
+	}
+	canonical, _ := json.Marshal(p)
+	if !bytes.Equal(raw, canonical) || Validate(p) != nil {
+		return Plan{}, errors.New("QUALIFICATION_PLAN_NONCANONICAL")
+	}
+	return p, nil
+}
+func ParseTranscript(raw []byte) (map[string]Event, error) {
+	if len(raw) == 0 || len(raw) > 1<<20 || raw[len(raw)-1] != '\n' {
+		return nil, errors.New("QUALIFICATION_TRANSCRIPT_INCOMPLETE")
+	}
+	lines := bytes.Split(raw[:len(raw)-1], []byte{'\n'})
+	if len(lines) != 2*len(Cases)+1 {
+		return nil, errors.New("QUALIFICATION_TRANSCRIPT_CASE_COUNT")
+	}
+	results := make(map[string]Event, len(Cases))
+	for i, name := range Cases {
+		for j, phase := range []string{"START", "RESULT"} {
+			var e Event
+			line := lines[2*i+j]
+			if len(line) > 4096 || json.Unmarshal(line, &e) != nil {
+				return nil, errors.New("QUALIFICATION_TRANSCRIPT_INVALID")
+			}
+			canonical, _ := json.Marshal(e)
+			if !bytes.Equal(line, canonical) || e.Schema != EventSchema || e.Phase != phase || e.Case != name || e.Bitmap != 0 {
+				return nil, errors.New("QUALIFICATION_TRANSCRIPT_INVALID")
+			}
+			if j == 0 && (e.Errno != 0 || e.Opened || e.Digest != "" || e.Bytes != 0) {
+				return nil, errors.New("QUALIFICATION_TRANSCRIPT_INVALID")
+			}
+			if j == 1 {
+				results[name] = e
+			}
+		}
+	}
+	var final Event
+	if json.Unmarshal(lines[len(lines)-1], &final) != nil {
+		return nil, errors.New("QUALIFICATION_TRANSCRIPT_INCOMPLETE")
+	}
+	canonical, _ := json.Marshal(final)
+	if !bytes.Equal(lines[len(lines)-1], canonical) || final.Schema != EventSchema || final.Phase != "COMPLETE" || final.Case != "" || final.Bitmap != CompleteBitmap || final.Errno != 0 || final.Opened || final.Digest != "" || final.Bytes != 0 {
+		return nil, errors.New("QUALIFICATION_TRANSCRIPT_INCOMPLETE")
+	}
+	return results, nil
+}
diff --git a/internal/qualificationprobe/plan_test.go b/internal/qualificationprobe/plan_test.go
new file mode 100644
--- /dev/null
+++ b/internal/qualificationprobe/plan_test.go
@@ -0,0 +1,58 @@
+package qualificationprobe
+
+import (
+	"bytes"
+	"encoding/base64"
+	"encoding/json"
+	"path/filepath"
+	"testing"
+)
+
+func fixturePlan(t *testing.T) Plan {
+	t.Helper()
+	root := t.TempDir()
+	return Plan{Schema: Schema, Source: filepath.Join(root, "S"), Working: filepath.Join(root, "QW"), Denied: filepath.Join(root, "D"), Nonce: "researchos-readonly-0123456789abcdef0123456789abcdef", Port: 12345, Cases: FixedCases()}
+}
+func TestFixedPlanRejectsCallerAlternates(t *testing.T) {
+	p := fixturePlan(t)
+	encoded, err := Encode(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got, err := Decode(encoded); err != nil || got.Source != p.Source {
+		t.Fatal("canonical fixed plan rejected", err)
+	}
+	for _, change := range []func(*Plan){func(v *Plan) { v.Source = filepath.Join(t.TempDir(), "user-project") }, func(v *Plan) { v.Working = v.Source }, func(v *Plan) { v.Cases[0] = "generic_command" }, func(v *Plan) { v.Nonce = "fixed" }, func(v *Plan) { v.Port = 0 }} {
+		q := p
+		q.Cases = FixedCases()
+		change(&q)
+		if _, err := Encode(q); err == nil {
+			t.Fatal("alternate plan accepted", q)
+		}
+	}
+	raw, _ := json.Marshal(p)
+	duplicate := bytes.Replace(raw, []byte(`"port":12345`), []byte(`"port":12345,"port":12345`), 1)
+	if _, err := Decode(base64.RawURLEncoding.EncodeToString(duplicate)); err == nil {
+		t.Fatal("duplicate plan key accepted")
+	}
+}
+func TestTranscriptRequiresOrderedCompleteBitmap(t *testing.T) {
+	rows := make([][]byte, 0, 2*len(Cases)+1)
+	for _, name := range Cases {
+		for _, phase := range []string{"START", "RESULT"} {
+			raw, _ := json.Marshal(Event{Schema: EventSchema, Phase: phase, Case: name})
+			rows = append(rows, raw)
+		}
+	}
+	complete, _ := json.Marshal(Event{Schema: EventSchema, Phase: "COMPLETE", Bitmap: CompleteBitmap})
+	rows = append(rows, complete)
+	raw := append(bytes.Join(rows, []byte{'\n'}), '\n')
+	if got, err := ParseTranscript(raw); err != nil || len(got) != len(Cases) {
+		t.Fatal("complete canonical transcript rejected", err)
+	}
+	for _, bad := range [][]byte{raw[:len(raw)-1], append([]byte(nil), raw[:len(raw)-len(complete)-1]...), bytes.Replace(raw, []byte(`"bitmap":127`), []byte(`"bitmap":126`), 1), bytes.Replace(raw, []byte(`"phase":"START"`), []byte(`"phase":"RESULT"`), 1), append(raw, []byte("junk\n")...)} {
+		if _, err := ParseTranscript(bad); err == nil {
+			t.Fatal("incomplete/duplicate transcript accepted")
+		}
+	}
+}
diff --git a/cmd/researchos-qualification-helper/main_windows.go b/cmd/researchos-qualification-helper/main_windows.go
new file mode 100644
--- /dev/null
+++ b/cmd/researchos-qualification-helper/main_windows.go
@@ -0,0 +1,148 @@
+//go:build windows
+
+package main
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"io"
+	"net"
+	"os"
+	"path/filepath"
+	"strconv"
+	"syscall"
+	"time"
+
+	"golang.org/x/sys/windows"
+	"researchos.local/research-os/internal/qualificationprobe"
+)
+
+func errorNumber(err error) int {
+	var n syscall.Errno
+	if errors.As(err, &n) {
+		return int(n)
+	}
+	return -1
+}
+func emit(e qualificationprobe.Event) error {
+	raw, err := json.Marshal(e)
+	if err != nil {
+		return err
+	}
+	raw = append(raw, '\n')
+	n, err := os.Stdout.Write(raw)
+	if err != nil {
+		return err
+	}
+	if n != len(raw) {
+		return io.ErrShortWrite
+	}
+	return nil
+}
+func fixedPath(root, name string) string { return filepath.Join(root, name) }
+func readSource(path string) qualificationprobe.Event {
+	e := qualificationprobe.Event{Schema: qualificationprobe.EventSchema, Phase: "RESULT", Case: "source_read"}
+	f, err := os.Open(path)
+	if err != nil {
+		e.Errno = errorNumber(err)
+		return e
+	}
+	defer f.Close()
+	e.Opened = true
+	raw, err := io.ReadAll(io.LimitReader(f, 64<<10+1))
+	if err != nil || len(raw) > 64<<10 {
+		e.Errno = -1
+		return e
+	}
+	sum := sha256.Sum256(raw)
+	e.Digest = "sha256:" + hex.EncodeToString(sum[:])
+	e.Bytes = len(raw)
+	return e
+}
+func deniedRead(path string) qualificationprobe.Event {
+	e := qualificationprobe.Event{Schema: qualificationprobe.EventSchema, Phase: "RESULT", Case: "denied_read"}
+	f, err := os.Open(path)
+	if err != nil {
+		e.Errno = errorNumber(err)
+		return e
+	}
+	e.Opened = true
+	f.Close()
+	return e
+}
+func openWin(path string, create bool, name string) qualificationprobe.Event {
+	e := qualificationprobe.Event{Schema: qualificationprobe.EventSchema, Phase: "RESULT", Case: name}
+	p, err := windows.UTF16PtrFromString(path)
+	if err != nil {
+		e.Errno = -1
+		return e
+	}
+	mode := uint32(windows.OPEN_EXISTING)
+	if create {
+		mode = windows.CREATE_NEW
+	}
+	h, err := windows.CreateFile(p, windows.GENERIC_WRITE, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE|windows.FILE_SHARE_DELETE, nil, mode, windows.FILE_ATTRIBUTE_NORMAL, 0)
+	if err != nil {
+		e.Errno = errorNumber(err)
+		return e
+	}
+	e.Opened = true
+	windows.CloseHandle(h)
+	return e
+}
+func connectLoopback(port uint16) qualificationprobe.Event {
+	e := qualificationprobe.Event{Schema: qualificationprobe.EventSchema, Phase: "RESULT", Case: "loopback_connect"}
+	c, err := net.DialTimeout("tcp4", net.JoinHostPort("127.0.0.1", strconv.Itoa(int(port))), time.Second)
+	if err != nil {
+		e.Errno = errorNumber(err)
+		return e
+	}
+	e.Opened = true
+	c.Close()
+	return e
+}
+func run(p qualificationprobe.Plan) error {
+	paths := map[string]string{
+		"source_read": fixedPath(p.Source, "allow.txt"), "denied_read": fixedPath(p.Denied, "denied.txt"),
+		"source_write_open": fixedPath(p.Source, "write-existing.txt"), "working_write_open": fixedPath(p.Working, "write-existing.txt"),
+		"source_create": fixedPath(p.Source, "create-denied.txt"), "working_create": fixedPath(p.Working, "create-denied.txt"),
+	}
+	for _, name := range qualificationprobe.Cases {
+		if err := emit(qualificationprobe.Event{Schema: qualificationprobe.EventSchema, Phase: "START", Case: name}); err != nil {
+			return err
+		}
+		var result qualificationprobe.Event
+		switch name {
+		case "source_read":
+			result = readSource(paths[name])
+		case "denied_read":
+			result = deniedRead(paths[name])
+		case "source_write_open", "working_write_open":
+			result = openWin(paths[name], false, name)
+		case "source_create", "working_create":
+			result = openWin(paths[name], true, name)
+		case "loopback_connect":
+			result = connectLoopback(p.Port)
+		}
+		if err := emit(result); err != nil {
+			return err
+		}
+	}
+	return emit(qualificationprobe.Event{Schema: qualificationprobe.EventSchema, Phase: "COMPLETE", Bitmap: qualificationprobe.CompleteBitmap})
+}
+func main() {
+	if len(os.Args) != 3 || os.Args[1] != "--plan-v1" {
+		os.Exit(64)
+	}
+	p, err := qualificationprobe.Decode(os.Args[2])
+	if err != nil {
+		os.Exit(64)
+	}
+	watchdog := time.AfterFunc(10*time.Second, func() { os.Exit(75) })
+	defer watchdog.Stop()
+	if run(p) != nil {
+		os.Exit(74)
+	}
+}
diff --git a/cmd/researchos-qualification-helper/main_windows_test.go b/cmd/researchos-qualification-helper/main_windows_test.go
new file mode 100644
--- /dev/null
+++ b/cmd/researchos-qualification-helper/main_windows_test.go
@@ -0,0 +1,47 @@
+//go:build windows
+
+package main
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+// These user-mode fake cases check fixed operation shape, not Native policy.
+func TestHelperFixedOperationsAreNarrow(t *testing.T) {
+	root := t.TempDir()
+	source := filepath.Join(root, "S")
+	working := filepath.Join(root, "QW")
+	denied := filepath.Join(root, "D")
+	for _, dir := range []string{source, working, denied} {
+		if err := os.Mkdir(dir, 0700); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := os.WriteFile(filepath.Join(source, "allow.txt"), []byte("synthetic-allow"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(denied, "denied.txt"), []byte("synthetic-denied"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	read := readSource(filepath.Join(source, "allow.txt"))
+	if !read.Opened || read.Errno != 0 || read.Bytes != len("synthetic-allow") || len(read.Digest) != 71 {
+		t.Fatal("source read shape", read)
+	}
+	read = deniedRead(filepath.Join(denied, "denied.txt"))
+	if !read.Opened || read.Errno != 0 || read.Digest != "" {
+		t.Fatal("denied read must never emit contents", read)
+	}
+	missing := openWin(filepath.Join(working, "missing.txt"), false, "working_write_open")
+	if missing.Opened || missing.Errno == 0 {
+		t.Fatal("missing file misreported as write access", missing)
+	}
