-func rpcOnlyKeys(value map[string]any, allowed ...string) bool {
-	for key := range value {
-		found := false
-		for _, item := range allowed {
-			if key == item {
-				found = true
-				break
-			}
-		}
-		if !found {
-			return false
-		}
-	}
-	return true
-}
