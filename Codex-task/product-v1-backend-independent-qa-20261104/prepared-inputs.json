  "definition:EventsData": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "task_ref": {
        "$ref": "#/$defs/TaskRef"
      },
      "events": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/Event"
        },
        "maxItems": 500
      },
      "next_cursor": {
        "$ref": "#/$defs/Decimal"
      },
      "has_more": {
        "type": "boolean"
      },
      "end": {
        "type": "boolean"
      },
      "reset": {
        "type": "boolean"
      },
      "snapshot": {
        "anyOf": [
          {
            "$ref": "#/$defs/Task"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "task_ref",
      "events",
      "next_cursor",
      "has_more",
      "end",
      "reset",
      "snapshot"
    ]
  },
  "definition:Event": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "event_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "task_ref": {
        "$ref": "#/$defs/TaskRef"
      },
      "run": {
        "anyOf": [
          {
            "$ref": "#/$defs/RunRef"
          },
          {
            "type": "null"
          }
        ]
      },
      "sequence": {
        "$ref": "#/$defs/PositiveDecimal"
      },
      "timestamp": {
        "type": "string",
        "format": "date-time"
      },
      "kind": {
        "enum": [
          "TASK_QUEUED",
          "RUN_STARTED",
          "RUN_STATE",
          "ASSISTANT_MESSAGE",
          "TOOL_EVENT",
          "LOG",
          "TASK_TERMINAL"
        ]
      },
      "payload": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "anyOf": [
              {
                "enum": [
                  "QUEUED",
                  "STARTING",
                  "RUNNING",
                  "CANCEL_REQUESTED",
                  "COMPLETED",
                  "FAILED",
                  "CANCELLED",
                  "BLOCKED",
                  "UNKNOWN"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "text": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1048576,
                "x-maxUtf8Bytes": 1048576
              },
              {
                "type": "null"
              }
            ]
          },
          "tool": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "phase": {
                    "enum": [
                      "STARTED",
                      "COMPLETED",
                      "FAILED"
                    ]
                  },
                  "summary": {
                    "type": "string",
                    "maxLength": 4096
                  }
                },
                "required": [
                  "id",
                  "name",
                  "phase",
                  "summary"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "task": {
            "anyOf": [
              {
                "$ref": "#/$defs/Task"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/$defs/Error"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "status",
          "text",
          "tool",
          "task",
          "error"
        ]
      }
    },
    "required": [
      "event_id",
      "task_ref",
      "run",
      "sequence",
      "timestamp",
      "kind",
      "payload"
    ]
  },
  "definition:Task": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "task_ref": {
        "$ref": "#/$defs/TaskRef"
      },
      "request_id": {
        "$ref": "#/$defs/RequestID"
      },
      "harness_id": {
        "const": "codex"
      },
      "workspace_ref": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "prompt": {
        "type": "string",
        "maxLength": 65536,
        "x-maxUtf8Bytes": 65536
      },
      "scope": {
        "const": "workspace-read"
      },
      "ephemeral": {
        "const": true
      },
      "status": {
        "enum": [
          "QUEUED",
          "STARTING",
          "RUNNING",
          "CANCEL_REQUESTED",
          "COMPLETED",
          "FAILED",
          "CANCELLED",
          "BLOCKED",
          "UNKNOWN"
        ]
      },
      "terminal": {
        "type": "boolean"
      },
      "task_revision": {
        "$ref": "#/$defs/PositiveDecimal"
      },
      "run": {
        "anyOf": [
          {
            "$ref": "#/$defs/RunRef"
          },
          {
            "type": "null"
          }
        ]
      },
      "created_at": {
        "type": "string",
        "format": "date-time"
      },
      "updated_at": {
        "type": "string",
        "format": "date-time"
      },
      "result": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "assistant_text": {
                "type": "string",
                "maxLength": 1048576,
                "x-maxUtf8Bytes": 1048576
              },
              "cli_thread_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "assistant_text",
              "cli_thread_id"
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "failure": {
        "anyOf": [
          {
            "$ref": "#/$defs/Error"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "task_ref",
      "request_id",
      "harness_id",
      "workspace_ref",
      "prompt",
      "scope",
      "ephemeral",
      "status",
      "terminal",
      "task_revision",
      "run",
      "created_at",
      "updated_at",
      "result",
      "failure"
    ]
  },
  "definition:CapabilitiesResponse": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "api_version": {
        "const": "harness.v1"
      },
      "data": {
        "$ref": "#/$defs/Capabilities"
      }
    },
    "required": [
      "api_version",
      "data"
    ]
  },
  "source_candidate_read": false,
  "tests_run": 0,
  "formal_increment": 0
}
