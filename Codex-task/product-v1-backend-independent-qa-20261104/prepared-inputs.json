  "definition:SubmitRequest": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "request_id": {
        "$ref": "#/$defs/RequestID"
      },
      "project_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "workspace_ref": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "harness_id": {
